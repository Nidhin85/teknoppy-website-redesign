---
/**
 * Floating WhatsApp button.
 *
 * Deliberately `md:` and up only. Below 768px the mobile bottom bar in
 * Layout.astro already carries a WhatsApp action, and that bar is `md:hidden` —
 * so the two hand over to each other at exactly the same breakpoint. Showing
 * both would put two WhatsApp targets in the same corner of a phone screen.
 *
 * Sits at z-30: under the header (z-50) and under the mobile nav panel (z-40),
 * which matters between 768px and 1023px where the hamburger menu still exists
 * and its opaque overlay should cover this button rather than fight it.
 */
import site from '../data/site.json';

const href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-fab hidden md:inline-flex fixed bottom-6 right-6 z-30 items-center rounded-full bg-[#25D366] text-white shadow-[0_10px_30px_-6px_rgba(37,211,102,0.55)] hover:bg-[#1EBE5A] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#25D366]/35 transition-colors duration-200"
  aria-label={`Chat with ${site.businessName} on WhatsApp`}
>
  <!-- Label first so the pill grows leftwards on hover and the icon stays put. -->
  <span class="whatsapp-fab-label text-[15px] font-bold whitespace-nowrap">
    {site.whatsappCtaLabel}
  </span>
  <span class="whatsapp-fab-icon relative grid place-items-center w-14 h-14 shrink-0">
    <svg class="w-7 h-7 relative z-10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path>
    </svg>
  </span>
</a>

<style>
  /* The label is collapsed to zero width and only opens on hover or keyboard
     focus, so the resting state is a clean circle. Animating max-width rather
     than width keeps it working with whatever the label text happens to be. */
  .whatsapp-fab-label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    padding-left: 0;
    transition:
      max-width 0.32s ease,
      opacity 0.2s ease,
      padding-left 0.32s ease;
  }

  .whatsapp-fab:hover .whatsapp-fab-label,
  .whatsapp-fab:focus-visible .whatsapp-fab-label {
    max-width: 12rem;
    opacity: 1;
    padding-left: 1.25rem;
  }

  /* A soft outward pulse, so the button reads as live without being a nag.
     Painted behind the icon and non-interactive. */
  .whatsapp-fab-icon::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background-color: #25d366;
    z-index: 0;
    animation: whatsapp-fab-pulse 2.6s ease-out infinite;
  }

  @keyframes whatsapp-fab-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(1.75);
      opacity: 0;
    }
  }

  .whatsapp-fab:hover .whatsapp-fab-icon::before {
    animation-play-state: paused;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab-label {
      transition: none;
    }
    .whatsapp-fab-icon::before {
      animation: none;
      opacity: 0;
    }
  }
</style>
