---
// Lightweight, fully accessible shared Lightbox for Life at Teknoppy galleries
---

<div
  id="life-lightbox"
  class="life-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Media Lightbox"
  aria-hidden="true"
>
  <div class="life-lightbox-backdrop" data-action="close"></div>

  <div class="life-lightbox-container" role="document">
    <!-- Header / Top controls -->
    <header class="life-lightbox-header">
      <div class="life-lightbox-info">
        <span class="life-lightbox-tag" id="life-lightbox-tag" style="display:none;"></span>
        <span class="life-lightbox-counter" id="life-lightbox-counter"></span>
      </div>
      <button
        type="button"
        class="life-lightbox-btn life-lightbox-close"
        data-action="close"
        aria-label="Close lightbox (Escape)"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Main stage (Image or Video) -->
    <div class="life-lightbox-stage" id="life-lightbox-stage">
      <img
        id="life-lightbox-img"
        class="life-lightbox-media life-lightbox-img"
        src=""
        alt=""
        style="display:none;"
      />
      <video
        id="life-lightbox-video"
        class="life-lightbox-media life-lightbox-video"
        controls
        playsinline
        style="display:none;"
      ></video>
    </div>

    <!-- Navigation arrows -->
    <button
      type="button"
      class="life-lightbox-nav life-lightbox-prev"
      data-action="prev"
      aria-label="Previous item (Left Arrow)"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button
      type="button"
      class="life-lightbox-nav life-lightbox-next"
      data-action="next"
      aria-label="Next item (Right Arrow)"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <!-- Bottom caption -->
    <footer class="life-lightbox-footer">
      <p id="life-lightbox-caption" class="life-lightbox-caption"></p>
    </footer>
  </div>
</div>

<style>
  .life-lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .life-lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .life-lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(9, 11, 15, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .life-lightbox-container {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    max-width: 1360px;
    max-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(16px, 3vw, 32px);
    box-sizing: border-box;
  }

  .life-lightbox-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    z-index: 10;
  }

  .life-lightbox-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .life-lightbox-tag {
    background: #f26a1b;
    color: #fff;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .life-lightbox-counter {
    color: rgba(255, 255, 255, 0.65);
    font-size: 13.5px;
    font-weight: 600;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .life-lightbox-btn {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .life-lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: scale(1.06);
  }

  .life-lightbox-stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 0;
    padding: clamp(12px, 2vw, 24px) 0;
    user-select: none;
    -webkit-user-select: none;
  }

  .life-lightbox-media {
    max-width: 92vw;
    max-height: 85vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 14px;
    box-shadow: 0 24px 64px -16px rgba(0, 0, 0, 0.7);
    transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .life-lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.2s, transform 0.2s;
  }

  .life-lightbox-nav:hover {
    background: #f26a1b;
    border-color: #f26a1b;
    transform: translateY(-50%) scale(1.08);
  }

  .life-lightbox-prev {
    left: clamp(14px, 2.5vw, 28px);
  }

  .life-lightbox-next {
    right: clamp(14px, 2.5vw, 28px);
  }

  .life-lightbox-footer {
    display: flex;
    justify-content: center;
    text-align: center;
    width: 100%;
    padding-top: 8px;
    z-index: 10;
  }

  .life-lightbox-caption {
    margin: 0;
    color: #fff;
    font-size: clamp(15px, 1.3vw, 19px);
    font-weight: 600;
    line-height: 1.4;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
    max-width: 65ch;
  }

  @media (max-width: 768px) {
    .life-lightbox-container {
      padding: 16px 14px;
    }
    .life-lightbox-nav {
      width: 42px;
      height: 42px;
    }
    .life-lightbox-prev {
      left: 10px;
    }
    .life-lightbox-next {
      right: 10px;
    }
    .life-lightbox-media {
      max-height: calc(100svh - 140px);
      border-radius: 10px;
    }
  }
</style>

<script is:inline>
  (() => {
    let currentGallery = [];
    let currentIndex = 0;
    let lastActiveElement = null;
    let touchStartX = 0;
    let touchEndX = 0;

    const lb = document.getElementById("life-lightbox");
    if (!lb) return;

    const img = document.getElementById("life-lightbox-img");
    const video = document.getElementById("life-lightbox-video");
    const caption = document.getElementById("life-lightbox-caption");
    const counter = document.getElementById("life-lightbox-counter");
    const tag = document.getElementById("life-lightbox-tag");

    function updateView() {
      if (!currentGallery.length) return;
      const item = currentGallery[currentIndex];
      if (!item) return;

      // Update counter
      if (counter) {
        counter.textContent = `${currentIndex + 1} / ${currentGallery.length}`;
      }

      // Update tag if present
      if (tag) {
        if (item.tag) {
          tag.textContent = item.tag;
          tag.style.display = "inline-block";
        } else {
          tag.style.display = "none";
        }
      }

      // Update caption
      if (caption) {
        caption.textContent = item.caption || item.alt || "";
      }

      // Render image or video
      if (item.type === "video") {
        if (img) {
          img.style.display = "none";
          img.src = "";
        }
        if (video) {
          video.src = item.src;
          if (item.poster) video.poster = item.poster;
          video.style.display = "block";
          video.currentTime = 0;
          video.play().catch(() => {});
        }
      } else {
        if (video) {
          video.pause();
          video.src = "";
          video.style.display = "none";
        }
        if (img) {
          img.src = item.src;
          img.alt = item.alt || item.caption || "";
          img.style.display = "block";
        }
      }
    }

    function openLightbox(gallery, startIndex = 0, triggerEl = null) {
      if (!Array.isArray(gallery) || gallery.length === 0) return;
      currentGallery = gallery;
      currentIndex = Math.max(0, Math.min(startIndex, gallery.length - 1));
      lastActiveElement = triggerEl || document.activeElement;

      updateView();

      lb.classList.add("is-open");
      lb.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";

      // Focus close button
      const closeBtn = lb.querySelector(".life-lightbox-close");
      if (closeBtn) closeBtn.focus();
    }

    function closeLightbox() {
      if (video) {
        video.pause();
        video.src = "";
      }
      if (img) img.src = "";
      lb.classList.remove("is-open");
      lb.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";

      if (lastActiveElement && typeof lastActiveElement.focus === "function") {
        lastActiveElement.focus();
      }
    }

    function nextItem() {
      if (!currentGallery.length) return;
      currentIndex = (currentIndex + 1) % currentGallery.length;
      updateView();
    }

    function prevItem() {
      if (!currentGallery.length) return;
      currentIndex = (currentIndex - 1 + currentGallery.length) % currentGallery.length;
      updateView();
    }

    // Expose global open helper
    window.__openLifeLightbox = (gallery, index, triggerEl) => {
      openLightbox(gallery, index, triggerEl);
    };

    // Click handler for delegated controls
    lb.addEventListener("click", (e) => {
      const target = e.target;
      const actionEl = target.closest("[data-action]");
      if (!actionEl) return;
      const action = actionEl.getAttribute("data-action");
      if (action === "close") closeLightbox();
      else if (action === "next") nextItem();
      else if (action === "prev") prevItem();
    });

    // Keyboard navigation
    window.addEventListener("keydown", (e) => {
      if (!lb.classList.contains("is-open")) return;
      if (e.key === "Escape") {
        e.preventDefault();
        closeLightbox();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        nextItem();
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        prevItem();
      } else if (e.key === "Tab") {
        // Focus trap
        const focusables = lb.querySelectorAll('button:not([disabled]), [tabindex="0"]');
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Touch swipe support
    lb.addEventListener("touchstart", (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    lb.addEventListener("touchend", (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 45) {
        if (diff < 0) nextItem();
        else prevItem();
      }
    }, { passive: true });
  })();
</script>
