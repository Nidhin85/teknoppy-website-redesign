---
// Celebrations section with draggable horizontal photo carousel, progress bar, and interactive lightbox modal
const celebrations = [
  {
    title: 'Onam Festival & Pookkalam',
    caption: 'Traditional Onam festival celebration with Kerala Kasavu attire, Nilavilakku, and authentic team spirit at our studio.',
    photo: '/images/life/teknoppy-onam-celebration.webp',
    tag: 'Culture & Festival',
    accent: 'g1'
  },
  {
    title: 'Pookkalam Flower Carpet',
    caption: 'Hands-on team collaboration arranging fresh yellow and orange marigold petals for the Onam pookkalam.',
    photo: '/images/life/teknoppy-pookkalam-preparation.webp',
    tag: 'Tradition & Art',
    accent: 'g4'
  },
  {
    title: 'Project Go-Live & Launch Presentation',
    caption: 'Unveiling major client websites in our conference room — presenting the official personal brand platform for celebrity author Lenaa.',
    photo: '/images/life/teknoppy-project-launch-presentation.webp',
    tag: 'Client Launch',
    accent: 'g5'
  },
  {
    title: 'Team & Client Milestone',
    caption: 'Celebrating successful project go-lives together with our clients and in-house team in front of the Teknoppy studio wall.',
    photo: '/images/life/teknoppy-team-client-milestone.webp',
    tag: 'Team Milestone',
    accent: 'g3'
  },
  {
    title: 'Strategy & Consultation Lounge',
    caption: 'Face-to-face consultations in our lounge — mapping brand positioning, target audience, and organic search architecture.',
    photo: '/images/life/teknoppy-client-consultation-lenaa.webp',
    tag: 'Client Strategy',
    accent: 'g2'
  },
  {
    title: 'Partnership Handshake & Trust',
    caption: 'Long-term client partnerships built on transparency, honest deadlines, and measurable digital growth.',
    photo: '/images/life/teknoppy-client-partnership-handshake.webp',
    tag: 'Client Partnership',
    accent: 'g1'
  },
  {
    title: 'Studio Celebrations & Cake Cutting',
    caption: 'Marking company achievements, festival highlights, and shared milestones together in the studio.',
    photo: '/video/poster.jpg',
    tag: 'Studio Celebration',
    accent: 'g5'
  },
  {
    title: 'Collaborative Reviews & Mentorship',
    caption: 'Mentorship in action — senior and junior engineers reviewing architecture and sharing deep technical insights.',
    photo: '/images/life/teknoppy-team-collaboration.webp',
    tag: 'Mentorship',
    accent: 'g2'
  }
];
---

<section id="celebrate" style="background:var(--tint);border-block:1px solid var(--tint-line);scroll-margin-top:90px">
  <div class="wrap">
    <div class="center sec">
      <span class="tag" style="background:var(--surface)">Celebrations</span>
      <h2 class="words">How does the team celebrate?</h2>
      <p>We mark festivals, birthdays and project launches together. Every photo below was taken at our office or on a team outing.</p>
    </div>
  </div>

  <!-- Draggable Horizontal Carousel Container -->
  <div class="carw">
    <div class="car" id="car" role="region" aria-label="Celebration photos carousel">
      {celebrations.map((c, idx) => (
        <figure class={`slide ${idx === 0 ? 'on' : ''}`} data-index={idx} tabindex="0" role="button" aria-label={`View photo of ${c.title}`}>
          <div class="slide-img-wrap">
            <img src={c.photo} alt={c.title} class="slide-img" loading="lazy" />
            <div class="slide-badge">{c.tag}</div>
          </div>
          <figcaption>
            <b>{c.title}</b>
            {c.caption}
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Carousel Controls & Progress Meter -->
    <div class="wrap carctl">
      <button id="cprev" aria-label="Previous photo">←</button>
      <div class="carbar">
        <i id="cbar" style={`width: ${(100 / celebrations.length).toFixed(1)}%;`}></i>
      </div>
      <button id="cnext" aria-label="Next photo">→</button>
    </div>
  </div>

  <p class="social wrap">
    More moments from the office on 
    <a href="https://www.instagram.com/teknoppy/" target="_blank" rel="noopener noreferrer" class="social-link">Instagram</a> 
    and 
    <a href="https://www.linkedin.com/company/teknoppy/" target="_blank" rel="noopener noreferrer" class="social-link">LinkedIn</a>.
  </p>
</section>

<!-- Accessible Lightbox Modal Dialog -->
<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <div class="box">
    <div id="lbph" class="lb-photo-target"></div>
    <p id="lbc" class="lb-caption"></p>
    <button class="x" id="lbx" aria-label="Close photo viewer">✕</button>
  </div>
</div>

<style>
  .slide-img-wrap {
    height: 320px;
    border-radius: var(--r);
    overflow: hidden;
    position: relative;
    background: #1a1a1a;
  }
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .slide:hover .slide-img {
    transform: scale(1.06);
  }
  .slide-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: var(--display);
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--orange);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .social-link {
    color: var(--orange);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .social-link:hover {
    color: var(--ink);
  }
  .lb-photo-target {
    width: 100%;
    max-height: 70vh;
    border-radius: 18px;
    overflow: hidden;
    background: #000;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .lb-photo-target img {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
    display: block;
  }
  .lb-caption {
    font-size: 16px;
    line-height: 1.5;
    padding-inline: 10px;
  }
</style>
