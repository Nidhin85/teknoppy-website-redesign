---
import { Phone } from 'lucide-react';
import site from '../data/site.json';
---

<!-- Fixed 3-Part Bottom Action Bar (CALL NOW | WHATSAPP | FREE QUOTE) -->
<div class="fixed-bottom-bar lg:hidden fixed bottom-0 left-0 right-0 w-full max-w-full z-40 flex items-stretch shadow-[0_-4px_25px_rgba(0,0,0,0.35)] overflow-hidden" role="region" aria-label="Quick Contact Actions">
  <!-- 1. CALL NOW (Yellow Treatment) -->
  <a
    href={`tel:${site.phoneLink}`}
    class="bar-btn btn-call flex-1 flex items-center justify-center gap-1 sm:gap-2.5 px-1 min-[360px]:px-2 sm:px-4 py-3 sm:py-3.5 md:py-4 bg-[#F9AE42] hover:bg-[#E89F36] text-neutral-950 font-black text-[10px] min-[360px]:text-xs sm:text-sm md:text-base lg:text-[17px] uppercase tracking-wider transition-all duration-200 border-r border-black/10 select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-950/80 focus-visible:ring-inset whitespace-nowrap"
    aria-label="Call Teknoppy"
  >
    <Phone class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-5 md:h-5 shrink-0 text-neutral-950" />
    <span>CALL NOW</span>
  </a>

  <!-- 2. WHATSAPP (Green Treatment) -->
  <a
    href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`}
    target="_blank"
    rel="noopener noreferrer"
    class="bar-btn btn-whatsapp flex-1 flex items-center justify-center gap-1 sm:gap-2.5 px-1 min-[360px]:px-2 sm:px-4 py-3 sm:py-3.5 md:py-4 bg-[#25D366] hover:bg-[#20ba5a] text-white font-black text-[10px] min-[360px]:text-xs sm:text-sm md:text-base lg:text-[17px] uppercase tracking-wider transition-all duration-200 border-r border-white/20 select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-inset whitespace-nowrap"
    aria-label="Chat with Teknoppy on WhatsApp"
  >
    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-5 md:h-5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
    </svg>
    <span>WHATSAPP</span>
  </a>

  <!-- 3. FREE QUOTE (Branded Primary Treatment) -->
  <a
    href="/request-a-quote/"
    class="bar-btn btn-quote flex-1 flex items-center justify-center gap-1 sm:gap-2.5 px-1 min-[360px]:px-2 sm:px-4 py-3 sm:py-3.5 md:py-4 bg-[#F05A2C] hover:bg-[#D24A20] text-white font-black text-[10px] min-[360px]:text-xs sm:text-sm md:text-base lg:text-[17px] uppercase tracking-wider transition-all duration-200 select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-inset whitespace-nowrap"
    aria-label="Request a Free Quote from Teknoppy"
  >
    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-5 md:h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
    <span>FREE QUOTE</span>
  </a>
</div>

<style>
  .fixed-bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 40;
    display: flex;
    align-items: stretch;
    box-shadow: 0 -4px 25px rgba(0, 0, 0, 0.35);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .fixed-bottom-bar .bar-btn {
    transition: filter 0.2s ease, background-color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .fixed-bottom-bar .bar-btn:hover {
      filter: brightness(1.08);
    }
  }

  .fixed-bottom-bar .bar-btn:active {
    filter: brightness(0.92);
  }

  /* Desktop view (1024px and above): Completely hide the bottom CTA bar and clear layout footprint */
  @media (min-width: 1024px) {
    .fixed-bottom-bar {
      display: none !important;
    }
  }

  /* Tablet and mobile view (below 1024px): Page bottom padding and FAB adjustment only when action bar is active on Kochi page */
  @media (max-width: 1023px) {
    :global(body.has-bottom-bar), :global(.is-kochi-page) {
      padding-bottom: calc(56px + env(safe-area-inset-bottom, 0px)) !important;
    }

    :global(body.has-bottom-bar .whatsapp-fab), :global(.is-kochi-page .whatsapp-fab) {
      bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px)) !important;
    }

    :global(body.has-bottom-bar .global-floating-cta-wrap), :global(.is-kochi-page .global-floating-cta-wrap) {
      bottom: calc(9.25rem + env(safe-area-inset-bottom, 0px)) !important;
    }
  }

  /* Tablet: the bar grows to ~61px (md: padding + text), so reserve a little more room */
  @media (min-width: 768px) and (max-width: 1023px) {
    :global(body.has-bottom-bar), :global(.is-kochi-page) {
      padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px)) !important;
    }
  }

  @media (max-width: 767px) {
    :global(body.has-bottom-bar .global-floating-cta-wrap), :global(.is-kochi-page .global-floating-cta-wrap) {
      bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px)) !important;
    }
  }
</style>
