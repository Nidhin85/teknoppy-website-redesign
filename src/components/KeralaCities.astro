---
import { MapPin, ArrowRight } from "lucide-react";

const cities = [
  {
    city: "Kochi",
    h3: "Web Design in Kochi",
    line: "Our headquarters. Websites for Kochi startups, clinics and enterprises.",
    link: "/web-design-company-kochi/",
    anchor: "web design company in Kochi",
    active: true
  },
  {
    city: "Thrissur",
    h3: "Web Design in Thrissur",
    line: "Business, education and retail websites for Thrissur brands.",
    link: null,
    anchor: null,
    active: false
  },
  {
    city: "Kozhikode",
    h3: "Web Design in Kozhikode",
    line: "Websites for Kozhikode (Calicut) healthcare, Ayurveda and trade.",
    link: null,
    anchor: null,
    active: false
  },
  {
    city: "Thiruvananthapuram",
    h3: "Web Design in Thiruvananthapuram",
    line: "Corporate and IT company websites for the capital region.",
    link: null,
    anchor: null,
    active: false
  },
  {
    city: "Palakkad",
    h3: "Web Design in Palakkad",
    line: "Websites for Palakkad manufacturers and local businesses.",
    link: null,
    anchor: null,
    active: false
  },
  {
    city: "Kottayam",
    h3: "Web Design in Kottayam",
    line: "Websites for Kottayam schools, finance and service firms.",
    link: null,
    anchor: null,
    active: false
  }
];

// Homepage passes the office video into this slot so it sits beside the section intro (reference layout)
const hasMedia = Astro.slots.has('media');
---

<section id="kerala-cities" class:list={["py-10 sm:py-12 md:py-16 relative overflow-hidden", hasMedia ? "home-cities" : "bg-white"]}>
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    <div class:list={[hasMedia ? "grid lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-10 sm:mb-12 md:mb-14" : ""]}>
      {hasMedia && (
        <div class="lg:col-span-7">
          <div class="home-video-frame">
            <slot name="media" />
          </div>
        </div>
      )}
      <div class:list={[hasMedia ? "lg:col-span-5 flex flex-col items-start text-left" : "max-w-3xl mx-auto text-center flex flex-col items-center mb-8 sm:mb-10 md:mb-12"]}>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
          <MapPin className="w-3.5 h-3.5" />
          Regional Hub
        </div>
        <h2 class:list={["font-black leading-tight text-neutral-900 mb-3 sm:mb-4", hasMedia ? "text-3xl md:text-4xl xl:text-[2.75rem]" : "text-3xl md:text-5xl"]} data-magnetic-heading>
          Web Design Company in Kerala by City
        </h2>
        <p class:list={["text-neutral-600 leading-relaxed font-medium", hasMedia ? "text-base md:text-lg" : "text-lg md:text-xl"]}>
          We design websites for businesses across Kerala. Find your city below.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-4.5 md:gap-5" data-stagger>
      {cities.map((item) => (
        <div class="group relative neu-card rounded-2xl p-4 sm:p-4.5 md:p-5 lg:p-5.5 flex flex-col justify-between h-full">
          <div>
            <div class="flex items-center justify-between mb-2.5 sm:mb-3">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white border border-neutral-200 text-neutral-700">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                {item.city}
              </span>
              {item.active && (
                <span class="text-xs font-semibold text-primary bg-primary/10 px-2.5 py-0.5 rounded-full">
                  Dedicated Hub
                </span>
              )}
            </div>

            <h3 class="text-base sm:text-lg md:text-[1.125rem] font-bold text-neutral-900 mb-1.5 leading-snug group-hover:text-primary transition-colors">
              {item.active ? (
                <a href={item.link} class="hover:underline">
                  {item.h3}
                </a>
              ) : (
                item.h3
              )}
            </h3>

            <p class="text-xs sm:text-[0.84rem] text-neutral-600 leading-relaxed font-normal mb-1">
              {item.line}
            </p>
          </div>

          <div class="pt-3 mt-3 border-t border-neutral-100 flex items-center justify-between">
            {item.active ? (
              <a
                href={item.link}
                class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-neutral-900 transition-colors group/link"
              >
                <span>Explore {item.anchor}</span>
                <ArrowRight className="w-4 h-4 transition-transform group-hover/link:translate-x-1" />
              </a>
            ) : (
              <span class="text-xs font-medium text-neutral-400">
                Local team coverage available
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .home-cities { background: linear-gradient(180deg, #fff4ec 0%, #fffaf6 100%); }
  .home-cities :global(.home-video-frame) { box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 30px 60px -34px rgb(120 40 10 / 0.5), 0 0 0 6px rgb(255 255 255 / 0.6); }
  /* homepage: the MapPin inside the eyebrow is replaced by the dash */
  .home-cities [class*="tracking-"] > :global(svg) { display: none; }
</style>
