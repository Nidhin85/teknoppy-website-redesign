---
import { ArrowUpRight, Layers, Users, CalendarCheck, LayoutGrid } from "lucide-react";
import home from "../data/home.json";

// decorative icons for the four stat cards (index-matched with home.about.stats)
const statIcons = [Layers, Users, CalendarCheck, LayoutGrid];
const statSuffixColor = ["text-primary", "text-secondary", "text-primary", "text-primary"];
---

<section id="about" class="home-about py-14 sm:py-16 md:py-20 lg:py-24 relative overflow-hidden">
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0" aria-hidden="true">
    <div class="home-about-glow"></div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-center">
      <!-- Left: copy -->
      <div class="lg:col-span-6 flex flex-col items-start text-left">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1"
        >
          {home.about.badge}
        </div>

        <h2
          class="text-4xl md:text-5xl lg:text-[3.4rem] font-black leading-[1.06] text-black mb-6"
          data-magnetic-heading
        >
          <span class="text-primary">{home.about.headingAccent}</span> {home.about.headingRest}
        </h2>

        <p class="text-base md:text-lg font-semibold text-neutral-900 leading-relaxed pl-4 md:pl-5 border-l-[3px] border-primary mb-6">
          {home.about.intro}
        </p>

        <div class="space-y-4 text-sm md:text-[0.95rem] text-muted leading-relaxed">
          <p>{home.about.paragraphs[0]}</p>
          <p>{home.about.paragraphs[1]}</p>
        </div>

        <!-- Contextual CTA: After Who We Are -->
        <div class="cta-reveal mt-8 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-5">
          <a
            href="/request-a-quote/"
            class="cta-float-secondary cta-delay-2 cta-pulse-medium cta-pulse-delay-2 cta-shimmer-btn inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-bold text-white bg-primary hover:bg-primary/95 rounded-full transition-all duration-300 shadow-[0_10px_24px_-8px_rgba(240,90,44,0.55)] hover:-translate-y-0.5 shrink-0 group self-start"
          >
            <span>Talk to Our Experts</span>
            <ArrowUpRight className="cta-arrow cta-arrow-invite w-4 h-4" />
          </a>
          <div class="max-w-xs">
            <p class="text-sm font-bold text-neutral-900 tracking-tight">Have an idea in mind?</p>
            <p class="text-xs text-neutral-600 mt-0.5">Have an idea in mind? Let's turn it into a digital experience.</p>
          </div>
        </div>
      </div>

      <!-- Right: 3D brand visual + stat cards -->
      <div class="lg:col-span-6 relative">
        <picture class="home-about-visual block">
          <source media="(max-width: 767px)" srcset="/images/home/3d/about-logo-3d-900.webp" />
          <img
            src="/images/home/3d/about-logo-3d.webp"
            alt="3D Teknoppy logo on a glass pedestal"
            width="1600"
            height="1200"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </picture>

        <div class="grid grid-cols-2 gap-3 sm:gap-4 -mt-10 sm:-mt-16 relative z-10">
          {home.about.stats.map((stat, i) => {
            const Icon = statIcons[i] ?? Layers;
            return (
              <div
                class="stat-card opacity-0 translate-y-12 flex flex-col bg-white/90 backdrop-blur-md border border-primary/10 p-4 sm:p-5 rounded-2xl shadow-[0_24px_48px_-30px_rgba(160,60,20,0.5)] transition-all duration-500 group hover:border-primary/25"
                style={`transition-delay: ${i * 150}ms;`}
              >
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 sm:w-11 sm:h-11 shrink-0 rounded-xl bg-gradient-to-br from-[#fff1e8] to-[#ffe0cc] text-primary flex items-center justify-center">
                    <Icon className="w-5 h-5" />
                  </span>
                  <h3 class="text-3xl sm:text-4xl font-black text-black tracking-tight leading-none flex items-baseline gap-0.5">
                    <span class="counter" data-target={stat.value}>{stat.value}</span>
                    <span class={`${statSuffixColor[i] ?? 'text-primary'} font-bold`}>{stat.suffix}</span>
                  </h3>
                </div>
                <p class="text-[11px] sm:text-xs font-bold text-neutral-800 uppercase tracking-wider mt-3">
                  {stat.label}
                </p>
                <p class="text-xs text-muted mt-1 leading-normal">
                  {stat.sublabel}
                </p>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-about { background: linear-gradient(180deg, #fffaf6 0%, #fff4ec 100%); }
  .home-about-glow {
    position: absolute; right: -10%; top: 5%; width: 60%; height: 80%;
    background: radial-gradient(closest-side, rgba(255, 150, 90, 0.22), rgba(255, 150, 90, 0));
  }
  .home-about-visual img {
    -webkit-mask-image: radial-gradient(closest-side at 50% 48%, #000 70%, transparent 100%);
            mask-image: radial-gradient(closest-side at 50% 48%, #000 70%, transparent 100%);
  }
</style>

<script>
  const isFine = typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(pointer: fine)').matches;
  const isReduced = typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Intersection observer for scroll reveal animations and counting
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-12");

          // Start counter animation on desktop fine-pointer devices
          if (isFine && !isReduced) {
            const counters = entry.target.querySelectorAll(".counter");
            counters.forEach((counter) => {
              const target = +counter.getAttribute("data-target")!;
              const duration = 1200;
              let start: number | null = null;
              const step = (timestamp: number) => {
                if (!start) start = timestamp;
                const progress = Math.min((timestamp - start) / duration, 1);
                const current = Math.round(target * (1 - Math.pow(1 - progress, 3)));
                counter.innerText = current.toString();
                if (progress < 1) {
                  requestAnimationFrame(step);
                } else {
                  counter.innerText = target.toString();
                }
              };
              requestAnimationFrame(step);
            });
          }

          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 },
  );

  document.querySelectorAll(".stat-card").forEach((card) => {
    observer.observe(card);
  });
</script>
