---
import { CheckCircle } from 'lucide-react';
---

<section id="about" class="py-24 md:py-32 bg-cream relative overflow-hidden">
  <!-- Subtle decorative background -->
  <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-secondary/15 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -left-12 -top-12 w-48 h-48 bg-primary/10 rounded-full blur-2xl -z-10"></div>
  
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    
    <!-- Tier 1: Header & Key Message (Full width, centered on mobile, left-aligned on desktop) -->
    <div class="max-w-4xl flex flex-col items-center text-center lg:items-start lg:text-left mb-12 md:mb-16">
      
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
        Who We Are
      </div>
      
      <!-- Headline -->
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-[1.1] text-black mb-8">
        <span class="text-primary">Kerala's Professional</span> Web Design Agency
      </h2>
      
      <!-- Main Intro Paragraph (Quote Style) -->
      <p class="text-xl md:text-2xl font-semibold text-black leading-snug pl-0 lg:pl-6 border-l-0 lg:border-l-4 border-secondary">
        Teknoppy Kerala is a full-service digital agency founded and headquartered in Kochi, serving businesses across Kerala, Thrissur, and South India. Led by Sanal and a dedicated team of designers, developers, and SEO strategists, we have been building high-performance websites since 2016.
      </p>
    </div>

    <!-- Tier 2: Details & Stats Split (2 columns on desktop) -->
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Detailed Copy (7 cols) -->
      <div class="lg:col-span-7 space-y-6 text-base md:text-lg text-muted text-center lg:text-left">
        <p class="leading-relaxed">
          As a professional web design agency Kerala businesses have trusted for nearly a decade, we bring together creative design and technical precision to deliver websites that rank, convert, and represent your brand with authority. From custom website design Kerala startups need to enterprise-level web development Kerala corporations demand — our work spans industries, project sizes, and business goals.
        </p>
        <p class="leading-relaxed">
          We have delivered over 150 successful websites across healthcare, retail, hospitality, education, real estate, and manufacturing sectors. Every project begins with strategy and ends with measurable results.
        </p>
      </div>

      <!-- Right Column: Stats Grid (5 cols) -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-6 w-full mt-4 lg:mt-0">
        
        <!-- Websites -->
        <div class="stat-card opacity-0 translate-y-12 flex flex-col bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-neutral-100/60 transition-all duration-500 hover:-translate-y-1 hover:shadow-md hover:border-primary/20 group" style="transition-delay: 0ms;">
          <h3 class="text-4xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-none flex items-baseline gap-0.5">
            <span class="counter" data-target="150">0</span>
            <span class="text-primary font-bold">+</span>
          </h3>
          <p class="text-xs font-bold text-neutral-800 uppercase tracking-wider mt-3">Websites Delivered</p>
          <p class="text-xs text-muted mt-1 leading-normal">High-performance products built to rank and convert.</p>
        </div>

        <!-- Clients -->
        <div class="stat-card opacity-0 translate-y-12 flex flex-col bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-neutral-100/60 transition-all duration-500 hover:-translate-y-1 hover:shadow-md hover:border-primary/20 group" style="transition-delay: 150ms;">
          <h3 class="text-4xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-none flex items-baseline gap-0.5">
            <span class="counter" data-target="100">0</span>
            <span class="text-secondary font-bold">+</span>
          </h3>
          <p class="text-xs font-bold text-neutral-800 uppercase tracking-wider mt-3">Kerala Clients</p>
          <p class="text-xs text-muted mt-1 leading-normal">Trusted by local businesses and brands since 2016.</p>
        </div>

        <!-- Experience -->
        <div class="stat-card opacity-0 translate-y-12 flex flex-col bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-neutral-100/60 transition-all duration-500 hover:-translate-y-1 hover:shadow-md hover:border-primary/20 group" style="transition-delay: 300ms;">
          <h3 class="text-4xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-none flex items-baseline gap-0.5">
            <span class="counter" data-target="8">0</span>
            <span class="text-primary font-bold">+</span>
          </h3>
          <p class="text-xs font-bold text-neutral-800 uppercase tracking-wider mt-3">Years Experience</p>
          <p class="text-xs text-muted mt-1 leading-normal">Nearly a decade of delivering custom web design.</p>
        </div>

        <!-- Industries -->
        <div class="stat-card opacity-0 translate-y-12 flex flex-col bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-neutral-100/60 transition-all duration-500 hover:-translate-y-1 hover:shadow-md hover:border-primary/20 group" style="transition-delay: 450ms;">
          <h3 class="text-4xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-none flex items-baseline gap-0.5">
            <span class="counter" data-target="12">0</span>
            <span class="text-primary font-bold">+</span>
          </h3>
          <p class="text-xs font-bold text-neutral-800 uppercase tracking-wider mt-3">Industries Covered</p>
          <p class="text-xs text-muted mt-1 leading-normal">Broad sector expertise from retail to corporate portals.</p>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  // Intersection observer for scroll reveal animations and counting
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-12');
        
        // Start counter animation
        const counters = entry.target.querySelectorAll('.counter');
        counters.forEach((counter) => {
          const updateCount = () => {
            const target = +counter.getAttribute('data-target')!;
            const count = +counter.innerText;
            const inc = target / 40; // Speed adjustment

            if (count < target) {
              counter.innerText = Math.ceil(count + inc).toString();
              setTimeout(updateCount, 40);
            } else {
              counter.innerText = target.toString();
            }
          };
          updateCount();
        });
        
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });

  document.querySelectorAll('.stat-card').forEach(card => {
    observer.observe(card);
  });
</script>
