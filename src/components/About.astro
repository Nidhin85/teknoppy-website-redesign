---
import { CheckCircle, ArrowRight } from "lucide-react";
import home from "../data/home.json";
---

<section id="about" class="py-24 md:py-32 bg-cream relative overflow-hidden">
  <!-- Subtle decorative background -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div
      class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.webp')] opacity-30"
    >
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    <!-- Tier 1: Header & Key Message (Full width, centered on mobile, left-aligned on desktop) -->
    <div
      class="max-w-4xl flex flex-col items-center text-center lg:items-start lg:text-left mb-12 md:mb-16"
    >
      <!-- Badge -->
      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1"
      >
        {home.about.badge}
      </div>

      <!-- Headline -->
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-black leading-[1.1] text-black mb-8"
        data-magnetic-heading
      >
        <span class="text-primary">{home.about.headingAccent}</span> {home.about.headingRest}
      </h2>

      <!-- Main Intro Paragraph (Quote Style) -->
      <p
        class="text-xl md:text-2xl font-semibold text-black leading-snug pl-0 lg:pl-6 border-l-0 lg:border-l-4 border-secondary"
      >
        {home.about.intro}
      </p>
    </div>

    <!-- Tier 2: Details & Stats Split (2 columns on desktop) -->
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Detailed Copy (7 cols) -->
      <div
        class="lg:col-span-7 space-y-6 text-base md:text-lg text-muted text-center lg:text-left"
      >
        <p class="leading-relaxed">
          {home.about.paragraphs[0]}
        </p>
        <p class="leading-relaxed">
          {home.about.paragraphs[1]}
        </p>
      </div>

      <!-- Right Column: Stats Grid (5 cols) -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-6 w-full mt-4 lg:mt-0">
        <!-- Websites -->
        <div
          class="stat-card opacity-0 translate-y-12 flex flex-col bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-neutral-100/60 transition-all duration-500 hover:-translate-y-1 hover:shadow-md hover:border-primary/20 group"
          style="transition-delay: 0ms;"
        >
          <h3
            class="text-4xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-none flex items-baseline gap-0.5"
          >
            <span class="counter" data-target={home.about.stats[0].value}>{home.about.stats[0].value}</span>
            <span class="text-primary font-bold">{home.about.stats[0].suffix}</span>
          </h3>
          <p
            class="text-xs font-bold text-neutral-800 uppercase tracking-wider mt-3"
          >
            {home.about.stats[0].label}
          </p>
          <p class="text-xs text-muted mt-1 leading-normal">
            {home.about.stats[0].sublabel}
          </p>
        </div>

        <!-- Clients -->
        <div
          class="stat-card opacity-0 translate-y-12 flex flex-col bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-neutral-100/60 transition-all duration-500 hover:-translate-y-1 hover:shadow-md hover:border-primary/20 group"
          style="transition-delay: 150ms;"
        >
          <h3
            class="text-4xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-none flex items-baseline gap-0.5"
          >
            <span class="counter" data-target={home.about.stats[1].value}>{home.about.stats[1].value}</span>
            <span class="text-secondary font-bold">{home.about.stats[1].suffix}</span>
          </h3>
          <p
            class="text-xs font-bold text-neutral-800 uppercase tracking-wider mt-3"
          >
            {home.about.stats[1].label}
          </p>
          <p class="text-xs text-muted mt-1 leading-normal">
            {home.about.stats[1].sublabel}
          </p>
        </div>

        <!-- Experience -->
        <div
          class="stat-card opacity-0 translate-y-12 flex flex-col bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-neutral-100/60 transition-all duration-500 hover:-translate-y-1 hover:shadow-md hover:border-primary/20 group"
          style="transition-delay: 300ms;"
        >
          <h3
            class="text-4xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-none flex items-baseline gap-0.5"
          >
            <span class="counter" data-target={home.about.stats[2].value}>{home.about.stats[2].value}</span>
            <span class="text-primary font-bold">{home.about.stats[2].suffix}</span>
          </h3>
          <p
            class="text-xs font-bold text-neutral-800 uppercase tracking-wider mt-3"
          >
            {home.about.stats[2].label}
          </p>
          <p class="text-xs text-muted mt-1 leading-normal">
            {home.about.stats[2].sublabel}
          </p>
        </div>

        <!-- Industries -->
        <div
          class="stat-card opacity-0 translate-y-12 flex flex-col bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-neutral-100/60 transition-all duration-500 hover:-translate-y-1 hover:shadow-md hover:border-primary/20 group"
          style="transition-delay: 450ms;"
        >
          <h3
            class="text-4xl sm:text-5xl lg:text-6xl font-black text-black tracking-tight leading-none flex items-baseline gap-0.5"
          >
            <span class="counter" data-target={home.about.stats[3].value}>{home.about.stats[3].value}</span>
            <span class="text-primary font-bold">{home.about.stats[3].suffix}</span>
          </h3>
          <p
            class="text-xs font-bold text-neutral-800 uppercase tracking-wider mt-3"
          >
            {home.about.stats[3].label}
          </p>
          <p class="text-xs text-muted mt-1 leading-normal">
            {home.about.stats[3].sublabel}
          </p>
        </div>
      </div>
    </div>

    <!-- Contextual CTA: After Who We Are -->
    <div class="cta-reveal mt-14 pt-8 border-t border-neutral-200/70 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div class="max-w-xl">
        <p class="text-base font-bold text-neutral-900 tracking-tight">Have an idea in mind?</p>
        <p class="text-sm text-neutral-600 mt-1">Have an idea in mind? Let's turn it into a digital experience.</p>
      </div>
      <a
        href="/request-a-quote/"
        class="cta-float-secondary cta-delay-2 cta-pulse-medium cta-pulse-delay-2 cta-shimmer-btn inline-flex items-center gap-2 px-6 py-3.5 text-sm font-bold text-primary bg-primary/10 hover:bg-primary hover:text-white border border-primary/25 rounded-full transition-all duration-300 shadow-2xs hover:shadow-md hover:-translate-y-0.5 shrink-0 group"
      >
        <span>Talk to Our Experts</span>
        <ArrowRight className="cta-arrow cta-arrow-invite w-4 h-4" />
      </a>
    </div>
  </div>
</section>

<script>
  // Intersection observer for scroll reveal animations and counting
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-12");

          // Start counter animation
          const counters = entry.target.querySelectorAll(".counter");
          counters.forEach((counter) => {
            counter.innerText = "0";
            const updateCount = () => {
              const target = +counter.getAttribute("data-target")!;
              const count = +counter.innerText;
              const inc = target / 40; // Speed adjustment

              if (count < target) {
                counter.innerText = Math.ceil(count + inc).toString();
                setTimeout(updateCount, 40);
              } else {
                counter.innerText = target.toString();
              }
            };
            updateCount();
          });

          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 },
  );

  document.querySelectorAll(".stat-card").forEach((card) => {
    observer.observe(card);
  });
</script>
