---
/**
 * Dedicated Full-Width Video-Only Hero Section
 * Used on Homepage and Web Design Company in Kochi page.
 *
 * Immersive, edge-to-edge native video presentation (Finexx Travels model).
 * Strictly video only: ZERO text, ZERO buttons, ZERO floating cards, ZERO overlays.
 * Video asset: /video/Teknoppy-Web-Banner.mp4 (native 1080p, matching YouTube E8i02o3GxC0)
 * Poster asset: /video/poster.jpg
 */
interface Props {
  ariaLabel?: string;
}

const {
  ariaLabel = "Teknoppy Creative Agency Video"
} = Astro.props;
---

<section
  id="homepage-video-hero"
  class="homepage-video-hero relative w-full bg-neutral-950 overflow-hidden"
  aria-label={ariaLabel}
>
  <div class="video-container relative w-full h-[58svh] sm:h-[65svh] md:h-[75vh] lg:h-[82vh] xl:h-[88vh] overflow-hidden bg-neutral-950">
    <!-- Responsive Hero Poster (displays instantly while video is deferred: mobile gets 47KB poster, desktop gets 131KB poster) -->
    <picture class="hero-poster-picture absolute inset-0 w-full h-full pointer-events-none select-none z-0">
      <source srcset="/video/poster-mobile.webp" media="(max-width: 767px)" type="image/webp" />
      <img
        src="/video/poster.webp"
        alt=""
        aria-hidden="true"
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="sync"
        class="w-full h-full object-cover object-center"
      />
    </picture>

    <video
      id="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      disablepictureinpicture
      preload="auto"
      class="hero-video-element relative z-10 w-full h-full object-cover object-center pointer-events-none select-none block"
      aria-label={ariaLabel}
    >
      <!-- src in the markup so the download starts while the HTML is parsed, not after the stylesheets
           (inline scripts wait for CSS). The MP4 is "faststart" (index at the front): one request to play. -->
      <source src="/video/Teknoppy-Web-Banner.mp4" type="video/mp4" />
    </video>
  </div>
</section>

<script is:inline>
  (function () {
    // 1. The video is already downloading (src is in the markup). Keep the poster only for
    //    reduced-motion or data-saver visitors (stop the download), otherwise make sure it plays.
    function initHeroVideo() {
      var video = document.getElementById("hero-bg-video");
      if (!video) return;

      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var saveData = navigator.connection && (navigator.connection.saveData || /2g/.test(navigator.connection.effectiveType || ''));
      if (reduceMotion || saveData) {
        // Remove the source and reset, which aborts the download; the poster stays visible.
        video.removeAttribute("autoplay");
        video.pause();
        video.querySelectorAll("source").forEach(function (s) { s.remove(); });
        video.removeAttribute("src");
        video.load();
        video.style.display = "none";
        return;
      }

      video.muted = true;
      video.defaultMuted = true;
      video.setAttribute("muted", "");
      video.playsInline = true;

      // Autoplay without any user gesture: try now, and again as soon as the browser has data
      // (some mobile browsers reject play() until the first frame is decoded) and when the tab
      // becomes visible again. No touch/scroll triggers. No video.load(): that would restart the download.
      var tryPlay = function () {
        if (!video.paused) return;
        var p = video.play();
        if (p && p.catch) p.catch(function () { /* blocked (e.g. iOS Low Power Mode): poster stays */ });
      };
      tryPlay();
      video.addEventListener("loadeddata", tryPlay, { once: true });
      video.addEventListener("canplay", tryPlay, { once: true });
      document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "visible") tryPlay();
      });
    }

    // Start immediately on desktop and mobile; the poster stays visible until the first frame plays.
    // This inline script runs right after the <video> markup, so the element already exists.
    initHeroVideo();

    // 2. Hide floating CTA, WhatsApp FAB & bottom action bar while video hero is in view so the video remains completely unobstructed
    function initFloatingObserver() {
      var hero = document.getElementById("homepage-video-hero");
      var floatingCta = document.getElementById("global-floating-cta-wrap");
      var whatsappFab = document.querySelector(".whatsapp-fab");
      var bottomBar = document.querySelector(".fixed-bottom-bar");

      if (!hero) return;

      var setVisible = function (show) {
        if (floatingCta) {
          floatingCta.style.transition = "opacity 0.35s ease, transform 0.35s ease, visibility 0.35s";
          floatingCta.style.opacity = show ? "1" : "0";
          floatingCta.style.transform = show ? "translateY(0)" : "translateY(24px)";
          floatingCta.style.pointerEvents = show ? "auto" : "none";
          floatingCta.style.visibility = show ? "visible" : "hidden";
        }
        if (whatsappFab) {
          whatsappFab.style.transition = "opacity 0.35s ease, transform 0.35s ease, visibility 0.35s";
          whatsappFab.style.opacity = show ? "1" : "0";
          whatsappFab.style.transform = show ? "translateY(0)" : "translateY(24px)";
          whatsappFab.style.pointerEvents = show ? "auto" : "none";
          whatsappFab.style.visibility = show ? "visible" : "hidden";
        }
        if (bottomBar) {
          bottomBar.style.transition = "opacity 0.35s ease, transform 0.35s ease, visibility 0.35s";
          bottomBar.style.opacity = show ? "1" : "0";
          bottomBar.style.transform = show ? "translateY(0)" : "translateY(100%)";
          bottomBar.style.pointerEvents = show ? "auto" : "none";
          bottomBar.style.visibility = show ? "visible" : "hidden";
        }
      };

      // Initially hide on top of page
      if (window.scrollY < 150) {
        setVisible(false);
      }

      if ("IntersectionObserver" in window) {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting && entry.intersectionRatio > 0.15) {
                setVisible(false);
              } else {
                setVisible(true);
              }
            });
          },
          { threshold: [0, 0.15, 0.5] }
        );
        observer.observe(hero);
      } else {
        window.addEventListener(
          "scroll",
          function () {
            var rect = hero.getBoundingClientRect();
            setVisible(rect.bottom <= 120);
          },
          { passive: true }
        );
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initFloatingObserver);
    } else {
      initFloatingObserver();
    }
  })();
</script>

<style>
  .homepage-video-hero {
    /* Offset fixed header smoothly */
    padding-top: 67px;
    margin: 0;
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .homepage-video-hero {
      padding-top: 73px;
    }
  }

  @media (min-width: 1024px) {
    .homepage-video-hero {
      padding-top: 77px;
    }
  }

  /* Phones: size the frame to the landscape video (16:9) so the whole picture shows,
     no crop and no letterbox. Tablet/desktop heights (md: and up) are untouched. */
  @media (max-width: 767px) {
    .video-container {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-element {
      display: none !important;
    }
  }
</style>
