---
/**
 * Dedicated Full-Width Video-Only Hero Section
 * Used on Homepage and Web Design Company in Kochi page.
 *
 * Immersive, edge-to-edge native video presentation (Finexx Travels model).
 * Strictly video only: ZERO text, ZERO buttons, ZERO floating cards, ZERO overlays.
 * Video asset: /video/Teknoppy-Web-Banner.mp4 (native 1080p, matching YouTube E8i02o3GxC0)
 * Poster asset: /video/poster.jpg
 */
interface Props {
  ariaLabel?: string;
}

const {
  ariaLabel = "Teknoppy Creative Agency Video"
} = Astro.props;
---

<section
  id="homepage-video-hero"
  class="homepage-video-hero relative w-full bg-neutral-950 overflow-hidden"
  aria-label={ariaLabel}
>
  <div class="video-container relative w-full h-[58svh] sm:h-[65svh] md:h-[75vh] lg:h-[82vh] xl:h-[88vh] overflow-hidden bg-neutral-950">
    <!-- Responsive Hero Poster (displays instantly while video is deferred: mobile gets 47KB poster, desktop gets 131KB poster) -->
    <picture class="hero-poster-picture absolute inset-0 w-full h-full pointer-events-none select-none z-0">
      <source srcset="/video/poster-mobile.webp" media="(max-width: 767px)" type="image/webp" />
      <img
        src="/video/poster.webp"
        alt=""
        aria-hidden="true"
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="sync"
        class="w-full h-full object-cover object-center"
      />
    </picture>

    <video
      id="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      class="hero-video-element relative z-10 w-full h-full object-cover object-center pointer-events-none select-none block"
      aria-label={ariaLabel}
      data-src="/video/Teknoppy-Web-Banner.mp4"
    >
      <source data-src="/video/Teknoppy-Web-Banner.mp4" type="video/mp4" />
    </video>
  </div>
</section>

<script is:inline>
  (function () {
    // 1. Defer heavy background video until after critical page load (ensures FCP & LCP are instant)
    function initHeroVideo() {
      // Respect prefers-reduced-motion
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }
      // If user has data saver enabled, keep the lightweight crisp poster
      if (navigator.connection && (navigator.connection.saveData || /2g/.test(navigator.connection.effectiveType || ''))) {
        return;
      }

      var video = document.getElementById("hero-bg-video");
      if (!video) return;

      var source = video.querySelector("source");
      var videoSrc = (source && source.getAttribute("data-src")) || video.getAttribute("data-src");
      if (!videoSrc) return;

      if (source && !source.src) {
        source.src = videoSrc;
      } else if (!video.src) {
        video.src = videoSrc;
      }

      video.muted = true;
      video.defaultMuted = true;
      video.load();

      var playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(function () {
          var resume = function () {
            video.play();
            window.removeEventListener("touchstart", resume);
            window.removeEventListener("scroll", resume);
            window.removeEventListener("click", resume);
          };
          window.addEventListener("touchstart", resume, { passive: true });
          window.addEventListener("scroll", resume, { passive: true });
          window.addEventListener("click", resume, { passive: true });
        });
      }
    }

    var isMobile = window.matchMedia && window.matchMedia('(max-width: 767px)').matches;

    if (isMobile) {
      // Mobile: Defer heavy 36.8MB video until first user interaction (touch/scroll) or network idle
      // Prevents saturating mobile data and throttling mobile CPU on initial paint
      var mobileStarted = false;
      var triggerMobileVideo = function() {
        if (mobileStarted) return;
        mobileStarted = true;
        window.removeEventListener('touchstart', triggerMobileVideo);
        window.removeEventListener('scroll', triggerMobileVideo);
        window.removeEventListener('click', triggerMobileVideo);
        initHeroVideo();
      };
      window.addEventListener('touchstart', triggerMobileVideo, { passive: true });
      window.addEventListener('scroll', triggerMobileVideo, { passive: true });
      window.addEventListener('click', triggerMobileVideo, { passive: true });
    } else {
      // Desktop: Start after critical page load & idle
      if (document.readyState === 'complete') {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(initHeroVideo, { timeout: 1500 });
        } else {
          setTimeout(initHeroVideo, 600);
        }
      } else {
        window.addEventListener('load', function() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(initHeroVideo, { timeout: 1500 });
          } else {
            setTimeout(initHeroVideo, 600);
          }
        });
      }
    }

    // 2. Hide floating CTA, WhatsApp FAB & bottom action bar while video hero is in view so the video remains completely unobstructed
    function initFloatingObserver() {
      var hero = document.getElementById("homepage-video-hero");
      var floatingCta = document.getElementById("global-floating-cta-wrap");
      var whatsappFab = document.querySelector(".whatsapp-fab");
      var bottomBar = document.querySelector(".fixed-bottom-bar");

      if (!hero) return;

      var setVisible = function (show) {
        if (floatingCta) {
          floatingCta.style.transition = "opacity 0.35s ease, transform 0.35s ease, visibility 0.35s";
          floatingCta.style.opacity = show ? "1" : "0";
          floatingCta.style.transform = show ? "translateY(0)" : "translateY(24px)";
          floatingCta.style.pointerEvents = show ? "auto" : "none";
          floatingCta.style.visibility = show ? "visible" : "hidden";
        }
        if (whatsappFab) {
          whatsappFab.style.transition = "opacity 0.35s ease, transform 0.35s ease, visibility 0.35s";
          whatsappFab.style.opacity = show ? "1" : "0";
          whatsappFab.style.transform = show ? "translateY(0)" : "translateY(24px)";
          whatsappFab.style.pointerEvents = show ? "auto" : "none";
          whatsappFab.style.visibility = show ? "visible" : "hidden";
        }
        if (bottomBar) {
          bottomBar.style.transition = "opacity 0.35s ease, transform 0.35s ease, visibility 0.35s";
          bottomBar.style.opacity = show ? "1" : "0";
          bottomBar.style.transform = show ? "translateY(0)" : "translateY(100%)";
          bottomBar.style.pointerEvents = show ? "auto" : "none";
          bottomBar.style.visibility = show ? "visible" : "hidden";
        }
      };

      // Initially hide on top of page
      if (window.scrollY < 150) {
        setVisible(false);
      }

      if ("IntersectionObserver" in window) {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting && entry.intersectionRatio > 0.15) {
                setVisible(false);
              } else {
                setVisible(true);
              }
            });
          },
          { threshold: [0, 0.15, 0.5] }
        );
        observer.observe(hero);
      } else {
        window.addEventListener(
          "scroll",
          function () {
            var rect = hero.getBoundingClientRect();
            setVisible(rect.bottom <= 120);
          },
          { passive: true }
        );
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initFloatingObserver);
    } else {
      initFloatingObserver();
    }
  })();
</script>

<style>
  .homepage-video-hero {
    /* Offset fixed header smoothly */
    padding-top: 67px;
    margin: 0;
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .homepage-video-hero {
      padding-top: 73px;
    }
  }

  @media (min-width: 1024px) {
    .homepage-video-hero {
      padding-top: 77px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-element {
      display: none !important;
    }
  }
</style>
