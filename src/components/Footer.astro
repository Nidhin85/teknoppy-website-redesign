---
/**
 * Full site footer — sits below the FooterCTA block on every page.
 *
 * Link columns come from `src/data/footer.json` so they stay CMS-editable.
 * Only pages that actually exist are listed; add rows as new pages ship.
 */
import { Phone, Mail, MapPin, ArrowUpRight } from 'lucide-react';
import site from '../data/site.json';
import footer from '../data/footer.json';

const year = new Date().getFullYear();

// Social icons render only when a real URL is configured — placeholder "#"
// entries are skipped rather than shown as dead links.
const socials = [
  {
    name: 'LinkedIn',
    url: site.social.linkedin,
    path: 'M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z'
  },
  {
    name: 'Instagram',
    url: site.social.instagram,
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z'
  },
  {
    name: 'X',
    url: site.social.twitter,
    path: 'M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z'
  }
].filter((s) => s.url && s.url !== '#');

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname === href || pathname === href.replace(/\/$/, '');
---

<footer class="theme-keep-light bg-neutral-950 text-white relative overflow-hidden">
  <!-- Subtle grid + warm glow, matching the dark hero treatment -->
  <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:56px_56px]"></div>
  <div class="absolute -top-32 -left-24 w-[420px] h-[420px] rounded-full bg-primary/10 blur-[120px] pointer-events-none"></div>

  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 relative z-10">

    <!-- MAIN GRID -->
    <div class="grid gap-12 lg:gap-16 lg:grid-cols-12 py-16 lg:py-20">

      <!-- Brand + NAP -->
      <div class="lg:col-span-4 space-y-8">
        <a href="/" class="inline-flex items-baseline gap-1 group">
          <span class="text-2xl font-black tracking-tighter text-white">TEKNOPPY</span>
          <span class="w-1.5 h-1.5 rounded-full bg-primary group-hover:scale-125 transition-transform"></span>
        </a>

        <p class="text-sm text-neutral-400 font-medium leading-relaxed max-w-sm">
          {footer.tagline}
        </p>

        <address class="not-italic space-y-4">
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0 text-primary">
              <MapPin className="w-3.5 h-3.5" />
            </span>
            <span class="text-sm text-neutral-400 font-medium leading-relaxed pt-1.5">{site.address}</span>
          </div>
          <a href={`tel:${site.phoneLink}`} class="flex items-center gap-3 group w-fit">
            <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
              <Phone className="w-3.5 h-3.5" />
            </span>
            <span class="text-sm text-neutral-300 font-semibold group-hover:text-white transition-colors">{site.phone}</span>
          </a>
          <a href={`mailto:${site.email}`} class="flex items-center gap-3 group w-fit">
            <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
              <Mail className="w-3.5 h-3.5" />
            </span>
            <span class="text-sm text-neutral-300 font-semibold group-hover:text-white transition-colors">{site.email}</span>
          </a>
        </address>

        <div class="flex items-center gap-3 pt-2">
          <a
            href={`https://wa.me/${site.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#25D366]/10 border border-[#25D366]/25 text-[#25D366] text-xs font-bold hover:bg-[#25D366]/20 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            WhatsApp
          </a>

          {socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.name}
              class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-neutral-400 hover:text-primary hover:border-primary/30 transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.path} /></svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Link columns -->
      <div class="lg:col-span-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3">
        {footer.columns.map((col) => (
          <nav class="space-y-4" aria-label={col.heading}>
            <h2 class="text-[12px] font-black text-primary uppercase tracking-[0.15em]">{col.heading}</h2>
            <ul class="space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                    class={`text-sm font-medium transition-colors inline-flex items-start gap-1 group ${
                      isCurrent(link.href) ? 'text-primary' : 'text-neutral-400 hover:text-white'
                    }`}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <!-- SERVICE AREA STRIP -->
    <div class="border-t border-white/10 py-8 flex flex-col lg:flex-row lg:items-center gap-4 lg:gap-8">
      <span class="text-[12px] font-black text-neutral-500 uppercase tracking-[0.15em] flex-shrink-0">Areas We Serve</span>
      <p class="text-sm text-neutral-400 font-medium leading-relaxed">{footer.serviceAreas}</p>
    </div>

    <!-- BOTTOM BAR -->
    <div class="border-t border-white/10 py-8 flex flex-col md:flex-row md:items-center justify-between gap-5">
      <p class="text-xs text-neutral-500 font-medium">
        &copy; {year} {site.businessName}. All rights reserved. Established {site.established}, Kochi, Kerala.
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {footer.legal.map((item) => (
          <a href={item.href} class="text-xs text-neutral-500 font-medium hover:text-neutral-300 transition-colors">{item.label}</a>
        ))}
        <a href="#top" class="text-xs text-neutral-500 font-medium hover:text-primary transition-colors inline-flex items-center gap-1">
          Back to top
          <ArrowUpRight className="w-3 h-3" />
        </a>
      </div>
    </div>
  </div>
</footer>
