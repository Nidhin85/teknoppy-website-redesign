---
import { PORTFOLIO_PROJECTS } from '../../data/portfolioItems';

// Select projects for Hero scrolling columns
const colA = PORTFOLIO_PROJECTS.slice(0, 6);
const colB = PORTFOLIO_PROJECTS.slice(6, 12);
---

<header class="pf-hero" id="top">
  <div class="wrap pf-hgrid">
    <div>
      <div class="pf-crumb pf-fadeup" style="--d:1">
        <a href="/">Home</a>
        <span>/</span>
        <span class="text-neutral-900 font-semibold">Portfolio</span>
      </div>
      
      <span class="pf-tag pf-fadeup" style="--d:1">
        Our work · 2018 to 2026
      </span>
      
      <h1 class="pf-fadeup" style="--d:2">
        Websites that help businesses 
        <span class="pf-rot" id="rot">
          <span class="on">grow.</span>
          <span>rank.</span>
          <span>sell.</span>
          <span>stand out.</span>
          <svg viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true">
            <path d="M3 11 C 80 3, 200 3, 297 9" />
          </svg>
        </span>
      </h1>
      
      <p class="lead pf-fadeup" style="--d:3">
        A selection of the 120+ websites, online stores, SEO campaigns, and custom web applications our in-house team in Vyttila, Kochi has delivered for clients across Kerala, the UAE, and Qatar.
      </p>
      
      <div class="pf-ctas pf-fadeup" style="--d:4">
        <a class="pf-btn pf-btn-primary" href="#work">
          Browse projects <span class="arr">↓</span>
        </a>
        <a class="pf-btn pf-btn-ghost" href="/case-study/">
          See case studies
        </a>
      </div>
      
      <div class="pf-hstats pf-fadeup" style="--d:5">
        <div>
          <i class="pf-sic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg></i>
          <b><span class="cnt" data-to="120">120</span><em>+</em></b>
          <small>Websites delivered</small>
        </div>
        <div>
          <i class="pf-sic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></i>
          <b><span class="cnt" data-to="8">8</span></b>
          <small>Since 2018</small>
        </div>
        <div>
          <i class="pf-sic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></i>
          <b><span class="cnt" data-to="3">3</span></b>
          <small>Countries served</small>
        </div>
      </div>
    </div>
    
    <div class="pf-hwrap pf-fadeup" style="--d:3">
      <div class="pf-float f1">
        <span class="ic">↗</span>
        <span>
          <i class="pf-fill">+212%</i> organic traffic
          <small>Healthcare & Clinic SEO, Kerala</small>
        </span>
      </div>
      
      <div class="pf-float f2">
        <span class="ic">⚡</span>
        <span>
          PageSpeed <i class="pf-fill">96</i>
          <small>Every build tested before launch</small>
        </span>
      </div>
      
      <!-- Laptop showcase (decorative; reuses existing project screenshots) -->
      <div class="pf-lapshow" aria-hidden="true">
        <span class="arc"></span>
        <span class="spark"><i></i><i></i><i></i></span>
        <div class="side l"><div class="bar"><i></i><i></i><i></i></div><img src="/case-studies/olivesresort.webp" alt="" loading="eager" /></div>
        <div class="side r"><div class="bar"><i></i><i></i><i></i></div><img src="/case-studies/visakh-rj-web-design.webp" alt="" loading="eager" /></div>
        <div class="lap"><div class="scr"><img src="/case-studies/lenaalife-desktop.webp" alt="" loading="eager" /></div><div class="base"></div></div>
      </div>
      <div class="pf-cols" aria-hidden="true">
        <!-- Column 1 (Scrolls Up) -->
        <div class="col">
          <div class="pf-track" id="t1">
            {[...colA, ...colA].map((p, idx) => (
              <div class="pf-mini">
                <div class="bar">
                  <i></i><i></i><i></i>
                </div>
                <div class={`thumb ${idx % 2 === 1 ? 'tall' : ''}`}>
                  <img src={p.image} alt={p.name} loading="eager" />
                </div>
                <p>
                  <span>{p.name}</span>
                  <small>{p.location.split(',')[0]}</small>
                </p>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Column 2 (Scrolls Down) -->
        <div class="col">
          <div class="pf-track" id="t2">
            {[...colB, ...colB].map((p, idx) => (
              <div class="pf-mini">
                <div class="bar">
                  <i></i><i></i><i></i>
                </div>
                <div class={`thumb ${idx % 2 === 0 ? 'tall' : ''}`}>
                  <img src={p.image} alt={p.name} loading="eager" />
                </div>
                <p>
                  <span>{p.name}</span>
                  <small>{p.location.split(',')[0]}</small>
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
