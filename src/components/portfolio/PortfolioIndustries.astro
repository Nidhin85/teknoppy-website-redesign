---
// Industries Section with Upward Color Reveals
const industries = [
  {
    name: 'Real estate & builders',
    count: '14 projects',
    icon: '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>'
  },
  {
    name: 'Healthcare & clinics',
    count: '18 projects',
    icon: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/><path d="M8 11h2l1-2 2 4 1-2h2"/>'
  },
  {
    name: 'Retail & e-commerce',
    count: '24 projects',
    icon: '<path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>'
  },
  {
    name: 'Hospitality & travel',
    count: '16 projects',
    icon: '<path d="M2 15l20-7-8 13-2-6z"/>'
  },
  {
    name: 'Education & edutech',
    count: '11 projects',
    icon: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/>'
  },
  {
    name: 'Logistics & industrial',
    count: '15 projects',
    icon: '<path d="M2 6h11v10H2zM13 10h5l3 3v3h-8z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>'
  },
  {
    name: 'Restaurants & cafés',
    count: '12 projects',
    icon: '<path d="M4 8h13v5a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6z"/><path d="M17 10h2a2 2 0 0 1 0 4h-2"/>'
  },
  {
    name: 'Professional services',
    count: '19 projects',
    icon: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5h6v2M3 13h18"/>'
  }
];
---

<section id="industries" class="pf-section">
  <div class="wrap">
    <div class="pf-head pf-rv">
      <div>
        <span class="pf-tag">Industries</span>
        <h2>Who we've built for</h2>
      </div>
      <p>
        We've worked across many sectors in Kerala and the GCC, so we usually already understand what your customers search for and what makes them pick up the phone.
      </p>
    </div>

    <div class="pf-ind" id="ind">
      {industries.map((ind, i) => (
        <div class="pf-it pf-rv" style={`--d:${i % 4}`}>
          <span class="ico">
            <svg 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="1.8" 
              stroke-linejoin="round" 
              stroke-linecap="round"
              set:html={ind.icon}
            />
          </span>
          <div>
            <b>{ind.name}</b>
            <small><i class="pf-fill">{ind.count}</i></small>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
