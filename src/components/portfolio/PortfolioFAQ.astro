---
// Portfolio FAQ Accordion Component
const faqs = [
  {
    q: "What types of projects are in Teknoppy's portfolio?",
    a: "Business websites, WordPress and WooCommerce sites, Shopify stores, web applications and SEO projects for clients in Kerala, the UAE and Qatar. Use the filters to view work by service or region."
  },
  {
    q: "Can I see work from my industry?",
    a: "Check the industries section or filter the grid. If your sector is not shown, ask us and we will share relevant work that is not published here, subject to client agreements."
  },
  {
    q: "Are these live client websites?",
    a: "Each card links to the client's live site or to a preview of the build. Where an agreement limits public display, we link to the case study instead."
  },
  {
    q: "How are the results measured?",
    a: "Each result comes from a stated source such as Google Analytics, Search Console or PageSpeed Insights, over the period shown in the case study. Results vary by project and are not guaranteed."
  },
  {
    q: "Where are Teknoppy's clients based?",
    a: "Teknoppy is based in Vyttila, Kochi. Clients are in Kerala, the UAE, Qatar and other regions listed in the case studies."
  },
  {
    q: "Where can I read the full case studies?",
    a: "Open any project to reach its case study, or browse all case studies. Each covers the brief, what we built and the measured result."
  }
];
---

<section id="faq" class="pf-section" style="padding-top: 20px;">
  <div class="wrap pf-faqw">
    <!-- Sticky Sidebar -->
    <div class="side pf-rv">
      <span class="pf-tag">FAQ</span>
      <h2>Portfolio FAQs</h2>
      <p>
        Straightforward answers to the most common questions clients ask before starting a project with our Kochi studio.
      </p>
      
      <div class="pf-ask">
        <b>Want to see more work?</b>
        <p>
          We can share specialized projects in your industry that aren't publicly published here, during a call or in person at our Vyttila office.
        </p>
        <a class="pf-btn pf-btn-primary" href="#contact">
          Ask for examples <span class="arr">→</span>
        </a>
      </div>
    </div>

    <!-- Accordion List -->
    <div class="pf-acc pf-rv" style="--d:1">
      {faqs.map((faq, idx) => (
        <div class={`pf-qa ${idx === 0 ? 'open' : ''}`}>
          <button 
            type="button" 
            aria-expanded={idx === 0 ? "true" : "false"}
            aria-controls={`pf-ans-${idx}`}
          >
            {faq.q}
            <span class="pf-pm" aria-hidden="true"></span>
          </button>
          <div class="pf-ans" id={`pf-ans-${idx}`}>
            <div>
              <p>{faq.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
