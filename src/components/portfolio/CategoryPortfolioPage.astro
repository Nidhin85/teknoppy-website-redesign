---
/**
 * Standardized Category Portfolio Page component.
 * Follows the visual design, grid structure, typography, and card layout of /portfolios/website-projects/
 * while preserving each category's specific content, SEO metadata, schemas, and supporting sections.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import FooterCTA from '../FooterCTA.astro';
import CategoryPortfolioExplorer, { 
  type PortfolioProjectItem, 
  type CategoryFilterItem 
} from './CategoryPortfolioExplorer.tsx';
import { ShieldCheck, Layers, Sparkles, ArrowRight } from 'lucide-react';

interface Props {
  page: any;
  canonicalPath: string;
}

const { page, canonicalPath } = Astro.props;
const sections = page.sections ?? [];

const hero = sections.find((s: any) => s.type === 'hero');
const linkGroupsSection = sections.find((s: any) => s.type === 'linkGroups');
const cardsSection = sections.find((s: any) => s.type === 'cards');
const proseSection = sections.find((s: any) => s.type === 'prose');
const faqSection = sections.find((s: any) => s.type === 'faq');

// Extract projects from linkGroups
const groups = linkGroupsSection?.groups ?? [];
const projects: PortfolioProjectItem[] = [];

groups.forEach((g: any) => {
  (g.items ?? []).forEach((item: any, idx: number) => {
    let imageSrc = item.image;
    if (!imageSrc) {
      if (item.label.toLowerCase().includes('direction north')) {
        imageSrc = '/case-studies/direction-north.webp';
      } else if (item.label.toLowerCase().includes('olives')) {
        imageSrc = '/case-studies/olivesresort.webp';
      }
    }

    const catSlug = g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');

    projects.push({
      id: `${catSlug}-${idx}-${item.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
      name: item.label,
      industryLabel: item.text,
      href: item.href,
      image: imageSrc,
      imageAlt: item.imageAlt || `${item.label} website screenshot`,
      category: g.title,
      categories: [catSlug]
    });
  });
});

// Category filter tabs (only generated if multiple groups exist)
const filterCategories: CategoryFilterItem[] = groups.length > 1
  ? [
      { id: 'all', label: 'All Projects', slug: 'all' },
      ...groups.map((g: any) => ({
        id: g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
        label: g.title,
        slug: g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')
      }))
    ]
  : [];

// Schema markup
const pageSchema = page.schema;
const faqSchema = faqSection && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqSection.items.map((f: any) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = page.breadcrumb && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": page.breadcrumb.map((c: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": c.name,
    "item": `https://teknoppy.com${c.href}`
  }))
};

const ogImage = projects[0]?.image || '/portfolios/website/general-tech-services.webp';
---

<Layout title={page.meta.title} description={page.meta.description} image={ogImage}>
  <Fragment slot="head">
    {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  </Fragment>

  <!-- Global Header with solid background for inner pages -->
  <Header forceSolidBg={true} />

  <main class="ds-ambient min-h-screen bg-[#fcfaf7] text-neutral-900 pt-28 sm:pt-32 md:pt-36 pb-20 sm:pb-28">
    <div class="max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">

      {/* =========================================================================
          HERO SECTION (Standardized to Website Projects style)
          ========================================================================= */}
      {hero && (
        <section class="text-center pt-4 sm:pt-6 pb-8 sm:pb-12">
          {/* Eyebrow badge */}
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#F05A2C]/10 border border-[#F05A2C]/20 text-[#F05A2C] text-xs font-bold uppercase tracking-wider mb-4 shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[#F05A2C] animate-pulse"></span>
            <span>{hero.badge || "OUR WORK"}</span>
          </div>

          {/* Main Heading */}
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-neutral-900 leading-[1.12] max-w-4xl mx-auto">
            {hero.h1Lead}{hero.h1Lead && ' '}<span class="text-[#F05A2C]">{hero.h1Accent}</span>{hero.h1Rest && ` ${hero.h1Rest}`}
          </h1>

          {/* Short Description */}
          {hero.body && hero.body.length > 0 && (
            <div class="mt-4 sm:mt-5 text-sm sm:text-base md:text-lg text-neutral-600 max-w-2xl mx-auto leading-relaxed font-normal space-y-3">
              {hero.body.map((p: any) => (
                p.html
                  ? <p set:html={p.html} />
                  : <p>{p.text ?? p}</p>
              ))}
            </div>
          )}
        </section>
      )}

      {/* =========================================================================
          PORTFOLIO EXPLORER (FILTERS + 2-COL IMAGE-FIRST GRID)
          ========================================================================= */}
      <CategoryPortfolioExplorer 
        client:load 
        projects={projects} 
        filterCategories={filterCategories} 
      />

      {/* =========================================================================
          SERVICES BEHIND THIS WORK (Category-specific cards preserved)
          ========================================================================= */}
      {cardsSection && cardsSection.items && cardsSection.items.length > 0 && (
        <section class="mt-20 sm:mt-24 pt-12 border-t border-neutral-200/80">
          <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-neutral-900 tracking-tight">
              {cardsSection.h2}
            </h2>
            {cardsSection.intro && (
              <p class="mt-3 text-sm sm:text-base text-neutral-600 leading-relaxed font-normal">
                {cardsSection.intro}
              </p>
            )}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {cardsSection.items.map((item: any) => (
              <a
                href={item.href}
                class="group bg-white rounded-2xl p-6 border border-neutral-200/80 hover:border-neutral-300 shadow-[0_2px_14px_rgba(0,0,0,0.03)] hover:shadow-[0_12px_32px_rgba(0,0,0,0.07)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
              >
                <div>
                  <h3 class="text-base sm:text-lg font-bold text-neutral-900 group-hover:text-[#F05A2C] transition-colors mb-2">
                    {item.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal">
                    {item.text}
                  </p>
                </div>
                {item.linkText && (
                  <div class="mt-4 pt-3 border-t border-neutral-100 flex items-center justify-between text-xs font-bold text-[#F05A2C]">
                    <span>{item.linkText.replace('→', '').trim()}</span>
                    <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      {/* =========================================================================
          ABOUT THESE BUILDS / PROSE SECTION
          ========================================================================= */}
      {proseSection && proseSection.paragraphs && (
        <section class="mt-16 sm:mt-20 bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-10 border border-neutral-200/80 shadow-[0_2px_14px_rgba(0,0,0,0.03)]">
          <h2 class="text-xl sm:text-2xl font-black text-neutral-900 tracking-tight mb-4">
            {proseSection.h2}
          </h2>
          <div class="space-y-4 text-sm sm:text-base text-neutral-600 leading-relaxed font-normal">
            {proseSection.paragraphs.map((p: any) => (
              <p set:html={p.html || p.text} />
            ))}
          </div>
        </section>
      )}

      {/* =========================================================================
          FAQS (Interactive Accordion)
          ========================================================================= */}
      {faqSection && faqSection.items && faqSection.items.length > 0 && (
        <section class="mt-16 sm:mt-20">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="inline-block text-[#F05A2C] text-xs font-bold uppercase tracking-wider mb-2">
              {faqSection.badge || "HAVE QUESTIONS?"}
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-neutral-900 tracking-tight">
              {faqSection.h2 || "Frequently Asked Questions"}
            </h2>
          </div>
          <div class="max-w-3xl mx-auto space-y-4">
            {faqSection.items.map((item: any) => (
              <details class="group bg-white rounded-2xl border border-neutral-200/80 p-5 sm:p-6 [&_summary::-webkit-details-marker]:hidden shadow-[0_2px_14px_rgba(0,0,0,0.03)] hover:border-neutral-300 transition-colors">
                <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
                  <h3 class="text-sm sm:text-base font-bold text-neutral-900 pr-4">
                    {item.q}
                  </h3>
                  <span class="w-6 h-6 rounded-full bg-neutral-100 group-open:bg-[#F05A2C]/10 text-neutral-500 group-open:text-[#F05A2C] flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-open:-rotate-180">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </span>
                </summary>
                <div class="mt-3 pt-3 border-t border-neutral-100 text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal">
                  {item.aHtml ? <Fragment set:html={item.aHtml} /> : item.a}
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      {/* =========================================================================
          TRUST / VALUE PROPOSITION STRIP (Exact match to Website Projects)
          ========================================================================= */}
      <section class="mt-20 sm:mt-28 pt-12 border-t border-neutral-200/80">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="bg-white rounded-2xl p-6 sm:p-7 border border-neutral-200/60 shadow-xs flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-[#F05A2C]/10 text-[#F05A2C] flex items-center justify-center flex-shrink-0">
              <Sparkles className="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-bold text-neutral-900 mb-1">In-House Design & Code</h3>
              <p class="text-xs sm:text-sm text-neutral-500 leading-relaxed font-normal">
                Every project is crafted by senior engineers and UI/UX designers, not outsourced to rotating freelancers.
              </p>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 sm:p-7 border border-neutral-200/60 shadow-xs flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-[#F05A2C]/10 text-[#F05A2C] flex items-center justify-center flex-shrink-0">
              <Layers className="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-bold text-neutral-900 mb-1">Tailored Architecture</h3>
              <p class="text-xs sm:text-sm text-neutral-500 leading-relaxed font-normal">
                Structured around real commercial sales funnels, high performance, and clean SEO crawlability from day one.
              </p>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 sm:p-7 border border-neutral-200/60 shadow-xs flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-[#F05A2C]/10 text-[#F05A2C] flex items-center justify-center flex-shrink-0">
              <ShieldCheck className="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-bold text-neutral-900 mb-1">Kerala & GCC Proven</h3>
              <p class="text-xs sm:text-sm text-neutral-500 leading-relaxed font-normal">
                Trusted by corporate, healthcare, finance, and ecommerce enterprises across Kerala, UAE, and Qatar.
              </p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  {/* Contact Consultation Form & Global Footer */}
  <FooterCTA />
</Layout>
