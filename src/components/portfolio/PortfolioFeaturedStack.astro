---
// Stacked Featured Case Studies Component with Sticky Overlapping Cards
---

<section id="featured" class="pf-featured-section">
  <div class="wrap">
    <div class="pf-head pf-rv">
      <div>
        <span class="pf-tag">Case studies</span>
        <h2>Case Study Highlights With Measured Results</h2>
      </div>
      <p>
        The brief, what we built, how we ranked it, and what changed for the business — with verified numbers to show it. 
        <a href="/case-study/" style="color:var(--pf-orange);font-weight:800">
          See all case studies →
        </a>
      </p>
    </div>

    <div class="pf-stack" id="stack">
      <!-- Card 01: Lenaa -->
      <article class="pf-sc" style="--i:0">
        <span class="num">01</span>
        <div class="pf-sct">
          <span class="pf-tag">Media &amp; Celebrity · Kerala</span>
          <h3>A celebrity personal brand platform engineered to captivate</h3>
          <p>
            A high-performance digital ecosystem for <i class="pf-fill">Lenaa</i>, unifying cinema releases, bestselling book tours, TEDx speaking engagements, and direct press relations under one authoritative brand.
          </p>
          <div class="pf-scm">
            <div>
              <b><i class="pf-fill">100K+</i></b>
              <small>Monthly reach</small>
            </div>
            <div>
              <b><i class="pf-fill">98/100</i></b>
              <small>Mobile PageSpeed</small>
            </div>
            <div>
              <b><i class="pf-fill">#1</i></b>
              <small>Celebrity platform</small>
            </div>
          </div>
          <a class="pf-btn pf-btn-primary" href="/lenaa-personal-brand-website-case-study/">
            Read case study <span class="arr">→</span>
          </a>
        </div>
        <div class="pf-dev">
          <div class="lap">
            <div class="bar"><i></i><i></i><i></i></div>
            <div class="screen">
              <img src="/case-studies/lenaalife-desktop.webp" alt="Lenaa desktop homepage" loading="lazy" />
            </div>
          </div>
          <div class="phone">
            <div class="screen">
              <img src="/case-studies/lenaalife-mobile.webp" alt="Lenaa mobile website" loading="lazy" />
            </div>
          </div>
        </div>
      </article>

      <!-- Card 02: General Tech Services -->
      <article class="pf-sc t2" style="--i:1">
        <span class="num">02</span>
        <div class="pf-sct">
          <span class="pf-tag">Industrial &amp; Calibration · UAE</span>
          <h3>Transforming complex technical testing into qualified B2B inquiries</h3>
          <p>
            Complete restructuring of 40+ calibration services for <i class="pf-fill">General Tech Services</i>, capturing high-intent procurement searches across Dubai, Sharjah, and Abu Dhabi.
          </p>
          <div class="pf-scm">
            <div>
              <b><i class="pf-fill">+180%</i></b>
              <small>Organic RFQ leads</small>
            </div>
            <div>
              <b><i class="pf-fill">30+</i></b>
              <small>Page 1 Gulf rankings</small>
            </div>
            <div>
              <b><i class="pf-fill">1.4s</i></b>
              <small>Mobile load time</small>
            </div>
          </div>
          <a class="pf-btn pf-btn-primary" href="/case-studies/general-tech-services-web-design/">
            Read case study <span class="arr">→</span>
          </a>
        </div>
        <div class="pf-dev">
          <div class="lap">
            <div class="bar"><i></i><i></i><i></i></div>
            <div class="screen">
              <img src="/case-studies/generaltech.webp" alt="General Tech Services desktop portal" loading="lazy" />
            </div>
          </div>
          <div class="phone">
            <div class="screen">
              <img src="/portfolios/website/general-tech-services.webp" alt="General Tech Services mobile website" loading="lazy" />
            </div>
          </div>
        </div>
      </article>

      <!-- Card 03: TriQare -->
      <article class="pf-sc t3" style="--i:2">
        <span class="num">03</span>
        <div class="pf-sct">
          <span class="pf-tag">Healthcare &amp; SaaS · Kochi</span>
          <h3>A clinical web application that eliminated patient intake bottlenecks</h3>
          <p>
            A tailored web application and administrative intranet for <i class="pf-fill">TriQare</i>, automating digital records, outpatient registration, and doctor schedules across clinical departments.
          </p>
          <div class="pf-scm">
            <div>
              <b><i class="pf-fill">3×</i></b>
              <small>Faster patient intake</small>
            </div>
            <div>
              <b><i class="pf-fill">100%</i></b>
              <small>Paperless workflow</small>
            </div>
            <div>
              <b><i class="pf-fill">99.9%</i></b>
              <small>Platform uptime</small>
            </div>
          </div>
          <a class="pf-btn pf-btn-primary" href="/case-studies/triqare-web-application-design/">
            Read case study <span class="arr">→</span>
          </a>
        </div>
        <div class="pf-dev">
          <div class="lap">
            <div class="bar"><i></i><i></i><i></i></div>
            <div class="screen">
              <img src="/case-studies/triqare-desktop.webp" alt="TriQare web application dashboard" loading="lazy" />
            </div>
          </div>
          <div class="phone">
            <div class="screen">
              <img src="/case-studies/triqare-mobile.webp" alt="TriQare mobile interface" loading="lazy" />
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
