---
import { ChevronDown, ArrowRight } from 'lucide-react';
import home from "../data/home.json";

interface Props {
  includeSchema?: boolean;
}

const { includeSchema = false } = Astro.props;

const faqs = home.faq.items;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="py-10 sm:py-12 md:py-16 bg-cream relative">
  <!-- Subtle Gradient Accent -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-neutral-50/10 to-transparent -z-10"></div>

  <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-8 sm:mb-10 md:mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
        {home.faq.badge}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 leading-tight mb-4">
        {home.faq.headingLead} <span class="text-primary">{home.faq.headingAccent}</span>
      </h2>
      <p class="text-neutral-600 text-sm md:text-base leading-relaxed max-w-xl mx-auto">
        {home.faq.intro}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
      {faqs.map((faq, index) => (
        <details class="faq-group neu-card neu-card-cream rounded-xl overflow-hidden [&_summary::-webkit-details-marker]:hidden transition-all duration-300" name="faq">
          <summary class="flex items-center justify-between p-4.5 sm:p-5 md:p-6 cursor-pointer list-none font-bold text-base sm:text-lg text-neutral-800 transition-colors faq-summary">
            <h3 class="pr-8 leading-snug">{faq.question}</h3>
            <span class="ml-auto flex-shrink-0 bg-primary/5 rounded-full p-2 transition-all duration-300 faq-icon-container shadow-sm border border-primary/10">
              <ChevronDown className="w-4 h-4 text-primary transition-transform duration-300 faq-icon" />
            </span>
          </summary>
          <div class="px-4.5 sm:px-5 md:px-6 pb-4.5 sm:pb-5 md:pb-6 text-neutral-600 leading-relaxed font-normal text-xs sm:text-sm md:text-base faq-content">
            <div class="h-px w-full bg-neutral-100 mb-4"></div>
            <p set:html={faq.answer} class="leading-relaxed"></p>
          </div>
        </details>
      ))}
    </div>

    <!-- Contextual Conversion CTA: After FAQ (Side Slide-In from Left) -->
    <div class="cta-slide-left mt-14 pt-8 border-t border-neutral-200/60 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left bg-white rounded-2xl p-6 sm:p-8 border border-neutral-200/80 shadow-xs">
      <div class="max-w-xl">
        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 tracking-tight">
          Still Have Questions?
        </h3>
        <p class="text-sm text-neutral-600 mt-1">
          Tell us what you're looking for and our team can guide you.
        </p>
      </div>
      <a
        href="/request-a-quote/"
        class="cta-float-secondary cta-delay-16 cta-pulse-medium cta-pulse-delay-4 cta-shimmer-btn inline-flex items-center justify-center gap-2 px-7 py-3.5 text-sm font-bold text-white bg-primary hover:bg-primary/95 rounded-full transition-all duration-300 shadow-md shadow-primary/20 hover:shadow-lg hover:-translate-y-0.5 shrink-0 group whitespace-nowrap"
      >
        <span>Let's Discuss Your Project</span>
        <ArrowRight className="cta-arrow cta-arrow-invite w-4 h-4" />
      </a>
    </div>
  </div>

  <!-- FAQ Schema -->
  {includeSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</section>

<style>
  /* Premium styling for active states */
  .faq-group[open] {
    background-color: var(--color-white);
    box-shadow: 0 16px 32px -8px rgba(240,90,44,0.08);
    border: 1px solid var(--color-primary);
  }
  
  .faq-group[open] .faq-summary {
    color: var(--color-primary);
  }
  
  .faq-group[open] .faq-icon-container {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }
  
  .faq-group[open] .faq-icon {
    color: var(--color-white);
    transform: rotate(-180deg);
  }

  /* Smooth animation */
  details > .faq-content {
    animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
