---
import { ChevronDown, HelpCircle } from 'lucide-react';

const faqs = [
  {
    question: "Which web design company in Kerala is reliable?",
    answer: "Teknoppy has been delivering professional website design and development from our Kochi office since 2016. With over 150 completed projects and a verified 5-star rating on Google, we are one of Kerala's most trusted digital agencies — backed by real client results, not just claims."
  },
  {
    question: "How to choose a web design company in Kerala?",
    answer: "Look for three things — a verified portfolio with real Kerala clients, demonstrated SEO knowledge built into the design process, and clear post-launch support terms. A good Kerala web design agency delivers not just a website but measurable business outcomes including search rankings and lead generation."
  },
  {
    question: "What does a web design company in Kerala provide?",
    answer: "A full-service Web Design Company in Kerala provides website design, custom development, ecommerce solutions, SEO integration, UI UX design, web application development, and ongoing technical support — everything a Kerala business needs to build, rank, and grow its digital presence."
  },
  {
    question: "How much does website design cost in Kerala?",
    answer: "Website design costs in Kerala vary based on scope — a business website typically starts from a clearly scoped package price while ecommerce and web application projects are quoted based on features and complexity. View our detailed pricing to understand which package suits your business."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="py-32 bg-white relative">
  <!-- Subtle Gradient Accent -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-gray-50 to-transparent -z-10"></div>

  <div class="max-w-[800px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 border border-blue-100 text-sm font-bold text-blue-600 uppercase tracking-wider mb-8">
        <HelpCircle className="w-4 h-4" />
        Have Questions?
      </div>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black leading-tight text-black mb-6">
        Frequently Asked Questions — <br class="hidden md:block"/> Web Design Company in Kerala
      </h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="faq-group bg-white rounded-2xl shadow-sm border border-border overflow-hidden [&_summary::-webkit-details-marker]:hidden transition-all duration-300 hover:border-black/20 hover:shadow-md" name="faq">
          <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer list-none font-bold text-lg md:text-xl text-black transition-colors faq-summary">
            <h3 class="pr-8 leading-snug">{faq.question}</h3>
            <span class="ml-auto flex-shrink-0 bg-gray-50 rounded-full p-2.5 transition-all duration-300 faq-icon-container border border-border">
              <ChevronDown className="w-5 h-5 text-black transition-transform duration-300 faq-icon" />
            </span>
          </summary>
          <div class="px-6 md:px-8 pb-6 md:pb-8 text-muted leading-relaxed font-medium faq-content">
            <div class="h-px w-full bg-border mb-6"></div>
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
    
    <!-- Direct Action Prompt below FAQs -->
    <div class="mt-16 text-center bg-gray-50 p-8 rounded-[2rem] border border-border/80 shadow-inner">
      <p class="text-xl font-bold text-black mb-4">Still have a question?</p>
      <p class="text-muted mb-8 font-medium">Our team is ready to provide the answers you need to make an informed decision.</p>
      <a href="https://wa.me/916282249224" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 text-sm font-bold text-white bg-[#25D366] rounded-full shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        Chat on WhatsApp
      </a>
    </div>
  </div>

  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  /* Premium styling for active states */
  .faq-group[open] {
    border-color: var(--color-black);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  
  .faq-group[open] .faq-summary {
    color: var(--color-primary);
  }
  
  .faq-group[open] .faq-icon-container {
    background-color: var(--color-black);
    border-color: var(--color-black);
  }
  
  .faq-group[open] .faq-icon {
    color: var(--color-white);
    transform: rotate(-180deg);
  }

  /* Smooth animation */
  details > .faq-content {
    animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
