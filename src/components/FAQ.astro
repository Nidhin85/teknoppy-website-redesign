---
import { ChevronDown } from 'lucide-react';

const faqs = [
  {
    question: "Which web design company in Kerala is reliable?",
    answer: "Teknoppy has been delivering professional website design and development from our Kochi office since 2016. With over 150 completed projects and a verified 5-star rating on Google, we are one of Kerala's most trusted digital agencies — backed by real client results, not just claims."
  },
  {
    question: "How to choose a web design company in Kerala?",
    answer: "Look for three things — a verified portfolio with real Kerala clients, demonstrated SEO knowledge built into the design process, and clear post-launch support terms. A good Kerala web design agency delivers not just a website but measurable business outcomes including search rankings and lead generation."
  },
  {
    question: "What does a web design company in Kerala provide?",
    answer: "A full-service Web Design Company in Kerala provides website design, custom development, ecommerce solutions, SEO integration, UI UX design, web application development, and ongoing technical support — everything a Kerala business needs to build, rank, and grow its digital presence."
  },
  {
    question: "How much does website design cost in Kerala?",
    answer: "Website design costs in Kerala vary based on scope — a business website typically starts from a clearly scoped package price while ecommerce and web application projects are quoted based on features and complexity. View our detailed pricing to understand which package suits your business."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="py-24 md:py-32 bg-cream relative">
  <!-- Subtle Gradient Accent -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-neutral-50/10 to-transparent -z-10"></div>

  <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FFC247]/10 border border-[#FFC247]/30 text-primary text-sm font-bold uppercase tracking-wider mb-8 shadow-sm transform -rotate-1">
        Have Questions?
      </div>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 leading-tight mb-4">
        Frequently Asked <span class="text-primary">Questions</span>
      </h2>
      <p class="text-neutral-600 text-sm md:text-base leading-relaxed max-w-xl mx-auto">
        Find quick answers to common questions about our website design and digital solutions in Kerala.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
      {faqs.map((faq, index) => (
        <details class="faq-group bg-white rounded-xl overflow-hidden [&_summary::-webkit-details-marker]:hidden border border-neutral-100 shadow-sm transition-all duration-300 hover:border-primary/20" name="faq">
          <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer list-none font-bold text-lg text-neutral-800 transition-colors faq-summary">
            <h3 class="pr-8 leading-snug">{faq.question}</h3>
            <span class="ml-auto flex-shrink-0 bg-primary/5 rounded-full p-2 transition-all duration-300 faq-icon-container shadow-sm border border-primary/10">
              <ChevronDown className="w-4 h-4 text-primary transition-transform duration-300 faq-icon" />
            </span>
          </summary>
          <div class="px-6 md:px-8 pb-6 md:pb-8 text-neutral-600 leading-relaxed font-normal text-sm md:text-base faq-content">
            <div class="h-px w-full bg-neutral-100 mb-6"></div>
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>

  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  /* Premium styling for active states */
  .faq-group[open] {
    background-color: var(--color-white);
    box-shadow: 0 16px 32px -8px rgba(255,107,26,0.08);
    border: 1px solid var(--color-primary);
  }
  
  .faq-group[open] .faq-summary {
    color: var(--color-primary);
  }
  
  .faq-group[open] .faq-icon-container {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }
  
  .faq-group[open] .faq-icon {
    color: var(--color-white);
    transform: rotate(-180deg);
  }

  /* Smooth animation */
  details > .faq-content {
    animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
