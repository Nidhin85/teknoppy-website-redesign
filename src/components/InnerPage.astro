---
/**
 * Generic renderer for the content-driven inner pages.
 *
 * Every page under `src/data/pages/*.json` that uses this component supplies a
 * `sections` array. Each entry has a `type` that maps to one of the blocks
 * below, so new pages are pure content — no new markup per page.
 *
 * Copy is rendered verbatim from the JSON. Where a paragraph needs an inline
 * internal link, the entry uses `html` instead of `text`; the wording itself is
 * unchanged, only anchors are added.
 */
import { ArrowRight, Zap, Check, Star, Send, Phone, Info, ChevronDown, Users, Layers, Laptop, Coins, Calculator, Quote, ShieldCheck } from 'lucide-react';
import { getCollection } from 'astro:content';
import CostCalculator from './CostCalculator.tsx';

interface Props {
  page: any;
  disableDefaultSchema?: boolean;
}

const { page, disableDefaultSchema = false, enhancedTypography = false, formFirst = false } = Astro.props;
const sections = page.sections ?? [];

// Background tokens, so each page can alternate its sections without repeating
// the class strings (Tailwind's JIT needs to see them in full).
const bgClass: Record<string, string> = {
  white: 'bg-white',
  cream: 'bg-cream/30',
  soft: 'bg-neutral-50/50',
  warm: 'bg-warm/40'
};
const bgOf = (s: any) => bgClass[s.bg ?? 'white'] ?? bgClass.white;

// Pages with a `projects` section pull their thumbnails from the portfolio
// content collection, so the grid stays CMS-editable.
const needsProjects = sections.some((s: any) => s.type === 'projects');
const projects = needsProjects
  ? (await getCollection('portfolio', ({ data }) => !data.draft))
      .sort((a, b) => a.data.order - b.data.order)
      .map((e) => ({
        name: e.data.name,
        loc: `${e.data.location} · ${e.data.industry}`.toUpperCase(),
        desc: e.data.description,
        result: e.data.result
      }))
  : [];

// Lead-gen pages carry a form. Same endpoint and same failure handling as the
// contact page: a form that cannot reach the inbox says so rather than faking a
// success message.
const formEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || 'https://formsubmit.co/ajax/sales@teknoppy.com';
const fieldClass =
  "w-full bg-white border border-neutral-200 rounded-xl px-4 py-3.5 text-neutral-900 placeholder-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none text-sm sm:text-base";
const labelClass = "block text-[13px] font-black text-neutral-700 uppercase tracking-widest mb-2";

const hero = sections.find((s: any) => s.type === 'hero');
const formSection = sections.find((s: any) => s.type === 'form');
const body = sections.filter((s: any) =>
  (formFirst ? (s.type !== 'form' && s.type !== 'hero') : (s.type !== 'hero')) &&
  // A stat band with no verified figures renders nothing at all — heading included.
  !(s.type === 'statBand' && !(s.items ?? []).length) &&
  // `draft: true` holds finished copy back from the live page — used where the
  // source doc supplies the wording but the figures in it are still unverified.
  // The copy stays in the JSON verbatim; flip the flag to publish.
  s.draft !== true
);

// Form-first layout (Request a Quote): heading split for the accent colour, phone label split
// into two lines, and decorative stat icons. Presentation only; the text is unchanged.
const headingWords = (formSection?.form?.heading ?? "").split(" ");
const headingAccent = headingWords.length > 3 ? headingWords.slice(-3).join(" ") : headingWords.join(" ");
const headingLead = headingWords.length > 3 ? headingWords.slice(0, -3).join(" ") : "";
const phoneSplit = (formSection?.aside?.phoneLabel ?? "").match(/^(.+?)\s+(Call .+)$/);
const statIcons = [Users, Layers, Zap];
const linkIcons = [Laptop, Coins, Calculator];
const firstFieldClass =
  "w-full bg-white border border-neutral-200 rounded-xl px-4 py-3.5 text-[15px] text-neutral-900 placeholder-neutral-400 hover:border-neutral-300 focus:border-primary focus:ring-4 focus:ring-primary/15 transition-all outline-none";
const firstLabelClass = "block text-[12px] font-bold text-neutral-800 uppercase tracking-[0.14em] mb-2";

const faqSection = sections.find((s: any) => s.type === 'faq');
const faqSchema = faqSection && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqSection.items.map((f: any) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = page.breadcrumb && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": page.breadcrumb.map((c: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": c.name,
    "item": `https://teknoppy.com${c.href}`
  }))
};
---

{/* FORM FIRST TOP SECTION — When page specifies formFirst={true} (e.g. Request a Quote) */}
{formFirst && formSection && (
  <section class="relative pt-24 sm:pt-28 md:pt-32 pb-12 sm:pb-16 bg-gradient-to-b from-[#fff3ea] via-[#fff8f3] to-white overflow-hidden" id="request-quote">
    <div class="absolute -top-32 -right-32 w-[560px] h-[560px] rounded-full bg-primary/10 blur-[120px] pointer-events-none"></div>
    <div class="absolute top-40 -left-40 w-[420px] h-[420px] rounded-full bg-[#F58439]/10 blur-[120px] pointer-events-none"></div>

    <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10">
      {/* Breadcrumb Navigation */}
      {page.breadcrumb && (
        <nav class="flex flex-wrap items-center gap-2 text-xs sm:text-[13px] font-medium text-neutral-500 mb-5" aria-label="Breadcrumb">
          {page.breadcrumb.map((crumb: any, i: number) => (
            <div class="flex items-center gap-2">
              {i > 0 && <span class="text-neutral-400">/</span>}
              {i === page.breadcrumb.length - 1 ? (
                <span class="text-neutral-900 font-semibold">{crumb.name}</span>
              ) : (
                <a href={crumb.href} class="hover:text-primary transition-colors">{crumb.name}</a>
              )}
            </div>
          ))}
        </nav>
      )}

      {/* Heading row — the form heading is the page H1; illustration is decorative (md+) */}
      {formSection.form.heading && (
        <div class="grid md:grid-cols-12 gap-6 items-center mb-8 sm:mb-10">
          <h1 class="md:col-span-8 text-[34px] sm:text-5xl lg:text-[58px] font-black leading-[1.06] tracking-tight text-neutral-900">
            {headingLead}{headingLead && <br />}
            <span class="relative inline-block text-primary">
              {headingAccent}
              <svg class="absolute -bottom-2 right-0 w-1/2 h-2.5 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" aria-hidden="true">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
          </h1>
          <div class="hidden md:flex md:col-span-4 justify-end" aria-hidden="true">
            <svg class="w-full max-w-[260px] h-auto drop-shadow-[0_30px_40px_rgba(240,90,44,0.22)]" viewBox="0 0 360 260" fill="none">
              <ellipse cx="180" cy="135" rx="150" ry="110" fill="#FFE7D9" />
              <!-- clipboard -->
              <g transform="rotate(10 170 135)">
                <rect x="105" y="40" width="140" height="185" rx="16" fill="#F05A2C" />
                <rect x="118" y="58" width="114" height="155" rx="8" fill="#fff" />
                <rect x="145" y="28" width="60" height="26" rx="8" fill="#F58439" />
                <circle cx="175" cy="30" r="9" fill="#fff" stroke="#F58439" stroke-width="5" />
                <g stroke-linecap="round" stroke-linejoin="round">
                  <rect x="132" y="80" width="20" height="20" rx="4" stroke="#F58439" stroke-width="3" />
                  <path d="M136 90l5 5 12-14" stroke="#F05A2C" stroke-width="4" />
                  <rect x="132" y="118" width="20" height="20" rx="4" stroke="#F58439" stroke-width="3" />
                  <path d="M136 128l5 5 12-14" stroke="#F05A2C" stroke-width="4" />
                  <rect x="132" y="156" width="20" height="20" rx="4" stroke="#F58439" stroke-width="3" />
                  <path d="M164 88h50M164 98h36M164 126h50M164 136h40M164 164h50M164 174h30" stroke="#C9CDD4" stroke-width="5" />
                </g>
              </g>
              <!-- sparks -->
              <path d="M78 70l-16-6M88 52l-6-16M74 92l-18 2" stroke="#F05A2C" stroke-width="5" stroke-linecap="round" />
              <!-- paper plane -->
              <path d="M262 112l78-30-30 66-15-22z" fill="#F05A2C" />
              <path d="M295 126l45-44-60 36z" fill="#C2410C" />
              <path d="M262 150c-20 10-30 30-12 34s14-20-4-14" stroke="#F05A2C" stroke-width="2.5" stroke-dasharray="5 6" stroke-linecap="round" opacity=".6" />
            </svg>
          </div>
        </div>
      )}

      {/* Two-Column Form & Aside Layout */}
      <div class={formSection.aside ? "grid lg:grid-cols-12 gap-6 lg:gap-8 items-start" : "max-w-2xl"}>

        {/* 1. Form card */}
        <div class={`${formSection.aside ? "lg:col-span-7 " : ""}bg-white rounded-[1.75rem] border border-neutral-100 p-5 sm:p-8 md:p-9 shadow-[0_30px_70px_-35px_rgba(0,0,0,0.25)]`}>
          <form
            data-lead-form
            data-endpoint={formEndpoint}
            data-source={formSection.form.source}
            data-summary={formSection.form.summary}
            data-success={formSection.form.successMessage}
            data-error={formSection.form.errorMessage}
            novalidate
            class="space-y-5 sm:space-y-6"
          >
            {/* Honeypot */}
            <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
              <label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {formSection.form.fields.map((f: any) => (
                <div class={f.width === 'half' ? 'col-span-1' : 'col-span-1 sm:col-span-2'}>
                  <label for={`lf-first-${f.name}`} class={firstLabelClass}>
                    {f.label}
                    {!f.required && <span class="text-neutral-400 font-semibold normal-case tracking-normal"> (optional)</span>}
                  </label>
                  {f.type === 'textarea' ? (
                    <textarea
                      id={`lf-first-${f.name}`}
                      name={f.name}
                      rows={f.rows ?? 4}
                      required={f.required}
                      placeholder={f.placeholder}
                      data-label={f.label}
                      class={`${firstFieldClass} resize-y min-h-[120px]`}
                    />
                  ) : f.type === 'select' ? (
                    <div class="relative">
                      <select id={`lf-first-${f.name}`} name={f.name} required={f.required} data-label={f.label} class={`${firstFieldClass} appearance-none pr-11 cursor-pointer`}>
                        <option value="" disabled selected>{f.placeholder ?? 'Select an option'}</option>
                        {f.options.map((opt: string) => <option value={opt}>{opt}</option>)}
                      </select>
                      <span class="absolute inset-y-0 right-4 flex items-center text-neutral-500 pointer-events-none"><ChevronDown className="w-4 h-4" /></span>
                    </div>
                  ) : (
                    <input
                      id={`lf-first-${f.name}`}
                      name={f.name}
                      type={f.type ?? 'text'}
                      required={f.required}
                      placeholder={f.placeholder}
                      autocomplete={f.autocomplete}
                      min={f.min}
                      data-label={f.label}
                      class={firstFieldClass}
                    />
                  )}
                  {f.hint && <p class="text-xs text-neutral-400 font-semibold mt-1.5 leading-relaxed">{f.hint}</p>}
                </div>
              ))}
            </div>

            <button type="submit" class="w-full inline-flex items-center justify-center gap-2.5 px-6 sm:px-8 py-4 text-base font-bold text-white bg-gradient-to-r from-[#F58439] to-primary rounded-xl shadow-[0_14px_30px_-10px_rgba(240,90,44,0.6)] hover:shadow-[0_18px_36px_-10px_rgba(240,90,44,0.7)] active:scale-[0.99] hover:-translate-y-0.5 transition-all duration-300 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed disabled:translate-y-0 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/30">
              {formSection.form.submitLabel}
              <ArrowRight class="w-4 h-4" />
            </button>

            <p data-lead-status role="status" aria-live="polite" class="hidden text-sm font-semibold rounded-xl px-4 py-3"></p>

            {formSection.form.note && (
              <p class="flex items-start gap-3 rounded-xl bg-[#fff4ec] border border-primary/10 px-4 py-3.5 text-[13px] text-neutral-600 font-medium leading-relaxed">
                <Info className="w-5 h-5 text-primary flex-shrink-0 mt-px" />
                <span>{formSection.form.note}</span>
              </p>
            )}
          </form>
        </div>

        {/* 2. Aside panel */}
        {formSection.aside && (
          <aside class="lg:col-span-5 lg:sticky lg:top-28">
            <div class="theme-keep-light bg-neutral-950 text-white rounded-[1.75rem] p-6 sm:p-8 shadow-[0_30px_70px_-35px_rgba(0,0,0,0.5)] relative overflow-hidden">
              <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-primary/25 blur-[90px] pointer-events-none"></div>
              <div class="relative z-10">
                {formSection.aside.heading && <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight mb-6">{formSection.aside.heading}</h3>}
                <ul class="space-y-6">
                  {(formSection.aside.items ?? []).map((item: any) => (
                    <li class="flex items-start gap-3.5">
                      <span class="w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center flex-shrink-0 mt-0.5 shadow-[0_0_0_4px_rgba(240,90,44,0.18)]">
                        <Check className="w-3.5 h-3.5" strokeWidth={3} />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[15px] font-bold text-white leading-snug">{item.title}</span>
                        {item.text && <span class="block text-sm font-medium text-neutral-400 mt-1.5 leading-relaxed">{item.text}</span>}
                      </span>
                    </li>
                  ))}
                </ul>
                {formSection.aside.phone && (
                  <a href={`tel:${formSection.aside.phone.replace(/\s/g, '')}`} class="group flex items-center gap-4 mt-8 pt-6 border-t border-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 rounded-lg">
                    <span class="w-11 h-11 rounded-full bg-primary/15 ring-1 ring-primary/40 text-primary flex items-center justify-center flex-shrink-0">
                      <Phone className="w-5 h-5" />
                    </span>
                    <span class="min-w-0">
                      {phoneSplit ? (
                        <>
                          <span class="block text-sm font-bold text-primary">{phoneSplit[1]}</span>
                          <span class="block text-lg font-black text-white group-hover:text-primary transition-colors">{phoneSplit[2]}</span>
                        </>
                      ) : (
                        <span class="block text-base font-bold text-white group-hover:text-primary transition-colors">{formSection.aside.phoneLabel ?? formSection.aside.phone}</span>
                      )}
                    </span>
                  </a>
                )}
                {formSection.aside.footnote && <p class="text-xs text-neutral-500 font-semibold italic mt-5 leading-relaxed">{formSection.aside.footnote}</p>}
              </div>
            </div>
          </aside>
        )}
      </div>

      {/* Stats strip — one card, three columns */}
      {hero && hero.stats && (
        <div class="mt-8 sm:mt-10">
          <div class="bg-white rounded-[1.75rem] border border-neutral-100 shadow-[0_20px_50px_-35px_rgba(0,0,0,0.25)] grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-neutral-200/80">
            {hero.stats.map((stat: any, i: number) => {
              const StatIcon = statIcons[i % statIcons.length];
              return (
                <div class="flex items-center justify-center gap-4 px-6 py-6 sm:py-7">
                  <StatIcon className="w-9 h-9 text-primary flex-shrink-0" strokeWidth={1.75} />
                  <div>
                    <p class="text-3xl sm:text-[34px] font-black text-primary leading-none tracking-tight">{stat.value}</p>
                    <p class="mt-1.5 text-xs font-bold text-neutral-700 uppercase tracking-wider">{stat.label}</p>
                  </div>
                </div>
              );
            })}
          </div>
          {hero.trustline && (
            <p class="text-center text-xs font-bold text-neutral-400 uppercase tracking-wider mt-5">
              {hero.trustline}
            </p>
          )}
        </div>
      )}
    </div>
  </section>
)}

<!-- HERO -->
{!formFirst && hero && (
  <section class="ds-hero relative pt-32 pb-24 md:pt-36 md:pb-28 overflow-hidden bg-[#fff8f2] text-neutral-900 border-b border-primary/10">
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <div class="ds-hero-glow absolute inset-0"></div>
      <div class="ds-hero-orbit absolute hidden lg:block"></div>
    </div>

    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 relative z-10">
      <div class={hero.stats ? "grid xl:grid-cols-12 gap-12 items-center" : ""}>
        <div class={hero.stats ? "xl:col-span-7 min-w-0 flex flex-col items-center text-center xl:items-start xl:text-left" : "max-w-4xl"}>
          {page.breadcrumb && (
            <nav class="flex flex-wrap items-center gap-2 text-xs font-medium text-neutral-500 mb-4" aria-label="Breadcrumb">
              {page.breadcrumb.map((crumb: any, i: number) => (
                <div class="flex items-center gap-2">
                  {i > 0 && <span class="text-neutral-300">/</span>}
                  {i === page.breadcrumb.length - 1 ? (
                    <span class="text-neutral-800 font-semibold">{crumb.name}</span>
                  ) : (
                    <a href={crumb.href} class="hover:text-primary transition-colors">{crumb.name}</a>
                  )}
                </div>
              ))}
            </nav>
          )}
          {(hero.badge || hero.eyebrow) && (
            <div class="flex flex-wrap items-center gap-3 mb-6">
              {hero.badge && (
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/80 border border-primary/20 text-xs font-bold text-primary uppercase tracking-widest shadow-[0_8px_20px_-12px_rgba(240,90,44,0.5)] backdrop-blur">
                  <Zap class="w-3.5 h-3.5" />
                  {hero.badge}
                </span>
              )}
              {hero.eyebrow && (
                <span class="text-xs font-black text-neutral-500 uppercase tracking-[0.2em]">{hero.eyebrow}</span>
              )}
            </div>
          )}
          <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-black leading-[1.1] tracking-tight text-neutral-900 mb-6">
            {hero.h1Lead}{hero.h1Lead && ' '}
            <span class="relative inline-block text-primary">
              {hero.h1Accent}
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>{hero.h1Rest ? ` ${hero.h1Rest}` : ''}
          </h1>

          {hero.subhead && (
            hero.subheadTag === 'p' ? (
              <p class="text-lg sm:text-xl lg:text-2xl font-bold text-neutral-800 mb-6 leading-snug max-w-3xl">
                {hero.subhead}
              </p>
            ) : (
              <h2 class="text-lg sm:text-xl lg:text-2xl font-bold text-neutral-800 mb-6 leading-snug max-w-3xl">
                {hero.subhead}
              </h2>
            )
          )}

          {(hero.body ?? []).map((p: any) => (
            p.html
              ? <p class="text-base sm:text-lg text-neutral-600 mb-6 max-w-3xl font-medium leading-relaxed" set:html={p.html} />
              : <p class="text-base sm:text-lg text-neutral-600 mb-6 max-w-3xl font-medium leading-relaxed">{p.text ?? p}</p>
          ))}

          {hero.ctas && (
            <div class={`flex flex-col sm:flex-row sm:flex-wrap items-center gap-4 w-full sm:w-auto mt-2 ${hero.stats ? 'sm:justify-center xl:justify-start' : ''}`}>
              {hero.ctas.map((cta: any, i: number) => (
                <a
                  href={cta.href}
                  class={i === 0
                    ? "w-full sm:w-auto inline-flex items-center justify-center text-center gap-2.5 px-6 sm:px-8 py-3.5 sm:py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 leading-snug sm:whitespace-nowrap"
                    : "w-full sm:w-auto inline-flex items-center justify-center text-center gap-2.5 px-6 sm:px-8 py-3.5 sm:py-4 text-base font-bold text-neutral-900 bg-white/80 backdrop-blur border border-neutral-200 rounded-full hover:border-primary/40 hover:text-primary transition-all duration-300 shadow-sm leading-snug sm:whitespace-nowrap"}
                >
                  {cta.label}
                  <ArrowRight class="w-4 h-4" />
                </a>
              ))}
            </div>
          )}

          {hero.meta && (
            <dl class="flex flex-wrap gap-x-10 gap-y-5 mt-8 pt-8 border-t border-primary/15 max-w-3xl">
              {hero.meta.map((m: any) => (
                <div class="min-w-0">
                  <dt class="text-[11px] font-black text-neutral-500 uppercase tracking-[0.18em] mb-1.5">{m.label}</dt>
                  <dd class="text-sm font-bold text-neutral-800 leading-snug">
                    {m.href
                      ? <a href={m.href} class="inline-flex items-center gap-1.5 text-primary hover:underline" target={m.href.startsWith('http') ? '_blank' : undefined} rel={m.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{m.value}<ArrowRight class="w-3 h-3" /></a>
                      : m.value}
                  </dd>
                </div>
              ))}
            </dl>
          )}

          {hero.trustline && (
            <p class="text-xs sm:text-sm text-neutral-500 font-semibold italic mt-8 max-w-2xl leading-relaxed">
              {hero.trustline}
            </p>
          )}
        </div>

        {hero.stats && (
          <div class={`xl:col-span-5 grid gap-4 sm:gap-6 ${hero.stats.length === 3 ? 'grid-cols-3 xl:grid-cols-1' : 'grid-cols-2'}`}>
            {hero.stats.map((stat: any) => (
              <div class="ds-glass bg-white/70 backdrop-blur-md border border-white rounded-[1.5rem] sm:rounded-[2rem] p-4 min-[400px]:p-5 sm:p-8 min-w-0 shadow-[0_24px_50px_-28px_rgba(160,60,20,0.45)] hover:border-primary/30 hover:shadow-[0_28px_60px_-26px_rgba(240,90,44,0.45)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start group">
                <span class="text-xl min-[400px]:text-2xl sm:text-3xl font-black text-neutral-900 block leading-tight sm:leading-none mb-2 break-words">{stat.value}</span>
                <div class="w-8 h-[2px] bg-primary mb-4"></div>
                <span class="text-[11px] font-black text-neutral-500 uppercase tracking-widest leading-normal">{stat.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<!-- BODY SECTIONS -->
{!formFirst && body.map((s: any) => (
  <section id={s.id} class={`py-16 sm:py-20 border-t border-neutral-100 relative ${bgOf(s)}`}>
    <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">

      {(s.badge || s.h2) && (
        <div class={`mb-10 ${s.center ? 'text-center max-w-3xl mx-auto' : 'max-w-3xl'}`}>
          {s.badge && (
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {s.badge}
            </div>
          )}
          {s.h2 && (
            <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">
              {s.h2}
            </h2>
          )}
          {s.intro && (
            s.introHtml
              ? <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed" set:html={s.intro} />
              : <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">{s.intro}</p>
          )}
        </div>
      )}

      {/* PROSE — paragraphs, optionally with a bold lead-in */}
      {s.type === 'prose' && (
        <div class="max-w-4xl space-y-5">
          {s.paragraphs.map((p: any) => (
            <p class={enhancedTypography ? "text-neutral-600 text-base sm:text-lg leading-relaxed font-medium" : "text-neutral-600 text-sm sm:text-base leading-relaxed font-medium"}>
              {p.lead && <strong class="font-black text-neutral-900">{p.lead}</strong>}
              {p.lead && ' '}
              {p.html ? <Fragment set:html={p.html} /> : (p.text ?? p)}
            </p>
          ))}
        </div>
      )}

      {/* CARDS — one card per H3 block. `layout: "list"` gives a full-width
          numbered list instead, which reads in order and never strands an
          orphan card when the item count doesn't divide by the column count. */}
      {s.type === 'cards' && s.layout === 'list' && (
        <div class="divide-y divide-neutral-200/70 border-t border-neutral-200/70">
          {s.items.map((item: any, i: number) => (
            <div class="grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-2 lg:gap-10 py-6 group">
              <div class="flex items-start gap-4">
                <span class="text-xs font-black text-primary tabular-nums pt-1 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <div class="min-w-0">
                  {s.itemHeading === 'h2'
                    ? <h2 class="text-base sm:text-lg font-black text-neutral-900 leading-snug">{item.title}</h2>
                    : <h3 class="text-base sm:text-lg font-black text-neutral-900 leading-snug">{item.title}</h3>}
                  {item.answers && (
                    <span class="inline-block text-[11px] font-black text-primary bg-primary/8 border border-primary/15 px-2 py-0.5 rounded-full uppercase tracking-wider mt-2">{item.answers}</span>
                  )}
                </div>
              </div>
              <div class="lg:pt-1 pl-8 lg:pl-0">
                {item.html
                  ? <p class={enhancedTypography ? "text-neutral-600 text-[15px] sm:text-base leading-relaxed font-medium" : "text-neutral-600 text-sm sm:text-[16px] leading-relaxed font-medium"} set:html={item.html} />
                  : <p class={enhancedTypography ? "text-neutral-600 text-[15px] sm:text-base leading-relaxed font-medium" : "text-neutral-600 text-sm sm:text-[16px] leading-relaxed font-medium"}>{item.text}</p>}
                {item.linkText && (
                  <a href={item.href} class="inline-flex items-center gap-1.5 text-xs font-black text-primary mt-3 hover:underline uppercase tracking-wider">
                    {item.linkText}
                    <ArrowRight class="w-3.5 h-3.5" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

      {s.type === 'cards' && s.layout !== 'list' && (
        <div class={`grid gap-6 ${s.columns === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3'}`}>
          {s.items.map((item: any) => (
            <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col">
              <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
              {s.itemHeading === 'h2'
                ? <h2 class="text-lg font-black text-neutral-900 leading-snug mb-3">{item.title}</h2>
                : <h3 class="text-lg font-black text-neutral-900 leading-snug mb-3">{item.title}</h3>}
              {item.html
                ? <p class={enhancedTypography ? "text-neutral-600 text-[15px] sm:text-base leading-relaxed font-medium" : "text-neutral-600 text-sm leading-relaxed font-medium"} set:html={item.html} />
                : <p class={enhancedTypography ? "text-neutral-600 text-[15px] sm:text-base leading-relaxed font-medium" : "text-neutral-600 text-sm leading-relaxed font-medium"}>{item.text}</p>}
              {item.linkText && (
                <a href={item.href} class="inline-flex items-center gap-1.5 text-xs font-black text-primary mt-5 hover:underline uppercase tracking-wider">
                  {item.linkText}
                  <ArrowRight class="w-3.5 h-3.5" />
                </a>
              )}
            </div>
          ))}
        </div>
      )}

      {/* STAT BAND — headline results. Renders only when real figures exist. */}
      {s.type === 'statBand' && (
        <div class={`grid gap-5 sm:grid-cols-2 ${s.items.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}>
          {s.items.map((st: any) => (
            <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] flex flex-col">
              <span class="text-4xl sm:text-5xl font-black text-primary leading-none tracking-tight">{st.value}</span>
              <div class="w-9 h-[3px] bg-primary/25 my-4"></div>
              <h3 class="text-sm font-bold text-neutral-700 leading-snug">{st.label}</h3>
              {st.source && <span class="text-[12px] font-semibold text-neutral-400 mt-3 uppercase tracking-wider">{st.source}</span>}
            </div>
          ))}
        </div>
      )}

      {/* FIGURE — website screenshot, optionally framed as a browser window */}
      {s.type === 'figure' && (
        <figure class="max-w-5xl">
          <div class={s.frame === false
            ? "rounded-3xl overflow-hidden border border-neutral-200/70 shadow-[0_24px_60px_-24px_rgba(0,0,0,0.25)]"
            : "rounded-3xl overflow-hidden border border-neutral-200/70 bg-neutral-100 shadow-[0_24px_60px_-24px_rgba(0,0,0,0.25)]"}>
            {s.frame !== false && (
              <div class="flex items-center gap-1.5 px-4 py-3 bg-neutral-100 border-b border-neutral-200/70">
                <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                {s.url && <span class="ml-3 text-[13px] font-semibold text-neutral-400 truncate">{s.url}</span>}
              </div>
            )}
            <img src={s.src} alt={s.alt} width="1440" height="900" loading="lazy" decoding="async" class="w-full aspect-[16/10] object-cover object-top block" />
          </div>
          {s.caption && <figcaption class="text-xs text-neutral-500 font-semibold mt-4 leading-relaxed">{s.caption}</figcaption>}
        </figure>
      )}

      {/* LINK GROUPS — a directory split under sub-headings */}
      {s.type === 'linkGroups' && (
        <div class="space-y-10">
          {s.groups.map((g: any) => (
            <div>
              <div class="flex items-baseline gap-3 mb-4 pb-3 border-b border-neutral-200/70">
                <h3 class="text-sm font-black text-neutral-900 uppercase tracking-wider">{g.title}</h3>
                <span class="text-[12px] font-black text-neutral-400">{g.items.length}</span>
              </div>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {g.items.map((item: any) => (
                  <a href={item.href} class="group bg-white rounded-2xl border border-neutral-100 shadow-[0_10px_24px_-16px_rgba(0,0,0,0.08)] hover:border-primary/30 hover:-translate-y-0.5 transition-all duration-300 flex flex-col overflow-hidden">
                    {item.image
                      ? <span class="block aspect-[16/10] overflow-hidden bg-neutral-100 border-b border-neutral-100">
                          <img src={item.image} alt={item.imageAlt ?? item.label} width="640" height="400" loading="lazy" decoding="async" class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500" />
                        </span>
                      : <span class="block aspect-[16/10] bg-gradient-to-br from-neutral-50 to-neutral-100 border-b border-neutral-100 flex items-center justify-center">
                          <span class="text-[12px] font-black text-neutral-400 uppercase tracking-[0.18em]">{item.imageFallback ?? 'Screenshot pending'}</span>
                        </span>}
                    <span class="flex flex-col flex-grow p-5">
                      {item.stat && <span class="block text-2xl font-black text-primary leading-none mb-2 tracking-tight">{item.stat}</span>}
                      <span class="block text-sm font-black text-neutral-900 group-hover:text-primary transition-colors leading-snug">{item.label}</span>
                      {item.text && <span class={enhancedTypography ? "block text-neutral-600 text-sm sm:text-[15px] font-medium mt-1.5 leading-relaxed flex-grow" : "block text-neutral-500 text-xs font-semibold mt-1.5 leading-relaxed flex-grow"}>{item.text}</span>}
                      <span class="inline-flex items-center gap-1.5 text-[12px] font-black text-primary mt-4 uppercase tracking-wider">
                        Read case study
                        <ArrowRight class="w-3 h-3" />
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}

      {/* STEPS — numbered process */}
      {s.type === 'steps' && (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {s.items.map((item: any, i: number) => (
            <div class="bg-white rounded-3xl border border-neutral-100 p-6 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] flex flex-col">
              <span class="w-9 h-9 rounded-full bg-primary text-white text-sm font-black flex items-center justify-center mb-4 shadow-[0_4px_12px_rgba(240,90,44,0.3)]">{i + 1}</span>
              <h3 class="text-base font-black text-neutral-900 mb-2 leading-snug">{item.title}</h3>
              <p class={enhancedTypography ? "text-neutral-600 text-[15px] sm:text-base leading-relaxed font-medium" : "text-neutral-600 text-sm leading-relaxed font-medium"}>{item.text}</p>
            </div>
          ))}
        </div>
      )}

      {/* BULLETS — checklist with optional closing note */}
      {s.type === 'bullets' && (
        <div class="max-w-4xl">
          <ul class="space-y-3">
            {s.items.map((item: any) => (
              <li class="flex items-start gap-3 bg-white rounded-2xl border border-neutral-100 p-4 sm:p-5 shadow-[0_10px_24px_-16px_rgba(0,0,0,0.08)]">
                <span class="w-5 h-5 rounded-full bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
                  <Check class="w-3 h-3" />
                </span>
                {item.html
                  ? <span class="text-neutral-600 text-sm leading-relaxed font-medium" set:html={item.html} />
                  : <span class="text-neutral-600 text-sm leading-relaxed font-medium">{item.text ?? item}</span>}
              </li>
            ))}
          </ul>
          {(s.outro ?? []).map((p: any) => (
            p.html
              ? <p class={enhancedTypography ? "text-neutral-600 text-base sm:text-lg leading-relaxed font-medium mt-6" : "text-neutral-600 text-sm sm:text-base leading-relaxed font-medium mt-6"} set:html={p.html} />
              : <p class={enhancedTypography ? "text-neutral-600 text-base sm:text-lg leading-relaxed font-medium mt-6" : "text-neutral-600 text-sm sm:text-base leading-relaxed font-medium mt-6"}>{p.text ?? p}</p>
          ))}
        </div>
      )}

      {/* LINKS — related pages / directory rows */}
      {s.type === 'links' && (
        <div class={`grid gap-4 max-w-5xl ${s.items.length > 1 ? 'sm:grid-cols-2' : ''}`}>
          {s.items.map((item: any) => (
            <a href={item.href} class="group bg-white rounded-2xl border border-neutral-100 p-5 shadow-[0_10px_24px_-16px_rgba(0,0,0,0.08)] hover:border-primary/30 hover:-translate-y-0.5 transition-all duration-300 flex items-start justify-between gap-4">
              <span>
                <span class="block text-sm font-black text-neutral-900 group-hover:text-primary transition-colors">{item.label}</span>
                {item.text && <span class={enhancedTypography ? "block text-neutral-600 text-sm sm:text-[15px] font-medium mt-1 leading-relaxed" : "block text-neutral-500 text-xs font-semibold mt-1 leading-relaxed"}>{item.text}</span>}
              </span>
              <ArrowRight class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
            </a>
          ))}
        </div>
      )}

      {/* PROJECTS — thumbnails from the portfolio collection */}
      {s.type === 'projects' && (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {projects
            .filter((proj: any) => !(s.exclude && s.exclude.includes(proj.name)))
            .map((proj: any) => (
            <div class="bg-white rounded-3xl border border-neutral-200/60 p-6 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <h3 class="text-lg font-bold text-neutral-900">{proj.name}</h3>
                  <span class="text-[11px] font-black text-primary bg-primary/5 px-2 py-0.5 rounded-full uppercase tracking-wider whitespace-nowrap">{proj.loc}</span>
                </div>
                <p class={enhancedTypography ? "text-neutral-600 text-[15px] sm:text-base leading-relaxed font-medium mb-4" : "text-neutral-600 text-xs leading-relaxed font-semibold mb-4"}>{proj.desc}</p>
                <div class="bg-neutral-50/50 rounded-2xl p-4 border border-neutral-100">
                  <span class="block text-[12px] font-black text-neutral-800 uppercase tracking-wider mb-1">Result</span>
                  <p class={enhancedTypography ? "text-neutral-600 text-sm font-semibold leading-relaxed" : "text-neutral-500 text-xs font-semibold leading-relaxed"}>{proj.result}</p>
                </div>
              </div>
              <a href="/contact-us/" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary mt-6 hover:underline">
                Enquire for details
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          ))}
        </div>
      )}

      {/* POSTS — "Latest Blog Posts" list */}
      {s.type === 'posts' && (
        <div class="max-w-4xl divide-y divide-neutral-100">
          {s.items.map((post: any) => (
            <a href={post.href} class="group block py-5 first:pt-0">
              <h3 class="text-base sm:text-lg font-black text-neutral-900 group-hover:text-primary transition-colors leading-snug">{post.title}</h3>
              <p class={enhancedTypography ? "text-neutral-600 text-[15px] sm:text-base leading-relaxed font-medium mt-2" : "text-neutral-600 text-sm leading-relaxed font-medium mt-2"}>{post.text}</p>
            </a>
          ))}
          {s.viewAll && (
            <a href={s.viewAll.href} class="inline-flex items-center gap-1.5 text-xs font-black text-primary uppercase tracking-wider pt-5 hover:underline">
              {s.viewAll.label}
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          )}
        </div>
      )}

      {/* TEAM — "Meet the Team" profile block */}
      {s.type === 'team' && (
        <div class="grid gap-6 lg:grid-cols-2">
          {s.items.map((m: any) => (
            <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-8 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)]">
              <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
              <div class="flex items-start gap-5">
                {m.photo && (
                  <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-primary/20 flex-shrink-0">
                    <img src={m.photo} alt={m.photoAlt ?? m.name} width="80" height="80" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                  </div>
                )}
                <div>
                  <h3 class="text-lg font-black text-neutral-900 leading-snug">{m.name}</h3>
                  <p class="text-sm font-bold text-primary mt-0.5">{m.role}</p>
                  {m.contact && <p class="text-xs text-neutral-500 font-semibold mt-2">{m.contact}</p>}
                </div>
              </div>
              <p class="text-neutral-600 text-sm leading-relaxed font-medium mt-5">{m.bio}</p>
              {m.reviewed && <p class="text-xs text-neutral-400 font-semibold italic mt-4">{m.reviewed}</p>}
            </div>
          ))}
        </div>
      )}

      {/* PRICING TABLE */}
      {s.type === 'pricing' && (
        <div class="max-w-4xl">
          <div class="overflow-x-auto rounded-3xl border border-neutral-100 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] bg-white">
            <table class="w-full text-left border-collapse min-w-[520px]">
              <thead>
                <tr class="bg-neutral-900 text-white">
                  <th class="px-5 py-4 text-[12px] font-black uppercase tracking-widest">{s.columns?.[0] ?? 'Service'}</th>
                  <th class="px-5 py-4 text-[12px] font-black uppercase tracking-widest">{s.columns?.[1] ?? 'Estimated Investment'}</th>
                  {s.columns?.[2] && <th class="px-5 py-4 text-[12px] font-black uppercase tracking-widest">{s.columns[2]}</th>}
                </tr>
              </thead>
              <tbody>
                {s.rows.map((row: any, i: number) => (
                  <tr class={i % 2 ? 'bg-neutral-50/50' : 'bg-white'}>
                    <td class="px-5 py-4 text-sm font-semibold text-neutral-800 border-t border-neutral-100">{row.service}</td>
                    <td class="px-5 py-4 text-sm font-black text-primary border-t border-neutral-100 whitespace-nowrap">{row.price}</td>
                    {s.columns?.[2] && <td class="px-5 py-4 text-sm font-semibold text-neutral-600 border-t border-neutral-100 whitespace-nowrap">{row.timeline}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {s.note && <p class={enhancedTypography ? "text-sm text-neutral-500 font-medium leading-relaxed mt-4" : "text-xs text-neutral-500 font-semibold leading-relaxed mt-4"} set:html={s.note} />}
        </div>
      )}

      {/* TABLE — generic comparison/feature table from the source doc; same styling as PRICING */}
      {s.type === 'table' && (
        <div class="max-w-4xl">
          <div class="overflow-x-auto rounded-3xl border border-neutral-100 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] bg-white">
            <table class="w-full text-left border-collapse min-w-[520px]">
              <thead>
                <tr class="bg-neutral-900 text-white">
                  {s.headers.map((h: string) => <th class="px-5 py-4 text-[12px] font-black uppercase tracking-widest">{h}</th>)}
                </tr>
              </thead>
              <tbody>
                {s.rows.map((row: string[], i: number) => (
                  <tr class={i % 2 ? 'bg-neutral-50/50' : 'bg-white'}>
                    {row.map((cell, j) => <td class={`px-5 py-4 text-sm border-t border-neutral-100 ${j === 0 ? 'font-black text-neutral-900' : 'font-semibold text-neutral-600'}`} set:html={cell} />)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {s.note && <p class={enhancedTypography ? "text-sm text-neutral-500 font-medium leading-relaxed mt-4" : "text-xs text-neutral-500 font-semibold leading-relaxed mt-4"} set:html={s.note} />}
        </div>
      )}

      {/* CASE STUDIES — approach + results + quote */}
      {s.type === 'caseStudies' && (
        <div class="space-y-8">
          {s.items.map((cs: any) => (
            <div class="bg-white rounded-3xl border border-neutral-100 p-6 sm:p-8 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)]">
              {cs.image && (
                <div class="mb-6 rounded-2xl overflow-hidden border border-neutral-100 aspect-[16/9] sm:aspect-[21/9] max-h-72 bg-neutral-50">
                  <img src={cs.image} alt={cs.imageAlt || cs.title} class="w-full h-full object-cover object-top" loading="lazy" />
                </div>
              )}
              {cs.client && (
                <span class="text-xs font-black text-primary uppercase tracking-wider block mb-2">{cs.client}</span>
              )}
              <h3 class="text-xl font-black text-neutral-900 leading-snug mb-4">{cs.title}</h3>
              {(cs.intro ?? []).map((p: any) => (
                <p class={enhancedTypography ? "text-neutral-600 text-base sm:text-[17px] leading-relaxed font-medium mb-3" : "text-neutral-600 text-sm leading-relaxed font-medium mb-3"}>{p.text ?? p}</p>
              ))}
              <div class="grid sm:grid-cols-2 gap-5 mt-6">
                {cs.approach && (
                  <div class="bg-neutral-50/50 rounded-2xl p-5 border border-neutral-100">
                    <h4 class="text-xs font-black text-neutral-900 uppercase tracking-wider mb-3">{cs.approachLabel ?? 'Our Approach'}</h4>
                    <ul class={enhancedTypography ? "space-y-2 text-sm sm:text-[15px] text-neutral-600 font-medium list-disc pl-4" : "space-y-1.5 text-xs text-neutral-600 font-semibold list-disc pl-4"}>
                      {cs.approach.map((point: string) => <li>{point}</li>)}
                    </ul>
                  </div>
                )}
                {cs.results && (
                  <div class="bg-neutral-50/50 rounded-2xl p-5 border border-neutral-100">
                    <h4 class="text-xs font-black text-neutral-900 uppercase tracking-wider mb-3">{cs.resultsLabel ?? 'The Results'}</h4>
                    <ul class={enhancedTypography ? "space-y-2 text-sm sm:text-[15px] text-neutral-600 font-medium list-disc pl-4" : "space-y-1.5 text-xs text-neutral-600 font-semibold list-disc pl-4"}>
                      {cs.results.map((point: string) => <li>{point}</li>)}
                    </ul>
                  </div>
                )}
              </div>
              {cs.quote && (
                <div class="border-l-4 border-primary pl-4 py-1.5 bg-cream/30 rounded-r-2xl mt-6">
                  <p class={enhancedTypography ? "text-sm sm:text-base text-neutral-600 font-medium italic leading-relaxed" : "text-xs text-neutral-600 font-medium italic leading-relaxed"}>"{cs.quote}"</p>
                  <span class="block text-xs font-black text-neutral-900 mt-2">{cs.author}</span>
                </div>
              )}
              {cs.links && <p class="text-xs text-neutral-500 font-semibold mt-4" set:html={cs.links} />}
            </div>
          ))}
        </div>
      )}

      {/* TESTIMONIALS */}
      {s.type === 'testimonials' && (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {s.items.map((t: any) => (
            <figure class="bg-white border border-neutral-200/50 rounded-3xl p-6 shadow-sm flex flex-col justify-between">
              <div class="flex gap-1 text-[#F9AE42] mb-4">
                {[0, 1, 2, 3, 4].map(() => <Star class="w-4 h-4 fill-current" />)}
              </div>
              <blockquote class={enhancedTypography ? "text-sm sm:text-base text-neutral-600 font-medium italic leading-relaxed mb-6 flex-grow" : "text-xs text-neutral-600 font-medium italic leading-relaxed mb-6 flex-grow"}>"{t.quote}"</blockquote>
              <figcaption class="border-t border-neutral-100 pt-4 mt-auto">
                <span class={enhancedTypography ? "block text-base font-bold text-neutral-800" : "block text-sm font-bold text-neutral-800"}>{t.author}</span>
                <span class="block text-[12px] text-neutral-400 font-bold uppercase tracking-wider mt-0.5">{t.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )}

      {/* FAQ */}
      {s.type === 'faq' && (
        <div class="max-w-4xl mx-auto space-y-4">
          {s.items.map((faq: any) => (
            <details class="group bg-white rounded-2xl border border-neutral-200/60 p-6 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
                <h3 class={enhancedTypography ? "text-base sm:text-lg font-bold text-neutral-900 pr-4" : "text-sm sm:text-base font-bold text-neutral-850 pr-4"}>{faq.q}</h3>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-primary flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class={enhancedTypography ? "mt-4 pt-4 border-t border-neutral-100/60 text-base sm:text-[17px] text-neutral-600 leading-relaxed font-normal" : "mt-4 pt-4 border-t border-neutral-100/60 text-xs sm:text-sm text-neutral-600 leading-relaxed font-semibold"}>
                {faq.aHtml ? <Fragment set:html={faq.aHtml} /> : faq.a}
              </div>
            </details>
          ))}
        </div>
      )}

      {/* CTA */}
      {s.type === 'cta' && (
        <div class="max-w-4xl">
          {(s.paragraphs ?? []).map((p: any) => (
            p.html ? (
              <p class="text-neutral-600 text-base sm:text-lg leading-relaxed font-medium mb-6" set:html={p.html} />
            ) : (
              <p class="text-neutral-600 text-base sm:text-lg leading-relaxed font-medium mb-6">{p.text ?? p}</p>
            )
          ))}
          <div class="flex flex-col sm:flex-row flex-wrap items-center gap-4">
            {s.ctas.map((cta: any, i: number) => (
              <a
                href={cta.href}
                class={i === 0
                  ? "w-full sm:w-auto inline-flex items-center justify-center text-center gap-2.5 px-6 sm:px-8 py-3.5 sm:py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 leading-snug sm:whitespace-nowrap"
                  : "w-full sm:w-auto inline-flex items-center justify-center text-center gap-2.5 px-6 sm:px-8 py-3.5 sm:py-4 text-base font-bold text-primary border border-primary/30 bg-primary/5 rounded-full hover:bg-primary/10 transition-all duration-300 leading-snug sm:whitespace-nowrap"}
              >
                {cta.label}
                <ArrowRight class="w-4 h-4" />
              </a>
            ))}
          </div>
        </div>
      )}

      {/* NAP — business contact rows */}
      {s.type === 'nap' && (
        <div class="max-w-2xl bg-white rounded-3xl border border-neutral-100 p-6 sm:p-8 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] divide-y divide-neutral-100">
          {s.rows.map((row: any) => (
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6 py-3 first:pt-0 last:pb-0">
              <span class="text-[12px] font-black text-primary uppercase tracking-wider sm:w-40 flex-shrink-0">{row.label}</span>
              {row.href
                ? <a href={row.href} class="text-sm font-bold text-neutral-800 hover:text-primary transition-colors">{row.value}</a>
                : <span class="text-sm font-bold text-neutral-800">{row.value}</span>}
            </div>
          ))}
        </div>
      )}

      {/* FORM — JSON-declared lead-capture form. Fields the contact API does not
          know about are folded into the message body by the script below, so a
          page can ask for whatever its source doc specifies. */}
      {s.type === 'form' && (
        <div class={s.aside ? "grid lg:grid-cols-12 gap-6 lg:gap-8 items-start" : "max-w-2xl"}>
          <div class={s.aside ? "lg:col-span-7 bg-white rounded-[2rem] border border-neutral-100 p-6 sm:p-8 shadow-[0_24px_60px_-30px_rgba(0,0,0,0.2)]" : "bg-white rounded-[2rem] border border-neutral-100 p-6 sm:p-8 shadow-[0_24px_60px_-30px_rgba(0,0,0,0.2)]"}>
            {s.form.heading && (
              <div class="flex items-center gap-3 mb-7">
                <span class="w-11 h-11 rounded-2xl bg-primary/10 text-primary flex items-center justify-center border border-primary/15 flex-shrink-0">
                  <Send class="w-5 h-5" />
                </span>
                <h3 class="text-xl sm:text-2xl font-black text-neutral-900 leading-tight">{s.form.heading}</h3>
              </div>
            )}

            <form
              data-lead-form
              data-endpoint={formEndpoint}
              data-source={s.form.source}
              data-summary={s.form.summary}
              data-success={s.form.successMessage}
              data-error={s.form.errorMessage}
              novalidate
              class="space-y-5"
            >
              {/* Honeypot: real people never see or fill this. Bots do. */}
              <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
                <label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                {s.form.fields.map((f: any) => (
                  <div class={f.width === 'half' ? '' : 'sm:col-span-2'}>
                    <label for={`lf-${s.id}-${f.name}`} class={labelClass}>
                      {f.label}
                      {!f.required && <span class="text-neutral-400 font-bold normal-case tracking-normal"> (optional)</span>}
                    </label>
                    {f.type === 'textarea' ? (
                      <textarea
                        id={`lf-${s.id}-${f.name}`}
                        name={f.name}
                        rows={f.rows ?? 4}
                        required={f.required}
                        placeholder={f.placeholder}
                        data-label={f.label}
                        class={`${fieldClass} resize-none`}
                      />
                    ) : f.type === 'select' ? (
                      <select id={`lf-${s.id}-${f.name}`} name={f.name} required={f.required} data-label={f.label} class={fieldClass}>
                        <option value="" disabled selected>{f.placeholder ?? 'Select an option'}</option>
                        {f.options.map((opt: string) => <option value={opt}>{opt}</option>)}
                      </select>
                    ) : (
                      <input
                        id={`lf-${s.id}-${f.name}`}
                        name={f.name}
                        type={f.type ?? 'text'}
                        required={f.required}
                        placeholder={f.placeholder}
                        autocomplete={f.autocomplete}
                        min={f.min}
                        data-label={f.label}
                        class={fieldClass}
                      />
                    )}
                    {f.hint && <p class="text-xs text-neutral-400 font-semibold mt-1.5 leading-relaxed">{f.hint}</p>}
                  </div>
                ))}
              </div>

              <button type="submit" class="w-full inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-xl shadow-[0_10px_30px_-8px_rgba(240,90,44,0.5)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed">
                {s.form.submitLabel}
                <ArrowRight class="w-4 h-4" />
              </button>

              <p data-lead-status role="status" aria-live="polite" class="hidden text-sm font-semibold rounded-xl px-4 py-3"></p>

              {s.form.note && <p class="text-xs text-neutral-500 font-semibold leading-relaxed">{s.form.note}</p>}
            </form>
          </div>

          {s.aside && (
            <aside class="lg:col-span-5 lg:sticky lg:top-28">
              <div class="theme-keep-light bg-neutral-950 text-white rounded-[2rem] p-6 sm:p-8 shadow-[0_24px_60px_-30px_rgba(0,0,0,0.4)] relative overflow-hidden">
                <div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-primary/20 blur-[80px] pointer-events-none"></div>
                <div class="relative z-10">
                  {s.aside.heading && <h3 class="text-lg font-black text-white mb-6">{s.aside.heading}</h3>}
                  <ul class="space-y-5">
                    {(s.aside.items ?? []).map((item: any) => (
                      <li>
                        <span class="flex items-start gap-3">
                          <span class="w-5 h-5 rounded-full bg-primary/15 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
                            <Check class="w-3 h-3" />
                          </span>
                          <span class="min-w-0">
                            <span class="block text-sm font-bold text-white leading-snug">{item.title}</span>
                            {item.text && <span class="block text-xs font-semibold text-neutral-400 mt-1 leading-relaxed">{item.text}</span>}
                          </span>
                        </span>
                      </li>
                    ))}
                  </ul>
                  {s.aside.phone && (
                    <a href={`tel:${s.aside.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-2.5 mt-7 pt-6 border-t border-white/10 text-sm font-bold text-primary hover:underline w-full">
                      <Phone class="w-4 h-4" />
                      {s.aside.phoneLabel ?? s.aside.phone}
                    </a>
                  )}
                  {s.aside.footnote && <p class="text-xs text-neutral-500 font-semibold italic mt-5 leading-relaxed">{s.aside.footnote}</p>}
                </div>
              </div>
            </aside>
          )}
        </div>
      )}

      {/* CALCULATOR — the interactive estimator island. Its bands live in the
          page JSON, copied from the pillar pricing tables. */}
      {s.type === 'calculator' && <CostCalculator config={s.calculator} client:load />}

      {/* AUTHOR / REVIEWED line */}
      {s.type === 'byline' && (
        <p class={enhancedTypography ? "text-xs sm:text-sm text-neutral-400 font-semibold italic max-w-4xl leading-relaxed" : "text-xs text-neutral-400 font-semibold italic max-w-4xl leading-relaxed"}>{s.text}</p>
      )}

    </div>
  </section>
))}

{/* FORM-FIRST BODY (Request a Quote) — same JSON content as the generic loop above,
    laid out to match the form-first hero. Covers the section types that page uses;
    the generic loop is skipped for formFirst pages. */}
{formFirst && (() => {
  let bulletIdx = 0;
  return body.map((s: any) => {
    const badge = s.badge && (
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-primary/20 shadow-sm text-primary text-[11px] sm:text-xs font-bold uppercase tracking-widest mb-4">
        {s.badge}
      </div>
    );

    // BULLETS — first list as a card grid, later lists as a dark band
    if (s.type === 'bullets') {
      const dark = bulletIdx++ > 0;
      if (!dark) return (
        <section id={s.id} class="py-16 sm:py-24 bg-white relative">
          <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 grid lg:grid-cols-12 gap-10 lg:gap-12">
            <div class="lg:col-span-4">
              <div class="lg:sticky lg:top-28">
                {badge}
                {s.h2 && <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-black text-neutral-900 leading-[1.1] tracking-tight">{s.h2}</h2>}
                <span class="block w-14 h-1 rounded-full bg-primary mt-5" aria-hidden="true"></span>
              </div>
            </div>
            <ul class="lg:col-span-8 grid sm:grid-cols-2 gap-4 sm:gap-5">
              {s.items.map((item: any, i: number) => (
                <li class={`group relative bg-gradient-to-br from-white to-[#fff7f1] rounded-2xl border border-neutral-100 p-6 shadow-[0_16px_40px_-28px_rgba(0,0,0,0.25)] hover:border-primary/25 hover:-translate-y-0.5 transition-all duration-300 ${s.items.length % 2 === 1 && i === s.items.length - 1 ? 'sm:col-span-2' : ''}`}>
                  <span class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center mb-4 shadow-[0_0_0_5px_rgba(240,90,44,0.12)]">
                    <Check className="w-5 h-5" strokeWidth={3} />
                  </span>
                  {item.html
                    ? <p class="text-neutral-700 text-[15px] leading-relaxed font-medium" set:html={item.html} />
                    : <p class="text-neutral-700 text-[15px] leading-relaxed font-medium">{item.text ?? item}</p>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
      return (
        <section id={s.id} class="py-6 sm:py-10 bg-white">
          <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
            <div class="theme-keep-light relative overflow-hidden bg-neutral-950 rounded-[1.75rem] px-6 py-10 sm:p-12 lg:p-14 shadow-[0_30px_70px_-35px_rgba(0,0,0,0.5)]">
              <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-primary/25 blur-[100px] pointer-events-none"></div>
              <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-[#F58439]/10 blur-[100px] pointer-events-none"></div>
              <div class="relative z-10">
                {s.badge && <div class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-primary/15 border border-primary/30 text-primary text-[11px] sm:text-xs font-bold uppercase tracking-widest mb-4">{s.badge}</div>}
                {s.h2 && <h2 class="max-w-3xl text-3xl sm:text-4xl lg:text-[44px] font-black text-white leading-[1.1] tracking-tight mb-10">{s.h2}</h2>}
                <ul class={`grid gap-5 ${s.items.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2'}`}>
                  {s.items.map((item: any) => (
                    <li class="rounded-2xl bg-white/[0.04] border border-white/10 p-6 hover:bg-white/[0.07] hover:border-primary/30 transition-colors">
                      <span class="w-11 h-11 rounded-full bg-primary/15 ring-1 ring-primary/40 text-primary flex items-center justify-center mb-4">
                        <ShieldCheck className="w-5 h-5" />
                      </span>
                      {item.html
                        ? <p class="text-neutral-300 text-[15px] leading-relaxed font-medium" set:html={item.html} />
                        : <p class="text-neutral-300 text-[15px] leading-relaxed font-medium">{item.text ?? item}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </section>
      );
    }

    // PROSE — heading left, story card right
    if (s.type === 'prose') return (
      <section id={s.id} class="py-16 sm:py-24 bg-white">
        <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-4">
            {badge}
            {s.h2 && <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-black text-neutral-900 leading-[1.1] tracking-tight">{s.h2}</h2>}
            <span class="block w-14 h-1 rounded-full bg-primary mt-5" aria-hidden="true"></span>
          </div>
          <div class="lg:col-span-8 relative bg-gradient-to-br from-[#fff4ec] to-white rounded-[1.75rem] border border-primary/10 border-l-4 border-l-primary p-7 sm:p-10 shadow-[0_20px_50px_-35px_rgba(240,90,44,0.4)]">
            <Quote className="absolute top-6 right-6 w-12 h-12 text-primary/15" aria-hidden="true" />
            <div class="space-y-5 relative pr-10 sm:pr-14">
              {s.paragraphs.map((p: any) => (
                <p class="text-neutral-700 text-base sm:text-lg leading-relaxed font-medium">
                  {p.lead && <strong class="font-black text-neutral-900">{p.lead}</strong>}
                  {p.lead && ' '}
                  {p.html ? <Fragment set:html={p.html} /> : (p.text ?? p)}
                </p>
              ))}
            </div>
          </div>
        </div>
      </section>
    );

    // LINKS — icon cards
    if (s.type === 'links') {
      const words = (s.h2 ?? '').split(' ');
      const h2Accent = words.length > 1 ? words.pop() : '';
      return (
      <section id={s.id} class="relative py-16 sm:py-24 bg-gradient-to-b from-white via-[#fff8f3] to-[#fff4ec] overflow-hidden">
        <div class="absolute -left-40 -top-40 w-[520px] h-[520px] rounded-full border-[40px] border-primary/[0.04] pointer-events-none" aria-hidden="true"></div>
        <div class="absolute right-0 top-0 w-64 h-64 bg-[radial-gradient(rgba(240,90,44,0.18)_1.5px,transparent_1.5px)] [background-size:16px_16px] [mask-image:radial-gradient(circle_at_top_right,black,transparent_70%)] pointer-events-none" aria-hidden="true"></div>
        <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10">
          <div class="mb-10 sm:mb-12 max-w-3xl">
            {s.badge && (
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-primary/15 shadow-sm text-primary text-xs sm:text-[13px] font-bold uppercase tracking-wider mb-5">
                <Layers className="w-4 h-4" />
                {s.badge}
              </div>
            )}
            {s.h2 && (
              <h2 class="text-3xl sm:text-4xl lg:text-[52px] font-black text-neutral-900 leading-[1.08] tracking-tight">
                {words.join(' ')}{h2Accent && ' '}
                {h2Accent && (
                  <span class="relative inline-block text-primary">
                    {h2Accent}
                    <svg class="absolute -bottom-2 left-0 w-full h-2.5 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" aria-hidden="true">
                      <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                    </svg>
                  </span>
                )}
              </h2>
            )}
          </div>
          <div class={`grid gap-5 lg:gap-7 ${s.items.length >= 3 ? 'md:grid-cols-3' : 'sm:grid-cols-2'}`}>
            {s.items.map((item: any, i: number) => {
              const LinkIcon = linkIcons[i % linkIcons.length];
              return (
                <a href={item.href} class="group relative overflow-hidden flex flex-col bg-white rounded-[1.75rem] border border-neutral-100 p-7 sm:p-8 shadow-[0_20px_50px_-30px_rgba(0,0,0,0.25)] hover:border-primary/25 hover:shadow-[0_28px_60px_-30px_rgba(240,90,44,0.45)] hover:-translate-y-1 transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50">
                  <svg class="absolute right-0 bottom-0 w-3/4 h-24 text-primary/[0.07] pointer-events-none" viewBox="0 0 300 100" preserveAspectRatio="none" fill="currentColor" aria-hidden="true">
                    <path d="M0 100C120 95 220 60 300 0v100z" />
                  </svg>
                  <span class="relative w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors duration-300">
                    <LinkIcon className="w-7 h-7" />
                  </span>
                  <span class="relative block text-xl sm:text-[22px] font-black text-neutral-900 leading-snug tracking-tight">{item.label}</span>
                  {item.text && <span class="relative block text-neutral-600 text-[15px] sm:text-base font-medium mt-3 leading-relaxed">{item.text}</span>}
                  <span class="relative mt-auto pt-8 flex justify-end" aria-hidden="true">
                    <span class="w-11 h-11 rounded-full bg-primary text-white flex items-center justify-center shadow-[0_10px_20px_-8px_rgba(240,90,44,0.6)] group-hover:translate-x-1 transition-transform duration-300">
                      <ArrowRight className="w-5 h-5" />
                    </span>
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
      );
    }

    // FAQ — centred, soft cards
    if (s.type === 'faq') return (
      <section id={s.id} class="py-16 sm:py-24 bg-[#fff8f3]">
        <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
          <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
            {badge}
            {s.h2 && <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-black text-neutral-900 leading-[1.1] tracking-tight">{s.h2}</h2>}
            <span class="block w-14 h-1 rounded-full bg-primary mx-auto mt-5" aria-hidden="true"></span>
          </div>
          <div class="max-w-3xl mx-auto space-y-4">
            {s.items.map((faq: any) => (
              <details class="group bg-white rounded-2xl border border-neutral-100 shadow-[0_10px_30px_-20px_rgba(0,0,0,0.2)] open:border-primary/20 open:shadow-[0_16px_40px_-20px_rgba(240,90,44,0.35)] transition-shadow [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 sm:px-7 py-5 rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40">
                  <h3 class="text-[15px] sm:text-base font-bold text-neutral-900">{faq.q}</h3>
                  <span class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-open:-rotate-180">
                    <ChevronDown className="w-4 h-4" />
                  </span>
                </summary>
                <div class="px-5 sm:px-7 pb-6 -mt-1 text-[15px] text-neutral-600 leading-relaxed font-medium">
                  {faq.aHtml ? <Fragment set:html={faq.aHtml} /> : faq.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    );

    // CTA — orange brand card
    if (s.type === 'cta') return (
      <section id={s.id} class="py-16 sm:py-20 bg-white">
        <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
          <div class="theme-keep-light relative overflow-hidden rounded-[1.75rem] bg-gradient-to-r from-primary to-[#F58439] px-7 py-10 sm:px-12 sm:py-14 shadow-[0_30px_60px_-30px_rgba(240,90,44,0.7)]">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_90%_10%,rgba(255,255,255,0.2),transparent_45%)] pointer-events-none"></div>
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8 text-center lg:text-left">
              <div class="max-w-2xl mx-auto lg:mx-0">
                {s.h2 && <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white leading-tight tracking-tight">{s.h2}</h2>}
                {(s.paragraphs ?? []).map((p: any) => (
                  p.html
                    ? <p class="mt-3 text-white/90 text-base sm:text-lg font-medium leading-relaxed" set:html={p.html} />
                    : <p class="mt-3 text-white/90 text-base sm:text-lg font-medium leading-relaxed">{p.text ?? p}</p>
                ))}
              </div>
              <div class="flex flex-col sm:flex-row items-center justify-center gap-4 flex-shrink-0">
                {s.ctas.map((cta: any, i: number) => (
                  <a
                    href={cta.href}
                    class={i === 0
                      ? "w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 text-base font-bold text-primary bg-white rounded-full shadow-[0_10px_30px_-10px_rgba(0,0,0,0.3)] hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap"
                      : "w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 text-base font-bold text-white border-2 border-white/60 rounded-full hover:bg-white/10 hover:border-white transition-all duration-300 whitespace-nowrap"}
                  >
                    {cta.label}
                    <ArrowRight className="w-4 h-4" />
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    );

    return null;
  });
})()}

