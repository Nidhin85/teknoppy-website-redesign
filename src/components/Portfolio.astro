---
import { ExternalLink, ArrowUpRight, ArrowRight } from 'lucide-react';

// Real client work, sourced from the case-study cluster in src/data/pages/case-studies/.
// Deliberately no result metrics: every statBand in that cluster is empty because the
// project rule is "never publish an estimated stat" (case-study.json devNotes). The
// figures that used to sit here (+120% patient leads, 3.5x ROI, and so on) were invented
// alongside three fictional clients. Facts shown below are verifiable from the live sites.
const projects = [
  {
    client: "Lenaa",
    location: "Kochi, Kerala",
    title: "One Personal Brand Website for an Actor, Author and TEDx Speaker",
    industry: "Personal Brand, Film & Publishing",
    href: "/lenaa-personal-brand-website-case-study/",
    imageDesktop: "/case-studies/lenaalife-desktop.webp",
    imageMobile: "/case-studies/lenaalife-mobile.webp",
    imageAlt: "Lenaa website homepage screenshot — personal brand website design project by Teknoppy, Kerala",
    summary: "A Malayalam cinema actor, bestselling author of Women-O-Pause and The Autobiography of God, and a three-time TEDx speaker — whose work lived across separate social profiles, with no single site to send press, readers or event organisers to.",
    services: "Personal Brand Website Design, UI/UX Design, SEO",
    liveLabel: "lenaalife.com",
    liveUrl: "https://www.lenaalife.com/",
    color: "from-amber-500/20 to-rose-500/20",
    accent: "bg-amber-500"
  },
  {
    client: "TriQare",
    location: "Mumbai, India (Pan-India)",
    title: "A Trust-First Pre-Launch Platform for a One-Tap Emergency SOS App",
    industry: "Healthtech",
    href: "/case-studies/triqare-web-application-design/",
    imageDesktop: "/case-studies/triqare-desktop.webp",
    imageMobile: "/case-studies/triqare-mobile.webp",
    imageAlt: "TriQare website homepage screenshot — healthtech web application design project by Teknoppy",
    summary: "A Mumbai-registered healthtech startup building India's first one-tap emergency ambulance SOS app, where the pre-launch site had to establish medical credibility before a single user had downloaded anything.",
    services: "Web Design, Content Strategy, SEO",
    liveLabel: "triqare.in",
    liveUrl: "https://triqare.in",
    color: "from-blue-500/20 to-cyan-500/20",
    accent: "bg-blue-500"
  },
  {
    client: "Apolo Mattress",
    location: "Ernakulam, Kerala",
    title: "A Shopify Store Built to Answer Every Question Before Checkout",
    industry: "Ecommerce, Manufacturing",
    href: "/case-studies/apolo-mattress-shopify-ecommerce/",
    imageDesktop: "/case-studies/apolomattress-desktop.webp",
    imageMobile: "/case-studies/apolomattress-mobile.webp",
    imageAlt: "Apolo Mattress Shopify store homepage screenshot — ecommerce website project by Teknoppy, Kerala",
    summary: "A Kerala mattress manufacturer selling memory foam, latex and pocket spring ranges backed by a 15-year warranty — a considered purchase where every unanswered question costs a sale.",
    services: "Shopify Development, Website Design, SEO",
    liveLabel: "apolomattress.com",
    liveUrl: "https://apolomattress.com",
    color: "from-purple-500/20 to-indigo-500/20",
    accent: "bg-purple-500"
  },
  {
    client: "Greens Ayurveda",
    location: "Azhiyur, Kozhikode, Kerala",
    title: "Global Wellness & Ayurvedic Hospital Platform Driving International Patient Care",
    industry: "Healthcare & Ayurveda",
    href: "/case-study/",
    imageDesktop: "/case-studies/greensayurveda.webp",
    imageMobile: "/case-studies/greensayurveda.webp",
    imageAlt: "Greens Ayurveda website homepage screenshot — wellness hospital website design by Teknoppy",
    summary: "A calm, mobile-first wellness website for a prestigious Ayurvedic hospital in North Kerala, connecting international and domestic patients with verified treatment programs and direct inquiry forms.",
    services: "Website Design, Content Architecture, Healthcare SEO",
    liveLabel: "greensayurveda.com",
    liveUrl: "https://greensayurveda.com",
    color: "from-emerald-500/20 to-teal-500/20",
    accent: "bg-emerald-500"
  },
  {
    client: "Olives Resort",
    location: "Wayanad, Kerala",
    title: "Immersive Hospitality Website with Direct Booking Integration & Interactive Route Maps",
    industry: "Hospitality & Eco-Tourism",
    href: "/case-studies/olives-boutique-resort-digital-marketing/",
    imageDesktop: "/case-studies/olivesresort.webp",
    imageMobile: "/case-studies/olivesresort.webp",
    imageAlt: "Olives Boutique Resort website homepage screenshot — resort website design by Teknoppy",
    summary: "An eco-friendly resort in Kalpetta, Wayanad featuring room showcase galleries, clear travel connectivity details, and direct booking inquiries that reduce third-party OTA commissions.",
    services: "Website Strategy, Social Media Marketing, Booking Enquiry Flow",
    liveLabel: "olivesresort.com",
    liveUrl: "https://www.instagram.com/olivesresortwayanad/",
    color: "from-lime-500/20 to-green-500/20",
    accent: "bg-lime-600"
  }
];
---

<section id="portfolio" class="py-12 sm:py-14 md:py-20 bg-white overflow-hidden text-neutral-900 relative">
  <!-- Dynamic warm background elements -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-secondary/10 rounded-full blur-[150px] -z-10"></div>
  <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-primary/8 rounded-full blur-[150px] -z-10"></div>
  
  <div class="max-w-[1280px] mx-auto px-3.5 sm:px-6 lg:px-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 sm:gap-10 mb-10 sm:mb-12 md:mb-14">
      <div class="max-w-3xl relative">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-bold uppercase tracking-wider mb-8 shadow-sm transform -rotate-1">
          Proven Results
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight text-neutral-900 mb-6" data-magnetic-heading>
          Our Recent Website Design <br class="hidden lg:block"/> Projects in Kerala
        </h2>
        <p class="text-xl text-neutral-600 font-medium leading-relaxed max-w-2xl">
          From startups and clinics to retail brands and corporate enterprises, our portfolio reflects the diversity of Kerala businesses we have helped build their digital presence. Every project is unique — and every result is measurable.
        </p>
      </div>
      <a href="/portfolios/" class="group inline-flex items-center gap-3 px-8 py-4 text-sm font-bold text-white bg-primary rounded-full hover:bg-primary/95 transition-all flex-shrink-0 shadow-lg shadow-primary/20">
        View All Projects
        <ExternalLink className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
      </a>
    </div>

    <!-- Case Study Showcase Layout -->
    <div class="space-y-4 sm:space-y-8 lg:space-y-12">
      {projects.map((project, index) => (
        <article class="case-study-card rounded-2xl sm:rounded-3xl border border-primary/50 bg-white p-2.5 min-[360px]:p-3.5 sm:p-6 lg:p-8 xl:p-10 shadow-[0_4px_24px_rgba(240,90,44,0.04)] hover:border-primary hover:shadow-[0_8px_30px_rgba(240,90,44,0.12)] transition-all duration-500 relative overflow-hidden group scroll-mt-20 sm:scroll-mt-24">
          <div class={`flex flex-col ${index % 2 !== 0 ? 'lg:flex-row-reverse' : 'lg:flex-row'} items-center gap-2.5 min-[360px]:gap-3 sm:gap-6 lg:gap-10 xl:gap-14`}>
            
            <!-- Image Mockup Container -->
            <div class="w-full lg:w-[48%] xl:w-[50%] relative z-10">
              <!-- Background Glow -->
              <div class={`absolute inset-0 bg-gradient-to-tr ${project.color} rounded-2xl transform ${index % 2 !== 0 ? 'rotate-1' : '-rotate-1'} scale-105 opacity-0 group-hover:opacity-100 transition-all duration-700 blur-xl`}></div>
              
              <!-- Main Desktop Window -->
              <div class="relative bg-white rounded-xl sm:rounded-2xl shadow-[0_10px_30px_rgba(240,90,44,0.06)] border border-neutral-200/80 overflow-hidden transform group-hover:-translate-y-1 transition-all duration-500 z-20">
                <div class="h-5 min-[360px]:h-6 sm:h-9 bg-neutral-50 border-b border-neutral-200/80 flex items-center px-2 min-[360px]:px-2.5 sm:px-4 gap-1 sm:gap-2">
                  <div class="w-1.5 h-1.5 min-[360px]:w-2 min-[360px]:h-2 sm:w-3 sm:h-3 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-1.5 h-1.5 min-[360px]:w-2 min-[360px]:h-2 sm:w-3 sm:h-3 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-1.5 h-1.5 min-[360px]:w-2 min-[360px]:h-2 sm:w-3 sm:h-3 rounded-full bg-[#27C93F]"></div>
                </div>
                
                <div class="aspect-[16/9] sm:aspect-[16/10] bg-cream relative overflow-hidden">
                  <img
                    src={project.imageDesktop}
                    alt={project.imageAlt}
                    width="1600"
                    height="1000"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-top group-hover:scale-102 transition-transform duration-700"
                  />
                </div>
              </div>
              
              <!-- Floating Mobile Mockup (Tablet & Desktop) -->
              <div class={`absolute -bottom-6 ${index % 2 !== 0 ? '-left-6' : '-right-6'} w-[32%] aspect-[9/19] bg-white rounded-xl sm:rounded-2xl shadow-xl border-3 border-neutral-900 overflow-hidden transform group-hover:-translate-y-4 ${index % 2 !== 0 ? 'group-hover:translate-x-2 rotate-4' : 'group-hover:-translate-x-2 -rotate-4'} transition-all duration-500 hidden md:block z-30`}>
                 <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[38%] h-3 bg-neutral-900 rounded-b-lg z-10"></div>
                 <img
                   src={project.imageMobile}
                   alt=""
                   aria-hidden="true"
                   width="430"
                   height="932"
                   loading="lazy"
                   decoding="async"
                   class="w-full h-full object-cover object-top bg-cream"
                 />
              </div>
            </div>

            <!-- Project Information -->
            <div class={`w-full lg:w-[52%] xl:w-[50%] flex flex-col items-start pt-1 sm:pt-2 lg:pt-0 relative z-20`}>
              <div class="w-full flex items-center justify-between gap-2 mb-1 sm:mb-3">
                <div class="px-2.5 sm:px-4 py-0.5 sm:py-1.5 rounded-full bg-primary/10 border border-primary/20 text-[10px] min-[360px]:text-[11px] sm:text-xs font-bold text-primary flex items-center gap-1.5">
                  <span class={`w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full ${project.accent}`}></span>
                  <span>{project.industry}</span>
                </div>
                <span class="text-[10px] min-[360px]:text-[11px] sm:hidden font-bold text-primary">
                  {project.location}
                </span>
              </div>
              
              <h3 class="text-base min-[360px]:text-lg sm:text-2xl lg:text-3xl font-black text-neutral-900 mb-0.5 sm:mb-1 leading-tight group-hover:text-primary transition-colors duration-300">
                {project.client}
              </h3>

              <p class="hidden sm:block text-[11px] sm:text-xs font-bold text-primary mb-2">
                Location: {project.location}
              </p>

              <h4 class="text-[11px] min-[360px]:text-xs sm:text-sm md:text-base font-bold text-neutral-800 mb-1 min-[360px]:mb-1.5 sm:mb-2.5 leading-snug">
                {project.title}
              </h4>

              <p class="text-[10.5px] min-[360px]:text-[11.5px] sm:text-sm text-neutral-600 mb-1.5 min-[360px]:mb-2.5 sm:mb-4 leading-normal sm:leading-relaxed font-normal">
                {project.summary}
              </p>
              
              <!-- Project facts: What We Delivered & Live Site -->
              <div class="grid grid-cols-2 gap-2 sm:gap-4 w-full mb-2 min-[360px]:mb-2.5 sm:mb-5 p-2 min-[360px]:p-2.5 sm:p-4 rounded-xl bg-cream/70 border border-neutral-200/60">
                <div>
                  <p class="text-[9px] min-[360px]:text-[10px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider mb-0.5 sm:mb-1">What We Delivered</p>
                  <p class="text-[10px] min-[360px]:text-[11px] sm:text-sm font-black text-neutral-900 leading-tight sm:leading-snug">{project.services}</p>
                </div>
                <div>
                  <p class="text-[9px] min-[360px]:text-[10px] sm:text-xs font-bold text-gray-500 uppercase tracking-wider mb-0.5 sm:mb-1">Live Site</p>
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-[10px] min-[360px]:text-[11px] sm:text-sm font-black text-primary hover:underline break-all"
                  >
                    <span>{project.liveLabel}</span>
                    <ExternalLink className="w-2.5 h-2.5 sm:w-3 sm:h-3 flex-shrink-0" />
                  </a>
                </div>
              </div>
              
              <a href={project.href} class="group/btn inline-flex items-center gap-1.5 sm:gap-2 text-[11px] min-[360px]:text-xs sm:text-sm font-bold text-neutral-800 bg-white border border-neutral-200 hover:border-primary/50 hover:bg-cream hover:text-primary px-3.5 py-1.5 min-[360px]:px-4 min-[360px]:py-2 sm:px-6 sm:py-3 rounded-full transition-all duration-300 shadow-sm">
                <span>View Case Study</span>
                <ArrowUpRight className="w-3.5 h-3.5 sm:w-4 sm:h-4 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform" />
              </a>
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- Regional Clients Strip -->
    <div class="mt-20 py-5 px-8 rounded-2xl bg-[#fcfcfc] border border-neutral-200/80 text-center">
      <p class="text-sm md:text-base font-bold text-neutral-800 tracking-wide">
        Clients in Kochi · Kozhikode · Wayanad · Thrissur · Thiruvananthapuram
      </p>
    </div>

    <!-- Conversion CTA: After Project Cards (Standout Checkpoint) -->
    <div class="cta-checkpoint mt-24 pt-12 border-t border-neutral-100 flex flex-col md:flex-row items-center justify-between gap-6 p-8 sm:p-10 rounded-2xl bg-cream/60 border border-neutral-200/70 text-center md:text-left">
      <div class="max-w-xl">
        <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">Want Results Like These?</h3>
        <p class="text-sm text-neutral-600 mt-1.5 leading-relaxed">Tell us what you're building and we'll suggest the right approach for your budget and timeline.</p>
      </div>
      <a
        href="/request-a-quote/"
        data-magnetic-btn
        class="cta-float-primary cta-delay-12 cta-pulse-strong cta-pulse-delay-3 cta-shimmer-btn inline-flex items-center justify-center gap-2.5 px-8 py-4 text-sm font-bold text-white bg-primary rounded-full hover:bg-primary/95 transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 shrink-0 group whitespace-nowrap"
      >
        <span>Want Results Like These? Let's Talk</span>
        <ArrowRight className="cta-arrow cta-arrow-invite w-4 h-4" />
      </a>
    </div>
  </div>
</section>
