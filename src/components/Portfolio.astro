---
import { ExternalLink, ArrowUpRight, BarChart3, Smartphone } from 'lucide-react';

const projects = [
  {
    title: "Healthcare Portal — Kochi",
    industry: "Healthcare",
    imageAlt: "website design project Kerala for healthcare client — Teknoppy portfolio",
    color: "from-blue-500/20 to-cyan-500/20",
    accent: "bg-blue-500",
    metric1: "+120%", metric1Label: "Patient Leads",
    metric2: "< 2s", metric2Label: "Load Time"
  },
  {
    title: "Ecommerce Store — Thrissur",
    industry: "Retail and Ecommerce",
    imageAlt: "responsive web design Kerala for retail ecommerce business — Teknoppy portfolio",
    color: "from-orange-500/20 to-red-500/20",
    accent: "bg-primary",
    metric1: "+85%", metric1Label: "Online Sales",
    metric2: "3.5x", metric2Label: "ROI"
  },
  {
    title: "Corporate Website — Kerala",
    industry: "Manufacturing Company",
    imageAlt: "custom website design Kerala for manufacturing company — Teknoppy portfolio",
    color: "from-purple-500/20 to-indigo-500/20",
    accent: "bg-purple-500",
    metric1: "Page 1", metric1Label: "Google Rank",
    metric2: "+200%", metric2Label: "Traffic"
  }
];
---

<section id="portfolio" class="py-32 bg-white overflow-hidden text-neutral-900 relative">
  <!-- Dynamic warm background elements -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-secondary/10 rounded-full blur-[150px] -z-10"></div>
  <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-primary/8 rounded-full blur-[150px] -z-10"></div>
  
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-10 mb-24">
      <div class="max-w-3xl relative">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-bold uppercase tracking-wider mb-8 shadow-sm transform -rotate-1">
          Proven Results
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight text-neutral-900 mb-6">
          Our Recent Website Design <br class="hidden lg:block"/> Projects in Kerala
        </h2>
        <p class="text-xl text-neutral-600 font-medium leading-relaxed max-w-2xl">
          From startups and clinics to retail brands and corporate enterprises, our portfolio reflects the diversity of Kerala businesses we have helped build their digital presence. Every project is unique — and every result is measurable.
        </p>
      </div>
      <a href="/portfolios/" class="group inline-flex items-center gap-3 px-8 py-4 text-sm font-bold text-white bg-primary rounded-full hover:bg-primary/95 transition-all flex-shrink-0 shadow-lg shadow-primary/20">
        View All Projects
        <ExternalLink className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
      </a>
    </div>

    <!-- Case Study Showcase Layout -->
    <div class="space-y-32">
      {projects.map((project, index) => (
        <div class={`flex flex-col ${index % 2 !== 0 ? 'lg:flex-row-reverse' : 'lg:flex-row'} items-center gap-0 lg:gap-16 group relative`}>
          
          <!-- Image Mockup Container (Overlapping Layout) -->
          <div class="w-full lg:w-[55%] relative z-10">
            <!-- Background Glow -->
            <div class={`absolute inset-0 bg-gradient-to-tr ${project.color} rounded-[3rem] transform ${index % 2 !== 0 ? 'rotate-2' : '-rotate-2'} scale-105 opacity-0 group-hover:opacity-100 transition-all duration-700 blur-xl`}></div>
            
            <!-- Main Desktop Window -->
            <div class="relative bg-white rounded-2xl shadow-[0_20px_50px_rgba(255,107,26,0.06)] border border-neutral-100 overflow-hidden transform group-hover:-translate-y-2 group-hover:shadow-[0_30px_60px_rgba(255,107,26,0.12)] transition-all duration-700 z-20">
              <div class="h-10 bg-neutral-50 border-b border-neutral-200/80 flex items-center px-4 gap-2">
                <div class="w-3 h-3 rounded-full bg-[#FF5F56]"></div>
                <div class="w-3 h-3 rounded-full bg-[#FFBD2E]"></div>
                <div class="w-3 h-3 rounded-full bg-[#27C93F]"></div>
              </div>
              
              <div class="aspect-[16/10] bg-[#FFF8EF] relative overflow-hidden group-hover:scale-102 transition-transform duration-700">
                <!-- Abstract Placeholder for Image -->
                <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-white to-[#FFC247]/10"></div>
                <div class="absolute inset-0 flex items-center justify-center opacity-50">
                  <div class="w-32 h-32 border border-dashed border-[#FF6B1A]/20 rounded-full flex items-center justify-center animate-[spin_10s_linear_infinite]">
                    <div class="w-20 h-20 border border-dashed border-[#FF6B1A]/20 rounded-full animate-[spin_8s_linear_infinite_reverse]"></div>
                  </div>
                </div>
                <div class="absolute inset-0 flex items-center justify-center z-10">
                  <span class="text-sm font-bold text-neutral-700 bg-white px-6 py-3 rounded-full shadow-sm border border-neutral-200">
                    {project.title}
                  </span>
                </div>
              </div>
            </div>
            
            <!-- Floating Mobile Mockup -->
            <div class={`absolute -bottom-10 ${index % 2 !== 0 ? '-left-10' : '-right-10'} w-[35%] aspect-[9/19] bg-white rounded-2xl shadow-2xl border-4 border-neutral-900 overflow-hidden transform group-hover:-translate-y-8 ${index % 2 !== 0 ? 'group-hover:translate-x-4 rotate-6' : 'group-hover:-translate-x-4 -rotate-6'} transition-all duration-700 hidden md:block z-30`}>
               <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[40%] h-4 bg-neutral-900 rounded-b-xl z-10"></div>
               <div class="w-full h-full bg-[#FFF8EF] flex flex-col items-center justify-center text-xs text-primary gap-2">
                 <Smartphone className="w-6 h-6 text-primary" />
                 Mobile View
               </div>
            </div>
          </div>

          <!-- Project Information -->
          <div class={`w-full lg:w-[45%] flex flex-col items-start pt-12 lg:pt-0 relative z-20 ${index % 2 !== 0 ? 'lg:pr-12' : 'lg:pl-12'}`}>
            <!-- Vertical Line Connection on Desktop -->
            <div class={`hidden lg:block absolute top-1/2 -translate-y-1/2 ${index % 2 !== 0 ? '-right-8' : '-left-8'} w-16 h-px bg-neutral-200`}></div>
            
            <div class="px-5 py-2 rounded-full bg-primary/10 border border-primary/20 text-xs font-bold text-primary mb-8 flex items-center gap-2">
              <span class={`w-2 h-2 rounded-full ${project.accent}`}></span>
              {project.industry}
            </div>
            
            <h3 class="text-3xl lg:text-4xl xl:text-5xl font-black text-neutral-900 mb-6 leading-[1.1] group-hover:text-primary transition-all duration-500">
              {project.title}
            </h3>
            
            <p class="text-neutral-600 text-lg mb-10 leading-relaxed font-medium">
              We developed a completely custom, high-performance solution tailored to the specific needs of this {project.industry.toLowerCase()} client, focusing on conversions and mobile experience.
            </p>
            
            <!-- Result Metrics Board -->
            <div class="grid grid-cols-2 gap-6 w-full mb-10 p-6 rounded-2xl bg-[#FFF8EF]/80 border border-[#FF6B1A]/10">
              <div>
                <p class="text-3xl font-black mb-1 text-primary">{project.metric1}</p>
                <p class="text-sm font-bold text-gray-500 uppercase">{project.metric1Label}</p>
              </div>
              <div>
                <p class="text-3xl font-black mb-1 text-primary">{project.metric2}</p>
                <p class="text-sm font-bold text-gray-500 uppercase">{project.metric2Label}</p>
              </div>
            </div>
            
            <a href="#" class="group/btn inline-flex items-center gap-3 text-neutral-800 font-bold text-lg bg-white border border-neutral-200 hover:border-primary/50 hover:bg-[#FFF8EF] hover:text-primary px-8 py-4 rounded-full transition-all duration-300 shadow-sm">
              View Case Study 
              <ArrowUpRight className="w-5 h-5 group-hover/btn:rotate-45 transition-transform" />
            </a>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>
