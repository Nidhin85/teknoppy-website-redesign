---
import { ExternalLink, ArrowUpRight, ArrowRight } from 'lucide-react';

// Real client work, sourced from the case-study cluster in src/data/pages/case-studies/.
// Deliberately no result metrics: every statBand in that cluster is empty because the
// project rule is "never publish an estimated stat" (case-study.json devNotes). The
// figures that used to sit here (+120% patient leads, 3.5x ROI, and so on) were invented
// alongside three fictional clients. Facts shown below are verifiable from the live sites.
const projects = [
  {
    client: "Lenaa",
    location: "Kochi, Kerala",
    title: "One Personal Brand Website for an Actor, Author and TEDx Speaker",
    industry: "Personal Brand, Film & Publishing",
    href: "/lenaa-personal-brand-website-case-study/",
    imageDesktop: "/case-studies/lenaalife-desktop.webp",
    imageMobile: "/case-studies/lenaalife-mobile.webp",
    imageAlt: "Lenaa website homepage screenshot — personal brand website design project by Teknoppy, Kerala",
    summary: "A Malayalam cinema actor, bestselling author of Women-O-Pause and The Autobiography of God, and a three-time TEDx speaker — whose work lived across separate social profiles, with no single site to send press, readers or event organisers to.",
    services: "Personal Brand Website Design, UI/UX Design",
    liveLabel: "lenaalife.com",
    liveUrl: "https://www.lenaalife.com/",
    color: "from-amber-500/20 to-rose-500/20",
    accent: "bg-amber-500"
  },
  {
    client: "Apolo Mattress",
    location: "Ernakulam, Kerala",
    title: "A Shopify Store Built to Answer Every Question Before Checkout",
    industry: "Ecommerce, Manufacturing",
    href: "/case-studies/apolo-mattress-shopify-ecommerce/",
    imageDesktop: "/case-studies/apolomattress-desktop.webp",
    imageMobile: "/case-studies/apolomattress-mobile.webp",
    imageAlt: "Apolo Mattress Shopify store homepage screenshot — ecommerce website project by Teknoppy, Kerala",
    summary: "A Kerala mattress manufacturer selling memory foam, latex and pocket spring ranges backed by a 15-year warranty — a considered purchase where every unanswered question costs a sale.",
    services: "Shopify Development, Website Design, SEO",
    liveLabel: "apolomattress.com",
    liveUrl: "https://apolomattress.com",
    color: "from-purple-500/20 to-indigo-500/20",
    accent: "bg-purple-500"
  },
  {
    client: "Olives Resort",
    location: "Wayanad, Kerala",
    title: "Immersive Hospitality Website with Direct Booking Integration & Interactive Route Maps",
    industry: "Hospitality & Eco-Tourism",
    href: "/case-studies/olives-boutique-resort-digital-marketing/",
    imageDesktop: "/case-studies/olivesresort.webp",
    imageMobile: "/case-studies/olivesresort.webp",
    imageAlt: "Olives Boutique Resort website homepage screenshot — resort website design by Teknoppy",
    summary: "An eco-friendly resort in Kalpetta, Wayanad featuring room showcase galleries, clear travel connectivity details, and direct booking inquiries that reduce third-party OTA commissions.",
    services: "Website Strategy, Social Media Marketing, Booking Enquiry Flow",
    liveLabel: "olivesresort.com",
    liveUrl: "https://www.instagram.com/olivesresortwayanad/",
    color: "from-lime-500/20 to-green-500/20",
    accent: "bg-lime-600"
  },
  {
    client: "Abrus Krishna Finance",
    location: "Guruvayoor, Kerala",
    title: "Designing a Trust-First UI for a Regulated Lending Business",
    industry: "Finance & Lending",
    href: "/case-studies/abrus-krishna-finance-ui-ux-design/",
    imageDesktop: "/case-studies/abruskrishna.webp",
    imageMobile: "/case-studies/abruskrishna.webp",
    imageAlt: "Abrus Krishna Finance website homepage screenshot — UI/UX design project by Teknoppy, Kerala",
    summary: "A Kerala Money-Lenders Act (KML) registered lending company offering gold loans and a range of micro business, personal and home loans, needing a visually distinct, trust-first interface across its loan products.",
    services: "UI/UX Design, Website Design, SEO",
    liveLabel: "abruskrishna.com",
    liveUrl: "https://abruskrishna.com",
    color: "from-yellow-500/20 to-amber-500/20",
    accent: "bg-amber-600"
  },
  {
    client: "Visakh RJ",
    location: "Mumbai, India",
    title: "Personal Brand SEO for a PMP Trainer Competing with Large Training Platforms",
    industry: "PMP Training & Leadership Coaching",
    href: "/case-studies/visakh-rj-pmp-trainer-seo/",
    imageDesktop: "/case-studies/visakh-rj-seo.webp",
    imageMobile: "/case-studies/visakh-rj-seo.webp",
    imageAlt: "Visakh RJ PMP trainer website screenshot — personal brand SEO case study by Teknoppy",
    summary: "A Mumbai PMP trainer competing with large training platforms, supported with Person and Course schema, a 132-keyword map and a backlink content kit.",
    services: "Schema, Keyword Research, Meta, Backlink Content",
    liveLabel: "rjvisakh.com",
    liveUrl: "https://www.rjvisakh.com/",
    color: "from-sky-500/20 to-indigo-500/20",
    accent: "bg-sky-500"
  }
];
---

<section id="portfolio" class="feat-band relative overflow-hidden text-white">
  <!-- Rendered mountain range (decorative) -->
  <div class="feat-mountains" aria-hidden="true"></div>
  <div class="feat-glow" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1320px] mx-auto px-5 sm:px-8 lg:px-12 pt-16 sm:pt-20 lg:pt-24 pb-16 sm:pb-20">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-10 sm:mb-12">
      <div class="max-w-3xl">
        <span class="ds-eyebrow is-dark">Proven Results</span>
        <h2 class="mt-4 text-[2.2rem] sm:text-5xl lg:text-[3.6rem] font-black leading-[1.03] tracking-[-0.035em] text-white" data-magnetic-heading>
          Our Recent Website Design <br class="hidden lg:block"/> Projects in Kerala
        </h2>
        <p class="mt-5 text-base sm:text-lg text-white/70 font-medium leading-relaxed max-w-2xl">
          From startups and clinics to retail brands and corporate enterprises, our portfolio reflects the diversity of Kerala businesses we have helped build their digital presence. Every project is unique — and every result is measurable.
        </p>
      </div>
      <a href="/portfolios/" class="group inline-flex items-center gap-3 px-7 py-3.5 text-sm font-bold text-white bg-primary rounded-full hover:bg-primary/95 transition-all flex-shrink-0 self-center lg:self-auto">
        View All Projects
        <ExternalLink className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
      </a>
    </div>

    <!-- Image-led project cards -->
    <div class="feat-grid">
      {projects.map((project, index) => (
        <article class={`feat-card group scroll-mt-24 ${index < 3 ? 'is-top' : 'is-bottom'}`}>
          <div class="feat-media">
            <img
              src={project.imageDesktop}
              alt={project.imageAlt}
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
              class="feat-shot"
            />
            <div class="feat-scrim" aria-hidden="true"></div>
            <div class="feat-overlay">
              <div class="min-w-0">
                <h3 class="feat-client">{project.client}</h3>
                <p class="feat-industry"><span class={`w-1.5 h-1.5 rounded-full ${project.accent}`}></span>{project.industry}</p>
              </div>
              <a href={project.href} class="feat-go" aria-label={`View ${project.client} case study`}>
                <ArrowUpRight className="w-4 h-4" />
              </a>
            </div>
            <div class="feat-phone hidden md:block" aria-hidden="true">
              <div class="feat-notch"></div>
              <img src={project.imageMobile} alt="" aria-hidden="true" width="430" height="932" loading="lazy" decoding="async" class="w-full h-full object-cover object-top" />
            </div>
          </div>

          <div class="feat-body">
            <p class="text-xs font-bold text-[#ff9a66]">Location: {project.location}</p>
            <h4 class="mt-1.5 text-[0.98rem] sm:text-base font-bold text-white leading-snug">{project.title}</h4>
            <p class="mt-2 text-[0.85rem] text-white/65 leading-relaxed">{project.summary}</p>

            <div class="feat-facts">
              <div>
                <p class="feat-k">What We Delivered</p>
                <p class="text-[0.82rem] font-bold text-white leading-snug">{project.services}</p>
              </div>
              <div>
                <p class="feat-k">Live Site</p>
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[0.82rem] font-bold text-[#ff9a66] hover:underline break-all">
                  <span>{project.liveLabel}</span>
                  <ExternalLink className="w-3 h-3 flex-shrink-0" />
                </a>
              </div>
            </div>

            <a href={project.href} class="group/btn feat-cta">
              <span>View Case Study</span>
              <ArrowUpRight className="w-4 h-4 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform" />
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Regional Clients Strip -->
    <div class="mt-10 sm:mt-12 py-5 px-6 rounded-2xl feat-glass text-center">
      <p class="text-sm md:text-base font-bold text-white/85 tracking-wide">
        Clients in Kochi · Kozhikode · Wayanad · Thrissur · Thiruvananthapuram
      </p>
    </div>

    <!-- Conversion CTA: After Project Cards (Standout Checkpoint) -->
    <div class="cta-checkpoint mt-6 flex flex-col md:flex-row items-center justify-between gap-6 p-7 sm:p-9 rounded-[1.75rem] feat-glass text-center md:text-left">
      <div class="max-w-xl">
        <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Want Results Like These?</h3>
        <p class="text-sm text-white/65 mt-1.5 leading-relaxed">Tell us what you're building and we'll suggest the right approach for your budget and timeline.</p>
      </div>
      <a
        href="/request-a-quote/"
        data-magnetic-btn
        class="cta-float-primary cta-delay-12 cta-pulse-strong cta-pulse-delay-3 cta-shimmer-btn inline-flex items-center justify-center gap-2.5 px-8 py-4 text-sm font-bold text-white bg-primary rounded-full hover:bg-primary/95 transition-all shrink-0 group whitespace-nowrap"
      >
        <span>Want Results Like These? Let's Talk</span>
        <ArrowRight className="cta-arrow cta-arrow-invite w-4 h-4" />
      </a>
    </div>
  </div>
</section>

<style>
  .feat-band {
    background: linear-gradient(180deg, #1a1411 0%, #120f0e 45%, #0f0d0c 100%);
  }
  .feat-mountains {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(46vw, 560px);
    background: url('/images/home/3d/featured-mountains.webp') center top / cover no-repeat;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    opacity: 0.95;
  }
  .feat-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40rem 22rem at 10% 0%, rgba(255, 120, 50, 0.20), transparent 70%),
      radial-gradient(36rem 22rem at 95% 30%, rgba(255, 150, 80, 0.10), transparent 70%);
    pointer-events: none;
  }
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .feat-card.is-top { grid-column: span 2; }
  .feat-card.is-bottom { grid-column: span 3; }
  .feat-card {
    display: flex;
    flex-direction: column;
    border-radius: 1.6rem;
    overflow: hidden;
    /* Solid warm-charcoal card, clearly lighter than the #120f0e band, with an orange-brown edge */
    background: linear-gradient(170deg, #36291f 0%, #291f19 100%);
    border: 1px solid rgba(255, 138, 82, 0.40);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 0 0 1px rgba(0, 0, 0, 0.45),
      0 22px 44px -18px rgba(0, 0, 0, 0.85),
      0 12px 36px -22px rgba(240, 90, 44, 0.30);
    transition: transform 0.45s cubic-bezier(.2, .8, .2, 1), border-color 0.35s, box-shadow 0.45s;
  }
  .feat-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 138, 82, 0.7);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.1) inset,
      0 0 0 1px rgba(0, 0, 0, 0.45),
      0 30px 60px -22px rgba(0, 0, 0, 0.9),
      0 18px 50px -24px rgba(240, 90, 44, 0.5);
  }
  .feat-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin: 0.55rem 0.55rem 0;
    border-radius: 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    isolation: isolate; /* keeps the zooming screenshot clipped to the rounded corners */
  }
  .feat-card.is-bottom .feat-media { aspect-ratio: 16 / 8.2; }
  .feat-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.9s cubic-bezier(.2, .8, .2, 1);
  }
  .feat-card:hover .feat-shot { transform: scale(1.05); }
  .feat-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 8, 7, 0.82) 0%, rgba(10, 8, 7, 0.35) 34%, transparent 58%);
  }
  .feat-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.05rem;
  }
  .feat-client { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.02em; color: #fff; line-height: 1.15; }
  .feat-industry { margin-top: 0.3rem; display: flex; align-items: center; gap: 0.45rem; font-size: 0.78rem; font-weight: 600; color: rgba(255, 255, 255, 0.82); }
  .feat-go {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    color: #1a1a1a;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.6);
    transition: all 0.3s;
  }
  .feat-go:hover, .feat-card:hover .feat-go { background: var(--color-primary); color: #fff; transform: rotate(-8deg); }
  .feat-phone {
    position: absolute;
    right: 4%;
    bottom: -8%;
    width: 22%;
    aspect-ratio: 9 / 19;
    border-radius: 1rem;
    overflow: hidden;
    border: 3px solid #141414;
    background: #fff;
    box-shadow: 0 20px 40px -14px rgba(0, 0, 0, 0.75);
    transform: rotate(-4deg);
    transition: transform 0.5s cubic-bezier(.2, .8, .2, 1);
  }
  .feat-card:hover .feat-phone { transform: rotate(-4deg) translateY(-8px); }
  .feat-notch { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 38%; height: 0.55rem; background: #141414; border-radius: 0 0 0.45rem 0.45rem; z-index: 2; }
  .feat-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem 1.25rem 1.3rem;
  }
  .feat-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
    margin-top: 0.95rem;
    padding: 0.8rem 0.9rem;
    border-radius: 0.95rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .feat-k { font-size: 0.66rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255, 255, 255, 0.45); margin-bottom: 0.25rem; }
  .feat-cta {
    margin-top: 1rem;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.62rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    transition: all 0.3s;
  }
  .feat-cta:hover { border-color: #ff8a52; color: #ff9a66; }
  .feat-glass {
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.025));
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
  }
  @media (max-width: 1023px) {
    .feat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .feat-card.is-top, .feat-card.is-bottom { grid-column: span 1; }
    .feat-card.is-bottom .feat-media { aspect-ratio: 16 / 10; }
    .feat-card:last-child { grid-column: 1 / -1; }
    .feat-card:last-child .feat-media { aspect-ratio: 16 / 8; }
  }
  @media (max-width: 639px) {
    .feat-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .feat-card:last-child .feat-media { aspect-ratio: 16 / 10; }
    .feat-mountains { height: 260px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .feat-card, .feat-shot, .feat-phone { transition: none; }
    .feat-card:hover { transform: none; }
  }
</style>
