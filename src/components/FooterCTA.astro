---
import { Phone, Mail, MapPin, Zap } from 'lucide-react';
import site from '../data/site.json';
import Footer from './Footer.astro';

// Shared with the contact page. Defaults to FormSubmit, which emails sales@ (no server needed)
// — PUBLIC_CONTACT_ENDPOINT only needs setting to point the form
// somewhere else.
const formEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || 'https://formsubmit.co/ajax/sales@teknoppy.com';

interface Props {
  includeSchema?: boolean;
  personName?: string;
  personRole?: string;
  personImage?: string;
  personBio?: string;
  heading?: string;
  description?: string;
}

const defaultContact = site.defaultContact || {
  name: "Vijayakala",
  role: "Business Development & Client Relations",
  image: "/team/vijayakala-expert.webp",
  bio: "Vijayakala is the first point of contact for new enquiries and the ongoing link between clients and the delivery team, covering scoping, proposals, and account communication."
};

const { 
  includeSchema = true,
  personName = defaultContact.name,
  personRole = defaultContact.role,
  personImage = defaultContact.image,
  personBio = defaultContact.bio,
  heading,
  description
} = Astro.props;

const businessInfo = {
  name: site.businessName,
  address: site.address,
  phone: site.phone,
  email: site.email,
  whatsapp: site.whatsapp
};

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://teknoppy.com/#localbusiness",
  "name": businessInfo.name,
  "telephone": businessInfo.phone,
  "email": businessInfo.email,
  "url": "https://teknoppy.com/",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam, Vyttila, Ernakulam",
    "addressLocality": "Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  },
  "areaServed": [
    { "@type": "State", "name": "Kerala" },
    { "@type": "Country", "name": "United Arab Emirates" },
    { "@type": "Country", "name": "Qatar" }
  ]
};
---

<section id="contact" class="theme-keep-light py-12 sm:py-14 md:py-20 bg-primary relative text-white">
  <!-- Dynamic background for high contrast -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(255,255,255,0.15),transparent_45%)] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"></div>

  <div class="cta-reveal max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: SEO Content & Consultation Form -->
      <div class="lg:col-span-7 space-y-12">
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/15 border border-white/20 text-xs font-bold text-white uppercase tracking-widest backdrop-blur-sm w-fit shadow-sm">
            <Zap className="w-4 h-4 text-[#F9AE42]" />
            Let's Build Something Great
          </div>
          
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight text-white">
            {heading ? heading : (
              <>Ready to Work with the Leading <br class="hidden lg:block"/> <span class="text-cream">Web Design Company in Kerala?</span></>
            )}
          </h2>
          
          <p class="text-base md:text-lg text-white/95 leading-relaxed font-medium max-w-2xl">
            {description ? description : "Whether you are launching a new business website, rebuilding an outdated one, or scaling your web development Kerala digital infrastructure — Teknoppy is ready to deliver. Start with a free website audit and see exactly where your current online presence stands, or request a quote and get a clear, no-obligation proposal within 24 hours."}
          </p>
        </div>

        <!-- Consultation Form — Matched accurately to reference screenshot -->
        <div class="space-y-5 pt-2">
          <div class="flex items-start gap-3.5 mb-5">
            <span class="w-8 h-1.5 bg-[#F9AE42] rounded-full inline-block mt-3 shrink-0"></span>
            <h3 class="text-2xl sm:text-3xl lg:text-[34px] font-black text-white leading-[1.18] tracking-tight">
              Get a Consultation From<br />Our Expert
            </h3>
          </div>
          
          <form
            id="footer-cta-form"
            class="bg-white/[0.08] backdrop-blur-md border border-white/20 rounded-[28px] sm:rounded-[32px] p-5 sm:p-7 md:p-8 space-y-5 shadow-2xl"
            method="POST"
            novalidate
            data-endpoint={formEndpoint}
            data-source="Footer consultation form"
          >
            <!-- Honeypot: real people never see or fill this. Bots do. -->
            <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
              <label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
            </div>

            <!-- 1. FULL NAME * -->
            <div class="space-y-2">
              <label for="footer-name" class="block text-xs font-black text-white uppercase tracking-wider">FULL NAME <span class="text-[#F9AE42]">*</span></label>
              <input 
                id="footer-name"
                type="text" 
                name="name" 
                required 
                autocomplete="name"
                placeholder="Enter your full name"
                class="w-full bg-white/10 hover:bg-white/[0.14] focus:bg-white/20 border border-white/20 focus:border-[#F9AE42] focus:ring-2 focus:ring-[#F9AE42]/20 rounded-2xl px-5 py-3.5 sm:py-4 text-white placeholder-white/50 text-sm sm:text-base transition-all outline-none"
              />
            </div>

            <!-- 2. EMAIL ADDRESS * -->
            <div class="space-y-2">
              <label for="footer-email" class="block text-xs font-black text-white uppercase tracking-wider">EMAIL ADDRESS <span class="text-[#F9AE42]">*</span></label>
              <input 
                id="footer-email"
                type="email" 
                name="email" 
                required 
                autocomplete="email"
                placeholder="name@company.com"
                class="w-full bg-white/10 hover:bg-white/[0.14] focus:bg-white/20 border border-white/20 focus:border-[#F9AE42] focus:ring-2 focus:ring-[#F9AE42]/20 rounded-2xl px-5 py-3.5 sm:py-4 text-white placeholder-white/50 text-sm sm:text-base transition-all outline-none"
              />
            </div>

            <!-- 3. PHONE NUMBER * -->
            <div class="space-y-2">
              <label for="footer-phone" class="block text-xs font-black text-white uppercase tracking-wider">PHONE NUMBER <span class="text-[#F9AE42]">*</span></label>
              <input 
                id="footer-phone"
                type="tel" 
                name="phone" 
                required 
                autocomplete="tel"
                placeholder="+91 98765 43210"
                class="w-full bg-white/10 hover:bg-white/[0.14] focus:bg-white/20 border border-white/20 focus:border-[#F9AE42] focus:ring-2 focus:ring-[#F9AE42]/20 rounded-2xl px-5 py-3.5 sm:py-4 text-white placeholder-white/50 text-sm sm:text-base transition-all outline-none"
              />
            </div>

            <!-- 4. MESSAGE * -->
            <div class="space-y-2">
              <label for="footer-message" class="block text-xs font-black text-white uppercase tracking-wider">MESSAGE <span class="text-[#F9AE42]">*</span></label>
              <textarea 
                id="footer-message"
                name="message" 
                rows="4" 
                required 
                placeholder="Tell us about your project requirements..."
                class="w-full bg-white/10 hover:bg-white/[0.14] focus:bg-white/20 border border-white/20 focus:border-[#F9AE42] focus:ring-2 focus:ring-[#F9AE42]/20 rounded-2xl px-5 py-3.5 sm:py-4 text-white placeholder-white/50 text-sm sm:text-base transition-all outline-none resize-none"
              ></textarea>
            </div>

            <!-- 5. Submit Request > (Full-width prominent button matching reference image) -->
            <div class="pt-2">
              <button
                type="submit"
                class="cta-pulse-strong cta-pulse-delay-2 cta-shimmer-btn w-full inline-flex items-center justify-center gap-2 py-4 px-6 text-base sm:text-lg font-black text-neutral-950 bg-[#F9AE42] hover:bg-[#E89F36] rounded-2xl shadow-[0_10px_30px_rgba(249,174,66,0.35)] hover:shadow-[0_12px_35px_rgba(249,174,66,0.5)] hover:-translate-y-0.5 active:scale-[0.99] transition-all duration-200 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span>Submit Request</span>
                <span class="text-xl font-black leading-none ml-1">&gt;</span>
              </button>
            </div>

            <p
              id="footer-cta-status"
              role="status"
              aria-live="polite"
              class="hidden text-sm font-semibold leading-relaxed rounded-2xl px-5 py-4 border transition-all"
            ></p>
          </form>

          <slot name="after-form" />
        </div>
      </div>

      <!-- Right Column: Business Development & Client Relations Expert Profile Card -->
      <div class="lg:col-span-5 w-full lg:sticky lg:top-32">
        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 sm:p-8 md:p-12 text-center space-y-8 shadow-2xl relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-white/10 to-transparent opacity-50 group-hover:opacity-80 transition-opacity duration-700 blur-2xl"></div>
          
          <div class="relative w-36 h-36 mx-auto">
            <!-- Double Ring outline -->
            <div class="absolute inset-0 rounded-full border border-white/20 scale-110"></div>
            <div class="absolute inset-0 rounded-full border-2 border-white/80 overflow-hidden shadow-lg">
              <img src={personImage} alt={personName} width="144" height="144" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>
          
          <div class="space-y-3">
            <h4 class="text-2xl font-bold text-white">{personName}</h4>
            <p class="text-sm text-[#F9AE42] font-semibold tracking-wider uppercase">{personRole}</p>
            <div class="h-px w-12 bg-white/20 mx-auto"></div>
            <p class="text-sm text-white/90 max-w-[280px] mx-auto leading-relaxed">
              {personBio}
            </p>
          </div>

          <div class="pt-6 border-t border-white/20 space-y-4">
            <a
              href={`https://wa.me/${businessInfo.whatsapp || '916282249224'}?text=${encodeURIComponent('Hi Teknoppy, I would like to enquire about your services.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="cta-pulse-medium cta-pulse-delay-3 flex items-center justify-center gap-2.5 w-full py-4 rounded-xl bg-[#F9AE42] hover:bg-[#E89F36] border border-[#F9AE42]/40 text-neutral-950 font-bold shadow-md hover:shadow-lg transition-all text-base"
              aria-label="Chat with Teknoppy on WhatsApp"
            >
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z" />
              </svg>
              <span>WhatsApp Me</span>
            </a>
            
            <a 
              href={`mailto:${businessInfo.email}`} 
              class="flex items-center justify-center gap-3 w-full py-4 rounded-xl bg-transparent border border-white/10 text-white/80 font-medium hover:text-white transition-colors"
            >
              <Mail className="w-4 h-4" />
              {businessInfo.email}
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- LocalBusiness Schema -->
  {includeSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</section>

<Footer />

<script>
  /**
   * Footer consultation form.
   *
   * Previously this form called `alert('...sent successfully')` and posted
   * nowhere, so every enquiry from every page was silently discarded. It now
   * posts to PUBLIC_CONTACT_ENDPOINT and, when that is not configured, tells
   * the visitor the truth and hands them the phone number instead.
   */
  const form = document.getElementById('footer-cta-form') as HTMLFormElement | null;
  const status = document.getElementById('footer-cta-status');

  if (form && status) {
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.classList.remove('hidden');
      status.classList.toggle('bg-emerald-500/20', ok);
      status.classList.toggle('border-emerald-400/40', ok);
      status.classList.toggle('text-emerald-100', ok);
      status.classList.toggle('bg-red-500/25', !ok);
      status.classList.toggle('border-red-400/40', !ok);
      status.classList.toggle('text-red-100', !ok);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Silently drop bot submissions that filled the honeypot.
      if ((form.elements.namedItem('company_website') as HTMLInputElement)?.value) return;

      if (!form.checkValidity()) {
        show('Please fill in your name, email, phone and message.', false);
        form.reportValidity();
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        show(
          'This form is not connected to our inbox yet. Please call +91 6282249224 or email sales@teknoppy.com and we will pick it up straight away.',
          false
        );
        return;
      }

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Sending…';

      try {
        const payload = Object.fromEntries(new FormData(form));
        delete payload.company_website;
        payload.source = form.dataset.source || 'Website';
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...payload, _subject: `New website enquiry: ${payload.source}`, _cc: 'sanal@teknoppy.com', _template: 'table' })
        });
        if (!res.ok || String((await res.json()).success) !== 'true') throw new Error(String(res.status)); // FormSubmit returns 200 even on refusal
        if (window.dataLayer) {
          window.dataLayer.push({
            event: 'lead_submit',
            lead_source: payload.source || 'Footer consultation form',
            form_id: 'footer-cta-form',
            page_path: window.location.pathname
          });
        }
        form.reset();
        show('Thanks — your message is with us. A Teknoppy strategist will reply within one business day.', true);
      } catch {
        show(
          "Something went wrong sending your message. Please call +91 6282249224 or email sales@teknoppy.com and we'll pick it up straight away.",
          false
        );
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  }
</script>
