---
import { Phone, Mail, MapPin, ArrowRight, Zap } from 'lucide-react';

const businessInfo = {
  name: "Teknoppy",
  address: "(Full Street Address), Kochi, Kerala — PIN Code",
  phone: "+91 6282249224",
  email: "sanal@teknoppy.com",
  whatsapp: "+91 6282249224"
};

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": businessInfo.name,
  "telephone": businessInfo.phone,
  "email": businessInfo.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "(Full Street Address)",
    "addressLocality": "Kochi",
    "addressRegion": "Kerala",
    "postalCode": "PIN Code",
    "addressCountry": "IN"
  }
};
---

<section id="contact" class="py-32 bg-black relative overflow-hidden">
  <!-- Dynamic background for high contrast -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-primary/20 via-black to-black"></div>
  <div class="absolute bottom-0 left-0 w-full h-[500px] bg-gradient-to-t from-primary/10 to-transparent blur-[100px] pointer-events-none"></div>

  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="grid lg:grid-cols-12 gap-16 items-center">
      
      <!-- CTA Content (Left) -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-sm font-bold text-white uppercase tracking-wider mb-8 backdrop-blur-sm">
          <Zap className="w-4 h-4 text-secondary" />
          Let's Build Something Great
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight text-white mb-8">
          Ready to Work with the <br class="hidden lg:block"/> Leading <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">Web Design Company in Kerala?</span>
        </h2>
        
        <p class="text-xl text-gray-400 mb-12 leading-relaxed font-medium max-w-2xl">
          Whether you are launching a new business website, rebuilding an outdated one, or scaling your web development Kerala digital infrastructure — Teknoppy is ready to deliver. Start with a free website audit and see exactly where your current online presence stands, or request a quote and get a clear, no-obligation proposal within 24 hours.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-6">
          <a href="#consultation" class="group w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-5 text-lg font-black text-black bg-primary hover:bg-white rounded-full shadow-[0_10px_40px_rgb(249,98,50,0.5)] hover:shadow-[0_10px_40px_rgba(255,255,255,0.4)] hover:-translate-y-1 transition-all duration-300">
            Book a Free Consultation
            <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="#audit" class="group w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-5 text-lg font-bold text-white bg-transparent border-2 border-white/30 rounded-full hover:border-white hover:bg-white/5 transition-all">
            Get a Free Website Audit
          </a>
        </div>
      </div>

      <!-- Contact Info Box (Right) -->
      <div class="lg:col-span-5 relative">
        <!-- Floating Accent -->
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-secondary/20 rounded-full blur-[60px] -z-10"></div>
        
        <div class="bg-white/5 backdrop-blur-xl rounded-[2.5rem] p-10 md:p-12 border border-white/10 shadow-2xl relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-primary/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 blur-2xl"></div>

          <h3 class="text-2xl font-black text-white mb-10 flex items-center gap-3">
             <span class="w-8 h-1 bg-primary rounded-full"></span>
             Contact Us
          </h3>
          
          <div class="space-y-8">
            <a href={`tel:${businessInfo.phone.replace(/\\s/g, '')}`} class="flex items-start gap-5 group/item">
              <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/10 flex items-center justify-center group-hover/item:bg-primary group-hover/item:border-primary group-hover/item:shadow-[0_0_20px_rgba(249,98,50,0.4)] transition-all duration-300">
                <Phone className="w-6 h-6 text-white" />
              </div>
              <div>
                <p class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-1">Phone / WhatsApp</p>
                <p class="text-xl font-bold text-white group-hover/item:text-primary transition-colors">{businessInfo.phone}</p>
              </div>
            </a>

            <a href={`mailto:${businessInfo.email}`} class="flex items-start gap-5 group/item">
              <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/10 flex items-center justify-center group-hover/item:bg-primary group-hover/item:border-primary group-hover/item:shadow-[0_0_20px_rgba(249,98,50,0.4)] transition-all duration-300">
                <Mail className="w-6 h-6 text-white" />
              </div>
              <div>
                <p class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-1">Email</p>
                <p class="text-xl font-bold text-white group-hover/item:text-primary transition-colors">{businessInfo.email}</p>
              </div>
            </a>

            <div class="flex items-start gap-5 group/item">
              <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/10 flex items-center justify-center group-hover/item:bg-white group-hover/item:border-white transition-all duration-300">
                <MapPin className="w-6 h-6 text-white group-hover/item:text-black transition-colors" />
              </div>
              <div>
                <p class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-1">Address</p>
                <p class="text-lg font-bold text-white leading-snug">{businessInfo.address}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- LocalBusiness Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<!-- Minimal Footer -->
<footer class="bg-[#0A0A0A] border-t border-white/10 py-10 text-center">
  <div class="max-w-[1280px] mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex items-center gap-4">
      <!-- Minimal Logo mark if any, or just text -->
      <span class="text-xl font-black text-white tracking-tighter">TEKNOPPY</span>
    </div>
    <p class="text-sm font-medium text-gray-500">&copy; {new Date().getFullYear()} Teknoppy. All rights reserved.</p>
    <div class="flex gap-4">
      <!-- Social placehoders -->
      <a href="#" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
      </a>
      <a href="#" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
      </a>
      <a href="#" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>
    </div>
  </div>
</footer>
