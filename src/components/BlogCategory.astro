---
// Blog category hub — one per topic in blog.json `categories.items[]`.
// Renders every published post whose frontmatter category matches the hub's
// `match[]` list (CMS authors type categories freehand, so the hub owns the
// mapping rather than the posts).
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import FooterCTA from './FooterCTA.astro';
import { ArrowRight, Calendar, Clock, User } from 'lucide-react';
import { getCollection } from 'astro:content';
import page from '../data/pages/blog.json';

interface Props {
  slug: string;
}
const { slug } = Astro.props;

const cat = page.categories.items.find((c) => c.slug === slug)!;
const others = page.categories.items.filter((c) => c.slug !== slug);

const norm = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const wanted = new Set([...cat.match.map(norm), norm(cat.slug)]);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((e) => wanted.has(norm(e.data.category)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((e) => ({
    title: e.data.title,
    excerpt: e.data.excerpt,
    category: e.data.category,
    author: e.data.author,
    date: e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
    readTime: e.data.readTime,
    image: e.data.cover,
    href: `/blog/${e.id}/`
  }));

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": cat.title,
    "description": cat.text,
    "url": `https://teknoppy.com${cat.href}`,
    "hasPart": posts.map((p) => ({
      "@type": "BlogPosting",
      "headline": p.title,
      "url": `https://teknoppy.com${p.href}`,
      "author": { "@type": "Person", "name": p.author }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://teknoppy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://teknoppy.com/blog/" },
      { "@type": "ListItem", "position": 3, "name": cat.title, "item": `https://teknoppy.com${cat.href}` }
    ]
  }
];
---

<Layout title={cat.meta.title} description={cat.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- DARK HERO -->
    <section class="relative pt-32 pb-20 md:pt-36 md:pb-24 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 opacity-[0.18]">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.webp')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 flex flex-col items-center text-center">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold text-neutral-400">
            <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog/" class="hover:text-primary transition-colors">Blog</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-neutral-200" aria-current="page">{cat.title}</li>
          </ol>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
          Blog Category
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-[46px] font-black leading-[1.1] tracking-tight text-white mb-6 max-w-4xl">
          {cat.title}
        </h1>
        <p class="text-base sm:text-lg text-neutral-300 max-w-3xl font-medium leading-relaxed">
          {cat.text}
        </p>
      </div>
    </section>

    <!-- POSTS -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        {posts.length > 0 ? (
          <>
            <p class="text-sm font-bold text-neutral-500 uppercase tracking-wider mb-8">
              {posts.length} {posts.length === 1 ? 'article' : 'articles'} in this category
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
              {posts.map((post) => (
                <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-primary/30 border border-neutral-100/80 transition-all duration-300 flex flex-col h-full">
                  <div class="overflow-hidden aspect-[16/10] bg-neutral-100 relative">
                    <img
                      src={post.image}
                      alt={`${post.category} article thumbnail — ${post.title}`}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full bg-white/90 backdrop-blur-sm text-[10px] font-black text-primary uppercase tracking-wider shadow-sm">
                      {post.category}
                    </span>
                  </div>

                  <div class="p-6 md:p-8 flex flex-col flex-grow justify-between">
                    <div class="space-y-4">
                      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium text-neutral-400">
                        <span class="flex items-center gap-1.5">
                          <User class="w-3.5 h-3.5" />
                          {post.author}
                        </span>
                        <span class="flex items-center gap-1.5">
                          <Calendar class="w-3.5 h-3.5" />
                          {post.date}
                        </span>
                        <span class="flex items-center gap-1.5">
                          <Clock class="w-3.5 h-3.5" />
                          {post.readTime}
                        </span>
                      </div>

                      <h2 class="text-xl font-bold text-neutral-900 leading-snug group-hover:text-primary transition-colors duration-300">
                        <a href={post.href}>{post.title}</a>
                      </h2>

                      <p class="text-sm text-neutral-500 leading-relaxed font-medium">{post.excerpt}</p>
                    </div>

                    <div class="pt-6 mt-6 border-t border-neutral-50">
                      <a href={post.href} class="inline-flex items-center gap-2 text-sm font-bold text-neutral-850 hover:text-primary transition-colors duration-300">
                        Read Article
                        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" />
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </>
        ) : (
          <div class="max-w-2xl mx-auto text-center bg-[#FFF8EF]/50 border border-neutral-100 rounded-3xl p-10">
            <h2 class="text-2xl font-black text-neutral-900 mb-4">No articles here yet</h2>
            <p class="text-neutral-600 font-medium leading-relaxed mb-8">{page.categories.emptyText}</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              <a href="/blog/" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300">
                Read the latest articles
                <ArrowRight class="w-4 h-4" />
              </a>
              <a href={cat.service.href} class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-bold text-neutral-900 bg-white border border-neutral-200 rounded-full hover:border-primary hover:text-primary transition-all duration-300">
                {cat.service.label}
              </a>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- RELATED SERVICE -->
    <section class="py-14 sm:py-16 bg-[#FFF8EF]/30 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="rounded-3xl border border-neutral-100 bg-white p-8 sm:p-10 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] flex flex-col sm:flex-row sm:items-center gap-6 justify-between">
          <div>
            <p class="text-xs font-black text-primary uppercase tracking-wider mb-2">Related service</p>
            <h2 class="text-2xl font-black text-neutral-900 leading-snug">{cat.service.label}</h2>
          </div>
          <a href={cat.service.href} class="inline-flex items-center justify-center gap-2 px-7 py-3.5 text-sm font-bold text-white bg-primary rounded-full whitespace-nowrap shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300">
            View the service
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- OTHER CATEGORIES -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-2xl sm:text-3xl font-black text-neutral-900 leading-tight mb-8">{page.categories.otherHeading}</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {others.map((other) => (
            <a
              href={other.href}
              class="group relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col min-h-[112px]"
            >
              <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
              <h3 class="text-lg font-black text-neutral-900 leading-snug mb-3 group-hover:text-primary transition-colors">{other.title}</h3>
              <p class="text-neutral-600 text-sm leading-relaxed font-medium">{other.text}</p>
              <span class="inline-flex items-center gap-1.5 text-xs font-black text-primary mt-5 uppercase tracking-wider">
                Browse category
                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <FooterCTA />

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</Layout>
