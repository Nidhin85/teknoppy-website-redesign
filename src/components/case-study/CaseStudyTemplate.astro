---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CaseStudyStickyNav from './CaseStudyStickyNav';
import CaseStudyFAQ from './CaseStudyFAQ';
import { 
  Shield, 
  MapPin, 
  CheckCircle2, 
  ExternalLink, 
  Lock, 
  ArrowRight, 
  Sparkles, 
  Layers, 
  ChevronRight, 
  FileText, 
  Phone,
  Mail,
  MessageCircle,
  Globe2,
  Zap,
  TrendingUp,
  ShieldCheck
} from 'lucide-react';
import site from '../../data/site.json';

export interface ChallengeItem {
  number: number;
  title: string;
  description: string;
}

export interface ApproachPillar {
  title: string;
  paragraphs: string[];
}

export interface DeliverableItem {
  title: string;
  description: string;
}

export interface CaseStudyProps {
  metaTitle: string;
  metaDescription: string;
  canonicalURL: string;
  heroImage: string;
  heroImageAlt: string;
  schemaType?: string;
  schemaAbout?: {
    type: string;
    name: string;
    address?: {
      locality: string;
      region: string;
      country: string;
    };
  };

  clientName: string;
  categoryTag: string;
  tagBadge?: string;

  title: string;
  storyLead: string;
  industry: string;
  location: string;
  services: string;
  platform?: string;
  approach?: string;
  liveWebsite: string;
  liveWebsiteUrl: string;
  heroHighlights?: string[];
  navItems?: { id: string; label: string }[];

  atAGlance?: string[];

  aboutHeading?: string;
  aboutParagraphs?: string[];

  challengeLead?: string;
  challenges?: ChallengeItem[];

  objectiveLead?: string;
  objectives?: string[];

  approachLead?: string;
  approachPillars?: ApproachPillar[];

  deliverables?: DeliverableItem[];

  whyMattersHeading?: string;
  whyMattersParagraphs?: string[];
  whyMattersCalloutHtml?: string;

  faqs?: { question: string; answer: string }[];

  authorName?: string;
  authorRole?: string;
  ctaHeadline?: string;
  ctaPhoneText?: string;
  ctaPhoneTel?: string;
  ctaTagline?: string;
  rankingKeywords?: RankingKeywordsData;
}

export interface KeywordRow {
  keyword: string;
  page?: string | number;
  position?: string | number;
  map?: string | number;
  ai?: string | number;
}

export interface KeywordGroup {
  title?: string;
  badge?: string;
  note?: string;
  hasMap?: boolean;
  hasAi?: boolean;
  rows: KeywordRow[];
}

export interface RankingKeywordsData {
  lead?: string;
  groups: KeywordGroup[];
}

const {
  metaTitle,
  metaDescription,
  canonicalURL,
  heroImage,
  heroImageAlt,
  schemaType = 'TechArticle',
  schemaAbout,
  clientName,
  categoryTag,
  tagBadge = 'Teknoppy Case Study',
  title,
  storyLead,
  industry,
  location,
  services,
  platform,
  approach,
  liveWebsite,
  liveWebsiteUrl,
  heroHighlights = [],
  navItems,
  atAGlance = [],
  aboutHeading = 'About the Project',
  aboutParagraphs = [],
  challengeLead = '',
  challenges = [],
  objectiveLead = '',
  objectives = [],
  approachLead,
  approachPillars = [],
  deliverables = [],
  whyMattersHeading = 'Strategic Value',
  whyMattersParagraphs = [],
  whyMattersCalloutHtml = '',
  faqs = [],
  authorName = 'Sanal Edison',
  authorRole = 'Digital Strategist at Teknoppy',
  ctaHeadline = 'Need a high-performing digital platform tailored to your growth goals?',
  ctaPhoneText = `Talk to Teknoppy | ${site.phone}`,
  ctaPhoneTel = site.phoneLink,
  ctaTagline = 'TEKNOPPY.COM • KOCHI, KERALA • DUBAI, UAE',
  rankingKeywords
} = Astro.props as CaseStudyProps;

const effectiveNavItems = navItems || [
  { id: 'overview', label: 'Overview' },
  { id: 'about', label: 'About' },
  { id: 'challenges', label: 'Challenges' },
  { id: 'objectives', label: 'Objectives' },
  { id: 'approach', label: 'Approach' },
  { id: 'deliverables', label: 'Deliverables' },
  ...(rankingKeywords && rankingKeywords.groups?.length ? [{ id: 'keywords', label: 'Keywords' }] : []),
  { id: 'strategy', label: 'Strategic Value' },
  { id: 'faq', label: 'FAQ' },
];

// Build Structured Data for Article & FAQ
const schemaArticle = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "headline": title,
  "description": metaDescription,
  "image": `https://teknoppy.com${heroImage}`,
  "author": {
    "@type": "Person",
    "name": authorName,
    "jobTitle": authorRole,
    "worksFor": {
      "@type": "Organization",
      "name": "Teknoppy"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Teknoppy",
    "logo": {
      "@type": "ImageObject",
      "url": "https://teknoppy.com/logo.svg"
    }
  },
  "mainEntityOfPage": canonicalURL,
  ...(schemaAbout ? {
    "about": {
      "@type": schemaAbout.type,
      "name": schemaAbout.name,
      ...(schemaAbout.address ? {
        "address": {
          "@type": "PostalAddress",
          "addressLocality": schemaAbout.address.locality,
          "addressRegion": schemaAbout.address.region,
          "addressCountry": schemaAbout.address.country
        }
      } : {})
    }
  } : {})
};

const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout title={metaTitle} description={metaDescription} image={heroImage}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />
  </Fragment>

  <Header forceSolidBg={true} />

  <main class="bg-white text-neutral-900 selection:bg-primary/20 selection:text-primary overflow-x-hidden pt-20 lg:pt-24 font-sans">
    
    {/* =========================================================================
        01. HERO SECTION
        ========================================================================= */}
    <section id="project-hero" class="relative pt-10 pb-14 md:pt-16 md:pb-20 overflow-hidden bg-gradient-to-b from-[#F8FAFC] via-white to-white border-b border-neutral-200/80">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(240,90,44,0.04),transparent_50%),radial-gradient(circle_at_80%_80%,rgba(249,174,66,0.03),transparent_50%)] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-7">
        
        {/* Breadcrumb & Marker */}
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-neutral-500">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <span>/</span>
            <a href="/case-study/" class="hover:text-primary transition-colors">Case Studies</a>
            <span>/</span>
            <span class="text-neutral-900 font-bold">{clientName}</span>
          </div>

          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-50 border border-orange-200/70 text-primary text-xs font-bold uppercase tracking-wider shadow-xs backdrop-blur-md">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary/70 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            {tagBadge}
          </div>
        </div>

        {/* Hero Title & Story Lead */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
          <div class="lg:col-span-8 space-y-5">
            <div class="inline-block px-3 py-1 rounded-md bg-orange-50 border border-orange-200/70 text-primary text-xs sm:text-sm font-bold tracking-wide uppercase">
              {categoryTag}
            </div>

            <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-neutral-900 leading-[1.14]">
              {title}
            </h1>

            <p class="text-base sm:text-lg text-neutral-600 font-normal leading-[1.65] max-w-3xl">
              {storyLead}
            </p>
          </div>

          {/* Project Metadata Card */}
          <div class="lg:col-span-4 bg-[#F8FAFC] rounded-2xl p-6 sm:p-7 border border-neutral-200/80 shadow-md space-y-4">
            <div class="flex items-center justify-between border-b border-neutral-200 pb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-neutral-500">Client</span>
              <span class="text-sm font-bold text-neutral-900">{clientName}</span>
            </div>

            <div class="space-y-3 text-xs sm:text-sm">
              <div class="flex justify-between gap-4">
                <span class="text-neutral-500">Industry</span>
                <span class="font-semibold text-right text-neutral-800">{industry}</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-neutral-500">Location</span>
                <span class="font-semibold text-right text-neutral-800">{location}</span>
              </div>
              {platform && (
                <div class="flex justify-between gap-4">
                  <span class="text-neutral-500">Platform</span>
                  <span class="font-semibold text-right text-neutral-800">{platform}</span>
                </div>
              )}
              <div class="flex justify-between gap-4">
                <span class="text-neutral-500">Services</span>
                <span class="font-semibold text-right text-neutral-800">{services}</span>
              </div>
              {approach && (
                <div class="flex justify-between gap-4">
                  <span class="text-neutral-500">Approach</span>
                  <span class="font-semibold text-right text-neutral-800">{approach}</span>
                </div>
              )}
              <div class="flex justify-between gap-4 pt-2 border-t border-neutral-200">
                <span class="text-neutral-500">Live Website</span>
                <a 
                  href={liveWebsiteUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="font-bold text-primary hover:text-[#D24A20] hover:underline flex items-center gap-1"
                >
                  {liveWebsite} <ExternalLink className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Hero Showcase Visual Device Mockup */}
        <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden border border-neutral-200/90 bg-neutral-900 shadow-xl">
          <div class="px-5 py-3 bg-neutral-100 border-b border-neutral-200 flex items-center justify-between gap-4">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-400"></span>
              <span class="w-3 h-3 rounded-full bg-amber-400"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
            </div>

            <div class="flex items-center gap-2 px-4 py-1 rounded-full bg-white text-[11px] text-neutral-600 font-mono border border-neutral-200 max-w-sm w-full justify-center shadow-2xs">
              <Lock className="w-3 h-3 text-emerald-600" />
              <span>https://{liveWebsite}</span>
            </div>

            <div class="text-[11px] text-neutral-500 font-semibold hidden sm:block font-mono">
              {platform || 'Production Build'}
            </div>
          </div>

          <div class="relative group bg-[#F8FAFC]">
            <img 
              src={heroImage} 
              alt={heroImageAlt} 
              class="w-full h-auto max-h-[640px] object-cover object-top block"
              loading="eager"
            />
            
            {heroHighlights.length > 0 && (
              <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-neutral-900/90 via-neutral-900/60 to-transparent p-5 sm:p-8 pt-12 flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-2.5">
                  {heroHighlights.map(h => (
                    <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-white text-neutral-900 shadow-md">
                      {h}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

      </div>
    </section>

    {/* =========================================================================
        STICKY SUB-NAVIGATION
        ========================================================================= */}
    <CaseStudyStickyNav clientName={clientName} navItems={effectiveNavItems} client:load />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 space-y-20 md:space-y-28">
      {Astro.slots.has('default') ? (
        <slot />
      ) : (
        <>
          {/* =========================================================================
              02. AT A GLANCE
              ========================================================================= */}
      <section id="overview" class="reveal-on-scroll relative rounded-3xl p-8 sm:p-10 md:p-12 bg-[#F8FAFC] border border-neutral-200/80 shadow-xs overflow-hidden">
        <div class="relative z-10 space-y-7">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-orange-50 border border-orange-200/70 flex items-center justify-center text-primary">
              <Sparkles className="w-5 h-5" />
            </div>
            <div>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Executive Summary</span>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-neutral-900 tracking-tight">AT A GLANCE</h2>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 pt-1">
            {atAGlance.map((point) => (
              <div class="flex items-start gap-3.5 p-4 sm:p-5 rounded-2xl bg-white border border-neutral-200/80 shadow-2xs hover:border-primary/40 transition-colors">
                <CheckCircle2 className="w-5 h-5 text-primary shrink-0 mt-0.5" />
                <span class="text-sm sm:text-base text-neutral-800 font-medium leading-relaxed">{point}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* =========================================================================
          03. ABOUT SECTION
          ========================================================================= */}
      <section id="about" class="reveal-on-scroll space-y-6 max-w-4xl">
        <div class="space-y-2.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-primary">Background</span>
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider">{clientName}</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
            {aboutHeading}
          </h2>
        </div>

        <div class="space-y-5 text-base sm:text-[17px] text-neutral-600 font-normal leading-relaxed">
          {aboutParagraphs.map(p => (
            <p>{p}</p>
          ))}
        </div>
      </section>

      {/* =========================================================================
          04. THE CHALLENGE
          ========================================================================= */}
      <section id="challenges" class="reveal-on-scroll space-y-8">
        <div class="space-y-2.5 max-w-3xl">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-amber-600">Analysis</span>
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider">Starting Obstacles</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight">The Challenge</h2>
          <p class="text-base sm:text-lg text-neutral-600">
            {challengeLead}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {challenges.map((item) => (
            <div class="relative p-6 sm:p-7 rounded-2xl bg-white border border-neutral-200/80 hover:border-amber-400/60 shadow-xs hover:shadow-md transition-all duration-300 space-y-3.5">
              <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-200/70 flex items-center justify-center text-amber-600 font-mono font-bold text-sm">
                {item.number}
              </div>
              <h3 class="text-lg font-bold text-neutral-900 tracking-tight leading-snug">
                {item.title}
              </h3>
              <p class="text-sm text-neutral-600 leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* =========================================================================
          05. PROJECT OBJECTIVE
          ========================================================================= */}
      <section id="objectives" class="reveal-on-scroll space-y-6 max-w-4xl">
        <div class="space-y-2.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-primary">Goals</span>
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider">Mandate</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight">Project Objective</h2>
          <p class="text-base sm:text-lg text-neutral-600 font-normal leading-relaxed">
            {objectiveLead}
          </p>
        </div>

        <div class="space-y-3.5">
          {objectives.map((obj) => (
            <div class="flex items-start gap-3.5 p-4 sm:p-5 rounded-2xl bg-[#F8FAFC] border border-neutral-200/80 hover:border-primary/40 transition-colors shadow-2xs">
              <div class="w-6 h-6 rounded-full bg-orange-100 text-primary flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                ✓
              </div>
              <p class="text-sm sm:text-base text-neutral-800 leading-relaxed font-medium">
                {obj}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* =========================================================================
          06. OUR APPROACH
          ========================================================================= */}
      <section id="approach" class="reveal-on-scroll space-y-10">
        <div class="space-y-2.5 max-w-3xl">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-primary">Execution</span>
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider">Strategic Framework</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight">Our Approach</h2>
          {approachLead && (
            <p class="text-base sm:text-lg text-neutral-600">{approachLead}</p>
          )}
        </div>

        <div class="space-y-6">
          {approachPillars.map((pillar, pIdx) => (
            <div class="p-7 sm:p-9 rounded-2xl sm:rounded-3xl bg-white border border-neutral-200/80 hover:border-primary/40 shadow-xs hover:shadow-md transition-all duration-300 space-y-3.5">
              <div class="flex items-center gap-3">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary px-2.5 py-1 rounded-md bg-orange-50 border border-orange-200/70">
                  Pillar 0{pIdx + 1}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">
                  {pillar.title}
                </h3>
              </div>
              <div class="space-y-3.5 text-sm sm:text-base text-neutral-600 font-normal leading-relaxed pt-1">
                {pillar.paragraphs.map(text => (
                  <p>{text}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* =========================================================================
          07. WHAT WE DELIVERED
          ========================================================================= */}
      <section id="deliverables" class="reveal-on-scroll space-y-8">
        <div class="space-y-2.5 max-w-3xl">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-600">Results</span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider">Final Scope</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight">What We Delivered</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {deliverables.map((item) => (
            <div class="p-6 sm:p-8 rounded-2xl bg-white border border-neutral-200/80 hover:border-emerald-500/40 shadow-xs hover:shadow-md transition-all space-y-2.5">
              <div class="flex items-center gap-2.5 text-emerald-600">
                <CheckCircle2 className="w-5 h-5 shrink-0" />
                <h3 class="text-lg font-bold text-neutral-900 tracking-tight">{item.title}</h3>
              </div>
              <p class="text-sm sm:text-base text-neutral-600 leading-relaxed pl-7">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* =========================================================================
          RANKING KEYWORDS SECTION
          ========================================================================= */}
      {rankingKeywords && rankingKeywords.groups && rankingKeywords.groups.length > 0 && (
        <section id="keywords" class="reveal-on-scroll space-y-8 scroll-mt-28">
          <div class="space-y-2.5 max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-50 text-[#F05A2C] border border-orange-200/70 text-xs font-bold uppercase tracking-wider">
              <Sparkles className="w-3.5 h-3.5 text-[#F05A2C]" />
              Verified Performance
            </div>
            <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
              Ranking Keywords
            </h2>
            {rankingKeywords.lead && (
              <p class="text-base sm:text-lg text-neutral-600 leading-relaxed">
                {rankingKeywords.lead}
              </p>
            )}
          </div>

          <div class="space-y-8">
            {rankingKeywords.groups.map((group) => {
              const showMap = group.hasMap ?? group.rows.some(r => r.map !== undefined && r.map !== '');
              const showAi = group.hasAi ?? group.rows.some(r => r.ai !== undefined && r.ai !== '');
              return (
                <div class="bg-[#F8FAFC] rounded-3xl p-6 sm:p-8 border border-neutral-200/80 shadow-xs space-y-5">
                  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-neutral-200 pb-4">
                    <div>
                      <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#F05A2C] block mb-1">
                        Verified Search Results
                      </span>
                      <h3 class="text-base sm:text-lg font-bold text-neutral-900">
                        {group.title || `Target keywords — ${clientName}`}
                      </h3>
                    </div>
                    <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full flex items-center gap-1.5 shadow-2xs">
                      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                      {group.badge || 'Google Page 1'}
                    </span>
                  </div>

                  <div class="overflow-x-auto rounded-2xl border border-neutral-200 bg-white">
                    <table class="w-full text-left border-collapse min-w-[500px]">
                      <thead>
                        <tr class="border-b border-neutral-200 bg-[#F8FAFC] text-xs font-mono font-bold uppercase tracking-wider text-neutral-500">
                          <th class="py-3 px-4 sm:px-5">RANKING KEYWORDS</th>
