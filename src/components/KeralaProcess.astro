---
import { 
  Compass, 
  Layers, 
  Palette, 
  Code2, 
  Gauge, 
  Rocket, 
  CheckCircle2 
} from "lucide-react";

const steps = [
  {
    icon: Compass,
    h3: "01 Discovery",
    desc: "Goals, audience and competitor check for your Kerala market."
  },
  {
    icon: Layers,
    h3: "02 Planning",
    desc: "Sitemap, page list and URL structure."
  },
  {
    icon: Palette,
    h3: "03 Design",
    desc: "Wireframes and visual design for mobile and desktop."
  },
  {
    icon: Code2,
    h3: "04 Development",
    desc: "Build on WordPress / Shopify / custom code with schema."
  },
  {
    icon: Gauge,
    h3: "05 SEO & Speed",
    desc: "On-page SEO, Core Web Vitals, Search Console setup."
  },
  {
    icon: Rocket,
    h3: "06 Launch & Support",
    desc: "Testing, go-live, training and ongoing maintenance."
  }
];
---

<section id="process" class="py-10 sm:py-12 md:py-16 bg-cream relative overflow-hidden">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center mb-7 sm:mb-9 md:mb-11">
      <div class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs sm:text-sm font-bold uppercase tracking-wider mb-4 sm:mb-6 shadow-sm transform -rotate-1">
        Proven Methodology
      </div>
      <h2 class="text-3xl md:text-5xl font-black leading-tight text-neutral-900 mb-2.5 sm:mb-3" data-magnetic-heading>
        Our Web Design Process for Kerala Businesses
      </h2>
      <p class="text-base md:text-lg text-neutral-600 leading-relaxed font-medium">
        A structured, milestone-driven framework that guarantees clarity, on-time delivery, and measurable search visibility.
      </p>
    </div>

    <!-- Neumorphic Compact Process Grid with Staggered Motion -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 md:gap-6" data-stagger>
      {steps.map((step) => {
        const StepIcon = step.icon;
        return (
          <div class="neu-card neu-card-cream rounded-2xl p-5 sm:p-6 md:p-6.5 group flex flex-col justify-between h-full">
            <div>
              <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-3.5 sm:mb-4 group-hover:bg-primary group-hover:text-white transition-colors duration-300">
                <StepIcon className="w-5 h-5 transition-transform duration-300 group-hover:scale-110" />
              </div>
              <h3 class="text-lg sm:text-xl font-black text-neutral-900 mb-2 sm:mb-2.5 leading-snug group-hover:text-primary transition-colors duration-300">
                {step.h3}
              </h3>
              <p class="text-xs sm:text-sm md:text-[0.9375rem] text-neutral-600 leading-relaxed font-normal">
                {step.desc}
              </p>
            </div>
            <div class="pt-3.5 mt-4 border-t border-neutral-100 flex items-center gap-2 text-xs font-semibold text-neutral-400">
              <CheckCircle2 className="w-3.5 h-3.5 text-primary shrink-0" />
              <span>Milestone-verified delivery</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
