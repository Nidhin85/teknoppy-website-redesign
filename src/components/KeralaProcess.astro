---
import { 
  Compass, 
  Layers, 
  Palette, 
  Code2, 
  Gauge, 
  Rocket, 
  CheckCircle2 
} from "lucide-react";

const steps = [
  {
    icon: Compass,
    h3: "01 Discovery",
    desc: "Goals, audience and competitor check for your Kerala market."
  },
  {
    icon: Layers,
    h3: "02 Planning",
    desc: "Sitemap, page list and URL structure."
  },
  {
    icon: Palette,
    h3: "03 Design",
    desc: "Wireframes and visual design for mobile and desktop."
  },
  {
    icon: Code2,
    h3: "04 Development",
    desc: "Build on WordPress / Shopify / custom code with schema."
  },
  {
    icon: Gauge,
    h3: "05 SEO & Speed",
    desc: "On-page SEO, Core Web Vitals, Search Console setup."
  },
  {
    icon: Rocket,
    h3: "06 Launch & Support",
    desc: "Testing, go-live, training and ongoing maintenance."
  }
];
---

<section id="process" class="py-12 sm:py-14 md:py-20 bg-cream relative overflow-hidden">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center mb-7 sm:mb-9 md:mb-11">
      <div class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs sm:text-sm font-bold uppercase tracking-wider mb-4 sm:mb-6 shadow-sm transform -rotate-1">
        Proven Methodology
      </div>
      <h2 class="text-3xl md:text-5xl font-black leading-tight text-neutral-900 mb-2.5 sm:mb-3" data-magnetic-heading>
        Our Web Design Process for Kerala Businesses
      </h2>
      <p class="text-base md:text-lg text-neutral-600 leading-relaxed font-medium">
        A structured, milestone-driven framework that guarantees clarity, on-time delivery, and measurable search visibility.
      </p>
    </div>

    <!-- Horizontal process timeline (reference layout): icon tiles on a dashed connector -->
    <ol class="process-line relative grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-8 sm:gap-x-6 lg:gap-x-4" data-stagger>
      {steps.map((step) => {
        const StepIcon = step.icon;
        return (
          <li class="process-step group relative flex flex-col items-center text-center">
            <div class="process-icon relative z-10 w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white border border-primary/10 shadow-[0_18px_36px_-20px_rgba(160,60,20,0.55)] flex items-center justify-center text-primary mb-4 transition-all duration-300 group-hover:bg-primary group-hover:text-white group-hover:-translate-y-1">
              <StepIcon className="w-6 h-6 transition-transform duration-300 group-hover:scale-110" />
            </div>
            <h3 class="text-base sm:text-lg font-bold text-neutral-900 mb-1.5 leading-snug group-hover:text-primary transition-colors duration-300">
              {step.h3}
            </h3>
            <p class="text-xs sm:text-[0.84rem] text-neutral-600 leading-relaxed font-normal max-w-[15rem]">
              {step.desc}
            </p>
          </li>
        );
      })}
    </ol>
    <div class="mt-8 sm:mt-10 flex items-center justify-center gap-2 text-xs font-semibold text-neutral-500">
      <CheckCircle2 className="w-3.5 h-3.5 text-primary shrink-0" />
      <span>Milestone-verified delivery</span>
    </div>
  </div>
</section>

<style>
  /* dashed connector through the icon centres (desktop single row only) */
  @media (min-width: 1024px) {
    .process-line::before {
      content: ""; position: absolute; top: 2rem; left: 8%; right: 8%; height: 0;
      border-top: 2px dashed rgba(240, 90, 44, 0.28);
    }
  }
</style>
