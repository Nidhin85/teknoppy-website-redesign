---
/**
 * Homepage Hero YouTube Video Component
 * Embedded full-width responsive YouTube hero video
 * Video ID: E8i02o3GxC0
 * Clean, seamless, autoplaying muted looping background video
 */
interface Props {
  videoId?: string;
  title?: string;
}

const {
  videoId = 'E8i02o3GxC0',
  title = 'Teknoppy — Web Design Company in Kerala Hero Video'
} = Astro.props;

const embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${videoId}&playsinline=1&rel=0&modestbranding=1`;
---

<section
  id="hero-video-section"
  class="hero-video-section w-full bg-neutral-950 overflow-hidden relative"
  aria-label="Teknoppy Hero Video"
>
  <div class="w-full relative aspect-video overflow-hidden bg-neutral-950 flex items-center justify-center">
    <iframe
      src={embedUrl}
      title={title}
      class="hero-video-iframe absolute inset-0 w-full h-full border-0 pointer-events-none select-none"
      allow="autoplay; encrypted-media; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
</section>

<style>
  .hero-video-section {
    padding-top: 67px;
    margin: 0;
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .hero-video-section {
      padding-top: 73px;
    }
  }

  @media (min-width: 1024px) {
    .hero-video-section {
      padding-top: 77px;
    }
  }

  .hero-video-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
</style>
