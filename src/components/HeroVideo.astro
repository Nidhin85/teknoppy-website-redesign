---
/**
 * Clean Cinematic YouTube Hero Video Component
 * Embedded full-width responsive YouTube hero video
 * Video ID: E8i02o3GxC0
 * Clean, seamless, continuous looping hero background video without controls, captions, or playlist overlays
 */
interface Props {
  videoId?: string;
  title?: string;
}

const {
  videoId = 'E8i02o3GxC0',
  title = 'Teknoppy — Web Design Company in Kerala Hero Video'
} = Astro.props;

// Clean embed URL suppressing controls, captions, annotations, keyboard events, and related videos
const embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${videoId}&playsinline=1&rel=0&enablejsapi=1&cc_load_policy=0&iv_load_policy=3&disablekb=1&fs=0&modestbranding=1`;
const posterUrl = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
---

<section
  id="hero-video-section"
  class="hero-video-section w-full bg-neutral-950 overflow-hidden relative"
  aria-label="Teknoppy Hero Video"
>
  <div
    class="hero-video-container w-full relative aspect-video overflow-hidden bg-neutral-950 flex items-center justify-center bg-cover bg-center"
    style={`background-image: url('${posterUrl}');`}
  >
    <iframe
      id={`hero-youtube-iframe-${videoId}`}
      src={embedUrl}
      title={title}
      class="hero-video-iframe absolute inset-0 w-full h-full border-0 pointer-events-none select-none"
      allow="autoplay; encrypted-media; picture-in-picture"
      allowfullscreen
      tabindex="-1"
      loading="eager"
    ></iframe>
  </div>
</section>

<style>
  .hero-video-section {
    padding-top: 67px;
    margin: 0;
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .hero-video-section {
      padding-top: 73px;
    }
  }

  @media (min-width: 1024px) {
    .hero-video-section {
      padding-top: 77px;
    }
  }

  .hero-video-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
</style>

<script is:inline>
  (function () {
    var checkInterval = null;
    var playerInstance = null;

    function initHeroVideo() {
      var iframe = document.querySelector('.hero-video-iframe');
      if (!iframe) return;
      if (iframe.getAttribute('data-yt-init') === 'true') return;
      iframe.setAttribute('data-yt-init', 'true');

      function startLoopMonitor(player) {
        if (checkInterval) {
          clearInterval(checkInterval);
          checkInterval = null;
        }
        checkInterval = setInterval(function () {
          try {
            if (!player || typeof player.getCurrentTime !== 'function' || typeof player.getDuration !== 'function') return;
            var duration = player.getDuration();
            var currentTime = player.getCurrentTime();
            // Seek seamlessly 0.35s before the video ends to prevent YouTube playlist UI, end screen, and buffering screen
            if (duration > 0 && currentTime >= duration - 0.35) {
              player.seekTo(0, true);
              player.playVideo();
            }
          } catch (e) {}
        }, 150);
      }

      function stopLoopMonitor() {
        if (checkInterval) {
          clearInterval(checkInterval);
          checkInterval = null;
        }
      }

      function attachPlayer() {
        if (typeof YT === 'undefined' || !YT.Player) return;
        try {
          playerInstance = new YT.Player(iframe, {
            events: {
              onReady: function (event) {
                try {
                  event.target.mute();
                  if (typeof event.target.setVolume === 'function') {
                    event.target.setVolume(0);
                  }
                  // Explicitly unload and suppress closed captions to prevent [Music] text
                  if (typeof event.target.unloadModule === 'function') {
                    event.target.unloadModule('captions');
                    event.target.unloadModule('cc');
                  }
                  event.target.playVideo();
                } catch (e) {}
              },
              onStateChange: function (event) {
                // YT.PlayerState: ENDED (0), PLAYING (1), PAUSED (2), BUFFERING (3)
                if (event.data === 1) {
                  // Playing: activate seamless loop monitoring
                  startLoopMonitor(event.target);
                } else if (event.data === 0) {
                  // Ended fallback: immediate seek & play to resume playback instantly
                  stopLoopMonitor();
                  try {
                    event.target.seekTo(0, true);
                    event.target.playVideo();
                  } catch (e) {}
                } else if (event.data === 2) {
                  // Paused fallback: immediately resume playback so pause icon and side chevrons never persist
                  stopLoopMonitor();
                  try {
                    event.target.playVideo();
                  } catch (e) {}
                } else {
                  stopLoopMonitor();
                }
              },
              onError: function () {
                stopLoopMonitor();
              }
            }
          });
        } catch (err) {
          console.warn('Hero video player init notice:', err);
        }
      }

      // Check if YouTube API is already loaded or needs to be injected
      if (typeof YT === 'undefined' || !YT.Player) {
        if (!window.onYouTubeIframeAPIReadyQueue) {
          window.onYouTubeIframeAPIReadyQueue = [];
          var existingCallback = window.onYouTubeIframeAPIReady;
          window.onYouTubeIframeAPIReady = function () {
            if (existingCallback) existingCallback();
            while (window.onYouTubeIframeAPIReadyQueue && window.onYouTubeIframeAPIReadyQueue.length > 0) {
              var fn = window.onYouTubeIframeAPIReadyQueue.shift();
              try { fn(); } catch (e) {}
            }
          };
        }
        window.onYouTubeIframeAPIReadyQueue.push(attachPlayer);

        if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
          var tag = document.createElement('script');
          tag.src = 'https://www.youtube.com/iframe_api';
          tag.async = true;
          document.head.appendChild(tag);
        }
      } else {
        attachPlayer();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroVideo);
    } else {
      initHeroVideo();
    }

    window.addEventListener('beforeunload', function () {
      if (checkInterval) {
        clearInterval(checkInterval);
        checkInterval = null;
      }
      if (playerInstance && typeof playerInstance.destroy === 'function') {
        try { playerInstance.destroy(); } catch (e) {}
      }
    });
  })();
</script>
