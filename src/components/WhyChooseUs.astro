---
import { SearchCheck, LineChart, BadgeDollarSign, MapPin, Rocket, LifeBuoy } from 'lucide-react';
import home from "../data/home.json";

const features = home.whyChooseUs.features;

// Feature icons stay hardcoded here and are zipped with the JSON features by index.
const icons = [SearchCheck, LineChart, BadgeDollarSign, MapPin, Rocket, LifeBuoy];
---

<section class="py-24 md:py-32 bg-cream relative">
  <!-- Dynamic background container to prevent overflow issues -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.png')] opacity-75"></div>
  </div>
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
    <!-- gap applies between all 12 tracks, so lg:gap-24 alone spent 11x96px on gutters
         and forced the row wider than the container below ~1164px. -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-12 xl:gap-24 items-start">
      
      <!-- Left Sticky Column -->
      <div class="lg:col-span-5 lg:sticky lg:top-32 space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
            {home.whyChooseUs.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 leading-[1.15] mb-6">
            {home.whyChooseUs.headingLead} <span class="text-primary">{home.whyChooseUs.headingAccent}</span> {home.whyChooseUs.headingRest}
          </h2>
          <p class="text-neutral-600 text-base leading-relaxed">
            {home.whyChooseUs.intro}
          </p>
        </div>

        <!-- Trust Stats -->
        <div class="pt-8 border-t border-neutral-200/60 flex items-center gap-4">
          <div class="flex -space-x-2.5">
            {[
              '/client logos/Abroad-career-1.jpg',
              '/client logos/abu-dhabi.jpg',
              '/client logos/al-coffee-1.jpg',
              '/client logos/amster.jpg'
            ].map((src) => (
               <div class="w-9 h-9 rounded-full border-2 border-white bg-white flex items-center justify-center overflow-hidden shadow-sm">
                 <img src={src} alt="Client partner logo" class="w-full h-full object-contain p-1.5 grayscale mix-blend-multiply" />
               </div>
            ))}
          </div>
          <div>
            <p class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider">Trusted Partner</p>
            <p class="text-sm font-semibold text-neutral-900 leading-tight">100+ Brands Across Kerala</p>
          </div>
        </div>
      </div>

      <!-- Right Feature Cards Column -->
      <div class="lg:col-span-7 space-y-6">
        {features.map((feature, index) => {
          const Icon = icons[index];
          return (
          <div
            class="relative bg-white border border-neutral-100/80 hover:border-primary/30 rounded-2xl p-8 transition-all duration-500 group flex flex-col justify-between shadow-sm hover:shadow-[0_20px_50px_rgba(240,90,44,0.06)] hover:-translate-y-1 advantage-card opacity-0 translate-y-8 w-full"
            style={`transition-delay: ${index * 60}ms`}
          >
            <div>
              <div class="flex justify-between items-start mb-6">
                <div class="w-12 h-12 rounded-full bg-primary/5 flex items-center justify-center transition-all duration-500 group-hover:bg-primary group-hover:scale-110 group-hover:shadow-[0_6px_15px_rgba(240,90,44,0.25)]">
                  <Icon className="w-5 h-5 text-primary group-hover:text-white transition-colors duration-500" />
                </div>
                
                <span class="text-xs font-mono font-semibold text-neutral-300 group-hover:text-primary transition-colors">
                  0{index + 1}
                </span>
              </div>
              
              <h3 class="text-xl font-bold text-neutral-900 leading-snug mb-3 group-hover:text-primary transition-colors duration-300">
                {feature.title}
              </h3>
              
              <p class="text-neutral-600 text-sm md:text-base leading-relaxed font-normal">
                {feature.description}
              </p>
            </div>
          </div>
          );
        })}
      </div>

    </div>
  </div>
</section>

<style>
  .advantage-card {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.4s ease, 
                box-shadow 0.4s ease, 
                opacity 0.6s ease;
  }
</style>

<script>
  const advantageCards = document.querySelectorAll('.advantage-card');

  // Reveal cards on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-8');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  advantageCards.forEach(card => observer.observe(card));
</script>
