---
import { SearchCheck, LineChart, BadgeDollarSign, MapPin, Rocket, LifeBuoy, ArrowRight } from 'lucide-react';
import home from "../data/home.json";

const features = home.whyChooseUs.features;

// Feature icons stay hardcoded here and are zipped with the JSON features by index.
const icons = [SearchCheck, LineChart, BadgeDollarSign, MapPin, Rocket, LifeBuoy];

// Trusted partner client logos across Kerala including newly provided brands
const partnerLogos = [
  { name: 'Abroad Career', src: '/client logos/Abroad-career-1.jpg' },
  { name: 'Lenaa', src: '/client logos/lenaa-brand.png' },
  { name: 'Educareer', src: '/client logos/educareer-brand.png' },
  { name: 'Roja House Boat', src: '/client logos/roja-house-boat.png' },
  { name: 'Mount Bell Global Studies', src: '/client logos/mount-bell-global-studies.png' },
  { name: 'Abrus Krishna Finance', src: '/client logos/abrus-krishna-finance-brand.png' },
  { name: 'Cochin Suraksha', src: '/client logos/cochin-suraksha-brand.png' },
  { name: 'Leema Engineering Works', src: '/client logos/leema-engineering-works-brand.png' },
  { name: 'Olives The Boutique Resort', src: '/client logos/olives-resort-brand.png' },
  { name: 'Direction North', src: '/client logos/direction-north.png' },
  { name: 'Triqare', src: '/client logos/triqare.png' },
  { name: 'Abu Dhabi Business Hub', src: '/client logos/abu-dhabi.jpg' },
  { name: 'Al Coffee', src: '/client logos/al-coffee-1.jpg' },
  { name: 'Amster', src: '/client logos/amster.jpg' },
  { name: 'Laughing Waters', src: '/client logos/laughing-waters.jpg' },
  { name: 'WestN Resorts', src: '/client logos/westn.jpg' },
  { name: 'General Tech Services', src: '/client logos/general-tech-services.jpg' },
  { name: 'Kerala Dayz', src: '/client logos/kerala-dayz.png' },
  { name: 'Varma Ayurveda', src: '/client logos/varma-ayurveda.png' },
  { name: 'Edamanasserry Spine Hospital', src: '/client logos/edamanasserry-spine-hospital.jpg' },
  { name: 'Alankar Avenue', src: '/client logos/alankar-avenue.png' }
];
---

<section class="py-10 sm:py-12 md:py-16 bg-cream relative overflow-hidden">
  <!-- Dynamic background container to prevent overflow issues -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.webp')] opacity-75"></div>
  </div>
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-start">
      
      <!-- Left Sticky Column -->
      <div class="lg:col-span-5 lg:sticky lg:top-28 space-y-6 sm:space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-xs sm:text-sm font-bold uppercase tracking-wider mb-4 sm:mb-6 shadow-sm transform -rotate-1">
            {home.whyChooseUs.badge}
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 leading-[1.15] mb-4 sm:mb-6" data-magnetic-heading>
            {home.whyChooseUs.headingLead} <span class="text-primary">{home.whyChooseUs.headingAccent}</span> {home.whyChooseUs.headingRest}
          </h2>
          <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
            {home.whyChooseUs.intro}
          </p>
        </div>

        <!-- Trust-to-Action CTA -->
        <div class="cta-slide-right pt-2 flex flex-col sm:flex-row lg:flex-col xl:flex-row items-start sm:items-center lg:items-start xl:items-center justify-between gap-2.5">
          <p class="text-xs text-neutral-600 font-medium">Join businesses building their digital presence with Teknoppy.</p>
          <a
            href="/request-a-quote/"
            class="cta-float-primary cta-float-sway cta-delay-10 cta-pulse-medium cta-pulse-delay-2 inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-primary hover:text-neutral-900 transition-colors group"
          >
            <span>Start Your Project</span>
            <ArrowRight className="cta-arrow cta-arrow-invite w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- Right Feature Cards Column: Compact Neumorphic 2-Col Grid Balancing Height -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-3.5 md:gap-4">
        {features.map((feature, index) => {
          const Icon = icons[index];
          return (
          <div
            class="neu-card neu-card-cream rounded-2xl p-5 sm:p-4.5 md:p-5 transition-all duration-500 group flex flex-col justify-between advantage-card opacity-0 translate-y-8 w-full h-full"
            style={`transition-delay: ${index * 60}ms`}
          >
            <div>
              <div class="w-10 h-10 sm:w-10 sm:h-10 rounded-xl bg-[#FFF4ED] border border-[#FDE6D7] flex items-center justify-center transition-all duration-300 group-hover:bg-primary group-hover:border-primary group-hover:shadow-[0_4px_12px_rgba(240,90,44,0.25)] mb-3 sm:mb-3">
                <Icon className="w-5 h-5 sm:w-4.5 sm:h-4.5 text-primary group-hover:text-white transition-colors duration-300" />
              </div>
              
              <h3 class="text-base sm:text-[0.9375rem] md:text-base font-bold text-neutral-900 leading-snug mb-2 sm:mb-1.5 group-hover:text-primary transition-colors duration-300">
                {feature.title}
              </h3>
              
              <p class="text-neutral-600 text-sm sm:text-[0.8125rem] md:text-[0.875rem] leading-relaxed font-normal">
                {feature.description}
              </p>
            </div>
          </div>
          );
        })}
      </div>

    </div>

    <!-- Trusted Partner 100+ Brands Across Kerala — Continuous Rightward Logo Carousel (White Background) -->
    <div class="mt-12 sm:mt-14 md:mt-16 bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-neutral-200/80 shadow-sm relative z-10 overflow-hidden">
      <div class="text-center md:text-left mb-6 sm:mb-8">
        <p class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-1.5">Trusted Partner</p>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-black text-neutral-900 tracking-tight">100+ Brands Across Kerala</h3>
      </div>

      <!-- Marquee Carousel Viewport (Moving Rightward) -->
      <div class="marquee-viewport relative w-full overflow-hidden marquee-mask py-1.5" aria-label="Trusted client brand logos">
        <div class="flex w-max">
          <!-- Primary Logo Sequence (Announced once for accessibility) -->
          <div class="marquee-track flex items-center gap-3.5 sm:gap-5 lg:gap-6 pr-3.5 sm:pr-5 lg:pr-6 shrink-0">
            {partnerLogos.map((logo) => {
              const isEnlarged = logo.name === 'Laughing Waters' || logo.name === 'Kerala Dayz' || logo.name === 'Alankar Avenue';
              return (
                <div
                  class={`logo-plate rounded-xl border border-neutral-200/75 bg-white flex items-center justify-center shrink-0 hover:border-primary/50 hover:shadow-sm transition-all duration-300 overflow-hidden ${
                    isEnlarged
                      ? 'h-[72px] sm:h-[84px] lg:h-[92px] min-w-[150px] sm:min-w-[180px] lg:min-w-[210px] px-5 sm:px-6 py-2'
                      : 'h-[72px] sm:h-[84px] lg:h-[92px] min-w-[120px] sm:min-w-[140px] lg:min-w-[160px] px-3.5 sm:px-5 py-2'
                  }`}
                >
                  <img
                    src={logo.src}
                    alt={`${logo.name} logo`}
                    loading="lazy"
                    decoding="async"
                    class={`w-auto object-contain transition-all duration-300 ${
                      isEnlarged
                        ? 'h-[50px] sm:h-[60px] lg:h-[68px] max-w-[140px] sm:max-w-[170px] lg:max-w-[195px]'
                        : 'h-[36px] sm:h-[44px] lg:h-[50px] max-w-[105px] sm:max-w-[125px] lg:max-w-[145px]'
                    }`}
                  />
                </div>
              );
            })}
          </div>

          <!-- Duplicate Logo Sequence for Seamless Continuous Loop (Hidden from screen readers) -->
          <div class="marquee-track flex items-center gap-3.5 sm:gap-5 lg:gap-6 pr-3.5 sm:pr-5 lg:pr-6 shrink-0" aria-hidden="true">
            {partnerLogos.map((logo) => {
              const isEnlarged = logo.name === 'Laughing Waters' || logo.name === 'Kerala Dayz' || logo.name === 'Alankar Avenue';
              return (
                <div
                  class={`logo-plate rounded-xl border border-neutral-200/75 bg-white flex items-center justify-center shrink-0 hover:border-primary/50 hover:shadow-sm transition-all duration-300 overflow-hidden ${
                    isEnlarged
                      ? 'h-[72px] sm:h-[84px] lg:h-[92px] min-w-[150px] sm:min-w-[180px] lg:min-w-[210px] px-5 sm:px-6 py-2'
                      : 'h-[72px] sm:h-[84px] lg:h-[92px] min-w-[120px] sm:min-w-[140px] lg:min-w-[160px] px-3.5 sm:px-5 py-2'
                  }`}
                >
                  <img
                    src={logo.src}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class={`w-auto object-contain transition-all duration-300 ${
                      isEnlarged
                        ? 'h-[50px] sm:h-[60px] lg:h-[68px] max-w-[140px] sm:max-w-[170px] lg:max-w-[195px]'
                        : 'h-[36px] sm:h-[44px] lg:h-[50px] max-w-[105px] sm:max-w-[125px] lg:max-w-[145px]'
                    }`}
                  />
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>

    <!-- Decision CTA: After Why Teknoppy Advantages (Standout Checkpoint) -->
    <div class="cta-checkpoint mt-10 sm:mt-12 md:mt-14 pt-8 sm:pt-10 border-t border-neutral-200/70">
      <div class="bg-white rounded-2xl p-6 sm:p-8 lg:p-10 border border-neutral-200/80 shadow-sm flex flex-col md:flex-row items-center justify-between gap-5 sm:gap-6 text-center md:text-left">
        <div class="space-y-1.5 max-w-xl">
          <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-neutral-900 tracking-tight">
            Ready to give your business an unfair digital advantage?
          </h3>
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed font-normal">
            Get a tailored strategy, realistic timeline, and transparent pricing scoped for your specific market.
          </p>
        </div>
        <a
          href="/request-a-quote/"
          data-magnetic-btn
          class="w-full sm:w-auto cta-float-secondary cta-delay-11 cta-pulse-strong cta-pulse-delay-5 cta-shimmer-btn inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 text-xs sm:text-base font-bold text-white bg-primary rounded-full hover:bg-primary/95 transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 shrink-0 group whitespace-nowrap"
        >
          <span>Why Wait? Let's Build Yours</span>
          <ArrowRight className="cta-arrow cta-arrow-invite w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .advantage-card {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.4s ease, 
                box-shadow 0.4s ease, 
                opacity 0.6s ease;
  }

  /* Continuous Horizontal Scrolling Logo Marquee Moving to the RIGHT */
  .marquee-viewport {
    mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
  }

  .marquee-track {
    animation: marquee-scroll-right 38s linear infinite;
    will-change: transform;
  }

  @keyframes marquee-scroll-right {
    from {
      transform: translate3d(-100%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Pause on hover for desktop cursor interaction */
  @media (hover: hover) and (pointer: fine) {
    .marquee-viewport:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  /* Respect accessibility prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      transform: none;
    }
    .marquee-viewport {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>

<script>
  const advantageCards = document.querySelectorAll('.advantage-card');

  // Reveal cards on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-8');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  advantageCards.forEach(card => observer.observe(card));
</script>
