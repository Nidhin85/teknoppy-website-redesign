---
const services = [
  {
    title: "Website Design and Development",
    description: "We create responsive web design Kerala businesses are proud to show — clean, fast, mobile-optimised, and built to convert. From corporate portals to business landing pages, every website we design is engineered for performance and search visibility.",
    link: "Explore our web design services in Kochi",
    href: "#",
    iconHtml: `<svg class="w-6 h-6 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect x="2" y="3" width="20" height="13" rx="2" /><path d="M6 21h12M12 16v5" /><circle cx="6" cy="7" r="1.2" fill="currentColor" class="opacity-40" /><circle cx="9" cy="7" r="1.2" fill="currentColor" class="opacity-40" /></svg>`,
    color: "group-hover:text-primary",
    bgColor: "bg-primary/5 group-hover:bg-primary/10",
    borderColor: "group-hover:border-primary/50"
  },
  {
    title: "WordPress Website Development",
    description: "Our WordPress development team builds scalable, secure, and easily manageable websites for Kerala businesses of all sizes. Whether you need a fresh build or a complete platform migration, we deliver WordPress solutions that perform reliably from day one.",
    link: "Explore WordPress development",
    href: "#",
    iconHtml: `<svg class="w-6 h-6 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /><circle cx="6" cy="6" r="1.2" fill="currentColor" class="opacity-40" /></svg>`,
    color: "group-hover:text-secondary",
    bgColor: "bg-secondary/5 group-hover:bg-secondary/10",
    borderColor: "group-hover:border-secondary/50"
  },
  {
    title: "Ecommerce Website Development",
    description: "We design and develop online stores that sell. From WooCommerce to Shopify, our business website design Kerala ecommerce solutions are built for seamless shopping experiences, secure transactions, and maximum conversion rates.",
    link: "Explore ecommerce website development",
    href: "#",
    iconHtml: `<svg class="w-6 h-6 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /><circle cx="12" cy="15" r="2" fill="currentColor" class="opacity-40" /></svg>`,
    color: "group-hover:text-blue-500",
    bgColor: "bg-blue-500/5 group-hover:bg-blue-500/10",
    borderColor: "group-hover:border-blue-500/50"
  },
  {
    title: "Web Application Development",
    description: "Our team builds powerful custom web applications — from SaaS platforms and CRM systems to ERP portals and booking engines. We engineer solutions that automate processes and solve real business problems for Kerala companies.",
    link: "Explore web application development",
    href: "#",
    iconHtml: `<svg class="w-6 h-6 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M8 9l-3 3 3 3M16 9l3 3-3 3M12 5l-2 14" /></svg>`,
    color: "group-hover:text-purple-500",
    bgColor: "bg-purple-500/5 group-hover:bg-purple-500/10",
    borderColor: "group-hover:border-purple-500/50"
  },
  {
    title: "SEO and Search Visibility",
    description: "Every website we build starts with SEO-friendly website design Kerala businesses need to rank on Google's first page. Our SEO services cover technical SEO, on-page optimisation, Core Web Vitals, local SEO, and ecommerce SEO — all under one roof.",
    link: "Explore professional SEO services",
    href: "#",
    iconHtml: `<svg class="w-6 h-6 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.3-4.3M11 7v8M8 11h6" /></svg>`,
    color: "group-hover:text-green-500",
    bgColor: "bg-green-500/5 group-hover:bg-green-500/10",
    borderColor: "group-hover:border-green-500/50"
  },
  {
    title: "UI UX Design",
    description: "Great design is invisible — it simply works. Our UI UX team creates mobile-friendly website design Kerala users find intuitive, engaging, and conversion-ready. From wireframes and prototypes to final pixel-perfect interfaces, we design digital experiences that retain users.",
    link: "Explore UI UX design",
    href: "#",
    iconHtml: `<svg class="w-6 h-6 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>`,
    color: "group-hover:text-pink-500",
    bgColor: "bg-pink-500/5 group-hover:bg-pink-500/10",
    borderColor: "group-hover:border-pink-500/50"
  }
];
---

<section id="services" class="pt-16 md:pt-24 pb-32 bg-black relative">
  <!-- Dynamic background container to prevent overflow issues without breaking sticky scroll -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-primary/20 via-black to-black"></div>
    <div class="absolute bottom-0 left-0 w-full h-[300px] bg-gradient-to-t from-primary/10 to-transparent blur-[100px]"></div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-white text-sm font-bold uppercase tracking-wider mb-8 shadow-lg transform -rotate-1 backdrop-blur-sm">
        What We Do
      </div>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight text-white mb-6">
        Our <span class="text-primary">Website Design</span> and <br class="hidden md:block" /> <span class="text-primary">Digital Services</span> in Kerala
      </h2>
      <p class="text-xl text-gray-400 leading-relaxed font-medium">
        As a leading Web Design Company in Kerala, Teknoppy offers a complete range of digital services — from website design and development to SEO, ecommerce, and online marketing solutions Kerala businesses need to compete and grow in 2026.
      </p>
    </div>

    <!-- Redesigned Glassmorphic Services Grid (with mobile stacking scroll fixed) -->
    <div class="flex flex-col md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10">
      {services.map((service, index) => (
        <a href={service.href} class="group relative services-card-sticky bg-[#0E0E0E] md:bg-white/5 backdrop-blur-xl rounded-2xl p-8 md:p-10 border border-primary/20 md:border-white/10 md:hover:border-primary/30 shadow-[0_0_20px_rgba(249,98,50,0.06)] md:shadow-xl md:hover:shadow-[0_0_30px_rgba(249,98,50,0.12)] md:hover:-translate-y-1.5 transition-all duration-500 flex flex-col h-full overflow-hidden" style={`--stack-idx: ${index};`}>
          
          <!-- Hover Accent Glow (Permanent on mobile, hover on desktop) -->
          <div class="absolute top-0 right-0 w-24 h-24 md:w-32 md:h-32 bg-gradient-to-br from-primary/20 md:from-primary/35 to-transparent opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-700 blur-xl md:blur-2xl -z-10"></div>
          
          <!-- Large Background Watermark Icon -->
          <div class="absolute -right-6 -bottom-6 text-white opacity-[0.03] group-hover:opacity-[0.07] group-hover:scale-110 pointer-events-none transition-all duration-700 select-none -z-10 [&>svg]:w-36 [&>svg]:h-36 [&>svg]:stroke-[0.8]" set:html={service.iconHtml}></div>

          <div class="flex justify-between items-start mb-8">
            <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/10 flex items-center justify-center transition-all duration-300 group-hover:bg-primary group-hover:border-primary group-hover:shadow-[0_0_20px_rgba(249,98,50,0.4)] text-white" set:html={service.iconHtml}>
            </div>
            
            <!-- Arrow indicator -->
            <div class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center opacity-40 group-hover:opacity-100 group-hover:bg-white group-hover:border-white transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-white group-hover:text-black transform -rotate-45 group-hover:rotate-0 transition-all duration-300"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </div>
          
          <h3 class="text-2xl font-black text-white mb-4 leading-snug">
            {service.title}
          </h3>
          
          <p class="text-gray-400 text-base leading-relaxed flex-grow font-medium">
            {service.description}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 767px) {
    .services-card-sticky {
      position: sticky;
      top: calc(90px + var(--stack-idx) * 16px);
      /* Add slight dimming effect as they stack */
      z-index: var(--stack-idx);
    }
  }
</style>
