---
import { ArrowRight, Check, Shield } from "lucide-react";

const pricingRows = [
  { package: "Landing page", price: "from Rs. 15,000" },
  { package: "Business website (5–8 pages)", price: "from Rs. 25,000" },
  { package: "Corporate website with CMS", price: "from Rs. 1,20,000" },
  { package: "Ecommerce website", price: "Custom quote" },
  { package: "Web application", price: "Custom quote" },
  { package: "Monthly maintenance", price: "from Rs. 3,000 / month" }
];
---

<section id="kerala-pricing" class="py-12 sm:py-14 md:py-20 bg-white relative overflow-hidden">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 relative z-10 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <div class="lg:col-span-5 flex flex-col items-start text-left">
      <div class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs sm:text-sm font-bold uppercase tracking-wider mb-4 sm:mb-6 shadow-sm transform -rotate-1">
        Transparent Pricing
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black leading-tight text-neutral-900 mb-3 sm:mb-4" data-magnetic-heading>
        Website Design Cost in Kerala
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-neutral-600 font-medium leading-relaxed max-w-md">
        Clear, written quotes before work starts. No hidden fees.
      </p>
    </div>

    <!-- Pricing card -->
    <div class="lg:col-span-7 pricing-card bg-white rounded-[1.75rem] border border-primary/10 shadow-[0_30px_60px_-36px_rgba(160,60,20,0.45)] overflow-hidden">
      <div class="overflow-x-auto overscroll-x-contain" tabindex="0" role="region" aria-label="Website Design Package Pricing">
        <table class="w-full min-w-[290px] text-left border-collapse">
          <thead>
            <tr class="border-b border-neutral-100">
              <th scope="col" class="w-[58%] sm:w-[62%] pt-5 pb-3 px-4 sm:px-7 text-[11px] sm:text-xs font-bold text-neutral-400 uppercase tracking-[0.14em]">
                Package
              </th>
              <th scope="col" class="w-[42%] sm:w-[38%] pt-5 pb-3 px-4 sm:px-7 text-[11px] sm:text-xs font-bold text-neutral-400 uppercase tracking-[0.14em] text-right">
                Price
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            {pricingRows.map((row) => (
              <tr class="hover:bg-[#fff8f3] transition-colors">
                <td class="py-3.5 sm:py-4 px-4 sm:px-7 text-xs sm:text-[0.95rem] font-bold text-neutral-900 leading-snug">
                  {row.package}
                </td>
                <td class="py-3.5 sm:py-4 px-4 sm:px-7 text-xs sm:text-[0.95rem] font-bold text-primary text-right whitespace-nowrap">
                  {row.price}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="m-3 sm:m-4 mt-1 rounded-2xl bg-[#fff6f0] border border-primary/10 p-4 sm:px-5 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-5 text-center sm:text-left">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-white flex items-center justify-center text-primary shrink-0 border border-primary/15">
            <Shield className="w-4 h-4" />
          </div>
          <p class="text-xs sm:text-sm text-neutral-700 font-medium">
            Detailed project scope, milestone delivery, and zero surprise charges.
          </p>
        </div>
        <a
          href="/web-design-pricing-kerala/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-2.5 sm:py-3 text-xs sm:text-sm font-bold text-white bg-primary hover:bg-primary/95 rounded-full transition-all shadow-[0_6px_18px_-4px_rgba(240,90,44,0.5)] hover:-translate-y-0.5 shrink-0 group whitespace-nowrap"
        >
          <span>See Full Pricing</span>
          <ArrowRight className="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </div>
</section>
