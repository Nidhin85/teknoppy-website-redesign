---
import { ArrowRight, Play, Globe2, Smile, Award, Star } from "lucide-react";
import home from "../data/home.json";
---

<section
  class="relative pt-20 pb-20 md:pt-24 md:pb-28 overflow-hidden bg-cover bg-center bg-no-repeat hero-bg"
>
  <!-- Rich Decorative Background Layer -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
    <!-- Fine grid pattern texture -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(240,90,44,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(240,90,44,0.02)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_at_center,white,transparent_85%)]"
    >
    </div>

    <!-- Glowing Orbs (Warm Agency Theme) -->
    <div
      class="absolute -top-48 -right-48 w-[600px] h-[600px] rounded-full bg-secondary/10 blur-[135px] animate-[pulse_8s_infinite_alternate]"
    >
    </div>
    <div
      class="absolute top-[30%] -left-48 w-[500px] h-[500px] rounded-full bg-primary/5 blur-[120px]"
    >
    </div>
    <div
      class="absolute -bottom-48 right-[10%] w-[500px] h-[500px] rounded-full bg-secondary/8 blur-[100px] animate-[pulse_6s_infinite_alternate_1s]"
    >
    </div>

    <!-- Office graphic concentric circular outlines -->
    <svg
      class="absolute right-0 top-12 w-[600px] h-[600px] opacity-15 text-primary pointer-events-none"
      viewBox="0 0 200 200"
      fill="none"
    >
      <circle
        cx="120"
        cy="80"
        r="80"
        stroke="currentColor"
        stroke-width="0.3"
        stroke-dasharray="2 2"></circle>
      <circle cx="120" cy="80" r="60" stroke="currentColor" stroke-width="0.3"
      ></circle>
      <circle
        cx="120"
        cy="80"
        r="40"
        stroke="currentColor"
        stroke-width="0.6"
        stroke-dasharray="4 4"></circle>
      <path
        d="M20,100 C60,40 140,160 180,100"
        stroke="currentColor"
        stroke-width="0.3"></path>
    </svg>
  </div>

  <div
    class="max-w-[1280px] mx-auto px-6 lg:px-12 grid xl:grid-cols-12 gap-12 xl:gap-8 items-center relative z-10"
  >
    <!-- Content (Left Column) -->
    <div
      class="xl:col-span-5 flex flex-col items-center text-center xl:items-start xl:text-left pt-8 xl:pt-16"
    >
      <!-- Headline (H1) -->
      <h1
        class="text-4xl sm:text-5xl lg:text-[48px] xl:text-[54px] font-black leading-[1.15] tracking-tight text-neutral-900 mb-5"
      >
        <span class="block"
          >{home.hero.h1Lead} <span
            class="inline-block bg-primary text-white px-4 py-0.5 rounded-[1.5rem] transform -rotate-1 mt-1 shadow-md"
            >{home.hero.h1Accent}</span
          ></span
        >
      </h1>

      <!-- H2 — AEO Subheadline (keeps the signature pill motif) -->
      <h2
        class="text-lg sm:text-xl lg:text-[22px] font-bold leading-snug tracking-tight text-neutral-800 mb-6 max-w-xl mx-auto xl:mx-0"
      >
        {home.hero.subheadline.pre} <span
          class="inline-block bg-[#F9AE42]/20 text-primary px-2 py-0.5 rounded-lg shadow-sm"
          >{home.hero.subheadline.a1}</span
        > {home.hero.subheadline.mid1} <span
          class="inline-block bg-primary text-white px-2 py-0.5 rounded-lg shadow-sm"
          >{home.hero.subheadline.a2}</span
        > {home.hero.subheadline.mid2} <span
          class="inline-block bg-[#FFF8EF] border border-primary/20 text-primary px-2 py-0.5 rounded-lg shadow-sm"
          >{home.hero.subheadline.a3}</span
        > {home.hero.subheadline.post}
      </h2>

      <p
        class="text-base lg:text-lg text-neutral-600 mb-8 max-w-lg mx-auto xl:mx-0 leading-relaxed font-medium"
      >
        {home.hero.body}
      </p>

      <!-- Primary Action Area -->
      <div
        class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto mb-2"
      >
        <a
          href={home.hero.primaryCta.href}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.25)] hover:bg-primary/95 hover:shadow-[0_6px_25px_rgba(240,90,44,0.35)] hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap"
        >
          {home.hero.primaryCta.label}
          <ArrowRight className="w-4 h-4" />
        </a>
        <a
          href={home.hero.secondaryCta.href}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-neutral-700 bg-white border border-neutral-200 rounded-full hover:border-primary/50 hover:bg-[#FFF8EF] transition-all duration-300 shadow-sm whitespace-nowrap"
        >
          <span
            class="flex items-center justify-center w-6 h-6 rounded-full border border-neutral-300 text-primary"
          >
            <Play className="w-2.5 h-2.5 fill-current ml-0.5" />
          </span>
          {home.hero.secondaryCta.label}
        </a>
      </div>

      <!-- Trust Bar -->
      <div
        class="mt-4 pt-5 border-t border-neutral-100/60 w-full grid grid-cols-2 sm:grid-cols-4 gap-y-4 gap-x-3 max-w-lg mx-auto xl:mx-0"
      >
        {home.hero.trustBar.map((stat) => (
          <div class="flex flex-col items-center xl:items-start">
            <span class="text-xl lg:text-2xl font-black text-neutral-900 leading-none">{stat.value}</span>
            <span class="text-[11px] text-neutral-500 font-semibold mt-1.5 uppercase tracking-wide text-center xl:text-left leading-tight">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Visual Presentation (Mockups with Warm Agency Highlights) -->
    <!-- Device Showcase (position: relative) -->
    <div
      id="device-showcase"
      class="xl:col-span-7 relative w-full h-[620px] hidden xl:flex items-center justify-center mt-6"
    >
      <!-- Central Background Glow -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-secondary/15 rounded-full blur-[85px] -z-10"
      >
      </div>

      <!-- Mockup Device Image Container -->
      <div
        class="w-full max-w-[750px] z-10 scale-160 xl:-translate-y-15 origin-center"
      >
        <img
          src="/mockup.png"
          alt="Teknoppy Performance Dashboard Mockups"
          class="w-full h-auto object-contain"
        />
      </div>

      <!-- Projects Delivered (Top Left of laptop) -->
      <div
        class="absolute top-[8%] left-[20%] w-[185px] bg-white rounded-2xl border border-neutral-100/70 p-3 z-20 hover:-translate-y-1 transition-all duration-300 anim-float-1 shadow-[0_12px_35px_rgba(240,90,44,0.04)] flex items-center gap-3"
      >
        <div
          class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"></path></svg
          >
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="text-[14px] font-extrabold text-neutral-900 leading-tight"
            >150+ Projects</span
          >
          <span
            class="text-[10px] text-neutral-500 font-semibold leading-none mt-0.5"
            >Delivered Globally</span
          >
        </div>
      </div>

      <!-- Top Rated Card (Left Center beside laptop) -->
      <div
        class="absolute top-[38%] left-[20%] w-[190px] bg-white rounded-2xl border border-neutral-100/70 p-3 z-20 hover:-translate-y-1 transition-all duration-300 anim-float-2 shadow-[0_12px_35px_rgba(240,90,44,0.04)] flex items-center gap-3"
      >
        <div
          class="w-9 h-9 rounded-full bg-amber-50 text-amber-500 flex items-center justify-center flex-shrink-0"
        >
          <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24"
            ><path
              d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
            ></path></svg
          >
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="text-[14px] font-extrabold text-neutral-900 leading-tight"
            >Top Rated</span
          >
          <span
            class="text-[10px] text-neutral-500 font-semibold leading-none mt-0.5"
            >Digital Agency</span
          >
        </div>
      </div>

      <!-- Google Partner Card (Top Right beside laptop) -->
      <div
        class="absolute top-[1%] right-[2%] w-[185px] bg-white rounded-2xl border border-neutral-100/70 p-3 z-20 hover:-translate-y-1 transition-all duration-300 anim-float-3 shadow-[0_12px_35px_rgba(240,90,44,0.04)] flex items-center gap-3"
      >
        <div
          class="w-9 h-9 rounded-full bg-neutral-50 flex items-center justify-center flex-shrink-0 shadow-inner"
        >
          <svg
            class="w-4.5 h-4.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              fill="#4285F4"></path><path
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              fill="#34A853"></path><path
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
              fill="#FBBC05"></path><path
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              fill="#EA4335"></path></svg
          >
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="text-[14px] font-extrabold text-neutral-900 leading-tight"
            >Google Partner</span
          >
          <span
            class="text-[10px] text-neutral-500 font-semibold leading-none mt-0.5"
            >Certified & Trusted</span
          >
        </div>
      </div>

      <!-- Client Satisfaction Card (Bottom Right beside phone) -->
      <div
        class="absolute bottom-[22%] right-[2%] w-[180px] bg-white rounded-2xl border border-neutral-100/70 p-3 z-20 hover:-translate-y-1 transition-all duration-300 anim-float-4 shadow-[0_12px_35px_rgba(240,90,44,0.04)] flex items-center gap-3"
      >
        <div
          class="w-9 h-9 rounded-full bg-rose-50 text-rose-500 flex items-center justify-center flex-shrink-0"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"
            ><path
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            ></path></svg
          >
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="text-[14px] font-extrabold text-neutral-900 leading-tight"
            >100% Satisfied</span
          >
          <span
            class="text-[10px] text-neutral-500 font-semibold leading-none mt-0.5"
            >Client Happiness Rate</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    background-image: url("/mobileherobg2.png");
  }
  @media (min-width: 768px) {
    .hero-bg {
      background-image: url("/tekenoppyherobg.png");
    }
  }

  /* Custom Floating Callout Animations */
  .anim-float-1 {
    animation: float1 7s ease-in-out infinite;
  }
  .anim-float-2 {
    animation: float2 6s ease-in-out infinite;
  }
  .anim-float-3 {
    animation: float3 8s ease-in-out infinite;
  }
  .anim-float-4 {
    animation: float4 7.5s ease-in-out infinite;
  }

  @keyframes float1 {
    0%,
    100% {
      transform: translateY(0) rotate(-3deg);
    }
    50% {
      transform: translateY(-7px) rotate(-3deg);
    }
  }
  @keyframes float2 {
    0%,
    100% {
      transform: translateY(0) rotate(2deg);
    }
    50% {
      transform: translateY(-6px) rotate(2deg);
    }
  }
  @keyframes float3 {
    0%,
    100% {
      transform: translateY(0) rotate(1deg);
    }
    50% {
      transform: translateY(-7px) rotate(1deg);
    }
  }
  @keyframes float4 {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-6px) rotate(-2deg);
    }
  }
</style>
