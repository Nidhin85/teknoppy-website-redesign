---
import { ArrowUpRight, Play, Layers, Users, Award, MapPin } from "lucide-react";
import home from "../data/home.json";

// Stats strip icons, in the same order as home.hero.trustBar
const statIcons = [Layers, Users, Award, MapPin];
---

<section id="hero-intro" class="home-hero relative overflow-hidden">
  <!-- Ambient light (decorative) -->
  <div class="home-hero-bg absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1320px] mx-auto px-5 sm:px-8 lg:px-12 pt-8 sm:pt-12 lg:pt-14">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-6 items-center">
      <!-- Copy -->
      <div class="hero-copy lg:col-span-6 xl:col-span-6 flex flex-col items-center text-center lg:items-start lg:text-left relative z-20">
        <h1 class="hero-h1 font-black text-neutral-950 tracking-[-0.035em] leading-[1.02] text-[2.65rem] min-[420px]:text-5xl sm:text-6xl lg:text-[4.1rem] xl:text-[4.6rem]" data-magnetic-heading>
          {home.hero.h1Lead} <em class="hero-accent not-italic">{home.hero.h1Accent}</em>
        </h1>

        <h2 class="hero-h2 mt-5 sm:mt-6 text-lg sm:text-xl lg:text-[1.35rem] font-bold leading-snug tracking-tight text-neutral-800 max-w-xl">
          {home.hero.subheadline.pre} <span class="text-primary">{home.hero.subheadline.a1}</span> {home.hero.subheadline.mid1} <span class="text-primary">{home.hero.subheadline.a2}</span> {home.hero.subheadline.mid2} <span class="text-primary">{home.hero.subheadline.a3}</span> {home.hero.subheadline.post}
        </h2>

        <p class="hero-body mt-4 text-base lg:text-[1.0625rem] text-neutral-600 max-w-lg leading-relaxed font-medium">
          {home.hero.body}<span id="hero-body-more">{" "}{home.hero.bodyMore}</span>{" "}<button
            type="button"
            id="hero-body-toggle"
            class="hero-body-toggle inline-flex items-baseline gap-1 font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary transition-colors cursor-pointer"
            aria-expanded="true"
            aria-controls="hero-body-more"
            data-more={home.hero.readMoreLabel}
            data-less={home.hero.readLessLabel}
            hidden
          >
            <span class="hero-toggle-label">{home.hero.readLessLabel}</span>
            <svg class="hero-toggle-chevron w-3.5 h-3.5 self-center transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </button>
        </p>

        <div class="hero-ctas mt-7 flex flex-col min-[420px]:flex-row items-center gap-3 w-full min-[420px]:w-auto">
          <a
            href={home.hero.primaryCta.href}
            data-magnetic-btn
            class="hero-cta-primary cta-pulse-strong cta-shimmer-btn group w-full min-[420px]:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 text-[0.98rem] font-bold text-white bg-primary rounded-full hover:bg-primary/95 transition-all duration-300 leading-snug sm:whitespace-nowrap text-center"
          >
            <span>{home.hero.primaryCta.label}</span>
            <ArrowUpRight className="cta-arrow w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
          <a
            href={home.hero.secondaryCta.href}
            class="group w-full min-[420px]:w-auto inline-flex items-center justify-center gap-3 px-6 py-3 text-[0.98rem] font-bold text-neutral-900 bg-white/70 backdrop-blur border border-neutral-300/80 rounded-full hover:border-primary/60 hover:text-primary transition-all duration-300 leading-snug sm:whitespace-nowrap text-center"
          >
            <span class="flex items-center justify-center w-8 h-8 rounded-full border-2 border-neutral-900 group-hover:border-primary transition-colors">
              <Play className="w-3 h-3 fill-current ml-0.5" />
            </span>
            {home.hero.secondaryCta.label}
          </a>
        </div>

        <div class="cta-slide-left mt-5 flex flex-col sm:flex-row items-center gap-x-4 gap-y-1.5">
          <span class="text-[13px] text-neutral-500 font-medium text-center sm:text-left">
            Tell us what you need and we'll help you find the right solution.
          </span>
          <a
            href="/request-a-quote/"
            class="cta-float-primary cta-float-sway cta-delay-1 cta-pulse-medium cta-pulse-delay-3 inline-flex items-center gap-1.5 text-[13px] font-bold text-primary hover:text-primary/80 whitespace-nowrap group transition-colors rounded-full"
          >
            <span>Let's Discuss Your Project</span>
            <ArrowUpRight className="cta-arrow cta-arrow-invite w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- 3D scene -->
      <div class="hero-scene lg:col-span-6 xl:col-span-6 relative" aria-hidden="true">
        <div class="hero-scene-frame relative">
          <!-- 3D brand scene: logo tile on a layered platform, service icon tiles, gradient ribbons.
               Pure CSS/SVG, sized in container units so every piece scales with the column. -->
          <div class="hs-stage">
            <span class="hs-glow"></span>
            <svg class="hs-ribbons" viewBox="0 0 1000 860" preserveAspectRatio="none" focusable="false">
              <defs>
                <linearGradient id="hsRib" x1="0" y1="1" x2="1" y2="0">
                  <stop offset="0" stop-color="#e8461c" />
                  <stop offset=".38" stop-color="#f05a2c" />
                  <stop offset=".62" stop-color="#ff8a3d" />
                  <stop offset=".85" stop-color="#f9ae42" />
                  <stop offset="1" stop-color="#ffd27a" />
                </linearGradient>
                <linearGradient id="hsRibGloss" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#fff" stop-opacity="0" />
                  <stop offset=".45" stop-color="#fff" stop-opacity=".55" />
                  <stop offset=".55" stop-color="#fff" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="hsRibSoft" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#ffd98a" />
                  <stop offset="1" stop-color="#ffb35c" />
                </linearGradient>
                <path id="hsRibMain" fill-rule="evenodd" d="M45,470a455,370 0 1,0 910,0a455,370 0 1,0 -910,0ZM108,452a420,345 0 1,0 840,0a420,345 0 1,0 -840,0Z" />
                <path id="hsRibThin" fill-rule="evenodd" d="M140,420a360,330 0 1,0 720,0a360,330 0 1,0 -720,0ZM145,440a335,318 0 1,0 670,0a335,318 0 1,0 -670,0Z" />
                <clipPath id="hsFront"><rect x="0" y="655" width="1000" height="205" /></clipPath>
                <linearGradient id="hsOpenGrad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset=".16" stop-color="#000" />
                  <stop offset=".34" stop-color="#fff" />
                </linearGradient>
                <mask id="hsOpen" maskUnits="userSpaceOnUse" x="-100" y="-100" width="1200" height="1060"><rect x="-100" y="-100" width="1200" height="1060" fill="url(#hsOpenGrad)" /></mask>
              </defs>
              <g transform="rotate(18 500 430)" opacity=".6"><use href="#hsRibThin" fill="url(#hsRibSoft)" /></g>
              <ellipse cx="500" cy="700" rx="420" ry="88" fill="none" stroke="#ffc98a" stroke-width="5" opacity=".55" />
              <g mask="url(#hsOpen)"><g transform="rotate(-14 500 460)">
                <use href="#hsRibMain" fill="url(#hsRib)" />
                <use href="#hsRibMain" fill="url(#hsRibGloss)" />
              </g></g>
            </svg>

            <div class="hs-podium">
              <span class="hs-disc hs-disc-base"></span>
              <span class="hs-disc hs-disc-top"></span>
              <span class="hs-podium-light"></span>
            </div>

            <div class="hs-tile">
              <span class="hs-mark"><img src="/logo.svg" alt="" width="220" height="62" decoding="async" /></span>
              <span class="hs-word"><img src="/logo.svg" alt="" width="220" height="62" decoding="async" /></span>
            </div>

            <span class="hs-ic hs-ic-code"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16" /></svg></span>
            <span class="hs-ic hs-ic-pen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M15.7 21.3a1 1 0 0 1-1.4 0l-1.6-1.6a1 1 0 0 1 0-1.4l5.6-5.6a1 1 0 0 1 1.4 0l1.6 1.6a1 1 0 0 1 0 1.4z" /><path d="m18 13-1.4-6.9a1 1 0 0 0-.7-.8L3.2 2a1 1 0 0 0-1.2 1.2l3.3 12.7a1 1 0 0 0 .8.7L13 18" /><path d="m2.3 2.3 7.3 7.3" /><circle cx="11" cy="11" r="2" /></svg></span>
            <span class="hs-ic hs-ic-chart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21v-4M11 21v-7M17 21v-10" stroke-width="3.4" /><path d="M3 12.5 9 8l3.5 2.5L20 4.5M15.5 4H20.5V9" stroke-width="2.3" /></svg></span>
            <span class="hs-ic hs-ic-mega"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10.5 12-4.5v12L3 13.5z" fill="currentColor" fill-opacity=".18" /><path d="M7 14.5 8.2 19a1.5 1.5 0 0 0 2.9-.8l-.8-2.9" /><path d="M18.5 9.5h2.5M18 6l2-1.5M18 13l2 1.5" /></svg></span>

            <svg class="hs-ribbons hs-ribbons-front" viewBox="0 0 1000 860" preserveAspectRatio="none" focusable="false">
              <g clip-path="url(#hsFront)">
                <ellipse cx="500" cy="700" rx="420" ry="88" fill="none" stroke="#ffc98a" stroke-width="5" opacity=".55" />
                <g transform="rotate(-14 500 460)">
                  <use href="#hsRibMain" fill="url(#hsRib)" />
                  <use href="#hsRibMain" fill="url(#hsRibGloss)" />
                </g>
              </g>
            </svg>
          </div>

          <!-- Floating glass chips (existing badge content) -->
          <div class="hero-chip chip-a">
            <span class="chip-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg></span>
            <span class="chip-tx"><b>120+ Projects</b><small>Delivered Globally</small></span>
          </div>
          <div class="hero-chip chip-b">
            <span class="chip-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.36-1.86M17 20H7m10 0v-2c0-.66-.13-1.3-.36-1.86m0 0A5 5 0 0012 15a5 5 0 00-4.64 3.14M7 20H2v-2a3 3 0 015.36-1.86M7 20v-2c0-.66.13-1.3.36-1.86m0 0a5 5 0 014.64-3.14M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg></span>
            <span class="chip-tx"><b>In-House Team</b><small>Design, Dev &amp; SEO</small></span>
          </div>
          <div class="hero-chip chip-c">
            <span class="chip-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg></span>
            <span class="chip-tx"><b>Serving All of Kerala</b><small>&amp; GCC Clients</small></span>
          </div>
          <div class="hero-chip chip-d">
            <span class="chip-ic"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
            <span class="chip-tx"><b>24-Hr Response</b><small>IST, GST &amp; AST Hours</small></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats strip (existing trust bar) -->
    <div class="hero-stats relative z-20 mt-8 lg:mt-10 mb-2" role="list">
      {home.hero.trustBar.map((stat, i) => {
        const Icon = statIcons[i] ?? Layers;
        return (
          <div class="hero-stat" role="listitem">
            <Icon className="hero-stat-ic" strokeWidth={1.75} />
            <div class="min-w-0">
              <span class="hero-stat-v">{stat.value}</span>
              <span class="hero-stat-l">{stat.label}</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script is:inline>
  /* The back half of the hero paragraph is keyword-rich but long. Collapsing it
     behind a toggle keeps the text in the DOM for crawlers while letting the CTAs
     sit higher. Inline (not a module) so it runs during parse with no flash; the
     markup ships expanded with the button hidden for visitors without JS. */
  (function () {
    var more = document.getElementById("hero-body-more");
    var btn = document.getElementById("hero-body-toggle");
    if (!more || !btn) return;
    var label = btn.querySelector(".hero-toggle-label");
    function setOpen(open) {
      more.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
      btn.classList.toggle("is-open", open);
      label.textContent = open ? btn.dataset.less : btn.dataset.more;
    }
    setOpen(false);
    btn.hidden = false;
    btn.addEventListener("click", function () {
      setOpen(btn.getAttribute("aria-expanded") !== "true");
    });
  })();
</script>

<style>
  .home-hero {
    background: #fff6ef;
  }
  .home-hero-bg {
    background:
      radial-gradient(52rem 34rem at 78% 30%, rgba(255, 150, 95, 0.30), transparent 65%),
      radial-gradient(38rem 26rem at 100% 85%, rgba(249, 174, 66, 0.20), transparent 70%),
      radial-gradient(44rem 30rem at 0% 0%, rgba(255, 255, 255, 0.95), transparent 70%),
      linear-gradient(180deg, #fffaf6 0%, #fff3ea 100%);
  }

  /* Heading: accent word in orange italic, like the reference */
  /* Solid fill on purpose: the magnetic-heading script wraps each letter in an
     inline-block, will-change span (its own layer). A gradient with
     background-clip:text on the parent does not paint into those layers while the
     transparent text fill is inherited, so the word rendered invisible. */
  .hero-accent {
    font-style: italic;
    color: var(--color-primary);
    -webkit-text-fill-color: currentColor;
    padding-right: 0.08em; /* room for the italic overhang */
  }
  .hero-accent :global(.mag-word),
  .hero-accent :global(.mag-char) {
    color: inherit;
    -webkit-text-fill-color: currentColor;
  }

  /* 3D brand scene. Everything is placed in cqw (1% of the stage width) on a
     1000 x 860 grid, so the composition keeps its proportions at every width. */
  .hero-scene-frame {
    margin-inline: -4%;
  }
  @media (min-width: 1024px) {
    .hero-scene-frame { margin-right: -10%; margin-left: -4%; margin-top: 2%; }
  }
  .hs-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1000 / 860;
    container-type: inline-size;
    isolation: isolate; /* keep the front ribbon layer below the glass chips */
    user-select: none;
  }
  .hs-stage > * { position: absolute; }
  .hs-glow {
    inset: 6% 10% 4%;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 50% 42%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 70%),
      radial-gradient(closest-side at 50% 70%, rgba(255, 170, 100, 0.35), rgba(255, 170, 100, 0) 100%);
    filter: blur(1cqw);
  }
  .hs-ribbons {
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 1.2cqw 1.6cqw rgba(232, 80, 30, 0.28));
  }
  .hs-ribbons-front { z-index: 4; }

  /* Layered platform: each disc is a cylinder (side) with an elliptical top */
  .hs-podium { inset: 0; z-index: 1; }
  .hs-disc { position: absolute; display: block; }
  .hs-disc::before,
  .hs-disc::after { content: ""; position: absolute; left: 0; right: 0; }
  .hs-disc-base { left: 17cqw; width: 66cqw; top: 55cqw; height: 21cqw; }
  .hs-disc-base::before {
    top: 0; bottom: 0;
    border-radius: 50% / 8cqw;
    background: linear-gradient(90deg, #ead8cb 0%, #fffaf6 38%, #ffffff 55%, #efe0d5 100%);
    box-shadow: 0 3cqw 5cqw -1.5cqw rgba(170, 80, 30, 0.35);
  }
  .hs-disc-base::after {
    top: 0; height: 16cqw;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 40%, #ffffff 0%, #fdf5ef 60%, #f4e3d6 100%);
    box-shadow: inset 0 -0.4cqw 0.8cqw rgba(255, 255, 255, 0.9);
  }
  .hs-disc-top { left: 27cqw; width: 46cqw; top: 52cqw; height: 12.6cqw; }
  .hs-disc-top::before {
    top: 0; bottom: 0;
    border-radius: 50% / 5cqw;
    background: linear-gradient(90deg, #d8461c 0%, #ff8a4c 40%, #ff9b5a 55%, #e2501f 100%);
  }
  .hs-disc-top::after {
    top: 0; height: 10cqw;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 35%, #ffc08a 0%, #ff8c4a 45%, #f26a33 100%);
    box-shadow: inset 0 0.3cqw 0.5cqw rgba(255, 255, 255, 0.55);
  }
  .hs-podium-light {
    position: absolute;
    left: 32cqw; width: 36cqw; top: 53.5cqw; height: 6cqw;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 246, 200, 0.95), rgba(255, 200, 120, 0) 100%);
    filter: blur(0.5cqw);
  }

  /* Glass tiles: light face + stacked edge shadows give the slab thickness */
  .hs-tile,
  .hs-ic {
    background: linear-gradient(150deg, #ffffff 0%, #fff8f3 50%, #ffe9da 100%);
    box-shadow:
      inset 0 0.25cqw 0 #ffffff,
      inset 0 -0.6cqw 1.4cqw rgba(240, 110, 50, 0.14),
      0 0.5cqw 0 #f8dccb,
      0 1cqw 0 #f2c7ab,
      0 3cqw 4.5cqw -1cqw rgba(190, 75, 25, 0.38);
  }
  .hs-tile {
    z-index: 3;
    left: 32cqw; top: 18.5cqw;
    width: 36cqw; height: 36cqw;
    border-radius: 7.5cqw;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1.6cqw;
    transform: perspective(90cqw) rotateX(6deg) rotateY(-12deg) rotateZ(-3deg);
    animation: hsTileFloat 7s ease-in-out infinite;
  }
  .hs-tile::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: linear-gradient(125deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 38%),
      radial-gradient(70% 45% at 50% 105%, rgba(255, 170, 90, 0.35), rgba(255, 170, 90, 0));
  }
  .hs-mark,
  .hs-word { position: relative; display: block; overflow: hidden; }
  .hs-mark img,
  .hs-word img { display: block; max-width: none; height: auto; }
  /* /logo.svg is 220 x 62: the mark spans x 0-58, the wordmark x 60-220 */
  .hs-mark { width: 10cqw; height: calc(10cqw * 62 / 58); }
  .hs-mark img { width: calc(10cqw * 220 / 58); }
  .hs-word { width: 27cqw; height: calc(27cqw * 62 / 160); }
  .hs-word img { width: calc(27cqw * 220 / 160); margin-left: calc(-27cqw * 60 / 160); }

  .hs-ic {
    z-index: 2;
    width: 14cqw; height: 14cqw;
    border-radius: 3.6cqw;
    display: grid; place-items: center;
    color: #f05a2c;
  }
  .hs-ic svg { width: 6.6cqw; height: 6.6cqw; filter: drop-shadow(0 0.3cqw 0.4cqw rgba(240, 90, 44, 0.3)); }
  .hs-ic-code  { left: 14cqw; top: 20cqw; transform: rotate(-9deg); animation: hsIcFloat 6s ease-in-out infinite -1s; }
  .hs-ic-pen   { left: 5cqw;  top: 42cqw; transform: rotate(-6deg); animation: hsIcFloat 7s ease-in-out infinite -3s; }
  .hs-ic-chart { right: 12cqw; top: 17cqw; transform: rotate(7deg);  animation: hsIcFloat 6.5s ease-in-out infinite -2s; }
  .hs-ic-mega  { right: 4cqw;  top: 40cqw; transform: rotate(5deg);  animation: hsIcFloat 7.5s ease-in-out infinite; }
  @keyframes hsTileFloat {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -1cqw; }
  }
  @keyframes hsIcFloat {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -1.2cqw; }
  }

  /* Glass chips */
  .hero-chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem 0.7rem 0.75rem;
    border-radius: 1.1rem;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(255, 244, 236, 0.62));
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9) inset, 0 18px 40px -18px rgba(160, 60, 20, 0.45);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
            backdrop-filter: blur(14px) saturate(1.3);
    white-space: nowrap;
    z-index: 3;
  }
  .chip-ic {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.8rem;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(145deg, #ff8a4c, #f05a2c);
    box-shadow: 0 8px 18px -8px rgba(240, 90, 44, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.45);
  }
  .chip-ic svg { width: 1.05rem; height: 1.05rem; }
  .chip-tx { display: flex; flex-direction: column; line-height: 1.15; }
  .chip-tx b { font-size: 0.95rem; font-weight: 800; color: #171717; }
  .chip-tx small { font-size: 0.75rem; font-weight: 600; color: #737373; margin-top: 0.15rem; }

  .chip-a { top: 0%;  left: 6%; animation: chipFloat 7s ease-in-out infinite; }
  .chip-b { top: 84%; left: 4%;  animation: chipFloat 6s ease-in-out infinite -2s; }
  .chip-c { top: 2%;  right: 9%; animation: chipFloat 8s ease-in-out infinite -1s; }
  .chip-d { top: 88%; right: 9%; animation: chipFloat 7.5s ease-in-out infinite -3s; }
