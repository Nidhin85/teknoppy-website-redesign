---
import { ArrowRight, Play, Globe2, Smile, Award, Star } from "lucide-react";
import home from "../data/home.json";
---

<section
  id="hero-intro"
  class="relative py-10 sm:py-12 lg:py-16 overflow-hidden bg-gradient-to-b from-[#FFFDF9] via-white to-white"
>
  <!-- Rich Decorative Background Layer -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
    <!-- Fine grid pattern texture -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(240,90,44,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(240,90,44,0.02)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_at_center,white,transparent_85%)]"
    >
    </div>

    <!-- Glowing Orbs (Warm Agency Theme) -->
    <div
      class="absolute -top-32 -right-48 w-[600px] h-[600px] rounded-full bg-secondary/8 blur-[135px] animate-[pulse_8s_infinite_alternate]"
    >
    </div>
    <div
      class="absolute top-[25%] -left-48 w-[500px] h-[500px] rounded-full bg-primary/4 blur-[120px]"
    >
    </div>
    <div
      class="absolute -bottom-48 right-[10%] w-[500px] h-[500px] rounded-full bg-secondary/6 blur-[100px] animate-[pulse_6s_infinite_alternate_1s]"
    >
    </div>

    <!-- Office graphic concentric circular outlines -->
    <svg
      class="absolute right-0 top-12 w-[600px] h-[600px] opacity-15 text-primary pointer-events-none"
      viewBox="0 0 200 200"
      fill="none"
    >
      <circle
        cx="120"
        cy="80"
        r="80"
        stroke="currentColor"
        stroke-width="0.3"
        stroke-dasharray="2 2"></circle>
      <circle cx="120" cy="80" r="60" stroke="currentColor" stroke-width="0.3"
      ></circle>
      <circle
        cx="120"
        cy="80"
        r="40"
        stroke="currentColor"
        stroke-width="0.6"
        stroke-dasharray="4 4"></circle>
      <path
        d="M20,100 C60,40 140,160 180,100"
        stroke="currentColor"
        stroke-width="0.3"></path>
    </svg>
  </div>

  <div
    class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 grid xl:grid-cols-12 gap-12 xl:gap-8 items-center relative z-10"
  >
    <!-- Content (Left Column) -->
    <div
      class="hero-copy xl:col-span-5 flex flex-col items-center text-center xl:items-start xl:text-left pt-0 xl:pt-2 relative z-20"
    >
      <!-- Headline (H1) -->
      <h1
        class="hero-h1 text-4xl sm:text-5xl lg:text-[48px] xl:text-[54px] font-black leading-[1.15] tracking-tight text-neutral-900 mb-4 sm:mb-5"
        data-magnetic-heading
      >
        <span class="block"
          >{home.hero.h1Lead} <span
            class="inline-block bg-primary text-white px-4 py-0.5 rounded-[1.5rem] transform -rotate-1 mt-1 shadow-md"
            >{home.hero.h1Accent}</span
          ></span
        >
      </h1>

      <!-- H2 — AEO Subheadline (keeps the signature pill motif) -->
      <h2
        class="hero-h2 text-lg sm:text-xl lg:text-[22px] font-bold leading-snug tracking-tight text-neutral-800 mb-4 sm:mb-6 max-w-xl mx-auto xl:mx-0"
      >
        {home.hero.subheadline.pre} <span
          class="inline-block bg-[#F9AE42]/20 text-primary px-2 py-0.5 rounded-lg shadow-sm"
          >{home.hero.subheadline.a1}</span
        > {home.hero.subheadline.mid1} <span
          class="inline-block bg-primary text-white px-2 py-0.5 rounded-lg shadow-sm"
          >{home.hero.subheadline.a2}</span
        > {home.hero.subheadline.mid2} <span
          class="inline-block bg-cream border border-primary/20 text-primary px-2 py-0.5 rounded-lg shadow-sm"
          >{home.hero.subheadline.a3}</span
        > {home.hero.subheadline.post}
      </h2>

      <p
        class="hero-body text-base lg:text-lg text-neutral-600 mb-6 sm:mb-8 max-w-lg mx-auto xl:mx-0 leading-relaxed font-medium"
      >
        {home.hero.body}<span id="hero-body-more">{" "}{home.hero.bodyMore}</span>{" "}<button
          type="button"
          id="hero-body-toggle"
          class="hero-body-toggle inline-flex items-baseline gap-1 font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary transition-colors cursor-pointer"
          aria-expanded="true"
          aria-controls="hero-body-more"
          data-more={home.hero.readMoreLabel}
          data-less={home.hero.readLessLabel}
          hidden
        >
          <span class="hero-toggle-label">{home.hero.readLessLabel}</span>
          <svg
            class="hero-toggle-chevron w-3.5 h-3.5 self-center transition-transform duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
      </p>

      <!-- Primary Action Area -->
      <div
        class="hero-ctas flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto mb-2"
      >
        <a
          href={home.hero.primaryCta.href}
          data-magnetic-btn
          class="hero-cta-primary cta-pulse-strong cta-shimmer-btn group w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 sm:px-8 py-3.5 sm:py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.25)] hover:bg-primary/95 hover:shadow-[0_6px_25px_rgba(240,90,44,0.35)] hover:-translate-y-0.5 transition-all duration-300 leading-snug sm:whitespace-nowrap text-center"
        >
          <span>{home.hero.primaryCta.label}</span>
          <ArrowRight className="cta-arrow w-4 h-4" />
        </a>
        <a
          href={home.hero.secondaryCta.href}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 sm:px-8 py-3.5 sm:py-4 text-base font-bold text-neutral-700 bg-white border border-neutral-200 rounded-full hover:border-primary/50 hover:bg-cream transition-all duration-300 shadow-sm leading-snug sm:whitespace-nowrap text-center"
        >
          <span
            class="flex items-center justify-center w-6 h-6 rounded-full border border-neutral-300 text-primary"
          >
            <Play className="w-2.5 h-2.5 fill-current ml-0.5" />
          </span>
          {home.hero.secondaryCta.label}
        </a>
      </div>

      <!-- Trust Bar -->
      <div
        class="hero-trust mt-4 pt-5 border-t border-neutral-100/60 w-full grid grid-cols-2 sm:grid-cols-4 gap-y-4 gap-x-3 max-w-lg mx-auto xl:mx-0"
      >
        {home.hero.trustBar.map((stat) => (
          <div class="flex flex-col items-center xl:items-start">
            <span class="text-xl lg:text-2xl font-black text-neutral-900 leading-none">{stat.value}</span>
            <span class="text-[13px] text-neutral-500 font-semibold mt-1.5 uppercase tracking-wide text-center xl:text-left leading-tight">{stat.label}</span>
          </div>
        ))}
      </div>

      <!-- Subtle Conversion Opportunity: After Hero Trust Indicators (Side Slide-In) -->
      <div class="cta-slide-left mt-4 pt-3.5 border-t border-neutral-100/60 flex flex-col sm:flex-row items-center justify-between gap-2.5 max-w-lg mx-auto xl:mx-0">
        <span class="text-xs text-neutral-500 font-medium text-center sm:text-left">
          Tell us what you need and we'll help you find the right solution.
        </span>
        <a
          href="/request-a-quote/"
          class="cta-float-primary cta-float-sway cta-delay-1 cta-pulse-medium cta-pulse-delay-3 inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-hover whitespace-nowrap group transition-colors"
        >
          <span>Let's Discuss Your Project</span>
          <ArrowRight className="cta-arrow cta-arrow-invite w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <!-- Visual Presentation (Mockups with Warm Agency Highlights) -->
    <!-- Device Showcase (position: relative) -->
    <div
      id="device-showcase"
      class="xl:col-span-7 relative w-full h-[620px] hidden xl:flex items-center justify-center mt-6"
    >
      <!-- Central Background Glow -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-secondary/15 rounded-full blur-[85px] -z-10"
      >
      </div>

      <!-- Mockup Device Image Container -->
      <div
        class="hero-mockup w-full max-w-[750px] z-10 scale-160 xl:-translate-y-15 origin-center"
      >
        <!-- The container is `hidden xl:flex`, so lazy loading keeps this 145 KB off
             every phone and tablet visit entirely; on xl it is in the viewport at
             layout time and fetches straight away. -->
        <img
          src="/mockup.webp"
          alt="Teknoppy Performance Dashboard Mockups"
          width="1400"
          height="933"
          loading="lazy"
          decoding="async"
          class="w-full h-auto object-contain"
        />
      </div>

      <!-- Projects Delivered (Top Left of laptop) -->
      <div
        class="absolute top-[8%] left-[20%] w-[185px] bg-white rounded-2xl border border-neutral-100/70 p-3 z-20 hover:-translate-y-1 transition-all duration-300 anim-float-1 shadow-[0_12px_35px_rgba(240,90,44,0.04)] flex items-center gap-3"
      >
        <div
          class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"></path></svg
          >
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="text-[15px] font-extrabold text-neutral-900 leading-tight"
            >120+ Projects</span
          >
          <span
            class="text-[12px] text-neutral-500 font-semibold leading-none mt-0.5"
            >Delivered Globally</span
          >
        </div>
      </div>

      <!-- In-House Team Card (Left Center beside laptop) -->
      <div
        class="absolute top-[38%] left-[20%] w-[190px] bg-white rounded-2xl border border-neutral-100/70 p-3 z-20 hover:-translate-y-1 transition-all duration-300 anim-float-2 shadow-[0_12px_35px_rgba(240,90,44,0.04)] flex items-center gap-3"
      >
        <div
          class="w-9 h-9 rounded-full bg-amber-50 text-amber-500 flex items-center justify-center flex-shrink-0"
        >
          <svg
            class="w-4.5 h-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 20h5v-2a3 3 0 00-5.36-1.86M17 20H7m10 0v-2c0-.66-.13-1.3-.36-1.86m0 0A5 5 0 0012 15a5 5 0 00-4.64 3.14M7 20H2v-2a3 3 0 015.36-1.86M7 20v-2c0-.66.13-1.3.36-1.86m0 0a5 5 0 014.64-3.14M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            ></path></svg
          >
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="text-[15px] font-extrabold text-neutral-900 leading-tight"
            >In-House Team</span
          >
          <span
            class="text-[12px] text-neutral-500 font-semibold leading-none mt-0.5"
            >Design, Dev &amp; SEO</span
          >
        </div>
      </div>

      <!-- Location Card (Top Right beside laptop) -->
      <div
        class="absolute top-[1%] right-[2%] w-[185px] bg-white rounded-2xl border border-neutral-100/70 p-3 z-20 hover:-translate-y-1 transition-all duration-300 anim-float-3 shadow-[0_12px_35px_rgba(240,90,44,0.04)] flex items-center gap-3"
      >
        <div
          class="w-9 h-9 rounded-full bg-neutral-50 flex items-center justify-center flex-shrink-0 shadow-inner"
        >
          <svg
            class="w-4.5 h-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
            ></path></svg
          >
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="text-[15px] font-extrabold text-neutral-900 leading-tight"
            >Serving All of Kerala</span
          >
          <span
            class="text-[12px] text-neutral-500 font-semibold leading-none mt-0.5"
            >&amp; GCC Clients</span
          >
        </div>
      </div>

      <!-- Response Time Card (Bottom Right beside phone) -->
      <div
        class="absolute bottom-[22%] right-[2%] w-[195px] bg-white rounded-2xl border border-neutral-100/70 p-3 z-20 hover:-translate-y-1 transition-all duration-300 anim-float-4 shadow-[0_12px_35px_rgba(240,90,44,0.04)] flex items-center gap-3"
      >
        <div
          class="w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center flex-shrink-0"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path></svg
          >
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="text-[15px] font-extrabold text-neutral-900 leading-tight"
            >24-Hr Response</span
          >
          <span
            class="text-[12px] text-neutral-500 font-semibold leading-none mt-0.5"
            >IST, GST &amp; AST Hours</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  /* The back half of the hero paragraph is keyword-rich but long, and it was the
     single biggest block of copy above the fold. Collapsing it behind a toggle
     keeps the text in the DOM for crawlers while letting the CTAs and trust bar
     sit higher on the page.

     Deliberately inline (not a module) so it runs synchronously during parse:
     the collapse happens before the first paint, with no flash of the full
     paragraph. The markup therefore ships expanded with the button hidden —
     that way a visitor without JS reads the whole paragraph and never sees a
     toggle that cannot do anything. */
  (function () {
    var more = document.getElementById("hero-body-more");
    var btn = document.getElementById("hero-body-toggle");
    if (!more || !btn) return;

    var label = btn.querySelector(".hero-toggle-label");

    function setOpen(open) {
      more.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
      btn.classList.toggle("is-open", open);
      label.textContent = open ? btn.dataset.less : btn.dataset.more;
    }

    setOpen(false);
    btn.hidden = false;

    btn.addEventListener("click", function () {
      setOpen(btn.getAttribute("aria-expanded") !== "true");
    });
  })();
</script>

<style>
  /* Fluid typography and spacing */
  @media (min-width: 1280px) {
    .hero-copy {
      font-size: 16px;
      padding-top: 0;
    }

    .hero-h1 {
      font-size: 3.375em; /* 54px */
      margin-bottom: 0.37em; /* 20px */
    }
    .hero-h1 :global(span span) {
      padding-inline: 0.296em; /* 16px */
      padding-block: 0.037em; /* 2px */
      margin-top: 0.074em; /* 4px */
    }

    .hero-h2 {
      font-size: 1.375em; /* 22px */
      margin-bottom: 1.091em; /* 24px */
      max-width: 26.182em; /* 576px */
    }
    .hero-h2 :global(span) {
      padding-inline: 0.364em; /* 8px */
      padding-block: 0.091em; /* 2px */
    }

    .hero-body {
      font-size: 1.1875em; /* 19px */
      margin-bottom: 1.684em; /* 32px */
      max-width: 26.947em; /* 512px */
    }

    .hero-ctas {
      gap: 0.75em; /* 12px */
      margin-bottom: 0.5em; /* 8px */
    }
    .hero-ctas :global(> a) {
      font-size: 1.0625em; /* 17px */
      padding-block: 0.941em; /* 16px */
      padding-inline: 1.882em; /* 32px */
    }

    .hero-trust {
      margin-top: 1em; /* 16px */
      padding-top: 1.25em; /* 20px */
      max-width: 32em; /* 512px */
      row-gap: 1em; /* 16px */
      column-gap: 0.75em; /* 12px */
    }
    .hero-trust :global(span:first-child) {
      font-size: 1.5em; /* 24px */
    }
    .hero-trust :global(span:last-child) {
      font-size: 0.8125em; /* 13px */
      margin-top: 0.462em; /* 6px */
    }
  }

  .hero-body-toggle.is-open .hero-toggle-chevron {
    transform: rotate(180deg);
  }

  /* Custom Floating Callout Animations */
  .anim-float-1 {
    animation: float1 7s ease-in-out infinite;
  }
  .anim-float-2 {
    animation: float2 6s ease-in-out infinite;
  }
  .anim-float-3 {
    animation: float3 8s ease-in-out infinite;
  }
  .anim-float-4 {
    animation: float4 7.5s ease-in-out infinite;
  }

  @keyframes float1 {
    0%,
    100% {
      transform: translateY(0) rotate(-3deg);
    }
    50% {
      transform: translateY(-7px) rotate(-3deg);
    }
  }
  @keyframes float2 {
    0%,
    100% {
      transform: translateY(0) rotate(2deg);
    }
    50% {
      transform: translateY(-6px) rotate(2deg);
    }
  }
  @keyframes float3 {
    0%,
    100% {
      transform: translateY(0) rotate(1deg);
    }
    50% {
      transform: translateY(-7px) rotate(1deg);
    }
  }
  @keyframes float4 {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-6px) rotate(-2deg);
    }
  }
</style>
