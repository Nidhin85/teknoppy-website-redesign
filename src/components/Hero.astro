---
import { ArrowRight, Play, Globe2, Smile, Award, Star } from 'lucide-react';
---

<section class="relative pt-28 pb-20 md:pt-32 md:pb-20 overflow-hidden bg-gradient-to-br from-[#F96232] via-[#E55A2D] to-[#D44A1E]">
  <!-- Rich Decorative Background Layer -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
    <!-- Fine grid pattern texture -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_at_center,white,transparent_85%)]"></div>
    
    <!-- Glowing Orbs -->
    <div class="absolute -top-48 -right-48 w-[600px] h-[600px] rounded-full bg-secondary/30 blur-[130px] animate-[pulse_8s_infinite_alternate]"></div>
    <div class="absolute top-[30%] -left-48 w-[500px] h-[500px] rounded-full bg-black/10 blur-[120px]"></div>
    <div class="absolute -bottom-48 right-[10%] w-[500px] h-[500px] rounded-full bg-white/15 blur-[100px] animate-[pulse_6s_infinite_alternate_1s]"></div>

    <!-- Wavy SVGs with increased opacity and layout -->
    <svg class="absolute top-0 left-0 w-full h-full opacity-15" viewBox="0 0 1440 800" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-100 200C200 100 400 400 800 200C1200 0 1300 300 1600 100" stroke="white" stroke-width="3" stroke-linecap="round" />
      <path d="M-100 450C300 250 500 550 900 350C1300 150 1400 450 1600 250" stroke="white" stroke-width="1.5" stroke-dasharray="8 8" stroke-linecap="round" />
    </svg>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 grid xl:grid-cols-2 gap-12 xl:gap-8 items-center relative z-10">
    
    <!-- Content (Left Column) -->
    <div class="flex flex-col items-center text-center xl:items-start xl:text-left pt-4">
      

      
      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-[60px] font-black leading-[1.15] tracking-tight text-white mb-5">
        Built to <span class="inline-block bg-white text-primary px-4 py-0.5 rounded-[1.5rem] transform -rotate-2 mt-1 shadow-xl">Rank.</span> <br />
        Designed to <span class="inline-block bg-black text-white px-4 py-0.5 rounded-[1.5rem] transform rotate-1 mt-1 shadow-xl">Convert.</span> <br />
        Engineered to <span class="inline-block bg-white text-primary px-4 py-0.5 rounded-[1.5rem] transform -rotate-1 mt-1 shadow-xl">Grow.</span>
      </h1>

      <p class="text-base md:text-lg text-white/90 mb-8 max-w-lg mx-auto xl:mx-0 leading-relaxed font-medium">
        We create SEO-driven websites that help Kerala businesses increase visibility, generate qualified leads, and achieve measurable growth.
      </p>

      <!-- Primary Action Area -->
      <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto mb-6">
        <a href="#consultation" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-[#111] rounded-full shadow-[0_6px_20px_rgba(0,0,0,0.3)] hover:shadow-[0_6px_20px_rgba(0,0,0,0.5)] hover:-translate-y-0.5 transition-all duration-300">
          Book a Free Consultation
          <ArrowRight className="w-4 h-4" />
        </a>
        <a href="#portfolio" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-transparent border border-white/30 rounded-full hover:border-white hover:bg-white/10 transition-all duration-300">
          <span class="flex items-center justify-center w-6 h-6 rounded-full border border-white text-white">
            <Play className="w-2.5 h-2.5 fill-current ml-0.5" />
          </span>
          View Our Portfolio
        </a>
      </div>

      <!-- Redesigned Grid Stats (Fixed wrapping and cropping on mobile) -->
      <div class="grid grid-cols-3 gap-2 sm:gap-6 mt-6 pt-6 border-t border-white/10 w-full">
        
        <!-- Websites -->
        <div class="flex flex-col items-center xl:items-start">
          <div class="flex items-center gap-1.5 text-white/80">
            <Globe2 className="w-4 h-4" />
            <span class="text-base sm:text-lg font-black text-white">150+</span>
          </div>
          <p class="text-[10px] sm:text-xs text-white/70 font-semibold mt-1 leading-tight">Websites Delivered</p>
        </div>
        
        <!-- Clients -->
        <div class="flex flex-col items-center xl:items-start border-l border-white/10 pl-3 sm:pl-6">
          <div class="flex items-center gap-1.5 text-white/80">
            <Smile className="w-4 h-4" />
            <span class="text-base sm:text-lg font-black text-white">100+</span>
          </div>
          <p class="text-[10px] sm:text-xs text-white/70 font-semibold mt-1 leading-tight">Happy Clients</p>
        </div>

        <!-- Experience -->
        <div class="flex flex-col items-center xl:items-start border-l border-white/10 pl-3 sm:pl-6">
          <div class="flex items-center gap-1.5 text-white/80">
            <Award className="w-4 h-4" />
            <span class="text-base sm:text-lg font-black text-white">8 Years</span>
          </div>
          <p class="text-[10px] sm:text-xs text-white/70 font-semibold mt-1 leading-tight">Experience</p>
        </div>

      </div>
    </div>

    <!-- Visual Presentation (Mockups based on the image) -->
    <div class="relative w-full h-[550px] hidden xl:block mt-6">
      
      <!-- Central Background Glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-white/20 rounded-full blur-[60px] -z-10"></div>

      <!-- Main Desktop Mockup (Bright screen, light border to pop against orange) -->
      <div class="absolute top-[12%] left-[8%] w-[580px] h-[350px] transform -rotate-2 z-10 animate-[float_6s_ease-in-out_infinite]">
        <!-- Screen -->
        <div class="w-full h-full bg-white rounded-t-xl rounded-b-sm shadow-[0_20px_50px_rgba(0,0,0,0.2)] border-2 border-white overflow-hidden relative flex flex-col">
          <!-- Browser Header -->
          <div class="h-8 bg-gray-50 border-b border-gray-200 flex items-center px-3 justify-between">
            <div class="flex gap-1.5">
              <div class="w-2 h-2 rounded-full bg-red-500"></div>
              <div class="w-2 h-2 rounded-full bg-yellow-400"></div>
              <div class="w-2 h-2 rounded-full bg-green-500"></div>
            </div>
            <div class="flex gap-3 text-[9px] font-bold text-gray-500 uppercase">
              <span>Home</span>
              <span>About</span>
              <span>Services</span>
              <span>Portfolio</span>
              <span>Contact</span>
            </div>
            <div class="px-2 py-0.5 bg-black text-white text-[9px] rounded-full font-bold">Get In Touch</div>
          </div>
          <!-- Fake Inner Content -->
          <div class="p-6 flex-grow relative bg-white">
            <h3 class="text-2xl font-black text-black leading-tight mb-3">
              Digital Solutions <br /> That <span class="text-primary">Drive Results</span>
            </h3>
            <p class="text-[10px] text-gray-500 max-w-[240px] mb-5">
              We build fast, SEO-optimized websites that rank higher and convert better.
            </p>
            <div class="flex gap-2">
              <div class="px-3 py-1.5 bg-primary text-white text-[10px] font-bold rounded-full">Start Your Project →</div>
              <div class="px-3 py-1.5 border border-gray-200 bg-white text-black text-[10px] font-bold rounded-full flex items-center gap-1"><Play className="w-2.5 h-2.5"/> Explore Work</div>
            </div>
          </div>
        </div>
        <!-- Laptop Base -->
        <div class="w-[110%] h-3 bg-gray-200 rounded-b-lg -ml-[5%] relative shadow-2xl">
           <div class="absolute top-0 left-1/2 -translate-x-1/2 w-20 h-1 bg-gray-300 rounded-b-sm"></div>
        </div>
      </div>

      <!-- Mobile Phone Mockup -->
      <div class="absolute bottom-[2%] right-[5%] w-[170px] h-[360px] bg-white rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.2)] border-[6px] border-black transform rotate-6 z-20 overflow-hidden">
        <!-- Dynamic Island -->
        <div class="absolute top-1.5 left-1/2 -translate-x-1/2 w-14 h-4 bg-black rounded-full z-30"></div>
        <!-- Phone Content -->
        <div class="w-full h-full bg-white flex flex-col pt-8 px-3">
          <div class="text-[9px] font-black mb-3 text-black">TEKNOPPY</div>
          <h4 class="text-base font-black leading-tight mb-2 text-black">Results-Driven Websites for <span class="text-primary">Growing</span> Businesses</h4>
          <p class="text-[7px] text-gray-500 mb-4">We help businesses attract the right audience, generate leads and scale online.</p>
          <div class="px-3 py-1.5 bg-black text-white text-[9px] font-bold rounded-full w-max mb-5">Get a Free Audit →</div>
          <div class="text-[9px] font-bold mb-2 text-black">Our Services</div>
          <div class="grid grid-cols-2 gap-1.5">
             <div class="h-10 bg-gray-50 rounded border border-gray-100"></div>
             <div class="h-10 bg-gray-50 rounded border border-gray-100"></div>
          </div>
        </div>
      </div>

      <!-- Floating Stat Card 1: Leads Generated (Bright styling to contrast orange) -->
      <div class="absolute top-[40%] -left-[2%] w-[150px] bg-white rounded-xl shadow-[0_15px_40px_rgba(0,0,0,0.15)] border border-gray-100 p-3 z-30 transform -rotate-3 animate-[float_5s_ease-in-out_infinite_reverse]">
        <div class="flex justify-between items-start mb-1.5">
          <p class="text-[9px] font-bold text-black">Leads Generated</p>
          <div class="w-3.5 h-3.5 rounded-full bg-green-100 flex items-center justify-center">
            <ArrowRight className="w-2 h-2 text-green-500 -rotate-45" />
          </div>
        </div>
        <p class="text-lg font-black text-black">+182%</p>
        <p class="text-[7px] text-gray-500 mb-2">vs last 6 months</p>
        <!-- Bar chart -->
        <div class="flex items-end gap-1 h-6">
          <div class="w-full bg-[#F8B342]/30 rounded-t-sm h-[30%]"></div>
          <div class="w-full bg-[#F8B342]/50 rounded-t-sm h-[50%]"></div>
          <div class="w-full bg-[#F8B342]/70 rounded-t-sm h-[65%]"></div>
          <div class="w-full bg-primary/80 rounded-t-sm h-[80%]"></div>
          <div class="w-full bg-primary rounded-t-sm h-[100%]"></div>
        </div>
      </div>

      <!-- Floating Stat Card 2: Website Traffic -->
      <div class="absolute top-[8%] right-[22%] w-[140px] bg-white rounded-xl shadow-[0_15px_40px_rgba(0,0,0,0.15)] border border-gray-100 p-3 z-0 transform rotate-2 animate-[float_7s_ease-in-out_infinite]">
        <div class="flex justify-between items-start mb-1.5">
          <p class="text-[9px] font-bold text-black">Website Traffic</p>
          <div class="w-3.5 h-3.5 rounded-full bg-green-100 flex items-center justify-center">
            <ArrowRight className="w-2 h-2 text-green-500 -rotate-45" />
          </div>
        </div>
        <p class="text-lg font-black text-black">+156%</p>
        <p class="text-[7px] text-gray-500 mb-2">vs last 3 months</p>
        <!-- Line chart simple SVG -->
        <svg class="w-full h-6" viewBox="0 0 100 30" preserveAspectRatio="none">
          <path d="M0,30 L10,25 L30,28 L50,15 L70,20 L90,5 L100,0" fill="none" stroke="#F96232" stroke-width="2" />
          <path d="M0,30 L10,25 L30,28 L50,15 L70,20 L90,5 L100,0 L100,30 L0,30 Z" fill="url(#grad1_light)" opacity="0.15" />
          <defs>
            <linearGradient id="grad1_light" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:#F96232;stop-opacity:1" />
              <stop offset="100%" style="stop-color:#F96232;stop-opacity:0" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Floating Stat Card 3: Google Rankings -->
      <div class="absolute top-[28%] -right-[2%] w-[140px] bg-white rounded-xl shadow-[0_15px_40px_rgba(0,0,0,0.15)] border border-gray-100 p-3 z-0 transform rotate-3 animate-[float_6s_ease-in-out_infinite_1s]">
        <div class="flex justify-between items-start mb-1.5">
          <p class="text-[9px] font-bold text-black">Google Rankings</p>
          <div class="w-3.5 h-3.5 rounded-full bg-green-100 flex items-center justify-center">
            <ArrowRight className="w-2 h-2 text-green-500 -rotate-45" />
          </div>
        </div>
        <p class="text-lg font-black text-black">+248%</p>
        <p class="text-[7px] text-gray-500 mb-2">vs last 6 months</p>
        <!-- Line chart simple SVG -->
        <svg class="w-full h-6" viewBox="0 0 100 30" preserveAspectRatio="none">
          <path d="M0,30 L20,20 L40,25 L60,10 L80,15 L100,0" fill="none" stroke="#F96232" stroke-width="2" />
          <path d="M0,30 L20,20 L40,25 L60,10 L80,15 L100,0 L100,30 L0,30 Z" fill="url(#grad2_light)" opacity="0.15" />
          <defs>
            <linearGradient id="grad2_light" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:#F96232;stop-opacity:1" />
              <stop offset="100%" style="stop-color:#F96232;stop-opacity:0" />
            </linear.Gradient>
          </defs>
        </svg>
      </div>

      <!-- Floating Stat Card 4: PageSpeed -->
      <div class="absolute bottom-[5%] right-[32%] w-[160px] bg-white rounded-full shadow-[0_15px_40px_rgba(0,0,0,0.15)] border border-gray-100 p-2 px-4 z-30 transform -rotate-2 flex items-center gap-3 animate-[float_4s_ease-in-out_infinite]">
        <div class="w-8 h-8 rounded-full border-[3px] border-green-500 flex items-center justify-center text-[10px] font-bold text-green-600">
          98
        </div>
        <div>
          <p class="text-[9px] font-bold text-black">PageSpeed Score</p>
          <p class="text-xs font-black text-green-500">98/100</p>
        </div>
      </div>

    </div>
  </div>
</section>
