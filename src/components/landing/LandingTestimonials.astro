---
// Client video testimonials — YouTube thumbnail facades, player loads on tap.
import { WA } from './shared';

interface Props {
  sub: string;
  cta: string;
  wa: string;
  ml?: string;
}

const { sub, cta, wa, ml } = Astro.props;

// `thumb` is a YouTube thumbnail name, or a local path starting with "/".
// Lenaa's testimonial is a 9:16 Short, and YouTube builds its 16:9 thumbnail by
// padding the portrait frame with darkened, mirrored copies of itself — it reads
// as a rendering fault next to the three landscape cards. Use the same hand
// cropped still the homepage uses (public/testimonials/lenaa.webp) and pull the
// focal point up, or a centre crop of a 404x720 portrait lands on her necklace.
const videos = [
  { id: 'T6Vzf4ZhCYk', title: 'Lena shares her Teknoppy experience', thumb: '/testimonials/lenaa.webp', pos: 'center 22%', w: 404, h: 720 },
  { id: 'E7HfgGOHjYE', title: 'What our valued customers say about our services', thumb: 'maxresdefault' },
  { id: 'ocV7KcfU9vs', title: 'Client testimonial — Teknoppy', thumb: 'maxresdefault' },
  { id: '-N_zd4eCPPM', title: 'Client testimonial — Teknoppy', thumb: 'hqdefault' }
];
---

<!-- ══════════ TESTIMONIALS ══════════ -->
<section class="testimonials">
  <div class="wrap">
    <h2 class="sec-title">Hear It From Our Clients</h2>
    <p class:list={['sec-sub', ml]}>{sub}</p>

    <div class="carousel" data-carousel>
      <div class="carousel__track" data-track>
        {videos.map(({ id, title, thumb, pos, w, h }) => {
          const local = thumb.startsWith('/');
          return (
            <article class="vcard" data-yt={id} data-title={title}>
              <img class="vcard__thumb" src={local ? thumb : `https://i.ytimg.com/vi/${id}/${thumb}.jpg`}
                   style={pos ? `object-position:${pos}` : undefined}
                   onerror={local ? undefined : `this.onerror=null;this.src='https://i.ytimg.com/vi/${id}/hqdefault.jpg'`}
                   alt={title} loading="lazy" decoding="async" width={w ?? 480} height={h ?? 360}>
              <button class="vcard__play" type="button" aria-label={`Play video: ${title}`}></button>
            </article>
          );
        })}
      </div>
      <button class="cnav cnav--prev" data-prev aria-label="Previous">‹</button>
      <button class="cnav cnav--next" data-next aria-label="Next">›</button>
      <div class="dots" data-dots></div>
    </div>

    <div class="center">
      <a href={wa} class="btn btn--outline">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={WA}/></svg>
        {cta}
      </a>
    </div>
  </div>
</section>
