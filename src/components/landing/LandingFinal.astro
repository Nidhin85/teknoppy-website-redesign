---
import { site, WA, PHONE, CLIP } from './shared';

interface Props {
  title: string;
  text: string;
  pills: string[];
  /** Label of the button that scrolls to the form, e.g. "Book Free SEO Audit" */
  formCta: string;
  wa: string;
  ml?: string;
}

const { title, text, pills, formCta, wa, ml } = Astro.props;
---

<!-- ══════════ FINAL CTA ══════════ -->
<section class="final" id="cta">
  <div class="wrap final__inner">
    <div class="final__copy">
      <h2 class={ml}>{title}</h2>
      <p class={ml}>{text}</p>
      <ul class="final__pills">
        {pills.map((p) => <li>{p}</li>)}
      </ul>
      <div class="final__cta">
        <a href={wa} class="btn btn--wa">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={WA}/></svg>
          WhatsApp Now
        </a>
        <a href="#contact" class="btn btn--light">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={CLIP}/></svg>
          {formCta}
        </a>
        <a href={`mailto:${site.email}`} class="btn btn--light">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={PHONE}/></svg>
          Request a Proposal
        </a>
      </div>
    </div>
    <div class="final__art" aria-hidden="true">
      <svg viewBox="0 0 120 120">
        <circle cx="60" cy="60" r="52" fill="#fff"/>
        <circle cx="60" cy="60" r="42" fill="#E23B2E"/>
        <circle cx="60" cy="60" r="32" fill="#fff"/>
        <circle cx="60" cy="60" r="22" fill="#E23B2E"/>
        <circle cx="60" cy="60" r="11" fill="#fff"/>
        <circle cx="60" cy="60" r="5" fill="#E23B2E"/>
        <path d="M60 60l44-42" stroke="#3A3A3A" stroke-width="6" stroke-linecap="round"/>
        <path d="M96 10l16 2-2 16z" fill="#F5A623"/>
      </svg>
    </div>
  </div>
</section>
