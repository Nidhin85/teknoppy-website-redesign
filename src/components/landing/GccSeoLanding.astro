---

<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F26522">
<meta name="color-scheme" content="light">
<!-- Paid-traffic page: keep it out of organic search so it doesn't compete with
     /seo-services/ and organic visits don't muddy the Ads conversion data. -->
<meta name="robots" content="noindex, follow">
<title>{copy.title}</title>
<meta name="description" content={copy.description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={copy.title}>
<meta property="og:description" content={copy.description}>
<meta property="og:image" content={ogImage}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preload" as="image" href="/logo.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- non-blocking font load: text paints in the fallback stack immediately -->
<link rel="stylesheet" href={fonts} media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href={fonts}></noscript>

{adsId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${adsId}`}></script>
    <script is:inline define:vars={{ adsId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', adsId);
    </script>
  </>
)}

<style is:inline>
/* ═══════════════════════════════════════════
   TEKNOPPY — mobile-first stylesheet
   Base = phone. Breakpoints scale up: 700 / 1000 / 1200
   ═══════════════════════════════════════════ */

:root{
  --orange:#F26522;
  --orange-d:#E0530F;
  --orange-l:#FF8A3D;
  --orange-tint:#FFF3EC;
  --wa:#25D366;
  --wa-d:#1EBE5A;
  --green:#2FA85A;
  --red:#E23B2E;
  --ink:#1C1C1C;
  --ink-2:#3D3D3D;
  --muted:#6B6B6B;
  --line:#EFE3DA;
  --line-2:#E9E9E9;
  --bg:#FFFFFF;
  --bg-soft:#FFF8F4;
  --dark:#141414;
  --r:14px;
  --shadow:0 4px 18px rgba(200,110,60,.10);
  --shadow-lg:0 12px 36px rgba(180,90,40,.15);
  --wrap:1180px;
  --bar-h:62px;
}

*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:80px}

a,button,summary,label,input{
  touch-action:manipulation;
  -webkit-tap-highlight-color:rgba(242,101,34,.12);
}

body{
  margin:0;
  font-family:"Manrope",system-ui,-apple-system,"Segoe UI",sans-serif;
  font-size:16px;
  line-height:1.55;
  color:var(--ink);
  background:var(--bg);
  overflow-x:hidden;
  padding-bottom:calc(var(--bar-h) + env(safe-area-inset-bottom));
}

img,svg,video{display:block;max-width:100%}
[hidden]{display:none !important}
a{color:inherit;text-decoration:none}
ul,ol{margin:0;padding:0;list-style:none}
h1,h2,h3,h4{margin:0;line-height:1.25;font-weight:800}
p{margin:0}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
table{border-collapse:collapse;width:100%}

.wrap{width:100%;max-width:var(--wrap);margin-inline:auto;padding-inline:18px}
.center{text-align:center;display:flex;justify-content:center}
.ml{font-family:"Noto Sans Malayalam","Manrope",sans-serif;line-height:1.7}
section{padding-block:26px}

.sec-title{
  text-align:center;color:var(--orange);
  font-size:clamp(20px,5.4vw,27px);font-weight:800;line-height:1.35;text-wrap:balance;
}
.sec-sub{text-align:center;color:var(--ink-2);font-size:14px;margin-top:8px;text-wrap:balance}
.br-m{display:inline}

/* ── buttons ─────────────────────────────── */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  padding:14px 24px;border-radius:10px;border:2px solid transparent;
  font-size:15px;font-weight:700;line-height:1.2;text-align:center;
  transition:transform .18s,box-shadow .18s,background .18s,color .18s;
  width:100%;max-width:420px;
}
.btn:active{transform:translateY(1px)}
.btn .ico{width:19px;height:19px;flex:none}
.btn--sm{padding:12px 20px;font-size:14px}

.btn--wa{background:var(--wa);color:#fff;box-shadow:0 4px 14px rgba(37,211,102,.3)}
.btn--primary{background:var(--orange);color:#fff;box-shadow:0 4px 14px rgba(242,101,34,.3)}
.btn--ghost{background:#fff;color:var(--ink);border-color:var(--orange);box-shadow:var(--shadow)}
.btn--ghost .ico{color:var(--orange)}
.btn--outline{background:#fff;color:var(--orange);border-color:var(--orange)}
.btn--light{background:#fff;color:var(--orange)}

@media (hover:hover){
  .btn:hover{transform:translateY(-2px)}
  .btn--wa:hover{background:var(--wa-d)}
  .btn--primary:hover{background:var(--orange-d)}
  .btn--ghost:hover{background:var(--orange-tint)}
  .btn--outline:hover{background:var(--orange);color:#fff}
  .btn--light:hover{background:var(--orange-tint)}
}

.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow)}

/* ═══════════ HEADER ═══════════ */
.header{
  position:sticky;top:0;z-index:60;
  background:rgba(255,255,255,.96);
  backdrop-filter:saturate(180%) blur(10px);
  border-bottom:1px solid var(--line);
}
.header__inner{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:64px}
.logo{display:flex;align-items:center;min-height:44px}
.logo__svg{height:36px;width:auto;aspect-ratio:220/62}

.nav-toggle{
  width:44px;height:44px;padding:8px;flex:none;
  display:flex;flex-direction:column;justify-content:center;gap:5px;
}
.nav-toggle span{display:block;height:3px;border-radius:3px;background:var(--ink);transition:transform .25s,opacity .2s}
.nav-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(8px) rotate(45deg)}
.nav-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}
.nav-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-8px) rotate(-45deg)}

.nav{
  position:absolute;top:100%;left:0;right:0;
  display:none;flex-direction:column;
  background:#fff;border-bottom:1px solid var(--line);box-shadow:var(--shadow);
  padding:6px 18px 16px;font-weight:600;font-size:15px;
}
.nav.is-open{display:flex}
.nav a{padding:13px 2px;border-bottom:1px solid var(--line);color:var(--ink-2)}
.nav__cta{
  margin-top:12px;background:var(--orange);color:#fff !important;
  border-bottom:0 !important;border-radius:8px;text-align:center;padding:12px !important;
}

/* ═══════════ HERO ═══════════ */
.hero{position:relative;overflow:hidden;padding-block:26px 30px}
.blob{position:absolute;border-radius:50%;pointer-events:none;z-index:0}
.blob--1{
  width:min(520px,120vw);aspect-ratio:1;right:-30vw;top:-24vw;
  background:radial-gradient(circle at 40% 40%,#FFE9DC,#FFF6F1 60%,transparent 72%);
}
.blob--2{
  width:min(340px,80vw);aspect-ratio:1;right:-10vw;bottom:-30vw;
  background:radial-gradient(circle,#FFF1E7,transparent 70%);
}
.hero__inner{position:relative;z-index:1;display:grid;gap:24px}
.hero__copy{display:flex;flex-direction:column;align-items:center;text-align:center}

.pill{
  display:inline-block;padding:7px 16px;border:1px solid #F6C7AC;border-radius:999px;
  background:var(--orange-tint);color:var(--orange);
  font-size:11.5px;font-weight:800;letter-spacing:.6px;line-height:1.3;margin-bottom:14px;
}
.hero__title{
  font-size:clamp(27px,7.6vw,34px);font-weight:800;color:var(--orange);
  letter-spacing:-.3px;line-height:1.4;text-wrap:balance;
}
.hero__sub{margin-top:12px;font-size:clamp(16px,4.2vw,19px);font-weight:800;text-wrap:balance}
.hero__lead{margin-top:14px;font-size:15px;font-weight:600;line-height:1.7;text-wrap:balance;color:var(--ink-2)}
.hero__lead .ml{color:var(--orange-d)}

.flags{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10px 8px;margin-top:18px;width:100%;max-width:340px;
  font-size:13px;font-weight:600;color:var(--ink-2);
}
.flags li{display:flex;align-items:center;justify-content:center;gap:6px}
.flags .flag{font-size:16px;line-height:1}

.ticks{display:grid;gap:11px;margin-top:20px;width:100%;max-width:340px;text-align:left}
.ticks li{position:relative;padding-left:29px;font-size:14.5px;font-weight:600;color:var(--ink-2)}
.ticks li::before{
  content:"";position:absolute;left:0;top:3px;
  width:19px;height:19px;border-radius:50%;background:var(--orange);
}
.ticks li::after{
  content:"";position:absolute;left:5px;top:8px;width:9px;height:5px;
  border-left:2.2px solid #fff;border-bottom:2.2px solid #fff;transform:rotate(-45deg);
}

.hero__cta{display:flex;flex-direction:column;align-items:center;gap:12px;margin-top:24px;width:100%}
.rating{
  display:flex;align-items:center;justify-content:center;flex-wrap:wrap;
  gap:7px;margin-top:20px;font-size:13.5px;color:var(--muted);
}
.g-ico{width:19px;height:19px;flex:none}
.rating b{color:var(--ink);font-weight:800}
.stars{color:#FBBC05;letter-spacing:2px;font-size:15px}
.rating__by b{color:var(--orange)}

.hero__art{display:none}
.art{width:100%;max-width:300px}
.art__t{font-family:"Manrope",sans-serif;font-weight:800;font-size:34px;fill:var(--orange)}

/* ═══════════ STATS ═══════════ */
.stats{padding-block:8px 26px}
.stats__title{text-align:center;color:var(--orange);font-size:15px;font-weight:800;margin-bottom:16px}
.stats__grid{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px 6px;
  background:#fff;border:1px solid var(--line);border-radius:var(--r);
  box-shadow:var(--shadow);padding:22px 12px;
}
.stat{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px}
.stat__ic{width:28px;height:28px;color:var(--orange)}
.stat b{font-size:20px;font-weight:800;line-height:1.1}
.stat span{font-size:11.5px;font-weight:600;color:var(--muted);line-height:1.35}
.stat--wide{grid-column:1/-1}

/* ═══════════ ORANGE BAND ═══════════ */
.band{padding-block:8px 26px}
.band__inner{
  display:grid;gap:18px;justify-items:center;text-align:center;
  background:linear-gradient(150deg,var(--orange) 0%,#F4762E 55%,#F5843F 100%);
  color:#fff;border-radius:var(--r);padding:26px 20px;box-shadow:var(--shadow-lg);
}
.band__globe{
  width:70px;height:70px;flex:none;border-radius:50%;
  background:rgba(255,255,255,.16);display:grid;place-items:center;
}
.band__globe svg{width:46px;height:46px;color:#fff}
.band__copy h2{font-size:clamp(19px,5.2vw,25px);line-height:1.4}
.band__copy p{margin-top:10px;font-size:13.5px;opacity:.95}
.band__list{display:grid;gap:12px;justify-items:start;text-align:left;width:100%;max-width:340px}
.band__list li{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:700}
.band__list .ico{width:24px;height:24px;flex:none;padding:4px;border-radius:50%;background:#fff;color:var(--orange)}

/* ═══════════ TRUSTED LOGOS ═══════════ */
.trusted{padding-block:8px 26px}
.trusted__title{
  text-align:center;color:var(--orange);font-size:clamp(15px,4.2vw,18px);
  font-weight:800;margin-bottom:18px;line-height:1.45;
}
.logos{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 16px;
  align-items:center;justify-items:center;
  background:#fff;border:1px solid var(--line);border-radius:var(--r);
  box-shadow:var(--shadow);padding:26px 18px;
}
.logo-card{
  display:flex;align-items:center;justify-content:center;gap:7px;
  min-height:46px;filter:grayscale(.2);transition:filter .2s,transform .2s;
}
.logo-card__ic{width:38px;height:38px;flex:none}
.lg{display:flex;flex-direction:column;align-items:center;line-height:1.15;text-align:center}
.lg b{font-size:15px;font-weight:800;letter-spacing:-.2px}
.lg i{font-style:normal;font-size:11px;font-weight:700;letter-spacing:1.1px;color:var(--muted);margin-top:3px}
.lg--gt b{color:#2B2B2B;font-size:16px}
.lg--gt b em{font-style:normal;color:#F26522}
.lg--er b{color:#1F3864;font-size:13px;letter-spacing:.6px}
.lg--er i{color:#F26522}
.lg--leema b{color:#1F5FA8;font-size:15px;letter-spacing:1.4px}
.lg--leema i{color:#1F5FA8;letter-spacing:.2px;font-size:11px}
.lg--cw b{color:#2B2B2B;font-size:13px;letter-spacing:.4px}
.lg--cw i{color:#E1251B;letter-spacing:.8px}
@media (hover:hover){.logo-card:hover{filter:none;transform:translateY(-2px)}}

/* ═══════════ CAROUSEL (shared) ═══════════ */
.carousel{position:relative;margin-top:20px}
.carousel__track{
  display:grid;grid-auto-flow:column;grid-auto-columns:100%;gap:14px;
  overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;
  -webkit-overflow-scrolling:touch;padding-bottom:4px;
}
.carousel__track::-webkit-scrollbar{display:none}
.carousel__track > *{scroll-snap-align:center}

.cnav{
  position:absolute;top:calc(50% - 12px);transform:translateY(-50%);
  width:42px;height:42px;border-radius:50%;
  border:1px solid var(--line);background:#fff;font-size:22px;line-height:1;
  display:grid;place-items:center;box-shadow:var(--shadow);z-index:3;
}
.cnav--prev{left:-6px}
.cnav--next{right:-6px}
@media (hover:hover){.cnav:hover{background:var(--orange);color:#fff;border-color:var(--orange)}}

.dots{display:flex;justify-content:center;gap:0;margin-top:4px}
.dots button{
  width:36px;height:36px;border-radius:50%;display:grid;place-items:center;
  -webkit-tap-highlight-color:transparent;
}
.dots button::before{
  content:"";width:7px;height:7px;border-radius:50%;background:#D9D9D9;
  transition:background .2s,width .2s;
}
.dots button[aria-current="true"]::before{background:var(--orange);width:20px;border-radius:4px}

/* ═══════════ TESTIMONIALS ═══════════ */
.vcard{
  position:relative;aspect-ratio:16/11;border-radius:12px;overflow:hidden;
  background:#111;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,.14);
}
.vcard__thumb{width:100%;height:100%;object-fit:cover;transition:transform .3s ease,filter .2s ease}
.vcard__play{
  position:absolute;inset:0;margin:auto;z-index:2;
  width:54px;height:54px;border-radius:50%;background:rgba(255,255,255,.92);
  display:grid;place-items:center;transition:transform .2s ease,background .2s ease;
}
.vcard__play::after{
  content:"";width:0;height:0;margin-left:4px;
  border-left:16px solid var(--ink);
  border-top:10px solid transparent;border-bottom:10px solid transparent;
}
.vcard iframe{position:absolute;inset:0;width:100%;height:100%;border:0;z-index:3}
.vcard.is-playing{cursor:default}
@media (hover:hover){
  .vcard:hover .vcard__thumb{transform:scale(1.04);filter:brightness(.92)}
  .vcard:hover .vcard__play{transform:scale(1.08);background:#fff}
}
.testimonials .center{margin-top:20px}

/* ═══════════ PROBLEMS ═══════════ */
.problem-list{display:grid;gap:10px;margin-top:18px}
.problem{
  display:flex;align-items:center;gap:13px;
  background:#fff;border:1px solid var(--line-2);border-radius:12px;
  padding:15px 16px;box-shadow:0 2px 10px rgba(0,0,0,.04);
}
.problem__x{width:26px;height:26px;flex:none;border-radius:50%;background:var(--red);position:relative}
.problem__x::before,.problem__x::after{
  content:"";position:absolute;inset:0;margin:auto;
  width:12px;height:2.2px;background:#fff;border-radius:2px;
}
.problem__x::before{transform:rotate(45deg)}
.problem__x::after{transform:rotate(-45deg)}
.problem__t{display:flex;flex-direction:column;font-size:13.5px;color:var(--muted);line-height:1.6}
.problem__t b{color:var(--ink);font-weight:700}

.problems__solve{
  text-align:center;margin:26px 0 18px;
  font-size:clamp(17px,4.6vw,21px);font-weight:800;color:var(--ink-2);text-wrap:balance;
}

/* ═══════════ WHY CHOOSE ═══════════ */
.why__card{
  background:var(--bg-soft);border:1px solid var(--line);
  border-radius:var(--r);padding:26px 20px;box-shadow:var(--shadow);
}
.why__list{display:grid;gap:15px;margin:20px 0}
.why__list li{display:flex;align-items:center;gap:14px}
.why__list svg{width:32px;height:32px;flex:none;color:var(--orange)}
.why__list span{font-size:13.5px;font-weight:700;color:var(--ink-2);line-height:1.45}

/* ═══════════ RESULTS ═══════════ */
.results__card{
  background:var(--dark);color:#fff;border-radius:var(--r);
  padding:22px 16px;box-shadow:var(--shadow-lg);
  display:grid;grid-template-columns:minmax(0,1fr);gap:20px;
}
.results__left{min-width:0}
.results__title{color:var(--orange);font-size:clamp(19px,5vw,25px);margin-bottom:16px}
.table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-inline:-4px;padding-inline:4px;min-width:0;max-width:100%}
.rtable{font-size:12.5px;min-width:430px}
.rtable th{
  text-align:left;padding:0 10px 11px 0;font-size:11px;font-weight:800;letter-spacing:.6px;
  color:#9A9A9A;text-transform:uppercase;white-space:nowrap;
}
.rtable th:nth-child(3),.rtable th:nth-child(4),
.rtable td:nth-child(3),.rtable td:nth-child(4){text-align:center}
.rtable td{
  padding:13px 10px 13px 0;border-top:1px solid rgba(255,255,255,.1);
  color:#DCDCDC;vertical-align:middle;line-height:1.35;
}
.rtable .pos{color:var(--orange);font-weight:800;font-size:16px;white-space:nowrap}
.rtable .grow{color:#3DD37E;font-weight:800;font-size:13.5px;white-space:nowrap}
.rtable .up{font-size:10px}
.results__btn{margin-top:18px}

.serp{background:#fff;border-radius:12px;padding:14px;color:var(--ink);box-shadow:0 8px 26px rgba(0,0,0,.3)}
.serp__bar{display:flex;align-items:center;gap:9px;border:1px solid #E3E3E3;border-radius:22px;padding:8px 14px}
.serp__g{width:17px;height:17px;flex:none}
.serp__mic{width:16px;height:16px;flex:none}
.serp__q{flex:1;font-size:12.5px;color:#3C4043;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.serp__result{margin-top:16px}
.serp__site{display:flex;align-items:center;gap:9px}
.serp__fav{
  width:26px;height:26px;border-radius:50%;flex:none;
  background:#EDEDED;color:#5F6368;font-size:13px;font-weight:800;display:grid;place-items:center;
}
.serp__site b{font-size:12.5px;font-weight:700;color:#202124;display:block;line-height:1.25}
.serp__site small{font-size:11px;color:#5F6368}
.serp__link{margin-top:11px;font-size:15px;font-weight:500;color:#1A0DAB;line-height:1.32}
.serp__desc{margin-top:7px;font-size:12px;color:#4D5156;line-height:1.55}

/* ═══════════ CASE STUDY ═══════════ */
.case__grid{display:grid;gap:12px;margin:18px 0}
.case__box{border-radius:12px;padding:16px 16px 18px;border:1px solid var(--line-2)}
.case__box--before{background:#FFF5F4;border-color:#F8DAD7}
.case__box--after{background:#F3FBF5;border-color:#CFEBD9}
.case__badge{
  display:inline-block;padding:5px 14px;border-radius:7px;
  font-size:11.5px;font-weight:800;color:#fff;margin-bottom:13px;
}
.case__badge--red{background:var(--red)}
.case__badge--green{background:var(--green)}
.case__list{display:grid;gap:10px}
.case__list li{position:relative;padding-left:26px;font-size:13.5px;font-weight:600;color:var(--ink-2);line-height:1.5}
.case__list--x li::before{content:"✕";position:absolute;left:2px;top:0;color:var(--red);font-weight:800;font-size:13px}
.case__list--check li::before{content:"✓";position:absolute;left:2px;top:0;color:var(--green);font-weight:800;font-size:14px}

/* ═══════════ PROCESS ═══════════ */
.steps{display:grid;gap:10px;margin:20px 0}
.step{
  display:flex;align-items:center;gap:14px;
  background:#fff;border:1px solid var(--line-2);border-radius:12px;
  padding:13px 16px;box-shadow:0 2px 10px rgba(0,0,0,.04);
}
.step__n{
  width:34px;height:34px;flex:none;border-radius:50%;
  background:var(--orange);color:#fff;font-size:13px;font-weight:800;
  display:grid;place-items:center;box-shadow:0 3px 10px rgba(242,101,34,.3);
}
.step__ic{width:24px;height:24px;flex:none;color:var(--orange);opacity:.85}
.step__t{font-size:13.5px;font-weight:700;color:var(--ink-2);line-height:1.4}

/* ═══════════ WHAT'S INCLUDED ═══════════ */
.inc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px 10px;margin-top:20px}
.inc-grid li{display:flex;flex-direction:column;align-items:center;text-align:center;gap:9px}
.inc-grid svg{width:30px;height:30px;color:var(--orange)}
.inc-grid span{font-size:12px;font-weight:700;color:var(--ink-2);line-height:1.35}

/* ═══════════ REVIEWS ═══════════ */
.reviews__score{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:12px;font-size:15px}
.reviews__score b{font-weight:800}
.review{
  background:#fff;border:1px solid var(--line-2);border-radius:12px;
  padding:22px 20px;text-align:center;box-shadow:var(--shadow);
  display:flex;flex-direction:column;align-items:center;gap:12px;min-height:100%;
}
.review .stars{font-size:19px;letter-spacing:3px}
.review p{font-size:13.5px;color:var(--ink-2);line-height:1.65}
.review__who{display:flex;align-items:center;gap:11px;margin-top:2px}
.review__av{
  width:40px;height:40px;flex:none;border-radius:50%;
  background:var(--orange-tint);color:var(--orange-d);
  font-size:13.5px;font-weight:800;display:grid;place-items:center;
}
.review__id{display:flex;flex-direction:column;text-align:left;line-height:1.3}
.review__id b{font-size:13.5px;font-weight:800;color:var(--ink)}
.review__id i{font-style:normal;font-size:11.5px;color:var(--muted)}
.reviews .center{margin-top:20px}

/* ═══════════ TRUST ═══════════ */
.trust__list{display:grid;gap:12px;margin-top:20px;max-width:420px;margin-inline:auto}
.trust__list li{
  position:relative;padding-left:36px;font-size:13.5px;font-weight:700;color:var(--ink-2);
  min-height:26px;display:flex;align-items:center;
}
.trust__list li::before{
  content:"";position:absolute;left:0;top:50%;transform:translateY(-50%);
  width:24px;height:24px;border-radius:50%;border:2px solid var(--orange);
}
.trust__list li::after{
  content:"";position:absolute;left:7px;top:calc(50% - 3px);width:9px;height:5px;
  border-left:2.2px solid var(--orange);border-bottom:2.2px solid var(--orange);transform:rotate(-45deg);
}

/* ═══════════ PRICING ═══════════ */
.plans{display:grid;gap:22px;margin-top:22px;align-items:start}
.plan{
  background:#fff;border:1px solid var(--line);border-radius:var(--r);
  padding:24px 20px;text-align:center;box-shadow:var(--shadow);
  display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s;
}
.plan--pop{border:2px solid var(--orange);position:relative;padding-top:32px;box-shadow:var(--shadow-lg)}
.plan__tag{
  position:absolute;top:-13px;left:50%;transform:translateX(-50%);
  background:var(--orange);color:#fff;font-size:11px;font-weight:800;letter-spacing:.7px;
  padding:6px 15px;border-radius:6px;white-space:nowrap;
}
.plan__name{font-size:19px;font-weight:800}
.plan__for{font-size:12.5px;color:var(--muted);margin-top:5px}
.plan__price{font-size:28px;font-weight:800;color:var(--orange);margin:15px 0 18px;line-height:1.1}
.plan__price small{font-size:13px;font-weight:600;color:var(--muted)}
.plan__price--custom{font-size:22px}
.plan__list{display:grid;gap:11px;text-align:left;margin-bottom:22px;flex:1}
.plan__list li{position:relative;padding-left:24px;font-size:13.5px;color:var(--ink-2);font-weight:500}
.plan__list li::before{
  content:"";position:absolute;left:3px;top:6px;width:9px;height:5px;
  border-left:2.2px solid var(--orange);border-bottom:2.2px solid var(--orange);transform:rotate(-45deg);
}
.plan__btn{max-width:none;margin-top:auto}
.plans__note{text-align:center;font-size:11.5px;color:var(--muted);margin-top:16px;font-style:italic}
@media (hover:hover){.plan:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}}

/* ═══════════ FAQ ═══════════ */
.faq__cols{display:grid;gap:0;margin-top:20px}
.qa{border-bottom:1px solid var(--line)}
.qa summary{
  list-style:none;cursor:pointer;
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding:15px 0;font-size:13.5px;font-weight:600;color:var(--ink-2);
}
.qa summary::-webkit-details-marker{display:none}
.qa summary::after{content:"+";flex:none;color:var(--orange);font-size:20px;font-weight:700;line-height:1}
.qa[open] summary{color:var(--orange)}
.qa[open] summary::after{content:"−"}
.qa p{padding:0 0 16px;font-size:13px;color:var(--muted)}
.faq .center{margin-top:22px}

/* ═══════════ SPEAK WITH OUR EXPERTS ═══════════ */
.expert{padding-bottom:0}
.expert__card{
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:16px 14px;align-items:center;
  max-width:760px;margin:20px auto 0;
  background:#fff;border:1px solid var(--line);border-radius:var(--r);
  box-shadow:var(--shadow-lg);padding:16px;
}
.expert__photo{
  width:100%;height:auto;aspect-ratio:4/3.4;object-fit:cover;object-position:50% 18%;
  border-radius:12px;background:var(--orange-tint);
}
.expert__info{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}
.expert__online{
  display:inline-flex;align-items:center;gap:7px;
  padding:5px 12px;border-radius:999px;
  border:1px solid #CFEBD9;background:#F3FBF5;
  font-size:12px;font-weight:800;color:var(--green);white-space:nowrap;
}
.expert__online::before{
  content:"";width:8px;height:8px;border-radius:50%;background:var(--wa);
  box-shadow:0 0 0 0 rgba(37,211,102,.55);animation:pulse 2s infinite;
}
@keyframes pulse{70%{box-shadow:0 0 0 7px rgba(37,211,102,0)}100%{box-shadow:0 0 0 0 rgba(37,211,102,0)}}
.expert__name{font-size:clamp(19px,5.2vw,24px);font-weight:800;color:var(--ink);line-height:1.2}
.expert__role{font-size:13.5px;font-weight:700;color:var(--orange);line-height:1.35}
.expert__cta{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.expert__cta .btn{max-width:none;padding-inline:10px}

/* ═══════════ CONTACT FORM ═══════════ */
.contact{background:var(--bg-soft);border-block:1px solid var(--line)}
.contact__inner{display:grid;gap:26px}
.contact__h{text-align:center}
.contact__sub{text-align:center;color:var(--ink-2);font-size:14.5px;margin-top:10px;text-wrap:balance}
.contact__points{display:grid;gap:11px;margin-top:20px;max-width:420px;margin-inline:auto;width:100%}
.contact__points li{position:relative;padding-left:28px;font-size:13.5px;font-weight:600;color:var(--ink-2)}
.contact__points li::before{
  content:"";position:absolute;left:0;top:3px;
  width:18px;height:18px;border-radius:50%;background:var(--orange);
}
.contact__points li::after{
  content:"";position:absolute;left:5px;top:8px;width:8px;height:4px;
  border-left:2.2px solid #fff;border-bottom:2.2px solid #fff;transform:rotate(-45deg);
}
.contact__meta{display:grid;gap:6px;margin-top:18px;justify-items:center}
.contact__meta a{display:flex;align-items:center;gap:9px;min-height:40px;font-size:14px;font-weight:700;color:var(--ink-2)}
.contact__meta svg{width:17px;height:17px;color:var(--orange);flex:none}
@media (hover:hover){.contact__meta a:hover{color:var(--orange)}}

.form-card{
  background:#fff;border:1px solid var(--line);border-radius:var(--r);
  padding:24px 20px;box-shadow:var(--shadow-lg);
}
.form-card__h{font-size:19px;font-weight:800}
.form-card__p{font-size:13.5px;color:var(--muted);margin-top:6px}
.form-card__line{display:block;width:54px;height:4px;border-radius:3px;background:var(--orange);margin:14px 0 20px}

.lead-form{display:grid;gap:14px}
.form-row{display:grid;gap:14px}
.field{position:relative}
.field__ic{
  position:absolute;left:13px;top:14px;width:18px;height:18px;
  color:#A9A9A9;pointer-events:none;transition:color .18s;
}
.field input,.field textarea{
  width:100%;font:inherit;font-size:16px;color:var(--ink);
  background:#FCFCFC;border:1.5px solid #E4E4E4;border-radius:10px;
  padding:13px 14px 13px 40px;
  transition:border-color .18s,box-shadow .18s,background .18s;
}
.field textarea{resize:vertical;min-height:96px;line-height:1.55}
.field input::placeholder,.field textarea::placeholder{color:#9A9A9A}
.field input:focus,.field textarea:focus{
  outline:none;background:#fff;border-color:var(--orange);box-shadow:0 0 0 3px rgba(242,101,34,.14);
}
.field:focus-within .field__ic{color:var(--orange)}
.field--area .field__ic{top:14px}
.field.is-bad input,.field.is-bad textarea{border-color:#E23B2E;background:#FFF7F6}
.field.is-bad .field__ic{color:#E23B2E}
.field__err{display:none;margin-top:5px;font-size:12px;font-weight:600;color:#E23B2E}
.field.is-bad .field__err{display:block}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

.lead-form__btn{width:100%;max-width:none;margin-top:2px}
.lead-form__btn[disabled]{opacity:.7;pointer-events:none}
.lead-form__note{font-size:11.5px;color:var(--muted);text-align:center;line-height:1.5}
.lead-form__fail{
  font-size:13px;font-weight:600;color:#B42318;background:#FFF5F4;
  border:1px solid #F8DAD7;border-radius:10px;padding:11px 13px;line-height:1.5;
}
.lead-form__fail a{text-decoration:underline}

.form-done{text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px 0}
.form-done__tick{width:56px;height:56px;border-radius:50%;background:#E8F7EE;position:relative;display:grid;place-items:center}
.form-done__tick::after{
  content:"";width:18px;height:9px;margin-top:-4px;
  border-left:3px solid var(--green);border-bottom:3px solid var(--green);transform:rotate(-45deg);
}
.form-done h4{font-size:19px;color:var(--green)}
.form-done p{font-size:13.5px;color:var(--muted);max-width:300px}

@media (min-width:560px){
  .form-row{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (min-width:1000px){
  .contact__inner{grid-template-columns:1fr 1.05fr;gap:44px;align-items:center}
  .contact__copy{text-align:left}
  .contact__h,.contact__sub{text-align:left}
  .contact__points{margin-inline:0;max-width:none}
  .contact__meta{justify-items:start;gap:2px}
  .form-card{padding:30px 28px}
}

/* ═══════════ FINAL CTA ═══════════ */
.final{
  background:linear-gradient(150deg,var(--orange) 0%,#F4762E 60%,#F5843F 100%);
  color:#fff;padding-block:32px;
}
.final__inner{display:grid;gap:20px;justify-items:center}
.final__copy{display:flex;flex-direction:column;align-items:center;text-align:center;width:100%}
.final__copy h2{font-size:clamp(19px,5.4vw,26px);line-height:1.45;text-wrap:balance}
.final__copy p{margin-top:8px;font-size:14.5px;opacity:.96}
.final__pills{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 18px;margin-top:14px;font-size:12.5px;font-weight:700}
.final__pills li{position:relative;padding-left:16px}
.final__pills li::before{
  content:"";position:absolute;left:0;top:calc(50% - 3px);
  width:6px;height:6px;border-radius:50%;background:#fff;
}
.final__cta{display:flex;flex-direction:column;align-items:center;gap:11px;margin-top:20px;width:100%}
.final__art{width:110px;order:-1}

/* ═══════════ FOOTER ═══════════ */
.footer{background:var(--dark);color:#9A9A9A;padding-block:30px 20px;font-size:13px}
.footer__grid{display:grid;gap:24px}
.footer__logo{height:34px;width:auto;aspect-ratio:220/62}
.footer__brand p{margin-top:12px;font-size:12.5px;line-height:1.65;max-width:330px}
.social{display:flex;gap:10px;margin-top:16px}
.social a{
  width:40px;height:40px;border-radius:50%;
  background:rgba(255,255,255,.08);color:#CFCFCF;
  display:grid;place-items:center;transition:background .2s,color .2s;
}
.social svg{width:15px;height:15px}
@media (hover:hover){.social a:hover{background:var(--orange);color:#fff}}

.footer__contact{display:grid;gap:2px}
.footer__contact li{display:flex;align-items:center;gap:10px;font-size:13px;min-height:40px}
.footer__contact a{display:flex;align-items:center;gap:10px;font-size:13px;min-height:40px}
.footer__contact svg{width:17px;height:17px;flex:none;color:var(--orange)}
@media (hover:hover){.footer__contact a:hover{color:#fff}}

.footer__copy{
  text-align:center;font-size:11.5px;color:#6E6E6E;
  margin-top:24px;padding-top:18px;border-top:1px solid rgba(255,255,255,.08);
}

/* ═══════════ STICKY ACTION BAR (mobile) ═══════════ */
.actionbar{
  position:fixed;left:0;right:0;bottom:0;z-index:70;
  display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:9px 10px;
  padding-bottom:calc(9px + env(safe-area-inset-bottom));
  background:rgba(255,255,255,.97);backdrop-filter:blur(10px);
  border-top:1px solid var(--line);box-shadow:0 -4px 18px rgba(0,0,0,.07);
}
.actionbar__btn{
  display:flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap;
  padding:11px 4px;border-radius:9px;font-size:12.5px;font-weight:700;line-height:1;
  border:1.5px solid transparent;
}
.actionbar__btn svg{width:16px;height:16px;flex:none}
.actionbar__btn--wa{background:var(--wa);color:#fff}
.actionbar__btn--audit{background:var(--orange);color:#fff}
.actionbar__btn--call{background:#fff;color:var(--orange);border-color:var(--orange)}

.fab{display:none}

/* ═══════════════════════════════════════════
   ≥ 700px — small tablet
   ═══════════════════════════════════════════ */
@media (min-width:700px){
  section{padding-block:44px}
  .wrap{padding-inline:24px}
  .br-m{display:none}

  .btn{width:auto;max-width:none}
  .hero__cta{flex-direction:row;flex-wrap:wrap;justify-content:center}
  .final__cta{flex-direction:row;flex-wrap:wrap;justify-content:center}
  .plan__btn{width:100%}

  .stats__grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:24px 10px}
  .stat--wide{grid-column:auto}

  .logos{grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 20px}

  .carousel__track{grid-auto-columns:calc(50% - 7px)}
  .carousel--reviews .carousel__track{grid-auto-columns:calc(50% - 7px)}

  .problem-list{grid-template-columns:repeat(2,minmax(0,1fr))}
  .why__list{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 24px}
  .case__grid{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}
  .steps{grid-template-columns:repeat(2,minmax(0,1fr))}
  .inc-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:26px 14px}
  .trust__list{grid-template-columns:repeat(2,minmax(0,1fr));max-width:none;gap:16px 26px}
  .faq__cols{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:34px}
  .plans{grid-template-columns:repeat(2,minmax(0,1fr))}
  .plan--premium{grid-column:1/-1;max-width:520px;margin-inline:auto;width:100%}

  .expert__card{grid-template-columns:260px minmax(0,1fr);gap:22px 26px;padding:20px}
  .expert__info{gap:10px}
  .expert__cta{grid-column:2;grid-template-columns:repeat(2,max-content);margin-top:4px}
  .expert__cta .btn{padding-inline:22px}
  .expert__photo{grid-row:span 2;aspect-ratio:1}

  .footer__grid{grid-template-columns:1.4fr 1fr;align-items:start}
  .footer__contact{justify-items:end}
}

/* ═══════════════════════════════════════════
   ≥ 1000px — desktop
   ═══════════════════════════════════════════ */
@media (min-width:1000px){
  :root{--bar-h:0px}
  body{padding-bottom:0}

  section{padding-block:52px}
  .wrap{padding-inline:28px}

  .nav-toggle{display:none}
  .nav{
    position:static;display:flex;flex-direction:row;align-items:center;
    gap:28px;padding:0;background:none;border:0;box-shadow:none;width:auto;
  }
  .nav a{padding:0;border:0}
  .nav__cta{margin-top:0;padding:9px 20px !important;border-radius:8px}
  @media (hover:hover){
    .nav a:hover{color:var(--orange)}
    .nav__cta:hover{background:var(--orange-d);color:#fff !important}
  }
  .header__inner{min-height:74px}
  .logo__svg{height:42px}

  .hero{padding-block:52px 44px}
  .hero__inner{grid-template-columns:1.05fr .95fr;gap:32px;align-items:center}
  .hero__copy{align-items:flex-start;text-align:left}
  .hero__art{display:flex;justify-content:center;order:0}
  .art{max-width:430px}
  .hero__title{font-size:clamp(34px,3.6vw,45px);line-height:1.3}
  .flags{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:8px 18px;max-width:none;width:auto}
  .ticks{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px 26px;max-width:470px}
  .hero__cta{justify-content:flex-start;width:auto}
  .rating{justify-content:flex-start}
  .blob--1{right:-140px;top:-120px;width:520px}
  .blob--2{right:60px;bottom:-160px;width:340px}

  .stats__grid{grid-template-columns:repeat(7,minmax(0,1fr));padding:24px 18px;gap:8px}
  .stat{position:relative}
  .stat + .stat::before{content:"";position:absolute;left:-4px;top:12%;height:76%;width:1px;background:var(--line)}

  .band__inner{
    grid-template-columns:auto 1fr auto;gap:28px;justify-items:start;text-align:left;
    padding:28px 32px;align-items:center;
  }
  .band__globe{width:78px;height:78px}
  .band__copy p{max-width:620px}
  .band__list{max-width:none;padding-left:26px;border-left:1px solid rgba(255,255,255,.35)}
  .band__list li{white-space:nowrap;font-size:14.5px}

  .logos{grid-template-columns:repeat(4,minmax(0,1fr));padding:28px 24px}

  .carousel__track{grid-auto-columns:calc(25% - 10.5px)}
  .carousel--reviews .carousel__track{grid-auto-columns:calc(33.333% - 9.34px)}
  .cnav--prev{left:-16px}
  .cnav--next{right:-16px}

  .problem-list{grid-template-columns:repeat(4,minmax(0,1fr))}
  .problem{flex-direction:column;text-align:center;gap:11px;padding:20px 16px}
  .problem__t{align-items:center}

  .why__card{padding:32px 30px}
  .why__list{grid-template-columns:repeat(5,minmax(0,1fr));gap:22px 16px}
  .why__list li{flex-direction:column;text-align:center;gap:11px}

  .results__card{grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:32px;align-items:center;padding:32px}
  .rtable{font-size:13.5px;min-width:0}
  .results__btn{margin-top:22px;width:auto;min-width:320px}

  .case__grid{gap:20px}
  .case__box{padding:22px 24px 24px}

  .steps{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .step{flex-direction:column;text-align:center;gap:11px;padding:20px 14px}

  .inc-grid{grid-template-columns:repeat(8,minmax(0,1fr));gap:10px}
  .inc-grid svg{width:32px;height:32px}

  .trust__list{grid-template-columns:repeat(4,minmax(0,1fr));gap:18px 24px}

  .plans{grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
  .plan--premium{grid-column:auto;max-width:none;margin-inline:0}
  .plan{padding:28px 24px}

  .faq__cols{column-gap:40px}

  .final{padding-block:34px}
  .final__inner{grid-template-columns:1fr auto;align-items:center;gap:36px}
  .final__copy{align-items:flex-start;text-align:left}
  .final__pills{justify-content:flex-start}
  .final__cta{justify-content:flex-start;width:auto}
  .final__art{order:0;width:140px}

  .footer{padding-block:34px 20px}
  .footer__grid{grid-template-columns:1.6fr 1fr}

  .actionbar{display:none}
  .fab{
    display:grid;place-items:center;
    position:fixed;right:22px;bottom:24px;z-index:70;
    width:54px;height:54px;border-radius:50%;
    background:var(--wa);color:#fff;
    box-shadow:0 8px 22px rgba(37,211,102,.45);transition:transform .2s;
  }
  .fab svg{width:30px;height:30px}
  .fab:hover{transform:scale(1.08)}
}

@media (min-width:1200px){
  section{padding-block:58px}
  .sec-title{font-size:28px}
  .hero__inner{grid-template-columns:1.2fr .8fr}
}

/* very narrow phones (Fold closed, ~280–344px) */
@media (max-width:344px){
  .wrap{padding-inline:14px}
  .flags{grid-template-columns:repeat(2,minmax(0,1fr));max-width:280px}
  .actionbar{gap:6px;padding-inline:8px}
  .actionbar__btn{font-size:11px;gap:5px;padding:11px 2px}
  .actionbar__btn svg{width:14px;height:14px}
  .stats__grid{padding-inline:8px}
  .band__inner,.why__card,.results__card{padding-inline:16px}
  .expert__card{grid-template-columns:minmax(0,1fr)}
  .expert__info{align-items:center;text-align:center}
}

/* phone in landscape: release the sticky header and slim the bar */
@media (orientation:landscape) and (max-height:520px){
  :root{--bar-h:50px}
  .header{position:static}
  .header__inner{min-height:52px}
  .hero{padding-block:18px 22px}
  section{padding-block:20px}
  .actionbar{padding:5px 10px;padding-bottom:calc(5px + env(safe-area-inset-bottom))}
  .actionbar__btn{padding:9px 4px;font-size:12px}
  .nav{max-height:70vh;overflow-y:auto}
}

.reveal{opacity:0;transform:translateY(14px);transition:opacity .5s ease,transform .5s ease}
.reveal.is-in{opacity:1;transform:none}

@media (prefers-reduced-motion:reduce){
  .reveal{opacity:1 !important;transform:none !important}
  *,*::before,*::after{
    animation-duration:.01ms !important;
    transition-duration:.01ms !important;
    scroll-behavior:auto !important;
  }
}
</style>
</head>
<body data-ads-id={adsId} data-ads-lead={adsLead} data-ads-wa={adsWa} data-ads-call={adsCall}>

<!-- ══════════ HEADER ══════════ -->
<header class="header">
  <div class="wrap header__inner">
    <a href="#" class="logo" aria-label="Teknoppy — Digital Growth Partner">
      <img class="logo__svg" src="/logo.svg" alt="Teknoppy" width="220" height="62" fetchpriority="high">
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="nav">
      <a href="#services">Services</a>
      <a href="#results">Results</a>
      <a href="#process">Process</a>
      <a href="#pricing">Pricing</a>
      <a href="#faq">FAQ</a>
      <a href="#contact" class="nav__cta">Contact</a>
    </nav>
  </div>
</header>

<!-- ══════════ HERO ══════════ -->
<section class="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <span class="pill">KERALA'S SEO COMPANY FOR GCC BUSINESSES</span>
      <h1 class:list={['hero__title', ml]}>{copy.heroTitle}</h1>
      <p class="hero__lead" set:html={copy.heroLead} />

      <ul class="flags">
        <li><span class="flag">🇦🇪</span>UAE</li>
        <li><span class="flag">🇸🇦</span>Saudi Arabia</li>
        <li><span class="flag">🇶🇦</span>Qatar</li>
        <li><span class="flag">🇰🇼</span>Kuwait</li>
        <li><span class="flag">🇴🇲</span>Oman</li>
        <li><span class="flag">🇧🇭</span>Bahrain</li>
      </ul>

      <ul class="ticks">
        <li>More Organic Traffic</li>
        <li>Qualified Leads</li>
        <li>Long Term Growth</li>
        <li>Transparent Reports</li>
      </ul>

      <div class="hero__cta">
        <a href={wa} class="btn btn--wa">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={WA}/></svg>
          WhatsApp Now
        </a>
        <a href="#contact" class="btn btn--primary">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={CLIP}/></svg>
          Get FREE SEO Audit
        </a>
        <a href={tel} class="btn btn--ghost">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={PHONE}/></svg>
          Schedule a Call
        </a>
      </div>

      <div class="rating">
        <svg class="g-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={G} />
        <b>4.9/5</b>
        <span class="stars">★★★★★</span>
        <span class="rating__by">| Rated by <b>100+</b> Clients</span>
      </div>
    </div>

    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 460 470" class="art">
        <defs>
          <linearGradient id="gOr" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#F05A22"/><stop offset="1" stop-color="#FF8A3D"/>
          </linearGradient>
          <linearGradient id="gOr2" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#FF8A3D"/><stop offset="1" stop-color="#EA4E14"/>
          </linearGradient>
        </defs>
        <g fill="#F26522" opacity=".28">
          <circle cx="386" cy="42" r="4"/><circle cx="408" cy="42" r="4"/><circle cx="430" cy="42" r="4"/>
          <circle cx="386" cy="64" r="4"/><circle cx="408" cy="64" r="4"/><circle cx="430" cy="64" r="4"/>
          <circle cx="386" cy="86" r="4"/><circle cx="408" cy="86" r="4"/><circle cx="430" cy="86" r="4"/>
        </g>
        <rect x="243" y="240" width="54" height="92"  rx="4" fill="url(#gOr)"/>
        <rect x="307" y="188" width="54" height="144" rx="4" fill="url(#gOr)"/>
        <rect x="371" y="126" width="54" height="206" rx="4" fill="url(#gOr)"/>
        <path d="M118 246c74-8 168-44 236-124l-30-24 96-14-20 94-28-22c-74 88-176 128-254 136z" fill="url(#gOr2)"/>
        <circle cx="118" cy="176" r="46" fill="none" stroke="#2B2B2B" stroke-width="13"/>
        <path d="M152 210l32 32" stroke="#2B2B2B" stroke-width="17" stroke-linecap="round"/>
        <text x="140" y="378" class="art__t">BUILD</text>
        <text x="140" y="416" class="art__t">RANK</text>
        <text x="140" y="454" class="art__t">GROW</text>
      </svg>
    </div>
  </div>
</section>

<!-- ══════════ STATS ══════════ -->
<section class="stats">
  <div class="wrap">
    <h3 class="stats__title">Trusted by Businesses Across GCC</h3>
    <div class="stats__grid">
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 7.7l5.4-.8z"/><path fill="currentColor" opacity=".55" d="M8 17l-2 5 4-1.4L12 24l2-3.4 4 1.4-2-5z"/></svg>
        <b>10+</b><span>Years<br>Experience</span>
      </div>
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 20h18v2H3zM5 12h3v6H5zm5-5h3v11h-3zm5 8h3v3h-3z"/><path fill="none" stroke="currentColor" stroke-width="1.6" d="M4 10l6-5 4 3 6-6"/></svg>
        <b>500+</b><span>Keywords<br>Ranked</span>
      </div>
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8m0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5"/></svg>
        <b>100+</b><span>Happy<br>Clients</span>
      </div>
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l8 3.5v6c0 5-3.4 9.2-8 10.5-4.6-1.3-8-5.5-8-10.5v-6z"/></svg>
        <span>White Hat<br>Practices</span>
      </div>
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 2h9l5 5v15H6zm8 1.5V8h4.5z"/><path stroke="#fff" stroke-width="1.6" d="M8.5 12.5l7 7m0-7l-7 7"/></svg>
