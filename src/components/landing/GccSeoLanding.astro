---
/**
 * Google Ads landing page — SEO for GCC Malayali businesses.
 *
 * One design, two languages: /lp/gcc-seo/en/ and /lp/gcc-seo/ml/. Only the
 * strings in `copy` differ between them. Head, header, footer, styles and script
 * live in LandingPage.astro, shared with the other landing pages.
 */
import LandingPage from './LandingPage.astro';
import LandingTestimonials from './LandingTestimonials.astro';
import LandingReviews from './LandingReviews.astro';
import LandingFaq from './LandingFaq.astro';
import LandingExpert from './LandingExpert.astro';
import LandingContact from './LandingContact.astro';
import LandingFinal from './LandingFinal.astro';
import { tel, waLink, WA, PHONE, CLIP, G } from './shared';

interface Props {
  lang: 'en' | 'ml';
}

const { lang } = Astro.props;
const EN = lang === 'en';
const ml = EN ? undefined : 'ml';

const copy = EN
  ? {
      title: 'Teknoppy — SEO Services for GCC Businesses',
      description:
        'Result-oriented SEO services for Malayali business owners across UAE, Saudi Arabia, Qatar, Kuwait, Oman and Bahrain.',
      heroTitle: 'Is Your Business Invisible on Google?',
      heroLead: 'Result-Oriented SEO Services<br>for Malayali Businesses in the GCC.',
      bandTitle: 'From Kerala,<br>Focused on GCC Business.',
      bandText:
        'SEO services designed specifically to help Malayali business owners in the Gulf get more qualified enquiries through Google.',
      testiSub: 'Hear what our clients have to say...',
      problemsTitle: 'Are You Facing<br class="br-m">These Problems?',
      problems: [
        ['You have a website...', 'but no enquiries.'],
        ['On Google Search,', 'only your competitors show up.'],
        ['Stop the ads,', 'and the leads stop.'],
        ['Tried SEO before,', 'but saw no results.']
      ],
      solve: 'Now build steady<br>visibility on Google.',
      expertTitle: 'Speak with Our Experts...',
      expertSub: 'Your path to growing your business on Google starts here.',
      faq: [
        [
          'How long does SEO take to show results?',
          'You will usually start seeing meaningful ranking changes within 3–6 months. This varies with competition and the age of your website.'
        ],
        [
          'Do you guarantee Google rankings?',
          'Nobody should promise guaranteed Google rankings. What we do guarantee is steady growth through white-hat methods.'
        ],
        [
          'Will I get a monthly report?',
          'Yes. Every month you get a transparent report covering keyword rankings, traffic and leads.'
        ],
        ['Do you offer WhatsApp support?', 'Yes. You can reach our SEO team directly on WhatsApp.'],
        [
          'Can you do SEO for my existing website?',
          'Absolutely. We start with a free SEO audit and then recommend the improvements your site needs.'
        ],
        [
          'Is there a long-term contract?',
          'No. We do not lock you into a long-term contract. You can continue month to month.'
        ]
      ],
      contactSub: "Let's grow your business on Google. Book a FREE SEO Audit.",
      finalTitle: 'Is Your Business Ready to Grow on Google?',
      finalText: 'Book your FREE SEO Audit today.',
      waText: "Hi Teknoppy, I saw your ad and I'd like a free SEO audit for my business.",
      source: 'Google Ads LP — GCC SEO (English)'
    }
  : {
      title: "Teknoppy — Kerala's SEO Company for GCC Businesses",
      description:
        'Result-oriented SEO services for Malayali business owners across UAE, Saudi Arabia, Qatar, Kuwait, Oman and Bahrain.',
      heroTitle: 'Google-ൽ നിങ്ങളുടെ ബിസിനസ് കാണുന്നില്ലേ?',
      heroLead: '<span class="ml">GCC മലയാളി ബിസിനസ്സുകൾക്ക്</span><br>Result-Oriented SEO Services.',
      bandTitle: 'കേരളത്തിൽ നിന്ന്<br>GCC Business Focus.',
      bandText:
        'ഗൾഫിലെ ബിസിനസ് നടത്തുന്ന മലയാളികൾക്ക് Google-ലൂടെ കൂടുതൽ qualified enquiries ലഭിക്കാൻ പ്രത്യേകമായി രൂപകൽപ്പന ചെയ്ത SEO സേവനങ്ങൾ.',
      testiSub: 'ഞങ്ങളുടെ ക്ലയന്റുകൾ പറയുന്നത് കേൾക്കൂ...',
      problemsTitle: 'ഈ പ്രശ്നങ്ങൾ നിങ്ങളും<br class="br-m">നേരിടുന്നുണ്ടോ?',
      problems: [
        ['Website ഉണ്ട്...', 'പക്ഷെ enquiries ഇല്ല.'],
        ['Google Search-ൽ', 'competitors മാത്രം.'],
        ['Ads നിർത്തിയാൽ', 'Leads ഇല്ല.'],
        ['SEO ചെയ്തിട്ടും', 'Result ഇല്ല.']
      ],
      solve: 'ഇനി Google-ൽ സ്ഥിരമായ<br>Visibility ഉണ്ടാക്കാം.',
      expertTitle: 'ഞങ്ങളുടെ Expert-നോട് സംസാരിക്കൂ...',
      expertSub: 'Google-ൽ നിങ്ങളുടെ ബിസിനസ് വളർത്താനുള്ള ആദ്യ ചുവട് ഇവിടെ തുടങ്ങാം.',
      faq: [
        [
          'SEO results ലഭിക്കാൻ എത്ര സമയം എടുക്കും?',
          'സാധാരണയായി 3–6 മാസത്തിനുള്ളിൽ കാര്യമായ ranking മാറ്റങ്ങൾ കാണാൻ തുടങ്ങും. Competition, website age എന്നിവ അനുസരിച്ച് ഇത് വ്യത്യാസപ്പെടാം.'
        ],
        [
          'Google Ranking Guarantee ഉണ്ടോ?',
          'ആരും Google ranking guarantee നൽകാൻ പാടില്ല. എന്നാൽ ഞങ്ങൾ white-hat രീതികളിലൂടെ സ്ഥിരമായ growth ഉറപ്പാക്കുന്നു.'
        ],
        [
          'Monthly Report ലഭിക്കുമോ?',
          'അതെ. എല്ലാ മാസവും keyword ranking, traffic, leads എന്നിവ ഉൾപ്പെടുന്ന transparent report ലഭിക്കും.'
        ],
        ['WhatsApp Support ഉണ്ടോ?', 'ഉണ്ട്. ഞങ്ങളുടെ SEO team-മായി നേരിട്ട് WhatsApp വഴി ബന്ധപ്പെടാം.'],
        [
          'Existing Website-നു SEO ചെയ്യുമോ?',
          'തീർച്ചയായും. ആദ്യം ഒരു free SEO audit ചെയ്ത ശേഷം ആവശ്യമായ improvements നിർദ്ദേശിക്കും.'
        ],
        [
          'Long Term Contract ആണോ?',
          'അല്ല. ഞങ്ങൾ long term contract നിർബന്ധമാക്കുന്നില്ല. Monthly അടിസ്ഥാനത്തിൽ തുടരാം.'
        ]
      ],
      contactSub: 'നിങ്ങളുടെ ബിസിനസ് Google-ൽ വളർത്താം. ഒരു FREE SEO Audit ബുക്ക് ചെയ്യൂ.',
      finalTitle: 'നിങ്ങളുടെ ബിസിനസ് Google-ൽ വളരാൻ തയ്യാറാണോ?',
      finalText: 'ഇന്നുതന്നെ ഒരു FREE SEO Audit ബുക്ക് ചെയ്യൂ.',
      waText: 'Hi Teknoppy, എന്റെ ബിസിനസിന് ഒരു free SEO audit വേണം.',
      source: 'Google Ads LP — GCC SEO (Malayalam)'
    };

const wa = waLink(copy.waText);

const nav: [string, string][] = [
  ['#services', 'Services'],
  ['#results', 'Results'],
  ['#process', 'Process'],
  ['#pricing', 'Pricing'],
  ['#faq', 'FAQ']
];
---

<LandingPage
  lang={lang}
  title={copy.title}
  description={copy.description}
  waText={copy.waText}
  nav={nav}
  footerBlurb="Kerala based SEO company helping businesses in GCC & worldwide grow on Google."
>

<!-- ══════════ HERO ══════════ -->
<section class="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <span class="pill">KERALA'S SEO COMPANY FOR GCC BUSINESSES</span>
      <h1 class:list={['hero__title', ml]}>{copy.heroTitle}</h1>
      <p class="hero__lead" set:html={copy.heroLead} />

      <ul class="flags">
        <li><span class="flag">🇦🇪</span>UAE</li>
        <li><span class="flag">🇸🇦</span>Saudi Arabia</li>
        <li><span class="flag">🇶🇦</span>Qatar</li>
        <li><span class="flag">🇰🇼</span>Kuwait</li>
        <li><span class="flag">🇴🇲</span>Oman</li>
        <li><span class="flag">🇧🇭</span>Bahrain</li>
      </ul>

      <ul class="ticks">
        <li>More Organic Traffic</li>
        <li>Qualified Leads</li>
        <li>Long Term Growth</li>
        <li>Transparent Reports</li>
      </ul>

      <div class="hero__cta">
        <a href={wa} class="btn btn--wa">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={WA}/></svg>
          WhatsApp Now
        </a>
        <a href="#contact" class="btn btn--primary">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={CLIP}/></svg>
          Get FREE SEO Audit
        </a>
        <a href={tel} class="btn btn--ghost">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={PHONE}/></svg>
          Schedule a Call
        </a>
      </div>

      <div class="rating">
        <svg class="g-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={G} />
        <b>4.9/5</b>
        <span class="stars">★★★★★</span>
        <span class="rating__by">| Rated by <b>100+</b> Clients</span>
      </div>
    </div>

    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 460 470" class="art">
        <defs>
          <linearGradient id="gOr" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#F05A22"/><stop offset="1" stop-color="#FF8A3D"/>
          </linearGradient>
          <linearGradient id="gOr2" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#FF8A3D"/><stop offset="1" stop-color="#EA4E14"/>
          </linearGradient>
        </defs>
        <g fill="#F26522" opacity=".28">
          <circle cx="386" cy="42" r="4"/><circle cx="408" cy="42" r="4"/><circle cx="430" cy="42" r="4"/>
          <circle cx="386" cy="64" r="4"/><circle cx="408" cy="64" r="4"/><circle cx="430" cy="64" r="4"/>
          <circle cx="386" cy="86" r="4"/><circle cx="408" cy="86" r="4"/><circle cx="430" cy="86" r="4"/>
        </g>
        <rect x="243" y="240" width="54" height="92"  rx="4" fill="url(#gOr)"/>
        <rect x="307" y="188" width="54" height="144" rx="4" fill="url(#gOr)"/>
        <rect x="371" y="126" width="54" height="206" rx="4" fill="url(#gOr)"/>
        <path d="M118 246c74-8 168-44 236-124l-30-24 96-14-20 94-28-22c-74 88-176 128-254 136z" fill="url(#gOr2)"/>
        <circle cx="118" cy="176" r="46" fill="none" stroke="#2B2B2B" stroke-width="13"/>
        <path d="M152 210l32 32" stroke="#2B2B2B" stroke-width="17" stroke-linecap="round"/>
        <text x="140" y="378" class="art__t">BUILD</text>
        <text x="140" y="416" class="art__t">RANK</text>
        <text x="140" y="454" class="art__t">GROW</text>
      </svg>
    </div>
  </div>
</section>

<!-- ══════════ STATS ══════════ -->
<section class="stats">
  <div class="wrap">
    <h3 class="stats__title">Trusted by Businesses Across GCC</h3>
    <div class="stats__grid">
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 7.7l5.4-.8z"/><path fill="currentColor" opacity=".55" d="M8 17l-2 5 4-1.4L12 24l2-3.4 4 1.4-2-5z"/></svg>
        <b>10+</b><span>Years<br>Experience</span>
      </div>
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 20h18v2H3zM5 12h3v6H5zm5-5h3v11h-3zm5 8h3v3h-3z"/><path fill="none" stroke="currentColor" stroke-width="1.6" d="M4 10l6-5 4 3 6-6"/></svg>
        <b>500+</b><span>Keywords<br>Ranked</span>
      </div>
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8m0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5"/></svg>
        <b>100+</b><span>Happy<br>Clients</span>
      </div>
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l8 3.5v6c0 5-3.4 9.2-8 10.5-4.6-1.3-8-5.5-8-10.5v-6z"/></svg>
        <span>White Hat<br>Practices</span>
      </div>
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 2h9l5 5v15H6zm8 1.5V8h4.5z"/><path stroke="#fff" stroke-width="1.6" d="M8.5 12.5l7 7m0-7l-7 7"/></svg>
        <span>No Long Term<br>Contracts</span>
      </div>
      <div class="stat">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" opacity=".18" d="M4 4h16v16H4z"/><path fill="currentColor" d="M6 14h3v5H6zm5-5h3v10h-3zm5-4h3v14h-3z"/></svg>
        <span>Transparent<br>Monthly Reports</span>
      </div>
      <div class="stat stat--wide">
        <svg class="stat__ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6m8 1a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5M2 19v-1c0-2.5 3.1-4 7-4s7 1.5 7 4v1zm15.5-5c2.7 0 4.5 1.2 4.5 3v2h-4v-1c0-1.6-.8-2.9-2-3.8z"/></svg>
        <span>Kerala Based SEO Team</span>
      </div>
    </div>
  </div>
</section>

<!-- ══════════ ORANGE BAND ══════════ -->
<section class="band">
  <div class="wrap band__inner">
    <div class="band__globe" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m6.9 6h-2.6a15.6 15.6 0 0 0-1.5-3.6A8 8 0 0 1 18.9 8M12 4.1c.8 1.1 1.4 2.4 1.8 3.9h-3.6c.4-1.5 1-2.8 1.8-3.9M4.3 14a8 8 0 0 1 0-4h3a17 17 0 0 0 0 4zm.8 2h2.6c.4 1.3.9 2.5 1.5 3.6A8 8 0 0 1 5.1 16m2.6-8H5.1a8 8 0 0 1 4.1-3.6C8.6 5.5 8.1 6.7 7.7 8M12 19.9c-.8-1.1-1.4-2.4-1.8-3.9h3.6c-.4 1.5-1 2.8-1.8 3.9m2.2-5.9H9.8a15 15 0 0 1 0-4h4.4a15 15 0 0 1 0 4m.6 5.6c.6-1.1 1.1-2.3 1.5-3.6h2.6a8 8 0 0 1-4.1 3.6m1.9-5.6a17 17 0 0 0 0-4h3a8 8 0 0 1 0 4z"/></svg>
    </div>
    <div class="band__copy">
      <h2 class={ml} set:html={copy.bandTitle} />
      <p class={ml}>{copy.bandText}</p>
    </div>
    <ul class="band__list">
      <li>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={WA}/></svg>
        WhatsApp-First Communication
      </li>
      <li>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m1 10.6l4 2.3-1 1.7-5-2.9V6h2z"/></svg>
        Transparent Monthly Reporting
      </li>
      <li>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m0 3c1.2 1.5 2 3.6 2.1 6H9.9C10 8.6 10.8 6.5 12 5M4.3 13h3.6c.1 1.7.4 3.3 1 4.7A8 8 0 0 1 4.3 13m4.6-2H4.3a8 8 0 0 1 4.6-4.7c-.6 1.4-.9 3-1 4.7m3.1 8c-1.2-1.5-2-3.6-2.1-6h4.2c-.1 2.4-.9 4.5-2.1 6m3.1-.3c.6-1.4.9-3 1-4.7h3.6a8 8 0 0 1-4.6 4.7m1-6.7c-.1-1.7-.4-3.3-1-4.7a8 8 0 0 1 4.6 4.7z"/></svg>
        Kerala Team, Global SEO Expertise
      </li>
    </ul>
  </div>
</section>

<!-- ══════════ TRUSTED LOGOS ══════════ -->
<section class="trusted">
  <div class="wrap">
    <h3 class="trusted__title">Trusted by Businesses<br class="br-m">Across GCC &amp; India</h3>
    <div class="logos">
      <div class="logo-card">
        <svg viewBox="0 0 44 44" class="logo-card__ic" aria-hidden="true">
          <circle cx="22" cy="22" r="19" fill="none" stroke="#F26522" stroke-width="3"/>
          <circle cx="22" cy="22" r="12" fill="none" stroke="#3A3A3A" stroke-width="2"/>
          <path d="M22 22l7-8" stroke="#F26522" stroke-width="3" stroke-linecap="round"/>
          <circle cx="22" cy="22" r="2.6" fill="#3A3A3A"/>
        </svg>
        <span class="lg lg--gt"><b>General<em>Tech</em></b><i>S E R V I C E S</i></span>
      </div>
      <div class="logo-card">
        <svg viewBox="0 0 44 44" class="logo-card__ic" aria-hidden="true">
          <path d="M22 5l4.6 9.6L37 16l-7.6 7.2 1.9 10.4L22 28.7l-9.3 4.9 1.9-10.4L7 16l10.4-1.4z" fill="#F26522"/>
          <path d="M12 37h20" stroke="#2F6B45" stroke-width="3" stroke-linecap="round"/>
        </svg>
        <span class="lg lg--er"><b>EXPERT RANGERS</b><i>M A N P O W E R</i></span>
      </div>
      <div class="logo-card">
        <svg viewBox="0 0 46 44" class="logo-card__ic" aria-hidden="true">
          <path d="M4 33L16 6l8 18 5-10 13 19z" fill="#1F5FA8"/>
          <path d="M4 37h38" stroke="#1F5FA8" stroke-width="4" stroke-linecap="round"/>
        </svg>
        <span class="lg lg--leema"><b>LEEMA</b><i>ENGINEERING WORKS</i></span>
      </div>
      <div class="logo-card">
        <svg viewBox="0 0 44 44" class="logo-card__ic" aria-hidden="true">
          <rect x="4" y="7" width="36" height="30" rx="4" fill="#E1251B"/>
          <path d="M12 15l5 15 5-11 5 11 5-15" fill="none" stroke="#fff" stroke-width="2.6" stroke-linejoin="round"/>
        </svg>
        <span class="lg lg--cw"><b>CREATIVE WEB</b><i>DESIGN, QATAR</i></span>
      </div>
    </div>
  </div>
</section>

<LandingTestimonials sub={copy.testiSub} cta="Talk to Our SEO Team on WhatsApp" wa={wa} ml={ml} />

<!-- ══════════ PROBLEMS ══════════ -->
<section class="problems">
  <div class="wrap">
    <h2 class:list={['sec-title', ml]} set:html={copy.problemsTitle} />
    <ul class="problem-list">
      {copy.problems.map(([lead, rest]) => (
        <li class="problem">
          <span class="problem__x" aria-hidden="true"></span>
          <span class:list={['problem__t', ml]}><b>{lead}</b>{rest}</span>
        </li>
      ))}
    </ul>
    <p class:list={['problems__solve', ml]} set:html={copy.solve} />
    <div class="center">
      <a href="#contact" class="btn btn--primary">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={WA}/></svg>
        Get Free SEO Audit
      </a>
    </div>
  </div>
</section>

<!-- ══════════ WHY CHOOSE ══════════ -->
<section class="why" id="services">
  <div class="wrap">
    <div class="why__card">
      <h2 class="sec-title">Why Businesses<br class="br-m">Choose Teknoppy</h2>
      <ul class="why__list">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7m0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5"/></svg>
          <span>Kerala Based Dedicated<br>SEO Experts</span>
