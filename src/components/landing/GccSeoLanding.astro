/**
 * Google Ads landing page — SEO for GCC Malayali businesses.
 *
 * One design, two languages: /lp/gcc-seo/en/ and /lp/gcc-seo/ml/. Only the
 * strings in `copy` differ between them; markup and styles are shared.
 *
 * Standalone on purpose (no site Layout, no Tailwind, CSS and JS inlined) so the
 * page is one HTML request plus fonts — it is the paid-traffic entry point and
 * every millisecond counts toward Quality Score.
 *
 * Conversion tracking is off until these are set in Vercel (then redeploy):
 *   PUBLIC_GOOGLE_ADS_ID              AW-XXXXXXXXXX
 *   PUBLIC_GOOGLE_ADS_LEAD_LABEL      conversion label for a sent form
 *   PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL  optional — WhatsApp link clicks
 *   PUBLIC_GOOGLE_ADS_CALL_LABEL      optional — tel: link clicks
 */
import site from '../../data/site.json';

interface Props {
  lang: 'en' | 'ml';
}

const { lang } = Astro.props;
const EN = lang === 'en';
const ml = EN ? undefined : 'ml';

const formEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact';
const adsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID || '';
const adsLead = import.meta.env.PUBLIC_GOOGLE_ADS_LEAD_LABEL || '';
const adsWa = import.meta.env.PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL || '';
