---
/**
 * Polished, brand-aligned Thank-You page for GCC SEO landing page submissions.
 * Follows the reference visual layout:
 * - Solid circular green success checkmark
 * - Centered "Thank you!" heading and confirmation text
 * - Clean symmetrical white cards:
 *     1. "Connect With Us" with round social & messaging buttons
 *     2. "Visit Our Website" with clean green "Visit Website" CTA button
 * - Official Teknoppy Header & Footer
 * - Preserved GTM implementation (GTM-NHX2WJ39)
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import site from '../../data/site.json';
import { Check, Phone, Mail } from 'lucide-react';

interface Props {
  lang: 'en' | 'ml';
}

const { lang } = Astro.props;
const EN = lang === 'en';

const copy = EN
  ? {
      title: 'Thank You | Teknoppy — SEO Services for GCC Businesses',
      description: "We've received your request successfully. Our team will get back to you shortly.",
      heading: 'Thank you!',
      message: "We've received your request successfully. Our team will review your business and get back to you shortly.",
      connectTitle: 'Connect With Us',
      visitTitle: 'Visit Our Website',
      visitBtn: 'Visit Website',
      phone: '+91 62822 49224',
      email: 'sales@teknoppy.com',
      websiteTag: 'Case Studies & Digital Services'
    }
  : {
      title: 'നന്ദി | Teknoppy — GCC Businesses-നുള്ള SEO Services',
      description: 'നിങ്ങളുടെ അഭ്യർത്ഥന വിജയകരമായി ലഭിച്ചു. ഞങ്ങളുടെ ടീം ഉടൻ തിരികെ ബന്ധപ്പെടും.',
      heading: 'നന്ദി!',
      message: 'നിങ്ങളുടെ അഭ്യർത്ഥന വിജയകരമായി ലഭിച്ചു. ഞങ്ങളുടെ ടീം ഉടൻ തിരികെ ബന്ധപ്പെടും.',
      connectTitle: 'ഞങ്ങളുമായി ബന്ധപ്പെടൂ',
      visitTitle: 'ഞങ്ങളുടെ വെബ്‌സൈറ്റ് സന്ദർശിക്കൂ',
      visitBtn: 'വെബ്‌സൈറ്റ് കാണൂ',
      phone: '+91 62822 49224',
      email: 'sales@teknoppy.com',
      websiteTag: 'കേസ് സ്റ്റഡികൾ & SEO സേവനങ്ങൾ'
    };

const waText = EN
  ? "Hi Teknoppy, I submitted the GCC SEO audit form and I'd like to connect."
  : 'Hi Teknoppy, ഞാൻ GCC SEO audit form submit ചെയ്തു. കൂടുതൽ വിവരങ്ങൾ അറിയണം.';

const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(waText)}`;
const tel = `tel:${site.phoneLink}`;

// Symmetrical round social buttons matching the reference
const socialChannels = [
  {
    name: 'WhatsApp',
    url: wa,
    bg: 'bg-[#25D366]',
    icon: '<path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>'
  },
  {
    name: 'Facebook',
    url: 'https://www.facebook.com/teknoppy',
    bg: 'bg-[#1877F2]',
    icon: '<path fill="currentColor" d="M13 22v-9h3l1-4h-4V7c0-1 .3-1.7 1.8-1.7H17V1.8C16.6 1.7 15.4 1.6 14 1.6c-2.9 0-4.9 1.8-4.9 5V9H6v4h3.1v9z"/>'
  },
  {
    name: 'LinkedIn',
    url: site.social.linkedin || 'https://www.linkedin.com/company/teknoppy',
    bg: 'bg-[#0A66C2]',
    icon: '<path fill="currentColor" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>'
  },
  {
    name: 'Instagram',
    url: site.social.instagram || 'https://www.instagram.com/teknoppy',
    bg: 'bg-gradient-to-tr from-[#FF543E] via-[#C837AB] to-[#4F5BD5]',
    icon: '<path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>'
  },
  {
    name: 'YouTube',
    url: 'https://www.youtube.com/@teknoppy',
    bg: 'bg-[#FF0000]',
    icon: '<path fill="currentColor" d="M23 12s0-3.7-.5-5.5a2.9 2.9 0 0 0-2-2C18.7 4 12 4 12 4s-6.7 0-8.5.5a2.9 2.9 0 0 0-2 2C1 8.3 1 12 1 12s0 3.7.5 5.5a2.9 2.9 0 0 0 2 2C5.3 20 12 20 12 20s6.7 0 8.5-.5a2.9 2.9 0 0 0 2-2C23 15.7 23 12 23 12M9.8 15.5v-7l6 3.5z"/>'
  }
];
---

<Layout title={copy.title} description={copy.description} lang={lang} hideBottomBar={true}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-NHX2WJ39');</script>
    <!-- End Google Tag Manager -->

    {!EN && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
      </>
    )}
  </Fragment>

  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NHX2WJ39"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <!-- Official Teknoppy Header with Solid Background -->
  <Header forceSolidBg={true} />

  <!-- Main Thank You Section (Clean, centered, matching reference layout) -->
  <main class={`flex-grow pt-24 sm:pt-28 md:pt-36 pb-20 sm:pb-24 md:pb-32 bg-[#F8F9FA] text-neutral-900 ${!EN ? 'font-[\'Noto_Sans_Malayalam\',sans-serif]' : ''}`}>
    <div class="max-w-3xl mx-auto px-4 sm:px-6">

      <!-- Success Checkmark Icon (Matching the green circular badge from the reference) -->
      <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#05B67A] text-white flex items-center justify-center mx-auto mb-5 shadow-sm shadow-[#05B67A]/30">
        <Check className="w-8 h-8 sm:w-9 sm:h-9 stroke-[3]" />
      </div>

      <!-- Heading -->
      <h1 class="text-3xl sm:text-4xl lg:text-[42px] font-black text-[#1E293B] tracking-tight leading-tight text-center">
        {copy.heading}
      </h1>

      <!-- Subtitle Message -->
      <p class="mt-3.5 text-sm sm:text-base text-[#64748B] max-w-lg mx-auto leading-relaxed text-center font-normal">
        {copy.message}
      </p>

      <!-- Two Symmetrical Cards: Connect With Us & Visit Our Website -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10 sm:mt-12">
        
        <!-- CARD 1: Connect With Us -->
        <div class="bg-white rounded-2xl p-7 sm:p-9 shadow-[0_8px_30px_rgba(0,0,0,0.04)] border border-neutral-100/90 flex flex-col items-center justify-center text-center">
          <h2 class="text-lg sm:text-xl font-bold text-[#1E293B] mb-5 tracking-tight">
            {copy.connectTitle}
          </h2>

          <!-- Circular social & communication buttons row (matching reference) -->
          <div class="flex items-center justify-center gap-3 flex-wrap">
            {socialChannels.map((s) => (
              <a 
                href={s.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label={s.name}
                class={`w-10 h-10 rounded-full ${s.bg} text-white flex items-center justify-center transition-transform hover:scale-110 shadow-xs`}
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" set:html={s.icon} />
              </a>
            ))}
          </div>

          <!-- Subtle direct contact footer -->
          <div class="mt-5 pt-4 border-t border-neutral-100 w-full flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 text-xs font-semibold text-neutral-500">
            <a href={tel} class="hover:text-primary transition-colors flex items-center gap-1.5 whitespace-nowrap">
              <Phone className="w-3.5 h-3.5" />
              <span>{copy.phone}</span>
            </a>
            <span class="text-neutral-300 hidden sm:inline">•</span>
            <a href={`mailto:${copy.email}`} class="hover:text-primary transition-colors flex items-center gap-1.5 whitespace-nowrap">
              <Mail className="w-3.5 h-3.5" />
              <span>{copy.email}</span>
            </a>
          </div>
        </div>

        <!-- CARD 2: Visit Our Website -->
        <div class="bg-white rounded-2xl p-7 sm:p-9 shadow-[0_8px_30px_rgba(0,0,0,0.04)] border border-neutral-100/90 flex flex-col items-center justify-center text-center">
          <h2 class="text-lg sm:text-xl font-bold text-[#1E293B] mb-5 tracking-tight">
            {copy.visitTitle}
          </h2>

          <!-- Solid Green "Visit Website" Button (Matching the reference) -->
          <a 
            href="https://www.teknoppy.com/" 
            class="inline-flex items-center justify-center px-8 py-3 rounded-lg bg-[#05B67A] hover:bg-[#049d68] text-white font-bold text-sm sm:text-base shadow-[0_4px_14px_rgba(5,182,122,0.35)] hover:shadow-lg transition-all cursor-pointer min-w-[170px]"
          >
            <span>{copy.visitBtn}</span>
          </a>

          <!-- Subtle domain tag -->
          <div class="mt-5 pt-4 border-t border-neutral-100 w-full flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs font-semibold text-neutral-500">
            <span class="text-neutral-600 font-medium">teknoppy.com</span>
            <span class="text-neutral-300">•</span>
            <span class="text-neutral-400">{copy.websiteTag}</span>
          </div>
        </div>

      </div>

    </div>
  </main>

  <!-- Official Teknoppy Footer -->
  <Footer />
</Layout>
