---
import { ArrowRight, Calendar, Clock } from 'lucide-react';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((e) => ({
    title: e.data.title,
    excerpt: e.data.excerpt,
    image: e.data.cover,
    category: e.data.category,
    date: e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
    readTime: e.data.readTime,
    href: `/blog/${e.id}/`,
  }));
---

<section id="blog" class="py-10 sm:py-12 md:py-16 bg-white relative overflow-hidden">
  <!-- Soft Background Accent Glows -->
  <div class="absolute top-0 left-0 w-80 h-80 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-secondary/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-8 sm:mb-10 md:mb-12">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
          Our Blog
        </div>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 leading-tight">
          Insights & Latest <span class="text-primary">Articles</span>
        </h2>
      </div>
      <p class="text-neutral-600 text-sm md:text-base leading-relaxed max-w-sm">
        Stay updated with expert perspectives, strategies, and resources on web development and SEO in Kerala.
      </p>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7" data-stagger>
      {posts.map((post) => (
        <article class="group neu-card blog-card rounded-2xl overflow-hidden flex flex-col h-full">
          <!-- Image Container (3:2, the covers' own ratio, so nothing is cropped) -->
          <div class="blog-media overflow-hidden aspect-[3/2] bg-neutral-100 relative">
            <img 
              src={post.image} 
              alt={post.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>

          <!-- Card Content -->
          <div class="px-5 pt-4 pb-5 sm:px-6 sm:pb-6 flex flex-col flex-grow justify-between">
            <div class="space-y-3 sm:space-y-3.5">
              <!-- Meta Info -->
              <div class="flex flex-wrap items-center gap-2 text-xs font-medium text-neutral-500">
                <span class="blog-chip flex items-center gap-1.5">
                  <Calendar class="w-3.5 h-3.5" />
                  {post.date}
                </span>
                <span class="blog-chip flex items-center gap-1.5">
                  <Clock class="w-3.5 h-3.5" />
                  {post.readTime}
                </span>
              </div>

              <!-- Title -->
              <h3 class="text-base sm:text-lg md:text-[1.125rem] font-bold text-neutral-900 leading-snug group-hover:text-primary transition-colors duration-300">
                <a href={post.href}>{post.title}</a>
              </h3>

              <!-- Excerpt -->
              <p class="text-xs sm:text-[0.84rem] text-neutral-500 leading-relaxed font-normal">
                {post.excerpt}
              </p>
            </div>

            <!-- Read More CTA -->
            <div class="pt-3 mt-3 border-t border-neutral-100">
              <a 
                href={post.href} 
                class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-neutral-850 hover:text-primary transition-colors duration-300"
              >
                Read Article
                <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Subtle Contextual CTA: After Blog Insights -->
    <div class="cta-reveal mt-14 pt-8 border-t border-neutral-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <p class="text-sm text-neutral-600 font-medium">
        Looking for advice tailored to your industry and growth goals?
      </p>
      <a
        href="/request-a-quote/"
        class="cta-float-secondary cta-float-sway cta-delay-15 cta-pulse-medium cta-pulse-delay-2 inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-neutral-900 transition-colors group shrink-0 rounded-full px-3 py-1.5 -mx-3"
      >
        <span>Have a Project in Mind? Let's Talk</span>
        <ArrowRight className="cta-arrow cta-arrow-invite w-4 h-4" />
      </a>
    </div>
  </div>
</section>

<style>
  /* Blog cards: distinct white-to-cream panels with a warm border and soft depth.
     Doubled class so these win over the shared .neu-card surface without editing it. */
  .blog-card.neu-card {
    background: linear-gradient(180deg, #ffffff 0%, #fff8f2 100%);
    border: 1px solid rgba(240, 90, 44, 0.18);
    border-radius: 1.25rem;
    box-shadow:
      0 1px 0 #ffffff inset,
      0 2px 6px rgba(120, 50, 20, 0.06),
      0 22px 44px -24px rgba(160, 60, 20, 0.38);
    isolation: isolate;
  }
  .blog-card.neu-card:hover { border-color: rgba(240, 90, 44, 0.38); }

  /* Image sits inset inside the card with its own rounded corners */
  .blog-media {
    margin: 0.6rem 0.6rem 0;
    border-radius: 0.9rem;
    border: 1px solid rgba(120, 50, 20, 0.06);
  }

  /* Date and reading time as small cream chips, separated from the title */
  .blog-chip {
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    background: #fff1e7;
    border: 1px solid rgba(240, 90, 44, 0.12);
    color: #7a5a48;
  }
  .blog-chip :global(svg) { color: var(--color-primary); }
</style>
