---
const logos = [
  { name: 'Abroad Career', src: '/client logos/Abroad-career-1.jpg' },
  { name: 'Abu Dhabi', src: '/client logos/abu-dhabi.jpg' },
  { name: 'Al Coffee', src: '/client logos/al-coffee-1.jpg' },
  { name: 'Amster', src: '/client logos/amster.jpg' },
  { name: 'AR', src: '/client logos/ar.jpg' },
  { name: 'First Class', src: '/client logos/first-class.jpg' },
  { name: 'Kewsa', src: '/client logos/kewsa.jpg' },
  { name: 'Laughing Waters', src: '/client logos/laughing-waters.jpg' },
  { name: 'Metal Center', src: '/client logos/metal-center.jpg' },
  { name: 'Olive', src: '/client logos/olive.jpg' },
  { name: 'Qrystal', src: '/client logos/qrystal.jpg' },
  { name: 'Rakshak', src: '/client logos/rakshak.jpg' },
  { name: 'Simov', src: '/client logos/simov-1.jpg' },
  { name: 'Studim Assist', src: '/client logos/studim-assist.jpg' },
  { name: 'Vinhar', src: '/client logos/vinhar.jpg' },
  { name: 'Web Design Cochin', src: '/client logos/web-design-cochin.jpg' },
  { name: 'Westn', src: '/client logos/westn.jpg' },
];
---

<section class="py-10 md:py-16 bg-[#FAFAFA] border-y border-border/40 relative z-10">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
    
    <!-- Section Title -->
    <div class="mb-10 flex flex-col items-center xl:items-start">
      <p class="text-xs sm:text-sm font-extrabold text-black uppercase tracking-[0.22em] relative pb-3 after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 xl:after:left-0 xl:after:translate-x-0 after:w-16 after:h-0.5 after:bg-primary">
        Trusted by <span class="text-primary font-black">120+ Brands</span> & Growing Businesses
      </p>
    </div>
    
    <!-- Swipeable track on mobile / Grid on desktop -->
    <div class="relative flex items-center w-full">
      <!-- Gradient fades for swipe indicators on mobile -->
      <div class="absolute left-0 top-0 bottom-0 w-10 bg-gradient-to-r from-[#FAFAFA] to-transparent z-10 pointer-events-none md:hidden"></div>
      <div class="absolute right-0 top-0 bottom-0 w-10 bg-gradient-to-l from-[#FAFAFA] to-transparent z-10 pointer-events-none md:hidden"></div>
      
      <div class="w-full flex md:grid md:grid-cols-6 lg:grid-cols-9 overflow-x-auto md:overflow-x-visible snap-x snap-mandatory gap-8 md:gap-x-8 md:gap-y-10 items-center justify-start md:justify-items-center pb-4 md:pb-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {logos.map(logo => (
          <div class="h-10 w-24 md:w-full max-w-[100px] shrink-0 snap-center flex items-center justify-center transition-all duration-300 hover:scale-105">
            <img 
              src={logo.src} 
              alt={`${logo.name} logo`} 
              class="max-h-full max-w-full object-contain opacity-70 grayscale mix-blend-multiply hover:opacity-100 hover:grayscale-0 transition-all duration-300 cursor-pointer"
            />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
