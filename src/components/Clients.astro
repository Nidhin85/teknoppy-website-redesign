---
// Roster lives in src/data/clients.json so the homepage strip, the testimonial
// grid and the /clients/ page never drift apart.
import clients from '../data/clients.json';
const logos = clients.logos;
---

<section class="py-10 md:py-16 bg-soft border-y border-border/40 relative z-10">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
    
    <!-- Section Title -->
    <div class="mb-10 flex flex-col items-center xl:items-start">
      <p class="text-xs sm:text-sm font-extrabold text-black uppercase tracking-[0.22em] relative pb-3 after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 xl:after:left-0 xl:after:translate-x-0 after:w-16 after:h-0.5 after:bg-primary">
        Trusted by <span class="text-primary font-black">120+ Brands</span> & Growing Businesses
      </p>
    </div>
    
    <!-- Swipeable track on mobile / Grid on desktop -->
    <div class="relative flex items-center w-full">
      <!-- Gradient fades for swipe indicators on mobile -->
      <div class="absolute left-0 top-0 bottom-0 w-10 bg-gradient-to-r from-soft to-transparent z-10 pointer-events-none md:hidden"></div>
      <div class="absolute right-0 top-0 bottom-0 w-10 bg-gradient-to-l from-soft to-transparent z-10 pointer-events-none md:hidden"></div>
      
      <div class="w-full flex md:grid md:grid-cols-6 lg:grid-cols-9 overflow-x-auto md:overflow-x-visible snap-x snap-mandatory gap-8 md:gap-x-8 md:gap-y-10 items-center justify-start md:justify-items-center pb-4 md:pb-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {logos.map(logo => (
          <div class="logo-plate h-10 w-24 md:w-full max-w-[100px] shrink-0 snap-center flex items-center justify-center transition-all duration-300 hover:scale-105">
            <img 
              src={logo.src} 
              alt={`${logo.name} logo`} 
              class="max-h-full max-w-full object-contain mix-blend-multiply transition-transform duration-300"
            />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
