---
import '../styles/global.css';
import '../styles/motion.css';
import site from '../data/site.json';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import BottomActionBar from '../components/BottomActionBar.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import MagneticTypography from '../components/MagneticTypography.astro';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative share image. Defaults to the brand OG card. */
  image?: string;
  canonical?: string;
  lang?: string;
  hideBottomBar?: boolean;
  showBottomBar?: boolean;
  hideFloatingCta?: boolean;
  floatingCtaLabel?: string;
  floatingCtaHref?: string;
}

const {
  title,
  description,
  image = '/og-image.png',
  canonical,
  lang = 'en',
  hideBottomBar = false,
  showBottomBar,
  hideFloatingCta = false,
  floatingCtaLabel,
  floatingCtaHref
} = Astro.props;

// Default SEO values
const siteName = "Teknoppy";
const canonicalURL = canonical 
  ? new URL(canonical) 
  : new URL(Astro.url.pathname, Astro.site || 'https://www.teknoppy.com');
// Social crawlers reject relative paths — always resolve against the site origin.
const ogImageURL = new URL(image, Astro.site || 'https://www.teknoppy.com');

// The 3-part Action Bar is page-specific: visible ONLY on /web-design-company-kochi/
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isKochiPage = currentPath === '/web-design-company-kochi';
const isHomePage = currentPath === '' || currentPath === '/';
const displayBottomBar = (showBottomBar ?? isKochiPage) && !hideBottomBar;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <!-- The site is light-only. Declaring the single scheme keeps form controls,
         scrollbars and the address bar light even when the OS is set to dark. -->
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FCFCFC" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Trustpilot domain ownership verification -->
    <meta name="trustpilot-one-time-domain-verification-id" content="3bd88369-90f9-4613-9901-b33402a14e43" />

    <!-- Google Search Console domain ownership verification -->
    <meta name="google-site-verification" content="EBj0l3rFwuhxhBYohPzxR4v3ELhcyE7_JlLBBjQj12M" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Sora + Inter typography stack matching reference editorial clarity: display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" />
    </noscript>
    
    <!-- Slot for additional head elements like Schema.org scripts -->
    <slot name="head" />
  </head>
  <body id="top" class={`min-h-screen flex flex-col relative pb-20 md:pb-0 ${isHomePage ? 'is-homepage' : ''} ${isKochiPage ? 'is-kochi-page' : ''}`}>
    <slot />

    <!-- Sitewide Continuously Floating CTA System -->
    <FloatingCTA
      hide={hideFloatingCta}
      label={floatingCtaLabel}
      href={floatingCtaHref}
    />

    <!-- Floating WhatsApp button (tablet + desktop; the bar below covers phones) -->
    <WhatsAppFab />

    <!-- Fixed 3-Part Bottom Action Bar (CALL NOW | WHATSAPP | FREE QUOTE) - Kochi Page Only -->
    {displayBottomBar && (
      <BottomActionBar />
    )}

    <style is:global>
      @keyframes shimmer {
        100% {
          transform: translateX(100%);
        }
      }
    </style>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {

        // CTA Scroll Reveal & Side-Slide Observer
        const ctaElements = document.querySelectorAll('.cta-reveal, .cta-slide-left, .cta-slide-right, .cta-checkpoint');
        if (ctaElements.length > 0) {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            ctaElements.forEach((el) => el.classList.add('is-revealed'));
          } else {
            const ctaObserver = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-revealed');
                    ctaObserver.unobserve(entry.target);
                  }
                });
              },
              { threshold: 0.15, rootMargin: '0px 0px -30px 0px' }
            );
            ctaElements.forEach((el) => ctaObserver.observe(el));
          }
        }

        // Homepage Floating CTA & Attention Glow Observer (Homepage Only)
        if (document.body.classList.contains('is-homepage')) {
          const floatingButtons = document.querySelectorAll(
            '.cta-float-primary, .cta-float-secondary, .cta-float-sway, .cta-pulse-strong, .cta-pulse-medium, .cta-pulse-subtle'
          );
          if (floatingButtons.length > 0) {
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              const floatObserver = new IntersectionObserver(
                (entries) => {
                  entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                      entry.target.classList.add('is-floating');
                      entry.target.classList.add('is-pulsing');
                    } else {
                      entry.target.classList.remove('is-floating');
                      entry.target.classList.remove('is-pulsing');
                    }
                  });
                },
                { threshold: 0.1, rootMargin: '60px 0px 60px 0px' }
              );
              floatingButtons.forEach((btn) => floatObserver.observe(btn));
            }
          }
        }

        // Web Design Company Kochi CTA Observer (Kochi Page Only)
        if (document.body.classList.contains('is-kochi-page')) {
          const kochiCtas = document.querySelectorAll('.kochi-cta');
          if (kochiCtas.length > 0) {
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              const kochiObserver = new IntersectionObserver(
                (entries) => {
                  entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                      entry.target.classList.add('is-in-view');
                    } else {
                      entry.target.classList.remove('is-in-view');
                    }
                  });
                },
                { threshold: 0.1, rootMargin: '40px 0px 40px 0px' }
              );
              kochiCtas.forEach((btn) => kochiObserver.observe(btn));
            }
          }
        }

        // Subtle Desktop Magnetic CTA Interaction (Selected high-intent checkpoints only)
        if (
          window.matchMedia &&
          window.matchMedia('(pointer: fine) and (hover: hover)').matches &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.querySelectorAll('[data-magnetic-btn]').forEach((btn) => {
            btn.addEventListener('mousemove', (e) => {
              const rect = btn.getBoundingClientRect();
              const x = e.clientX - rect.left - rect.width / 2;
              const y = e.clientY - rect.top - rect.height / 2;
              const pullX = Math.max(-4, Math.min(4, x * 0.1));
              const pullY = Math.max(-4, Math.min(4, y * 0.1));
              btn.style.transform = `translate(${pullX}px, ${pullY}px)`;
            });
            btn.addEventListener('mouseleave', () => {
              btn.style.transform = '';
            });
          });
        }
      });
    </script>
    <MagneticTypography />
    <script src="../scripts/motion.js"></script>
  </body>
</html>
