---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Default SEO values
const siteName = "Teknoppy";
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://teknoppy.com');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <!-- Image for OG -->
    <!-- <meta property="og:image" content={new URL('/og-image.jpg', Astro.url)} /> -->

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <!-- <meta property="twitter:image" content={new URL('/og-image.jpg', Astro.url)} /> -->

    <!-- Fonts: Geist (via unpkg or similar) and Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Slot for additional head elements like Schema.org scripts -->
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col relative pb-20 md:pb-0">
    <slot />

    <!-- Premium Sticky Bottom CTA Bar (Mobile Only) -->
    <div class="fixed bottom-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-xl border-t border-border/80 px-4 py-3 flex justify-between items-center gap-3 md:hidden shadow-[0_-10px_40px_rgba(0,0,0,0.08)] pb-safe">
      <div class="flex gap-2 flex-[0.8]">
        <a href="tel:+916282249224" class="flex-1 flex items-center justify-center h-12 bg-gray-50 hover:bg-gray-100 rounded-xl border border-border/80 transition-colors" aria-label="Call Us">
          <svg class="w-5 h-5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        </a>
        <a href="https://wa.me/916282249224" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center h-12 bg-[#25D366]/10 hover:bg-[#25D366]/20 rounded-xl border border-[#25D366]/20 transition-colors" aria-label="WhatsApp">
          <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>
      </div>
      <a href="#consultation" class="flex-[1.2] flex items-center justify-center h-12 px-4 text-[15px] font-black text-white bg-primary rounded-xl shadow-[0_4px_14px_0_rgba(249,98,50,0.39)] hover:shadow-[0_6px_20px_rgba(249,98,50,0.23)] hover:bg-[#E55A2D] transition-all relative overflow-hidden group">
        <span class="absolute inset-0 w-full h-full -ml-[-100%] bg-gradient-to-r from-transparent via-white/20 to-transparent animate-[shimmer_2s_infinite]"></span>
        Get Free Quote
      </a>
    </div>

    <style is:global>
      @supports (padding-bottom: env(safe-area-inset-bottom)) {
        .pb-safe {
          padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));
        }
      }
      @keyframes shimmer {
        100% {
          transform: translateX(100%);
        }
      }
    </style>
  </body>
</html>
