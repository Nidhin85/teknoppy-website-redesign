---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowUpRight, Play, Rocket, Users, Calendar, LayoutGrid, Star, Phone, Mail, SearchCheck, Award, Wallet, MapPin, LifeBuoy } from 'lucide-react';
import about from '../data/pages/about.json';
import { aboutUsSchema } from '../data/schemas/aboutUsSchema';

const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).map(w => w[0]).join('').slice(0, 2).toUpperCase();

const title = "About Teknoppy | Web & Digital Agency in Kochi";
const description = "Meet Teknoppy - a Kochi web design, development and digital marketing team founded in 2018 by Sanal Edison. Our story, people and how we work.";

const stats = [
  { value: "120+", label: "Websites Delivered", icon: Rocket },
  { value: "100+", label: "Kerala Clients Served", icon: Users },
  { value: "8 Years", label: "In Business", icon: Calendar },
  { value: "12+", label: "Industries Covered", icon: LayoutGrid }
];

const values = [
  {
    title: "SEO From Day One",
    desc: "We do not bolt SEO on after launch. Every project begins with keyword research, structured data planning, and Core Web Vitals benchmarking — making SEO-friendly website design Kerala businesses need a foundational principle, not an afterthought."
  },
  {
    title: "Proven Track Record",
    desc: "As a Web Design Company in Kerala with over 120 completed projects, our work speaks louder than promises. Clients across Kochi, Thrissur, Kozhikode, and Ernakulam have seen measurable improvements in search rankings, lead generation, and website engagement within the first 90 days of launch."
  },
  {
    title: "Clear, Transparent Pricing",
    desc: "We believe every Kerala business — from a Thrissur-based startup to a Kochi enterprise — deserves a world-class website at a fair price. Our affordable website design Kerala packages are transparent, clearly scoped, and delivered on time with zero hidden costs."
  },
  {
    title: "Local Market Knowledge",
    desc: "Our team lives and works in Kerala. We understand how Kerala buyers search online, what local businesses need to stand out in competitive markets, and how to position your brand for both statewide and city-level search visibility."
  },
  {
    title: "One Team, Start to Finish",
    desc: "Design, development, content integration, SEO setup, speed optimisation, schema markup, and post-launch support — Teknoppy delivers a technically sound, conversion-focused website under one roof so you never need to coordinate multiple vendors."
  },
  {
    title: "Support After Launch",
    desc: "Our relationship does not end at launch. Every client receives dedicated post-launch support, performance monitoring, and proactive maintenance to ensure your website continues to rank, load fast, and convert visitors into leads long after going live."
  }
];

// decorative icons for the values cards (index-matched with values)
const valueIcons = [SearchCheck, Award, Wallet, MapPin, Users, LifeBuoy];

const testimonials = [
  {
    quote: "We now rank at the top of Google for our keywords and get many direct booking calls due to better visibility. Thank you Teknoppy for all the support.",
    author: "Biju Thomas",
    role: "CEO, Olives Resort, Wayanad"
  },
  {
    quote: "Being in the Fintech space, we needed a reliable partner. Teknoppy created an appealing website that represents our brand perfectly.",
    author: "Vivek Menon",
    role: "CTO, Evosyz, Kochi"
  },
  {
    quote: "I have worked with many IT teams, but I am 100% happy with Teknoppy. No doubt, I recommend them with 100% satisfaction.",
    author: "Dr. Asghar",
    role: "CEO, Greens Ayurveda, Calicut"
  }
];
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutUsSchema)} />
  </Fragment>

  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <!-- HERO SECTION (reference layout: text left, framed team photo right, stat cards row, wave) -->
    <section class="ds-hero about-hero relative pt-28 pb-24 md:pt-36 md:pb-28 overflow-hidden bg-[#fff8f2] text-neutral-900">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="ds-hero-glow absolute inset-0"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">
          <!-- Hero Text -->
          <div class="lg:col-span-6 flex flex-col items-start text-left">
            <div class="ds-eyebrow uppercase tracking-[0.22em] text-sm mb-6">
              About Us
            </div>
            <h1 class="text-[44px] sm:text-6xl lg:text-[64px] xl:text-[72px] font-black leading-[1.04] tracking-[-0.035em] text-neutral-900 mb-7">
              About
              <span class="relative inline-block text-primary">
                Teknoppy
                <svg class="absolute -bottom-3 left-0 w-full h-3 text-primary" viewBox="0 0 100 12" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3 9C28 3 66 2 97 6" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
                </svg>
              </span>
            </h1>
            <p class="text-lg sm:text-xl lg:text-[22px] text-neutral-800 mb-5 max-w-xl font-semibold leading-snug">
              Kerala's Professional Web Design & Digital Agency — building high-performance websites that rank, convert, and grow, since 2018.
            </p>
            <p class="text-[15px] sm:text-base text-neutral-500 mb-9 max-w-xl leading-relaxed">
              Teknoppy Kerala is a full-service digital agency founded and headquartered in Kochi, serving businesses across Kerala, Thrissur, and South India. Led by Sanal and a dedicated team of designers, developers, and SEO strategists, we have been building high-performance websites since 2018.
            </p>

            <div class="flex flex-col min-[420px]:flex-row items-stretch min-[420px]:items-center gap-3 sm:gap-4 w-full sm:w-auto">
              <a href="#contact" class="inline-flex items-center justify-center gap-2.5 px-7 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_10px_26px_-6px_rgba(240,90,44,0.55)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 leading-snug whitespace-nowrap">
                Get in Touch
                <ArrowUpRight class="w-4 h-4" />
              </a>
              <a href="#story" class="inline-flex items-center justify-center gap-3 pl-2.5 pr-7 py-2.5 text-base font-bold text-neutral-900 bg-white/70 border border-neutral-200 rounded-full hover:bg-white hover:border-primary/30 transition-all duration-300 shadow-sm leading-snug whitespace-nowrap">
                <span class="w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center">
                  <Play class="w-3.5 h-3.5 ml-0.5" fill="currentColor" size={14} />
                </span>
                Our Story
              </a>
            </div>
          </div>

          <!-- Hero Visual: team photo in an organic orange frame -->
          <div class="lg:col-span-6">
            <div class="about-visual relative mx-auto w-full max-w-[560px] lg:max-w-none">
              <span class="about-blob about-blob--back" aria-hidden="true"></span>
              <span class="about-blob about-blob--ring" aria-hidden="true"></span>
              <span class="about-blob about-blob--dot" aria-hidden="true"></span>
              <span class="about-blob about-blob--pill" aria-hidden="true"></span>
              <div class="about-photo">
                <img src="/images/life/teknoppy-core-team-portrait.jpg" alt="The Teknoppy team at the Kochi studio" width="1024" height="682" loading="eager" decoding="async" fetchpriority="high" />
              </div>
            </div>
          </div>
        </div>

        <!-- Hero Stats Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 mt-16 lg:mt-20">
          {stats.map(stat => {
            const IconComp = stat.icon;
            return (
              <div class="bg-white border border-primary/10 rounded-[1.5rem] sm:rounded-[1.75rem] p-5 sm:p-7 shadow-[0_24px_50px_-30px_rgba(160,60,20,0.45)] hover:border-primary/25 hover:-translate-y-1 transition-all duration-300 flex flex-col sm:flex-row sm:items-center gap-4 group">
                <div class="w-12 h-12 sm:w-14 sm:h-14 shrink-0 rounded-2xl flex items-center justify-center text-primary bg-gradient-to-br from-[#fff1e8] to-[#ffe0cc] group-hover:scale-105 transition-transform">
                  <IconComp class="w-6 h-6" />
                </div>
                <div class="min-w-0">
                  <span class="text-[26px] sm:text-3xl font-black text-neutral-900 block leading-none mb-2 tracking-tight">{stat.value}</span>
                  <span class="text-[10.5px] sm:text-[11px] font-bold text-neutral-500 uppercase tracking-[0.14em] leading-snug block">{stat.label}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Orange wave decoration -->
      <svg class="about-wave absolute bottom-0 left-0 w-full h-16 sm:h-24 pointer-events-none" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="aboutWave" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#ffb07c" stop-opacity="0.55" />
            <stop offset="0.55" stop-color="#ff7a3d" stop-opacity="0.75" />
            <stop offset="1" stop-color="#f05a2c" />
          </linearGradient>
        </defs>
        <path d="M0 92C220 60 420 112 700 86C960 62 1180 30 1440 54V120H0Z" fill="url(#aboutWave)" opacity="0.35" />
        <path d="M0 108C260 84 520 120 820 100C1060 84 1260 62 1440 78V120H0Z" fill="url(#aboutWave)" />
      </svg>
    </section>

    <style>
      .about-visual { aspect-ratio: 1.18 / 1; }
      .about-photo {
        position: absolute; inset: 6% 5% 7% 7%;
        border-radius: 46% 54% 42% 58% / 38% 40% 60% 62%;
        overflow: hidden;
        transform: rotate(-3deg);
        box-shadow: 0 40px 80px -36px rgba(160, 60, 20, 0.55), 0 0 0 6px rgba(255, 255, 255, 0.85);
        z-index: 2;
      }
      .about-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; transform: rotate(3deg) scale(1.08); }
      .about-blob { position: absolute; pointer-events: none; }
      .about-blob--back {
        inset: 0 0 2% 12%;
        border-radius: 58% 42% 55% 45% / 45% 52% 48% 55%;
        background: radial-gradient(120% 90% at 25% 20%, #ffd2b4 0%, #ff9a5c 38%, #f05a2c 72%, #c9421c 100%);
        box-shadow: inset 0 18px 40px rgba(255, 255, 255, 0.45), inset 0 -24px 50px rgba(150, 40, 10, 0.35);
        transform: rotate(8deg);
        z-index: 1;
      }
      .about-blob--ring {
        inset: 3% 2% 4% 4%;
        border-radius: 44% 56% 40% 60% / 40% 42% 58% 60%;
        border: 2px solid rgba(240, 90, 44, 0.35);
        transform: rotate(-9deg);
        z-index: 1;
      }
      .about-blob--dot {
        width: 17%; aspect-ratio: 1; left: -1%; bottom: 6%;
        border-radius: 50%;
        background: radial-gradient(circle at 32% 28%, #fff3ea 0%, #ffb27f 30%, #f05a2c 70%, #b83a16 100%);
        box-shadow: 0 18px 30px -12px rgba(200, 70, 20, 0.6);
        z-index: 3;
      }
      .about-blob--pill {
        width: 26%; height: 9%; right: 2%; top: 2%;
        border-radius: 999px;
        background: linear-gradient(120deg, #ffe1cc 0%, #ff8a4a 55%, #f05a2c 100%);
        box-shadow: inset 0 4px 10px rgba(255, 255, 255, 0.6), 0 14px 26px -12px rgba(200, 70, 20, 0.55);
        transform: rotate(-18deg);
        z-index: 3;
      }
      @media (prefers-reduced-motion: no-preference) {
        .about-blob--dot { animation: aboutFloat 7s ease-in-out infinite; }
        .about-blob--pill { animation: aboutFloat 8s ease-in-out -3s infinite; }
      }
      @keyframes aboutFloat { 0%, 100% { translate: 0 0; } 50% { translate: 0 -10px; } }
    </style>

    <!-- STORY SECTION (reference: copy left, framed studio photo right) -->
    <section id="story" class="ab-sec relative py-16 sm:py-20 lg:py-24 overflow-hidden">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.webp')] opacity-30"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10 grid lg:grid-cols-12 gap-12 lg:gap-14 items-center">
        <div class="lg:col-span-6">
          <div class="ab-pill mb-5">Our Story</div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-[1.08] tracking-[-0.03em] mb-6">
            Who We <span class="text-primary">Are</span>
          </h2>
          <div class="space-y-5">
            <p class="text-neutral-700 font-medium text-base sm:text-[17px] leading-relaxed">
              As a professional web design agency Kerala businesses have trusted since 2018, we bring together creative design and technical precision to deliver websites that rank, convert, and represent your brand with authority. From custom website design Kerala startups need to enterprise-level web development Kerala corporations demand — our work spans industries, project sizes, and business goals.
            </p>
            <p class="text-neutral-500 font-medium text-[15px] sm:text-base leading-relaxed">
              We have delivered over 120 successful websites across healthcare, retail, hospitality, education, real estate, and manufacturing sectors. Every project begins with strategy and ends with measurable results.
            </p>
          </div>
        </div>
        <div class="lg:col-span-6">
          <div class="story-visual relative mx-auto w-full max-w-[560px]">
            <span class="story-back" aria-hidden="true"></span>
            <div class="story-photo">
              <img src="/images/life/teknoppy-team-inhouse-studio.webp" alt="The Teknoppy team in front of the Teknoppy logo wall at the Kochi studio" width="1024" height="682" loading="lazy" decoding="async" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VALUES SECTION (reference: 3x2 icon cards) -->
    <section class="ab-sec-alt relative py-16 sm:py-20 lg:py-24 overflow-hidden">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.webp')]" style="opacity: 0.25;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-10 sm:mb-12">
          <div class="ab-pill mb-5">Why Teknoppy</div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-[1.08] tracking-[-0.03em]">
            Why Kerala Businesses <span class="text-primary">Choose Teknoppy</span>
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 lg:gap-6">
          {values.map((val, idx) => {
            const VIcon = valueIcons[idx] ?? Rocket;
            return (
              <div class="ab-card p-6 sm:p-7 flex flex-col group">
                <div class="flex items-center justify-between mb-5">
                  <span class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#fff1e8] to-[#ffe0cc] text-primary flex items-center justify-center transition-colors duration-300 group-hover:from-primary group-hover:to-primary group-hover:text-white">
                    <VIcon class="w-6 h-6" />
                  </span>
                  <span class="text-xs font-bold text-primary/60 tracking-widest">{String(idx + 1).padStart(2, '0')}</span>
                </div>
                <h3 class="text-lg font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-2.5 leading-snug">{val.title}</h3>
                <p class="text-neutral-500 text-sm leading-relaxed">{val.desc}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- TEAM SECTION (reference: founder feature card + member grid) -->
    <section class="ab-sec relative py-16 sm:py-20 lg:py-24 overflow-hidden">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.webp')]" style="opacity: 0.35;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
          <div class="ab-pill mb-5">{about.team.badge}</div>
          <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-[1.08] tracking-[-0.03em]">
            {about.team.heading} <span class="text-primary">{about.team.headingAccent}</span>
          </h2>
        </div>

        <div class="max-w-4xl mx-auto">
          <!-- Founder — featured card -->
          <div class="ab-card p-5 sm:p-7 lg:p-8 flex flex-col md:flex-row items-center md:items-start gap-6 lg:gap-9">
            <!-- Founder Image — full portrait, falls back to the square headshot -->
            <div class="relative w-48 sm:w-56 flex-shrink-0 aspect-[3/4] rounded-2xl overflow-hidden bg-warm shadow-[0_18px_36px_-22px_rgba(120,40,10,0.55)] flex items-center justify-center">
              <span class="absolute text-5xl font-black text-primary/15 select-none">{initials(about.team.founder.name)}</span>
              <img
                src={about.team.founder.photo}
                alt={about.team.founder.photoAlt}
                decoding="async"
                data-fallback={about.team.founder.photoFallback}
                onerror="if(this.dataset.fallback&&this.src.indexOf(this.dataset.fallback)===-1){this.src=this.dataset.fallback}else{this.remove()}"
                class="relative w-full h-full object-contain"
              />
            </div>

            <!-- Founder Content -->
            <div class="flex-1 text-center md:text-left md:pt-2">
              <div class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-3 mb-3">
                <h3 class="text-2xl sm:text-[28px] font-black text-neutral-900 tracking-tight">{about.team.founder.name}</h3>
                <p class="text-sm text-primary font-semibold">{about.team.founder.role}</p>
              </div>
              <div class="flex flex-col sm:flex-row items-center md:items-start justify-center md:justify-start gap-2.5 sm:gap-5 mb-5">
                <a href={`mailto:${about.team.founder.email}`} class="inline-flex items-center gap-2 text-xs font-bold text-neutral-600 hover:text-primary transition-colors">
                  <Mail class="w-4 h-4 text-primary" />
                  {about.team.founder.email}
                </a>
                <a href={`tel:${about.team.founder.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 text-xs font-bold text-neutral-600 hover:text-primary transition-colors">
                  <Phone class="w-4 h-4 text-primary" />
                  {about.team.founder.phone}
                </a>
              </div>
              <p class="text-neutral-600 text-sm sm:text-[15px] leading-relaxed">
                {about.team.founder.bio}
              </p>
            </div>
          </div>
        </div>

        <!-- The rest of the team -->
        {about.team.members?.length > 0 && (
          <div class="mt-12 sm:mt-14">
            {about.team.membersHeading && (
              <h3 class="text-center text-xs font-bold text-neutral-400 uppercase tracking-[0.2em] mb-7">
                {about.team.membersHeading}
              </h3>
            )}
            <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-5">
                {about.team.members.map((m: any) => (
                  <div class="group ab-card overflow-hidden flex flex-col">
                    <!-- Head-and-shoulders crop (reference layout), anchored near the top so faces stay in frame -->
                    <div class="relative w-full aspect-square bg-gradient-to-b from-[#fbf3ec] to-[#f4e6da] flex items-center justify-center overflow-hidden">
                      <span class="absolute text-5xl font-black text-primary/15 select-none">{initials(m.name)}</span>
                      <img
                        src={m.photo}
                        alt={m.photoAlt ?? m.name}
                        loading="lazy"
                        decoding="async"
                        onerror="this.remove()"
                        class="relative w-full h-full object-cover object-[50%_12%] group-hover:scale-[1.03] transition-transform duration-500"
                      />
                    </div>
                    <div class="p-4 sm:p-5 flex flex-col flex-1">
                      <h4 class="text-[15px] sm:text-base font-bold text-neutral-900 leading-snug">{m.name}</h4>
                      <p class="text-xs sm:text-[13px] text-primary font-semibold mt-1 leading-snug">{m.role}</p>
                      <p class="text-neutral-500 text-xs leading-relaxed mt-3 pt-3 border-t border-neutral-100">{m.bio}</p>
                    </div>
                  </div>
            ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- CLIENT TESTIMONIALS SECTION -->
    <section class="ab-sec-alt relative py-16 sm:py-20">
      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
          <div class="ab-pill mb-5">Testimonials</div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-[1.08] tracking-[-0.03em]">
            What Our <span class="text-primary">Clients Say</span> About Teknoppy
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 lg:gap-6">
          {testimonials.map(item => (
            <div class="ab-card p-6 sm:p-7 flex flex-col justify-between">
              <div>
                <div class="flex gap-1 text-[#F9AE42] mb-4">
                  <Star class="w-4 h-4" fill="currentColor" />
                  <Star class="w-4 h-4" fill="currentColor" />
                  <Star class="w-4 h-4" fill="currentColor" />
                  <Star class="w-4 h-4" fill="currentColor" />
                  <Star class="w-4 h-4" fill="currentColor" />
                </div>
                <p class="text-sm text-neutral-700 font-medium leading-relaxed mb-6">
                  "{item.quote}"
                </p>
              </div>
              <div class="border-t border-neutral-100 pt-4 mt-auto">
                <span class="block text-sm font-bold text-neutral-900">{item.author}</span>
                <span class="block text-xs text-primary font-semibold mt-0.5">{item.role}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <!-- FAQ — questions reused from the pages that own them (see about.json).
         FAQPage schema is intentionally left with those source pages so the same
         Q&A entities are not marked up on two URLs. -->
    <section class="ab-sec relative py-16 sm:py-20">
      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <div class="ab-pill mb-5">{about.faq.badge}</div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-[1.08] tracking-[-0.03em]">
            {about.faq.heading}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {about.faq.intro}
          </p>
        </div>

        <div class="max-w-3xl mx-auto ab-card overflow-hidden">
          {about.faq.items.map((faq: any) => (
            <details class="ab-faq group px-5 sm:px-7 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer gap-4 py-4 sm:py-5 focus-visible:outline-2 focus-visible:outline-primary rounded-lg">
                <h3 class="text-sm sm:text-[15px] font-bold text-neutral-900">{faq.q}</h3>
                <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24">
                    <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </summary>
              <div class="pb-5 text-sm text-neutral-600 leading-relaxed">
                {faq.aHtml ? <Fragment set:html={faq.aHtml} /> : faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <style>
      .ab-sec { background: linear-gradient(180deg, #fffaf6 0%, #fff6ef 100%); }
      .ab-sec-alt { background: linear-gradient(180deg, #fff6ef 0%, #fffaf6 100%); }
      .ab-pill {
        display: inline-flex; align-items: center; padding: 0.35rem 0.9rem; border-radius: 999px;
        background: #ffe8db; color: var(--color-primary); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.01em;
      }
      .ab-card {
        background: #fff; border: 1px solid rgba(240, 90, 44, 0.09); border-radius: 1.5rem;
        box-shadow: 0 24px 50px -34px rgba(160, 60, 20, 0.45);
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      }
      .ab-card:is(.group):hover { transform: translateY(-3px); border-color: rgba(240, 90, 44, 0.22); box-shadow: 0 30px 56px -32px rgba(160, 60, 20, 0.5); }
      .ab-faq + .ab-faq { border-top: 1px solid #f1ede9; }
      .story-visual { aspect-ratio: 1.25 / 1; }
      .story-back {
        position: absolute; inset: 4% 0 0 8%;
        border-radius: 2.25rem;
        background: linear-gradient(135deg, #ffd2b4 0%, #ff9a5c 45%, #f05a2c 100%);
        transform: rotate(6deg);
        box-shadow: inset 0 14px 30px rgba(255, 255, 255, 0.4), 0 30px 60px -30px rgba(200, 70, 20, 0.6);
      }
      .story-photo {
        position: absolute; inset: 2% 6% 6% 2%;
        border-radius: 2rem; overflow: hidden;
        transform: rotate(-3deg);
        border: 6px solid #fff;
        box-shadow: 0 34px 70px -34px rgba(120, 40, 10, 0.6);
      }
      .story-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; }
    </style>
  </main>

  <FooterCTA
    includeSchema={false}
    heading="Want to Work With Our Team?"
    description="Tell us about your project. We reply within one business day and set up a call with the right people from our team."
  />
</Layout>
