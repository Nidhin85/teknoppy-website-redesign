---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Zap, Rocket, Users, Calendar, LayoutGrid, Star, Phone, Mail } from 'lucide-react';
import about from '../data/pages/about.json';

const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).map(w => w[0]).join('').slice(0, 2).toUpperCase();

const title = "About Teknoppy — Web Design Agency Kerala | Our Story, Team & Mission";
const description = "Teknoppy is a professional web design and digital agency headquartered in Kochi, Kerala. Founded in 2018, we have delivered 120+ high-performance websites for businesses across Kerala and beyond.";

const stats = [
  { value: "120+", label: "Websites Delivered", icon: Rocket },
  { value: "100+", label: "Kerala Clients Served", icon: Users },
  { value: "8 Years", label: "In Business", icon: Calendar },
  { value: "12+", label: "Industries Covered", icon: LayoutGrid }
];

const values = [
  {
    title: "Every Website We Build Is SEO-Friendly from Day One",
    desc: "We do not bolt SEO on after launch. Every project begins with keyword research, structured data planning, and Core Web Vitals benchmarking — making SEO-friendly website design Kerala businesses need a foundational principle, not an afterthought."
  },
  {
    title: "A Proven Track Record Kerala Businesses Rely On",
    desc: "As a Web Design Company in Kerala with over 120 completed projects, our work speaks louder than promises. Clients across Kochi, Thrissur, Kozhikode, and Ernakulam have seen measurable improvements in search rankings, lead generation, and website engagement within the first 90 days of launch."
  },
  {
    title: "Affordable Website Design Without Compromising Quality",
    desc: "We believe every Kerala business — from a Thrissur-based startup to a Kochi enterprise — deserves a world-class website at a fair price. Our affordable website design Kerala packages are transparent, clearly scoped, and delivered on time with zero hidden costs."
  },
  {
    title: "We Understand the Kerala Business Landscape",
    desc: "Our team lives and works in Kerala. We understand how Kerala buyers search online, what local businesses need to stand out in competitive markets, and how to position your brand for both statewide and city-level search visibility."
  },
  {
    title: "From Strategy to Launch — We Handle Everything",
    desc: "Design, development, content integration, SEO setup, speed optimisation, schema markup, and post-launch support — Teknoppy delivers a technically sound, conversion-focused website under one roof so you never need to coordinate multiple vendors."
  },
  {
    title: "We Are With You After Your Website Goes Live",
    desc: "Our relationship does not end at launch. Every client receives dedicated post-launch support, performance monitoring, and proactive maintenance to ensure your website continues to rank, load fast, and convert visitors into leads long after going live."
  }
];

const testimonials = [
  {
    quote: "We now rank at the top of Google for our keywords and get many direct booking calls due to better visibility. Thank you Teknoppy for all the support.",
    author: "Biju Thomas",
    role: "CEO, Olives Resort, Wayanad"
  },
  {
    quote: "Being in the Fintech space, we needed a reliable partner. Teknoppy created an appealing website that represents our brand perfectly.",
    author: "Vivek Menon",
    role: "CTO, Evosyz, Kochi"
  },
  {
    quote: "I have worked with many IT teams, but I am 100% happy with Teknoppy. No doubt, I recommend them with 100% satisfaction.",
    author: "Dr. Asghar",
    role: "CEO, Greens Ayurveda, Calicut"
  }
];
---

<Layout title={title} description={description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- DARK HERO SECTION -->
    <section class="relative pt-32 pb-24 md:pt-36 md:pb-32 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.png')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 grid xl:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="xl:col-span-7 flex flex-col items-center text-center xl:items-start xl:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
            <Zap class="w-3.5 h-3.5" />
            About Us
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-black leading-[1.1] tracking-tight text-white mb-6">
            About
            <span class="relative inline-block text-primary">
              Teknoppy
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-neutral-300 mb-6 max-w-2xl font-medium leading-relaxed">
            Kerala's Professional Web Design & Digital Agency — building high-performance websites that rank, convert, and grow, since 2018.
          </p>
          <p class="text-sm sm:text-base text-neutral-400 mb-8 max-w-2xl font-medium leading-relaxed">
            Teknoppy Kerala is a full-service digital agency founded and headquartered in Kochi, serving businesses across Kerala, Thrissur, and South India. Led by Sanal and a dedicated team of designers, developers, and SEO strategists, we have been building high-performance websites since 2018.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
            <a href="#contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap">
              Get in Touch
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href="#story" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white border border-white/20 rounded-full hover:bg-white/5 transition-all duration-300 shadow-sm whitespace-nowrap">
              Our Story
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Hero Stats Cards Grid -->
        <div class="xl:col-span-5 grid grid-cols-2 gap-4 sm:gap-6">
          {stats.map(stat => {
            const IconComp = stat.icon;
            return (
              <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
                <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
                  <IconComp class="w-5 h-5" />
                </div>
                <span class="text-3xl font-black text-white block leading-none mb-2">{stat.value}</span>
                <div class="w-8 h-[2px] bg-primary mb-4"></div>
                <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">{stat.label}</span>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- STORY SECTION -->
    <section id="story" class="py-24 bg-[#FFF8EF]/30 border-y border-neutral-100 relative">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.png')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider shadow-sm mb-5">
            Our Story
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight mb-6">
            Who We Are — Kerala's Professional <span class="text-primary">Web Design Agency</span>
          </h2>
          <div class="space-y-5">
            <p class="text-neutral-600 font-medium text-base sm:text-lg leading-relaxed">
              As a professional web design agency Kerala businesses have trusted for nearly a decade, we bring together creative design and technical precision to deliver websites that rank, convert, and represent your brand with authority. From custom website design Kerala startups need to enterprise-level web development Kerala corporations demand — our work spans industries, project sizes, and business goals.
            </p>
            <p class="text-neutral-600 font-medium text-base sm:text-lg leading-relaxed">
              We have delivered over 120 successful websites across healthcare, retail, hospitality, education, real estate, and manufacturing sectors. Every project begins with strategy and ends with measurable results.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- VALUES SECTION -->
    <section class="py-24 bg-white border-t border-neutral-100 relative">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.png')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Why Teknoppy
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            Why Kerala Businesses <span class="text-primary">Choose Teknoppy</span>
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {values.map((val, idx) => (
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">{String(idx + 1).padStart(2, '0')}</span>
                <h3 class="text-lg font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3 leading-snug">{val.title}</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">{val.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TEAM SECTION -->
    <section class="py-24 bg-[#FFF9F6]/40 border-t border-neutral-100 relative">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.png')]" style="opacity: 0.8;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {about.team.badge}
          </div>
          <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
            {about.team.heading} <span class="text-primary">{about.team.headingAccent}</span>
          </h2>
        </div>

        <div class="max-w-4xl mx-auto">
          <!-- Founder — featured card -->
          <div class="bg-white rounded-3xl border border-neutral-100 p-8 sm:p-10 lg:p-12 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] flex flex-col md:flex-row items-center md:items-start gap-8 lg:gap-12">
            <!-- Founder Image — full portrait, falls back to the square headshot -->
            <div class="relative w-52 sm:w-60 flex-shrink-0 aspect-[3/4] rounded-2xl overflow-hidden border border-neutral-100 bg-[#FAF7F4] shadow-md flex items-center justify-center">
              <span class="absolute text-5xl font-black text-primary/15 select-none">{initials(about.team.founder.name)}</span>
              <img
                src={about.team.founder.photo}
                alt={about.team.founder.photoAlt}
                decoding="async"
                data-fallback={about.team.founder.photoFallback}
                onerror="if(this.dataset.fallback&&this.src.indexOf(this.dataset.fallback)===-1){this.src=this.dataset.fallback}else{this.remove()}"
                class="relative w-full h-full object-contain"
              />
            </div>

            <!-- Founder Content -->
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-2xl font-black text-neutral-900 mb-1">{about.team.founder.name}</h3>
              <p class="text-sm text-primary font-bold uppercase tracking-wider mb-3">{about.team.founder.role}</p>
              <div class="flex flex-col sm:flex-row items-center md:items-start justify-center md:justify-start gap-3 sm:gap-6 mb-6">
                <a href={`mailto:${about.team.founder.email}`} class="inline-flex items-center gap-2 text-xs font-bold text-neutral-600 hover:text-primary transition-colors">
                  <Mail class="w-4 h-4 text-primary" />
                  {about.team.founder.email}
                </a>
                <a href={`tel:${about.team.founder.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 text-xs font-bold text-neutral-600 hover:text-primary transition-colors">
                  <Phone class="w-4 h-4 text-primary" />
                  {about.team.founder.phone}
                </a>
              </div>
              <div class="w-10 h-[3px] bg-primary/80 mb-6 rounded-full mx-auto md:mx-0"></div>
              <p class="text-neutral-500 text-sm leading-relaxed font-semibold">
                {about.team.founder.bio}
              </p>
            </div>
          </div>

          <!-- The rest of the team -->
          {about.team.members?.length > 0 && (
            <div class="mt-14">
              {about.team.membersHeading && (
                <h3 class="text-center text-xs font-black text-neutral-400 uppercase tracking-[0.2em] mb-8">
                  {about.team.membersHeading}
                </h3>
              )}
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {about.team.members.map((m: any) => (
                  <div class="group bg-white rounded-3xl border border-neutral-100 overflow-hidden shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col">
                    <!-- Full portrait — object-contain so nothing is cropped -->
                    <div class="relative w-full aspect-[3/4] bg-[#FAF7F4] border-b border-neutral-100 flex items-center justify-center overflow-hidden">
                      <span class="absolute text-5xl font-black text-primary/15 select-none">{initials(m.name)}</span>
                      <img
                        src={m.photo}
                        alt={m.photoAlt ?? m.name}
                        loading="lazy"
                        decoding="async"
                        onerror="this.remove()"
                        class="relative w-full h-full object-contain group-hover:scale-[1.02] transition-transform duration-500"
                      />
                    </div>
                    <div class="p-7 flex flex-col flex-1">
                      <h4 class="text-lg font-black text-neutral-900 leading-snug">{m.name}</h4>
                      <p class="text-[11px] text-primary font-bold uppercase tracking-wider mt-1">{m.role}</p>
                      <div class="w-8 h-[3px] bg-primary/80 rounded-full my-4"></div>
                      <p class="text-neutral-500 text-xs leading-relaxed font-semibold">{m.bio}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- CLIENT TESTIMONIALS SECTION -->
    <section class="py-20 bg-neutral-50/50 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Testimonials
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            What Our <span class="text-primary">Clients Say</span> About Teknoppy
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {testimonials.map(item => (
            <div class="bg-white border border-neutral-200/50 rounded-3xl p-6 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex gap-1 text-[#F9AE42] mb-4">
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                </div>
                <p class="text-xs text-neutral-600 font-medium italic leading-relaxed mb-6">
                  "{item.quote}"
                </p>
              </div>
              <div class="border-t border-neutral-100 pt-4 mt-auto">
                <span class="block text-sm font-bold text-neutral-800">{item.author}</span>
                <span class="block text-[10px] text-neutral-400 font-bold uppercase tracking-wider mt-0.5">{item.role}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <!-- FAQ — questions reused from the pages that own them (see about.json).
         FAQPage schema is intentionally left with those source pages so the same
         Q&A entities are not marked up on two URLs. -->
    <section class="py-20 bg-neutral-50/50 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {about.faq.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {about.faq.heading}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {about.faq.intro}
          </p>
        </div>

        <div class="max-w-4xl mx-auto space-y-4">
          {about.faq.items.map((faq: any) => (
            <details class="group bg-white rounded-2xl border border-neutral-200/60 p-6 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer focus:outline-none gap-4">
                <h3 class="text-sm sm:text-base font-bold text-neutral-850">{faq.q}</h3>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-primary flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-neutral-100/60 text-xs sm:text-sm text-neutral-600 leading-relaxed font-semibold">
                {faq.aHtml ? <Fragment set:html={faq.aHtml} /> : faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <FooterCTA />
</Layout>
