---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/web-design-company-qatar.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Fragment slot="head">
    <!-- Doc: Geo Meta — target country Qatar -->
    <meta name="geo.region" content="QA" />
    <meta name="geo.placename" content="Doha, Lusail, Al Wakrah" />
  </Fragment>

  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA />
</Layout>
