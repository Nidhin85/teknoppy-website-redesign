  },
  {
    title: "Content Marketing",
    desc: "As a content marketing agency in Kochi, we produce SEO-led blogs and copy that answer real buyer questions, earn AI-engine citations, and move prospects down the funnel.",
    icon: Edit
  },
  {
    title: "Email Marketing & Automation",
    desc: "Email marketing services Kochi businesses use to turn existing leads into repeat customers — nurture sequences, newsletters, and lifecycle automation at near-zero marginal cost.",
    icon: Zap
  },
  {
    title: "Branding & Creative",
    desc: "As a branding agency in Kochi, we craft identity, messaging, and ad creative that make your business look credible across every channel and lift campaign performance.",
    icon: Award
  },
  {
    title: "Landing Pages & CRO",
    desc: "Conversion-focused landing pages and A/B testing that turn traffic you already pay for into measurably more leads.",
    icon: LayoutGrid
  },
  {
    title: "Analytics & Performance",
    desc: "As a performance marketing agency Kochi brands rely on, we set up GA4, Search Console, and call tracking so every channel is measured and every report tells the truth.",
    icon: Gauge
  }
];

const processes = [
  {
    step: "01",
    title: "Audit & Goal Mapping",
    desc: "We audit your website, search visibility, ads, and competitors, then define the real goal — leads, calls, or sales — and the numbers that prove it.",
    icon: Search
  },
  {
    step: "02",
    title: "Strategy & Channel Plan",
    desc: "We choose the channels that fit your market and budget — SEO, Google Ads, social, or a blend — with a clear plan, timeline, and forecast before any spend.",
    icon: Compass
  },
  {
    step: "03",
    title: "Tracking & Measurement Setup",
    desc: "GA4, Google Search Console, conversion events, and call tracking are configured first, so results are attributable from day one — not estimated later.",
    icon: Activity
  },
  {
    step: "04",
    title: "Campaign Launch & Creative",
    desc: "We produce the assets — copy, creative, landing pages, ad sets, and optimised content — and launch in controlled phases to validate before scaling.",
    icon: Rocket
  },
  {
    step: "05",
    title: "Optimisation & A/B Testing",
    desc: "Continuous refinement of keywords, bids, audiences, and creative based on live data — cutting waste and doubling down on what produces leads.",
    icon: TrendingUp
  },
  {
    step: "06",
    title: "Reporting & Scaling",
    desc: "Plain-English monthly reports on leads, cost-per-result, and ROI, plus a review call to decide where to scale next.",
    icon: Gauge
  }
];

const pricing = [
  { type: "Local / Small-Business SEO", price: "Rs. 15,000 – 35,000 / mo" },
  { type: "Competitive / Ecommerce SEO", price: "Rs. 35,000 – 75,000 / mo" },
  { type: "Social Media Marketing (organic + creative)", price: "Rs. 12,000 – 40,000 / mo" },
  { type: "Google Ads / PPC Management", price: "Rs. 10,000 – 30,000 / mo + ad spend" },
  { type: "Content Marketing (blogs + on-page)", price: "Rs. 15,000 – 50,000 / mo" },
  { type: "Full-Funnel Growth Package (multi-channel)", price: "Rs. 50,000 – 1,50,000 / mo" },
  { type: "Branding / Strategy (one-time)", price: "Rs. 25,000 – 1,00,000" }
];

const industries = [
  { name: "Startups & New Business", desc: "A popular digital marketing company for startups in Kochi — go-to-market campaigns and lead funnels that prove traction on a lean budget.", icon: Rocket },
  { name: "Hospitals & Healthcare", desc: "Local SEO, reputation, and appointment-focused campaigns that reach patients while staying trust-first.", icon: Activity },
  { name: "Real Estate", desc: "High-intent Google and Meta lead-gen for property enquiries, with landing pages and qualification built in.", icon: Home },
  { name: "Restaurants & Food", desc: "Local SEO, Google Business Profile, and social that drive footfall, reservations, and online orders.", icon: Utensils },
  { name: "Schools & Education", desc: "Admission-season campaigns across search, social, and content that fill enquiry forms with qualified parents.", icon: GraduationCap },
  { name: "Tourism & Travel", desc: "Visual, conversion-focused campaigns and SEO for packages and resorts — domestic and international demand.", icon: Compass },
  { name: "Professional Services", desc: "Authority content and local SEO for law firms, consultants, CAs, and advisors who win clients on trust.", icon: Briefcase },
  { name: "Small Businesses & SMEs", desc: "Digital marketing for small businesses Kochi that keeps costs sensible while still delivering steady growth.", icon: Building2 }
];

const projects = [
  {
    name: "Olives Resort",
    type: "Tourism & Hospitality",
    loc: "WAYANAD · HOSPITALITY",
    desc: "A conversion-focused hospitality website paired with local and organic SEO for resort and Wayanad-stay keywords.",
    result: "Top Google rankings for core resort keywords and a measurable increase in direct booking calls (confirmed by CEO Biju Thomas)."
  },
  {
    name: "Greens Ayurveda",
    type: "Healthcare & Ayurveda",
    loc: "AZHIYUR, CALICUT · AYURVEDA",
    desc: "Local and organic SEO targeting Ayurvedic-treatment and Panchakarma-centre keywords, with schema and a structured enquiry flow.",
    result: "A significant rise in international enquiries and steady organic growth for wellness keywords."
  },
  {
    name: "Evosyz",
    type: "Fintech",
    loc: "KOCHI · FINTECH",
    desc: "On-page SEO and conversion optimisation for a regulated fintech brand.",
    result: "Stronger search visibility for fintech keywords in Kochi and increased franchise and partnership enquiries."
  }
];

const testimonials = [
  {
    quote: "Being in the Fintech space, we needed a reliable partner. Teknoppy created an appealing website that represents our brand perfectly.",
    author: "Vivek Menon",
    role: "CTO, Evosyz, Kochi"
  },
  {
    quote: "Teknoppy was very intuitive in understanding our requirements. They made great digital collateral and now we are getting good outreach to the market.",
    author: "Shainesh Prakashan",
    role: "CEO, Exacore IT, Infopark Kochi"
  },
  {
    quote: "Thank you Teknoppy for a wonderful mobile app for my tarot channel. All functions work great and I am getting many subscribers.",
    author: "Rincy",
    role: "Astrologer & Psychic Healer, Australia"
  }
];

const faqs = [
  {
    q: "How much does digital marketing cost in Kochi?",
    a: "Most Kochi businesses invest between Rs. 10,000 and Rs. 75,000 per month depending on channels and competition, while full-funnel programmes range higher. Google Ads also needs a separate ad budget. We share a written quote before any work begins."
  },
  {
    q: "How long does digital marketing take to show results?",
    a: "Paid ads like Google Ads can generate leads within days. SEO and content typically show meaningful movement in 3 to 6 months and compound from there. We set realistic timelines and milestones at the start."
  },
  {
    q: "Which is the best digital marketing company in Kochi?",
    a: "The best choice is the agency that fits your goals and budget and can prove its results. Teknoppy is trusted by startups, clinics, resorts, and established brands across Kerala for exactly that reason."
  },
  {
    q: "How to choose a digital marketing agency in Kochi?",
    a: "Look for clear reporting, real case studies, honest pricing, and a team that explains things simply. Avoid anyone who promises instant results or hides how your budget is spent."
  },
  {
    q: "What does a digital marketing company do?",
    a: "A digital marketing company helps your business get found online and grow — improving your Google ranking, running paid ads, managing social media, and creating content, all measured against real business goals."
  },
  {
    q: "Is digital marketing worth it for small businesses?",
    a: "Yes — when it is measured. Even a small budget can bring a clear cost-per-lead you can judge for yourself. Waste only happens when money is spent without tracking, which we prevent."
  },
  {
    q: "Do you optimise for AI answer engines like ChatGPT and Perplexity?",
    a: "Yes. Alongside traditional SEO we structure content and schema for answer engines and generative search (AEO and GEO) — clear question-led sections and verifiable detail AI assistants can cite."
  },
  {
    q: "Do you work with businesses near me and outside Kochi?",
    a: "Yes. When you search for a digital marketing agency near me Kochi, we are a local choice as a digital marketing company in Kochi, Kerala and a digital marketing company in Ernakulam, and we serve Thrissur, Calicut, and Trivandrum plus India-wide clients."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={title} description={description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- HERO SECTION WITH OFFICE CIRCLING SVG (DARK VERSION) -->
    <section class="relative pt-32 pb-24 md:pt-36 md:pb-32 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.png')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 grid xl:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="xl:col-span-7 flex flex-col items-center text-center xl:items-start xl:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
            <Zap class="w-3.5 h-3.5" />
            Kerala's Performance Marketing Studio
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-black leading-[1.1] tracking-tight text-white mb-6">
            Digital
            <span class="relative inline-block text-primary">
              Marketing
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
            <br class="hidden sm:block" />
            Company in Kochi
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-neutral-300 mb-6 max-w-2xl font-medium leading-relaxed">
            SEO · Google Ads · Social Media · Content — Performance Marketing for Kerala Businesses Since 2018. Marketing that is measurable, not just visible.
          </p>
          <p class="text-sm sm:text-base text-neutral-400 mb-8 max-w-2xl font-medium leading-relaxed">
            Teknoppy is a results-driven digital marketing company in Kochi delivering SEO, paid advertising, social media, and content marketing for businesses across Kerala. Since 2018, we have delivered 120+ web and marketing projects — building search visibility, qualified leads, and measurable revenue for brands in Kochi, Thrissur, Calicut, Trivandrum, and the wider Kerala market.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
            <a href="#contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap">
              Book a Free Audit
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href="#services" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white border border-white/20 rounded-full hover:bg-white/5 transition-all duration-300 shadow-sm whitespace-nowrap">
              Explore Our Services
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Hero Graphic (Redesigned Stats Cards Grid) -->
        <div class="xl:col-span-5 grid grid-cols-2 gap-4 sm:gap-6">

          <!-- Card 1 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Rocket class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">120+</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Projects Delivered</span>
          </div>

          <!-- Card 2 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Calendar class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">2018</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Established</span>
          </div>

          <!-- Card 3 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <TrendingUp class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Multi-Channel</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">SEO · Ads · Social</span>
          </div>

          <!-- Card 4 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Globe2 class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Kerala</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Wide Coverage</span>
          </div>

        </div>
      </div>
    </section>

    <!-- WHY TEKNOPPY SECTION -->
    <section class="py-24 bg-[#FFF8EF]/30 border-y border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.png')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

          <!-- Left Column (Sticky Panel) -->
          <div class="lg:col-span-5 lg:sticky lg:top-32 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider shadow-sm">
              Trusted Partners
            </div>
            <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
              Why Teknoppy Is the Trusted <br />
              <span class="text-primary">Digital Marketing Company in Kochi</span>
            </h2>
            <p class="text-neutral-500 font-medium text-sm leading-relaxed max-w-sm">
              Marketing today is not about being everywhere — it is about being measurable. As a full-funnel digital marketing agency in Kochi, Teknoppy combines technical SEO, paid media, conversion-focused creative, and transparent analytics, so every rupee you spend is tracked to a result. Our clients include startups, hospitals, real estate firms, restaurants, manufacturers, and established enterprises who need leads, not just likes.
            </p>
          </div>

          <!-- Right Column (Premium Custom Cards Grid) -->
          <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6 lg:gap-8">

            <!-- Card 1 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">01 . Data</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Data-Driven, Not Vanity Metrics</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  We report on leads, cost-per-acquisition, and revenue — not just impressions and follower counts. As a result-driven digital marketing agency Kochi owners trust, every campaign ties to a goal you care about.
                </p>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">02 . Full Funnel</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Full Funnel Under One Roof</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  SEO, Google Ads, social, content, email, and landing pages handled by one in-house Kochi team — no disconnected freelancers, no finger-pointing between agencies.
                </p>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">03 . Transparency</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Transparent, ROI-Focused Reporting</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Live dashboards and monthly reviews built around ROI-focused digital marketing Kochi businesses can verify — you always know what was done, what it cost, and what it returned.
                </p>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">04 . Local</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">A Local Kochi Team</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Headquartered in Kochi, Kerala, we understand the local market and Malayalam-speaking audiences — and we are a call or meeting away, not a remote offshore agency.
                </p>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- OUR DIGITAL MARKETING SERVICES IN KOCHI -->
    <section id="services" class="py-20 bg-white relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.png')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Services Scope
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            Our <span class="text-primary">Digital Marketing</span> Services in Kochi
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base sm:text-lg">
            We provide complete digital marketing services in Kochi under one roof, so you never manage several agencies at once. From SEO services in Kochi to paid media and creative, here is how we help.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {services.map(svc => {
            const IconComp = svc.icon;
            return (
              <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col">
                <!-- Left Gradient Stroke -->
                <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 bg-primary/5 text-primary rounded-2xl flex items-center justify-center flex-shrink-0 border border-primary/10 shadow-inner">
                    <IconComp class="w-6 h-6" />
                  </div>
                  <h3 class="text-base sm:text-[17px] font-black text-neutral-850 leading-snug">{svc.title}</h3>
                </div>
                <p class="text-neutral-500 text-xs leading-relaxed mt-4 font-semibold">{svc.desc}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- DIGITAL MARKETING PROCESS SECTION (LIGHT TIMELINE CARDS) -->
    <section class="py-24 bg-[#FFF9F6]/40 border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.png')]" style="opacity: 0.8;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            • Our Process •
          </div>
          <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
