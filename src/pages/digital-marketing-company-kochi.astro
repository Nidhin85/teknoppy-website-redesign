---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Play, Globe2, Smile, Award, Star, CheckCircle, Clock, Heart, Shield, Check, HelpCircle, User, Zap, Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages, MonitorSmartphone, Building2, Edit, ShieldCheck, Search, Layers, Network, Code, Gauge, LayoutGrid, Calendar, TrendingUp } from 'lucide-react';
import page from '../data/pages/digital-marketing.json';
import { digitalMarketingSchema } from '../data/schemas/digitalMarketingSchema';

const title = page.meta.title;
const description = page.meta.description;

// Icons are zipped by index onto the JSON-driven content (design is hardcoded).
const heroStatIcons = [Rocket, Calendar, TrendingUp, Globe2];
const whyIcons = [TrendingUp, Award, ShieldCheck, Heart];

// Heading colours: highlight one phrase in orange (same words, split for styling only; falls back to plain text).
const splitAccent = (t: string, phrase: string) => { const i = (t ?? '').indexOf(phrase); return i < 0 ? null : [t.slice(0, i), phrase, t.slice(i + phrase.length)]; };
// Hero heading colours match the Ecommerce hero: service name + "in Kochi" orange (same words, split for styling only).
const heroLeadMatch = page.hero.heading.lead.match(/^(Digital Marketing)\s+(.*)$/);
const heroLead = heroLeadMatch ? { key: heroLeadMatch[1], rest: heroLeadMatch[2] } : null;
const serviceIcons = [Search, TrendingUp, Network, Edit, Zap, Award, LayoutGrid, Gauge];
const processIcons = [Search, Compass, Activity, Rocket, TrendingUp, Gauge];
const industryIcons = [Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Building2];

// Alternating case-study accent colour classes, selected by block.accent.
const caseAccents: Record<string, { glow: string; mesh: string; label: string }> = {
  blue: {
    glow: "from-blue-500/20 to-indigo-500/20",
    mesh: "from-blue-500/10",
    label: "text-blue-400"
  },
  emerald: {
    glow: "from-emerald-500/20 to-teal-500/20",
    mesh: "from-emerald-500/10",
    label: "text-emerald-400"
  }
};
---

<Layout
  title={title}
  description={description}
  floatingCtaLabel="Grow My Business"
  floatingCtaHref="/request-a-quote/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(digitalMarketingSchema)} />
  </Fragment>

  <Header forceSolidBg={true} />

  <main class="dmd-page overflow-hidden bg-[#fffaf6]">
    <!-- HERO (reference layout: dark band, copy left, glowing 3D marketing-analytics visual right, stats strip below) -->
    <section class="dmd-hero theme-keep-light relative pt-28 sm:pt-32 lg:pt-36 pb-14 sm:pb-16 lg:pb-20 overflow-hidden text-white">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
        <div class="dmd-hero-glow"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
          <!-- Hero Text -->
          <div class="lg:col-span-6 flex flex-col items-start text-left">
            <nav class="flex flex-wrap items-center gap-2 text-xs font-medium text-white/60 mb-5" aria-label="Breadcrumb">
              <a href="/" class="hover:text-white transition-colors">Home</a>
              <span class="text-white/30">›</span>
              <a href="/services/" class="hover:text-white transition-colors">Services</a>
              <span class="text-white/30">›</span>
              <span class="text-white font-semibold">Digital Marketing Company in Kochi</span>
            </nav>
            <div class="dmd-badge mb-5">
              <Zap class="w-3.5 h-3.5 shrink-0" />
              <span>{page.hero.badge}</span>
            </div>
            <h1 class="text-[34px] sm:text-[48px] lg:text-[46px] xl:text-[54px] font-black leading-[1.06] tracking-[-0.035em] text-white mb-6">
              {heroLead ? (<><span class="text-[#ff7a3d]">{heroLead.key}</span> {heroLead.rest}</>) : page.hero.heading.lead} <span class="text-[#ff7a3d]">{page.hero.heading.highlight}</span>{page.hero.heading.tail && ` ${page.hero.heading.tail}`}
            </h1>
            <p class="text-base sm:text-lg text-white/90 mb-4 max-w-xl font-semibold leading-snug">
              {page.hero.subheadline}
            </p>
            <p class="text-[15px] sm:text-base text-white/65 mb-8 max-w-xl font-medium leading-relaxed">
              {page.hero.body}
            </p>

            <div class="flex flex-col min-[420px]:flex-row items-stretch min-[420px]:items-center gap-3 sm:gap-4 w-full sm:w-auto">
              <a href={page.hero.ctaPrimary.href} class="inline-flex items-center justify-center gap-2.5 px-7 py-4 text-sm sm:text-base font-bold text-white bg-primary rounded-full shadow-[0_10px_30px_-6px_rgba(240,90,44,0.7)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 leading-snug whitespace-nowrap">
                {page.hero.ctaPrimary.label}
                <ArrowRight class="w-4 h-4" />
              </a>
              <a href={page.hero.ctaSecondary.href} class="inline-flex items-center justify-center gap-3 pl-7 pr-2.5 py-2.5 text-sm sm:text-base font-bold text-neutral-900 bg-white rounded-full hover:-translate-y-0.5 transition-all duration-300 shadow-sm leading-snug whitespace-nowrap">
                {page.hero.ctaSecondary.label}
                <span class="flex items-center justify-center w-9 h-9 rounded-full bg-primary text-white shrink-0">
                  <Play class="w-3.5 h-3.5 ml-0.5" fill="currentColor" />
                </span>
              </a>
            </div>
          </div>

          <!-- Hero visual: analytics browser, glowing orange sphere and floating channel labels -->
          <div class="lg:col-span-6">
            <div class="dmd-visual relative mx-auto w-full max-w-[600px] lg:max-w-none xl:w-[110%]">
              <picture>
                <source media="(max-width: 767px)" srcset="/images/home/3d/dm-hero-3d-900.webp" />
                <img src="/images/home/3d/dm-hero-3d.webp" alt="3D browser window showing a rising growth chart and pie chart in front of a glowing orange sphere, with labels for SEO optimization, social media marketing, Google Ads (PPC) and content marketing" width="1500" height="1030" loading="eager" decoding="async" fetchpriority="high" class="w-full h-auto" />
              </picture>
            </div>
          </div>
        </div>

        <!-- Stats strip -->
        <div class="dmd-stats mt-12 lg:mt-14 grid grid-cols-2 lg:grid-cols-4">
          {page.hero.statCards.map((card, i) => {
            const IconComp = heroStatIcons[i];
            return (
              <div class="flex items-center gap-3.5 px-4 sm:px-6 py-4 sm:py-5">
                <span class="w-11 h-11 sm:w-12 sm:h-12 shrink-0 rounded-2xl bg-gradient-to-br from-[#fff1e8] to-[#ffe0cc] text-primary flex items-center justify-center">
                  <IconComp class="w-5 h-5" />
                </span>
                <div class="min-w-0">
                  <span class="block text-xl sm:text-2xl font-black text-neutral-900 leading-none tracking-tight">{card.value}</span>
                  <span class="block text-xs sm:text-[13px] text-neutral-500 font-medium mt-1.5 leading-snug">{card.label}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- WHY TEKNOPPY SECTION -->
    <section class="py-24 bg-cream/30 border-y border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.webp')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-10 sm:mb-12">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider shadow-sm mb-5">
              {page.whyTeknoppy.badge}
            </div>
            <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
              {page.whyTeknoppy.heading.lead} <br class="hidden sm:inline" />
              {(() => { const w = splitAccent(page.whyTeknoppy.heading.highlight, "Digital Marketing Company in Kochi"); return w ? (<>{w[0]}<span class="text-primary">{w[1]}</span>{w[2]}</>) : <span class="text-primary">{page.whyTeknoppy.heading.highlight}</span>; })()}
            </h2>
          </div>
          <p class="lg:col-span-5 text-neutral-600 font-medium text-base sm:text-[17px] leading-relaxed">
            {page.whyTeknoppy.intro}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          {page.whyTeknoppy.cards.map((card, i) => {
            const WIcon = whyIcons[i] ?? Zap;
            return (
              <div class="dmd-card group p-6 sm:p-7 flex flex-col">
                <span class="dmd-icon mb-5"><WIcon class="w-6 h-6" /></span>
                <span class="text-[11px] font-bold text-primary uppercase tracking-widest block mb-2">{card.tag}</span>
                <h3 class="text-lg font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-2.5 leading-snug">{card.title}</h3>
                <p class="text-neutral-600 text-sm leading-relaxed">{card.description}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- OUR DIGITAL MARKETING SERVICES IN KOCHI -->
    <section id="services" class="py-20 bg-white relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.webp')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-10 sm:mb-12">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.services.badge}
            </div>
            <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
              {page.services.heading.lead} <span class="text-primary">{page.services.heading.highlight}</span> {page.services.heading.tail}
            </h2>
          </div>
          <p class="lg:col-span-5 text-neutral-600 font-medium text-base sm:text-lg leading-relaxed">
            {page.services.intro}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          {page.services.cards.map((svc, i) => {
            const IconComp = serviceIcons[i];
            // Committed JSON uses linkHref/description/linkText; cms:pull writes href/desc (CMS schema).
            const href = svc.linkHref ?? svc.href;
            const description = svc.description ?? svc.desc;
            const label = svc.linkText ?? svc.linkLabel ?? 'Learn more';
            const Card = href ? 'a' : 'div';
            return (
              <Card href={href} class="dmd-card group p-6 flex flex-col">
                <span class="dmd-icon mb-5"><IconComp class="w-6 h-6" /></span>
                <h3 class:list={["text-lg font-bold text-neutral-900 leading-snug mb-2.5", href && "group-hover:text-primary transition-colors duration-300"]}>{svc.title}</h3>
                <p class="text-neutral-600 text-sm leading-relaxed">{description}</p>
                {href && (
                  <span class="inline-flex items-center gap-1.5 mt-auto pt-5 text-[13px] font-bold text-primary">
                    {label} <ArrowRight class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" />
                  </span>
                )}
              </Card>
            );
          })}
        </div>
      </div>
    </section>

    <!-- DIGITAL MARKETING PROCESS SECTION (LIGHT TIMELINE CARDS) -->
    <section class="py-24 bg-warm/40 border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.webp')]" style="opacity: 0.8;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {page.process.badge}
          </div>
          <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
            {page.process.heading.lead} <span class="text-primary">{page.process.heading.highlight}</span> {page.process.heading.tail}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.process.intro}
          </p>
        </div>

        <ol class="dmd-process relative grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-9 sm:gap-x-6 lg:gap-x-4 z-10">
          {page.process.steps.map((proc, idx) => {
            const IconComponent = processIcons[idx];
            return (
              <li class="group relative flex flex-col items-center text-center">
                <div class="relative z-10 w-16 h-16 rounded-full bg-white border border-primary/15 shadow-[0_18px_36px_-20px_rgba(160,60,20,0.55)] flex items-center justify-center text-primary mb-4 transition-all duration-300 group-hover:bg-primary group-hover:text-white group-hover:-translate-y-1">
                  <IconComponent class="w-6 h-6" />
                </div>
                <span class="text-[11px] font-bold text-primary uppercase tracking-[0.14em] mb-1">Step {proc.number}</span>
                <h3 class="text-base sm:text-lg font-bold text-neutral-900 leading-snug mb-1.5 group-hover:text-primary transition-colors duration-300">{proc.title}</h3>
                <p class="text-neutral-600 text-xs sm:text-[0.84rem] leading-relaxed max-w-[15rem]">{proc.description}</p>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <!-- PRICING TABLE SECTION -->
    <section class="py-20 bg-white border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/pricingbg.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-5">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.pricing.badge}
            </div>
            <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight mb-4">
              {page.pricing.heading.lead} <span class="text-primary">{page.pricing.heading.highlight}</span>
            </h2>
            <p class="text-neutral-600 font-medium text-base max-w-md">
              {page.pricing.intro}
            </p>
          </div>
          <div class="lg:col-span-7">
            <div class="bg-white rounded-[1.75rem] border border-primary/10 overflow-hidden shadow-[0_30px_60px_-36px_rgba(160,60,20,0.45)]">
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="border-b border-neutral-100">
                      <th class="pt-5 pb-3 px-4 sm:px-7 text-[11px] sm:text-xs font-bold text-neutral-400 uppercase tracking-[0.14em]">Service</th>
                      <th class="pt-5 pb-3 px-4 sm:px-7 text-[11px] sm:text-xs font-bold text-neutral-400 uppercase tracking-[0.14em] text-right">Estimated Investment</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-neutral-100">
                    {page.pricing.rows.map((priceItem) => (
                      <tr class="hover:bg-[#fff8f3] transition-colors">
                        <td class="py-3.5 sm:py-4 px-4 sm:px-7 font-bold text-neutral-900 text-xs sm:text-[0.95rem]">{priceItem.service}</td>
                        <td class="py-3.5 sm:py-4 px-4 sm:px-7 text-right font-bold text-primary text-xs sm:text-[0.95rem] sm:whitespace-nowrap">{priceItem.price}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
            <p class="text-neutral-500 text-xs sm:text-sm mt-4 leading-relaxed font-medium">
              {page.pricing.footnote}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TARGET INDUSTRIES SECTION (DARK AMBER THEME) -->
    <section class="py-20 theme-keep-light bg-neutral-950 text-white border-t border-white/5 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/industriesbg.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          <div class="lg:col-span-4">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/20 border border-amber-500/30 text-amber-400 text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.industries.badge}
            </div>
            <h2 class="text-3xl md:text-4xl font-black text-white leading-tight">
              <span class="text-[#F9AE42]">{page.industries.heading.highlight}</span> {page.industries.heading.tail}
            </h2>
            <p class="text-neutral-400 font-medium mt-3 text-base">
              {page.industries.intro}
            </p>
          </div>
          <div class="lg:col-span-8 grid sm:grid-cols-2 gap-3 sm:gap-4">
            {page.industries.items.map((ind, i) => {
              const IconComponent = industryIcons[i];
              return (
                <div class="bg-white/[0.04] border border-white/10 p-4 sm:p-5 rounded-2xl hover:border-amber-500/40 hover:bg-white/[0.07] transition-all duration-300 flex items-start gap-3.5">
                  <div class="w-10 h-10 rounded-xl bg-primary/20 text-[#ff9a5c] flex items-center justify-center flex-shrink-0">
                    <IconComponent class="w-5 h-5" />
                  </div>
                  <div class="min-w-0">
                    <h3 class="text-[15px] font-bold text-white mb-1">{ind.title}</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed">{ind.description}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <!-- CASE STUDIES SECTION (PORTFOLIO STYLE) -->
    <section class="py-24 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mb-20">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {page.caseStudies.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {page.caseStudies.heading.lead} <span class="text-primary">{page.caseStudies.heading.highlight}</span> {page.caseStudies.heading.tail}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.caseStudies.intro}
          </p>
        </div>

        <div class="space-y-24">

          {page.caseStudies.blocks.map((block, idx) => {
            const accent = caseAccents[block.accent];
            return (
              <div class={`flex flex-col ${idx % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'} items-center gap-12 lg:gap-16 group relative`}>
                <!-- Left: Mockup Window -->
                <div class="w-full lg:w-[48%] relative z-10">
                  <!-- Glow -->
                  <div class={`absolute inset-0 bg-gradient-to-tr ${accent.glow} rounded-[2rem] scale-105 opacity-0 group-hover:opacity-100 transition-all duration-700 blur-xl`}></div>

                  <!-- Browser -->
                  <div class="relative bg-white rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-neutral-100 overflow-hidden transform group-hover:-translate-y-1.5 transition-all duration-500">
                    <div class="h-10 bg-neutral-50 border-b border-neutral-100/80 flex items-center px-4 gap-2">
                      <div class="w-3 h-3 rounded-full bg-[#FF5F56]"></div>
                      <div class="w-3 h-3 rounded-full bg-[#FFBD2E]"></div>
                      <div class="w-3 h-3 rounded-full bg-[#27C93F]"></div>
                      {block.site && <span class="ml-3 text-[13px] font-semibold text-neutral-400 truncate">{block.site}</span>}
                    </div>
                    {block.image
                      ? <img
                          src={block.image}
                          alt={block.imageAlt}
                          width="1440"
                          height="900"
                          loading="lazy"
                          decoding="async"
                          class="w-full aspect-[16/10] object-cover object-top block"
                        />
                      : (
                      <div class="aspect-[16/10] theme-keep-light bg-[#0c0c0e] relative overflow-hidden flex flex-col items-center justify-center p-8 text-center">
                        <!-- Abstract mesh -->
                        <div class={`absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] ${accent.mesh} via-transparent to-transparent`}></div>
                        <span class={`text-xs font-black ${accent.label} uppercase tracking-widest mb-3`}>{block.label}</span>
                        <span class="text-4xl sm:text-5xl font-black text-white leading-none mb-3">{block.metric}</span>
                        <span class="text-xs text-neutral-400 uppercase tracking-wider font-semibold">{block.metricSub}</span>
                      </div>
                      )}
                  </div>
                </div>

                <!-- Right: Content -->
                <div class="w-full lg:w-[52%] space-y-6">
                  <div>
                    <span class="text-xs font-black text-primary uppercase tracking-widest">Case Study 0{idx + 1}</span>
                    <h3 class="text-2xl font-black text-neutral-900 mt-1">{block.title}</h3>
                  </div>
                  <p class="text-sm text-neutral-500 leading-relaxed font-medium">
                    {block.intro}
                  </p>

                  <div class="grid sm:grid-cols-2 gap-4">
                    <div class="bg-neutral-50/50 rounded-2xl p-5 border border-neutral-100">
                      <h4 class="text-xs font-black text-neutral-900 uppercase tracking-wider mb-2">Our Approach</h4>
                      <ul class="space-y-1.5 text-xs text-neutral-500 font-semibold list-disc pl-4">
                        {block.approach.map(point => <li>{point}</li>)}
                      </ul>
                    </div>
                    <div class="bg-neutral-50/50 rounded-2xl p-5 border border-neutral-100">
                      <h4 class="text-xs font-black text-neutral-900 uppercase tracking-wider mb-2">The Results</h4>
                      <ul class="space-y-1.5 text-xs text-neutral-500 font-semibold list-disc pl-4">
                        {block.results.map(point => <li>{point}</li>)}
                      </ul>
