              <div class="mt-4 pt-4 border-t border-neutral-100/60 text-xs sm:text-sm text-neutral-600 leading-relaxed font-semibold">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- FAQ Schema -->
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    </section>
  </main>

  <FooterCTA />
</Layout>
