---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Play, Globe2, Smile, Award, Star, CheckCircle, Clock, Heart, Shield, Check, HelpCircle, User, Zap, Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages, MonitorSmartphone, Building2, Edit, ShieldCheck, Search, Layers, Network, Code, Gauge, LayoutGrid, Calendar, TrendingUp } from 'lucide-react';

const title = "Web Application Development Company Kochi | Custom Web Apps — Teknoppy";
const description = "Teknoppy is a Kochi web application development company building scalable, secure, enterprise-grade custom web applications for Kerala, India, and GCC businesses since 2018.";

const services = [
  {
    title: "Custom Web Application Development",
    desc: "Build powerful, scalable applications from scratch using modern web application development frameworks.",
    icon: Code
  },
  {
    title: "Web Application Development for Startups Kochi",
    desc: "MVP development, rapid prototyping, lean web application development approach.",
    icon: Rocket
  },
  {
    title: "Enterprise Web Application Development",
    desc: "Large-scale systems, complex workflows, enterprise-grade security and performance.",
    icon: Building2
  },
  {
    title: "Web Application Development for E-Commerce",
    desc: "Shopping carts, payment integration, inventory management, analytics dashboards.",
    icon: Layers
  },
  {
    title: "Web Application Development for Healthcare",
    desc: "Patient management, telemedicine, HIPAA-compliant secure web application development.",
    icon: Activity
  },
  {
    title: "Web Application Development for Fintech",
    desc: "Payment processing, digital wallets, investment platforms, bank-grade security.",
    icon: Shield
  },
  {
    title: "Web Application Development for SaaS",
    desc: "Multi-tenant architecture, subscription management, API integrations, cloud deployment.",
    icon: Network
  }
];

const processes = [
  {
    step: "01",
    title: "Discovery & Requirements Analysis",
    desc: "Detailed meetings covering business goals, user personas, technical requirements. Clear expectations before coding begins.",
    icon: Search
  },
  {
    step: "02",
    title: "Architecture & Technology Selection",
    desc: "Design system architecture, select appropriate web application development frameworks, plan database structure, define API specifications.",
    icon: Network
  },
  {
    step: "03",
    title: "Development & API Implementation",
    desc: "Full-stack web application development using modern frameworks. Frontend UI, backend APIs, database integration, third-party services.",
    icon: Code
  },
  {
    step: "04",
    title: "Testing & Quality Assurance",
    desc: "Unit testing, integration testing, security testing, performance testing, user acceptance testing.",
    icon: Gauge
  },
  {
    step: "05",
    title: "Deployment & Infrastructure Setup",
    desc: "Deploy to cloud infrastructure (AWS, Azure), set up monitoring, configure backups, optimize web application development performance.",
    icon: Rocket
  },
  {
    step: "06",
    title: "Maintenance & Continuous Support",
    desc: "Monthly updates, security patches, feature enhancements, support and bug fixes.",
    icon: ShieldCheck
  }
];

const pricing = [
  { type: "MVP/Startup Application", price: "Rs. 3,00,000 – 8,00,000", timeline: "2-3 months" },
  { type: "Standard Web Application", price: "Rs. 8,00,000 – 15,00,000", timeline: "3-4 months" },
  { type: "Enterprise Application", price: "Rs. 15,00,000 – 40,00,000+", timeline: "4-6 months" },
  { type: "Ongoing Maintenance & Support", price: "Rs. 20,000 – 50,000/month", timeline: "Monthly" }
];

const industries = [
  { name: "E-Commerce Platforms", desc: "Shopping carts, payment integration, inventory management, and analytics dashboards.", icon: Layers },
  { name: "Healthcare Systems", desc: "Patient management, telemedicine, and HIPAA-compliant secure development.", icon: Activity },
  { name: "Fintech Applications", desc: "Payment processing, digital wallets, investment platforms, and bank-grade security.", icon: Shield },
  { name: "SaaS Products", desc: "Multi-tenant architecture, subscription management, API integrations, and cloud deployment.", icon: Network },
  { name: "Enterprise Systems", desc: "CRM, ERP, HRM, and large-scale workflow automation platforms.", icon: Building2 },
  { name: "Startup MVPs", desc: "Rapid prototyping and lean builds that validate and scale fast.", icon: Rocket }
];

const projects = [
  {
    name: "E-Commerce Marketplace",
    loc: "KOCHI · E-COMMERCE",
    desc: "React, Node.js, PostgreSQL, Redis, AWS rebuild with microservices, caching, and CDN.",
    result: "Page load 4.2s → 0.8s, concurrent users 1,000 → 50,000, transactions +400%, revenue +350%."
  },
  {
    name: "SaaS Analytics Platform",
    loc: "BANGALORE · SAAS",
    desc: "Multi-tenant platform with Kafka, TimescaleDB, Elasticsearch, React + D3.js, and GraphQL APIs on AWS.",
    result: "Customers +400%, MRR +400%, <1s latency, 99.99% uptime, 95% NPS."
  },
  {
    name: "Healthcare Management System",
    loc: "KERALA · HEALTHCARE",
    desc: "HIPAA-compliant EHR, telemedicine, scheduling, and secure messaging with SOC 2 Type II certification.",
    result: "200+ facilities, 50,000+ patients monthly, zero breaches in 2+ years, Rs. 1Cr+ telemedicine revenue."
  }
];

const testimonials = [
  {
    quote: "Professional, results-driven. Delivered exactly what we needed within budget and timeline.",
    author: "CTO",
    role: "SaaS Company, Bangalore"
  },
  {
    quote: "Outstanding web application development team. Understood our complex requirements and delivered a scalable solution handling 10x growth.",
    author: "CEO",
    role: "Fintech Startup, Kochi"
  },
  {
    quote: "Best web application development company. High-quality application our users love. Highly recommended.",
    author: "Founder",
    role: "Healthcare Platform, Kerala"
  },
  {
    quote: "Exceptional expertise. Secure web application development practices and enterprise approach gave us confidence.",
    author: "CTO",
    role: "Manufacturing Company, Ernakulam"
  }
];

const faqs = [
  {
    q: "What does web application development cost in Kochi?",
    a: "Web application development cost ranges from Rs. 3L for MVPs to Rs. 40L+ for enterprise systems. Cost depends on features, complexity, timeline, and team size. Custom quotes provided after understanding requirements."
  },
  {
    q: "How long does web application development take?",
    a: "MVP: 2-3 months. Standard: 3-4 months. Enterprise: 4-6 months. We provide a detailed timeline before starting."
  },
  {
    q: "What technologies do you use?",
    a: "React, Vue.js, Angular (frontend), Node.js, Python, Java (backend), PostgreSQL, MongoDB (databases), AWS/Azure (cloud). Framework selection based on your requirements."
  },
  {
    q: "Do you provide web application development support after launch?",
    a: "Yes. We offer maintenance packages covering updates, security patches, feature enhancements, and bug fixes. Ongoing support included."
  },
  {
    q: "How secure is your web application development?",
    a: "Secure web application development is standard. We implement encryption, authentication, OWASP standards, regular security testing, and compliance (GDPR, HIPAA, PCI-DSS)."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={title} description={description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- HERO SECTION WITH OFFICE CIRCLING SVG (DARK VERSION) -->
    <section class="relative pt-32 pb-24 md:pt-36 md:pb-32 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.png')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 grid xl:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="xl:col-span-7 flex flex-col items-center text-center xl:items-start xl:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
            <Zap class="w-3.5 h-3.5" />
            Kerala's Premier Digital Studio
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-black leading-[1.1] tracking-tight text-white mb-6">
            Web
            <span class="relative inline-block text-primary">
              Application
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
            <br class="hidden sm:block" />
            Development Company Kochi
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-neutral-300 mb-5 max-w-2xl font-medium leading-relaxed">
            Enterprise-Grade Custom Applications for Kerala Businesses. Scalable · Secure · Professional — Custom Web Application Development Solutions | 100+ Projects | Since 2018.
          </p>
          <p class="text-sm sm:text-base text-neutral-400 mb-8 max-w-2xl font-medium leading-relaxed">
            Web Application Development Company Kochi is a professional application development agency delivering custom, scalable, web application development solutions for businesses across Kerala, India, and the GCC region. Since 2018, we have completed 100+ web application development projects — from startup MVPs to large-scale enterprise systems — helping Kerala businesses build powerful digital platforms that drive growth and operational efficiency.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
            <a href="#contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap">
              Book a Free Consultation
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href="#services" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white border border-white/20 rounded-full hover:bg-white/5 transition-all duration-300 shadow-sm whitespace-nowrap">
              Explore Our Services
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Hero Graphic (Redesigned Stats Cards Grid) -->
        <div class="xl:col-span-5 grid grid-cols-2 gap-4 sm:gap-6">

          <!-- Card 1 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Rocket class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">100+</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Applications</span>
          </div>

          <!-- Card 2 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Calendar class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">2018</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Established</span>
          </div>

          <!-- Card 3 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <TrendingUp class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Page 1</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Results</span>
          </div>

          <!-- Card 4 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Globe2 class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Kerala</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Wide Coverage</span>
          </div>

        </div>
      </div>
    </section>

    <!-- INTRO BAND -->
    <section class="py-12 bg-white border-b border-neutral-100 relative">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <p class="text-neutral-600 text-base sm:text-lg leading-relaxed font-medium max-w-4xl">
          Every business today needs a powerful, scalable web application development solution that automates processes and enhances user experience. As a dedicated Professional Web Application Development Kochi provider, Teknoppy combines modern architecture with proven execution — using cutting-edge web application development technologies and frameworks — delivered by an in-house Kochi team specializing in web application development for startups through enterprise-scale systems.
        </p>
      </div>
    </section>

    <!-- WHY TEKNOPPY SECTION -->
    <section class="py-24 bg-[#FFF8EF]/30 border-y border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.png')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

          <!-- Left Column (Sticky Panel) -->
          <div class="lg:col-span-5 lg:sticky lg:top-32 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider shadow-sm">
              Trusted Partners
            </div>
            <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
              Why Teknoppy Is the Trusted <br />
              <span class="text-primary">Web Application Development Company Kochi</span>
            </h2>
            <p class="text-neutral-500 font-medium text-sm leading-relaxed max-w-sm">
              We strip away generic templates to engineer custom-built, high-performance web application platforms designed to scale, secure, and drive measurable business growth.
            </p>
          </div>

          <!-- Right Column (Premium Custom Cards Grid) -->
          <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6 lg:gap-8">

            <!-- Card 1 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">01 . Architecture</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Custom Architecture, Not Template Solutions</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Every web application development project begins with discovery and architecture planning mapped to your business goals. Our in-house Kochi team covers full-stack development, database design, API development, security architecture, testing, and deployment — all under one roof.
                </p>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">02 . Scale</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Scalable-First Studio</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Every application is built using scalable web application development patterns, tested against cloud web application development benchmarks, and structured with clean architecture. Your application enters production ready to scale.
                </p>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">03 . Clarity</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Full Transparency</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Written project timelines, clearly defined development phases, real cost estimates, and post-launch support packages. No hidden costs.
                </p>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">04 . Partnership</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Local Kochi Team</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Teknoppy is headquartered in Kochi, Kerala — not a remote offshore agency. Strategy discussions, code reviews, urgent updates — we are one message away.
                </p>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- OUR WEB APPLICATION DEVELOPMENT SERVICES IN KOCHI -->
    <section id="services" class="py-20 bg-white relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.png')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Services Scope
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            Our <span class="text-primary">Web Application Development</span> Services in Kochi
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base sm:text-lg">
            We build custom web applications across industries and platforms.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {services.map(svc => {
            const IconComp = svc.icon;
            return (
              <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col">
                <!-- Left Gradient Stroke -->
                <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 bg-primary/5 text-primary rounded-2xl flex items-center justify-center flex-shrink-0 border border-primary/10 shadow-inner">
                    <IconComp class="w-6 h-6" />
                  </div>
                  <h3 class="text-base sm:text-[17px] font-black text-neutral-850 leading-snug">{svc.title}</h3>
                </div>
                <p class="text-neutral-500 text-xs leading-relaxed mt-4 font-semibold">{svc.desc}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- WEB APPLICATION DEVELOPMENT PROCESS SECTION (LIGHT TIMELINE CARDS) -->
    <section class="py-24 bg-[#FFF9F6]/40 border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.png')]" style="opacity: 0.8;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            • Our Process •
          </div>
          <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
            Our <span class="text-primary">Web Application Development</span> Process
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            Our professional web application development process follows six clearly defined stages, ensuring every project is delivered on time, within budget, and built precisely to brief.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-y-12 gap-x-6 lg:gap-x-8 relative z-10">
          {processes.map((proc, idx) => {
            const IconComponent = proc.icon;
            return (
              <div class="relative bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col justify-between group min-h-[260px]">
                <div>
                  <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-primary/5 text-primary rounded-2xl flex items-center justify-center flex-shrink-0 border border-primary/10 shadow-inner">
                      <IconComponent class="w-6 h-6" />
                    </div>
                    <div>
                      <span class="block text-[9px] font-black text-primary uppercase tracking-widest">Step {proc.step}</span>
                      <h3 class="text-base sm:text-[17px] font-black text-neutral-850 leading-snug mt-0.5 group-hover:text-primary transition-colors duration-300">{proc.title}</h3>
                    </div>
                  </div>
                  <p class="text-neutral-500 text-xs leading-relaxed mt-5 font-semibold">{proc.desc}</p>
                </div>
                <div class="w-10 h-[3px] bg-primary/80 mt-6 rounded-full"></div>

                {/* Horizontal Connector Arrow */}
                {idx % 3 !== 2 && (
                  <div class="hidden lg:flex absolute right-[-20px] top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center shadow-md shadow-primary/20 z-20 transition-transform duration-300 group-hover:scale-110">
