---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Play, Globe2, Smile, Award, Star, CheckCircle, Clock, Heart, Shield, Check, HelpCircle, User, Zap, Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages, MonitorSmartphone, Building2, Edit, ShieldCheck, Search, Layers, Network, Code, Gauge, LayoutGrid, Calendar, TrendingUp } from 'lucide-react';
import page from '../data/pages/web-application.json';
import { getCollection } from 'astro:content';
import blogPage from '../data/pages/blog.json';
import { webAppSchema } from '../data/schemas/webAppSchema';

// Latest Blog Posts — pulled live from the blog collection at build time so the
// section tracks the CMS rather than a hand-maintained list. Category matching
// reuses the blog hub's own `match[]` mapping (CMS authors type categories
// freehand, so the hub owns the mapping, not the posts).
const blogCat = blogPage.categories.items.find((c) => c.slug === 'web-application')!;
const normCat = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const wantedCats = new Set([...blogCat.match.map(normCat), normCat(blogCat.slug)]);

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const onTopicPosts = publishedPosts.filter((e) => wantedCats.has(normCat(e.data.category)));

// No Web Application post is published yet. Rather than render an empty
// section, fall back to the newest posts sitewide and say so — the section
// becomes correctly topical the moment the first web-app post lands.
const usingFallback = onTopicPosts.length === 0;
const latestPosts = (usingFallback ? publishedPosts : onTopicPosts).slice(0, 3).map((e) => ({
  title: e.data.title,
  excerpt: e.data.excerpt,
  category: e.data.category,
  author: e.data.author,
  date: e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  readTime: e.data.readTime,
  image: e.data.cover,
  href: `/blog/${e.id}/`
}));

// Icons stay hardcoded, zipped by index onto the JSON data arrays.
const serviceIcons = [Code, Rocket, Building2, Layers, Activity, Shield, Network];
const processIcons = [Search, Network, Code, Gauge, Rocket, ShieldCheck];
const industryIcons = [Layers, Activity, Shield, Network, Building2, Rocket];

// Case-study accent palettes, selected per block via block.accent (keeps full
// Tailwind class strings in source so the JIT compiler detects them).
const caseAccents: Record<string, { glow: string; mesh: string; label: string }> = {
  blue:    { glow: "from-blue-500/20 to-indigo-500/20",   mesh: "from-blue-500/10",    label: "text-blue-400" },
  emerald: { glow: "from-emerald-500/20 to-teal-500/20",  mesh: "from-emerald-500/10", label: "text-emerald-400" },
  violet:  { glow: "from-violet-500/20 to-purple-500/20", mesh: "from-violet-500/10",  label: "text-violet-400" }
};
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <!-- HERO SECTION WITH OFFICE CIRCLING SVG (DARK VERSION) -->
    <section class="relative pt-32 pb-24 md:pt-36 md:pb-32 overflow-hidden theme-keep-light bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.webp')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 grid xl:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="xl:col-span-7 flex flex-col items-center text-center xl:items-start xl:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
            <Zap class="w-3.5 h-3.5" />
            {page.hero.badge}
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-black leading-[1.1] tracking-tight text-white mb-6">
            {page.hero.headingPre}
            <span class="relative inline-block text-primary">
              {page.hero.headingHighlight}
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
            <br class="hidden sm:block" />
            {page.hero.headingPost}
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-neutral-300 mb-5 max-w-2xl font-medium leading-relaxed">
            {page.hero.subheadline}
          </p>
          <p class="text-sm sm:text-base text-neutral-400 mb-8 max-w-2xl font-medium leading-relaxed">
            {page.hero.body}
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
            <a href={page.hero.ctaPrimary.href} class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap">
              {page.hero.ctaPrimary.label}
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href={page.hero.ctaSecondary.href} class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white border border-white/20 rounded-full hover:bg-white/5 transition-all duration-300 shadow-sm whitespace-nowrap">
              {page.hero.ctaSecondary.label}
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Hero Graphic (Redesigned Stats Cards Grid) -->
        <div class="xl:col-span-5 grid grid-cols-2 gap-4 sm:gap-6">

          <!-- Card 1 -->
          <div class="theme-keep-light bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Rocket class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">{page.hero.statCards[0].value}</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[11px] font-black text-neutral-400 uppercase tracking-widest leading-normal">{page.hero.statCards[0].label}</span>
          </div>

          <!-- Card 2 -->
          <div class="theme-keep-light bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Calendar class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">{page.hero.statCards[1].value}</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[11px] font-black text-neutral-400 uppercase tracking-widest leading-normal">{page.hero.statCards[1].label}</span>
          </div>

          <!-- Card 3 -->
          <div class="theme-keep-light bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <TrendingUp class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">{page.hero.statCards[2].value}</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[11px] font-black text-neutral-400 uppercase tracking-widest leading-normal">{page.hero.statCards[2].label}</span>
          </div>

          <!-- Card 4 -->
          <div class="theme-keep-light bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Globe2 class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">{page.hero.statCards[3].value}</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[11px] font-black text-neutral-400 uppercase tracking-widest leading-normal">{page.hero.statCards[3].label}</span>
          </div>

        </div>
      </div>
    </section>

    <!-- INTRO BAND -->
    <section class="py-12 bg-white border-b border-neutral-100 relative">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <p class="text-neutral-600 text-base sm:text-lg leading-relaxed font-medium max-w-4xl">
          {page.introBand}
        </p>
      </div>
    </section>

    <!-- WHY TEKNOPPY SECTION -->
    <section class="py-24 bg-cream/30 border-y border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.webp')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

          <!-- Left Column (Sticky Panel) -->
          <div class="lg:col-span-5 lg:sticky lg:top-32 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider shadow-sm">
              {page.whyTeknoppy.badge}
            </div>
            <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
              {page.whyTeknoppy.headingPre} <br />
              <span class="text-primary">{page.whyTeknoppy.headingHighlight}</span>
            </h2>
            <p class="text-neutral-500 font-medium text-sm leading-relaxed max-w-sm">
              {page.whyTeknoppy.intro}
            </p>
          </div>

          <!-- Right Column (Premium Custom Cards Grid) -->
          <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6 lg:gap-8">

            <!-- Card 1 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">{page.whyTeknoppy.cards[0].tag}</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">{page.whyTeknoppy.cards[0].title}</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  {page.whyTeknoppy.cards[0].description}
                </p>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">{page.whyTeknoppy.cards[1].tag}</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">{page.whyTeknoppy.cards[1].title}</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  {page.whyTeknoppy.cards[1].description}
                </p>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">{page.whyTeknoppy.cards[2].tag}</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">{page.whyTeknoppy.cards[2].title}</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  {page.whyTeknoppy.cards[2].description}
                </p>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">{page.whyTeknoppy.cards[3].tag}</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">{page.whyTeknoppy.cards[3].title}</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  {page.whyTeknoppy.cards[3].description}
                </p>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- OUR WEB APPLICATION DEVELOPMENT SERVICES IN KOCHI -->
    <section id="services" class="py-20 bg-white relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.webp')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {page.services.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {page.services.headingPre} <span class="text-primary">{page.services.headingHighlight}</span> {page.services.headingPost}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base sm:text-lg">
            {page.services.intro}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {page.services.cards.map((svc, i) => {
            const IconComp = serviceIcons[i];
            const Card = svc.href ? 'a' : 'div';
            return (
              <Card href={svc.href} class="group relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col">
                <!-- Left Gradient Stroke -->
                <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 bg-primary/5 text-primary rounded-2xl flex items-center justify-center flex-shrink-0 border border-primary/10 shadow-inner">
                    <IconComp class="w-6 h-6" />
                  </div>
                  <h3 class:list={["text-base sm:text-[18px] font-black text-neutral-850 leading-snug", svc.href && "group-hover:text-primary transition-colors duration-300"]}>{svc.title}</h3>
                </div>
                <p class="text-neutral-500 text-xs leading-relaxed mt-4 font-semibold">{svc.desc}</p>
                {svc.href && (
                  <span class="inline-flex items-center gap-1.5 mt-5 text-xs font-bold text-primary">
                    Learn more <ArrowRight class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" />
                  </span>
                )}
              </Card>
            );
          })}
        </div>
      </div>
    </section>

    <!-- APPLICATION TYPES DIRECTORY — links every sub-page built under this pillar -->
    {page.subServices && (
      <section class="py-24 bg-white border-t border-neutral-100 relative">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
          <div class="max-w-3xl mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.subServices.badge}
            </div>
            <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">
              {page.subServices.heading}
            </h2>
            <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">
              {page.subServices.intro}
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {page.subServices.items.map((item) => (
              <a
                href={item.href}
                class="group bg-white rounded-2xl border border-neutral-100 p-5 sm:p-6 shadow-[0_12px_30px_-18px_rgba(0,0,0,0.08)] hover:border-primary/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_-20px_rgba(0,0,0,0.1)] transition-all duration-300 flex items-start justify-between gap-4"
              >
                <span class="min-w-0">
                  <span class="block text-[15px] font-black text-neutral-900 group-hover:text-primary transition-colors leading-snug">{item.title}</span>
                  <span class="block text-neutral-500 text-xs font-semibold mt-1.5 leading-relaxed">{item.desc}</span>
                </span>
                <ArrowRight class="w-4 h-4 text-primary flex-shrink-0 mt-0.5 transition-transform duration-300 group-hover:translate-x-1" />
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- WEB APPLICATION DEVELOPMENT PROCESS SECTION (LIGHT TIMELINE CARDS) -->
    <section class="py-24 bg-warm/40 border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.webp')]" style="opacity: 0.8;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {page.process.badge}
          </div>
          <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
            {page.process.headingPre} <span class="text-primary">{page.process.headingHighlight}</span> {page.process.headingPost}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.process.intro}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-y-12 gap-x-6 lg:gap-x-8 relative z-10">
          {page.process.steps.map((proc, idx) => {
            const IconComponent = processIcons[idx];
            return (
              <div class="relative bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col justify-between group min-h-[260px]">
                <div>
                  <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-primary/5 text-primary rounded-2xl flex items-center justify-center flex-shrink-0 border border-primary/10 shadow-inner">
                      <IconComponent class="w-6 h-6" />
                    </div>
                    <div>
                      <span class="block text-[11px] font-black text-primary uppercase tracking-widest">Step {proc.step}</span>
                      <h3 class="text-base sm:text-[18px] font-black text-neutral-850 leading-snug mt-0.5 group-hover:text-primary transition-colors duration-300">{proc.title}</h3>
                    </div>
                  </div>
                  <p class="text-neutral-500 text-xs leading-relaxed mt-5 font-semibold">{proc.desc}</p>
                </div>
                <div class="w-10 h-[3px] bg-primary/80 mt-6 rounded-full"></div>

                {/* Horizontal Connector Arrow */}
                {idx % 3 !== 2 && (
                  <div class="hidden lg:flex absolute right-[-20px] top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center shadow-md shadow-primary/20 z-20 transition-transform duration-300 group-hover:scale-110">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- PRICING TABLE SECTION -->
    <section class="py-20 bg-white border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/pricingbg.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-12">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {page.pricing.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight mb-4">
            {page.pricing.headingPre} <span class="text-primary">{page.pricing.headingHighlight}</span>
          </h2>
          <p class="text-neutral-500 font-medium text-base">
            {page.pricing.intro}
          </p>
        </div>

        <div class="bg-white rounded-3xl border border-neutral-200/60 overflow-hidden shadow-sm">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-primary text-white font-bold text-sm sm:text-base border-b border-primary/20">
                <th class="p-4 sm:p-5">Service Type</th>
                <th class="p-4 sm:p-5 text-right">Estimated Investment</th>
                <th class="p-4 sm:p-5 text-right">Timeline</th>
              </tr>
            </thead>
            <tbody>
              {page.pricing.rows.map((priceItem, idx) => (
                <tr class={`border-b border-neutral-100 hover:bg-neutral-50/50 transition-colors ${idx % 2 === 0 ? 'bg-white' : 'bg-neutral-50/20'}`}>
                  <td class="p-4 sm:p-5 font-bold text-neutral-800 text-sm sm:text-base">{priceItem.type}</td>
                  <td class="p-4 sm:p-5 text-right font-black text-primary text-sm sm:text-base">{priceItem.price}</td>
                  <td class="p-4 sm:p-5 text-right font-bold text-neutral-600 text-sm sm:text-base">{priceItem.timeline}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-neutral-500 text-xs mt-4 leading-relaxed max-w-3xl font-medium">
          {page.pricing.footnote}
        </p>
      </div>
    </section>

    <!-- TARGET INDUSTRIES SECTION (DARK AMBER THEME) -->
    <section class="py-20 theme-keep-light bg-neutral-950 text-white border-t border-white/5 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/industriesbg.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/20 border border-amber-500/30 text-amber-400 text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {page.industries.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-white leading-tight">
            <span class="text-[#F9AE42]">{page.industries.headingHighlight}</span> {page.industries.headingPost}
          </h2>
          <p class="text-neutral-400 font-medium mt-3 text-base">
            {page.industries.intro}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.industries.items.map((ind, i) => {
            const IconComponent = industryIcons[i];
            // Same treatment as the service cards: a card with an `href`
            // renders as an anchor so the grid is a navigation path, not a
            // dead end.
            const Card = ind.href ? 'a' : 'div';
            return (
              <Card href={ind.href} class="group bg-neutral-900/60 border border-amber-500/10 p-6 rounded-3xl shadow-lg hover:border-amber-500/40 hover:-translate-y-1 transition-all duration-300 flex items-start gap-4">
                <div class="w-10 h-10 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <IconComponent class="w-5 h-5" />
                </div>
                <div>
                  <h3 class:list={["text-base font-bold text-white mb-2", ind.href && "group-hover:text-[#F9AE42] transition-colors duration-300"]}>{ind.name}</h3>
                  <p class="text-neutral-400 text-xs leading-relaxed font-semibold">{ind.desc}</p>
                  {ind.href && (
                    <span class="inline-flex items-center gap-1.5 mt-3 text-[11px] font-black text-amber-400 uppercase tracking-wider">
                      Explore
                      <ArrowRight class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" />
                    </span>
                  )}
                </div>
              </Card>
            );
          })}
        </div>
      </div>
    </section>

    <!-- OUR WEB APPLICATION CASE STUDY — PROVEN RESULTS -->
    <!-- Named, published clients only. The `caseStudies` block below this one
         stays drafted because its figures are unverified; these two are backed
         by their own live case-study pages, so they carry no held-back stats. -->
    {page.featuredCaseStudies && (
      <section class="py-24 bg-white border-t border-neutral-100 relative">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
          <div class="max-w-3xl mb-14">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.featuredCaseStudies.badge}
            </div>
            <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">
              {page.featuredCaseStudies.headingPre} <span class="text-primary">{page.featuredCaseStudies.headingHighlight}</span> {page.featuredCaseStudies.headingPost}
            </h2>
            <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">
              {page.featuredCaseStudies.intro}
            </p>
          </div>

          <div class="grid gap-6 lg:grid-cols-2">
            {page.featuredCaseStudies.items.map((cs) => (
              <a
                href={cs.href}
                class="group relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-7 sm:p-8 shadow-[0_12px_30px_-18px_rgba(0,0,0,0.08)] hover:border-primary/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_-20px_rgba(0,0,0,0.1)] transition-all duration-300 flex flex-col"
              >
                <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class="text-[15px] font-black text-neutral-900">{cs.client}</span>
                  <span class="text-[11px] font-black text-primary bg-primary/5 px-2.5 py-1 rounded-full uppercase tracking-wider whitespace-nowrap">{cs.sector}</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-black text-neutral-900 leading-snug group-hover:text-primary transition-colors">{cs.title}</h3>
                <p class="text-neutral-600 text-sm leading-relaxed font-medium mt-3 flex-grow">{cs.text}</p>
                <div class="bg-neutral-50/70 rounded-2xl p-4 border border-neutral-100 mt-6">
                  <span class="block text-[11px] font-black text-neutral-800 uppercase tracking-wider mb-1">Scope</span>
                  <p class="text-neutral-500 text-xs font-semibold leading-relaxed">{cs.stack}</p>
                </div>
                <span class="inline-flex items-center gap-1.5 mt-6 text-xs font-black text-primary uppercase tracking-wider">
                  Read the case study
                  <ArrowRight class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" />
                </span>
              </a>
            ))}
          </div>

          {page.featuredCaseStudies.viewAll && (
            <a href={page.featuredCaseStudies.viewAll.href} class="inline-flex items-center gap-2 mt-10 px-7 py-3.5 text-sm font-bold text-neutral-900 bg-white border border-neutral-200 rounded-full hover:border-primary hover:text-primary transition-all duration-300">
              {page.featuredCaseStudies.viewAll.label}
              <ArrowRight class="w-4 h-4" />
            </a>
          )}
        </div>
      </section>
    )}

    <!-- CASE STUDIES SECTION (PORTFOLIO STYLE) -->
    <!-- `draft: true` in web-application.json holds finished copy back from the
         live page — used where the figures are not yet verified. -->
    {page.caseStudies.draft !== true && (
    <section class="py-24 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mb-20">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Success Stories
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {page.caseStudies.headingPre} <span class="text-primary">{page.caseStudies.headingHighlight}</span> {page.caseStudies.headingPost}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.caseStudies.intro}
          </p>
        </div>

        <div class="space-y-24">

          {page.caseStudies.blocks.map((block, idx) => {
            const accent = caseAccents[block.accent];
            return (
              <div class={`flex flex-col ${idx % 2 === 1 ? 'lg:flex-row-reverse' : 'lg:flex-row'} items-center gap-12 lg:gap-16 group relative`}>
                {/* Left: Mockup Window */}
                <div class="w-full lg:w-[48%] relative z-10">
                  {/* Glow */}
                  <div class={`absolute inset-0 bg-gradient-to-tr ${accent.glow} rounded-[2rem] scale-105 opacity-0 group-hover:opacity-100 transition-all duration-700 blur-xl`}></div>

                  {/* Browser */}
                  <div class="relative bg-white rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-neutral-100 overflow-hidden transform group-hover:-translate-y-1.5 transition-all duration-500">
                    <div class="h-10 bg-neutral-50 border-b border-neutral-100/80 flex items-center px-4 gap-2">
                      <div class="w-3 h-3 rounded-full bg-[#FF5F56]"></div>
                      <div class="w-3 h-3 rounded-full bg-[#FFBD2E]"></div>
                      <div class="w-3 h-3 rounded-full bg-[#27C93F]"></div>
                      {block.site && <span class="ml-3 text-[13px] font-semibold text-neutral-400 truncate">{block.site}</span>}
                    </div>
                    {block.image
                      ? <img
                          src={block.image}
                          alt={block.imageAlt}
                          width="1440"
                          height="900"
                          loading="lazy"
                          decoding="async"
                          class="w-full aspect-[16/10] object-cover object-top block"
                        />
                      : (
                      <div class="aspect-[16/10] theme-keep-light bg-[#0c0c0e] relative overflow-hidden flex flex-col items-center justify-center p-8 text-center">
                        {/* Abstract mesh */}
                        <div class={`absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] ${accent.mesh} via-transparent to-transparent`}></div>
                        <span class={`text-xs font-black ${accent.label} uppercase tracking-widest mb-3`}>{block.label}</span>
                        <span class="text-4xl sm:text-5xl font-black text-white leading-none mb-3">{block.metric}</span>
                        <span class="text-xs text-neutral-400 uppercase tracking-wider font-semibold">{block.metricSub}</span>
                      </div>
                      )}
                  </div>
                </div>

                {/* Right: Content */}
                <div class="w-full lg:w-[52%] space-y-6">
                  <div>
                    <span class="text-xs font-black text-primary uppercase tracking-widest">Case Study {String(idx + 1).padStart(2, '0')}</span>
                    <h3 class="text-2xl font-black text-neutral-900 mt-1">{block.title}</h3>
                  </div>
                  <p class="text-sm text-neutral-500 leading-relaxed font-medium">
                    {block.intro}
                  </p>

                  <div class="grid sm:grid-cols-2 gap-4">
                    <div class="bg-neutral-50/50 rounded-2xl p-5 border border-neutral-100">
                      <h4 class="text-xs font-black text-neutral-900 uppercase tracking-wider mb-2">Our Approach</h4>
                      <ul class="space-y-1.5 text-xs text-neutral-500 font-semibold list-disc pl-4">
                        {block.approach.map(item => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-neutral-50/50 rounded-2xl p-5 border border-neutral-100">
                      <h4 class="text-xs font-black text-neutral-900 uppercase tracking-wider mb-2">The Results</h4>
                      <ul class="space-y-1.5 text-xs text-neutral-500 font-semibold list-disc pl-4">
                        {block.results.map(item => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  {/* Testimonial Quote */}
                  <div class="border-l-4 border-primary pl-4 py-1.5 bg-cream/30 rounded-r-2xl">
                    <p class="text-xs text-neutral-600 font-medium italic leading-relaxed">
                      "{block.quote}"
                    </p>
                    <span class="block text-xs font-black text-neutral-900 mt-2">— {block.author}</span>
                  </div>
                </div>
              </div>
            );
          })}

        </div>
      </div>
    </section>
    )}

    <!-- CLIENT TESTIMONIALS SECTION -->
    {page.testimonials.draft !== true && (
    <section class="py-20 bg-neutral-50/50 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Testimonials
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {page.testimonials.headingPre} <span class="text-primary">{page.testimonials.headingHighlight}</span> {page.testimonials.headingPost}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.testimonials.intro}
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.testimonials.items.map(item => (
            <div class="bg-white border border-neutral-200/50 rounded-3xl p-6 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex gap-1 text-[#F9AE42] mb-4">
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                </div>
                <p class="text-xs text-neutral-600 font-medium italic leading-relaxed mb-6">
                  "{item.quote}"
                </p>
              </div>
              <div class="border-t border-neutral-100 pt-4 mt-auto">
                <span class="block text-sm font-bold text-neutral-800">{item.author}</span>
                <span class="block text-[12px] text-neutral-400 font-bold uppercase tracking-wider mt-0.5">{item.role}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- FEATURED PROJECTS LIST -->
    {page.projects.draft !== true && (
    <section class="py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Our Portfolio
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {page.projects.headingPre} <span class="text-primary">{page.projects.headingHighlight}</span> {page.projects.headingPost}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.projects.intro}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
          {page.projects.items.map(proj => (
            <div class="bg-white rounded-3xl border border-neutral-200/60 p-6 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg font-bold text-neutral-900">{proj.name}</h3>
                  <span class="text-[11px] font-black text-primary bg-primary/5 px-2 py-0.5 rounded-full uppercase tracking-wider">{proj.loc}</span>
                </div>
                <p class="text-neutral-600 text-xs leading-relaxed font-semibold mb-4">{proj.desc}</p>
                <div class="bg-neutral-50/50 rounded-2xl p-4 border border-neutral-100">
                  <span class="block text-[12px] font-black text-neutral-800 uppercase tracking-wider mb-1">Result</span>
                  <p class="text-neutral-500 text-xs font-semibold leading-relaxed">{proj.result}</p>
                </div>
              </div>
              <a href="#contact" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary mt-6 hover:underline">
                Enquire for details
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- FAQS SECTION -->
    <section class="py-20 bg-neutral-50/50 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Support & FAQs
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {page.faqs.headingPre} <span class="text-primary">{page.faqs.headingHighlight}</span>
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.faqs.intro}
          </p>
        </div>

        <div class="max-w-4xl mx-auto space-y-4">
          {page.faqs.items.map(faq => (
            <details class="group bg-white rounded-2xl border border-neutral-200/60 p-6 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
                <h3 class="text-sm sm:text-base font-bold text-neutral-850 pr-4">
                  {faq.q}
                </h3>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-primary flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-neutral-100/60 text-xs sm:text-sm text-neutral-600 leading-relaxed font-semibold">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- LATEST BLOG POSTS — WEB APPLICATION DEVELOPMENT INSIGHTS -->
    <!-- Teasers come from the blog content collection at build time, so the
         section follows the CMS with no hand-maintained list here. -->
    {page.blog && latestPosts.length > 0 && (
      <section class="py-24 bg-cream/30 border-t border-neutral-100 relative">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
          <div class="max-w-3xl mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.blog.badge}
            </div>
            <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">
              {page.blog.headingPre} <span class="text-primary">{page.blog.headingHighlight}</span> {page.blog.headingPost}
            </h2>
            <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">
              {page.blog.intro}
            </p>
            {usingFallback && (
              <p class="text-neutral-500 text-sm font-semibold mt-3 italic">{page.blog.fallbackNote}</p>
            )}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {latestPosts.map((post) => (
              <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-primary/30 border border-neutral-100/80 transition-all duration-300 flex flex-col h-full">
                <div class="overflow-hidden aspect-[16/10] bg-neutral-100 relative">
                  <img
                    src={post.image}
                    alt={`${post.category} article thumbnail — ${post.title}`}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full bg-white/90 backdrop-blur-sm text-[12px] font-black text-primary uppercase tracking-wider shadow-sm">
                    {post.category}
                  </span>
                </div>

                <div class="p-6 flex flex-col flex-grow justify-between">
                  <div class="space-y-3">
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium text-neutral-400">
                      <span class="flex items-center gap-1.5">
                        <Calendar class="w-3.5 h-3.5" />
                        {post.date}
                      </span>
                      <span class="flex items-center gap-1.5">
                        <Clock class="w-3.5 h-3.5" />
                        {post.readTime}
                      </span>
                    </div>

                    <h3 class="text-lg font-black text-neutral-900 leading-snug group-hover:text-primary transition-colors duration-300">
                      <a href={post.href}>{post.title}</a>
                    </h3>

                    <p class="text-sm text-neutral-500 leading-relaxed font-medium">{post.excerpt}</p>
                  </div>

                  <div class="pt-5 mt-5 border-t border-neutral-50">
                    <a href={post.href} class="inline-flex items-center gap-2 text-sm font-bold text-neutral-850 hover:text-primary transition-colors duration-300">
                      Read Article
                      <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" />
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          {page.blog.viewAll && (
            <a href={page.blog.viewAll.href} class="inline-flex items-center gap-2 mt-10 px-7 py-3.5 text-sm font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300">
              {page.blog.viewAll.label}
              <ArrowRight class="w-4 h-4" />
            </a>
          )}
        </div>
      </section>
    )}
  </main>

  <FooterCTA includeSchema={false} />
</Layout>
