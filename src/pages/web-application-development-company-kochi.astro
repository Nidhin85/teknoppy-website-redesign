---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Play, Globe2, Smile, Award, Star, CheckCircle, Clock, Heart, Shield, Check, HelpCircle, User, Zap, Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages, MonitorSmartphone, Building2, Edit, ShieldCheck, Search, Layers, Network, Code, Gauge, LayoutGrid, Calendar, TrendingUp } from 'lucide-react';
import page from '../data/pages/web-application.json';
import { getCollection } from 'astro:content';
import blogPage from '../data/pages/blog.json';
import { webAppSchema } from '../data/schemas/webAppSchema';

// Latest Blog Posts — pulled live from the blog collection at build time so the
// section tracks the CMS rather than a hand-maintained list. Category matching
// reuses the blog hub's own `match[]` mapping (CMS authors type categories
// freehand, so the hub owns the mapping, not the posts).
const blogCat = blogPage.categories.items.find((c) => c.slug === 'web-application')!;
const normCat = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const wantedCats = new Set([...blogCat.match.map(normCat), normCat(blogCat.slug)]);

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const onTopicPosts = publishedPosts.filter((e) => wantedCats.has(normCat(e.data.category)));

// No Web Application post is published yet. Rather than render an empty
// section, fall back to the newest posts sitewide and say so — the section
// becomes correctly topical the moment the first web-app post lands.
const usingFallback = onTopicPosts.length === 0;
const latestPosts = (usingFallback ? publishedPosts : onTopicPosts).slice(0, 3).map((e) => ({
  title: e.data.title,
  excerpt: e.data.excerpt,
  category: e.data.category,
  author: e.data.author,
  date: e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  readTime: e.data.readTime,
  image: e.data.cover,
  href: `/blog/${e.id}/`
}));

// Icons stay hardcoded, zipped by index onto the JSON data arrays.
const heroStatIcons = [Rocket, Calendar, TrendingUp, Globe2];
const whyIcons = [Zap, Layers, ShieldCheck, Heart];

// Heading colours: highlight one phrase in orange (same words, split for styling only; falls back to plain text).
const splitAccent = (t: string, phrase: string) => { const i = (t ?? '').indexOf(phrase); return i < 0 ? null : [t.slice(0, i), phrase, t.slice(i + phrase.length)]; };
// Hero heading colours match the Ecommerce hero: service name + "in Kochi" orange (same words, split for styling only).
const heroH1Match = page.hero.headingPre.match(/^(Web Application)\s+(.*?)\s+(in)$/);
const heroH1 = heroH1Match ? { key: heroH1Match[1], mid: heroH1Match[2], tail: heroH1Match[3] } : null;
const serviceIcons = [Code, Rocket, Building2, Layers, Activity, Shield, Network];
const processIcons = [Search, Network, Code, Gauge, Rocket, ShieldCheck];
const industryIcons = [Layers, Activity, Shield, Network, Building2, Rocket];

// Case-study accent palettes, selected per block via block.accent (keeps full
// Tailwind class strings in source so the JIT compiler detects them).
const caseAccents: Record<string, { glow: string; mesh: string; label: string }> = {
  blue:    { glow: "from-blue-500/20 to-indigo-500/20",   mesh: "from-blue-500/10",    label: "text-blue-400" },
  emerald: { glow: "from-emerald-500/20 to-teal-500/20",  mesh: "from-emerald-500/10", label: "text-emerald-400" },
  violet:  { glow: "from-violet-500/20 to-purple-500/20", mesh: "from-violet-500/10",  label: "text-violet-400" }
};
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
  floatingCtaLabel="Discuss My Project"
  floatingCtaHref="/request-a-quote/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <Header forceSolidBg={true} />

  <main class="wad-page overflow-hidden bg-[#fffaf6]">
    <!-- HERO (reference layout: dark band, copy left, glowing 3D web-app visual right, stats strip below) -->
    <section class="wad-hero theme-keep-light relative pt-28 sm:pt-32 lg:pt-36 pb-14 sm:pb-16 lg:pb-20 overflow-hidden text-white">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
        <div class="wad-hero-glow"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
          <!-- Hero Text -->
          <div class="lg:col-span-6 flex flex-col items-start text-left">
            <nav class="flex flex-wrap items-center gap-2 text-xs font-medium text-white/60 mb-5" aria-label="Breadcrumb">
              <a href="/" class="hover:text-white transition-colors">Home</a>
              <span class="text-white/30">›</span>
              <a href="/services/" class="hover:text-white transition-colors">Services</a>
              <span class="text-white/30">›</span>
              <span class="text-white font-semibold">Web Application Development Company Kochi</span>
            </nav>
            <div class="wad-badge mb-5">
              <Zap class="w-3.5 h-3.5 shrink-0" />
              <span>{page.hero.badge}</span>
            </div>
            <h1 class="text-[34px] sm:text-[48px] lg:text-[46px] xl:text-[54px] font-black leading-[1.06] tracking-[-0.035em] text-white mb-6">
              {heroH1 ? (<><span class="text-[#ff7a3d]">{heroH1.key}</span>{" "}{heroH1.mid}{" "}<span class="text-[#ff7a3d]">{heroH1.tail}{" "}{page.hero.headingHighlight}</span></>) : (<>{page.hero.headingPre} <span class="text-[#ff7a3d]">{page.hero.headingHighlight}</span></>)}{page.hero.headingPost && ` ${page.hero.headingPost}`}
            </h1>
            <p class="text-base sm:text-lg text-white/90 mb-4 max-w-xl font-semibold leading-snug">
              {page.hero.subheadline}
            </p>
            <p class="text-[15px] sm:text-base text-white/65 mb-8 max-w-xl font-medium leading-relaxed">
              {page.hero.body}
            </p>

            <div class="flex flex-col min-[420px]:flex-row items-stretch min-[420px]:items-center gap-3 sm:gap-4 w-full sm:w-auto">
              <a href={page.hero.ctaPrimary.href} class="inline-flex items-center justify-center gap-2.5 px-7 py-4 text-sm sm:text-base font-bold text-white bg-primary rounded-full shadow-[0_10px_30px_-6px_rgba(240,90,44,0.7)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 leading-snug whitespace-nowrap">
                {page.hero.ctaPrimary.label}
                <ArrowRight class="w-4 h-4" />
              </a>
              <a href={page.hero.ctaSecondary.href} class="inline-flex items-center justify-center gap-3 pl-7 pr-2.5 py-2.5 text-sm sm:text-base font-bold text-neutral-900 bg-white rounded-full hover:-translate-y-0.5 transition-all duration-300 shadow-sm leading-snug whitespace-nowrap">
                {page.hero.ctaSecondary.label}
                <span class="flex items-center justify-center w-9 h-9 rounded-full bg-primary text-white shrink-0">
                  <Play class="w-3.5 h-3.5 ml-0.5" fill="currentColor" />
                </span>
              </a>
            </div>
          </div>

          <!-- Hero visual: browser with code tile, glowing orange ring and floating labels -->
          <div class="lg:col-span-6">
            <div class="wad-visual relative mx-auto w-full max-w-[600px] lg:max-w-none xl:w-[110%]">
              <picture>
                <source media="(max-width: 767px)" srcset="/images/home/3d/webapp-hero-3d-900.webp" />
                <img src="/images/home/3d/webapp-hero-3d.webp" alt="3D web application browser window with a code icon, a glowing orange ring and labels for custom web apps, scalable and secure, API integration and ongoing support" width="1500" height="1039" loading="eager" decoding="async" fetchpriority="high" class="w-full h-auto" />
              </picture>
            </div>
          </div>
        </div>

        <!-- Stats strip -->
        <div class="wad-stats mt-12 lg:mt-14 grid grid-cols-2 lg:grid-cols-4">
          {page.hero.statCards.map((card, i) => {
            const IconComp = heroStatIcons[i];
            return (
              <div class="flex items-center gap-3.5 px-4 sm:px-6 py-4 sm:py-5">
                <span class="w-11 h-11 sm:w-12 sm:h-12 shrink-0 rounded-2xl bg-gradient-to-br from-[#fff1e8] to-[#ffe0cc] text-primary flex items-center justify-center">
                  <IconComp class="w-5 h-5" />
                </span>
                <div class="min-w-0">
                  <span class="block text-xl sm:text-2xl font-black text-neutral-900 leading-none tracking-tight">{card.value}</span>
                  <span class="block text-xs sm:text-[13px] text-neutral-500 font-medium mt-1.5 leading-snug">{card.label}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- INTRO BAND -->
    <section class="py-12 bg-white border-b border-neutral-100 relative">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <p class="text-neutral-600 text-base sm:text-lg leading-relaxed font-medium max-w-4xl">
          {page.introBand}
        </p>
      </div>
    </section>

    <!-- WHY TEKNOPPY SECTION -->
    <section class="py-24 bg-cream/30 border-y border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.webp')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-10 sm:mb-12">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider shadow-sm mb-5">
              {page.whyTeknoppy.badge}
            </div>
            <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
              {page.whyTeknoppy.headingPre} <br class="hidden sm:inline" />
              <span class="text-primary">{page.whyTeknoppy.headingHighlight}</span>
            </h2>
          </div>
          <p class="lg:col-span-5 text-neutral-600 font-medium text-base sm:text-[17px] leading-relaxed">
            {page.whyTeknoppy.intro}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          {page.whyTeknoppy.cards.map((card, i) => {
            const WIcon = whyIcons[i] ?? Zap;
            return (
              <div class="wad-card group p-6 sm:p-7 flex flex-col">
                <span class="wad-icon mb-5"><WIcon class="w-6 h-6" /></span>
                <span class="text-[11px] font-bold text-primary uppercase tracking-widest block mb-2">{card.tag}</span>
                <h3 class="text-lg font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-2.5 leading-snug">{card.title}</h3>
                <p class="text-neutral-600 text-sm leading-relaxed">{card.description}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- OUR WEB APPLICATION DEVELOPMENT SERVICES IN KOCHI -->
    <section id="services" class="py-20 bg-white relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.webp')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-10 sm:mb-12">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.services.badge}
            </div>
            <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
              {page.services.headingPre} <span class="text-primary">{page.services.headingHighlight}</span> {page.services.headingPost}
            </h2>
          </div>
          <p class="lg:col-span-5 text-neutral-600 font-medium text-base sm:text-lg leading-relaxed">
            {page.services.intro}
          </p>
        </div>

        <div class="wad-svc-grid grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 lg:gap-6">
          {page.services.cards.map((svc, i) => {
            const IconComp = serviceIcons[i];
            const Card = svc.href ? 'a' : 'div';
            return (
              <Card href={svc.href} class="wad-card group p-6 sm:p-7 flex flex-col">
                <span class="wad-icon mb-5"><IconComp class="w-6 h-6" /></span>
                <h3 class:list={["text-lg sm:text-[19px] font-bold text-neutral-900 leading-snug mb-2.5", svc.href && "group-hover:text-primary transition-colors duration-300"]}>{svc.title}</h3>
                <p class="text-neutral-600 text-sm sm:text-[15px] leading-relaxed">{svc.desc}</p>
                {svc.href && (
                  <span class="inline-flex items-center gap-1.5 mt-auto pt-5 text-[13px] font-bold text-primary">
                    Learn more <ArrowRight class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" />
                  </span>
                )}
              </Card>
            );
          })}
        </div>
      </div>
    </section>

    <!-- APPLICATION TYPES DIRECTORY — links every sub-page built under this pillar -->
    {page.subServices && (
      <section class="py-24 bg-white border-t border-neutral-100 relative">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
          <div class="max-w-3xl mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.subServices.badge}
            </div>
            <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">
              {(() => { const t = splitAccent(page.subServices.heading, "Web Applications"); return t ? (<>{t[0]}<span class="text-primary">{t[1]}</span>{t[2]}</>) : page.subServices.heading; })()}
            </h2>
            <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">
              {page.subServices.intro}
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            {page.subServices.items.map((item) => (
              <a
                href={item.href}
                class="wad-card group p-5 sm:p-6 flex items-start justify-between gap-4"
              >
                <span class="min-w-0">
                  <span class="block text-[15px] font-black text-neutral-900 group-hover:text-primary transition-colors leading-snug">{item.title}</span>
                  <span class="block text-neutral-600 text-sm font-medium mt-1.5 leading-relaxed">{item.desc}</span>
                </span>
                <ArrowRight class="w-4 h-4 text-primary flex-shrink-0 mt-0.5 transition-transform duration-300 group-hover:translate-x-1" />
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- WEB APPLICATION DEVELOPMENT PROCESS SECTION (LIGHT TIMELINE CARDS) -->
    <section class="py-24 bg-warm/40 border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.webp')]" style="opacity: 0.8;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {page.process.badge}
          </div>
          <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
            {page.process.headingPre} <span class="text-primary">{page.process.headingHighlight}</span> {page.process.headingPost}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.process.intro}
          </p>
        </div>

        <ol class="wad-process relative grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-9 sm:gap-x-6 lg:gap-x-4 z-10">
          {page.process.steps.map((proc, idx) => {
            const IconComponent = processIcons[idx];
            return (
              <li class="group relative flex flex-col items-center text-center">
                <div class="relative z-10 w-16 h-16 rounded-full bg-white border border-primary/15 shadow-[0_18px_36px_-20px_rgba(160,60,20,0.55)] flex items-center justify-center text-primary mb-4 transition-all duration-300 group-hover:bg-primary group-hover:text-white group-hover:-translate-y-1">
                  <IconComponent class="w-6 h-6" />
                </div>
                <span class="text-[11px] font-bold text-primary uppercase tracking-[0.14em] mb-1">Step {proc.step}</span>
                <h3 class="text-base sm:text-lg font-bold text-neutral-900 leading-snug mb-1.5 group-hover:text-primary transition-colors duration-300">{proc.title}</h3>
                <p class="text-neutral-600 text-xs sm:text-[0.84rem] leading-relaxed max-w-[15rem]">{proc.desc}</p>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <!-- PRICING TABLE SECTION -->
    <section class="py-20 bg-white border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/pricingbg.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-4">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.pricing.badge}
            </div>
            <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight mb-4">
              {page.pricing.headingPre} <span class="text-primary">{page.pricing.headingHighlight}</span>
            </h2>
            <p class="text-neutral-600 font-medium text-base max-w-md">
              {page.pricing.intro}
            </p>
          </div>
          <div class="lg:col-span-8">
            <div class="bg-white rounded-[1.75rem] border border-primary/10 overflow-hidden shadow-[0_30px_60px_-36px_rgba(160,60,20,0.45)]">
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[520px]">
                  <thead>
                    <tr class="border-b border-neutral-100">
                      <th class="pt-5 pb-3 px-4 sm:px-6 text-[11px] sm:text-xs font-bold text-neutral-400 uppercase tracking-[0.14em]">Service Type</th>
                      <th class="pt-5 pb-3 px-4 sm:px-6 text-[11px] sm:text-xs font-bold text-neutral-400 uppercase tracking-[0.14em] text-right">Estimated Investment</th>
                      <th class="pt-5 pb-3 px-4 sm:px-6 text-[11px] sm:text-xs font-bold text-neutral-400 uppercase tracking-[0.14em] text-right">Timeline</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-neutral-100">
                    {page.pricing.rows.map((priceItem) => (
                      <tr class="hover:bg-[#fff8f3] transition-colors">
                        <td class="py-3.5 sm:py-4 px-4 sm:px-6 font-bold text-neutral-900 text-xs sm:text-[0.95rem]">{priceItem.type}</td>
                        <td class="py-3.5 sm:py-4 px-4 sm:px-6 text-right font-bold text-primary text-xs sm:text-[0.95rem] whitespace-nowrap">{priceItem.price}</td>
                        <td class="py-3.5 sm:py-4 px-4 sm:px-6 text-right font-semibold text-neutral-600 text-xs sm:text-[0.95rem] whitespace-nowrap">{priceItem.timeline}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
            <p class="text-neutral-500 text-xs sm:text-sm mt-4 leading-relaxed font-medium">
              {page.pricing.footnote}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TARGET INDUSTRIES SECTION (DARK AMBER THEME) -->
    <section class="py-20 theme-keep-light bg-neutral-950 text-white border-t border-white/5 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/industriesbg.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          <div class="lg:col-span-4">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/20 border border-amber-500/30 text-amber-400 text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.industries.badge}
            </div>
            <h2 class="text-3xl md:text-4xl font-black text-white leading-tight">
              {(() => { const t = splitAccent(page.industries.headingHighlight, "Industries We Build"); return t ? (<>{t[0]}<span class="text-[#F9AE42]">{t[1]}</span>{t[2]}</>) : <span class="text-[#F9AE42]">{page.industries.headingHighlight}</span>; })()} {page.industries.headingPost}
            </h2>
            <p class="text-neutral-400 font-medium mt-3 text-base">
              {page.industries.intro}
            </p>
          </div>
          <div class="lg:col-span-8 grid sm:grid-cols-2 gap-3 sm:gap-4">
            {page.industries.items.map((ind, i) => {
              const IconComponent = industryIcons[i];
              // A card with an `href` renders as an anchor so the grid is a navigation path, not a dead end.
              const Card = ind.href ? 'a' : 'div';
              return (
                <Card href={ind.href} class="group bg-white/[0.04] border border-white/10 p-4 sm:p-5 rounded-2xl hover:border-amber-500/40 hover:bg-white/[0.07] transition-all duration-300 flex items-start gap-3.5">
                  <div class="w-10 h-10 rounded-xl bg-primary/20 text-[#ff9a5c] flex items-center justify-center flex-shrink-0">
                    <IconComponent class="w-5 h-5" />
                  </div>
                  <div class="min-w-0">
                    <h3 class:list={["text-[15px] font-bold text-white mb-1", ind.href && "group-hover:text-[#F9AE42] transition-colors duration-300"]}>{ind.name}</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed">{ind.desc}</p>
                    {ind.href && (
                      <span class="inline-flex items-center gap-1.5 mt-2.5 text-[11px] font-black text-amber-400 uppercase tracking-wider">
                        Explore
