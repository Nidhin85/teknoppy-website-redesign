---
// Sveltia CMS admin — served as an Astro route so /admin/ works in dev AND prod.
// Config lives at /public/admin/config.yml (served at /admin/config.yml).
// A Teknoppy-branded gate (all styles inline, so nothing can strip them) overlays
// Sveltia's default GitHub-worded login — editors only see a simple "Log in".
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager — Teknoppy</title>
  </head>
  <body>
    <!-- Sveltia CMS (Decap-compatible). Config: /admin/config.yml -->
    <script is:inline src="https://unpkg.com/@sveltia/cms@0.172.4/dist/sveltia-cms.js"></script>

    <script is:inline>
      (function () {
        var gate = null;

        // Svelte wraps interpolated words in invisible bidi-isolate chars (U+2066–2069),
        // so match on the button's data-label after stripping them.
        function clean(s) { return (s || '').replace(/[\u2066\u2067\u2068\u2069]/g, '').trim(); }
        function findLoginBtn() {
          var els = document.querySelectorAll('[data-label]');
          for (var i = 0; i < els.length; i++) {
            if (clean(els[i].getAttribute('data-label')) === 'Sign In with GitHub') {
              return els[i].closest('button, a, [role="button"]') || els[i];
            }
          }
          return null;
        }

        function ensureGate() {
          if (gate && document.body.contains(gate)) return gate;
          gate = document.createElement('div');
          gate.setAttribute('style',
            'position:fixed;inset:0;z-index:2147483647;display:none;' +
            'align-items:center;justify-content:center;background:#f4f4f5;' +
            'font-family:system-ui,-apple-system,Segoe UI,sans-serif');
          gate.innerHTML =
            '<form style="background:#fff;padding:36px 30px;border-radius:16px;' +
            'box-shadow:0 12px 40px rgba(0,0,0,.1);width:320px;text-align:center">' +
            '<img src="/logo.svg" alt="Teknoppy" style="height:46px;width:auto;margin-bottom:16px" />' +
            '<div style="font-weight:800;font-size:19px;color:#111">Teknoppy CMS</div>' +
            '<div style="color:#999;font-size:13px;margin:4px 0 22px">Sign in to manage your website content</div>' +
            '<button type="submit" style="width:100%;padding:13px;background:#f05a2c;color:#fff;border:0;' +
            'border-radius:10px;font-weight:700;font-size:15px;cursor:pointer">Log in</button>' +
            '</form>';
          document.body.appendChild(gate);
          gate.querySelector('form').addEventListener('submit', function (e) {
            e.preventDefault();
            var btn = findLoginBtn();
            if (btn) btn.click();
          });
          return gate;
        }

        var hideTimer = null;
        function sync() {
          if (findLoginBtn()) {
            // Login screen present → cover it. Cancel any pending hide (transient re-render).
            if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
            ensureGate().style.display = 'flex';
          } else if (gate && gate.style.display !== 'none' && !hideTimer) {
            // Button gone — could be a Svelte re-render blip or a real login. Debounce.
            hideTimer = setTimeout(function () {
              hideTimer = null;
              if (!findLoginBtn()) gate.style.display = 'none';
            }, 1200);
          }
        }

        try {
          new MutationObserver(sync).observe(document.documentElement, { childList: true, subtree: true });
        } catch (e) {}
        setInterval(sync, 300);
        sync();
      })();
    </script>
  </body>
</html>
