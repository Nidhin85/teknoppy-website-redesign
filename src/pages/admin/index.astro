---
// Sveltia CMS admin — served as an Astro route so /admin/ works in dev AND prod.
// Config lives at /public/admin/config.yml (served at /admin/config.yml).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager — Teknoppy</title>
  </head>
  <body>
    <!-- Sveltia CMS (Decap-compatible). Config: /admin/config.yml -->
    <script is:inline src="https://unpkg.com/@sveltia/cms@0.172.4/dist/sveltia-cms.js"></script>

    <!-- Rebrand the login screen as a simple password login (hide GitHub wording). -->
    <script is:inline>
      (function () {
        function customize() {
          var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null);
          var node;
          while ((node = walker.nextNode())) {
            var v = node.nodeValue;
            if (!v || !v.trim()) continue;
            var tv = v.trim();
            if (tv === 'Sign In with GitHub') node.nodeValue = v.replace('Sign In with GitHub', 'Log in');
            else if (tv === 'Sveltia CMS') node.nodeValue = v.replace('Sveltia CMS', 'Teknoppy CMS');
            else if (tv === 'Sign In Using Access Token') {
              var p = node.parentElement;
              var btn = p && (p.closest('button') || p.closest('a'));
              if (btn) btn.style.display = 'none';
            }
          }
        }
        try {
          new MutationObserver(customize).observe(document.documentElement, {
            childList: true, subtree: true, characterData: true,
          });
        } catch (e) {}
        var n = 0;
        var iv = setInterval(function () { customize(); if (++n > 80) clearInterval(iv); }, 200);
      })();
    </script>
  </body>
</html>
