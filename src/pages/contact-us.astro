---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Phone, Mail, MapPin, Clock, Zap, ArrowRight, MessageCircle } from 'lucide-react';
import site from '../data/site.json';
import page from '../data/pages/contact.json';

const icons: Record<string, any> = { phone: Phone, mail: Mail, map: MapPin, clock: Clock };

// Submissions POST here. Until it is set the form reports a failure and points
// at phone/email rather than showing a success message for a message that was
// never delivered.
const formEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '';

const sameAs = [site.social.linkedin, site.social.instagram, site.social.twitter].filter(
  (u) => u && u !== '#'
);

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": page.meta.title,
    "description": page.meta.description,
    "url": "https://teknoppy.com/contact-us/"
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": site.businessName,
    "url": "https://teknoppy.com/",
    "logo": "https://teknoppy.com/logo.svg",
    "email": site.email,
    "telephone": site.phone,
    "founder": { "@type": "Person", "name": site.founderName },
    ...(sameAs.length ? { sameAs } : {})
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": site.businessName,
    "telephone": site.phone,
    "email": site.email,
    "url": "https://teknoppy.com/contact-us/",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Kaithakal Building, Near Thykoodam Metro, Vyttila PO",
      "addressLocality": "Kochi",
      "addressRegion": "Kerala",
      "postalCode": "682019",
      "addressCountry": "IN"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "10:00",
        "closes": "18:00"
      }
    ],
    "areaServed": [
      { "@type": "State", "name": "Kerala" },
      { "@type": "City", "name": "Kochi" },
      { "@type": "Country", "name": "United Arab Emirates" },
      { "@type": "Country", "name": "Qatar" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": page.faq.items.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- HERO — H1 + the one-business-day promise, both above the fold -->
    <section class="relative pt-32 pb-20 md:pt-36 md:pb-24 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.png')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
          <Zap class="w-3.5 h-3.5" />
          {page.hero.badge}
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-black leading-[1.1] tracking-tight text-white mb-6">
          {page.hero.h1Lead}{' '}
          <span class="relative inline-block text-primary">
            {page.hero.h1Accent}
            <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
          </span>
        </h1>
        <p class="text-base sm:text-lg lg:text-xl text-neutral-300 max-w-3xl font-medium leading-relaxed">
          {page.hero.intro}
        </p>
      </div>
    </section>

    <!-- REACH US DIRECTLY — icon-led, scannable -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl font-black text-neutral-900 leading-tight mb-10">{page.reachUs.heading}</h2>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {page.reachUs.items.map((item) => {
            const IconComp = icons[item.icon];
            const inner = (
              <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col h-full">
                <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
                <div class="w-[52px] h-[52px] bg-primary/5 text-primary rounded-2xl flex items-center justify-center border border-primary/10 shadow-inner mb-5">
                  <IconComp class="w-5 h-5" />
                </div>
                <span class="text-[10px] font-black text-primary uppercase tracking-widest block mb-2">{item.label}</span>
                <p class="text-base font-bold text-neutral-850 leading-snug break-words">{item.value}</p>
              </div>
            );
            return item.href ? (
              <a href={item.href} class="block h-full rounded-3xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40">{inner}</a>
            ) : inner;
          })}
        </div>

        <a
          href={`https://wa.me/${site.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 mt-8 px-6 py-3.5 rounded-full bg-[#25D366]/10 border border-[#25D366]/25 text-[#25D366] text-sm font-bold hover:bg-[#25D366]/20 transition-colors"
        >
          <MessageCircle class="w-4 h-4" />
          {page.reachUs.whatsappLabel}
        </a>
      </div>
    </section>

    <!-- MAP — directly below the NAP block, lazy-loaded -->
    <section class="pb-16 sm:pb-20 bg-white">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="rounded-3xl overflow-hidden border border-neutral-200 shadow-sm">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(page.map.query)}&output=embed`}
            width="100%"
            height="360"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={page.map.title}
            class="w-full block"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- FORM — exactly 6 fields, single column -->
    <section id="contact-form" class="py-16 sm:py-20 bg-[#FFF8EF]/30 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-3xl sm:text-4xl font-black text-neutral-900 leading-tight mb-8 text-center">{page.form.heading}</h2>

          <form id="contact-form-el" data-endpoint={formEndpoint} data-success={page.form.successMessage} data-error={page.form.errorMessage} novalidate class="space-y-5 bg-white rounded-3xl border border-neutral-100 p-6 sm:p-10 shadow-[0_12px_40px_-20px_rgba(0,0,0,0.12)]">
            <div class="space-y-2">
              <label for="cf-name" class="block text-[11px] font-black text-neutral-700 uppercase tracking-widest">Name</label>
              <input id="cf-name" name="name" type="text" required autocomplete="name" class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:border-primary focus:bg-white focus:ring-2 focus:ring-primary/20 transition-all outline-none" placeholder="Your full name" />
            </div>

            <div class="space-y-2">
              <label for="cf-email" class="block text-[11px] font-black text-neutral-700 uppercase tracking-widest">Email</label>
              <input id="cf-email" name="email" type="email" required autocomplete="email" aria-describedby="cf-email-err" class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:border-primary focus:bg-white focus:ring-2 focus:ring-primary/20 transition-all outline-none" placeholder="name@company.com" />
              <p id="cf-email-err" class="hidden text-xs font-semibold text-red-600" role="alert">Enter a valid email address.</p>
            </div>

            <div class="space-y-2">
              <label for="cf-phone" class="block text-[11px] font-black text-neutral-700 uppercase tracking-widest">Phone</label>
              <input id="cf-phone" name="phone" type="tel" required autocomplete="tel" aria-describedby="cf-phone-err" class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:border-primary focus:bg-white focus:ring-2 focus:ring-primary/20 transition-all outline-none" placeholder="+91 00000 00000" />
              <p id="cf-phone-err" class="hidden text-xs font-semibold text-red-600" role="alert">Enter a valid phone number.</p>
            </div>

            <div class="space-y-2">
              <label for="cf-company" class="block text-[11px] font-black text-neutral-700 uppercase tracking-widest">
                Company <span class="text-neutral-400 font-bold normal-case tracking-normal">(optional)</span>
              </label>
              <input id="cf-company" name="company" type="text" autocomplete="organization" class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:border-primary focus:bg-white focus:ring-2 focus:ring-primary/20 transition-all outline-none" placeholder="Your company name" />
            </div>

            <div class="space-y-2">
              <label for="cf-service" class="block text-[11px] font-black text-neutral-700 uppercase tracking-widest">Service interested in</label>
              <select id="cf-service" name="service" required class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 focus:border-primary focus:bg-white focus:ring-2 focus:ring-primary/20 transition-all outline-none">
                <option value="" disabled selected>Select a service</option>
                {page.form.serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
              </select>
            </div>

            <div class="space-y-2">
              <label for="cf-message" class="block text-[11px] font-black text-neutral-700 uppercase tracking-widest">Message</label>
              <textarea id="cf-message" name="message" rows="5" required class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:border-primary focus:bg-white focus:ring-2 focus:ring-primary/20 transition-all outline-none resize-none" placeholder="What you need, your current site if you have one, and a rough timeline."></textarea>
            </div>

            <button type="submit" class="w-full inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-xl shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed">
              {page.form.submitLabel}
              <ArrowRight class="w-4 h-4" />
            </button>

            <!-- Inline confirmation, announced to screen readers -->
            <p id="cf-status" role="status" aria-live="polite" class="hidden text-sm font-semibold rounded-xl px-4 py-3"></p>
          </form>
        </div>
      </div>
    </section>

    <!-- WHERE WE WORK -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl font-black text-neutral-900 leading-tight mb-6">{page.whereWeWork.heading}</h2>
        <p class="max-w-4xl text-neutral-600 text-sm sm:text-base leading-relaxed font-medium" set:html={page.whereWeWork.html} />
      </div>
    </section>

    <!-- WHAT HAPPENS AFTER YOU SUBMIT -->
    <section class="py-16 sm:py-20 bg-neutral-50/50 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl font-black text-neutral-900 leading-tight mb-6">{page.afterSubmit.heading}</h2>
        <div class="max-w-4xl space-y-5">
          {page.afterSubmit.paragraphs.map((p: any) => (
            p.html
              ? <p class="text-neutral-600 text-sm sm:text-base leading-relaxed font-medium" set:html={p.html} />
              : <p class="text-neutral-600 text-sm sm:text-base leading-relaxed font-medium">{p.text}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ — accordion, collapsed by default on every breakpoint -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl font-black text-neutral-900 leading-tight mb-10 text-center">{page.faq.heading}</h2>

        <div class="max-w-4xl mx-auto space-y-4">
          {page.faq.items.map((faq) => (
            <details class="group bg-white rounded-2xl border border-neutral-200/60 p-6 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
                <h3 class="text-sm sm:text-base font-bold text-neutral-850 pr-4">{faq.q}</h3>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-primary flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-neutral-100/60 text-xs sm:text-sm text-neutral-600 leading-relaxed font-semibold">
                {faq.a}
              </div>
            </details>
          ))}
        </div>

        <p class="max-w-4xl mx-auto mt-8 text-center text-sm text-neutral-600 font-medium" set:html={page.faq.footnoteHtml} />
      </div>
    </section>

    <!-- CLOSING CTA -->
    <section class="py-16 sm:py-20 bg-[#FFF8EF]/30 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          {page.closingCtas.map((cta, i) => (
            <a
              href={cta.href}
              class={i === 0
                ? "w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300"
                : "w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-primary border border-primary/30 bg-white rounded-full hover:bg-primary/5 transition-all duration-300"}
            >
              {cta.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</Layout>

<script>
  const form = document.getElementById('contact-form-el') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');

  if (form && status) {
    const emailEl = document.getElementById('cf-email') as HTMLInputElement;
    const phoneEl = document.getElementById('cf-phone') as HTMLInputElement;
    const emailErr = document.getElementById('cf-email-err')!;
    const phoneErr = document.getElementById('cf-phone-err')!;

    const validEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim());
    const validPhone = (v: string) => /^[+()\d][\d\s\-()]{7,}$/.test(v.trim());

    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.className = ok
        ? 'text-sm font-semibold rounded-xl px-4 py-3 bg-emerald-50 text-emerald-800 border border-emerald-200'
        : 'text-sm font-semibold rounded-xl px-4 py-3 bg-red-50 text-red-700 border border-red-200';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Client-side validation before anything is sent.
      let ok = form.checkValidity();
      emailErr.classList.toggle('hidden', validEmail(emailEl.value));
      phoneErr.classList.toggle('hidden', validPhone(phoneEl.value));
      if (!validEmail(emailEl.value) || !validPhone(phoneEl.value)) ok = false;
      if (!ok) {
        form.reportValidity();
        return;
      }

      const endpoint = form.dataset.endpoint;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

      // No endpoint configured yet — say so plainly rather than showing a
      // success message for a message that was never delivered.
      if (!endpoint) {
        show(
          'This form is not connected to our inbox yet. Please call +91 6282249224 or email sanal@teknoppy.com and we will pick it up straight away.',
          false
        );
        return;
      }

      btn.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form)))
        });
        if (!res.ok) throw new Error(String(res.status));
        show(form.dataset.success || 'Thanks — your message is with us. A Teknoppy strategist will reply within one business day.', true);
        form.reset();
      } catch {
        show(form.dataset.error || 'Something went wrong sending your message. Please call +91 6282249224 or email sanal@teknoppy.com and we will pick it up straight away.', false);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
