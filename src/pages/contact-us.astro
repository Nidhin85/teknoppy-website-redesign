---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Phone, Mail, MapPin, Clock, Zap, ArrowRight, MessageCircle, Send } from 'lucide-react';
import site from '../data/site.json';
import page from '../data/pages/contact.json';
import { contactUsSchema } from '../data/schemas/contactUsSchema';

const icons: Record<string, any> = { phone: Phone, mail: Mail, map: MapPin, clock: Clock };

// Submissions POST here. Defaults to the /api/contact handler that ships with
// the site; PUBLIC_CONTACT_ENDPOINT only needs setting to point the form
// somewhere else.
const formEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact';

const fieldClass =
  "w-full bg-white border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none";
const labelClass = "block text-[13px] font-black text-neutral-700 uppercase tracking-widest mb-2";
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(contactUsSchema)} />
  </Fragment>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/40">
    <!-- COMPACT HERO — H1 and the one-business-day promise stay above the fold,
         but the hero no longer fills the screen; the form starts right beneath it. -->
    <section class="relative pt-32 pb-20 md:pt-36 md:pb-24 overflow-hidden theme-keep-light bg-neutral-950 text-white">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.webp')]"></div>
      </div>
      <div class="absolute -bottom-24 -right-24 w-[420px] h-[420px] rounded-full bg-primary/15 blur-[120px] pointer-events-none"></div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
            <Zap class="w-3.5 h-3.5" />
            {page.hero.badge}
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[52px] font-black leading-[1.1] tracking-tight text-white mb-5">
            {page.hero.h1Lead}{' '}
            <span class="relative inline-block text-primary">
              {page.hero.h1Accent}
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
          </h1>
          <p class="text-base sm:text-lg text-neutral-300 font-medium leading-relaxed">
            {page.hero.intro}
          </p>
        </div>
      </div>
    </section>

    <!-- SPLIT WORKSPACE — form and contact details side by side, so a visitor can
         write to us or reach us directly without scrolling to choose. -->
    <!-- The header's "Book a Free Consultation" button targets #contact, which on every
         other page is the FooterCTA section. This page has no FooterCTA, so the anchor
         points at the form instead. -->
    <span id="contact" class="block scroll-mt-28" aria-hidden="true"></span>
    <section id="contact-form" class="relative -mt-10 pb-16 sm:pb-20 z-20">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">

          <!-- FORM CARD — exactly six fields -->
          <div class="lg:col-span-7 bg-white rounded-[2rem] border border-neutral-100 p-6 sm:p-10 shadow-[0_24px_60px_-30px_rgba(0,0,0,0.25)]">
            <div class="flex items-center gap-3 mb-8">
              <span class="w-11 h-11 rounded-2xl bg-primary/10 text-primary flex items-center justify-center border border-primary/15 flex-shrink-0">
                <Send class="w-5 h-5" />
              </span>
              <h2 class="text-2xl sm:text-3xl font-black text-neutral-900 leading-tight">{page.form.heading}</h2>
            </div>

            <form id="contact-form-el" data-endpoint={formEndpoint} data-success={page.form.successMessage} data-error={page.form.errorMessage} data-source="Contact page" novalidate class="space-y-5">
              <!-- Honeypot: real people never see or fill this. Bots do. -->
              <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
                <label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
              </div>

              <div>
                <label for="cf-name" class={labelClass}>Name</label>
                <input id="cf-name" name="name" type="text" required autocomplete="name" class={fieldClass} placeholder="Your full name" />
              </div>

              <div>
                <label for="cf-email" class={labelClass}>Email</label>
                <input id="cf-email" name="email" type="email" required autocomplete="email" aria-describedby="cf-email-err" class={fieldClass} placeholder="name@company.com" />
                <p id="cf-email-err" class="hidden text-xs font-semibold text-red-600 mt-1.5" role="alert">Enter a valid email address.</p>
              </div>

              <div>
                <label for="cf-phone" class={labelClass}>Phone</label>
                <input id="cf-phone" name="phone" type="tel" required autocomplete="tel" aria-describedby="cf-phone-err" class={fieldClass} placeholder="+91 00000 00000" />
                <p id="cf-phone-err" class="hidden text-xs font-semibold text-red-600 mt-1.5" role="alert">Enter a valid phone number.</p>
              </div>

              <div>
                <label for="cf-company" class={labelClass}>
                  Company <span class="text-neutral-400 font-bold normal-case tracking-normal">(optional)</span>
                </label>
                <input id="cf-company" name="company" type="text" autocomplete="organization" class={fieldClass} placeholder="Your company name" />
              </div>

              <div>
                <label for="cf-service" class={labelClass}>Service interested in</label>
                <select id="cf-service" name="service" required class={fieldClass}>
                  <option value="" disabled selected>Select a service</option>
                  {page.form.serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
                </select>
              </div>

              <div>
                <label for="cf-message" class={labelClass}>Message</label>
                <textarea id="cf-message" name="message" rows="5" required class={`${fieldClass} resize-none`} placeholder="What you need, your current site if you have one, and a rough timeline."></textarea>
              </div>

              <button type="submit" class="w-full inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-xl shadow-[0_10px_30px_-8px_rgba(240,90,44,0.5)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed">
                {page.form.submitLabel}
                <ArrowRight class="w-4 h-4" />
              </button>

              <p id="cf-status" role="status" aria-live="polite" class="hidden text-sm font-semibold rounded-xl px-4 py-3"></p>
            </form>
          </div>

          <!-- CONTACT RAIL — dark card echoing the hero, sticky alongside the form -->
          <aside class="lg:col-span-5 lg:sticky lg:top-28 space-y-6">
            <div class="theme-keep-light bg-neutral-950 text-white rounded-[2rem] p-6 sm:p-8 shadow-[0_24px_60px_-30px_rgba(0,0,0,0.4)] relative overflow-hidden">
              <div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-primary/20 blur-[80px] pointer-events-none"></div>

              <h2 class="text-xl font-black text-white mb-6 relative z-10">{page.reachUs.heading}</h2>

              <address class="not-italic relative z-10">
                {page.reachUs.items.map((item) => {
                  const IconComp = icons[item.icon];
                  const row = (
                    <div class="flex items-start gap-4 py-4 border-t border-white/10 first:border-t-0 first:pt-0">
                      <span class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0 text-primary">
                        <IconComp class="w-4 h-4" />
                      </span>
                      <span class="pt-0.5">
                        <span class="block text-[12px] font-black text-neutral-500 uppercase tracking-widest mb-1">{item.label}</span>
                        <span class="block text-sm font-bold text-white leading-snug">{item.value}</span>
                      </span>
                    </div>
                  );
                  return item.href
                    ? <a href={item.href} class="block hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 rounded-xl">{row}</a>
                    : row;
                })}
              </address>

              <a
                href={`https://wa.me/${site.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="relative z-10 mt-6 w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-[#25D366] text-white text-sm font-bold hover:bg-[#20bd5a] transition-colors"
              >
                <MessageCircle class="w-4 h-4" />
                {page.reachUs.whatsappLabel}
              </a>
            </div>

            <!-- Map sits directly under the NAP block, as the doc specifies -->
            <div class="rounded-[2rem] overflow-hidden border border-neutral-200 shadow-sm bg-white">
              <iframe
                src={`https://www.google.com/maps?q=${encodeURIComponent(page.map.query)}&output=embed`}
                width="100%"
                height="300"
                style="border:0;"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={page.map.title}
                class="w-full block"
              ></iframe>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- WHERE WE WORK + WHAT HAPPENS NEXT — paired cards rather than two full bands -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-6 lg:gap-8">
          <div class="relative overflow-hidden bg-cream/60 rounded-[2rem] border border-neutral-100 p-7 sm:p-9">
            <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
            <h2 class="text-2xl sm:text-3xl font-black text-neutral-900 leading-tight mb-4">{page.whereWeWork.heading}</h2>
            <p class="text-neutral-600 text-sm sm:text-base leading-relaxed font-medium" set:html={page.whereWeWork.html} />
          </div>

          <div class="relative overflow-hidden bg-cream/60 rounded-[2rem] border border-neutral-100 p-7 sm:p-9">
            <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
            <h2 class="text-2xl sm:text-3xl font-black text-neutral-900 leading-tight mb-4">{page.afterSubmit.heading}</h2>
            <div class="space-y-4">
              {page.afterSubmit.paragraphs.map((p: any) => (
                p.html
                  ? <p class="text-neutral-600 text-sm sm:text-base leading-relaxed font-medium" set:html={p.html} />
                  : <p class="text-neutral-600 text-sm sm:text-base leading-relaxed font-medium">{p.text}</p>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ — two columns on desktop so six questions read without a long scroll -->
    <section class="py-16 sm:py-20 bg-cream/40 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight mb-10 text-center">{page.faq.heading}</h2>

        <div class="grid md:grid-cols-2 gap-4 max-w-5xl mx-auto items-start">
          {page.faq.items.map((faq) => (
            <details class="group bg-white rounded-2xl border border-neutral-200/60 p-6 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer focus:outline-none gap-4">
                <h3 class="text-sm sm:text-base font-bold text-neutral-850">{faq.q}</h3>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-primary flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-neutral-100/60 text-xs sm:text-sm text-neutral-600 leading-relaxed font-semibold">
                {faq.a}
              </div>
            </details>
          ))}
        </div>

        <p class="max-w-5xl mx-auto mt-8 text-center text-sm text-neutral-600 font-medium" set:html={page.faq.footnoteHtml} />
      </div>
    </section>

    <!-- CLOSING CTA — full-bleed brand band -->
    <section class="theme-keep-light py-14 sm:py-16 bg-primary relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(255,255,255,0.15),transparent_45%)] pointer-events-none"></div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          {page.closingCtas.map((cta, i) => (
            <a
              href={cta.href}
              class={i === 0
                ? "w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-primary bg-white rounded-full shadow-[0_10px_30px_-10px_rgba(0,0,0,0.3)] hover:-translate-y-0.5 transition-all duration-300"
                : "w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white border border-white/40 rounded-full hover:bg-white/10 transition-all duration-300"}
            >
              {cta.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form-el') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');

  if (form && status) {
    const emailEl = document.getElementById('cf-email') as HTMLInputElement;
    const phoneEl = document.getElementById('cf-phone') as HTMLInputElement;
    const emailErr = document.getElementById('cf-email-err')!;
    const phoneErr = document.getElementById('cf-phone-err')!;

    const validEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim());
    const validPhone = (v: string) => /^[+()\d][\d\s\-()]{7,}$/.test(v.trim());

    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.className = ok
        ? 'text-sm font-semibold rounded-xl px-4 py-3 bg-emerald-50 text-emerald-800 border border-emerald-200'
        : 'text-sm font-semibold rounded-xl px-4 py-3 bg-red-50 text-red-700 border border-red-200';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Silently drop bot submissions that filled the honeypot.
      if ((form.elements.namedItem('company_website') as HTMLInputElement)?.value) return;

      // Client-side validation before anything is sent.
      let ok = form.checkValidity();
      emailErr.classList.toggle('hidden', validEmail(emailEl.value));
      phoneErr.classList.toggle('hidden', validPhone(phoneEl.value));
      if (!validEmail(emailEl.value) || !validPhone(phoneEl.value)) ok = false;
      if (!ok) {
        form.reportValidity();
        return;
      }

      const endpoint = form.dataset.endpoint;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

      // No endpoint configured yet — say so plainly rather than showing a
      // success message for a message that was never delivered.
      if (!endpoint) {
        show(
          'This form is not connected to our inbox yet. Please call +91 6282249224 or email sales@teknoppy.com and we will pick it up straight away.',
          false
        );
        return;
      }

      btn.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...Object.fromEntries(new FormData(form)),
            source: form.dataset.source || 'Website'
          })
        });
        if (!res.ok) throw new Error(String(res.status));
        show(form.dataset.success || '', true);
        form.reset();
      } catch {
        show(form.dataset.error || '', false);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
