---
import CaseStudyTemplate from '../../components/case-study/CaseStudyTemplate.astro';
import AbrusInteractiveIA from '../../components/case-study/AbrusInteractiveIA';
import AbrusLightbox, { type GalleryItem } from '../../components/case-study/AbrusLightbox';
import CaseStudyFAQ from '../../components/case-study/CaseStudyFAQ';
import { faqsData } from '../../components/case-study/AbrusFAQ';
import { 
  Shield, 
  Clock, 
  MapPin, 
  Search, 
  CheckCircle2, 
  Layers, 
  FileText, 
  Building2, 
  Sparkles,
  Coins
} from 'lucide-react';

const pageTitle = "Abrus Krishna Finance: WordPress Website Design for a KML-Registered Gold Loan Company in Guruvayoor | Teknoppy Case Study";
const pageDescription = "How Teknoppy built abruskrishna.com on WordPress for a KML-registered Kerala gold loan and micro-finance company in Guruvayoor: 9 dedicated loan pages, regulatory trust integration, local search strategy, and deliberate product separation.";
const canonicalURL = "https://teknoppy.com/case-studies/abrus-krishna-finance/";

// Sub-navigation anchors
const abrusNavItems = [
  { id: 'overview', label: 'Overview' },
  { id: 'challenges', label: 'Challenges' },
  { id: 'objectives', label: 'Objectives' },
  { id: 'strategy', label: 'Strategy' },
  { id: 'architecture', label: 'Architecture' },
  { id: 'comparison', label: 'Product Focus' },
  { id: 'journey', label: 'Borrower Journey' },
  { id: 'compliance', label: 'Compliance' },
  { id: 'gallery', label: 'Showcase' },
  { id: 'faq', label: 'FAQ' },
];

// Gallery data for Lightbox (100% full screenshot visibility)
const galleryItems: GalleryItem[] = [
  {
    id: 'hero-ui',
    src: '/case-studies/abruskrishna.webp',
    title: 'abruskrishna.com Live Homepage & Trust Architecture',
    category: 'Full Website Experience',
    caption: 'The live WordPress homepage built on Elementor, presenting upfront borrower verification, gold loan offerings, and institutional credibility.'
  },
  {
    id: 'branding-identity',
    src: '/client logos/abrus-krishna-finance.jpg',
    title: 'Abrus Krishna Finance Brand Identity',
    category: 'Brand Trust Signal',
    caption: 'Official institutional logo and color identity for the Guruvayoor-based KML-registered lending institution.'
  },
  {
    id: 'local-presence',
    src: '/case-studies/abruskrishna.webp',
    title: 'Borrower Trust & Local Branch Presentation',
    category: 'UI & Compliance',
    caption: 'Branch location information, KML compliance statements, and 15–30 minute rapid approval steps displayed prominently for prospective borrowers.'
  }
];

// Schema About entity
const schemaAbout = {
  type: "FinancialService",
  name: "Abrus Krishna Finance",
  address: {
    locality: "Guruvayoor",
    region: "Kerala",
    country: "India"
  }
};
---

<CaseStudyTemplate
  metaTitle={pageTitle}
  metaDescription={pageDescription}
  canonicalURL={canonicalURL}
  heroImage="/case-studies/abruskrishna.webp"
  heroImageAlt="Abrus Krishna Finance WordPress Website Design Showcase by Teknoppy"
  schemaType="TechArticle"
  schemaAbout={schemaAbout}
  clientName="Abrus Krishna Finance"
  categoryTag="Fintech & Microfinance / WordPress Engineering"
  tagBadge="Teknoppy Flagship Case Study"
  title="WordPress Website Design for a KML-Registered Gold Loan Company in Guruvayoor"
  storyLead="How Teknoppy architected abruskrishna.com around search intent, regulatory trust under the Kerala Money-Lenders Act, 1958, and deliberate separation between nine distinct loan products."
  industry="Gold Loans & Micro-Finance (KML-Registered Lending)"
  location="Guruvayoor, Thrissur District, Kerala"
  services="Website Design, WordPress Development, Information Architecture, SEO"
  platform="WordPress (Elementor Pro)"
  liveWebsite="abruskrishna.com"
  liveWebsiteUrl="https://abruskrishna.com"
  heroHighlights={[
    "9 Dedicated Search-Intent Pages",
    "15–30 Min In-Branch Approval",
    "KML Regulatory Compliance Core"
  ]}
  navItems={abrusNavItems}
  faqs={faqsData}
  ctaHeadline="Need a website for your gold loan, micro-finance, or lending business that separates your products clearly and builds regulatory trust into every page?"
>

  {/* =========================================================================
      01. PROJECT OVERVIEW & INSTITUTIONAL CONTEXT
      ========================================================================= */}
  <section id="overview" class="reveal-on-scroll scroll-mt-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      {/* Left Column: Section Marker & Editorial Callout */}
      <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-28">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-200/70 text-[#0066CC] text-xs font-bold uppercase tracking-wider">
          <Building2 className="w-3.5 h-3.5 text-[#0066CC]" />
          Institutional Context
        </div>

        <h2 class="text-2xl sm:text-4xl lg:text-5xl text-neutral-900 font-extrabold tracking-tight leading-tight">
          A website that carries the trust built by the physical branch since 2018.
        </h2>

        <div class="p-6 rounded-2xl bg-[#F8FAFC] border border-neutral-200/80 shadow-xs space-y-3">
          <span class="text-xs font-bold uppercase tracking-widest text-[#0066CC]">Key Characteristic</span>
          <p class="text-sm text-neutral-600 leading-relaxed font-normal">
            As a secured, collateral-backed lender operating under a state licensing framework, Abrus Krishna Finance carries obligations most local businesses don't: interest rates, foreclosure terms, KYC verification, and customer data handling all sit under statutory KML regulation.
          </p>
        </div>
      </div>

      {/* Right Column: Narrative Body & At a Glance */}
      <div class="lg:col-span-7 space-y-8 text-neutral-600 text-base sm:text-lg leading-relaxed">
        <div class="space-y-5">
          <h3 class="text-2xl sm:text-3xl font-bold text-neutral-900 tracking-tight">
            About Abrus Krishna Finance
          </h3>
          
          <p>
            Abrus Krishna Finance is a <strong class="text-neutral-900 font-semibold">Kerala Money-Lenders Act, 1958 (KML) registered lending institution</strong> headquartered near Thaikad, Guruvayoor. Operating in the financial sector since 2018, the company provides gold loans, doorstep gold loans, and a range of micro business, personal, home, and consumer goods loans to individuals, families, and small business owners across the region, working through KML-compliant agreements and authorised partner shops.
          </p>

          <p>
            Every borrower has reason to check a lender's legitimacy before pledging gold jewelry or signing an agreement. That combination — <strong class="text-neutral-900 font-semibold">nine distinct loan pages, a regulated operating environment, and a customer base that includes many first-time borrowers</strong> — made this brief unusually specific.
          </p>

          <p>
            It wasn't a generic &ldquo;get us online&rdquo; project; it was a request for a website that could carry the exact same trust the physical branch had built since 2018.
          </p>
        </div>

        {/* Key Facts / At a Glance */}
        <div class="pt-4">
          <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-neutral-500 mb-4">
            Project Snapshot • At a Glance
          </h4>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            {[
              { title: "9 Dedicated Loan Pages", desc: "Each built around its own distinct search intent without generic bundling." },
              { title: "KML Compliance as a First-Class Page", desc: "Positioned prominently as core trust content rather than a hidden footer disclaimer." },
              { title: "Gold Loan vs Doorstep Gold Loan Separation", desc: "Kept deliberately distinct to prevent internal search keyword competition." },
              { title: "15–30 Minute Approval Process", desc: "Realistic, rapid approval timing laid out upfront on the homepage." },
              { title: "Dual Spelling Local Strategy", desc: "Covering both 'Guruvayoor' and 'Guruvayur' natural search queries." }
            ].map((item, i) => (
              <div key={i} class={`p-4 sm:p-5 rounded-2xl border border-neutral-200/80 bg-white shadow-xs hover:border-[#0066CC]/40 transition-colors ${i === 4 ? 'sm:col-span-2' : ''}`}>
                <div class="flex items-start gap-3.5">
                  <CheckCircle2 className="w-5 h-5 text-[#0066CC] shrink-0 mt-0.5" />
                  <div>
                    <h5 class="text-sm sm:text-base font-bold text-neutral-900 mb-1">{item.title}</h5>
                    <p class="text-xs sm:text-sm text-neutral-600 leading-normal">{item.desc}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  {/* =========================================================================
      02. THE CHALLENGE (5-CARD DIAGNOSTIC GRID)
      ========================================================================= */}
  <section id="challenges" class="reveal-on-scroll scroll-mt-28 relative rounded-3xl p-8 sm:p-10 md:p-12 bg-[#F8FAFC] border border-neutral-200/80 shadow-xs space-y-10">
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-[#0066CC] border border-blue-200/70 text-xs font-bold uppercase tracking-wider">
        Diagnostic Assessment
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
        The Challenges Before Redesign
      </h2>
      <p class="text-neutral-600 text-base sm:text-lg leading-relaxed">
        Before the redesign, Abrus Krishna Finance's online presence did not reflect the breadth or the trustworthiness of the business. Five core structural obstacles stood in the way of borrower trust and search visibility.
      </p>
    </div>

    {/* 5 Challenges Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
      
      {/* Card 1 */}
      <div class="p-6 sm:p-7 rounded-2xl bg-white border border-neutral-200/80 hover:border-[#0066CC]/40 hover:shadow-md transition-all flex flex-col justify-between group shadow-xs">
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
            <span class="font-mono text-xs text-[#0066CC] font-bold">CHALLENGE 01</span>
            <Layers className="w-5 h-5 text-[#0066CC]" />
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-neutral-900 tracking-tight leading-snug group-hover:text-[#0066CC] transition-colors">
            Nine loan products, no clear separation
          </h3>
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
            Gold Loan, Gold Loan in Guruvayoor, Doorstep Gold Loan, Business Loan in Guruvayoor, Business & Micro Enterprise Loan, Micro Personal Loan, Micro Home Loan, Micro Finance, and Consumer Goods Loan needed to exist as their own pages instead of being bundled into one generic loans/services page. A borrower searching for one specific product had no direct path to the information relevant to them.
          </p>
        </div>
        <div class="mt-5 pt-3.5 border-t border-neutral-100 text-[11px] font-mono text-neutral-500">
          Impact: High bounce rate & lost specific search intent
        </div>
      </div>

      {/* Card 2 */}
      <div class="p-6 sm:p-7 rounded-2xl bg-white border border-neutral-200/80 hover:border-[#0066CC]/40 hover:shadow-md transition-all flex flex-col justify-between group shadow-xs">
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
            <span class="font-mono text-xs text-[#0066CC] font-bold">CHALLENGE 02</span>
            <Shield className="w-5 h-5 text-sky-600" />
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-neutral-900 tracking-tight leading-snug group-hover:text-[#0066CC] transition-colors">
            Compliance and trust signals were missing
          </h3>
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
            There was no dedicated KML Registration & Compliance page, and no FAQ content addressing the questions a first-time borrower actually has: whether a branch visit is mandatory, how foreclosure works, how repayments are collected, and how personal and financial data is protected. For a regulated lender, this content is the foundation of borrower trust.
          </p>
        </div>
        <div class="mt-5 pt-3.5 border-t border-neutral-100 text-[11px] font-mono text-neutral-500">
          Impact: Hesitation among first-time borrowers
        </div>
      </div>

      {/* Card 3 */}
      <div class="p-6 sm:p-7 rounded-2xl bg-white border border-neutral-200/80 hover:border-[#0066CC]/40 hover:shadow-md transition-all flex flex-col justify-between group shadow-xs">
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
            <span class="font-mono text-xs text-[#0066CC] font-bold">CHALLENGE 03</span>
            <Coins className="w-5 h-5 text-amber-600" />
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-neutral-900 tracking-tight leading-snug group-hover:text-[#0066CC] transition-colors">
            Gold Loan and Doorstep Gold Loan needed clear separation
          </h3>
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
            These two products are closely related and searched for in similar ways. Without a deliberate content structure, the two pages would end up targeting the same terms and competing with each other instead of each ranking for its own distinct intent — one branch-based, one home-collection.
          </p>
        </div>
        <div class="mt-5 pt-3.5 border-t border-neutral-100 text-[11px] font-mono text-neutral-500">
          Impact: Internal search competition & keyword overlap
        </div>
      </div>

      {/* Card 4 */}
      <div class="p-6 sm:p-7 rounded-2xl bg-white border border-neutral-200/80 hover:border-[#0066CC]/40 hover:shadow-md transition-all flex flex-col justify-between group shadow-xs">
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
            <span class="font-mono text-xs text-[#0066CC] font-bold">CHALLENGE 04</span>
            <Clock className="w-5 h-5 text-emerald-600" />
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-neutral-900 tracking-tight leading-snug group-hover:text-[#0066CC] transition-colors">
            No visible borrower journey
          </h3>
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
            The steps between a customer's first enquiry and receiving their loan — contact/visit, document verification, approval, disbursement — weren't laid out anywhere. First-time borrowers had no way to know what to expect, including how fast the process actually moves.
          </p>
        </div>
        <div class="mt-5 pt-3.5 border-t border-neutral-100 text-[11px] font-mono text-neutral-500">
          Impact: Customer drop-off before initial contact
        </div>
      </div>

      {/* Card 5 */}
      <div class="p-6 sm:p-7 rounded-2xl bg-white border border-neutral-200/80 hover:border-[#0066CC]/40 hover:shadow-md transition-all flex flex-col justify-between group shadow-xs md:col-span-2 lg:col-span-2">
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
            <span class="font-mono text-xs text-[#0066CC] font-bold">CHALLENGE 05</span>
            <MapPin className="w-5 h-5 text-[#0066CC]" />
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-neutral-900 tracking-tight leading-snug group-hover:text-[#0066CC] transition-colors">
            Local search intent was underused
          </h3>
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
            Guruvayoor-specific searches — <em class="text-neutral-900 font-semibold">"gold loan Guruvayoor,"</em> <em class="text-neutral-900 font-semibold">"business loan Guruvayoor"</em> — weren't reflected in the site's structure or page titles, leaving local intent unaddressed even though the branch is a local, walk-in business built on neighbourhood trust.
          </p>
        </div>
        <div class="mt-5 pt-3.5 border-t border-neutral-100 text-[11px] font-mono text-neutral-500">
          Impact: Loss of walk-in search traffic to local competitors
        </div>
      </div>

    </div>
  </section>

  {/* =========================================================================
      03. PROJECT OBJECTIVES & TRANSFORMATION STORY
      ========================================================================= */}
  <section id="objectives" class="reveal-on-scroll scroll-mt-28 space-y-12">
    {/* Section Heading */}
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-[#0066CC] border border-blue-200/70 text-xs font-bold uppercase tracking-wider">
        Project Objectives
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
        Five Core Objectives
      </h2>
      <p class="text-neutral-600 text-base sm:text-lg leading-relaxed">
        Teknoppy's brief was to design and build a WordPress website that could accomplish five definitive goals:
      </p>
    </div>

    {/* 5 Core Objectives */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {[
        "Present all nine loan pages as distinct, individually optimized pages built around their own search intent",
        "Make KML registration and compliance a visible, first-class part of the site rather than a footnote",
        "Structure the Gold Loan and Doorstep Gold Loan pages around different search intent, so each could rank on its own terms",
        "Lay out the borrower journey — including realistic approval timing — clearly enough that a first-time customer would know exactly what to expect",
        "Reflect Guruvayoor-specific search intent in the pages where it mattered most, without turning every page into a location page"
      ].map((item, i) => (
        <div key={i} class={`p-5 rounded-2xl bg-white border border-neutral-200/80 shadow-xs hover:border-[#0066CC]/40 transition-colors flex items-start gap-3.5 ${i === 4 ? 'md:col-span-2 lg:col-span-2' : ''}`}>
          <div class="w-7 h-7 rounded-lg bg-blue-50 border border-blue-200/70 flex items-center justify-center text-[#0066CC] font-mono text-xs font-bold shrink-0 mt-0.5">
            0{i + 1}
          </div>
          <p class="text-xs sm:text-sm text-neutral-800 leading-relaxed font-medium">
            {item}
          </p>
        </div>
      ))}
    </div>

    {/* Before vs Strategy vs Delivered Comparison */}
    <div class="rounded-3xl border border-neutral-200/80 bg-white overflow-hidden shadow-xs mt-8">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-neutral-200/80">
        
        {/* BEFORE */}
        <div class="p-8 sm:p-10 space-y-5 bg-rose-50/40">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
            <span class="text-xs font-bold uppercase tracking-widest text-rose-700">Before Redesign</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-neutral-900">
            Generic & Bundled Architecture
          </h3>
          <ul class="space-y-3.5 text-xs sm:text-sm text-neutral-600">
            <li class="flex items-start gap-2.5">
              <span class="text-rose-500 font-bold">✕</span>
              <span>9 loan types squeezed into single generic services listing</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-rose-500 font-bold">✕</span>
              <span>Compliance buried as an unhelpful footnote disclaimer</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-rose-500 font-bold">✕</span>
              <span>Gold loan and doorstep gold loan competing for identical keywords</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-rose-500 font-bold">✕</span>
              <span>Borrower timeline missing, creating hesitation around approval speed</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-rose-500 font-bold">✕</span>
              <span>Zero targeting for Guruvayur locality and variant spelling</span>
            </li>
          </ul>
        </div>

        {/* STRATEGY */}
        <div class="p-8 sm:p-10 space-y-5 bg-blue-50/40">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#0066CC]"></span>
            <span class="text-xs font-bold uppercase tracking-widest text-[#0066CC]">Teknoppy Strategy</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-neutral-900">
            Intent-Centric Architecture
          </h3>
          <ul class="space-y-3.5 text-xs sm:text-sm text-neutral-700">
            <li class="flex items-start gap-2.5">
              <span class="text-[#0066CC] font-bold">→</span>
              <span>Structure URLs around user query intent, not internal hierarchy</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#0066CC] font-bold">→</span>
              <span>Elevate KML regulation into core trust architecture and FAQ schema</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#0066CC] font-bold">→</span>
              <span>Delineate branch transaction vs home collection value propositions</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#0066CC] font-bold">→</span>
              <span>Publish 15–30 minute verified approval timeline on the homepage</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#0066CC] font-bold">→</span>
              <span>Capture high-intent Guruvayoor & Guruvayur variations organically</span>
            </li>
          </ul>
        </div>

        {/* AFTER / DELIVERED */}
        <div class="p-8 sm:p-10 space-y-5 bg-emerald-50/40">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-700">Delivered Structure</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-neutral-900">
            Authority & Conversion Ready
          </h3>
          <ul class="space-y-3.5 text-xs sm:text-sm text-neutral-700">
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
              <span>9 distinct, individually optimized pages with customized KYC & terms</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
              <span>First-class KML Registration & Compliance page with transparent terms</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
              <span>Cannibalization eliminated through differentiated content & headings</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
              <span>Visible 4-step borrower journey reducing drop-off before contact</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
              <span>Rank-ready for local low-volume, high-conversion commercial terms</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  {/* =========================================================================
      04. INFORMATION ARCHITECTURE & INTERACTIVE 9 LOAN PAGES MATRIX
      ========================================================================= */}
  <section id="strategy" class="reveal-on-scroll scroll-mt-28 space-y-12">
    <div id="architecture" class="scroll-mt-28 space-y-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-[#0066CC] border border-blue-200/70 text-xs font-bold uppercase tracking-wider">
            Information Architecture
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
            Built Around Search Intent, Not Internal Org Structure
          </h2>
          <p class="text-neutral-600 text-base sm:text-lg leading-relaxed">
            Rather than mirroring how the business is organized internally, the site's structure was built around how a borrower actually searches. Someone looking for <em class="text-neutral-900 font-medium">"gold loan Guruvayoor"</em> has a different intent from someone comparing <em class="text-neutral-900 font-medium">"doorstep gold loan"</em> options, and both are different again from someone researching a <em class="text-neutral-900 font-medium">"micro business loan"</em> for a small enterprise.
          </p>
        </div>
        <div class="lg:col-span-4 bg-[#F8FAFC] p-5 rounded-2xl border border-neutral-200/80 shadow-xs text-xs text-neutral-600 leading-relaxed">
          <strong class="text-neutral-900 block mb-1 font-bold">Content Principle</strong>
          Each loan page was given its own URL, with content written to answer the specific questions a borrower for that product would have — eligibility, required documents, and process — rather than generic loan copy repeated across pages.
        </div>
      </div>

