---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AbrusStickyNav from '../../components/case-study/AbrusStickyNav';
import AbrusInteractiveIA from '../../components/case-study/AbrusInteractiveIA';
import AbrusLightbox, { type GalleryItem } from '../../components/case-study/AbrusLightbox';
import AbrusFAQ, { faqsData } from '../../components/case-study/AbrusFAQ';
import site from '../../data/site.json';
import { 
  Shield, 
  Clock, 
  MapPin, 
  Search, 
  CheckCircle2, 
  Layers, 
  ChevronRight, 
  FileText, 
  Building2, 
  Sparkles,
  Phone, 
  MessageCircle,
  Mail,
  ExternalLink,
  Lock,
  Coins,
  ArrowRight,
  TrendingUp,
  Zap,
  Globe2
} from 'lucide-react';

const pageTitle = "Abrus Krishna Finance: WordPress Website Design for a KML-Registered Gold Loan Company in Guruvayoor | Teknoppy Case Study";
const pageDescription = "How Teknoppy built abruskrishna.com on WordPress for a KML-registered Kerala gold loan and micro-finance company in Guruvayoor: 9 dedicated loan pages, regulatory trust integration, local search strategy, and deliberate product separation.";
const canonicalURL = "https://teknoppy.com/case-studies/abrus-krishna-finance/";

// Gallery data for Lightbox
const galleryItems: GalleryItem[] = [
  {
    id: 'hero-ui',
    src: '/case-studies/abruskrishna.webp',
    title: 'abruskrishna.com Live Homepage & Trust Architecture',
    category: 'Full Website Experience',
    caption: 'The live WordPress homepage built on Elementor, presenting upfront borrower verification, gold loan offerings, and institutional credibility.'
  },
  {
    id: 'branding-identity',
    src: '/client logos/abrus-krishna-finance.jpg',
    title: 'Abrus Krishna Finance Brand Identity',
    category: 'Brand Trust Signal',
    caption: 'Official institutional logo and color identity for the Guruvayoor-based KML-registered lending institution.'
  },
  {
    id: 'local-presence',
    src: '/case-studies/abruskrishna.webp',
    title: 'Borrower Trust & Local Branch Presentation',
    category: 'UI & Compliance',
    caption: 'Branch location information, KML compliance statements, and 15–30 minute rapid approval steps displayed prominently for prospective borrowers.'
  }
];

// Structured Data for Article & FAQ
const schemaArticle = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Abrus Krishna Finance: WordPress Website Design for a KML-Registered Gold Loan Company in Guruvayoor",
  "description": pageDescription,
  "image": "https://teknoppy.com/case-studies/abruskrishna.webp",
  "author": {
    "@type": "Person",
    "name": "Sanal Edison",
    "jobTitle": "Digital Strategist",
    "worksFor": {
      "@type": "Organization",
      "name": "Teknoppy"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Teknoppy",
    "logo": {
      "@type": "ImageObject",
      "url": "https://teknoppy.com/logo.svg"
    }
  },
  "mainEntityOfPage": canonicalURL,
  "about": {
    "@type": "FinancialService",
    "name": "Abrus Krishna Finance",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Guruvayoor",
      "addressRegion": "Kerala",
      "addressCountry": "India"
    }
  }
};

const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqsData.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout title={pageTitle} description={pageDescription} image="/case-studies/abruskrishna.webp">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />
  </Fragment>

  <!-- Global Header with solid background -->
  <Header forceSolidBg={true} />

  <main class="bg-[#05070B] text-slate-100 selection:bg-indigo-500/30 selection:text-indigo-200 overflow-x-hidden pt-20 lg:pt-24 font-sans">
    
    <!-- =========================================================================
        01. HERO SECTION (DARK INK & INDIGO DESIGN SYSTEM)
        ========================================================================= -->
    <section id="project-hero" class="relative pt-12 pb-16 md:pt-18 md:pb-24 overflow-hidden border-b border-white/[0.08]">
      {/* Atmospheric Ambient Lighting */}
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(99,102,241,0.18),transparent_50%),radial-gradient(circle_at_80%_80%,rgba(56,189,248,0.12),transparent_50%)] pointer-events-none"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-8">
        
        {/* Breadcrumb & Case Study Marker */}
        <div class="reveal-on-scroll flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
            <a href="/" class="hover:text-indigo-400 transition-colors">Home</a>
            <span>/</span>
            <a href="/case-study/" class="hover:text-indigo-400 transition-colors">Case Studies</a>
            <span>/</span>
            <span class="text-white font-medium">Abrus Krishna Finance</span>
          </div>

          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs font-bold uppercase tracking-wider shadow-sm backdrop-blur-md">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
            </span>
            Teknoppy Flagship Case Study
          </div>
        </div>

        {/* Hero Title & Story Lead */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-end">
          <div class="lg:col-span-8 space-y-6">
            <div class="reveal-on-scroll reveal-delay-1 inline-block px-3 py-1 rounded-md bg-indigo-500/15 border border-indigo-500/30 text-indigo-300 text-xs sm:text-sm font-bold tracking-wide uppercase">
              Financial Services & Gold Loan Architecture
            </div>

            <h1 class="reveal-on-scroll reveal-delay-2 text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-[1.08]">
              WordPress Website Design for a <span class="bg-gradient-to-r from-white via-indigo-100 to-indigo-400 bg-clip-text text-transparent">KML-Registered</span> Gold Loan Company in Guruvayoor
            </h1>

            <p class="reveal-on-scroll reveal-delay-3 text-base sm:text-lg text-slate-300 font-normal leading-[1.6] max-w-3xl">
              How Teknoppy architected <strong class="font-semibold text-white">abruskrishna.com</strong> around search intent, regulatory trust under the Kerala Money-Lenders Act, 1958, and deliberate separation between nine distinct loan products.
            </p>
          </div>

          {/* Project Metadata Card */}
          <div class="reveal-on-scroll reveal-delay-3 lg:col-span-4 bg-[#0D1424]/90 rounded-2xl p-6 sm:p-7 border border-white/[0.1] shadow-2xl space-y-5 backdrop-blur-xl">
            <div class="flex items-center justify-between border-b border-white/[0.08] pb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Client</span>
              <span class="text-sm font-bold text-white">Abrus Krishna Finance</span>
            </div>

            <div class="space-y-3.5 text-xs sm:text-sm">
              <div class="flex justify-between gap-4">
                <span class="text-slate-400">Industry</span>
                <span class="font-semibold text-right text-slate-200">Gold Loans & Micro-Finance (KML-Registered Lending)</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-slate-400">Location</span>
                <span class="font-semibold text-right text-slate-200">Guruvayoor, Thrissur District, Kerala</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-slate-400">Platform</span>
                <span class="font-semibold text-right text-slate-200">WordPress (Elementor)</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-slate-400">Services</span>
                <span class="font-semibold text-right text-slate-200">Website Design, WordPress Development, Information Architecture, SEO</span>
              </div>
              <div class="flex justify-between gap-4 pt-2 border-t border-white/[0.08]">
                <span class="text-slate-400">Live URL</span>
                <a 
                  href="https://abruskrishna.com" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="font-bold text-indigo-400 hover:text-indigo-300 hover:underline flex items-center gap-1"
                >
                  abruskrishna.com <ExternalLink className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Hero Showcase Visual Device Mockup */}
        <div class="reveal-on-scroll relative rounded-3xl overflow-hidden border border-white/[0.12] bg-[#070A12] shadow-2xl">
          {/* Browser Bar */}
          <div class="px-5 py-3.5 bg-[#0A0F1C] border-b border-white/[0.08] flex items-center justify-between gap-4 backdrop-blur-md">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            </div>

            <div class="flex items-center gap-2 px-4 py-1 rounded-full bg-white/[0.05] text-[11px] text-slate-400 font-mono border border-white/[0.08] max-w-sm w-full justify-center">
              <Lock className="w-3 h-3 text-emerald-400" />
              <span>https://abruskrishna.com</span>
            </div>

            <div class="text-[11px] text-slate-400 font-semibold hidden sm:block font-mono">
              WordPress • Elementor
            </div>
          </div>

          {/* Hero Image */}
          <div class="relative group">
            <img 
              src="/case-studies/abruskrishna.webp" 
              alt="Abrus Krishna Finance WordPress Website Design Showcase" 
              class="w-full h-auto max-h-[640px] object-cover object-top"
              loading="eager"
            />
            
            {/* Floating Highlights Strip */}
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-[#05070B] via-[#05070B]/80 to-transparent p-6 sm:p-10 pt-16 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white/10 text-white backdrop-blur-md border border-white/20">
                  9 Dedicated Search-Intent Pages
                </span>
                <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white/10 text-white backdrop-blur-md border border-white/20">
                  15–30 Minute In-Branch Approval
                </span>
                <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white/10 text-white backdrop-blur-md border border-white/20">
                  KML Regulatory Compliance Core
                </span>
              </div>

              <a 
                href="#overview" 
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white text-xs font-bold transition-all shadow-lg hover:shadow-indigo-500/30"
              >
                Read Architectural Analysis
                <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- =========================================================================
        02. STICKY SUBNAVIGATION & PROGRESS BAR
        ========================================================================= -->
    <AbrusStickyNav client:load />

    <!-- =========================================================================
        03. PROJECT OVERVIEW & CONTEXT
        ========================================================================= -->
    <section id="overview" class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 reveal-on-scroll">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        {/* Left Column: Section Marker & Dark Editorial Callout */}
        <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-28">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/[0.08] text-indigo-400 text-xs font-bold uppercase tracking-wider">
            <Building2 className="w-3.5 h-3.5 text-indigo-400" />
            Institutional Context
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl text-white font-extrabold tracking-tight leading-tight">
            A website that carries the trust built by the physical branch since 2018.
          </h2>

          <div class="p-6 rounded-2xl bg-[#0D1424]/90 border border-white/[0.08] shadow-xl space-y-3">
            <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Key Characteristic</span>
            <p class="text-sm text-slate-300 leading-relaxed font-normal">
              As a secured, collateral-backed lender operating under a state licensing framework, Abrus Krishna Finance carries obligations most local businesses don't: interest rates, foreclosure terms, KYC verification, and customer data handling all sit under statutory KML regulation.
            </p>
          </div>
        </div>

        {/* Right Column: Narrative Body & At a Glance */}
        <div class="lg:col-span-7 space-y-8 text-slate-300 text-base sm:text-lg leading-relaxed">
          <div class="space-y-5">
            <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
              About Abrus Krishna Finance
            </h3>
            
            <p>
              Abrus Krishna Finance is a <strong class="text-white font-semibold">Kerala Money-Lenders Act, 1958 (KML) registered lending institution</strong> headquartered near Thaikad, Guruvayoor. Operating in the financial sector since 2018, the company provides gold loans, doorstep gold loans, and a range of micro business, personal, home, and consumer goods loans to individuals, families, and small business owners across the region, working through KML-compliant agreements and authorised partner shops.
            </p>

            <p>
              Every borrower has reason to check a lender's legitimacy before pledging gold jewelry or signing an agreement. That combination — <strong class="text-white font-semibold">nine distinct loan pages, a regulated operating environment, and a customer base that includes many first-time borrowers</strong> — made this brief unusually specific.
            </p>

            <p>
              It wasn't a generic &ldquo;get us online&rdquo; project; it was a request for a website that could carry the exact same trust the physical branch had built since 2018.
            </p>
          </div>

          {/* Key Facts / At a Glance */}
          <div class="pt-6">
            <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">
              Project Snapshot • At a Glance
            </h4>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              {[
                { title: "9 Dedicated Loan Pages", desc: "Each built around its own distinct search intent without generic bundling." },
                { title: "KML Compliance as a First-Class Page", desc: "Positioned prominently as core trust content rather than a hidden footer disclaimer." },
                { title: "Gold Loan vs Doorstep Gold Loan Separation", desc: "Kept deliberately distinct to prevent internal search keyword competition." },
                { title: "15–30 Minute Approval Process", desc: "Realistic, rapid approval timing laid out upfront on the homepage." },
                { title: "Dual Spelling Local Strategy", desc: "Covering both 'Guruvayoor' and 'Guruvayur' natural search queries." }
              ].map((item, i) => (
                <div key={i} class={`p-4 rounded-xl border border-white/[0.08] bg-[#0C1220]/90 shadow-sm ${i === 4 ? 'sm:col-span-2' : ''}`}>
                  <div class="flex items-start gap-3">
                    <CheckCircle2 className="w-5 h-5 text-indigo-400 flex-shrink-0 mt-0.5" />
                    <div>
                      <h5 class="text-sm font-bold text-white mb-1">{item.title}</h5>
                      <p class="text-xs text-slate-400 leading-normal">{item.desc}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- =========================================================================
        04. THE CHALLENGE (5-CARD DIAGNOSTIC GRID)
        ========================================================================= -->
    <section id="challenges" class="py-20 md:py-28 bg-[#070A12] text-white relative overflow-hidden border-y border-white/[0.08] reveal-on-scroll">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">
            Diagnostic Assessment
          </span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
            The Challenges Before Redesign
          </h2>
          <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
            Before the redesign, Abrus Krishna Finance's online presence did not reflect the breadth or the trustworthiness of the business. Five core structural obstacles stood in the way of borrower trust and search visibility.
          </p>
        </div>

        {/* 5 Challenges Grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
          
          {/* Card 1 */}
          <div class="p-7 rounded-2xl bg-[#0C1220]/90 border border-white/[0.08] hover:border-indigo-500/40 transition-all flex flex-col justify-between group shadow-lg">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-white/[0.06] pb-4">
                <span class="font-mono text-xs text-indigo-400 font-bold">CHALLENGE 01</span>
                <Layers className="w-5 h-5 text-indigo-400" />
              </div>
              <h3 class="text-xl font-bold text-white tracking-tight leading-snug group-hover:text-indigo-300 transition-colors">
                Nine loan products, no clear separation
              </h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                Gold Loan, Gold Loan in Guruvayoor, Doorstep Gold Loan, Business Loan in Guruvayoor, Business & Micro Enterprise Loan, Micro Personal Loan, Micro Home Loan, Micro Finance, and Consumer Goods Loan needed to exist as their own pages instead of being bundled into one generic loans/services page. A borrower searching for one specific product had no direct path to the information relevant to them.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] font-mono text-slate-500">
              Impact: High bounce rate & lost specific search intent
            </div>
          </div>

          {/* Card 2 */}
          <div class="p-7 rounded-2xl bg-[#0C1220]/90 border border-white/[0.08] hover:border-indigo-500/40 transition-all flex flex-col justify-between group shadow-lg">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-white/[0.06] pb-4">
                <span class="font-mono text-xs text-indigo-400 font-bold">CHALLENGE 02</span>
                <Shield className="w-5 h-5 text-sky-400" />
              </div>
              <h3 class="text-xl font-bold text-white tracking-tight leading-snug group-hover:text-indigo-300 transition-colors">
                Compliance and trust signals were missing
              </h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                There was no dedicated KML Registration & Compliance page, and no FAQ content addressing the questions a first-time borrower actually has: whether a branch visit is mandatory, how foreclosure works, how repayments are collected, and how personal and financial data is protected. For a regulated lender, this content is the foundation of borrower trust.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] font-mono text-slate-500">
              Impact: Hesitation among first-time borrowers
            </div>
          </div>

          {/* Card 3 */}
          <div class="p-7 rounded-2xl bg-[#0C1220]/90 border border-white/[0.08] hover:border-indigo-500/40 transition-all flex flex-col justify-between group shadow-lg">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-white/[0.06] pb-4">
                <span class="font-mono text-xs text-indigo-400 font-bold">CHALLENGE 03</span>
                <Coins className="w-5 h-5 text-amber-400" />
              </div>
              <h3 class="text-xl font-bold text-white tracking-tight leading-snug group-hover:text-indigo-300 transition-colors">
                Gold Loan and Doorstep Gold Loan needed clear separation
              </h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                These two products are closely related and searched for in similar ways. Without a deliberate content structure, the two pages would end up targeting the same terms and competing with each other instead of each ranking for its own distinct intent — one branch-based, one home-collection.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] font-mono text-slate-500">
              Impact: Internal search competition & keyword overlap
            </div>
          </div>

          {/* Card 4 */}
          <div class="p-7 rounded-2xl bg-[#0C1220]/90 border border-white/[0.08] hover:border-indigo-500/40 transition-all flex flex-col justify-between group shadow-lg">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-white/[0.06] pb-4">
                <span class="font-mono text-xs text-indigo-400 font-bold">CHALLENGE 04</span>
                <Clock className="w-5 h-5 text-emerald-400" />
              </div>
              <h3 class="text-xl font-bold text-white tracking-tight leading-snug group-hover:text-indigo-300 transition-colors">
                No visible borrower journey
              </h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                The steps between a customer's first enquiry and receiving their loan — contact/visit, document verification, approval, disbursement — weren't laid out anywhere. First-time borrowers had no way to know what to expect, including how fast the process actually moves.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] font-mono text-slate-500">
              Impact: Customer drop-off before initial contact
            </div>
          </div>

          {/* Card 5 */}
          <div class="p-7 rounded-2xl bg-[#0C1220]/90 border border-white/[0.08] hover:border-indigo-500/40 transition-all flex flex-col justify-between group shadow-lg md:col-span-2 lg:col-span-2">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-white/[0.06] pb-4">
                <span class="font-mono text-xs text-indigo-400 font-bold">CHALLENGE 05</span>
                <MapPin className="w-5 h-5 text-indigo-400" />
              </div>
              <h3 class="text-xl font-bold text-white tracking-tight leading-snug group-hover:text-indigo-300 transition-colors">
                Local search intent was underused
              </h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                Guruvayoor-specific searches — <em class="text-slate-200">"gold loan Guruvayoor,"</em> <em class="text-slate-200">"business loan Guruvayoor"</em> — weren't reflected in the site's structure or page titles, leaving local intent unaddressed even though the branch is a local, walk-in business built on neighbourhood trust.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] font-mono text-slate-500">
              Impact: Loss of walk-in search traffic to local competitors
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =========================================================================
        05. PROJECT OBJECTIVES & TRANSFORMATION STORY
        ========================================================================= -->
    <section id="objectives" class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 reveal-on-scroll">
      <div class="space-y-16">
        
        {/* Section Heading */}
