---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterCTA from '../../components/FooterCTA.astro';
import InnerPage from '../../components/InnerPage.astro';
import page from '../../data/pages/case-studies/mount-bell-global-studies-web-design-development.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA />
</Layout>
