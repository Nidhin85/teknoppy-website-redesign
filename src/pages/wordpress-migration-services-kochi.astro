---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/wordpress-migration-services-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA heading="Ready to Move Your Website Safely?" description="Tell us where your site is hosted now and where you want to move it. We reply within one business day with a migration plan, timeline and fixed quote." />
</Layout>
