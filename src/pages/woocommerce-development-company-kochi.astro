---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/woocommerce-development-company-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA
    heading="Ready to Start Your WooCommerce Development Project?"
    description="Tell us what your store needs — new build, redesign or migrations. We reply within one business day with a recommended store plan, timeline and quote."
  />
</Layout>
