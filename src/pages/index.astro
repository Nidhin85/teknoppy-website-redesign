---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomepageVideoHero from '../components/HomepageVideoHero.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import KeralaCities from '../components/KeralaCities.astro';
import Services from '../components/Services.astro';
import KeralaProcess from '../components/KeralaProcess.astro';
import KeralaPricing from '../components/KeralaPricing.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import KeralaIndustries from '../components/KeralaIndustries.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.tsx';
import videoTestimonials from '../data/video-testimonials.json';
import GoogleReviews from '../components/GoogleReviews.astro';
import Blog from '../components/Blog.astro';
import FAQ from '../components/FAQ.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { getCollection } from 'astro:content';
import home from '../data/home.json';

const title = "Web Design Company in Kerala — Teknoppy | Website Design and Development";
const description = "Teknoppy is a trusted web design company in Kerala building SEO-friendly, responsive websites for businesses from Thiruvananthapuram to Kozhikode. Book a free consultation.";

const stripHtml = (html: string) => html.replace(/<[^>]*>?/gm, '');

const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.teknoppy.com/#organization",
      "name": "Teknoppy",
      "url": "https://www.teknoppy.com/",
      "logo": "https://www.teknoppy.com/logo.svg",
      "description": "Web design company in Kerala",
      "foundingDate": "2018",
      "founder": {
        "@type": "Person",
        "name": "Sanal Edison"
      },
      "telephone": "+91-6282249224",
      "email": "sales@teknoppy.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam, Vyttila",
        "addressLocality": "Kochi",
        "addressRegion": "Kerala",
        "postalCode": "682019",
        "addressCountry": "IN"
      },
      "areaServed": [
        { "@type": "State", "name": "Kerala" },
        { "@type": "City", "name": "Kochi" },
        { "@type": "City", "name": "Thrissur" },
        { "@type": "City", "name": "Kozhikode" },
        { "@type": "City", "name": "Thiruvananthapuram" },
        { "@type": "City", "name": "Palakkad" },
        { "@type": "City", "name": "Kottayam" }
      ],
      "sameAs": [
        "https://www.facebook.com/teknoppy/",
        "https://www.linkedin.com/company/teknoppy/",
        "https://www.instagram.com/teknoppy/"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.teknoppy.com/#website",
      "url": "https://www.teknoppy.com/",
      "name": "Teknoppy",
      "publisher": {
        "@id": "https://www.teknoppy.com/#organization"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.teknoppy.com/#faq",
      "mainEntity": home.faq.items.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": stripHtml(faq.answer)
        }
      }))
    }
  ]
};

const testimonials = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ name: e.data.name, role: e.data.role, content: e.data.quote, initials: e.data.initials, photo: e.data.photo }));
---

<Layout title={title} description={description} canonical="https://www.teknoppy.com/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
  </Fragment>
  <Header forceSolidBg={true} />
  <main>
    <HomepageVideoHero />
    <Hero />
    <About />
    <KeralaCities />
    <Services />
    <KeralaProcess />
    <KeralaPricing />
    <WhyChooseUs />
    <KeralaIndustries />
    <Portfolio />
    <Testimonials testimonials={testimonials} videos={videoTestimonials.videos} client:visible />
    <GoogleReviews />
    <Blog />
    <FAQ />
  </main>
  <FooterCTA includeSchema={false} />
</Layout>
