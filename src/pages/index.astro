---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.tsx';
import videoTestimonials from '../data/video-testimonials.json';
import Blog from '../components/Blog.astro';
import FAQ from '../components/FAQ.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { getCollection } from 'astro:content';

const title = "Web Design Company in Kerala — Teknoppy | Website Design and Development";
const description = "Teknoppy is a trusted Web Design Company in Kerala delivering SEO-friendly, responsive, and conversion-focused websites for businesses across Kerala and Kochi. Book your free consultation today.";

const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.teknoppy.com/#organization",
      "name": "Teknoppy",
      "url": "https://www.teknoppy.com/",
      "logo": "https://www.teknoppy.com/logo.svg",
      "image": "https://www.teknoppy.com/og-image.png",
      "foundingDate": "2018",
      "founder": {
        "@type": "Person",
        "name": "Sanal Edison"
      },
      "email": "sales@teknoppy.com",
      "telephone": "+91-6282249224",
      "sameAs": [
        "https://www.teknoppy.com/"
      ]
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://www.teknoppy.com/#localbusiness",
      "name": "Teknoppy",
      "image": "https://www.teknoppy.com/og-image.png",
      "url": "https://www.teknoppy.com/",
      "telephone": "+91-6282249224",
      "email": "sales@teknoppy.com",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam, Vyttila",
        "addressLocality": "Kochi",
        "addressRegion": "Kerala",
        "postalCode": "682019",
        "addressCountry": "IN"
      },
      "areaServed": [
        "Kochi",
        "Thrissur",
        "Kozhikode",
        "Thiruvananthapuram",
        "Palakkad",
        "Kottayam",
        "UAE",
        "Qatar"
      ],
      "parentOrganization": {
        "@id": "https://www.teknoppy.com/#organization"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.teknoppy.com/#website",
      "url": "https://www.teknoppy.com/",
      "name": "Teknoppy",
      "publisher": {
        "@id": "https://www.teknoppy.com/#organization"
      },
      "inLanguage": "en-IN"
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.teknoppy.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which web design company in Kerala is reliable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Teknoppy has been delivering professional website design and development from our Kochi office since 2018. With over 120 completed projects across Kerala, the UAE and Qatar, we are one of Kerala's most trusted digital agencies, backed by real client results, not just claims."
          }
        },
        {
          "@type": "Question",
          "name": "How to choose a web design company in Kerala?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Look for three things: a verified portfolio with real Kerala clients, demonstrated SEO knowledge built into the design process, and clear post-launch support terms. A good Kerala web design agency delivers not just a website but measurable business outcomes including search rankings and lead generation."
          }
        },
        {
          "@type": "Question",
          "name": "What does a web design company in Kerala provide?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A full-service web design company in Kerala provides website design, custom development, ecommerce solutions, SEO integration, UI UX design, web application development, and ongoing technical support, everything a Kerala business needs to build, rank, and grow its digital presence."
          }
        },
        {
          "@type": "Question",
          "name": "How much does website design cost in Kerala?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Website design costs in Kerala vary based on scope. A business website typically starts from a clearly scoped package price while ecommerce and web application projects are quoted based on features and complexity."
          }
        }
      ]
    }
  ]
};

const testimonials = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ name: e.data.name, role: e.data.role, content: e.data.quote, initials: e.data.initials, photo: e.data.photo }));
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
  </Fragment>
  <Header />
  <main>
    <Hero />
    <About />
    <Services />
    <WhyChooseUs />
    <Portfolio />
    <Testimonials testimonials={testimonials} videos={videoTestimonials.videos} client:visible />
    <Blog />
    <FAQ />
  </main>
  <FooterCTA includeSchema={false} />
</Layout>
