---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.tsx';
import videoTestimonials from '../data/video-testimonials.json';
import Blog from '../components/Blog.astro';
import FAQ from '../components/FAQ.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const title = "Web Design Company in Kerala — Teknoppy | Website Design and Development";
const description = "Teknoppy is a trusted Web Design Company in Kerala delivering SEO-friendly, responsive, and conversion-focused websites for businesses across Kerala and Kochi. Book your free consultation today.";

// Structure doc §1: the homepage carries LocalBusiness (from FooterCTA) +
// Organization + WebSite + FAQPage (from the FAQ component).
const siteUrl = 'https://teknoppy.com/';
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#organization`,
  "name": site.businessName,
  "url": siteUrl,
  "logo": `${siteUrl}logo.svg`,
  "email": site.email,
  "telephone": site.phone,
  "foundingDate": site.established,
  "founder": { "@id": "https://teknoppy.com/sanal-edison-digital-strategist/#person" },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Kaithakal Building, Near Thykoodam Metro, Vyttila PO",
    "addressLocality": "Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  },
  "areaServed": [
    { "@type": "State", "name": "Kerala" },
    { "@type": "Country", "name": "United Arab Emirates" },
    { "@type": "Country", "name": "Qatar" }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  "name": site.businessName,
  "url": siteUrl,
  "inLanguage": "en-IN",
  "publisher": { "@id": `${siteUrl}#organization` }
};

const testimonials = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ name: e.data.name, role: e.data.role, content: e.data.quote, initials: e.data.initials, photo: e.data.photo }));
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <About />
    <Services />
    <WhyChooseUs />
    <Portfolio />
    <Testimonials testimonials={testimonials} videos={videoTestimonials.videos} client:visible />
    <Blog />
    <FAQ />
  </main>
  <FooterCTA />

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
</Layout>
