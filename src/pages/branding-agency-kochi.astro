---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/branding-agency-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA 
    heading="Start Your Branding Project With Teknoppy"
    description="Share your goals and what is not working in your current identity. We will review it and send a clear, no-obligation proposal within 24 hours."
  />
</Layout>
