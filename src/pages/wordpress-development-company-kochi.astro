---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Play, Globe2, Smile, Award, Star, CheckCircle, Clock, Heart, Shield, Check, HelpCircle, User, Zap, Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages, MonitorSmartphone, Building2, Edit, ShieldCheck, Search, Layers, Network, Code, Gauge, LayoutGrid, Calendar, TrendingUp } from 'lucide-react';

const title = "WordPress Development Company Kochi | Custom WordPress Services";
const description = "Teknoppy is a trusted WordPress development company Kochi delivering custom WordPress websites, WooCommerce development, and migration services for Kerala businesses. AWS certified developers since 2018.";

const services = [
  {
    title: "WordPress Web Design Kochi",
    desc: "Professional interface design for corporate sites, landing pages, and conversion-focused platforms combining visual excellence with user experience strategy.",
    icon: MonitorSmartphone
  },
  {
    title: "Custom WordPress Development Kochi",
    desc: "Fully custom WordPress builds from discovery through launch, including theme development, plugin customization, and database architecture tailored to your business needs.",
    icon: Code
  },
  {
    title: "WordPress Website Design Kochi",
    desc: "Complete website design covering responsive layouts, mobile-first design, and pixel-perfect mockups ensuring your WordPress site looks stunning on all devices.",
    icon: LayoutGrid
  },
  {
    title: "WooCommerce Development Kochi",
    desc: "E-commerce WordPress stores with product catalogs, payment gateway integration, inventory management, and conversion-optimized checkout flows.",
    icon: Briefcase
  },
  {
    title: "WordPress Migration Kochi",
    desc: "Seamless migration from Wix, Shopify, Blogger, or other platforms to WordPress while preserving SEO rankings and redirecting old URLs correctly.",
    icon: Network
  },
  {
    title: "WordPress Maintenance Services Kochi",
    desc: "Monthly plans covering plugin updates, security patches, uptime monitoring, content updates, speed checks, and technical WordPress support.",
    icon: ShieldCheck
  },
  {
    title: "WordPress Speed Optimization Kochi",
    desc: "Core Web Vitals optimization, image compression, caching strategies, and performance tuning ensuring sub-2.5-second load times.",
    icon: Gauge
  },
  {
    title: "WordPress Security & Updates Kochi",
    desc: "SSL certificates, daily backups, malware scanning, security hardening, and automated WordPress core plugin updates protecting your site 24/7.",
    icon: Shield
  }
];

const processes = [
  {
    step: "01",
    title: "Discovery & Requirements",
    desc: "Detailed stakeholder interviews mapping your business goals, target audience, competitor landscape, and technical requirements for WordPress development.",
    icon: Search
  },
  {
    step: "02",
    title: "WordPress Architecture Planning",
    desc: "Custom WordPress structure, URL hierarchy, database design, and internal-linking strategy preventing keyword cannibalization and ensuring clean crawlability.",
    icon: Network
  },
  {
    step: "03",
    title: "WordPress Web Design & Wireframing",
    desc: "Low-fidelity wireframes approved before development. High-fidelity mockups for WordPress web design ensuring zero revision surprises after coding starts.",
    icon: LayoutGrid
  },
  {
    step: "04",
    title: "Custom WordPress Development",
    desc: "Clean semantic HTML/CSS, mobile-first responsive design with custom themes, plugin integration, and API connectivity as needed for your WordPress website.",
    icon: Code
  },
  {
    step: "05",
    title: "SEO Setup & Content Migration",
    desc: "On-page SEO optimization, schema markup implementation, sitemap generation, and Google Search Console verification for WordPress ranking readiness.",
    icon: Gauge
  },
  {
    step: "06",
    title: "Testing, Launch & Training",
    desc: "Full cross-browser cross-device testing, WordPress security hardening, performance verification, sitemap submission, and comprehensive handover documentation.",
    icon: Rocket
  }
];

const pricing = [
  { type: "Basic WordPress Website (5–8 pages)", price: "Rs. 40,000 – 80,000" },
  { type: "Professional Multi-Page WordPress (10–20 pages)", price: "Rs. 80,000 – 1,80,000" },
  { type: "Corporate WordPress with CMS (20–40 pages)", price: "Rs. 1,80,000 – 4,00,000" },
  { type: "WooCommerce Store (15–30 products)", price: "Rs. 1,00,000 – 2,50,000" },
  { type: "WordPress Migration (from other platforms)", price: "Rs. 30,000 – 1,20,000" },
  { type: "WordPress Maintenance Plans (monthly)", price: "Rs. 5,000 – 15,000 / mo" }
];

const industries = [
  { name: "Startups & New Business", desc: "Credibility-building WordPress launch sites converting early-stage visitors into qualified leads.", icon: Rocket },
  { name: "Hospitals & Healthcare", desc: "Trust-first WordPress sites with appointment booking, doctor profiles, and structured health content.", icon: Activity },
  { name: "Real Estate Agencies", desc: "Property listing WordPress platforms with search filters, maps, enquiry forms, and agent profiles.", icon: Home },
  { name: "Restaurants & Food", desc: "Mobile-first WordPress sites with menu integration, reservations, and Google Maps connectivity.", icon: Utensils },
  { name: "Schools & Education", desc: "Structured WordPress sites with admission forms, faculty pages, course listings, and parent portals.", icon: GraduationCap },
  { name: "Tourism & Travel", desc: "Visually rich conversion-focused WordPress sites with package listings and booking enquiry systems.", icon: Compass },
  { name: "Professional Services", desc: "High-authority WordPress sites for law firms, consultants, CAs, and financial advisors.", icon: Briefcase },
  { name: "Manufacturing & B2B", desc: "Corporate-grade WordPress B2B sites with product catalogues and enquiry architecture.", icon: Factory }
];

const projects = [
  {
    name: "Evosyz",
    type: "Fintech Corporate WordPress Website",
    loc: "KOCHI · FINTECH",
    desc: "Custom WordPress development communicating RBI-licensed services to franchisees and financial partners, with custom UI/UX, conversion-focused layout, and WhatsApp integration.",
    result: "Increased franchise enquiries, improved brand credibility, and stronger search visibility for fintech keywords in Kochi."
  },
  {
    name: "Greens Ayurveda",
    type: "Healthcare & Wellness WordPress Website",
    loc: "AZHIYUR, CALICUT · AYURVEDA",
    desc: "Mobile-first SEO-optimised WordPress wellness site with clear treatment pages, appointment enquiry forms, and structured content architecture for domestic and international visitors.",
    result: "A significant rise in international enquiries, improved time on page, and stronger organic visibility for Ayurvedic treatment keywords."
  },
  {
    name: "Olives Resort",
    type: "Tourism & Hospitality WordPress Website",
    loc: "WAYANAD · HOSPITALITY",
    desc: "Visually rich conversion-focused WordPress hospitality site with property showcase pages, booking integration, and Google Maps connectivity.",
    result: "Top Google rankings for resort keywords and measurable increase in direct booking calls (confirmed by CEO Biju Thomas)."
  },
  {
    name: "SIBP",
    type: "Educational Institution WordPress Website",
    loc: "KERALA · EDUCATION",
    desc: "Structured institutional WordPress website with admission enquiry forms, faculty sections, course listings, and event calendar, built with clean URL architecture and local SEO.",
    result: "Improved admission enquiries and stronger local search visibility."
  },
  {
    name: "Dream Abroad",
    type: "Overseas Education Consultancy WordPress Website",
    loc: "KERALA · CONSULTANCY",
    desc: "Professional consultancy WordPress website with country-specific programme pages, student enquiry forms, and trust-forward content structure built to convert prospective students.",
    result: "Higher quality student enquiries and improved organic rankings."
  },
  {
    name: "Mountbell",
    type: "Corporate Business WordPress Website",
    loc: "KOCHI · CORPORATE",
    desc: "Professional multi-page corporate WordPress website focused on clean layouts, fast load times, and structured service architecture supporting business development.",
    result: "Stronger positioning as a credible corporate entity in Kochi."
  }
];

const testimonials = [
  {
    quote: "We now rank at the top of Google for our WordPress keywords and get many direct booking calls. Thank you Teknoppy for all the support.",
    author: "Biju Thomas",
    role: "CEO, Olives Resort, Wayanad"
  },
  {
    quote: "Teknoppy was very intuitive in understanding our WordPress requirements. They made great digital collateral and now we are getting good outreach to the market.",
    author: "Shainesh Prakashan",
    role: "CEO, Exacore IT, Infopark Kochi"
  },
  {
    quote: "I have worked with many IT teams, but I am 100% happy with Teknoppy. No doubt, I recommend them with 100% satisfaction.",
    author: "Dr. Asghar",
    role: "CEO, Greens Ayurveda, Calicut"
  },
  {
    quote: "Being in the Fintech space, we needed a reliable WordPress partner. Teknoppy created an appealing WordPress website that represents our brand perfectly.",
    author: "Vivek Menon",
    role: "CTO, Evosyz, Kochi"
  }
];

const faqs = [
  {
    q: "What services does a WordPress development company offer?",
    a: "Professional WordPress development companies offer custom WordPress web design, custom development, WooCommerce e-commerce, WordPress maintenance, migration services, speed optimization, and ongoing support covering discovery through launch and beyond."
  },
  {
    q: "How much does WordPress development cost in Kochi?",
    a: "Costs range from Rs. 40,000 for basic websites to Rs. 4,00,000+ for enterprise WordPress solutions. Every project receives a written quote based on pages, functionality, and complexity."
  },
  {
    q: "How long does WordPress development take?",
    a: "Standard WordPress websites take 3-5 weeks from discovery to launch. Larger sites with custom functionality can take 6-12 weeks. Written timelines are provided at project start."
  },
  {
    q: "Can you migrate my existing website to WordPress?",
    a: "Yes. Our WordPress migration services handle transfers from Shopify, Wix, Blogger, and other platforms while preserving SEO rankings and implementing proper redirects."
  },
  {
    q: "Is custom WordPress development better than templates?",
    a: "Custom WordPress development provides better security, performance, scalability, and unique branding compared to template-based solutions. Custom WordPress is built specifically for your business requirements."
  },
  {
    q: "Is WordPress SEO-friendly?",
    a: "Yes. WordPress with proper optimization is highly SEO-friendly. Every WordPress site includes on-page SEO, schema markup, mobile optimization, and speed tuning standard."
  },
  {
    q: "What makes a WordPress website secure?",
    a: "Security includes SSL certificates, daily backups, malware scanning, security hardening, regular WordPress core updates, plugin updates, and 24/7 monitoring."
  },
  {
    q: "Does your WordPress development company provide ongoing support?",
    a: "Yes. Monthly WordPress maintenance plans cover updates, security monitoring, speed optimization, content changes, and technical WordPress support."
  },
  {
    q: "Do you offer multilingual WordPress development?",
    a: "Yes. We build multilingual WordPress websites for businesses wanting to reach both Malayalam-speaking and international audiences — especially valuable for tourism, Ayurveda, and export-oriented businesses."
  },
  {
    q: "How do I get started with Teknoppy?",
    a: "Contact us via the Contact page, request a quote, or book a free 30-minute consultation. We respond to all enquiries within one business day."
  },
  {
    q: "Do you provide website maintenance after launch?",
    a: "Yes. Monthly WordPress maintenance plans from Rs. 5,000 per month cover updates, security monitoring, speed checks, content edits, and technical fixes."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={title} description={description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- HERO SECTION WITH OFFICE CIRCLING SVG (DARK VERSION) -->
    <section class="relative pt-32 pb-24 md:pt-36 md:pb-32 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.png')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 grid xl:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="xl:col-span-7 flex flex-col items-center text-center xl:items-start xl:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
            <Zap class="w-3.5 h-3.5" />
            Kerala's Premier Digital Studio
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-black leading-[1.1] tracking-tight text-white mb-6">
            <span class="relative inline-block text-primary">
              WordPress
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span> Development Company Kochi
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-neutral-300 mb-8 max-w-2xl font-medium leading-relaxed">
            Custom · Mobile-First · SEO-Ready WordPress Solutions for Kerala Businesses Since 2018. We build WordPress platforms that rank, convert, and scale.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
            <a href="#contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap">
              Book a Free Audit
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href="#services" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white border border-white/20 rounded-full hover:bg-white/5 transition-all duration-300 shadow-sm whitespace-nowrap">
              Explore Our Services
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Hero Graphic (Redesigned Stats Cards Grid) -->
        <div class="xl:col-span-5 grid grid-cols-2 gap-4 sm:gap-6">

          <!-- Card 1 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Rocket class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">120+</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">WordPress Projects</span>
          </div>

          <!-- Card 2 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Calendar class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">2018</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Established</span>
          </div>

          <!-- Card 3 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <TrendingUp class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Page 1</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Google Results</span>
          </div>

          <!-- Card 4 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Globe2 class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Kerala</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Wide Coverage</span>
          </div>

        </div>
      </div>
    </section>

    <!-- INTRO BAND -->
    <section class="py-16 bg-white border-b border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-4xl space-y-5">
          <p class="text-neutral-600 text-base sm:text-lg leading-relaxed font-medium">
            Teknoppy is a professional WordPress development company Kochi delivering custom, mobile-first, SEO-ready WordPress solutions for businesses across Kerala. Since 2018, we have completed 120+ WordPress projects — from focused WordPress web design to large-scale enterprise WordPress development — helping Kerala brands build a strong digital presence and generate consistent leads online.
          </p>
          <p class="text-neutral-600 text-base sm:text-lg leading-relaxed font-medium">
            Every business needs more than a standard website. It needs a fast, credible, search-optimised platform that turns visitors into paying customers. As a dedicated WordPress development company, Teknoppy combines professional WordPress web design with custom development, on-page SEO architecture, structured schema markup, and Core Web Vitals optimisation — so your WordPress site ranks and converts. Our clients include startups, hospitals, real estate firms, restaurants, manufacturers, and established enterprises across Kochi, Thrissur, Calicut, Trivandrum, and the wider Kerala market.
          </p>
        </div>
      </div>
    </section>

    <!-- WHY TEKNOPPY SECTION -->
    <section class="py-24 bg-[#FFF8EF]/30 border-y border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.png')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

          <!-- Left Column (Sticky Panel) -->
          <div class="lg:col-span-5 lg:sticky lg:top-32 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider shadow-sm">
              Trusted Partners
            </div>
            <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
              Why Teknoppy Is the Trusted <br />
              <span class="text-primary">WordPress Development Company Kochi</span>
            </h2>
            <p class="text-neutral-500 font-medium text-sm leading-relaxed max-w-sm">
              We strip away generic templates to engineer custom-built high-performance web platforms designed to rank, scale, and convert visitors into clients.
            </p>
          </div>

          <!-- Right Column (Premium Custom Cards Grid) -->
          <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6 lg:gap-8">

            <!-- Card 1 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">01 . Strategy</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Custom WordPress Development, Not Templates</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Every project begins with custom WordPress architecture mapped to your business goals. Our in-house Kochi team covers WordPress web design, custom development, content structure, on-page SEO, schema markup, and Google Search Console setup — all under one roof.
                </p>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">02 . Expertise</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">AWS-Certified Senior Developer</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Abilash KR, our senior developer, brings AWS certification and 15+ years of WordPress expertise. Every WordPress website is built on proven architecture, secure infrastructure, and performance optimization from day one.
                </p>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">03 . Clarity</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Full Transparency</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Written project timelines, clearly defined revision rounds, real cost estimates, and post-launch support packages. No hidden costs. No vanishing after handover.
                </p>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">04 . Partnership</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">A Local Kochi Team</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Teknoppy is headquartered in Kochi, Kerala — not a remote offshore agency. When you need a meeting, a quick call, or an urgent WordPress update, we are one message away.
                </p>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- OUR WORDPRESS WEB DESIGN SERVICES IN KOCHI -->
    <section id="services" class="py-20 bg-white relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.png')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Services Scope
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            Our <span class="text-primary">WordPress Web Design</span> Services in Kochi
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base sm:text-lg">
            As a full-service WordPress development company in Kochi, Teknoppy delivers the following specialised services.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {services.map(svc => {
            const IconComp = svc.icon;
            return (
              <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col">
                <!-- Left Gradient Stroke -->
