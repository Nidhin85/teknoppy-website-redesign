---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Play, Mail, Phone, Globe2, Smile, Award, Star, CheckCircle, Clock, Heart, Shield, Check, HelpCircle, User, Zap, Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages, MonitorSmartphone, Building2, Edit, ShieldCheck, Search, Layers, Network, Code, Gauge, LayoutGrid, Calendar, TrendingUp } from 'lucide-react';
import page from '../data/pages/wordpress.json';
import { getCollection } from 'astro:content';
import { wordpressSchema } from '../data/schemas/wordpressSchema';

// The source doc names three WordPress posts that are not written yet; the three
// closest live posts stand in for them (see devNotes.blogNote). Resolving by slug
// keeps titles, dates and read times CMS-driven.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const blogPosts = page.blog.items
  .map(item => allPosts.find(post => post.id === item.slug))
  .filter(Boolean)
  .map(post => ({
    title: post!.data.title,
    excerpt: post!.data.excerpt,
    category: post!.data.category,
    readTime: post!.data.readTime,
    date: post!.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }),
    href: `/blog/${post!.id}/`
  }));

const title = page.meta.title;
const description = page.meta.description;

// Icons stay in code and are zipped with the JSON content by index.
const heroStatIcons = [Rocket, Calendar, Clock, Globe2];
// Hero heading: colour the trailing "in Kochi" like the reference (same words, split for styling only).
const heroAfterMatch = page.hero.heading.after.match(/^(.*?)\s*(in Kochi)$/);
const heroAfter = heroAfterMatch ? { lead: heroAfterMatch[1], tail: heroAfterMatch[2] } : { lead: page.hero.heading.after, tail: '' };
const whyIcons = [Zap, Layers, ShieldCheck, Heart];
const statCards = page.hero.statCards.map((card, i) => ({ ...card, icon: heroStatIcons[i] }));

const serviceIcons = [MonitorSmartphone, Code, LayoutGrid, Briefcase, Network, ShieldCheck, Gauge, Shield];
const services = page.services.cards.map((svc, i) => ({ ...svc, icon: serviceIcons[i] }));

const processIcons = [Search, Network, LayoutGrid, Code, Gauge, Rocket];
const processes = page.process.steps.map((proc, i) => ({ ...proc, icon: processIcons[i] }));

const industryIcons = [Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory];
const industries = page.industries.items.map((ind, i) => ({ ...ind, icon: industryIcons[i] }));

// Case-study accent colour classes (kept as full static strings so Tailwind detects them).
const caseAccents = {
  blue: {
    glow: "from-blue-500/20 to-indigo-500/20",
    mesh: "from-blue-500/10 via-transparent to-transparent",
    text: "text-blue-400"
  },
  emerald: {
    glow: "from-emerald-500/20 to-teal-500/20",
    mesh: "from-emerald-500/10 via-transparent to-transparent",
    text: "text-emerald-400"
  }
};
---

<Layout
  title={title}
  description={description}
  floatingCtaLabel="Build With WordPress"
  floatingCtaHref="/request-a-quote/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(wordpressSchema)} />
  </Fragment>

  <Header forceSolidBg={true} />

  <main class="wpd-page overflow-hidden bg-[#fffaf6]">
    <!-- HERO (reference layout: dark band with orange lighting, copy left, glowing 3D WordPress browser right, stats strip below) -->
    <section class="wpd-hero theme-keep-light relative pt-28 sm:pt-32 lg:pt-36 pb-14 sm:pb-16 lg:pb-20 overflow-hidden text-white">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
        <div class="wpd-hero-glow"></div>
        <div class="wpd-hero-arc"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
          <!-- Hero Text -->
          <div class="lg:col-span-6 flex flex-col items-start text-left">
            <nav class="flex flex-wrap items-center gap-2 text-xs font-medium text-white/60 mb-5" aria-label="Breadcrumb">
              <a href="/" class="hover:text-white transition-colors">Home</a>
              <span class="text-neutral-300">›</span>
              <a href="/services/" class="hover:text-white transition-colors">Services</a>
              <span class="text-neutral-300">›</span>
              <span class="text-white font-semibold">WordPress Development Company Kochi</span>
            </nav>
            <div class="wpd-badge mb-5">
              <Zap class="w-3.5 h-3.5 shrink-0" />
              <span>{page.hero.badge}</span>
            </div>
            <h1 class="text-[38px] sm:text-[54px] lg:text-[54px] xl:text-[60px] font-black leading-[1.05] tracking-[-0.035em] text-white mb-6">
              <span class="text-[#ff7a3d]">{page.hero.heading.highlight}</span> {heroAfter.lead}{heroAfter.tail && <span class="text-[#ff7a3d]"> {heroAfter.tail}</span>}
            </h1>
            <p class="text-[15px] sm:text-base lg:text-[17px] text-white/80 mb-8 max-w-xl font-medium leading-relaxed">
              {page.hero.body}
            </p>

            <div class="flex flex-col min-[420px]:flex-row items-stretch min-[420px]:items-center gap-3 sm:gap-4 w-full sm:w-auto">
              <a href={page.hero.ctaPrimary.href} class="inline-flex items-center justify-center gap-2.5 px-7 py-4 text-sm sm:text-base font-bold text-white bg-primary rounded-full shadow-[0_10px_30px_-6px_rgba(240,90,44,0.75)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 leading-snug whitespace-nowrap">
                {page.hero.ctaPrimary.label}
                <ArrowRight class="w-4 h-4" />
              </a>
              <a href={page.hero.ctaSecondary.href} class="inline-flex items-center justify-center gap-3 pl-2.5 pr-7 py-2.5 text-sm sm:text-base font-bold text-neutral-900 bg-white border border-white rounded-full hover:text-primary transition-all duration-300 shadow-sm leading-snug whitespace-nowrap">
                <span class="flex items-center justify-center w-9 h-9 rounded-full bg-primary/10 text-primary shrink-0">
                  <Play class="w-3.5 h-3.5 ml-0.5" fill="currentColor" />
                </span>
                {page.hero.ctaSecondary.label}
              </a>
            </div>
          </div>

          <!-- Hero visual: WordPress browser, orange ring and floating service labels -->
          <div class="lg:col-span-6">
            <div class="wpd-visual relative mx-auto w-full max-w-[600px] lg:max-w-none xl:w-[112%]">
              <picture>
                <source media="(max-width: 767px)" srcset="/images/home/3d/wp-hero-3d-dark-900.webp" />
                <img src="/images/home/3d/wp-hero-3d-dark.webp" alt="3D website browser showing the WordPress logo, with an orange ring and labels for custom development, WooCommerce stores, theme design and support and maintenance" width="1500" height="1034" loading="eager" decoding="async" fetchpriority="high" class="w-full h-auto" />
              </picture>
            </div>
          </div>
        </div>

        <!-- Stats strip -->
        <div class="wpd-stats mt-12 lg:mt-14 grid grid-cols-2 lg:grid-cols-4">
          {statCards.map(card => {
            const IconComp = card.icon;
            return (
              <div class="flex items-center gap-3.5 px-4 sm:px-6 py-4 sm:py-5">
                <span class="w-11 h-11 sm:w-12 sm:h-12 shrink-0 rounded-2xl bg-gradient-to-br from-[#fff1e8] to-[#ffe0cc] text-primary flex items-center justify-center">
                  <IconComp class="w-5 h-5" />
                </span>
                <div class="min-w-0">
                  <span class="block text-xl sm:text-2xl font-black text-neutral-900 leading-none tracking-tight">{card.value}</span>
                  <span class="block text-xs sm:text-[13px] text-neutral-500 font-medium mt-1.5 leading-snug">{card.label}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- INTRO BAND -->
    <section class="py-16 bg-white border-b border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-4xl space-y-5">
          {page.introBand.paragraphs.map(para => (
            <p class="text-neutral-600 text-base sm:text-lg leading-relaxed font-medium">
              {para}
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- WHY TEKNOPPY SECTION -->
    <section class="py-24 bg-cream/30 border-y border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.webp')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-10 sm:mb-12">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider shadow-sm mb-5">
              {page.whyTeknoppy.badge}
            </div>
            <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
              {page.whyTeknoppy.heading.before} <br class="hidden sm:inline" />
              <span class="text-primary">{page.whyTeknoppy.heading.highlight}</span>
            </h2>
          </div>
          <p class="lg:col-span-5 text-neutral-600 font-medium text-base sm:text-[17px] leading-relaxed">
            {page.whyTeknoppy.intro}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          {page.whyTeknoppy.cards.map((card, i) => {
            const WIcon = whyIcons[i] ?? Zap;
            return (
              <div class="wpd-card group p-6 sm:p-7 flex flex-col">
                <span class="wpd-icon mb-5"><WIcon class="w-6 h-6" /></span>
                <span class="text-[11px] font-bold text-primary uppercase tracking-widest block mb-2">{card.tag}</span>
                <h3 class="text-lg font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-2.5 leading-snug">{card.title}</h3>
                <p class="text-neutral-600 text-sm leading-relaxed">{card.description}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- OUR WORDPRESS WEB DESIGN SERVICES IN KOCHI -->
    <section id="services" class="py-20 bg-white relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.webp')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-10 sm:mb-12">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.services.badge}
            </div>
            <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
              {page.services.heading.before} <span class="text-primary">{page.services.heading.highlight}</span> {page.services.heading.after}
            </h2>
          </div>
          <p class="lg:col-span-5 text-neutral-600 font-medium text-base sm:text-lg leading-relaxed">
            {page.services.intro}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 lg:gap-6">
          {services.map(svc => {
            const IconComp = svc.icon;
            const Card = svc.href ? 'a' : 'div';
            return (
              <Card href={svc.href} class="wpd-card group p-6 sm:p-7 flex flex-col">
                <span class="wpd-icon mb-5"><IconComp class="w-6 h-6" /></span>
                <h3 class:list={["text-lg sm:text-[19px] font-bold text-neutral-900 leading-snug mb-2.5", svc.href && "group-hover:text-primary transition-colors duration-300"]}>{svc.title}</h3>
                <p class="text-neutral-600 text-sm sm:text-[15px] leading-relaxed">{svc.desc}</p>
                {svc.href && (
                  <span class="inline-flex items-center gap-1.5 mt-auto pt-5 text-[13px] font-bold text-primary">
                    Learn more <ArrowRight class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" />
                  </span>
                )}
              </Card>
            );
          })}
        </div>
      </div>
    </section>

    <!-- SUB-SERVICES DIRECTORY — links every sub-page built under this pillar -->
    {page.subServices && (
      <section class="py-24 bg-white border-t border-neutral-100 relative">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
          <div class="max-w-3xl mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.subServices.badge}
            </div>
            <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">
              {page.subServices.heading}
            </h2>
            <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">
              {page.subServices.intro}
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            {page.subServices.items.map((item) => (
              <a
                href={item.href}
                class="wpd-card group p-5 sm:p-6 flex items-start justify-between gap-4"
              >
                <span class="min-w-0">
                  <span class="block text-[15px] font-black text-neutral-900 group-hover:text-primary transition-colors leading-snug">{item.title}</span>
                  <span class="block text-neutral-600 text-sm font-medium mt-1.5 leading-relaxed">{item.desc}</span>
                </span>
                <ArrowRight class="w-4 h-4 text-primary flex-shrink-0 mt-0.5 transition-transform duration-300 group-hover:translate-x-1" />
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- WORDPRESS DEVELOPMENT PROCESS SECTION (LIGHT TIMELINE CARDS) -->
    <section class="py-24 bg-warm/40 border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.webp')]" style="opacity: 0.8;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {page.process.badge}
          </div>
          <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
            {page.process.heading.before} <span class="text-primary">{page.process.heading.highlight}</span> {page.process.heading.after}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.process.intro}
          </p>
        </div>

        <ol class="wpd-process relative grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-9 sm:gap-x-6 lg:gap-x-4 z-10">
          {processes.map((proc) => {
            const IconComponent = proc.icon;
            return (
              <li class="group relative flex flex-col items-center text-center">
                <div class="relative z-10 w-16 h-16 rounded-full bg-white border border-primary/15 shadow-[0_18px_36px_-20px_rgba(160,60,20,0.55)] flex items-center justify-center text-primary mb-4 transition-all duration-300 group-hover:bg-primary group-hover:text-white group-hover:-translate-y-1">
                  <IconComponent class="w-6 h-6" />
                </div>
                <span class="text-[11px] font-bold text-primary uppercase tracking-[0.14em] mb-1">Step {proc.step}</span>
                <h3 class="text-base sm:text-lg font-bold text-neutral-900 leading-snug mb-1.5 group-hover:text-primary transition-colors duration-300">{proc.title}</h3>
                <p class="text-neutral-600 text-xs sm:text-[0.84rem] leading-relaxed max-w-[15rem]">{proc.desc}</p>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <!-- PRICING TABLE SECTION -->
    <section class="py-20 bg-white border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/pricingbg.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-5">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.pricing.badge}
            </div>
            <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight mb-4">
              {page.pricing.heading.before} <span class="text-primary">{page.pricing.heading.highlight}</span>
            </h2>
            <p class="text-neutral-600 font-medium text-base max-w-md">
              {page.pricing.intro}
            </p>
          </div>
          <div class="lg:col-span-7">
            <div class="bg-white rounded-[1.75rem] border border-primary/10 overflow-hidden shadow-[0_30px_60px_-36px_rgba(160,60,20,0.45)]">
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="border-b border-neutral-100">
                      <th class="pt-5 pb-3 px-4 sm:px-7 text-[11px] sm:text-xs font-bold text-neutral-400 uppercase tracking-[0.14em]">{page.pricing.tableHead.type}</th>
                      <th class="pt-5 pb-3 px-4 sm:px-7 text-[11px] sm:text-xs font-bold text-neutral-400 uppercase tracking-[0.14em] text-right">{page.pricing.tableHead.price}</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-neutral-100">
                    {page.pricing.rows.map((priceItem) => (
                      <tr class="hover:bg-[#fff8f3] transition-colors">
                        <td class="py-3.5 sm:py-4 px-4 sm:px-7 font-bold text-neutral-900 text-xs sm:text-[0.95rem]">{priceItem.type}</td>
                        <td class="py-3.5 sm:py-4 px-4 sm:px-7 text-right font-bold text-primary text-xs sm:text-[0.95rem] sm:whitespace-nowrap">{priceItem.price}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
            <p class="text-neutral-500 text-xs sm:text-sm mt-4 leading-relaxed font-medium">
              {page.pricing.footnote}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TARGET INDUSTRIES SECTION (DARK AMBER THEME) -->
    <section class="py-20 theme-keep-light bg-neutral-950 text-white border-t border-white/5 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/industriesbg.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          <div class="lg:col-span-4">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/20 border border-amber-500/30 text-amber-400 text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
              {page.industries.badge}
            </div>
            <h2 class="text-3xl md:text-4xl font-black text-white leading-tight">
              <span class="text-[#F9AE42]">{page.industries.heading.highlight}</span> {page.industries.heading.after}
            </h2>
            <p class="text-neutral-400 font-medium mt-3 text-base">
              {page.industries.intro}
            </p>
          </div>
          <div class="lg:col-span-8 grid sm:grid-cols-2 gap-3 sm:gap-4">
            {industries.map(ind => {
              const IconComponent = ind.icon;
              return (
                <div class="bg-white/[0.04] border border-white/10 p-4 sm:p-5 rounded-2xl hover:border-amber-500/40 hover:bg-white/[0.07] transition-all duration-300 flex items-start gap-3.5">
                  <div class="w-10 h-10 rounded-xl bg-primary/20 text-[#ff9a5c] flex items-center justify-center flex-shrink-0">
                    <IconComponent class="w-5 h-5" />
                  </div>
                  <div class="min-w-0">
                    <h3 class="text-[15px] font-bold text-white mb-1">{ind.name}</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed">{ind.desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <!-- CASE STUDIES SECTION (PORTFOLIO STYLE) -->
    <section class="py-24 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mb-20">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[12px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            {page.caseStudies.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {page.caseStudies.heading.before} <span class="text-primary">{page.caseStudies.heading.highlight}</span> {page.caseStudies.heading.after}
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            {page.caseStudies.intro}
          </p>
        </div>

        <div class="space-y-24">
          {page.caseStudies.blocks.map((cs, idx) => {
            const accent = caseAccents[cs.accent];
            return (
              <div class={`flex flex-col ${idx % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'} items-center gap-12 lg:gap-16 group relative`}>
                {/* Left: Mockup Window */}
                <div class="w-full lg:w-[48%] relative z-10">
                  {/* Glow */}
                  <div class={`absolute inset-0 bg-gradient-to-tr ${accent.glow} rounded-[2rem] scale-105 opacity-0 group-hover:opacity-100 transition-all duration-700 blur-xl`}></div>

                  {/* Browser */}
                  <div class="relative bg-white rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-neutral-100 overflow-hidden transform group-hover:-translate-y-1.5 transition-all duration-500">
                    <div class="h-10 bg-neutral-50 border-b border-neutral-100/80 flex items-center px-4 gap-2">
                      <div class="w-3 h-3 rounded-full bg-[#FF5F56]"></div>
                      <div class="w-3 h-3 rounded-full bg-[#FFBD2E]"></div>
                      <div class="w-3 h-3 rounded-full bg-[#27C93F]"></div>
                      {cs.site && <span class="ml-3 text-[13px] font-semibold text-neutral-400 truncate">{cs.site}</span>}
                    </div>
                    {cs.image
                      ? <img
                          src={cs.image}
                          alt={cs.imageAlt}
                          width="1440"
                          height="900"
                          loading="lazy"
                          decoding="async"
                          class="w-full aspect-[16/10] object-cover object-top block"
                        />
                      : (
                      <div class="aspect-[16/10] theme-keep-light bg-[#0c0c0e] relative overflow-hidden flex flex-col items-center justify-center p-8 text-center">
                        {/* Abstract mesh */}
                        <div class={`absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] ${accent.mesh}`}></div>
                        <span class={`text-xs font-black ${accent.text} uppercase tracking-widest mb-3`}>{cs.tag}</span>
                        <span class="text-4xl sm:text-5xl font-black text-white leading-none mb-3">{cs.metric}</span>
                        <span class="text-xs text-neutral-400 uppercase tracking-wider font-semibold">{cs.metricSub}</span>
                      </div>
                      )}
                  </div>
                </div>

                {/* Right: Content */}
                <div class="w-full lg:w-[52%] space-y-6">
                  <div>
                    <span class="text-xs font-black text-primary uppercase tracking-widest">{cs.label}</span>
                    <h3 class="text-2xl font-black text-neutral-900 mt-1">{cs.title}</h3>
                  </div>
                  <p class="text-sm text-neutral-500 leading-relaxed font-medium">
                    {cs.intro}
                  </p>

                  <div class="grid sm:grid-cols-2 gap-4">
                    <div class="bg-neutral-50/50 rounded-2xl p-5 border border-neutral-100">
                      <h4 class="text-xs font-black text-neutral-900 uppercase tracking-wider mb-2">Our Approach</h4>
                      <ul class="space-y-1.5 text-xs text-neutral-500 font-semibold list-disc pl-4">
                        {cs.approach.map(item => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-neutral-50/50 rounded-2xl p-5 border border-neutral-100">
                      <h4 class="text-xs font-black text-neutral-900 uppercase tracking-wider mb-2">The Results</h4>
                      <ul class="space-y-1.5 text-xs text-neutral-500 font-semibold list-disc pl-4">
                        {cs.results.map(item => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  {/* Testimonial Quote */}
                  <div class="border-l-4 border-primary pl-4 py-1.5 bg-cream/30 rounded-r-2xl">
                    <p class="text-xs text-neutral-600 font-medium italic leading-relaxed">
                      "{cs.quote}"
                    </p>
                    <span class="block text-xs font-black text-neutral-900 mt-2">{cs.author}</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
