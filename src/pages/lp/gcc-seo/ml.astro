<style is:inline>
:root{--o:#F26522;--o2:#D4500F;--y:#FFC629;--y2:#FFF4CC;--k:#111111;--k2:#2B2B2B;--g:#5C5C5C;--line:#ECE7DF;--bg:#FFFFFF;--cream:#FFFAF2;--wa:#128C4A;--neu-flat:6px 6px 18px rgba(17,17,17,0.06), -6px -6px 18px rgba(255,255,255,0.95);--neu-hover:10px 14px 28px rgba(17,17,17,0.1), -8px -8px 22px rgba(255,255,255,1);--neu-inset:inset 2px 2px 5px rgba(17,17,17,0.06), inset -2px -2px 5px rgba(255,255,255,0.85);--neu-dark:8px 8px 24px rgba(0,0,0,0.5), -4px -4px 16px rgba(43,43,43,0.3);--neu-dark-hover:12px 14px 30px rgba(0,0,0,0.65), -6px -6px 20px rgba(43,43,43,0.45)}
body{margin:0;background:#FFFFFF}
*{box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:clip}
body{overflow-x:clip}
a{color:#D4500F}a:hover{color:#A93D08}
.page{font-family:'Plus Jakarta Sans','Noto Sans Malayalam',sans-serif;color:#111111;background:#FFFFFF;line-height:1.6;font-size:16px;overflow-x:clip}
.wrap{max-width:1220px;margin:0 auto;padding:0 24px}
.disp{font-family:Sora,'Noto Sans Malayalam',sans-serif;letter-spacing:-0.5px}
.eyebrow{display:inline-flex;align-items:center;gap:8px;margin:0 0 14px;font-weight:800;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#B8440C}
.eyebrow::before{content:"";width:22px;height:3px;border-radius:3px;background:#F26522}
.h2{margin:0 0 14px;font-size:42px;line-height:1.2;color:#111111}
.lead{margin:0;color:#4A4A4A;font-size:18px}
.sec{padding:100px 0}
.center{text-align:center;max-width:780px;margin:0 auto 52px}
.center .eyebrow{justify-content:center}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;padding:0 28px;border-radius:999px;font-weight:800;font-size:16px;text-decoration:none;border:none;cursor:pointer;font-family:inherit;transition:transform .2s ease,box-shadow .2s ease,background .2s ease}
.btn:hover{transform:translateY(-2px)}
.btn-o{background:#F26522;color:#fff;box-shadow:0 10px 24px -10px rgba(242,101,34,.7)}.btn-o:hover{background:#D4500F;color:#fff}
.btn-k{background:#111111;color:#fff}.btn-k:hover{background:#2B2B2B;color:#fff}
.btn-wa{background:#128C4A;color:#fff}.btn-wa:hover{background:#0E7039;color:#fff}
.btn-y{background:#FFC629;color:#111}.btn-y:hover{background:#FFB800;color:#111}
.btn-ln{background:#fff;color:#111;border:2px solid #111}.btn-ln:hover{color:#111}
.g2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.g3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.g4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.card{background:#fff;border:1.5px solid #ECE7DF;border-radius:22px;padding:28px;box-shadow:var(--neu-flat);transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease}
.card:hover{transform:translateY(-6px);box-shadow:var(--neu-hover);border-color:#F26522}

/* header */
.hdr{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.95);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid #F1ECE4}
.hdr .wrap{display:flex;justify-content:space-between;align-items:center;height:74px;gap:16px}
.logo{display:inline-flex;align-items:center;text-decoration:none}
.logo img{height:38px;width:auto;display:block;object-fit:contain}
.nav{display:flex;gap:28px}
.nav a{color:#111;text-decoration:none;font-weight:700;font-size:15px;position:relative}
.nav a::after{content:"";position:absolute;left:0;bottom:-4px;height:2px;width:0;background:#F26522;transition:width .25s}
.nav a:hover::after{width:100%}

/* hero */
.hero{position:relative;padding:76px 0 90px;background:#FFFAF2;overflow:hidden}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:56px;align-items:center}
.blob{position:absolute;border-radius:50%;filter:blur(2px);z-index:1}
.b1{width:520px;height:520px;right:-140px;top:-160px;background:#FFC629;opacity:.55;animation:float1 14s ease-in-out infinite}
.b2{width:300px;height:300px;right:28%;bottom:-160px;background:#F26522;opacity:.18;animation:float2 11s ease-in-out infinite}
.b3{width:14px;height:14px;left:6%;top:22%;background:#F26522;animation:float2 6s ease-in-out infinite}
.b4{width:22px;height:22px;left:44%;top:12%;background:#111;opacity:.9;animation:float1 8s ease-in-out infinite}
.dots{position:absolute;inset:0;z-index:1;background-image:radial-gradient(#E7DCCB 1.2px,transparent 1.2px);background-size:22px 22px;opacity:.6;-webkit-mask-image:linear-gradient(90deg,#000 0,transparent 55%);mask-image:linear-gradient(90deg,#000 0,transparent 55%)}
@keyframes float1{0%,100%{transform:translate(0,0)}50%{transform:translate(-30px,26px)}}
@keyframes float2{0%,100%{transform:translate(0,0)}50%{transform:translate(24px,-22px)}}
.pill{display:inline-flex;align-items:center;gap:10px;padding:8px 16px 8px 8px;border-radius:999px;background:#111;color:#fff;font-weight:700;font-size:14px;margin-bottom:22px}
.pill b{background:#FFC629;color:#111;border-radius:999px;padding:3px 10px;font-size:12px;letter-spacing:.5px}
.h1{margin:0 0 20px;font-size:60px;line-height:1.12;font-weight:800;color:#111}
.hl{position:relative;white-space:nowrap;color:#111}
.hl::after{content:"";position:absolute;left:-4px;right:-4px;bottom:6px;height:18px;background:#FFC629;z-index:-1;border-radius:6px;transform-origin:left;animation:mark 1s .5s cubic-bezier(.2,.8,.2,1) both}
.hl-wrap{position:relative;z-index:0;display:inline-block}
@keyframes mark{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.sub{margin:0 0 28px;font-size:19px;color:#3D3D3D;max-width:580px}
.ctas{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:28px}
.proof{display:flex;flex-wrap:wrap;gap:22px;align-items:center;font-size:15px;color:#3D3D3D}
.stars{color:#F5A300;letter-spacing:2px}
.pulse{position:relative}
.pulse::before{content:"";position:absolute;inset:0;border-radius:999px;box-shadow:0 0 0 0 rgba(18,140,74,.55);animation:pulse 2.2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(18,140,74,.55)}70%{box-shadow:0 0 0 16px rgba(18,140,74,0)}100%{box-shadow:0 0 0 0 rgba(18,140,74,0)}}

/* hero video banner */
.hero-full-wrap{width:100%;margin:0;padding:0;position:relative;overflow:hidden;background:#000}
.hero-video-banner{width:100%;margin:0;padding:0;position:relative;background:#000;overflow:hidden;line-height:0}
.hero-video-banner video{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;object-position:center center;display:block;border:0;margin:0;padding:0}
.video-controls-badge{position:absolute;bottom:clamp(12px,2.5vw,24px);right:clamp(14px,3vw,32px);display:flex;align-items:center;gap:10px;padding:7px 14px;border-radius:999px;background:rgba(17,17,17,0.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,0.22);color:#fff;font-size:0.82rem;font-weight:700;z-index:10;box-shadow:0 6px 18px rgba(0,0,0,0.45);transition:transform .2s}
.video-controls-badge:hover{transform:scale(1.02)}
.vc-left{display:flex;align-items:center;gap:8px}
.vc-pill{background:#F26522;color:#fff;font-size:0.68rem;font-weight:800;padding:3px 8px;border-radius:999px;letter-spacing:0.04em;text-transform:uppercase}
.vc-title{color:#F3F3F3;font-size:0.78rem}
.vc-actions{display:flex;align-items:center;gap:6px;margin-left:4px}
.vc-btn{background:rgba(255,255,255,0.14);border:1px solid rgba(255,255,255,0.25);color:#fff;font-size:0.75rem;font-weight:700;padding:4px 10px;border-radius:999px;cursor:pointer;display:inline-flex;align-items:center;gap:4px;transition:background .2s;font-family:inherit}
.vc-btn:hover{background:rgba(255,255,255,0.28)}

/* Hero proof card (SERP simulation) */
.proof-wrap{position:relative;min-width:0}
.proof-card{background:#fff;border:1.5px solid #111;border-radius:24px;box-shadow:10px 10px 0 #111;overflow:hidden}
.proof-top{min-width:0;display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid #ECE7DF;background:#FAF8F5}
.dots-top{display:flex;gap:6px}.dots-top i{width:10px;height:10px;border-radius:50%;background:#E3DED7;display:inline-block}
.proof-top .label{font-size:12px;font-weight:700;color:#5C5C5C;letter-spacing:.05em;text-transform:uppercase}
.live{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#128C4A}
.live::before{content:"";width:8px;height:8px;border-radius:50%;background:#128C4A;animation:pulse-live 1.6s infinite}
@keyframes pulse-live{0%{box-shadow:0 0 0 0 rgba(18,140,74,.5)}100%{box-shadow:0 0 0 10px rgba(18,140,74,0)}}
.proof-body{padding:22px 22px 8px}
.gs-head{display:flex;align-items:center;gap:14px}
.gs-brand{display:inline-flex;align-items:center;gap:8px;font-family:Arial,Helvetica,sans-serif;font-size:24px;font-weight:700;letter-spacing:-.5px;color:#5F6368;flex:none}
.gs-brand img{width:26px;height:26px;flex:none}
.gs-head .search{flex:1;min-width:0;display:flex;align-items:center;justify-content:space-between;border:1px solid #DFDAD3;border-radius:999px;padding:12px 18px;font-size:16px;font-weight:500;box-shadow:0 1px 6px rgba(32,33,36,.18);margin-bottom:0}
.gs-head .search .q{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#202124}
.caret{display:inline-block;width:2px;height:18px;background:#111;margin-left:2px;vertical-align:middle;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.gs-tabs{display:flex;gap:18px;margin:14px 0 0;padding-left:2px;border-bottom:1px solid #EBEBEB;font-family:Arial,sans-serif;font-size:13px;color:#5F6368}
.gs-tabs span{padding-bottom:9px}
.gs-tabs .on{color:#1A73E8;border-bottom:3px solid #1A73E8;font-weight:700}
.gs-count{font-family:Arial,sans-serif;font-size:12px;color:#70757A;margin-top:10px}
.gs-count b{font-weight:700;color:#5F6368}
.proof-card .serp{margin-top:10px;display:grid;gap:10px;border:none;box-shadow:none;padding:0;animation:none}
.proof-card .res{display:grid;grid-template-columns:1fr auto;align-items:start;font-family:Arial,sans-serif;gap:14px;padding:14px;border-radius:14px}
.proof-card .res.win{background:#FFF4CC;border:1.5px solid #FFC629}
.proof-card .res.win .pos{width:auto;height:auto;padding:6px 12px;border-radius:999px;font-size:14px;background:#111;color:#FFC629;font-weight:800;transition:transform .3s}
.proof-card .res.win .pos.bump{transform:scale(1.18)}
.proof-card .res.ghost{opacity:.7;padding:10px 14px}
.proof-card .res.ghost .pos{width:auto;height:auto;padding:6px 12px;border-radius:999px;font-size:12px;background:#F3F0EC;color:#B9B2A8}
.proof-card .sk{height:9px;border-radius:9px;background:#F0ECE7;margin:5px 0}
.site{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.fav{width:28px;height:28px;flex:none;border-radius:50%;background:#fff;border:1px solid #DADCE0;display:grid;place-items:center;font-weight:800;font-size:13px;color:#F26522}
.site b{display:block;font-size:14px;font-weight:600;color:#202124;line-height:1.2}
.proof-card .res .url{display:block;font-size:12px;color:#4D5156;line-height:1.3}
.proof-card .res .title{font-size:18px;font-weight:700;color:#1A0DAB;line-height:1.3}
.proof-card .res .desc{font-size:13.5px;color:#4D5156;margin-top:3px}
.fade{transition:opacity .35s}
.fade.out{opacity:0}
.proof-foot{display:grid;grid-template-columns:1fr 1.25fr;gap:16px;align-items:end;padding:18px 22px 22px;border-top:1px dashed #ECE7DF;margin-top:14px}
.metric small{display:block;font-size:13px;color:#5C5C5C;font-weight:600}
.metric .big{font-size:42px;font-weight:800;line-height:1.1;font-family:Sora,sans-serif}
.metric .big em{font-style:normal;color:#F26522}
.metric .client{display:inline-block;margin-top:6px;font-size:12px;font-weight:700;background:#F3F0EC;border-radius:999px;padding:4px 10px}
.chart svg{width:100%;height:auto;display:block}
.chart .ax{font-size:10px;fill:#9A938A;font-family:inherit}
.proof-chips{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:0 22px 22px}
.proof-chips div{border:1px solid #ECE7DF;border-radius:14px;padding:10px 8px;text-align:center;background:#FFFDFB}
.proof-chips b{display:block;font-size:20px;font-weight:800;line-height:1.1;font-family:Sora,sans-serif}
.proof-chips b em{font-style:normal;color:#F26522}
.proof-chips span{display:block;font-size:11.5px;color:#5C5C5C;font-weight:600;margin-top:4px;line-height:1.3}
.kw-dots{display:flex;justify-content:center;gap:8px;margin-top:20px}
.kw-dots button{width:10px;height:10px;border-radius:999px;border:0;background:#DCD5CC;cursor:pointer;transition:.3s;padding:0}
.kw-dots button.on{width:30px;background:#F26522}
.proof-caption{text-align:center;font-size:13px;color:#5C5C5C;margin-top:10px;font-weight:600}

/* marquee */
.mq{background:#111;color:#fff;overflow:hidden;padding:18px 0;border-top:4px solid #FFC629}
.mq-track{display:flex;gap:48px;width:max-content;animation:scroll 32s linear infinite}
.mq-track span{font-family:Sora,sans-serif;font-weight:700;font-size:20px;white-space:nowrap;display:flex;align-items:center;gap:48px}
.mq-track span::after{content:"✦";color:#F26522}
@keyframes scroll{to{transform:translateX(-50%)}}

/* stats */
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border:1.5px solid #111;border-radius:24px;overflow:hidden;background:#fff;margin-top:-1px;box-shadow:var(--neu-flat)}
.stat{padding:30px 24px;border-right:1.5px solid #111;text-align:center}
.stat:last-child{border-right:none}
.stat .n{font-family:Sora,sans-serif;font-size:44px;font-weight:800;line-height:1.1;color:#111}
.stat .n i{font-style:normal;color:#F26522}
.stat .l{color:#5C5C5C;font-weight:600}

/* Results section (redesigned) */
.results{background:#fff;border-block:1px solid #ECE7DF}
.rk-grid{margin-top:44px;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:stretch}
.rk{background:#fff;border:1.5px solid #111;border-radius:24px;box-shadow:8px 8px 0 #111;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}
.rk:hover{transform:translate(-3px,-3px);box-shadow:11px 11px 0 #111}
.rk-head{background:#23245E;color:#fff;padding:22px 22px 20px;position:relative;overflow:hidden}
.rk-head::after{content:"#1";position:absolute;right:-6px;top:-30px;font-size:120px;font-weight:800;line-height:1;color:rgba(255,255,255,.05);pointer-events:none;font-family:Sora,sans-serif}
.rk-meta{display:flex;justify-content:space-between;align-items:center;gap:10px;position:relative;z-index:1}
.rk-mk{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#C9CAF0}
.rk-mk i{font-style:normal;font-size:16px;letter-spacing:0}
.rk-badge{background:#FFC629;color:#111;font-weight:800;font-size:12px;padding:5px 10px;border-radius:999px;white-space:nowrap}
.rk-name{font-size:21px;font-weight:800;margin-top:12px;position:relative;z-index:1;font-family:Sora,'Noto Sans Malayalam',sans-serif}
.rk-grow{display:flex;align-items:baseline;gap:8px;margin-top:10px;position:relative;z-index:1}
.rk-grow b{font-size:32px;font-weight:800;line-height:1;color:#FFC629;font-family:Sora,sans-serif}
.rk-grow span{font-size:13px;color:#C9CAF0;font-weight:600}
.rk-th{display:flex;justify-content:space-between;padding:16px 22px 6px;font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#5C5C5C}
.rk-list{list-style:none;padding:0 12px 14px;flex:1;margin:0}
.rk-list li{display:flex;align-items:center;gap:12px;padding:11px 10px;border-radius:12px;font-weight:600;font-size:15px;line-height:1.35}
.rk-list li:nth-child(odd){background:#FAF8F5}
.rk-list .g{width:18px;height:18px;flex:none}
.rk-list .k{flex:1;min-width:0;color:#111}
.rk-list .p{flex:none;min-width:40px;height:30px;display:grid;place-items:center;border-radius:9px;background:#FFC629;color:#111;font-weight:800;font-size:14px;box-shadow:0 4px 12px -5px rgba(255,199,44,.9)}
.rk-sum{display:flex;justify-content:center;margin-top:30px}
.rk-sum > span{display:inline-flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;background:#FFF4CC;border:1.5px solid #FFC629;border-radius:999px;padding:10px 20px;font-weight:700;font-size:15px}
.rk-sum b{color:#F26522}
.results-cta{text-align:center;margin-top:40px}

/* problem vs promise */
.split{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-radius:28px;overflow:hidden;border:1.5px solid #111;box-shadow:var(--neu-flat)}
.split > div{padding:44px}
.pain{background:#fff}
.gain{background:#111;color:#fff;box-shadow:var(--neu-dark)}
.li{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid #EFEAE2;font-size:17px}
.gain .li{border-color:#2B2B2B}
.li:last-child{border-bottom:none}
.ic{flex:none;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px}
.ic.x{background:#FFE7DD;color:#B8440C}
.ic.ok{background:#FFC629;color:#111}

/* services */
.svc .ico{width:52px;height:52px;border-radius:16px;background:#FFF4CC;color:#111;display:flex;align-items:center;justify-content:center;margin-bottom:16px;box-shadow:3px 3px 8px rgba(242,101,34,.12), -2px -2px 6px rgba(255,255,255,.95);transition:background .3s,transform .3s}
.svc:hover .ico{background:#F26522;color:#fff;transform:rotate(-8deg)}
.svc h3{margin:0 0 6px;font-family:Sora,sans-serif;font-size:19px}
.svc p{margin:0;color:#5C5C5C;font-size:15px}

/* process */
.track{position:relative;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:14px}
.track::before{content:"";position:absolute;left:4%;right:4%;top:28px;height:3px;background:repeating-linear-gradient(90deg,#111 0 10px,transparent 10px 18px)}
.step{position:relative;text-align:center}
