<style is:inline>
:root{--o:#F26522;--o2:#D4500F;--y:#FFC629;--y2:#FFF4CC;--k:#111111;--k2:#2B2B2B;--g:#5C5C5C;--line:#ECE7DF;--bg:#FFFFFF;--cream:#FFFAF2;--wa:#128C4A;--neu-flat:6px 6px 18px rgba(17,17,17,0.06), -6px -6px 18px rgba(255,255,255,0.95);--neu-hover:10px 14px 28px rgba(17,17,17,0.1), -8px -8px 22px rgba(255,255,255,1);--neu-inset:inset 2px 2px 5px rgba(17,17,17,0.06), inset -2px -2px 5px rgba(255,255,255,0.85);--neu-dark:8px 8px 24px rgba(0,0,0,0.5), -4px -4px 16px rgba(43,43,43,0.3);--neu-dark-hover:12px 14px 30px rgba(0,0,0,0.65), -6px -6px 20px rgba(43,43,43,0.45)}
body{margin:0;background:#FFFFFF}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
a{color:#D4500F}a:hover{color:#A93D08}
.page{font-family:'Plus Jakarta Sans','Noto Sans Malayalam',sans-serif;color:#111111;background:#FFFFFF;line-height:1.6;font-size:16px;overflow-x:hidden}
.wrap{max-width:1220px;margin:0 auto;padding:0 24px}
.disp{font-family:Sora,'Noto Sans Malayalam',sans-serif;letter-spacing:-0.5px}
.eyebrow{display:inline-flex;align-items:center;gap:8px;margin:0 0 14px;font-weight:800;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#B8440C}
.eyebrow::before{content:"";width:22px;height:3px;border-radius:3px;background:#F26522}
.h2{margin:0 0 14px;font-size:42px;line-height:1.2;color:#111111}
.lead{margin:0;color:#4A4A4A;font-size:18px}
.sec{padding:100px 0}
.center{text-align:center;max-width:780px;margin:0 auto 52px}
.center .eyebrow{justify-content:center}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;padding:0 28px;border-radius:999px;font-weight:800;font-size:16px;text-decoration:none;border:none;cursor:pointer;font-family:inherit;transition:transform .2s ease,box-shadow .2s ease,background .2s ease}
.btn:hover{transform:translateY(-2px)}
.btn-o{background:#F26522;color:#fff;box-shadow:0 10px 24px -10px rgba(242,101,34,.7)}.btn-o:hover{background:#D4500F;color:#fff}
.btn-k{background:#111111;color:#fff}.btn-k:hover{background:#2B2B2B;color:#fff}
.btn-wa{background:#128C4A;color:#fff}.btn-wa:hover{background:#0E7039;color:#fff}
.btn-y{background:#FFC629;color:#111}.btn-y:hover{background:#FFB800;color:#111}
.btn-ln{background:#fff;color:#111;border:2px solid #111}.btn-ln:hover{color:#111}
.g2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.g3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.g4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.card{background:#fff;border:1.5px solid #ECE7DF;border-radius:22px;padding:28px;box-shadow:var(--neu-flat);transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease}
.card:hover{transform:translateY(-6px);box-shadow:var(--neu-hover);border-color:#F26522}

/* header */
.hdr{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid #F1ECE4}
.hdr .wrap{display:flex;justify-content:space-between;align-items:center;height:74px;gap:16px}
.logo{display:inline-flex;align-items:center;text-decoration:none}
.logo img{height:38px;width:auto;display:block;object-fit:contain}
.nav{display:flex;gap:28px}
.nav a{color:#111;text-decoration:none;font-weight:700;font-size:15px;position:relative}
.nav a::after{content:"";position:absolute;left:0;bottom:-4px;height:2px;width:0;background:#F26522;transition:width .25s}
.nav a:hover::after{width:100%}

/* hero */
.hero{position:relative;padding:76px 0 90px;background:#FFFAF2;overflow:hidden}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:56px;align-items:center}
.blob{position:absolute;border-radius:50%;filter:blur(2px);z-index:1}
.b1{width:520px;height:520px;right:-140px;top:-160px;background:#FFC629;opacity:.55;animation:float1 14s ease-in-out infinite}
.b2{width:300px;height:300px;right:28%;bottom:-160px;background:#F26522;opacity:.18;animation:float2 11s ease-in-out infinite}
.b3{width:14px;height:14px;left:6%;top:22%;background:#F26522;animation:float2 6s ease-in-out infinite}
.b4{width:22px;height:22px;left:44%;top:12%;background:#111;opacity:.9;animation:float1 8s ease-in-out infinite}
.dots{position:absolute;inset:0;z-index:1;background-image:radial-gradient(#E7DCCB 1.2px,transparent 1.2px);background-size:22px 22px;opacity:.6;-webkit-mask-image:linear-gradient(90deg,#000 0,transparent 55%);mask-image:linear-gradient(90deg,#000 0,transparent 55%)}
@keyframes float1{0%,100%{transform:translate(0,0)}50%{transform:translate(-30px,26px)}}
@keyframes float2{0%,100%{transform:translate(0,0)}50%{transform:translate(24px,-22px)}}
.pill{display:inline-flex;align-items:center;gap:10px;padding:8px 16px 8px 8px;border-radius:999px;background:#111;color:#fff;font-weight:700;font-size:14px;margin-bottom:22px}
.pill b{background:#FFC629;color:#111;border-radius:999px;padding:3px 10px;font-size:12px;letter-spacing:.5px}
.h1{margin:0 0 20px;font-size:60px;line-height:1.12;font-weight:800;color:#111}
.hl{position:relative;white-space:nowrap;color:#111}
.hl::after{content:"";position:absolute;left:-4px;right:-4px;bottom:6px;height:18px;background:#FFC629;z-index:-1;border-radius:6px;transform-origin:left;animation:mark 1s .5s cubic-bezier(.2,.8,.2,1) both}
.hl-wrap{position:relative;z-index:0;display:inline-block}
@keyframes mark{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.sub{margin:0 0 28px;font-size:19px;color:#3D3D3D;max-width:580px}
.ctas{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:28px}
.proof{display:flex;flex-wrap:wrap;gap:22px;align-items:center;font-size:15px;color:#3D3D3D}
.stars{color:#F5A300;letter-spacing:2px}
.pulse{position:relative}
.pulse::before{content:"";position:absolute;inset:0;border-radius:999px;box-shadow:0 0 0 0 rgba(18,140,74,.55);animation:pulse 2.2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(18,140,74,.55)}70%{box-shadow:0 0 0 16px rgba(18,140,74,0)}100%{box-shadow:0 0 0 0 rgba(18,140,74,0)}}

/* hero visual */
.viz{position:relative}
.serp{background:#fff;border-radius:24px;padding:24px;border:1.5px solid #111;box-shadow:12px 12px 0 #111;animation:rise .9s .2s cubic-bezier(.2,.8,.2,1) both}
@keyframes rise{from{opacity:0;transform:translateY(40px) rotate(-2deg)}to{opacity:1;transform:none}}
.search{display:flex;align-items:center;gap:10px;padding:12px 16px;border:1.5px solid #E2DCD2;border-radius:999px;margin-bottom:18px;font-size:15px}
.caret{display:inline-block;width:2px;height:18px;background:#111;margin-left:2px;vertical-align:middle;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.typing{display:inline-block;overflow:hidden;white-space:nowrap;vertical-align:middle;animation:type 2.2s .8s steps(24) both}
@keyframes type{from{width:0}to{width:24ch}}
.res{display:flex;gap:14px;align-items:flex-start;border-radius:16px;padding:14px 16px}
.res.win{background:#FFF4CC;border:1.5px solid #FFC629}
.rank{flex:none;width:58px;height:58px;border-radius:14px;background:#111;color:#fff;overflow:hidden;position:relative;font-family:Sora,sans-serif;font-weight:800;font-size:24px}
.rank .col{position:absolute;left:0;right:0;top:0;display:flex;flex-direction:column;animation:climb 3.2s 1.2s cubic-bezier(.6,0,.2,1) both}
.rank .col span{height:58px;display:flex;align-items:center;justify-content:center}
.rank .col span:last-child{color:#FFC629}
@keyframes climb{0%{transform:translateY(0)}30%{transform:translateY(-58px)}60%{transform:translateY(-116px)}100%{transform:translateY(-174px)}}
.ghost{height:10px;border-radius:6px;background:#EEE9E1;margin-bottom:8px}
.chart{margin-top:16px;padding-top:16px;border-top:1px dashed #E2DCD2}
.chart .row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px;font-size:14px;color:#5C5C5C}
.chart .big{font-family:Sora,sans-serif;font-size:30px;font-weight:800;color:#111}
.chart .big em{font-style:normal;color:#F26522}
.line{stroke-dasharray:420;stroke-dashoffset:420;animation:draw 2.4s 1.4s ease forwards}
.area{opacity:0;animation:fade 1s 3s ease forwards}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes fade{to{opacity:1}}
.chip{position:absolute;background:#fff;border:1.5px solid #111;border-radius:14px;padding:10px 14px;font-weight:800;font-size:14px;box-shadow:5px 5px 0 #111;display:flex;align-items:center;gap:8px}
.chip1{left:-34px;top:38%;animation:bob 4s ease-in-out infinite}
.chip2{right:-18px;bottom:-22px;background:#FFC629;animation:bob 5s 1s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

/* marquee */
.mq{background:#111;color:#fff;overflow:hidden;padding:18px 0;border-top:4px solid #FFC629}
.mq-track{display:flex;gap:48px;width:max-content;animation:scroll 32s linear infinite}
.mq-track span{font-family:Sora,sans-serif;font-weight:700;font-size:20px;white-space:nowrap;display:flex;align-items:center;gap:48px}
.mq-track span::after{content:"✦";color:#F26522}
@keyframes scroll{to{transform:translateX(-50%)}}

/* stats */
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border:1.5px solid #111;border-radius:24px;overflow:hidden;background:#fff;margin-top:-1px;box-shadow:var(--neu-flat)}
.stat{padding:30px 24px;border-right:1.5px solid #111;text-align:center}
.stat:last-child{border-right:none}
.stat .n{font-family:Sora,sans-serif;font-size:44px;font-weight:800;line-height:1.1;color:#111}
.stat .n i{font-style:normal;color:#F26522}
.stat .l{color:#5C5C5C;font-weight:600}

/* results */
.rcard{position:relative;overflow:hidden}
.rcard .tag{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.loc{font-size:13px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;color:#5C5C5C}
.no1{background:#FFC629;color:#111;font-family:Sora,sans-serif;font-weight:800;padding:4px 12px;border-radius:10px}
.kw{background:#FFFAF2;border:1.5px dashed #E2CDB4;border-radius:12px;padding:10px 14px;font-weight:700;margin:12px 0 18px}
.bar{height:12px;background:#F4EFE7;border-radius:8px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:8px;background:linear-gradient(90deg,#FFC629,#F26522);transform-origin:left;transform:scaleX(0);transition:transform 1.6s cubic-bezier(.2,.8,.2,1)}
.rv.in .bar i,.no-js .bar i{transform:scaleX(1)}
.growth{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px}
.growth b{font-family:Sora,sans-serif;font-size:28px;color:#111}

/* problem vs promise */
.split{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-radius:28px;overflow:hidden;border:1.5px solid #111;box-shadow:var(--neu-flat)}
.split > div{padding:44px}
.pain{background:#fff}
.gain{background:#111;color:#fff;box-shadow:var(--neu-dark)}
.li{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid #EFEAE2;font-size:17px}
.gain .li{border-color:#2B2B2B}
.li:last-child{border-bottom:none}
.ic{flex:none;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px}
.ic.x{background:#FFE7DD;color:#B8440C}
.ic.ok{background:#FFC629;color:#111}

/* services */
.svc .ico{width:52px;height:52px;border-radius:16px;background:#FFF4CC;color:#111;display:flex;align-items:center;justify-content:center;margin-bottom:16px;box-shadow:3px 3px 8px rgba(242,101,34,.12), -2px -2px 6px rgba(255,255,255,.95);transition:background .3s,transform .3s}
.svc:hover .ico{background:#F26522;color:#fff;transform:rotate(-8deg)}
.svc h3{margin:0 0 6px;font-family:Sora,sans-serif;font-size:19px}
.svc p{margin:0;color:#5C5C5C;font-size:15px}

/* process */
.track{position:relative;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:14px}
.track::before{content:"";position:absolute;left:4%;right:4%;top:28px;height:3px;background:repeating-linear-gradient(90deg,#111 0 10px,transparent 10px 18px)}
.step{position:relative;text-align:center}
.dot{width:58px;height:58px;margin:0 auto 14px;border-radius:50%;background:#fff;border:2px solid #111;display:flex;align-items:center;justify-content:center;font-family:Sora,sans-serif;font-weight:800;position:relative;z-index:1;box-shadow:4px 4px 12px rgba(17,17,17,.08), -3px -3px 8px rgba(255,255,255,.9);transition:background .3s,color .3s,box-shadow .3s}
.step:hover .dot{background:#F26522;color:#fff;border-color:#F26522}
.step.last .dot{background:#FFC629}
.step b{display:block;font-size:15px}
.step span{display:block;font-size:13px;color:#5C5C5C}

/* audit includes */
.audit{background:#FFC629;border-radius:32px;padding:56px;position:relative;overflow:hidden;box-shadow:10px 10px 30px rgba(242,101,34,.15), -8px -8px 24px rgba(255,255,255,.8)}
.audit::after{content:"";position:absolute;width:340px;height:340px;border-radius:50%;border:40px solid rgba(242,101,34,.25);right:-110px;top:-110px;animation:spin 30s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.chk{display:flex;gap:12px;align-items:flex-start;background:#fff;border-radius:16px;padding:16px 18px;font-weight:700;border:1.5px solid #111;box-shadow:3px 3px 8px rgba(17,17,17,.04), -2px -2px 6px rgba(255,255,255,.9)}
.chk .ic{background:#111;color:#FFC629}

/* pricing */
.price{display:flex;flex-direction:column;gap:14px;box-shadow:var(--neu-flat)}
.price:hover{box-shadow:var(--neu-hover)}
.price .amt{font-family:Sora,sans-serif;font-size:40px;font-weight:800;line-height:1.1}
.price ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;flex-grow:1}
.price li{display:flex;gap:10px}
.price li::before{content:"✓";color:#F26522;font-weight:800}
.price.hot{background:#111;color:#fff;border-color:#111;box-shadow:var(--neu-dark);transform:translateY(-10px)}
.price.hot:hover{transform:translateY(-16px);box-shadow:var(--neu-dark-hover)}
.price.hot li::before{color:#FFC629}
.badge{align-self:flex-start;background:#FFC629;color:#111;font-weight:800;font-size:12px;letter-spacing:.6px;text-transform:uppercase;padding:5px 12px;border-radius:999px}

/* compare */
.tbl{overflow-x:auto;border:1.5px solid #111;border-radius:22px;background:#fff;box-shadow:var(--neu-flat)}
table{width:100%;min-width:640px;border-collapse:collapse;font-size:16px}
th,td{padding:17px 22px;text-align:center}
th:first-child,td:first-child{text-align:left}
thead th{background:#FFFAF2;font-family:Sora,sans-serif}
thead th.us{background:#F26522;color:#fff}
tbody tr{border-top:1px solid #EFEAE2}
td.us{background:#FFF4CC;font-weight:800}
td.them{color:#6B6B6B}

/* reviews */
.quote{display:flex;flex-direction:column;gap:16px;box-shadow:var(--neu-flat)}
.quote:hover{box-shadow:var(--neu-hover)}
.quote blockquote{margin:0;font-size:17px;flex-grow:1}
.quote blockquote::before{content:"“";display:block;font-family:Sora,serif;font-size:60px;line-height:.6;color:#F26522;margin-bottom:8px}
.who{display:flex;gap:12px;align-items:center}
.av{width:46px;height:46px;border-radius:50%;background:#FFC629;color:#111;font-weight:800;display:flex;align-items:center;justify-content:center}

/* video carousel */
.vcarousel-wrap{position:relative;margin-bottom:48px}
.vcarousel{display:flex;gap:22px;overflow-x:auto;scroll-behavior:auto;-webkit-overflow-scrolling:touch;padding:12px 6px 24px 6px;margin:-12px -6px -24px -6px;scrollbar-width:none}
.vcarousel::-webkit-scrollbar{display:none}
.vcard{flex:0 0 calc((100% - 44px) / 3);background:#fff;border:1.5px solid #ECE7DF;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--neu-flat);transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease;cursor:pointer;position:relative}
.vcard:hover{transform:translateY(-6px);box-shadow:var(--neu-hover);border-color:#F26522}
.vcard:focus-visible{outline:3px solid #F26522;outline-offset:3px}
.vcard-media{position:relative;width:100%;aspect-ratio:16/9;background:#0B1422;overflow:hidden}
.vcard-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.vcard:hover .vcard-media img{transform:scale(1.05)}
.vcard-badge{position:absolute;top:12px;left:12px;background:rgba(17,17,17,.88);backdrop-filter:blur(6px);color:#fff;font-family:Sora,sans-serif;font-weight:700;font-size:11px;letter-spacing:.04em;padding:4px 10px;border-radius:6px;display:inline-flex;align-items:center;gap:5px;z-index:2}
.vcard-badge.short{background:rgba(242,101,34,.92)}
.vcard-play{position:absolute;inset:0;margin:auto;width:52px;height:52px;border-radius:50%;background:rgba(17,17,17,.82);backdrop-filter:blur(6px);border:2px solid rgba(255,255,255,.8);display:flex;align-items:center;justify-content:center;color:#fff;transition:transform .25s,background .25s,border-color .25s;box-shadow:0 8px 22px rgba(0,0,0,.45);z-index:2}
.vcard:hover .vcard-play{transform:scale(1.12);background:#F26522;border-color:#fff}
.vcard-play svg{margin-left:3px}
.vcard-body{padding:22px;display:flex;flex-direction:column;gap:5px;flex-grow:1}
.vcard-body strong{font-size:17px;color:#111;font-family:Sora,'Noto Sans Malayalam',sans-serif}
.vcard-body span{font-size:14px;color:#5C5C5C;font-weight:500}
.vcard-body p{margin:8px 0 0;font-size:14px;color:#2B2B2B;line-height:1.5;font-style:italic}
.ccontrols{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:24px}
.cbtn{width:46px;height:46px;border-radius:50%;background:#fff;border:1.5px solid #111;color:#111;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:var(--neu-flat);transition:transform .2s,background .2s,color .2s,box-shadow .2s}
.cbtn:hover{background:#111;color:#fff;transform:scale(1.06);box-shadow:var(--neu-hover)}
.cbtn:focus-visible{outline:3px solid #F26522}

/* modal video player */
.vmodal{border:none;padding:0;background:transparent;max-width:880px;width:calc(100% - 32px);margin:auto;border-radius:20px;overflow:visible}
.vmodal::backdrop{background:rgba(11,20,34,.88);backdrop-filter:blur(8px)}
.vmodal-box{background:#111;border:1px solid #2B2B2B;border-radius:20px;padding:20px;position:relative;box-shadow:0 30px 70px rgba(0,0,0,.8)}
