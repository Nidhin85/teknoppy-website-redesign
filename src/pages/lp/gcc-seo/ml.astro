  return 'M4 86 C40 84 70 82 100 ' + mid + ' S160 ' + (end + 22) + ' 214 ' + end;
}

function show(i, manual) {
  if (!dotsEl) return;
  idx = i;
  var d = CLIENTS[i];
  var kw = d.keywords[0];
  Array.prototype.slice.call(dotsEl.children).forEach(function(b, j) {
    b.classList.toggle('on', j === i);
  });
  if ($('h-market')) $('h-market').textContent = d.market;
  if ($('h-market2')) $('h-market2').textContent = d.market;
  if ($('h-res')) $('h-res').classList.add('out');
  clearInterval(typer);
  var q = $('h-query');
  if (q) {
    q.textContent = '';
    var c = 0;
    typer = setInterval(function() {
      q.textContent = kw.slice(0, ++c);
      if (c >= kw.length) {
        clearInterval(typer);
        reveal(d);
      }
    }, reduce ? 0 : 45);
  } else {
    reveal(d);
  }
  if (manual) {
    clearInterval(timer);
    timer = setInterval(next, 5600);
  }
}

function reveal(d) {
  if ($('h-site')) $('h-site').textContent = d.client;
  if ($('h-fav')) $('h-fav').textContent = d.client.charAt(0);
  if ($('h-url')) $('h-url').textContent = d.url;
  if ($('h-title')) $('h-title').textContent = d.title;
  if ($('h-desc')) $('h-desc').textContent = d.desc;
  if ($('h-res')) $('h-res').classList.remove('out');
  var pos = $('h-pos');
  if (pos) {
    var seq = [9, 5, 3, 1];
    var k = 0;
    var climb = setInterval(function() {
      pos.textContent = '#' + seq[k];
      pos.classList.add('bump');
      setTimeout(function() { pos.classList.remove('bump'); }, 180);
      if (++k >= seq.length) clearInterval(climb);
    }, reduce ? 0 : 220);
  }
  if ($('h-growth')) $('h-growth').textContent = d.growth;
  if ($('h-client')) $('h-client').textContent = d.client + ' · ' + d.market;
  if ($('h-kwn')) $('h-kwn').textContent = d.keywords.length;
  var p = curve(d.growth);
  if ($('h-line')) $('h-line').setAttribute('d', p);
  if ($('h-area')) $('h-area').setAttribute('d', p + ' L214 92 L4 92 Z');
  if ($('h-dot')) $('h-dot').setAttribute('cy', p.split(' ').pop());
}

function next() {
  show((idx + 1) % CLIENTS.length);
}

if (dotsEl) {
  CLIENTS.forEach(function(c, i) {
    var b = document.createElement('button');
    b.type = 'button';
    b.setAttribute('aria-label', c.client);
    b.onclick = function() { show(i, true); };
    dotsEl.appendChild(b);
  });
  show(0);
  if (!reduce) {
    timer = setInterval(next, 5600);
  }
}

var els=document.querySelectorAll('.rv');
if(!('IntersectionObserver' in window)||reduce){els.forEach(function(e){e.classList.add('in')});}
else{var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}})},{threshold:.15});els.forEach(function(e){io.observe(e)});}
document.querySelectorAll('[data-count]').forEach(function(el){
var end=+el.getAttribute('data-count');if(reduce)return;el.textContent='0';
var o=new IntersectionObserver(function(en){if(!en[0].isIntersecting)return;o.disconnect();var t0=null;
function step(t){if(!t0)t0=t;var p=Math.min((t-t0)/1600,1);el.textContent=Math.round(end*(1-Math.pow(1-p,3)));if(p<1)requestAnimationFrame(step);}
requestAnimationFrame(step);},{threshold:.5});o.observe(el);});

// Video Carousel Auto-scroll & Modal Player
var vTrack = document.getElementById('vTrack');
var vPrev = document.getElementById('vPrev');
var vNext = document.getElementById('vNext');
var vModal = document.getElementById('videoModal');
var vFrame = document.getElementById('vModalFrame');
var vTitle = document.getElementById('vModalTitle');
var vClose = document.getElementById('vModalClose');

if (vTrack) {
  var isHovered = false;
  var isFocused = false;
  var isTouching = false;
  var isModalOpen = false;
  var isDocumentHidden = document.hidden;
  var speed = 0.75;
  var rafId = null;

  function stepCarousel() {
    if (!reduce && !isHovered && !isFocused && !isTouching && !isModalOpen && !isDocumentHidden) {
      vTrack.scrollLeft += speed;
      var half = vTrack.scrollWidth / 2;
      if (half > 0 && vTrack.scrollLeft >= half) {
        vTrack.scrollLeft -= half;
      }
    }
    rafId = requestAnimationFrame(stepCarousel);
  }

  if (!reduce) {
    rafId = requestAnimationFrame(stepCarousel);
  }

  vTrack.addEventListener('mouseenter', function(){ isHovered = true; });
  vTrack.addEventListener('mouseleave', function(){ isHovered = false; });
  vTrack.addEventListener('focusin', function(){ isFocused = true; });
  vTrack.addEventListener('focusout', function(){ isFocused = false; });
  vTrack.addEventListener('touchstart', function(){ isTouching = true; }, { passive: true });
  vTrack.addEventListener('touchend', function(){ isTouching = false; }, { passive: true });
  vTrack.addEventListener('touchcancel', function(){ isTouching = false; }, { passive: true });

  document.addEventListener('visibilitychange', function(){
    isDocumentHidden = document.hidden;
  });

  var cardStep = function(){
    var first = vTrack.querySelector('.vcard');
    return first ? first.offsetWidth + 22 : 360;
  };

  if (vPrev) {
    vPrev.addEventListener('click', function(){
      vTrack.scrollBy({ left: -cardStep(), behavior: 'smooth' });
      setTimeout(function(){
        if (vTrack.scrollLeft <= 0) {
          var half = vTrack.scrollWidth / 2;
          if (half > 0) vTrack.scrollLeft += half;
        }
      }, 350);
    });
  }

  if (vNext) {
    vNext.addEventListener('click', function(){
      vTrack.scrollBy({ left: cardStep(), behavior: 'smooth' });
    });
  }

  function openVideo(id, title) {
    if (!vModal || !vFrame) return;
    isModalOpen = true;
    vFrame.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0&playsinline=1';
    if (vTitle) vTitle.textContent = title || 'Client Testimonial';
    if (typeof vModal.showModal === 'function') {
      vModal.showModal();
    } else {
      vModal.setAttribute('open', '');
    }
  }

  function closeVideo() {
    if (!vModal || !vFrame) return;
    isModalOpen = false;
    vFrame.src = 'about:blank';
    vFrame.removeAttribute('src');
    if (typeof vModal.close === 'function') {
      vModal.close();
    } else {
      vModal.removeAttribute('open');
    }
  }

  var vCards = Array.prototype.slice.call(vTrack.querySelectorAll('.vcard'));
  vCards.forEach(function(card){
    card.addEventListener('click', function(){
      var yt = card.getAttribute('data-yt');
      var title = card.getAttribute('data-title');
      if (yt) openVideo(yt, title);
    });
    card.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        var yt = card.getAttribute('data-yt');
        var title = card.getAttribute('data-title');
        if (yt) openVideo(yt, title);
      }
    });
  });

  if (vClose) vClose.addEventListener('click', closeVideo);
  if (vModal) {
    vModal.addEventListener('click', function(e){
      if (e.target === vModal) closeVideo();
    });
    vModal.addEventListener('cancel', function(){
      closeVideo();
    });
  }
}

