<style is:inline>
:root{
  --navy:#0F1B2D; --navy-2:#16263F; --navy-3:#22314A; --line:#2E4366;
  --orange:#F26522; --orange-d:#D4500F; --peach:#FFB48A; --cream:#FFF5EF;
  --paper:#FFFFFF; --ground:#F4F6FA; --ink:#1C2433; --ink-2:#3A4456; --muted:#5A6478; --soft:#C9D1DE; --hair:#ECEFF4;
  --green:#128C4A; --green-d:#0E7039; --link:#1A47B8; --star:#F5A300;
  --display:'Sora',system-ui,sans-serif;
  --body:'Plus Jakarta Sans',system-ui,sans-serif;
  /* Neumorphic soft dimensional surfaces */
  --neu-flat:6px 6px 18px rgba(15,27,45,.06), -6px -6px 18px rgba(255,255,255,.95);
  --neu-hover:10px 10px 24px rgba(15,27,45,.1), -8px -8px 22px rgba(255,255,255,1);
  --neu-inset:inset 2px 2px 5px rgba(15,27,45,.06), inset -2px -2px 5px rgba(255,255,255,.85);
  color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:clip}
body{overflow-x:clip}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.6}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--navy)}
a{color:var(--orange-d)}
h1,h2,h3{font-family:var(--display);text-wrap:balance;margin:0}
.wrap{max-width:1200px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
.band{padding-block:96px}
.eyebrow{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#B8440C;margin:0 0 12px}
.dark .eyebrow{color:var(--peach)}
.h2{font-size:clamp(28px,4vw,42px);line-height:1.22;color:var(--navy)}
.dark .h2{color:#fff}
.lead{font-size:18px;color:var(--ink-2);max-width:62ch;margin:14px 0 0}
.dark .lead{color:var(--soft)}
.center{text-align:center}.center .lead{margin-inline:auto}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 26px;border-radius:12px;font:700 16px var(--body);text-decoration:none;border:none;cursor:pointer;transition:transform .2s,background .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px)}
.btn:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--peach);outline-offset:3px}
.btn-o{background:var(--orange);color:#fff;box-shadow:0 10px 24px -10px rgba(242,101,34,.7)}.btn-o:hover{background:var(--orange-d);color:#fff}
.btn-g{background:var(--green);color:#fff}.btn-g:hover{background:var(--green-d);color:#fff}
.btn-ghost{background:transparent;color:#fff;border:1.5px solid var(--line)}.btn-ghost:hover{border-color:#fff;color:#fff}
.row{display:flex;flex-wrap:wrap;gap:14px}

/* header */
header{position:sticky;top:0;z-index:100;background:rgba(15,27,45,.95);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--navy-3)}
header .wrap{display:flex;justify-content:space-between;align-items:center;height:72px;gap:16px}
.logo{display:inline-flex;align-items:center;text-decoration:none}
.logo img{display:block;height:38px;width:auto;object-fit:contain}
nav{display:flex;gap:26px}nav a{color:#E6EAF1;text-decoration:none;font-weight:600;font-size:15px}nav a:hover{color:var(--peach)}

/* hero */
.hero{background:var(--navy);color:#fff;position:relative;overflow:hidden;padding-block:72px 96px}
.hero::after{content:"";position:absolute;inset:auto -10% -40% auto;width:620px;height:620px;border-radius:50%;background:radial-gradient(circle,rgba(242,101,34,.22),transparent 65%);pointer-events:none;animation:glow 8s ease-in-out infinite alternate}
@keyframes glow{to{transform:translate(-60px,-40px) scale(1.1)}}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:56px;align-items:center;position:relative;z-index:1}
.pill{display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border-radius:999px;background:var(--navy-2);border:1px solid var(--line);color:var(--peach);font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.dot{width:8px;height:8px;border-radius:50%;background:#3DD27A;box-shadow:0 0 0 0 rgba(61,210,122,.6);animation:ping 1.8s infinite}
@keyframes ping{70%{box-shadow:0 0 0 8px rgba(61,210,122,0)}100%{box-shadow:0 0 0 0 rgba(61,210,122,0)}}
.hero h1{font-size:clamp(36px,5.4vw,58px);line-height:1.15;font-weight:800;margin:22px 0 18px;letter-spacing:-.01em}
.hero h1 em{font-style:normal;color:var(--orange);position:relative;white-space:nowrap}
.hero h1 em::after{content:"";position:absolute;left:0;right:0;bottom:-4px;height:6px;border-radius:4px;background:var(--orange);opacity:.35;transform-origin:left;animation:under 1.2s .4s ease-out both}
@keyframes under{from{transform:scaleX(0)}}
.hero p.sub{font-size:19px;color:var(--soft);max-width:56ch;margin:0 0 28px}
.trust{display:flex;flex-wrap:wrap;gap:20px;margin-top:28px;font-size:15px;color:var(--soft)}
.trust b{color:#fff}.stars{color:var(--star);letter-spacing:2px}

/* SERP animation */
.serp{background:var(--paper);color:var(--ink);border-radius:24px;padding:24px;box-shadow:0 40px 80px -30px rgba(0,0,0,.65), 0 0 0 1px rgba(255,255,255,.08)}
.searchbar{display:flex;align-items:center;gap:10px;padding:12px 18px;border:1px solid #D9DEE7;border-radius:999px;margin-bottom:16px;font-size:15px;background:var(--ground);box-shadow:var(--neu-inset)}
.caret{display:inline-block;width:2px;height:18px;background:var(--ink);margin-left:2px;animation:blink 1s steps(1) infinite;vertical-align:middle}
@keyframes blink{50%{opacity:0}}
.results{position:relative;height:370px}
.res{position:absolute;left:0;right:0;top:0;height:66px;border:1px solid var(--hair);border-radius:14px;padding:10px 16px;background:var(--paper);box-shadow:2px 3px 10px rgba(15,27,45,.04);transition:transform .9s cubic-bezier(.65,0,.25,1),opacity .6s;will-change:transform}
.res .bar{height:9px;border-radius:5px;background:#E6EAF1;margin-top:8px}
.res .bar.t{height:12px;width:68%;background:#C4CCD9;margin-top:0}
.res.me{border:2px solid var(--orange);background:#FFF8F3;z-index:2;box-shadow:0 12px 28px -12px rgba(242,101,34,.6), 3px 3px 10px rgba(15,27,45,.06)}
.res.me .url{font-size:12px;color:var(--ink-2)}
.res.me .tt{font-size:16px;font-weight:600;color:var(--link);line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank{position:absolute;top:-12px;right:14px;background:var(--orange);color:#fff;font:800 13px var(--display);padding:3px 11px;border-radius:999px;box-shadow:0 4px 10px rgba(242,101,34,.35);transition:background .4s}
.rank.top{background:var(--green);box-shadow:0 4px 10px rgba(18,140,74,.35)}
.serp-foot{display:flex;justify-content:space-between;align-items:center;margin-top:14px;padding-top:14px;border-top:1px solid var(--hair);font-size:14px;color:var(--muted)}
.serp-foot b{font:800 26px var(--display);color:var(--green-d)}

/* marquee */
.marquee{background:var(--orange);color:#fff;overflow:hidden;padding-block:16px}
.track{display:flex;gap:48px;width:max-content;animation:scroll 32s linear infinite;font:700 18px var(--display);white-space:nowrap}
.track span{display:inline-flex;align-items:center;gap:48px}
.track span::after{content:"✦";opacity:.6}
@keyframes scroll{to{transform:translateX(-50%)}}

/* stats */
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:-1px}
.stat{text-align:center;padding:28px 16px;background:var(--paper);border:1px solid var(--hair);border-radius:18px;box-shadow:var(--neu-flat);transition:transform .25s,box-shadow .25s}
.stat:hover{transform:translateY(-3px);box-shadow:var(--neu-hover)}
.stat .n{font:800 clamp(32px,4vw,44px) var(--display);color:var(--navy);font-variant-numeric:tabular-nums}
.stat .l{color:var(--muted);font-weight:600;margin-top:4px}

/* results */
.cards3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:44px}
.rcard{background:var(--paper);border:1px solid var(--hair);border-radius:20px;padding:28px;display:flex;flex-direction:column;gap:16px;box-shadow:var(--neu-flat);transition:transform .3s,box-shadow .3s}
.rcard:hover{transform:translateY(-5px);box-shadow:var(--neu-hover)}
.rtop{display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.one{background:var(--navy);color:#fff;font:800 14px var(--display);padding:4px 12px;border-radius:8px;box-shadow:0 4px 10px rgba(15,27,45,.2)}
.kw{background:var(--ground);border-radius:12px;padding:12px 16px;font-weight:600;box-shadow:var(--neu-inset)}
.meter{height:10px;border-radius:6px;background:#E6EAF1;overflow:hidden;box-shadow:inset 1px 1px 3px rgba(15,27,45,.1)}
.meter i{display:block;height:100%;border-radius:6px;background:linear-gradient(90deg,var(--orange-d),var(--orange));transform-origin:left;transition:transform 1.4s cubic-bezier(.2,.8,.2,1)}
.mrow{display:flex;justify-content:space-between;font-size:14px;color:var(--muted);margin-bottom:6px}
.mrow b{color:var(--green-d);font-size:18px;font-variant-numeric:tabular-nums}

/* problems */
.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px;align-items:center}
.probs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.prob{background:var(--paper);border:1px solid var(--hair);border-radius:18px;padding:24px;box-shadow:var(--neu-flat);transition:transform .25s,box-shadow .25s}
.prob:hover{transform:translateY(-3px);box-shadow:var(--neu-hover)}
.prob .x{width:40px;height:40px;border-radius:12px;background:#FDECEC;color:#C62828;display:flex;align-items:center;justify-content:center;font-weight:800;margin-bottom:12px;box-shadow:inset 1px 1px 3px rgba(198,40,40,.15), -2px -2px 6px rgba(255,255,255,.9)}
.prob strong{display:block;color:var(--navy)}.prob span{color:var(--muted);font-size:15px}

/* before/after */
.ba{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-radius:24px;overflow:hidden;border:1px solid var(--hair);margin-top:40px;box-shadow:var(--neu-flat)}
.ba > div{padding:40px}
.ba ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px;font-size:17px}
.ba li{display:flex;gap:12px}
.ba .after{background:linear-gradient(145deg,#0F1B2D,#16263F);color:#fff;box-shadow:inset 3px 3px 12px rgba(0,0,0,.35)}
.big{font:800 52px var(--display);color:var(--orange);font-variant-numeric:tabular-nums}

/* services */
.cards4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:44px}
.svc{background:var(--paper);border:1px solid var(--hair);border-radius:18px;padding:26px;box-shadow:var(--neu-flat);transition:border-color .25s,transform .25s,box-shadow .25s}
.svc:hover{border-color:var(--orange);transform:translateY(-4px);box-shadow:var(--neu-hover)}
.svc .ic{width:46px;height:46px;border-radius:14px;background:#FFF0E6;color:var(--orange);display:flex;align-items:center;justify-content:center;margin-bottom:14px;box-shadow:3px 3px 8px rgba(242,101,34,.12), -2px -2px 6px rgba(255,255,255,.95)}
.svc h3{font-size:18px;color:var(--navy);margin-bottom:6px}.svc p{margin:0;color:var(--muted);font-size:15px}

/* process timeline */
.steps{position:relative;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:12px;margin-top:52px}
.steps::before{content:"";position:absolute;left:4%;right:4%;top:24px;height:3px;background:var(--navy-3);border-radius:2px}
.steps .prog{position:absolute;left:4%;top:24px;height:3px;width:92%;background:var(--orange);border-radius:2px;transform:scaleX(1);transform-origin:left;transition:transform 2.4s ease-out}
.step{position:relative;text-align:center}
.step .c{width:48px;height:48px;margin:0 auto 14px;border-radius:50%;background:var(--navy-2);border:2px solid var(--orange);color:#fff;font:800 15px var(--display);display:flex;align-items:center;justify-content:center;position:relative;z-index:1;box-shadow:4px 4px 12px rgba(5,10,18,.5), -3px -3px 10px rgba(46,67,102,.3)}
.step b{display:block;font-size:15px;line-height:1.35}
.step span{display:block;font-size:13px;color:var(--soft);margin-top:4px}

/* pricing */
.price{background:var(--paper);border:1px solid var(--hair);border-radius:20px;padding:34px;display:flex;flex-direction:column;gap:16px;position:relative;box-shadow:var(--neu-flat);transition:transform .3s,box-shadow .3s}
.price:hover{transform:translateY(-4px);box-shadow:var(--neu-hover)}
.price.pop{border:2px solid var(--orange);box-shadow:0 14px 36px -12px rgba(242,101,34,.4), var(--neu-flat)}
.price.pop:hover{box-shadow:0 18px 42px -10px rgba(242,101,34,.5), var(--neu-hover)}
.price .tag{position:absolute;top:-14px;left:28px;background:var(--orange);color:#fff;font-size:13px;font-weight:700;padding:5px 12px;border-radius:999px;box-shadow:0 4px 10px rgba(242,101,34,.4)}
.amt{font:800 38px var(--display);color:var(--navy)}.amt small{font:500 15px var(--body);color:var(--muted)}
.price ul{margin:0;padding-left:20px;color:var(--ink-2);display:flex;flex-direction:column;gap:6px;flex-grow:1}
.btn-l{background:var(--paper);color:var(--navy);border:1.5px solid #D9DEE7;box-shadow:2px 3px 8px rgba(15,27,45,.04)}.btn-l:hover{border-color:var(--navy);color:var(--navy)}

/* compare */
.tbl{overflow-x:auto;margin-top:40px;border:1px solid var(--hair);border-radius:20px;background:var(--paper);box-shadow:var(--neu-flat)}
table{width:100%;min-width:620px;border-collapse:collapse}
th,td{padding:16px 22px;text-align:center}th:first-child,td:first-child{text-align:left;font-weight:600}
thead th{background:var(--ground);color:var(--navy)}thead th.us{background:var(--orange);color:#fff}
tbody tr{border-top:1px solid var(--hair)}td.us{background:#FFF8F3;color:var(--green-d);font-weight:700}td.them{color:var(--muted)}

/* reviews (written) */
.rev{margin:0;background:var(--paper);border:1px solid var(--hair);border-radius:18px;padding:26px;display:flex;flex-direction:column;gap:14px;box-shadow:var(--neu-flat);transition:transform .25s,box-shadow .25s}
.rev:hover{transform:translateY(-3px);box-shadow:var(--neu-hover)}
.rev blockquote{margin:0;flex-grow:1;font-size:16px;line-height:1.6}.rev figcaption strong{display:block;color:var(--navy)}.rev figcaption span{font-size:14px;color:var(--muted)}

/* video carousel */
.vcarousel-wrap{position:relative;margin-top:40px}
.vcarousel{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;padding:12px 6px 24px 6px;margin:-12px -6px -24px -6px;scrollbar-width:none}
.vcarousel::-webkit-scrollbar{display:none}
.vcard{flex:0 0 calc((100% - 44px) / 3);scroll-snap-align:start;background:var(--paper);border:1px solid var(--hair);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--neu-flat);transition:transform .3s,box-shadow .3s;cursor:pointer;position:relative}
.vcard:hover{transform:translateY(-5px);box-shadow:var(--neu-hover)}
.vcard:focus-visible{outline:3px solid var(--peach);outline-offset:3px}
.vcard-media{position:relative;width:100%;aspect-ratio:16/9;background:#0B1422;overflow:hidden}
.vcard-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.vcard:hover .vcard-media img{transform:scale(1.05)}
.vcard-badge{position:absolute;top:12px;left:12px;background:rgba(15,27,45,.88);backdrop-filter:blur(6px);color:#fff;font:700 11px var(--display);letter-spacing:.04em;padding:4px 10px;border-radius:6px;display:inline-flex;align-items:center;gap:5px;z-index:2}
.vcard-badge.short{background:rgba(242,101,34,.92)}
.vcard-play{position:absolute;inset:0;margin:auto;width:52px;height:52px;border-radius:50%;background:rgba(15,27,45,.82);backdrop-filter:blur(6px);border:2px solid rgba(255,255,255,.8);display:flex;align-items:center;justify-content:center;color:#fff;transition:transform .25s,background .25s,border-color .25s;box-shadow:0 8px 22px rgba(0,0,0,.45);z-index:2}
.vcard:hover .vcard-play{transform:scale(1.12);background:var(--orange);border-color:#fff}
.vcard-play svg{margin-left:3px}
.vcard-body{padding:22px;display:flex;flex-direction:column;gap:5px;flex-grow:1}
.vcard-body strong{font-size:17px;color:var(--navy);font-family:var(--display)}
.vcard-body span{font-size:14px;color:var(--muted);font-weight:500}
.vcard-body p{margin:8px 0 0;font-size:13.5px;color:var(--ink-2);line-height:1.5;font-style:italic}
.ccontrols{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:28px}
.cbtn{width:46px;height:46px;border-radius:50%;background:var(--paper);border:1px solid var(--hair);color:var(--navy);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:var(--neu-flat);transition:transform .2s,background .2s,color .2s,box-shadow .2s}
.cbtn:hover{background:var(--navy);color:#fff;transform:scale(1.06);box-shadow:var(--neu-hover)}
.cbtn:focus-visible{outline:3px solid var(--peach)}
.cdots{display:flex;gap:8px;align-items:center}
.cdot{width:10px;height:10px;border-radius:999px;background:#D9DEE7;border:none;padding:0;cursor:pointer;transition:width .3s,background .3s}
.cdot.active{width:26px;background:var(--orange)}

/* modal video player */
.vmodal{border:none;padding:0;background:transparent;max-width:880px;width:calc(100% - 32px);margin:auto;border-radius:20px;overflow:visible}
.vmodal::backdrop{background:rgba(11,20,34,.88);backdrop-filter:blur(8px)}
.vmodal-box{background:var(--navy);border:1px solid var(--line);border-radius:20px;padding:20px;position:relative;box-shadow:0 30px 70px rgba(0,0,0,.8)}
.vmodal-close{position:absolute;top:-16px;right:-16px;width:40px;height:40px;border-radius:50%;background:var(--orange);color:#fff;border:2px solid #fff;font:700 18px var(--display);cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,.45);transition:transform .2s,background .2s;z-index:10}
.vmodal-close:hover{transform:scale(1.1);background:var(--orange-d)}
.vplayer-wrap{position:relative;width:100%;aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden}
.vplayer-wrap iframe{position:absolute;inset:0;width:100%;height:100%;border:none}
.vmodal-caption{margin-top:14px;color:#fff;font-size:16px;font-weight:600}

/* faq */
.faq{max-width:860px;margin:40px auto 0;display:flex;flex-direction:column;gap:14px}
details{background:var(--paper);border:1px solid var(--hair);border-radius:16px;padding:22px 26px;box-shadow:4px 4px 14px rgba(15,27,45,.04), -4px -4px 14px rgba(255,255,255,.9);transition:border-color .25s,box-shadow .25s}
details[open]{border-color:var(--orange);box-shadow:6px 6px 18px rgba(15,27,45,.06), -6px -6px 18px rgba(255,255,255,.95)}
summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:16px;font-weight:700;color:var(--navy);font-size:17px}
summary::-webkit-details-marker{display:none}
summary .p{color:var(--orange);font-size:24px;line-height:1;transition:transform .3s}
details[open] summary .p{transform:rotate(45deg)}
details p{margin:12px 0 0;color:var(--ink-2)}

/* audit */
.audit{background:var(--cream);border-top:1px solid #FBE1D2}
.form{background:var(--paper);border:1px solid #F3DCCD;border-radius:24px;padding:36px;box-shadow:12px 12px 36px rgba(15,27,45,.08), -10px -10px 30px rgba(255,255,255,.95)}
.form form{display:flex;flex-direction:column;gap:16px;margin-top:20px}
label{display:flex;flex-direction:column;gap:6px;font-weight:600;font-size:14px}
input,select{height:50px;padding:0 16px;border:1.5px solid #D9DEE7;border-radius:12px;font:400 16px var(--body);color:var(--ink);background:var(--ground);box-shadow:var(--neu-inset);transition:border-color .2s,box-shadow .2s}
input:focus,select:focus{border-color:var(--orange);background:#fff;box-shadow:0 0 0 3px rgba(242,101,34,.15);outline:none}
.ok{display:none;margin-top:14px;padding:14px 16px;border-radius:12px;background:#E7F6EE;color:var(--green-d);font-weight:600}
.ok.show{display:block}
.expert{display:flex;gap:16px;align-items:center;background:var(--paper);border:1px solid #F3DCCD;border-radius:18px;padding:18px;margin-top:24px;box-shadow:var(--neu-flat)}
.expert-ph{width:58px;height:58px;border-radius:50%;background:var(--ground);flex:none;overflow:hidden;display:flex;align-items:center;justify-content:center}
.expert-ph img{width:100%;height:100%;object-fit:cover}
.copy{font-weight:700;color:var(--navy);user-select:all}

/* final + footer */
.final{background:var(--navy);color:#fff;padding-block:72px}
.final .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:28px}
footer{background:#0B1422;color:var(--soft);padding-block:44px 96px;font-size:15px}
footer .cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}
footer strong{color:#fff}footer a{color:var(--soft);text-decoration:none}
.fb{margin-top:32px;padding-top:20px;border-top:1px solid var(--navy-3);font-size:14px}

/* mobile sticky CTA */
.mcta{display:none;position:fixed;left:0;right:0;bottom:0;z-index:25;gap:10px;background:var(--paper);border-top:1px solid var(--hair);padding:10px max(12px,env(safe-area-inset-right,0px)) calc(10px + env(safe-area-inset-bottom,0px)) max(12px,env(safe-area-inset-left,0px))}
.mcta .btn{flex:1;min-height:48px;padding:0 12px;font-size:15px}

/* reveal: elements are visible at rest; JS adds a lift-in when they enter */
.lift{transition:transform .8s cubic-bezier(.2,.8,.2,1),opacity .8s}
.lift.pre{transform:translateY(28px);opacity:.25}

/* hero video banner */
.hero-full-wrap{width:100%;margin:0;padding:0;position:relative;overflow:hidden;background:#000}
.hero-video-banner{width:100%;margin:0;padding:0;position:relative;background:#000;overflow:hidden;line-height:0}
.hero-video-banner video{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;object-position:center center;display:block;border:0;margin:0;padding:0}
.video-controls-badge{position:absolute;bottom:clamp(12px,2.5vw,24px);right:clamp(14px,3vw,32px);display:flex;align-items:center;gap:10px;padding:7px 14px;border-radius:999px;background:rgba(17,17,17,0.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,0.22);color:#fff;font-size:0.82rem;font-weight:700;z-index:10;box-shadow:0 6px 18px rgba(0,0,0,0.45);transition:transform .2s}
.video-controls-badge:hover{transform:scale(1.02)}
.vc-left{display:flex;align-items:center;gap:8px}
.vc-pill{background:#F26522;color:#fff;font-size:0.68rem;font-weight:800;padding:3px 8px;border-radius:999px;letter-spacing:0.04em;text-transform:uppercase}
.vc-title{color:#F3F3F3;font-size:0.78rem}
.vc-actions{display:flex;align-items:center;gap:6px;margin-left:4px}
.vc-btn{background:rgba(255,255,255,0.14);border:1px solid rgba(255,255,255,0.25);color:#fff;font-size:0.75rem;font-weight:700;padding:4px 10px;border-radius:999px;cursor:pointer;display:inline-flex;align-items:center;gap:4px;transition:background .2s;font-family:inherit}
.vc-btn:hover{background:rgba(255,255,255,0.28)}

/* ===== hero Google card + #1 keyword cards (tkx-) ===== */
:where(.tkx-scope){--orange:#F26522;--yellow:#FFC72C;--yellow-soft:#FFF4D6;--ink:#121212;--ink-2:#3A3A3A;--muted:#6B6B6B;--line:#ECE7E1;--navy:#0F1B2D;--green:#14A44D;--font:"Plus Jakarta Sans",system-ui,sans-serif;font-family:var(--font);line-height:1.6;color:var(--ink)}
.tkx-scope *{box-sizing:border-box}
.tkx-scope h3,.tkx-scope ul{margin:0;padding:0}
/* Hero visual — SERP proof card */
.tkx-proof{position:relative;min-width:0}
.tkx-proof-card{background:#fff;border:1.5px solid var(--ink);border-radius:24px;box-shadow:10px 10px 0 var(--ink);overflow:hidden}
.tkx-proof-top{min-width:0;display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--line);background:#FAF8F5}
.tkx-dots{display:flex;gap:6px}.tkx-dots i{width:10px;height:10px;border-radius:50%;background:#E3DED7}
.tkx-proof-top .tkx-label{font-size:12px;font-weight:700;color:var(--muted);letter-spacing:.05em;text-transform:uppercase}
.tkx-live{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--green)}
.tkx-live::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--green);animation:tkxPulse 1.6s infinite}
@keyframes tkxPulse{0%{box-shadow:0 0 0 0 rgba(20,164,77,.5)}100%{box-shadow:0 0 0 10px rgba(20,164,77,0)}}
.tkx-proof-body{padding:22px 22px 8px}
.tkx-search{display:flex;align-items:center;gap:12px;border:1px solid #DFDAD3;border-radius:999px;padding:12px 18px;font-size:16px;font-weight:500;box-shadow:0 2px 8px rgba(0,0,0,.04)}
.tkx-search svg{width:18px;height:18px;flex:none;color:var(--muted)}
.tkx-caret{display:inline-block;width:2px;height:18px;background:var(--ink);margin-left:2px;vertical-align:middle;animation:tkxBlink 1s steps(1) infinite}
@keyframes tkxBlink{50%{opacity:0}}
.tkx-serp{margin-top:16px;display:grid;gap:10px}
.tkx-res{display:grid;grid-template-columns:52px 1fr;gap:14px;align-items:center;padding:14px;border-radius:14px}
.tkx-res .tkx-pos{width:52px;height:52px;border-radius:12px;display:grid;place-items:center;font-weight:800;font-size:20px}
.tkx-res.tkx-win{background:var(--yellow-soft);border:1.5px solid var(--yellow)}
.tkx-res.tkx-win .tkx-pos{background:var(--ink);color:var(--yellow);transition:transform .3s}
.tkx-res.tkx-win .tkx-pos.tkx-bump{transform:scale(1.15)}
.tkx-res .tkx-url{font-size:12px;color:var(--muted)}
.tkx-res .tkx-title{font-size:17px;font-weight:700;color:#1A44C8;line-height:1.3}
.tkx-res .tkx-desc{font-size:13px;color:var(--ink-2)}
.tkx-res.tkx-ghost{padding:10px 14px}
.tkx-res.tkx-ghost .tkx-pos{width:52px;height:34px;background:#F3F0EC;color:#B9B2A8;font-size:14px}
.tkx-sk{height:9px;border-radius:9px;background:#F0ECE7;margin:5px 0}
.tkx-fade{transition:opacity .35s}
.tkx-fade.tkx-out{opacity:0}
.tkx-proof-foot{display:grid;grid-template-columns:1fr 1.25fr;gap:16px;align-items:end;padding:18px 22px 22px;border-top:1px dashed var(--line);margin-top:14px}
.tkx-metric small{display:block;font-size:13px;color:var(--muted);font-weight:600}
.tkx-metric .tkx-big{font-size:42px;font-weight:800;line-height:1.1}
.tkx-metric .tkx-big em{font-style:normal;color:var(--orange)}
.tkx-metric .tkx-client{display:inline-block;margin-top:6px;font-size:12px;font-weight:700;background:#F3F0EC;border-radius:999px;padding:4px 10px}
.tkx-chart svg{width:100%;height:auto;display:block}
.tkx-chart .tkx-ax{font-size:10px;fill:#9A938A;font-family:var(--font)}
.tkx-kw-dots{display:flex;justify-content:center;gap:8px;margin-top:26px}
.tkx-kw-dots button{width:10px;height:10px;border-radius:999px;border:0;background:#DCD5CC;cursor:pointer;transition:.3s;padding:0}
.tkx-kw-dots button.tkx-on{width:30px;background:var(--orange)}
.tkx-proof-caption{text-align:center;font-size:13px;color:var(--muted);margin-top:10px;font-weight:600}

.tkx-proof-chips{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:0 22px 22px}
.tkx-proof-chips div{border:1px solid var(--line);border-radius:14px;padding:10px 8px;text-align:center;background:#FFFDFB}
.tkx-proof-chips b{display:block;font-size:20px;font-weight:800;line-height:1.1}
.tkx-proof-chips b em{font-style:normal;color:var(--orange)}
.tkx-proof-chips span{display:block;font-size:11.5px;color:var(--muted);font-weight:600;margin-top:4px;line-height:1.3}

.tkx-gs-head{display:flex;align-items:center;gap:14px}
.tkx-gs-brand img{width:26px;height:26px;flex:none}
.tkx-gs-brand{display:inline-flex;align-items:center;gap:8px;font-family:Arial,Helvetica,sans-serif;font-size:24px;font-weight:700;letter-spacing:-.5px;color:#5F6368;flex:none}
.tkx-gs-head .tkx-search{flex:1;min-width:0;justify-content:space-between;font-family:Arial,var(--font);box-shadow:0 1px 6px rgba(32,33,36,.18);border-color:transparent}
.tkx-gs-head .tkx-search .tkx-q{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#202124}
.tkx-gs-tabs{display:flex;gap:18px;margin:14px 0 0;padding-left:2px;border-bottom:1px solid #EBEBEB;font-family:Arial,var(--font);font-size:13px;color:#5F6368}
.tkx-gs-tabs span{padding-bottom:9px}
.tkx-gs-tabs .tkx-on{color:#1A73E8;border-bottom:3px solid #1A73E8;font-weight:700}
.tkx-gs-count{font-family:Arial,var(--font);font-size:12px;color:#70757A;margin-top:10px}
.tkx-gs-count b{font-weight:700;color:#5F6368}
.tkx-proof .tkx-serp{margin-top:10px}
.tkx-proof .tkx-res{grid-template-columns:1fr auto;align-items:start;font-family:Arial,var(--font)}
.tkx-proof .tkx-res.tkx-win .tkx-pos{width:auto;height:auto;padding:6px 10px;border-radius:999px;font-size:14px}
.tkx-proof .tkx-res.tkx-ghost{opacity:.7}
.tkx-proof .tkx-res.tkx-ghost .tkx-pos{width:auto;height:auto;padding:6px 10px;border-radius:999px;font-size:12px}
.tkx-site{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.tkx-fav{width:28px;height:28px;flex:none;border-radius:50%;background:#fff;border:1px solid #DADCE0;display:grid;place-items:center;font-weight:800;font-size:13px;color:var(--orange)}
.tkx-site b{display:block;font-size:14px;font-weight:400;color:#202124;line-height:1.2}
.tkx-proof .tkx-res .tkx-url{display:block;font-size:12px;color:#4D5156;line-height:1.3}
.tkx-proof .tkx-res .tkx-title{font-size:19px;font-weight:400;color:#1A0DAB;line-height:1.3}
.tkx-proof .tkx-res .tkx-desc{font-size:13.5px;color:#4D5156;margin-top:3px}

/* RESULTS — 3 clients × 5 keywords at #1 */
.tkx-rk-grid{margin-top:44px;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:stretch}
.tkx-rk{background:#fff;border:1.5px solid var(--ink);border-radius:24px;box-shadow:8px 8px 0 var(--ink);overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}
.tkx-rk:hover{transform:translate(-3px,-3px);box-shadow:11px 11px 0 var(--ink)}
.tkx-rk-head{background:var(--navy);color:#fff;padding:22px 22px 20px;position:relative;overflow:hidden}
.tkx-rk-head::after{content:"#1";position:absolute;right:-6px;top:-30px;font-size:120px;font-weight:800;line-height:1;color:rgba(255,255,255,.05);pointer-events:none}
.tkx-rk-meta{display:flex;justify-content:space-between;align-items:center;gap:10px;position:relative;z-index:1}
.tkx-rk-mk{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#C9CAF0}
.tkx-rk-mk i{font-style:normal;font-size:16px;letter-spacing:0}
.tkx-rk-badge{background:var(--yellow);color:var(--ink);font-weight:800;font-size:12px;padding:5px 10px;border-radius:999px;white-space:nowrap}
.tkx-rk-name{font-size:21px;font-weight:800;margin-top:12px;position:relative;z-index:1}
.tkx-rk-grow{display:flex;align-items:baseline;gap:8px;margin-top:10px;position:relative;z-index:1}
.tkx-rk-grow b{font-size:32px;font-weight:800;line-height:1;color:var(--yellow)}
.tkx-rk-grow span{font-size:13px;color:#C9CAF0;font-weight:600}
.tkx-rk-th{display:flex;justify-content:space-between;padding:16px 22px 6px;font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.tkx-rk-list{list-style:none;padding:0 12px 14px;flex:1}
.tkx-rk-list li{display:flex;align-items:center;gap:12px;padding:11px 10px;border-radius:12px;font-weight:600;font-size:15px;line-height:1.35}
.tkx-rk-list li:nth-child(odd){background:#FAF8F5}
.tkx-rk-list .tkx-g{width:18px;height:18px;flex:none}
.tkx-rk-list .tkx-k{flex:1;min-width:0}
.tkx-rk-list .tkx-p{flex:none;min-width:40px;height:30px;display:grid;place-items:center;border-radius:9px;background:var(--yellow);color:var(--ink);font-weight:800;font-size:14px;box-shadow:0 4px 12px -5px rgba(255,199,44,.9)}
.tkx-rk-sum{display:flex;justify-content:center;margin-top:30px}
.tkx-rk-sum > span{display:inline-flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;background:var(--yellow-soft);border:1.5px solid var(--yellow);border-radius:999px;padding:10px 20px;font-weight:700;font-size:15px}
.tkx-rk-sum b{color:var(--orange)}

@media (max-width:1000px){
  .hero-grid,.two{grid-template-columns:minmax(0,1fr)}
  .tkx-proof{max-width:560px;margin-inline:auto;width:100%}
  .tkx-rk-grid{grid-template-columns:1fr;max-width:520px;margin-inline:auto}
  .cards3{grid-template-columns:minmax(0,1fr)}
  .cards4,.stats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .steps{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:28px}
  .steps::before,.steps .prog{display:none}
  .vcard{flex:0 0 calc((100% - 22px) / 2)}
  nav{display:none}
  footer .cols{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:640px){
  .vcard{flex:0 0 84vw;scroll-snap-align:center}
}
@media (max-width:700px){
  .probs,.ba,.cards4{grid-template-columns:minmax(0,1fr)}
  .band{padding-block:64px}
  .mcta{display:flex}
  .ba > div{padding:28px}
  .video-controls-badge{bottom:8px;right:8px;padding:4px 8px;gap:6px;max-width:calc(100% - 16px)}
  .vc-title{display:none}
  .vc-pill{font-size:0.62rem;padding:2px 6px}
  .vc-btn{font-size:0.7rem;padding:3px 8px}
  .tkx-proof-foot{grid-template-columns:1fr}
  .tkx-proof-card{box-shadow:6px 6px 0 var(--ink)}
  .tkx-metric .tkx-big{font-size:34px}
  .tkx-proof-chips{gap:8px;padding:0 16px 18px}
  .tkx-proof-chips b{font-size:17px}
  .tkx-gs-brand{font-size:0;gap:0}
  .tkx-gs-brand img{width:28px;height:28px}
  .tkx-gs-tabs{gap:14px}
  .tkx-gs-tabs span:nth-child(n+5){display:none}
  .tkx-proof .tkx-res .tkx-title{font-size:17px}
  .tkx-rk{border-radius:20px;box-shadow:6px 6px 0 var(--ink)}
  .tkx-rk-head{padding:18px 18px 16px}
  .tkx-rk-name{font-size:19px;margin-top:10px}
  .tkx-rk-grow b{font-size:28px}
  .tkx-rk-list{padding:0 10px 12px}
  .tkx-rk-list li{padding:10px 8px;font-size:13.5px;gap:8px}
  .tkx-rk-list .tkx-k{overflow-wrap:break-word;word-break:normal}
  .tkx-rk-list .tkx-p{min-width:34px;height:26px;font-size:12.5px;border-radius:7px}
  .tkx-rk-sum > span{font-size:13px;padding:8px 14px;line-height:1.4}
  .tbl{border-radius:18px;-webkit-overflow-scrolling:touch}
  table{width:100%;min-width:100%;table-layout:fixed;font-size:12px}
  th,td{padding:10px 4px;line-height:1.3;word-break:break-word}
  th:first-child,td:first-child{font-size:11.5px;width:28%;padding-left:8px}
  th.us,td.us{width:36%}
  th:last-child,td:last-child{width:36%;padding-right:8px}
}
@media (max-width:380px){
  .vc-left{display:none}
  .vc-btn span:last-child{display:none}
  .tkx-rk-list li{font-size:12px;padding:8px 5px;gap:6px}
  .tkx-rk-badge{font-size:11px;padding:3px 8px}
  .tkx-rk-mk{font-size:11px}
  table{font-size:11.5px}
  th,td{padding:10px 4px}
  th:first-child,td:first-child{font-size:11px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none !important;transition:none !important}
  .lift.pre{transform:none;opacity:1}
  .tkx-scope *{animation:none !important;transition:none !important}
}

/* === H1 centred on hero video === */
.hero-video-h1{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;padding:16px 20px 70px;text-align:center;line-height:normal;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,.15) 0%,rgba(0,0,0,.5) 100%)}
.hero-video-h1 h1{margin:0;max-width:1100px;color:#fff;font-family:var(--display),Sora,sans-serif;font-weight:800;font-size:clamp(1.7rem,4.8vw,4rem);line-height:1.15;letter-spacing:-.01em;text-wrap:balance;text-shadow:0 4px 24px rgba(0,0,0,.7)}
.hero-video-banner .video-controls-badge{z-index:5}
@media (max-width:600px){.hero-video-h1{padding:10px 14px 50px}.hero-video-h1 h1{font-size:clamp(1.3rem,6.2vw,1.8rem)}}
/* old H1 kept as same-looking headline */
.hero .hero-title{font-family:var(--display);text-wrap:balance;font-size:clamp(36px,5.4vw,58px);line-height:1.15;font-weight:800;margin:22px 0 18px;letter-spacing:-.01em}
.hero .hero-title em{font-style:normal;color:var(--orange);position:relative;white-space:nowrap}
.hero .hero-title em::after{content:"";position:absolute;left:0;right:0;bottom:-4px;height:6px;border-radius:4px;background:var(--orange);opacity:.35;transform-origin:left;animation:under 1.2s .4s ease-out both}

</style>
</head>
