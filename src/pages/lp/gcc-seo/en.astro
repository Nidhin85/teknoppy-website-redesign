  </div>
</header>

<!-- FULL-BLEED HERO VIDEO BANNER -->
<section class="hero-full-wrap" id="hero-reel">
  <div class="hero-video-banner" id="heroVideoBanner">
    <video
      id="heroVideo"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/video/poster.jpg">
      <source src="/video/Teknoppy-Web-Banner.mp4" type="video/mp4">
      <source src="/video/Teknoppy%20Web%20Banner%20final.mp4" type="video/mp4">
      Your browser does not support the video tag.
