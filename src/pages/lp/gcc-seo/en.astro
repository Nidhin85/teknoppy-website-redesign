<!-- CLIENT JAVASCRIPT: ANIMATIONS & INTERACTIONS -->
<script is:inline>
(function(){
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* 1. Hero: ranking climb loop. Resting state = #1 at top. */
  var box = document.getElementById('results-anim');
  var queryEl = document.getElementById('q');
  var queries = [
    'cmm calibration services',
    'pipe supplier in sharjah',
    'web design in qatar',
    'industrial calibration uae'
  ];
  var queryIdx = 0;

  if (box && !reduce) {
    var items = Array.prototype.slice.call(box.querySelectorAll('.res'));
    var me = items[0], others = items.slice(1), badge = document.getElementById('rankBadge');
    var stages = [
      {slot:4,label:'#9'},
      {slot:3,label:'#6'},
      {slot:2,label:'#4'},
      {slot:1,label:'#2'},
      {slot:0,label:'#1 on Google'}
    ];
    var H = 76;
    function place(slot){
      me.style.transform = 'translateY(' + slot*H + 'px)';
      var s = 0;
      others.forEach(function(o){ if (s === slot) s++; o.style.transform = 'translateY(' + s*H + 'px)'; s++; });
    }
    function run(){
      var i = 0;
      place(stages[0].slot); badge.textContent = stages[0].label; badge.classList.remove('top');
      var t = setInterval(function(){
        i++;
        if (i >= stages.length) {
          clearInterval(t);
          setTimeout(function(){
            queryIdx = (queryIdx + 1) % queries.length;
            if (queryEl) queryEl.textContent = queries[queryIdx];
            run();
          }, 3800);
          return;
        }
        place(stages[i].slot); badge.textContent = stages[i].label;
        if (i === stages.length - 1) badge.classList.add('top');
      }, 1200);
    }
    setTimeout(run, 1600);
  }

  if (!('IntersectionObserver' in window) || reduce) return;

  /* 2. Lift-in: elements below the initial viewport lift smoothly into view */
  var lifts = document.querySelectorAll('.lift');
  var vh = window.innerHeight;
  lifts.forEach(function(el){ if (el.getBoundingClientRect().top > vh) el.classList.add('pre'); });
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.remove('pre'); io.unobserve(e.target); } });
  }, {threshold: .15});
  lifts.forEach(function(el){ if (el.classList.contains('pre')) io.observe(el); });

  /* 3. Counters and meters animate when first seen */
  function count(el){
    var end = +el.dataset.count, pre = el.dataset.prefix || '', suf = el.dataset.suffix || '', t0 = null;
    function f(ts){
      if(!t0) t0 = ts;
      var p = Math.min((ts - t0)/1400, 1);
      var v = Math.round(end * (1 - Math.pow(1-p,3)));
      el.textContent = pre + v + suf;
      if (p < 1) requestAnimationFrame(f);
    }
    requestAnimationFrame(f);
  }
  var cio = new IntersectionObserver(function(es){
    es.forEach(function(e){ if (e.isIntersecting){ count(e.target); cio.unobserve(e.target); } });
  }, {threshold: .6});
  document.querySelectorAll('[data-count]').forEach(function(el){ if (el.getBoundingClientRect().top > vh) cio.observe(el); });

  var meters = document.querySelectorAll('.meter i');
  meters.forEach(function(m){ m.style.transform = 'scaleX(' + m.dataset.w + ')'; });
  var mio = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if (e.isIntersecting){
        var m = e.target;
        m.style.transform = 'scaleX(0)';
        requestAnimationFrame(function(){
          requestAnimationFrame(function(){ m.style.transform = 'scaleX(' + m.dataset.w + ')'; });
        });
        mio.unobserve(m);
      }
    });
  }, {threshold: .6});
  meters.forEach(function(m){ if (m.getBoundingClientRect().top > vh) mio.observe(m); });

  /* 4. Process line draws across when the steps enter the viewport */
  var steps = document.getElementById('steps'), prog = steps && steps.querySelector('.prog');
  if (prog && steps.getBoundingClientRect().top > vh) {
    prog.style.transition = 'none';
    prog.style.transform = 'scaleX(0)';
    var sio = new IntersectionObserver(function(es){
      if (es[0].isIntersecting){
        prog.style.transition = '';
        requestAnimationFrame(function(){ prog.style.transform = 'scaleX(1)'; });
        sio.disconnect();
      }
    }, {threshold: .4});
    sio.observe(steps);
  }
})();

/* Video Carousel & Modal Player */
(function(){
  var vTrack = document.getElementById('vTrack');
  var vPrev = document.getElementById('vPrev');
  var vNext = document.getElementById('vNext');
  var vDotsContainer = document.getElementById('vDots');
  var vModal = document.getElementById('videoModal');
  var vFrame = document.getElementById('vModalFrame');
  var vTitle = document.getElementById('vModalTitle');
  var vClose = document.getElementById('vModalClose');

  if (!vTrack) return;

  var vCards = Array.prototype.slice.call(vTrack.querySelectorAll('.vcard'));
  var cardStep = function(){
    var first = vCards[0];
    return first ? first.offsetWidth + 22 : 360;
  };

  if (vPrev) {
    vPrev.addEventListener('click', function(){
      vTrack.scrollBy({ left: -cardStep(), behavior: 'smooth' });
    });
  }
  if (vNext) {
    vNext.addEventListener('click', function(){
      vTrack.scrollBy({ left: cardStep(), behavior: 'smooth' });
    });
  }

  // Build pagination dots
  if (vDotsContainer && vCards.length) {
    vDotsContainer.innerHTML = '';
    vCards.forEach(function(_, idx){
      var dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'cdot' + (idx === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Go to testimonial video ' + (idx + 1));
      dot.addEventListener('click', function(){
        vTrack.scrollTo({ left: idx * cardStep(), behavior: 'smooth' });
      });
      vDotsContainer.appendChild(dot);
    });

    var dots = Array.prototype.slice.call(vDotsContainer.querySelectorAll('.cdot'));
    var syncDots = function(){
      var scrollLeft = vTrack.scrollLeft;
      var step = cardStep();
      var current = Math.min(Math.round(scrollLeft / step), dots.length - 1);
      dots.forEach(function(d, i){
        if (i === current) d.classList.add('active');
        else d.classList.remove('active');
      });
    };

    var scrollTimer;
    vTrack.addEventListener('scroll', function(){
      cancelAnimationFrame(scrollTimer);
      scrollTimer = requestAnimationFrame(syncDots);
    }, { passive: true });
  }

  // Modal play handlers
  function openVideo(id, title){
    if (!vModal || !vFrame) return;
    vFrame.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0&playsinline=1';
    if (vTitle) vTitle.textContent = title || 'Client Testimonial';
    if (typeof vModal.showModal === 'function') {
      vModal.showModal();
    } else {
      vModal.setAttribute('open', '');
    }
  }

  function closeVideo(){
    if (!vModal || !vFrame) return;
    vFrame.src = 'about:blank';
    vFrame.removeAttribute('src');
    if (typeof vModal.close === 'function') {
      vModal.close();
    } else {
      vModal.removeAttribute('open');
    }
  }

  vCards.forEach(function(card){
    card.addEventListener('click', function(){
      var yt = card.getAttribute('data-yt');
      var title = card.getAttribute('data-title');
      if (yt) openVideo(yt, title);
    });
    card.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        var yt = card.getAttribute('data-yt');
        var title = card.getAttribute('data-title');
        if (yt) openVideo(yt, title);
      }
    });
  });

  if (vClose) vClose.addEventListener('click', closeVideo);
  if (vModal) {
    vModal.addEventListener('click', function(e){
      if (e.target === vModal) closeVideo();
    });
    vModal.addEventListener('cancel', function(){
      closeVideo();
    });
  }
})();

/* Audit form: submits enquiry to /api/contact and redirects to thank-you page on confirmed success */
var auditForm = document.getElementById('auditForm');
if (auditForm) {
  auditForm.addEventListener('submit', async function(e){
    e.preventDefault();
    var f = e.target, ok = document.getElementById('ok');
    if (!f.name.value.trim() || !f.phone.value.trim()) {
      ok.style.background = '#FDECEC';
      ok.style.color = '#C62828';
      ok.textContent = 'Please enter your name and WhatsApp number.';
      ok.classList.add('show');
      return;
    }

    var btn = f.querySelector('button[type="submit"]');
    var origBtnText = btn ? btn.innerHTML : '';
    if (btn) {
      btn.disabled = true;
      btn.style.opacity = '0.7';
    }

    var nameVal = f.name.value.trim();
    var phoneVal = f.phone.value.trim();
    var siteVal = f.website.value.trim();
    var countryVal = f.country.value;

    var payload = {
      name: nameVal,
      phone: phoneVal,
      email: 'lead@teknoppy.com',
      service: 'GCC SEO Audit (' + countryVal + ')',
      message: 'Website: ' + (siteVal || 'Not provided') + '\nTarget Country: ' + countryVal + '\nSource: GCC SEO English Landing Page',
      source: 'GCC SEO English Landing Page'
    };

    try {
      var res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      });

      var data = null;
      try {
        data = await res.json();
      } catch (parseErr) {
        data = null;
      }

      if (!res.ok || !data || data.ok !== true) {
        var errorMsg = (data && data.error) ? data.error : 'Could not submit your request. Please try again.';
        throw new Error(errorMsg);
      }

      // Confirmed success: redirect to thank-you page (NO WhatsApp popup)
      window.location.href = '/lp/gcc-seo/en/thank-you/';
    } catch (err) {
      ok.style.background = '#FDECEC';
      ok.style.color = '#C62828';
      ok.textContent = err.message || 'Could not submit your request. Please call +91 62822 49224 or reach out directly on WhatsApp.';
      ok.classList.add('show');
      if (btn) {
        btn.disabled = false;
        btn.style.opacity = '1';
        if (origBtnText) btn.innerHTML = origBtnText;
      }
    }
  });
}
</script>
