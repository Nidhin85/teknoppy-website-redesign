---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/email-marketing-company-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA
    heading="Talk to Our Email Marketing Team in Kochi"
    description="Tell us your list size and what you sell. We will review your current emails and platform for free and send a written automation plan within 24 hours."
  />
</Layout>
