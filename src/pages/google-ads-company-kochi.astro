---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/google-ads-company-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA
    heading="Talk to a Google Ads Specialist in Kochi"
    description="Share your goal and current ad spend. We will review your account or market for free and send a written plan with a recommended budget within 24 hours."
  />
</Layout>
