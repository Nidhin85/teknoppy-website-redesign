    brand: 'Followers, reach and engagement'
  };

  var goalContainer = $('#goalTiles');
  if (goalContainer) {
    goalContainer.innerHTML = Object.keys(GOALS).map(function(k, i) {
      var n = C.filter(function(c) { return c.goal.indexOf(k) > -1; }).length;
      return '<button class="goal rv" style="--d:' + i + '" data-g="' + k + '">' +
        '<div class="top">' +
          '<span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + gi[k] + '</svg></span>' +
          '<span class="go">→</span>' +
        '</div>' +
        '<div>' +
          '<b>' + GOALS[k] + '</b>' +
          '<span>' + gd[k] + '</span>' +
          '<em>' + n + ' case studies</em>' +
        '</div>' +
      '</button>';
    }).join('');
  }

  /* ---------- LIBRARY FILTERING & SEARCH ---------- */
  var state = { q: '', ind: 'all', reg: 'all', svc: 'all', goal: 'all', sort: 'new' };

  var inds = [];
  C.forEach(function(c) {
    if (inds.indexOf(c.ind) < 0) inds.push(c.ind);
  });
  inds.sort();

  var indSelect = $('#ind');
  if (indSelect) {
    indSelect.innerHTML = '<option value="all">All industries</option>' + inds.map(function(x) {
      return '<option value="' + x + '">' + x + '</option>';
    }).join('');
  }

  var svcKeys = Object.keys(SVC).filter(function(k) {
    return C.some(function(c) { return c.s.indexOf(k) > -1; });
  });

  var chipsEl = $('#chips');
  if (chipsEl) {
    chipsEl.innerHTML = '<button class="chip on" data-s="all">All services<sup>' + C.length + '</sup></button>' +
      svcKeys.map(function(k) {
        var count = C.filter(function(c) { return c.s.indexOf(k) > -1; }).length;
        return '<button class="chip" data-s="' + k + '">' + SVC[k] + '<sup>' + count + '</sup></button>';
      }).join('');
  }

  function esc(s) { return s.replace(/[.*+?^$${}()|[\]\\]/g, '\\$&'); }
  function hl(txt) {
    if (!state.q) return txt;
    return txt.replace(new RegExp('(' + esc(state.q) + ')', 'ig'), '<mark>$1</mark>');
  }

  function card(c) {
    return '<a class="csc" href="' + c.href + '" data-id="' + c.id + '">' +
      (c.d === newest ? '<span class="new">New</span>' : '') +
      '<div class="meta"><span>' + hl(c.ind) + '</span><span>' + hl(c.loc) + '</span></div>' +
      '<div class="big"><b>' + c.m + '</b><small>' + c.ml + '</small></div>' +
      '<h3>' + hl(c.t) + '</h3>' +
      '<div class="flow">' +
        '<div><em>Problem</em><span>' + hl(c.ch) + '</span></div>' +
        '<div><em>Our work</em><span>' + hl(c.so) + '</span></div>' +
      '</div>' +
      '<div class="thumb">' +
        '<img src="' + c.img + '" alt="' + c.t + '" loading="lazy" onerror="this.remove()" />' +
      '</div>' +
      '<div class="foot">' +
        '<div class="svc">' +
          c.s.slice(0, 3).map(function(x) { return '<span>' + SVC[x] + '</span>'; }).join('') +
        '</div>' +
        '<span class="read">Read case study <span class="arr">→</span></span>' +
      '</div>' +
    '</a>';
  }

  var lib = $('#lib');
  // Pagination: show 9 cards, then 9 more per "Load More Projects" click.
  // Any filter/search/sort change (render called without `keep`) resets to the first 9.
  var PAGE = 9, shown = PAGE;
  function render(anim, keep) {
    var prevShown = keep ? shown - PAGE : 0;
    if (!keep) shown = PAGE;
    if (!lib) return;
    var q = state.q.toLowerCase().trim();
    var list = C.filter(function(c) {
      return (!q || q.split(/\s+/).every(function(w) { return c.all.indexOf(w) > -1; })) &&
        (state.ind === 'all' || c.ind === state.ind) &&
        (state.reg === 'all' || c.r === state.reg) &&
        (state.svc === 'all' || c.s.indexOf(state.svc) > -1) &&
        (state.goal === 'all' || c.goal.indexOf(state.goal) > -1);
    });

    list.sort(function(a, b) {
      if (state.sort === 'az') return a.t.localeCompare(b.t);
      if (state.sort === 'old') return a.d.localeCompare(b.d);
      return b.d.localeCompare(a.d);
    });

    var visible = list.slice(0, shown);
    lib.innerHTML = visible.map(card).join('');

    if ((anim || keep) && !reduce) {
      $$('.csc', lib).forEach(function(el, i) {
        if (i < prevShown) return;
        el.style.setProperty('--k', i - prevShown);
        el.classList.add('pop');
      });
    }

    var moreWrap = $('#moreWrap');
    if (moreWrap) moreWrap.hidden = list.length <= shown;

    var countEl = $('#count');
    if (countEl) {
      countEl.innerHTML = 'Showing <b>' + visible.length + '</b> of <b>' + list.length + '</b> verified case studies';
    }

    var emptyEl = $('#empty');
    if (emptyEl) {
      emptyEl.classList.toggle('on', !list.length);
    }

    var a = [];
    if (state.q) a.push(['q', '“' + state.q + '”']);
    if (state.goal !== 'all') a.push(['goal', GOALS[state.goal]]);
    if (state.ind !== 'all') a.push(['ind', state.ind]);
    if (state.reg !== 'all') {
      var regEl = $('#reg');
      a.push(['reg', regEl ? regEl.selectedOptions[0].text : state.reg]);
    }
    if (state.svc !== 'all') a.push(['svc', SVC[state.svc]]);

    var activeEl = $('#active');
    if (activeEl) {
      activeEl.innerHTML = a.map(function(x) {
        return '<button data-k="' + x[0] + '" aria-label="Remove filter ' + x[1] + '">' + x[1] + ' ✕</button>';
      }).join('') + (a.length ? '<button class="clear" data-k="all">Clear all</button>' : '');
    }
  }

  function sync() {
    var qInput = $('#q');
    if (qInput) qInput.value = state.q;
    var msEl = $('#ms');
    if (msEl) msEl.classList.toggle('has', !!state.q);
    if (indSelect) indSelect.value = state.ind;
    var regSelect = $('#reg');
    if (regSelect) regSelect.value = state.reg;
    var sortSelect = $('#sort');
    if (sortSelect) sortSelect.value = state.sort;
    $$('.chip').forEach(function(c) {
      c.classList.toggle('on', c.dataset.s === state.svc);
    });
  }

  function set(k, v, scroll) {
    state[k] = v;
    sync();
    render(1);
    if (scroll) {
      var libSection = $('#library');
      if (libSection) libSection.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    }
  }

  function reset() {
    state = { q: '', ind: 'all', reg: 'all', svc: 'all', goal: 'all', sort: state.sort };
    sync();
    render(1);
  }

  var deb;
  var qInput = $('#q');
  if (qInput) {
    qInput.addEventListener('input', function(e) {
      clearTimeout(deb);
      var v = e.target.value;
      var msEl = $('#ms');
      if (msEl) msEl.classList.toggle('has', !!v);
      deb = setTimeout(function() {
        state.q = v;
        render(1);
      }, 180);
    });
  }

  var qxBtn = $('#qx');
  if (qxBtn) {
    qxBtn.onclick = function() {
      set('q', '');
      if (qInput) qInput.focus();
    };
  }

  if (indSelect) indSelect.onchange = function() { set('ind', this.value); };
  var regSelect = $('#reg');
  if (regSelect) regSelect.onchange = function() { set('reg', this.value); };
  var sortSelect = $('#sort');
  if (sortSelect) sortSelect.onchange = function() { set('sort', this.value); };

  if (chipsEl) {
    chipsEl.addEventListener('click', function(e) {
      var b = e.target.closest('.chip');
      if (b) set('svc', b.dataset.s);
    });
  }

  var activeEl = $('#active');
  if (activeEl) {
    activeEl.addEventListener('click', function(e) {
      var b = e.target.closest('button');
      if (!b) return;
      var k = b.dataset.k;
      if (k === 'all') reset();
      else set(k, k === 'q' ? '' : 'all');
    });
  }

  var resetBtn = $('#reset');
  if (resetBtn) resetBtn.onclick = reset;

  $$('.views button').forEach(function(b) {
    b.onclick = function() {
      $$('.views button').forEach(function(x) { x.classList.toggle('on', x === b); });
      if (lib) lib.classList.toggle('list', b.dataset.v === 'list');
      render(1);
    };
  });

  if (goalContainer) {
    goalContainer.addEventListener('click', function(e) {
      var b = e.target.closest('.goal');
      if (b) {
        state.goal = b.dataset.g;
        set('svc', 'all', 1);
      }
    });
  }

  /* Keep the active filters in the URL so the browser Back button (and reloads or shared links)
     return to the same filtered view, e.g. the SEO section, instead of the unfiltered hub. */
  var FILTER_KEYS = ["q", "ind", "reg", "svc", "goal", "sort"];
  var FILTER_DEFAULT = { q: "", ind: "all", reg: "all", svc: "all", goal: "all", sort: "new" };
  function persistFilters() {
    try {
      var p = new URLSearchParams();
      FILTER_KEYS.forEach(function(k) { if (state[k] && state[k] !== FILTER_DEFAULT[k]) p.set(k, state[k]); });
      var qs = p.toString();
      history.replaceState(null, "", location.pathname + (qs ? "?" + qs : "") + (qs ? "#library" : location.hash));
    } catch (e) {}
  }
  function restoreFilters() {
    try {
      var p = new URLSearchParams(location.search);
      FILTER_KEYS.forEach(function(k) { if (p.has(k)) state[k] = p.get(k); });
      if (SVC[state.svc] === undefined) state.svc = "all";
      sync();
    } catch (e) {}
  }
  restoreFilters();
  var loadMoreBtn = $('#loadMore');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function() {
      shown += PAGE;
      render(0, true);
    });
  }

  render(0);
  persistFilters();
  var renderOnly = render;
  render = function(anim, keep) { renderOnly(anim, keep); persistFilters(); };
  window.addEventListener("pageshow", function(e) { if (e.persisted) { restoreFilters(); renderOnly(0); } });

  /* Reading Progress Bar */
  var prog = $('#progress');
  var tick = false;
  window.addEventListener('scroll', function() {
    if (!tick) {
      tick = true;
      window.requestAnimationFrame(function() {
        var h = root.scrollHeight - window.innerHeight;
        if (prog) prog.style.transform = 'scaleX(' + (h > 0 ? window.scrollY / h : 0) + ')';
        tick = false;
      });
    }
  }, { passive: true });

  /* Scroll Reveal & Counter Animations */
  if (!reduce && 'IntersectionObserver' in window) {
    root.classList.add('js');
    var io = new IntersectionObserver(function(es) {
      es.forEach(function(e) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });

    $$('.rv').forEach(function(el) { io.observe(el); });
    setTimeout(function() {
      $$('.rv').forEach(function(el) { el.classList.add('in'); });
    }, 6000);

    var co = new IntersectionObserver(function(es) {
      es.forEach(function(e) {
        if (!e.isIntersecting) return;
        var el = e.target;
        var to = +el.dataset.to;
        var t0 = null;
        (function step(t) {
          t0 = t0 || t;
          var p = Math.min((t - t0) / 1500, 1);
          el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(step);
        })(performance.now());
        co.unobserve(el);
      });
    }, { threshold: 0.5 });

    $$('.cnt').forEach(function(c) { co.observe(c); });
  }
})();
</script>
