  .qwall { grid-template-columns: 1fr; }
  .lib.list .csc { grid-template-columns: 180px 1fr; }
  .lib.list .big { grid-column: 2; grid-row: auto; text-align: left; padding-top: 10px; }
  .lib.list .foot { grid-column: 2; grid-row: auto; flex-direction: row; align-items: center; justify-content: space-between; }
  .lib.list .thumb { grid-row: 1/7; }
}

@media (max-width: 860px) {
