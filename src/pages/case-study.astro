}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
  }
}

/* ---- Case studies hub: reference hero (two columns + mockups + stat cards) ---- */
.hero .wrap.hero-grid { text-align: left; display: grid; grid-template-columns: 1fr; gap: 36px; align-items: center; }
.hero .crumb { justify-content: flex-start; }
.hero h1 { margin-left: 0; margin-right: 0; font-size: clamp(38px, 5.6vw, 72px); }
.hero .lead { margin-left: 0; margin-right: 0; font-size: 17px; }
.hero .ctas { justify-content: flex-start; }
.hero-art { position: relative; aspect-ratio: 1.3 / 1; width: 100%; max-width: 620px; margin: 0 auto; }
.hero-arc {
  position: absolute; inset: 2% -2% 6% 8%; border-radius: 50%;
  border: 14px solid transparent; border-top-color: #ff8a3c; border-right-color: #f05a2c;
  transform: rotate(-18deg); filter: drop-shadow(0 10px 24px rgba(240, 90, 44, .35)); opacity: .9;
}
.mock {
  position: absolute; background: #fff; border-radius: 18px; overflow: hidden;
  box-shadow: 0 30px 60px -28px rgba(120, 40, 10, .55), 0 0 0 1px rgba(240, 90, 44, .12);
}
.mock .mbar { height: 22px; background: #f6ece5; display: flex; gap: 5px; align-items: center; padding: 0 10px; }
.mock .mbar i { width: 7px; height: 7px; border-radius: 50%; background: #f05a2c; }
.mock .mbar i:nth-child(2) { background: #ff9a3c; }
.mock .mbar i:nth-child(3) { background: #ffd2b6; }
.mock img { display: block; width: 100%; height: calc(100% - 22px); object-fit: cover; object-position: top; }
.mock-a { left: 16%; top: 12%; width: 62%; height: 70%; z-index: 3; transform: rotate(-3deg); }
.mock-b { left: 0; top: 24%; width: 34%; height: 50%; z-index: 1; transform: rotate(-7deg); }
.mock-c { right: 0; top: 22%; width: 34%; height: 52%; z-index: 2; transform: rotate(5deg); }
.mplay { position: absolute; right: 7%; bottom: 9%; width: 44px; height: 44px; border-radius: 50%; background: #fff; box-shadow: 0 8px 20px rgba(0, 0, 0, .25); }
.mplay::after { content: ""; position: absolute; left: 17px; top: 13px; border-left: 14px solid #1a1a1a; border-top: 9px solid transparent; border-bottom: 9px solid transparent; }
.hero .proof { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 8px; justify-content: stretch; }
.hero .proof > span {
  display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; column-gap: 14px; row-gap: 2px;
  border-radius: 18px; padding: 14px 16px; background: #fff; line-height: 1.3;
  box-shadow: 0 20px 40px -30px rgba(160, 60, 20, .45);
}
.hero .proof > span .pi {
  width: 44px; height: 44px; border-radius: 14px; flex: none; display: inline-flex; align-items: center; justify-content: center;
  color: var(--orange); background: linear-gradient(135deg, #fff1e8, #ffe0cc); font-style: normal;
}
.hero .proof > span .pi svg { width: 22px; height: 22px; }
.hero .proof > span .pi { grid-row: 1 / span 2; }
.hero .proof > span b { align-self: end; }
.hero .proof b { font-size: 22px; }
#measure h2 em.acc { font-style: normal; color: var(--orange); }
@media (min-width: 1024px) {
  .hero .wrap.hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr); gap: 40px; }
  .hero .proof { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 18px; }
}
@media (prefers-reduced-motion: no-preference) {
  .mock-a { animation: csFloat 7s ease-in-out infinite; }
}
@keyframes csFloat { 0%, 100% { translate: 0 0; } 50% { translate: 0 -8px; } }

/* ---- Case studies hero v2: white canvas, soft shapes, swoosh, layered showcase ---- */
.hero { background: #fff; padding-block: 44px 56px; }
