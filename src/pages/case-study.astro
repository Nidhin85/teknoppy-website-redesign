/* ---- Case studies library: reference compact cards (grid view only; list view keeps full detail) ---- */
#library .head h2 .acc { position: relative; display: inline-block; color: var(--orange); }
#library .head h2 .acc svg { position: absolute; left: 0; bottom: -.14em; width: 100%; height: .16em; color: var(--orange); }
.lib:not(.list) { gap: 20px; }
.lib:not(.list) .csc {
  display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); grid-template-rows: auto auto 1fr auto;
  min-height: 196px; padding: 0; overflow: hidden; border-radius: 20px;
  background: linear-gradient(135deg, #fff 0%, #fff8f3 100%);
  box-shadow: 0 22px 44px -32px rgba(160, 60, 20, .5);
}
.lib:not(.list) .csc .meta { grid-column: 1 / -1; grid-row: 1; position: relative; z-index: 2; padding: 16px 18px 0; }
.lib:not(.list) .csc .big { grid-column: 1; grid-row: 2; position: relative; z-index: 2; padding: 8px 0 0 18px; }
.lib:not(.list) .csc .big b { font-size: 30px; line-height: 1; }
.lib:not(.list) .csc .big small { margin-top: 2px; font-size: 12.5px; }
.lib:not(.list) .csc h3 { grid-column: 1; grid-row: 3; position: relative; z-index: 2; padding: 10px 0 0 18px; font-size: 16.5px; line-height: 1.25; }
