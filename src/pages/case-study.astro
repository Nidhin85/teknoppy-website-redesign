        '<b>' + c.ind + '</b>' +
      '</button>';
    }).join('');

    var sl = $$('.slide', slidesEl);
    var tb = $$('button', tabsEl);
    var si = 0;
    var spot = $('#spot');
    var timer;

    function goS(n) {
      si = (n + sl.length) % sl.length;
      sl.forEach(function(s, i) {
        var on = i === si;
        s.classList.toggle('on', on);
        s.setAttribute('aria-hidden', !on);
        var b = s.querySelector('.btn');
        if (b) b.tabIndex = on ? 0 : -1;
      });
      tb.forEach(function(t, i) {
        t.classList.remove('on');
        void t.offsetWidth;
        t.classList.toggle('on', i === si);
        t.setAttribute('aria-selected', i === si);
      });
      restart();
    }

    function restart() {
      clearTimeout(timer);
      if (!reduce) {
        timer = setTimeout(function() {
          if (!spot.classList.contains('paused')) goS(si + 1);
          else restart();
        }, 7000);
      }
    }

    tb.forEach(function(t, i) {
      t.onclick = function() { goS(i); };
    });

    spot.addEventListener('mouseenter', function() { spot.classList.add('paused'); });
    spot.addEventListener('mouseleave', function() { spot.classList.remove('paused'); });
    spot.addEventListener('focusin', function() { spot.classList.add('paused'); });
    spot.addEventListener('focusout', function() { spot.classList.remove('paused'); });

    /* Touch Swipe */
    var sx = null;
    spot.addEventListener('touchstart', function(e) { sx = e.touches[0].clientX; }, { passive: true });
    spot.addEventListener('touchend', function(e) {
      if (sx === null) return;
      var dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 50) goS(si + (dx < 0 ? 1 : -1));
      sx = null;
    });

    restart();
  }

