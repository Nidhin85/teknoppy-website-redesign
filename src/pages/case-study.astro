.lib:not(.list) .csc .read { padding: 0; border: 0; background: none; color: var(--orange); justify-content: flex-start; font-size: 13.5px; }
.lib:not(.list) .csc:hover .read,
.lib:not(.list) .csc:focus-visible .read { background: none; color: var(--orange); border: 0; }
.lib:not(.list) .csc .new { top: auto; bottom: 14px; right: 14px; z-index: 3; }
.lib:not(.list) .csc .meta { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; }
.lib:not(.list) .csc .meta span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.lib:not(.list) .csc .meta span:first-child { flex: 0 1 auto; }
.lib:not(.list) .csc .meta span:last-child { flex: 0 1 auto; text-align: right; }
