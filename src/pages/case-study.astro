  .cta { grid-template-columns: 1fr; }
}

@media (max-width: 640px) {
  section { padding-block: 68px; }
  /* Phone type scale: the desktop sizes above read oversized on a 390px screen. */
  .crumb { font-size: 13px; }
  .hero h1 { font-size: 32px; line-height: 1.12; letter-spacing: -.04em; margin-top: 18px; }
  .hero .lead { font-size: 15px; line-height: 1.65; margin-top: 16px; }
  .hint { font-size: 12.5px; }
  .proof b { font-size: 15px; }
  .head h2 { font-size: 26px; margin-top: 12px; }
  .head p { font-size: 15px; }
  .slide h3 { font-size: 22px; }
  .slide p { font-size: 14.5px; }
  .mets b { font-size: 24px; }
  .measure h2 { font-size: 26px; }
  .measure .txt > p { font-size: 15px; }
  .cta h3 { font-size: 24px; }
  .tabs b { font-size: 13px; }
  .csc h3 { font-size: 17px; }
  .slide { padding: 28px 22px 20px; gap: 24px; }
  .slide .vis { min-height: 200px; }
  .slide .vis .chip { left: 10px; bottom: 12px; }
  .mets { gap: 18px; }
  .tabs small { display: none; }
  .goals { gap: 12px; }
  .hero .ctas .btn { flex: 1 1 100%; justify-content: center; }
  .mini-search { flex-basis: 100%; }
  .row1 .sel { flex: 1 1 calc(50% - 30px); }
  .proof { gap: 8px; }
  .proof > span { padding: 7px 14px; font-size: 12.5px; }
  .proof b { font-size: 16px; }
  .csc .read { flex: 1; justify-content: center; }
  .goal { padding: 18px; gap: 24px; }
  .goal b { font-size: 17px; }
  .goal span { font-size: 13.5px; }
  .lib { grid-template-columns: 1fr; gap: 24px; }
  /* Phones: single-column cards sat white-on-near-white with a #eee hairline,
     so the stack read as one continuous block. Give each card a defined edge
     and a soft lift so it separates cleanly from its neighbours. */
  .csc {
    border-radius: 22px;
    border-color: #e4e4e4;
    box-shadow: 0 1px 2px rgba(17, 17, 17, .04), 0 12px 28px -18px rgba(17, 17, 17, .22);
  }
  .csc .meta { padding: 20px 20px 0; }
  .csc .big { padding: 12px 20px 0; }
  .csc h3 { padding: 14px 20px 0; }
