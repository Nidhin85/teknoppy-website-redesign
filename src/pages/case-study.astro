---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const metaTitle = "Case Studies | Website, SEO & Marketing Results | Teknoppy Kochi";
const metaDescription = "Read Teknoppy case studies: real website, SEO, e-commerce and social media projects for clients in Kerala, the UAE and Qatar, with the problem, the work and the results.";
const canonicalURL = "https://www.teknoppy.com/case-study/";

// Schema.org Structured Data
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://www.teknoppy.com/case-study/#webpage",
      "name": "Teknoppy Case Studies",
      "description": metaDescription,
      "url": canonicalURL,
      "publisher": {
        "@type": "Organization",
        "@id": "https://www.teknoppy.com/#organization",
        "name": "Teknoppy",
        "url": "https://www.teknoppy.com/",
        "logo": "https://www.teknoppy.com/logo.svg",
        "telephone": "+91 6282249224"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.teknoppy.com/case-study/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.teknoppy.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Case Studies",
          "item": canonicalURL
        }
      ]
    }
  ]
};
---

<Layout title={metaTitle} description={metaDescription} canonical={canonicalURL} image="/case-studies/generaltech.webp">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Reading Progress Bar -->
  <div id="progress" aria-hidden="true"></div>

  <!-- Shared Sitewide Header with Solid Background -->
  <Header forceSolidBg={true} />

  <main class="case-study-hub" id="top">
    <!-- HERO SECTION -->
    <header class="hero">
      <span class="hero-blob hero-blob-l" aria-hidden="true"></span>
      <span class="hero-blob hero-blob-r" aria-hidden="true"></span>
      <div class="wrap hero-grid">
        <div class="hero-copy">
        <div class="crumb fadeup" style="--d:1">
          <a href="/">Home</a><span>/</span><span>Case studies</span>
        </div>
        <span class="tag fadeup" style="--d:1">Case studies</span>
        <h1 class="fadeup" style="--d:2">Real projects. <em>Real numbers.<svg class="swoosh" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M6 11C80 4 200 3 294 8" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></em></h1>
        <p class="lead fadeup" style="--d:3">
          The brief, the work and the results behind our client projects in Kerala, the UAE and Qatar. Start with a featured story, or filter every case study by industry, service or region.
        </p>
        <div class="ctas fadeup" style="--d:4">
          <a class="btn btn-primary" href="#library">Explore all case studies <span class="arr">↓</span></a>
          <a class="btn btn-ghost btn-play" href="/portfolios/"><span class="pl" aria-hidden="true"></span>View portfolio <span class="arr">→</span></a>
        </div>
        <p class="hint fadeup" style="--d:4">
          Just want to see our designs? The portfolio shows 120+ websites at a glance.
        </p>
        </div>
        <!-- Hero visual: stacked browser mockups of real case-study screenshots -->
        <div class="hero-art fadeup" style="--d:3" aria-hidden="true">
          <span class="hero-arc"></span>
          <span class="hero-spark"><i></i><i></i><i></i></span>
          <div class="mock mock-b"><div class="mbar"><i></i><i></i><i></i></div><img src="/case-studies/generaltech.webp" alt="" loading="eager" decoding="async" /></div>
          <div class="mock mock-c"><div class="mbar"><i></i><i></i><i></i></div><img src="/case-studies/olivesresort.webp" alt="" loading="eager" decoding="async" /></div>
          <div class="mock mock-a"><div class="mbar"><i></i><i></i><i></i></div><img src="/case-studies/roja-houseboats.webp" alt="" loading="eager" decoding="async" /><span class="mplay"></span></div>
        </div>
        <div class="proof fadeup" style="--d:5" aria-label="Case study highlights">
          <span><i class="pi" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg></i><b><span class="cnt" data-to="12">12</span></b> verified case studies</span>
          <span><i class="pi" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4M10 10h4M10 14h4M10 18h4"/></svg></i><b><span class="cnt" data-to="8">8</span></b> industries</span>
          <span><i class="pi" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg></i><b><i class="fill">+<span class="cnt" data-to="180">180</span>%</i></b> average traffic growth</span>
          <span><i class="pi" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></i><b><span class="cnt" data-to="3">3</span></b> countries: India, UAE, Qatar</span>
        </div>
      </div>
    </header>

    <!-- FEATURED SPOTLIGHT -->
    <section id="featured">
      <div class="wrap">
        <div class="head rv">
          <div>
            <span class="tag">Featured</span>
            <h2>Stories worth starting with</h2>
          </div>
          <p>
            Three projects that show how we work across websites, e-commerce and lead generation. <a class="tlink" href="#library">Or browse all case studies ↓</a>
          </p>
        </div>
        <div class="spot rv" id="spot">
          <div class="slides" id="slides"></div>
          <div class="tabs" id="tabs" role="tablist"></div>
        </div>
      </div>
    </section>

    <!-- LIBRARY & FILTERS -->
    <section id="library" style="padding-top:20px">
      <div class="wrap">
        <div class="head rv">
          <div>
            <span class="tag">All case studies</span>
            <h2>Explore every <span class="acc">story<svg viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true"><path d="M4 9C30 3 70 3 96 7" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span></h2>
          </div>
          <p>
            Filter by industry, service or region. Each card shows the headline result first, so you can see what changed at a glance.
          </p>
        </div>
        <div class="bar2" id="bar2">
          <div class="row1">
            <label class="mini-search" id="ms">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
              <input id="q" type="search" placeholder="Search case studies" aria-label="Search case studies">
              <button type="button" id="qx" aria-label="Clear search">✕</button>
            </label>
            <div class="sel"><select id="ind" aria-label="Industry"></select></div>
            <div class="sel">
              <select id="reg" aria-label="Region">
                <option value="all">All regions</option>
                <option value="kerala">Kerala</option>
                <option value="uae">UAE</option>
                <option value="qatar">Qatar</option>
              </select>
            </div>
            <div class="sel">
              <select id="sort" aria-label="Sort">
                <option value="new">Newest first</option>
                <option value="old">Oldest first</option>
                <option value="az">A to Z</option>
              </select>
            </div>
            <div class="views" role="group" aria-label="Layout">
              <button class="on" data-v="grid" aria-label="Grid view">
                <svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg>
              </button>
              <button data-v="list" aria-label="List view">
                <svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="4" width="18" height="4" rx="2"/><rect x="3" y="10" width="18" height="4" rx="2"/><rect x="3" y="16" width="18" height="4" rx="2"/></svg>
              </button>
            </div>
          </div>
          <div class="chips" id="chips" aria-label="Filter by service"></div>
        </div>
        <div class="status">
          <p id="count" aria-live="polite"></p>
          <div class="active" id="active"></div>
        </div>
        <div class="lib" id="lib"></div>
        <div class="more-wrap" id="moreWrap" hidden>
          <button type="button" class="btn btn-ghost" id="loadMore">Load More Case Studies <span class="arr">↓</span></button>
        </div>
        <div class="empty" id="empty">
          <b>No case studies match that yet</b>
          <span>Try a different filter, or ask us for examples from your industry.</span>
          <button class="btn btn-ghost" id="reset">Clear all filters</button>
        </div>
      </div>
    </section>

    <!-- BROWSE BY GOAL -->
    <section id="goals" style="padding-top:20px">
      <div class="wrap">
        <div class="head rv">
          <div>
            <span class="tag">Browse by goal</span>
            <h2>What do you want <span class="acc">more of?<svg class="sw" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true"><path d="M4 9C30 3 70 3 96 7" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span></h2>
          </div>
          <p>
            Not sure where to start? Pick the result you're after and we'll filter the case studies above to show where we delivered it.
          </p>
        </div>
        <div class="goals" id="goalTiles"></div>
      </div>
    </section>

    <!-- HOW WE MEASURE -->
    <section id="measure" style="background:var(--surface);border-block:1px solid var(--line)">
      <div class="wrap measure">
        <div class="txt rv">
          <span class="tag">How we report results</span>
          <h2>Every number on this page can be <span class="acc">checked<svg class="sw" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true"><path d="M4 9C30 3 70 3 96 7" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span></h2>
          <p>
            We only publish figures the client has agreed to share, taken from their own analytics. Each case study names its data source and date range.
          </p>
        </div>
        <div class="steps">
          <div class="step rv">
            <i>01</i>
            <span class="sic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg></span>
            <div>
              <b>A baseline before we start</b>
              <span>Traffic, rankings, leads and speed are recorded in week one, so there's an honest "before".</span>
            </div>
          </div>
          <div class="step rv" style="--d:1">
            <i>02</i>
            <span class="sic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></span>
            <div>
              <b>Goals agreed with the client</b>
              <span>Every project has two or three measurable targets, written down before design starts.</span>
            </div>
          </div>
          <div class="step rv" style="--d:2">
            <i>03</i>
            <span class="sic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg></span>
            <div>
              <b>Data from the client's own tools</b>
              <span>Google Analytics 4, Search Console, Google Business Profile and ad dashboards, never our own estimates.</span>
            </div>
          </div>
          <div class="step rv" style="--d:3">
            <i>04</i>
            <span class="sic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></span>
            <div>
              <b>Published with permission</b>
              <span>Clients review their case study before it goes live. Some prefer to stay anonymous, and we respect that.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VERIFIED CLIENT VOICES -->
    <section id="voices">
      <div class="wrap">
        <div class="head rv">
          <div>
            <span class="tag">From our clients</span>
            <h2>In their <span class="acc">own words<svg class="sw" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true"><path d="M4 9C30 3 70 3 96 7" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span></h2>
          </div>
          <p>Short quotes from the clients behind these case studies. Each one links to the full story.</p>
        </div>
        <div class="qwall">
          <div class="qc rv">
            <span class="qstars" aria-hidden="true">★★★★★</span>
            <q>"We now rank at the top of Google for our keywords and get many direct booking calls due to better visibility. Thank you Teknoppy for all the support."</q>
            <div class="who">
              <span class="av"><img src="/testimonials/biju-thomas.webp" alt="Biju Thomas" loading="lazy" /></span>
              <div>
                <b>Biju Thomas · CEO, Olives Resort</b>
              </div>
            </div>
            <a class="qlink" href="/case-studies/olives-boutique-resort-digital-marketing/"><span class="qth" aria-hidden="true"><img src="/case-studies/olivesresort.webp" alt="" loading="lazy" /></span><span class="ql">Olives Resort case study</span> <span class="ga">→</span></a>
          </div>
          <div class="qc rv" style="--d:1">
            <span class="qstars" aria-hidden="true">★★★★★</span>
            <q>"Mr. Sanal is exceptionally supportive and customer-friendly. I have worked with many IT teams, but I am 100% happy with Teknoppy. No doubt, I recommend them with 100% satisfaction."</q>
            <div class="who">
              <span class="av"><img src="/testimonials/dr-asghar.webp" alt="Dr. Asghar" loading="lazy" /></span>
              <div>
                <b>Dr. Asghar · CEO, Greens Ayurveda</b>
              </div>
            </div>
            <a class="qlink" href="/portfolios/website-projects/"><span class="qth" aria-hidden="true"><img src="/case-studies/greensayurveda.webp" alt="" loading="lazy" /></span><span class="ql">See the Greens Ayurveda website</span> <span class="ga">→</span></a>
          </div>
          <div class="qc rv" style="--d:2">
            <span class="qstars" aria-hidden="true">★★★★★</span>
            <q>"Teknoppy did an exceptional job building my personal brand website and digital identity. Truly professional team, timely execution, and a seamless experience throughout."</q>
            <div class="who">
              <span class="av"><img src="/testimonials/lenaa.webp" alt="Lenaa" loading="lazy" /></span>
              <div>
                <b>Lenaa · Actor, Author &amp; TEDx Speaker</b>
              </div>
            </div>
            <a class="qlink" href="/lenaa-personal-brand-website-case-study/"><span class="qth" aria-hidden="true"><img src="/case-studies/lenaalife.webp" alt="" loading="lazy" /></span><span class="ql">Lenaa personal brand story</span> <span class="ga">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- CLOSING CTA BANNER -->
    <div class="wrap" id="contact" style="padding-bottom:90px">
      <div class="cta rv">
        <div class="l">
          <span class="cic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4M10 10h4M10 14h4M10 18h4"/></svg></span>
          <h3>Don't see your industry?</h3>
          <p>We've worked with more businesses than we can publish here. Ask, and we'll share a project similar to yours.</p>
          <a class="btn btn-primary" href="/contact-us/">Ask for examples <span class="arr">→</span></a>
        </div>
        <div class="r">
          <span class="cic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/></svg></span>
          <h3>Want to be our next case study?</h3>
          <p>Get a free audit of your website and Google presence. We reply within one business day.</p>
          <a class="btn" href="/request-a-quote/">Get a free audit <span class="arr">→</span></a>
        </div>
      </div>
    </div>
  </main>

  <!-- Shared Sitewide Footer -->
  <Footer />
</Layout>

<style is:global>
/* Teknoppy Case Study Hub — Design Tokens & Scoped Styles */
:root {
  --bg: #fcfcfc;
  --surface: #ffffff;
  --ink: #1a1a1a;
  --muted: #555555;
  --soft: #8a8a8a;
  --line: #eeeeee;
  --orange: #f15a24;
  --tint: #fff1eb;
  --tint-line: #ffe0d2;
  --display: "Sora", "Segoe UI", system-ui, sans-serif;
  --body: "Manrope", "Segoe UI", system-ui, sans-serif;
  --r: 24px;
  --ease: cubic-bezier(.2, .8, .2, 1);
}

.case-study-hub {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--body);
  font-size: 16px;
  line-height: 1.65;
  overflow-x: hidden;
  padding-top: 76px;
}

.case-study-hub h1,
.case-study-hub h2,
.case-study-hub h3,
.case-study-hub h4 {
  font-family: var(--display);
  margin: 0;
  line-height: 1.12;
  letter-spacing: -.03em;
  text-wrap: balance;
}

.case-study-hub p { margin: 0; }
.case-study-hub a { color: inherit; }
.case-study-hub button,
.case-study-hub input,
.case-study-hub select { font-family: inherit; color: inherit; }

.wrap { max-width: 1220px; margin: 0 auto; padding-inline: 20px; box-sizing: border-box; }
section { padding-block: 96px; }

.fill {
  background: var(--tint);
  color: var(--orange);
  border: 1px dashed #f8b597;
  border-radius: 6px;
  padding: 0 5px;
  font-weight: 700;
  font-style: normal;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

#progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 3px;
  width: 100%;
  background: var(--orange);
  transform-origin: left;
  transform: scaleX(0);
  z-index: 120;
  pointer-events: none;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12.5px;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--orange);
  background: var(--tint);
  border: 1px solid var(--tint-line);
  padding: 6px 14px;
  border-radius: 999px;
}
.tag::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--orange);
  animation: cs-blink 1.6s infinite;
}
@keyframes cs-blink { 50% { opacity: .25; } }

.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}
.head h2 {
  font-size: clamp(30px, 4.2vw, 52px);
  margin-top: 16px;
  max-width: 18ch;
}
.head p {
  color: var(--muted);
  font-size: 17px;
  max-width: 46ch;
}

.btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 15px;
  text-decoration: none;
  overflow: hidden;
  isolation: isolate;
  border: 0;
  cursor: pointer;
  transition: transform .3s, color .3s, border-color .3s, background .3s;
  white-space: nowrap;
}
.btn-primary {
  background: var(--orange);
  color: #fff !important;
  box-shadow: 0 10px 26px -12px rgba(241, 90, 36, .75);
}
.btn-primary::before {
  content: "";
  position: absolute;
  top: 0;
  left: -60%;
  width: 40%;
  height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .45), transparent);
  transform: skewX(-20deg);
  transition: left .7s;
  z-index: -1;
}
.btn-primary:hover::before { left: 130%; }
.btn-ghost {
  border: 1.5px solid var(--line);
  background: var(--surface);
  color: var(--ink);
}
.btn-ghost:hover {
  border-color: var(--orange);
  color: var(--orange);
}
.btn:hover { transform: translateY(-2px); }
.btn .arr { transition: transform .3s; }
.btn:hover .arr { transform: translateX(5px); }

/* HERO */
.hero {
  position: relative;
  padding-block: 52px 40px;
  overflow: hidden;
}
.hero::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -380px;
  width: 1000px;
  height: 900px;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(241, 90, 36, .12), transparent 62%);
  animation: cs-glow 9s ease-in-out infinite;
  pointer-events: none;
}
@keyframes cs-glow { 50% { transform: translateX(-50%) scale(1.12); } }
.hero .wrap { position: relative; text-align: center; }
.crumb {
  font-size: 14px;
  color: var(--soft);
  display: flex;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 18px;
}
.crumb a { color: var(--muted); text-decoration: none; }
.crumb a:hover { color: var(--orange); }
.hero h1 {
  font-size: clamp(38px, 6.6vw, 84px);
  font-weight: 800;
  letter-spacing: -.055em;
  line-height: 1.05;
  margin: 22px auto 0;
  max-width: 15ch;
}
.hero h1 em { font-style: normal; color: var(--orange); }
.hero .lead {
  color: var(--muted);
  font-size: 18px;
  max-width: 58ch;
  margin: 22px auto 0;
}
.hero .ctas {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 30px;
}
.hint {
  margin-top: 14px;
  font-size: 14px;
  color: var(--soft);
  font-weight: 600;
}
.proof {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 36px;
}
.proof > span {
  display: inline-flex;
  gap: 8px;
  align-items: baseline;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 9px 18px;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--muted);
  transition: border-color .3s, transform .3s;
}
.proof > span:hover {
  border-color: var(--tint-line);
  transform: translateY(-2px);
}
.proof b {
  font-family: var(--display);
  font-size: 19px;
  color: var(--ink);
  letter-spacing: -.03em;
}
.tlink {
  color: var(--orange);
  font-weight: 800;
  text-decoration: none;
  white-space: nowrap;
}
.tlink:hover { text-decoration: underline; }

.fadeup {
  animation: cs-fadeup .9s var(--ease) both;
  animation-delay: calc(var(--d, 0) * 110ms);
}
@keyframes cs-fadeup {
  from { opacity: 0; transform: translateY(24px); }
}

/* FEATURED SPOTLIGHT */
#featured { padding-top: 56px; }
.spot {
  position: relative;
  border-radius: 34px;
  background: var(--ink);
  color: #fff;
  overflow: hidden;
  isolation: isolate;
}
.spot::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(255, 255, 255, .07) 1px, transparent 1px);
  background-size: 22px 22px;
  z-index: -2;
}
.spot::before {
  content: "";
  position: absolute;
  width: 600px;
  height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(241, 90, 36, .45), transparent 62%);
  left: -200px;
  bottom: -320px;
  z-index: -1;
  animation: cs-glow 8s ease-in-out infinite;
}
.slides { display: grid; }
.slide {
  grid-area: 1/1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  padding: 52px 52px 30px;
  opacity: 0;
  visibility: hidden;
  transition: opacity .6s, visibility .6s;
}
.slide.on { opacity: 1; visibility: visible; }
.slide .txt {
  display: flex;
  flex-direction: column;
  gap: 16px;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
}
.slide .lbl {
  font-size: 12.5px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--orange);
}
.slide h3 {
  font-size: clamp(26px, 3.4vw, 42px);
  letter-spacing: -.045em;
  color: #fff;
  transform: translateY(20px);
  opacity: 0;
  transition: all .7s var(--ease) .1s;
}
.slide p {
  color: rgba(255, 255, 255, .75);
  font-size: 16px;
  max-width: 46ch;
  transform: translateY(20px);
  opacity: 0;
  transition: all .7s var(--ease) .2s;
}
.slide.on h3,
.slide.on p,
.slide.on .mets {
  transform: none;
  opacity: 1;
}
.mets {
  display: flex;
  gap: 28px;
  flex-wrap: wrap;
  margin-block: 6px;
  transform: translateY(20px);
  opacity: 0;
  transition: all .7s var(--ease) .3s;
}
.mets b {
  display: block;
  font-family: var(--display);
  font-size: clamp(26px, 3vw, 40px);
  letter-spacing: -.05em;
  line-height: 1.1;
  color: var(--orange);
}
.mets small {
  color: rgba(255, 255, 255, .6);
  font-weight: 700;
  font-size: 13px;
}
.slide .vis {
  position: relative;
  min-height: 380px;
}
.slide .vis-wrap {
  position: absolute;
  inset: 0;
  border-radius: 22px;
  overflow: hidden;
  border: 4px solid rgba(255, 255, 255, .1);
  box-shadow: 0 20px 50px -20px rgba(0, 0, 0, .8);
  transform: scale(.95) rotate(2deg);
  transition: transform 1s var(--ease);
  background: #111;
}
.slide .vis-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}
.slide.on .vis-wrap { transform: none; }
.slide .vis .chip {
  position: absolute;
  left: -14px;
  bottom: 24px;
  background: #fff;
  color: var(--ink);
  border-radius: 16px;
  padding: 12px 18px;
  font-weight: 800;
  font-size: 14px;
  box-shadow: 0 20px 40px -20px rgba(0, 0, 0, .6);
  display: flex;
  gap: 12px;
  align-items: center;
  animation: cs-bob 5s ease-in-out infinite;
  z-index: 2;
}
.slide .vis .chip > i {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: var(--orange);
  color: #fff;
  display: grid;
  place-items: center;
  font-style: normal;
  font-weight: 800;
}
.slide .vis .chip small {
  display: block;
  color: var(--soft);
  font-size: 11.5px;
  font-weight: 700;
}
@keyframes cs-bob { 50% { transform: translateY(-8px); } }

.tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid rgba(255, 255, 255, .12);
}
.tabs button {
  all: unset;
  cursor: pointer;
  padding: 20px 28px 22px;
  position: relative;
  border-right: 1px solid rgba(255, 255, 255, .12);
  display: grid;
  gap: 2px;
  transition: background .3s;
}
.tabs button:last-child { border-right: 0; }
.tabs button:hover { background: rgba(255, 255, 255, .04); }
.tabs button:focus-visible { outline: 3px solid var(--orange); outline-offset: -3px; }
.tabs small {
  font-size: 12px;
  font-weight: 800;
  color: rgba(255, 255, 255, .45);
  letter-spacing: .08em;
  text-transform: uppercase;
}
.tabs b {
  font-family: var(--display);
  font-size: 16px;
  color: rgba(255, 255, 255, .65);
  transition: color .3s;
}
.tabs button.on b { color: #fff; }
.tabs .bar {
  position: absolute;
  left: 0;
  top: -1px;
  height: 3px;
  width: 0;
  background: var(--orange);
}
.tabs button.on .bar { animation: cs-fillbar var(--dur, 7s) linear forwards; }
.spot.paused .tabs button.on .bar { animation-play-state: paused; }
@keyframes cs-fillbar { to { width: 100%; } }

/* GOALS */
.goals {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.goal {
  all: unset;
  box-sizing: border-box;
  cursor: pointer;
  position: relative;
  border-radius: 24px;
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 26px;
  display: grid;
  gap: 40px;
  overflow: hidden;
  isolation: isolate;
  transition: color .45s, border-color .45s, transform .45s var(--ease);
}
.goal::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--orange);
  clip-path: circle(0% at 100% 0);
  transition: clip-path .6s var(--ease);
  z-index: -1;
}
.goal:hover,
.goal:focus-visible {
  color: #fff;
  border-color: var(--orange);
  transform: translateY(-5px);
}
.goal:hover::before,
.goal:focus-visible::before {
  clip-path: circle(150% at 100% 0);
}
.goal .top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.goal .ic {
  width: 50px;
  height: 50px;
  border-radius: 15px;
  background: var(--tint);
  color: var(--orange);
  display: grid;
  place-items: center;
  transition: all .45s;
}
.goal .ic svg { width: 24px; height: 24px; }
.goal:hover .ic {
  background: rgba(255, 255, 255, .2);
  color: #fff;
}
.goal .go {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1.5px solid var(--line);
  display: grid;
  place-items: center;
  transition: all .45s var(--ease);
}
.goal:hover .go {
  border-color: #fff;
  transform: rotate(-45deg);
}
.goal b {
  font-family: var(--display);
  font-size: 20px;
  display: block;
  letter-spacing: -.02em;
}
.goal span {
  font-size: 14.5px;
  color: var(--muted);
  transition: color .45s;
}
.goal:hover span { color: rgba(255, 255, 255, .85); }
.goal em {
  display: block;
  font-style: normal;
  font-weight: 800;
  font-size: 13px;
  color: var(--orange);
  margin-top: 8px;
  transition: color .45s;
}
.goal:hover em { color: #fff; }

/* LIBRARY */
#library { padding-top: 20px; }
.bar2 {
  position: sticky;
  top: 73px;
  z-index: 30;
  background: rgba(252, 252, 252, .95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
  padding-block: 14px;
  margin-bottom: 22px;
  display: grid;
  gap: 12px;
}
.row1 {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}
.mini-search {
  flex: 1;
  min-width: 220px;
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: 999px;
  padding: 0 16px;
  transition: border-color .3s;
}
.mini-search:focus-within { border-color: var(--orange); }
.mini-search svg { width: 17px; height: 17px; color: var(--soft); flex: none; }
.mini-search input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: none;
  padding: 11px 0;
  font-weight: 600;
  font-size: 14.5px;
}
.mini-search button {
  border: 0;
  background: var(--bg);
  border-radius: 999px;
  width: 24px;
  height: 24px;
  cursor: pointer;
  display: none;
  font-size: 12px;
}
.mini-search.has button { display: block; }

.sel { position: relative; }
.sel select {
  appearance: none;
  -webkit-appearance: none;
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: 999px;
  padding: 11px 38px 11px 16px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: border-color .3s;
}
.sel select:hover,
.sel select:focus {
  border-color: var(--orange);
  outline: 0;
}
.sel::after {
  content: "";
  position: absolute;
  right: 16px;
  top: 50%;
  width: 7px;
  height: 7px;
  border-right: 2px solid var(--ink);
  border-bottom: 2px solid var(--ink);
  transform: translateY(-70%) rotate(45deg);
  pointer-events: none;
}

.views {
  display: flex;
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: 999px;
  padding: 3px;
}
.views button {
  border: 0;
  background: none;
  width: 38px;
  height: 36px;
  border-radius: 999px;
  cursor: pointer;
  display: grid;
  place-items: center;
  color: var(--soft);
  transition: all .3s;
}
.views button svg { width: 17px; height: 17px; }
.views button.on {
  background: var(--ink);
  color: #fff;
}

.chips {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  padding: 2px;
}
.chips::-webkit-scrollbar { display: none; }
.chip {
  flex: none;
  border: 1.5px solid var(--line);
  background: var(--surface);
  border-radius: 999px;
  padding: 7px 15px;
  font-weight: 700;
  font-size: 13.5px;
  cursor: pointer;
  transition: all .3s;
  display: flex;
  gap: 7px;
  align-items: center;
}
.chip sup {
  font-size: 11px;
  font-weight: 800;
  color: var(--soft);
  background: var(--bg);
  border-radius: 999px;
  padding: 0 7px;
  line-height: 1.7;
}
.chip:hover { border-color: var(--orange); color: var(--orange); }
.chip.on {
  background: var(--orange);
  border-color: var(--orange);
  color: #fff;
}
.chip.on sup {
  background: rgba(255, 255, 255, .25);
  color: #fff;
}

.status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}
.status p {
  color: var(--soft);
  font-weight: 700;
  font-size: 14px;
}
.status p b { color: var(--ink); }
.active { display: flex; gap: 6px; flex-wrap: wrap; }
.active button {
  border: 0;
  background: var(--tint);
  color: var(--orange);
  font-weight: 800;
  font-size: 12.5px;
  padding: 4px 10px;
  border-radius: 999px;
  cursor: pointer;
}
.active button.clear {
  background: none;
  color: var(--muted);
  text-decoration: underline;
}

.lib {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}
.csc {
  position: relative;
  border-radius: 26px;
  background: var(--surface);
  border: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  text-decoration: none;
  transition: transform .45s var(--ease), border-color .3s, box-shadow .45s;
}
.csc:hover,
.csc:focus-visible {
  transform: translateY(-6px);
  border-color: var(--tint-line);
  box-shadow: 0 30px 60px -38px rgba(241, 90, 36, .6);
}
.csc.hide { display: none; }
.csc.pop {
  animation: cs-pop .6s var(--ease) both;
  animation-delay: calc(var(--k, 0) * 55ms);
}
@keyframes cs-pop { from { opacity: 0; transform: translateY(24px); } }

.csc .meta {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: center;
  padding: 22px 24px 0;
  font-size: 12.5px;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--soft);
}
.csc .meta span:first-child { color: var(--orange); }

.csc .big { padding: 14px 24px 0; }
.csc .big b {
  display: block;
  font-family: var(--display);
  font-size: clamp(34px, 3.6vw, 48px);
  letter-spacing: -.06em;
  line-height: 1;
  color: var(--ink);
  transition: color .3s;
}
.csc:hover .big b { color: var(--orange); }
.csc .big small {
  display: block;
  color: var(--muted);
  font-weight: 700;
  font-size: 14px;
  margin-top: 6px;
}

.csc h3 {
  font-size: 19px;
  letter-spacing: -.025em;
  padding: 16px 24px 0;
  line-height: 1.3;
}
.csc .flow {
  display: grid;
  gap: 6px;
  padding: 14px 24px 0;
  font-size: 14px;
  color: var(--muted);
}
.csc .flow div {
  display: grid;
  grid-template-columns: 76px 1fr;
  gap: 8px;
}
.csc .flow em {
  font-style: normal;
  font-weight: 800;
  font-size: 11.5px;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--ink);
  padding-top: 2px;
}

.csc .thumb {
  margin: 20px 12px 0;
  border-radius: 16px;
  height: 165px;
  overflow: hidden;
  background: var(--tint);
  position: relative;
}
.csc .thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  transition: transform .6s var(--ease);
}
.csc:hover .thumb img { transform: scale(1.06); }

.csc .foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 16px 22px 20px;
  margin-top: auto;
  flex-wrap: wrap;
}
.svc { display: flex; gap: 6px; flex-wrap: wrap; }
.svc span {
  font-size: 12px;
  font-weight: 700;
  color: var(--muted);
  background: var(--bg);
  border: 1px solid var(--line);
  padding: 2px 10px;
  border-radius: 999px;
}
.csc .read {
  flex: none;
  display: inline-flex;
  gap: 8px;
  align-items: center;
  font-weight: 800;
  font-size: 13.5px;
  padding: 9px 15px;
  border-radius: 999px;
  border: 1.5px solid var(--line);
  color: var(--ink);
  transition: all .3s;
  white-space: nowrap;
}
.csc .read .arr { transition: transform .3s; }
.csc:hover .read,
.csc:focus-visible .read {
  background: var(--orange);
  border-color: var(--orange);
  color: #fff;
}
.csc:hover .read .arr { transform: translateX(4px); }
.lib:not(.list) .csc .foot { flex-direction: column; align-items: stretch; gap: 14px; }
.lib:not(.list) .csc .read { justify-content: center; }

.csc .new {
  position: absolute;
  right: 16px;
  top: 18px;
  background: var(--orange);
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  padding: 3px 10px;
  border-radius: 999px;
  letter-spacing: .04em;
}

mark {
  background: #ffe0d2;
  color: inherit;
  border-radius: 3px;
  padding: 0 1px;
}

/* LIST VIEW */
.lib.list {
  grid-template-columns: 1fr;
  gap: 14px;
}
.lib.list .csc {
  display: grid;
  grid-template-columns: 240px 1fr 240px;
  grid-template-rows: auto auto 1fr;
  column-gap: 26px;
  padding: 16px;
  align-items: start;
}
.lib.list .thumb {
  grid-column: 1;
  grid-row: 1/4;
  margin: 0;
  height: 100%;
  min-height: 180px;
}
.lib.list .meta { grid-column: 2; padding: 4px 0 0; }
.lib.list h3 { grid-column: 2; padding: 8px 0 0; font-size: 21px; }
.lib.list .flow { grid-column: 2; padding: 10px 0 0; }
.lib.list .big { grid-column: 3; grid-row: 1/3; padding: 8px 0 0; text-align: right; }
.lib.list .big b { font-size: 44px; }
.lib.list .foot { grid-column: 3; grid-row: 3; flex-direction: column; align-items: flex-end; padding: 12px 0 0; align-self: end; }
.lib.list .svc { justify-content: flex-end; }
.lib.list .new { top: 26px; left: 26px; right: auto; }

.empty {
  display: none;
  text-align: center;
  padding: 60px 20px;
  border: 1.5px dashed #e2dcd8;
  border-radius: 24px;
  color: var(--muted);
  gap: 12px;
  justify-items: center;
}
.empty.on { display: grid; }
.empty b { font-family: var(--display); font-size: 20px; color: var(--ink); }

/* HOW WE MEASURE */
.measure {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 56px;
  align-items: center;
}
.measure h2 { font-size: clamp(30px, 4vw, 50px); margin-top: 16px; }
.measure .txt > p { color: var(--muted); font-size: 17px; margin-top: 16px; }
.steps { display: grid; gap: 12px; }
.step {
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 18px;
  align-items: start;
  padding: 20px 22px;
  border-radius: 20px;
  background: var(--surface);
  border: 1px solid var(--line);
  transition: border-color .3s, transform .4s var(--ease);
}
.step:hover {
  border-color: var(--tint-line);
  transform: translateX(6px);
}
.step i {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: var(--tint);
  color: var(--orange);
  display: grid;
  place-items: center;
  font-style: normal;
  font-family: var(--display);
  font-weight: 800;
  font-size: 18px;
}
.step b { font-family: var(--display); font-size: 18px; display: block; }
.step span { color: var(--muted); font-size: 15px; }

/* QUOTES STRIP */
.qwall {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.qc {
  border-radius: 24px;
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 28px;
  display: grid;
  gap: 18px;
  align-content: space-between;
  position: relative;
  overflow: hidden;
}
.qc::before {
  content: "“";
  position: absolute;
  right: 18px;
  top: -24px;
  font-family: var(--display);
  font-size: 140px;
  line-height: 1;
  color: var(--tint);
}
.qc q { position: relative; font-size: 15.5px; line-height: 1.6; quotes: none; color: var(--ink); }
.qc .who { display: flex; gap: 14px; align-items: center; }
.qc .av {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  overflow: hidden;
  background: var(--tint);
  border: 2px solid var(--tint-line);
  flex: none;
}
.qc .av img { width: 100%; height: 100%; object-fit: cover; }
.qc .who b { display: block; font-family: var(--display); font-size: 15px; color: var(--ink); }
.qc .who a { color: var(--orange); font-weight: 800; font-size: 13px; text-decoration: none; }
.qc .who a:hover { text-decoration: underline; }

/* CTA BANNER */
.cta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-radius: 34px;
  overflow: hidden;
  border: 1px solid var(--tint-line);
}
.cta > div {
  padding: 52px 44px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
  position: relative;
  overflow: hidden;
  isolation: isolate;
  min-width: 0;
}
.cta h3 { font-size: clamp(26px, 3.2vw, 40px); letter-spacing: -.04em; }
.cta p { font-size: 16.5px; max-width: 38ch; }
.cta .l { background: var(--tint); }
.cta .l p { color: var(--muted); }
.cta .r { background: var(--orange); color: #fff; }
.cta .r h3 { color: #fff; }
.cta .r p { color: rgba(255, 255, 255, .9); }
.cta .r .btn { background: #fff; color: var(--orange) !important; }
.cta .r::before {
  content: "";
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  border: 40px solid rgba(255, 255, 255, .12);
  right: -100px;
  bottom: -120px;
  animation: cs-spin 26s linear infinite;
  z-index: -1;
}
@keyframes cs-spin { to { transform: rotate(360deg); } }

.js .rv {
  opacity: 0;
  transform: translateY(36px);
  transition: opacity .9s, transform .9s var(--ease);
  transition-delay: calc(var(--d, 0) * 90ms);
}
.js .rv.in { opacity: 1; transform: none; }

/* RESPONSIVE MEDIA QUERIES */
@media (max-width: 1060px) {
  .lib { grid-template-columns: 1fr 1fr; }
  .goals { grid-template-columns: 1fr 1fr; }
  .slide { grid-template-columns: 1fr; padding: 36px 32px 24px; }
  .slide .vis { min-height: 260px; }
