/* ---- Browse by goal + How we report: reference styling ---- */
#goals h2 .acc, #measure h2 .acc { position: relative; display: inline-block; color: var(--orange); }
#goals h2 .acc .sw, #measure h2 .acc .sw { position: absolute; left: 0; bottom: -.14em; width: 100%; height: .16em; }
#measure h2 em.acc { color: inherit; }

/* goal cards: tinted per goal, wave corner, sparkle, round arrow bottom-right */
.goal { --gc: #f05a2c; --gt: #fff1e8; --gw: #ffd7bf; gap: 0; padding: 24px 24px 22px; min-height: 230px; align-content: start;
  background: linear-gradient(160deg, #fff 30%, var(--gt) 100%); border-color: color-mix(in srgb, var(--gc) 16%, #fff);
  box-shadow: 0 22px 44px -34px rgba(120, 50, 20, .45); }
.goal:nth-child(2) { --gc: #7c3aed; --gt: #f4eefe; --gw: #ddd0fb; }
.goal:nth-child(3) { --gc: #16a34a; --gt: #ecf9f0; --gw: #c9ecd5; }
.goal:nth-child(4) { --gc: #1d6fd8; --gt: #edf4fd; --gw: #cfe1f8; }
.goal::before { clip-path: none; inset: auto -10% -20% 35%; height: 70%; border-radius: 60% 40% 0 0; background: var(--gw); opacity: .55; z-index: -1; transition: opacity .4s; }
.goal::after { content: ""; position: absolute; left: 84px; top: 14px; width: 18px; height: 18px;
  background: linear-gradient(var(--gc), var(--gc)) 2px 0 / 3px 8px no-repeat, linear-gradient(var(--gc), var(--gc)) 10px 6px / 8px 3px no-repeat;
  transform: rotate(20deg); opacity: .85; }
.goal:hover, .goal:focus-visible { color: inherit; border-color: var(--gc); transform: translateY(-5px); }
.goal:hover::before, .goal:focus-visible::before { clip-path: none; opacity: .85; }
.goal .top { display: block; }
.goal .ic { width: 52px; height: 52px; border-radius: 16px; background: var(--gt); color: var(--gc); margin-bottom: 16px; }
.goal:hover .ic { background: var(--gt); color: var(--gc); }
.goal .go { position: absolute; right: 22px; bottom: 22px; width: 38px; height: 38px; border: 0; background: var(--gc); color: #fff; font-weight: 800; box-shadow: 0 8px 18px -6px color-mix(in srgb, var(--gc) 70%, transparent); }
.goal:hover .go { border: 0; transform: translateX(3px); }
.goal b { font-size: 21px; }
.goal span { display: block; margin-top: 6px; max-width: 22ch; color: var(--muted); }
.goal:hover span { color: var(--muted); }
.goal em { display: inline-block; margin-top: 16px; padding: 5px 12px; border-radius: 999px; background: #fff; color: var(--gc); border: 1px solid color-mix(in srgb, var(--gc) 22%, #fff); }
.goal:hover em { color: var(--gc); }

/* measure: soft peach band, timeline dots + numbers, icon tile per step */
#measure { background: linear-gradient(180deg, #fff6ef, #fffaf6) !important; }
.steps { position: relative; gap: 14px; }
.step { grid-template-columns: 54px 56px minmax(0, 1fr); gap: 14px; align-items: center; padding: 14px 20px 14px 0; background: transparent; border: 0; position: relative; }
.step::before { content: ""; position: absolute; left: 6px; top: 50%; width: 12px; height: 12px; border-radius: 50%; background: var(--orange); transform: translateY(-50%); box-shadow: 0 0 0 4px #ffe4d4; }
.step:not(:last-child)::after { content: ""; position: absolute; left: 11px; top: calc(50% + 10px); height: calc(100% + 4px); border-left: 2px dashed #f6b48f; }
.step:hover { transform: translateX(4px); border-color: transparent; }
.step i { width: auto; height: auto; background: none; color: var(--orange); font-size: 22px; padding-left: 26px; justify-self: start; }
.step .sic { width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #fff1e8, #ffe0cc); color: var(--orange); display: grid; place-items: center; }
.step .sic svg { width: 26px; height: 26px; }
.step > div { background: #fff; border: 1px solid #f6e7dc; border-radius: 16px; padding: 14px 18px; box-shadow: 0 18px 36px -30px rgba(160, 60, 20, .45); }
.step span:not(.sic) { font-size: 14px; }
@media (max-width: 640px) {
  .goal { min-height: 0; padding: 18px 16px 64px; }
  .goal::after { left: 70px; }
  .goal .ic { width: 44px; height: 44px; margin-bottom: 12px; }
  .goal b { font-size: 17px; }
  .goal span { font-size: 13px; }
  .goal .go { right: 14px; bottom: 14px; width: 32px; height: 32px; }
  .goal em { font-size: 11.5px; padding: 4px 9px; }
  .step { grid-template-columns: 40px 44px minmax(0, 1fr); gap: 10px; padding-right: 0; }
  .step i { font-size: 17px; padding-left: 22px; }
  .step .sic { width: 44px; height: 44px; border-radius: 13px; }
  .step .sic svg { width: 21px; height: 21px; }
  .step > div { padding: 12px 14px; }
}

/* ---- Headings: same heavy weight as the hero H1 ---- */
.case-study-hub h2 { font-weight: 800; letter-spacing: -.035em; }
.case-study-hub .slide h3 { font-weight: 800; }
.case-study-hub .cta h3 { font-weight: 800; }

/* Load more */
