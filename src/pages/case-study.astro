.lib:not(.list) .csc .svc { display: none; }
.lib:not(.list) .csc .thumb {
  grid-column: 2; grid-row: 2 / 5; margin: 0; height: auto; min-height: 150px; align-self: stretch;
  border-radius: 60% 0 0 0 / 70% 0 0 0; background: var(--tint);
}
