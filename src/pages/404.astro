---
/**
 * 404 — served by Vercel for any unmatched URL.
 *
 * Kept deliberately useful rather than decorative: the old WordPress site has
 * years of indexed URLs that will not exist after the cutover, so this page is
 * a routing surface, not a dead end. Links point at the pillars people are
 * most likely to have been looking for.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

const destinations = [
  { name: 'Web Design', href: '/web-design-company-kochi/', desc: 'Custom, SEO-ready websites' },
  { name: 'WordPress Development', href: '/wordpress-development-company-kochi/', desc: 'Custom WordPress & WooCommerce' },
  { name: 'Ecommerce Development', href: '/ecommerce-website-development-company-kochi/', desc: 'Online stores built to sell' },
  { name: 'Web Applications', href: '/web-application-development-company-kochi/', desc: 'Scalable custom web apps' },
  { name: 'SEO Services', href: '/seo-services/', desc: 'Rankings that bring enquiries' },
  { name: 'Digital Marketing', href: '/digital-marketing-company-kochi/', desc: 'SEO, ads, social and content' },
];
---

<Layout
  title="Page Not Found | Teknoppy"
  description="The page you were looking for has moved or no longer exists. Find Teknoppy's web design, development, SEO and digital marketing services in Kochi, Kerala."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <Header forceSolidBg={true} />

  <main class="bg-neutral-950 text-white relative overflow-hidden">
    <!-- Same grid + warm glow treatment as the dark hero and footer -->
    <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:56px_56px]"></div>
    <div class="absolute -top-32 -left-24 w-[420px] h-[420px] rounded-full bg-primary/15 blur-[120px] pointer-events-none"></div>

    <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 py-24 lg:py-32">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.18em] text-primary">
          <span class="w-6 h-px bg-primary"></span>
          Error 404
        </span>

        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-black tracking-tighter leading-[1.05]">
          That page isn't here anymore.
        </h1>

        <p class="mt-6 text-base sm:text-lg text-neutral-400 font-medium leading-relaxed">
          The link may be out of date, or the page may have moved during our site
          rebuild. Everything we do is still one click away below — or talk to us
          directly and we'll point you to the right place.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="/"
            class="inline-flex items-center justify-center h-12 px-7 rounded-full bg-primary text-white text-sm font-bold hover:bg-[#D24A20] transition-colors"
          >
            Back to homepage
          </a>
          <a
            href="/contact-us/"
            class="inline-flex items-center justify-center h-12 px-7 rounded-full border border-white/20 text-white text-sm font-bold hover:bg-white/10 transition-colors"
          >
            Contact us
          </a>
          <a
            href={`tel:${site.phoneLink}`}
            class="inline-flex items-center justify-center h-12 px-7 rounded-full border border-white/20 text-white text-sm font-bold hover:bg-white/10 transition-colors"
          >
            {site.phone}
          </a>
        </div>
      </div>

      <!-- Recovery links -->
      <div class="mt-16 lg:mt-20 pt-12 border-t border-white/10">
        <h2 class="text-[13px] font-bold uppercase tracking-[0.18em] text-neutral-500">
          Popular destinations
        </h2>

        <ul class="mt-7 grid gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
          {destinations.map((d) => (
            <li>
              <a
                href={d.href}
                class="group flex flex-col gap-1 py-4 border-b border-white/10 hover:border-primary/50 transition-colors"
              >
                <span class="text-sm font-bold text-white group-hover:text-primary transition-colors">
                  {d.name}
                </span>
                <span class="text-xs text-neutral-500 font-medium">{d.desc}</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-neutral-400">
          <a href="/case-study/" class="hover:text-primary transition-colors">Case studies</a>
          <a href="/portfolios/" class="hover:text-primary transition-colors">Portfolio</a>
          <a href="/about-us/" class="hover:text-primary transition-colors">About us</a>
          <a href="/blog/" class="hover:text-primary transition-colors">Blog</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
