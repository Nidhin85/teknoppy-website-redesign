---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/content-marketing-agency-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA
    heading="Ready to plan your content marketing?"
    description="Tell us about your business and goals. Start with a free consultation, or request a quote and get a clear, no-obligation proposal within 24 hours."
  />
</Layout>
