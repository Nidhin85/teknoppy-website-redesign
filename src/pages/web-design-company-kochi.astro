---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Play, Globe2, Smile, Award, Star, CheckCircle, Clock, Heart, Shield, Check, HelpCircle, User, Zap, Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages, MonitorSmartphone, Building2, Edit, ShieldCheck, Search, Layers, Network, Code, Gauge, LayoutGrid, Calendar, TrendingUp } from 'lucide-react';

const title = "Web Design Company in Kochi — Teknoppy | Custom Website Design & Development";
const description = "Teknoppy is Kochi's trusted web design company, building fast, mobile-first, and SEO-optimised websites for Kerala businesses. Get a free consultation.";

const services = [
  {
    title: "Responsive Web Design",
    desc: "Pixel-perfect, mobile-first websites that look great and perform flawlessly across all devices and screen sizes.",
    icon: MonitorSmartphone
  },
  {
    title: "Business Website Development",
    desc: "Strategic, fast, and scalable websites for SMEs and growing businesses built on clean code and optimised for conversions.",
    icon: Briefcase
  },
  {
    title: "Corporate Website Development",
    desc: "Enterprise-grade websites with multi-department structure, team sections, investor pages, and custom CMS backend.",
    icon: Building2
  },
  {
    title: "Landing Page Design",
    desc: "High-converting landing pages for ads, product launches, and campaigns — crafted to drive leads and results.",
    icon: Rocket
  },
  {
    title: "Website Redesign Services",
    desc: "Modern, user-friendly redesigns that improve performance while preserving your SEO rankings and brand identity.",
    icon: Edit
  },
  {
    title: "Website Maintenance Services",
    desc: "Ongoing support with updates, security, backups, uptime monitoring, speed optimisation, and more — so your site stays healthy.",
    icon: ShieldCheck
  },
  {
    title: "SEO-Friendly Website Development",
    desc: "Built with clean code, schema markup, optimised content structure, and lightning-fast performance for better rankings.",
    icon: Search
  },
  {
    title: "CMS Website Development",
    desc: "Custom WordPress solutions that give you full control to manage pages, blogs, products, and more without touching code.",
    icon: Layers
  }
];

const processes = [
  {
    step: "01",
    title: "Discovery & Goal Mapping",
    desc: "A structured brief covering goals, audience, competitors, design direction, and technical requirements. We map your geographic service area for local SEO from the start.",
    icon: Search
  },
  {
    step: "02",
    title: "Sitemap & URL Architecture",
    desc: "Full page structure, URL plan, and internal-linking hierarchy defined before design. Prevents keyword cannibalization and ensures clean crawlability.",
    icon: Network
  },
  {
    step: "03",
    title: "Wireframing & UX Design",
    desc: "Low-fidelity wireframes first, then high-fidelity mockups. You approve the layout before a line of code is written — preventing costly late revisions.",
    icon: LayoutGrid
  },
  {
    step: "04",
    title: "Development & Schema",
    desc: "Clean semantic HTML/CSS with mobile-first breakpoints. LocalBusiness, Organisation, FAQPage, BreadcrumbList, and Service schema implemented during development.",
    icon: Code
  },
  {
    step: "05",
    title: "SEO Setup & Speed",
    desc: "Title tags, meta descriptions, H1/H2 hierarchy, image alt text, Core Web Vitals scoring, sitemap generation, and Google Search Console verification.",
    icon: Gauge
  },
  {
    step: "06",
    title: "Launch, Testing & Handover",
    desc: "Full cross-browser and cross-device testing, sitemap submission to Google, and a structured handover document covering CMS access and maintenance.",
    icon: Rocket
  }
];

const pricing = [
  { type: "Basic Business Website (5–8 pages)", price: "Rs. 25,000 – 50,000" },
  { type: "Professional Multi-Page Website (10–20 pages)", price: "Rs. 50,000 – 1,20,000" },
  { type: "Corporate Website with CMS (20–40 pages)", price: "Rs. 1,20,000 – 3,00,000" },
  { type: "Landing Page (1–3 pages, conversion-focused)", price: "Rs. 15,000 – 40,000" },
  { type: "Website Redesign (existing site overhaul)", price: "Rs. 30,000 – 1,50,000" },
  { type: "Ongoing Monthly Maintenance", price: "Rs. 3,000 – 10,000 / mo" }
];

const industries = [
  { name: "Startups & New Business", desc: "Credibility-building launch websites that convert early-stage visitors into qualified leads.", icon: Rocket },
  { name: "Hospitals & Healthcare", desc: "Trust-first sites with appointment booking, doctor profiles, and structured health content.", icon: Activity },
  { name: "Real Estate Agencies", desc: "Property listings with search filters, maps, enquiry forms, and agent profiles.", icon: Home },
  { name: "Restaurants & Food", desc: "Mobile-first sites with menu integration, reservations, and Google Maps connectivity.", icon: Utensils },
  { name: "Schools & Education", desc: "Structured sites with admission forms, faculty pages, and parent information portals.", icon: GraduationCap },
  { name: "Tourism & Travel", desc: "Visually rich, conversion-focused sites with package listings and booking enquiry systems.", icon: Compass },
  { name: "Professional Services", desc: "High-authority sites for law firms, consultants, CAs, and financial advisors.", icon: Briefcase },
  { name: "Manufacturing & B2B", desc: "Corporate-grade B2B sites with product catalogues and enquiry architecture.", icon: Factory },
  { name: "Multilingual Websites", desc: "Bilingual builds for Malayalam-speaking and international audiences alike.", icon: Languages }
];

const projects = [
  {
    name: "Evosyz",
    type: "Fintech Corporate Website",
    loc: "KOCHI · FINTECH",
    desc: "A modern, responsive, SEO-friendly corporate website communicating RBI-licensed services to franchisees and financial partners, with custom UI/UX, conversion-focused layout, and WhatsApp integration.",
    result: "Increased franchise enquiries, improved brand credibility, and stronger search visibility for fintech keywords in Kochi."
  },
  {
    name: "Greens Ayurveda",
    type: "Healthcare & Wellness Website",
    loc: "AZHIYUR, CALICUT · AYURVEDA",
    desc: "A calm, mobile-first, SEO-optimised wellness website with clear treatment pages, appointment enquiry forms, and structured content architecture for domestic and international visitors.",
    result: "A significant rise in international enquiries, improved time on page, and stronger organic visibility for Ayurvedic treatment keywords."
  },
  {
    name: "Olives Resort",
    type: "Tourism & Hospitality Website",
    loc: "WAYANAD · HOSPITALITY",
    desc: "A visually rich, conversion-focused hospitality website with property showcase pages, booking enquiry integration, and Google Maps connectivity.",
    result: "Top Google rankings for resort keywords and a measurable increase in direct booking calls (confirmed by CEO Biju Thomas)."
  },
  {
    name: "SIBP",
    type: "Educational Institution Website",
    loc: "KERALA · EDUCATION",
    desc: "A structured institutional website with admission enquiry forms, faculty sections, course listings, and an event calendar, built with clean URL architecture and local SEO.",
    result: "Increased franchise enquiries, improved brand credibility, and stronger search visibility for fintech keywords in Kochi."
  },
  {
    name: "Dream Abroad",
    type: "Overseas Education Consultancy",
    loc: "KERALA · CONSULTANCY",
    desc: "A professional consultancy website with country-specific programme pages, student enquiry forms, and a trust-forward content structure built to convert prospective students.",
    result: "Significant lift in direct admissions inquiries and organic search rankings."
  },
  {
    name: "Mountbell",
    type: "Business Website",
    loc: "KOCHI · CORPORATE",
    desc: "A professional multi-page corporate website focused on clean layouts, fast load times, and a structured service architecture supporting business development.",
    result: "Stronger positioning as a credible corporate entity in Kochi."
  }
];

const testimonials = [
  {
    quote: "We now rank at the top of Google for our keywords and get many direct booking calls due to better visibility. Thank you Teknoppy for all the support.",
    author: "Biju Thomas",
    role: "CEO, Olives Resort, Wayanad"
  },
  {
    quote: "Being in the Fintech space, we needed a reliable partner. Teknoppy created an appealing website that represents our brand perfectly.",
    author: "Vivek Menon",
    role: "CTO, Evosyz, Kochi"
  },
  {
    quote: "Teknoppy was very intuitive in understanding our requirements. They made great digital collateral and now we are getting good outreach to the market.",
    author: "Shainesh Prakashan",
    role: "CEO, Exacore IT, Infopark Kochi"
  },
  {
    quote: "Thank you Teknoppy for a wonderful mobile app for my tarot channel. All functions work great and I am getting many subscribers.",
    author: "Rincy",
    role: "Astrologer & Psychic Healer, Australia"
  },
  {
    quote: "I have worked with many IT teams, but I am 100% happy with Teknoppy. No doubt, I recommend them with 100% satisfaction.",
    author: "Dr. Asghar",
    role: "CEO, Greens Ayurveda, Calicut"
  }
];

const faqs = [
  {
    q: "What does a web design company in Kochi charge for a business website?",
    a: "A professional business website typically costs between Rs. 25,000 and Rs. 1,20,000 depending on pages, features, and content complexity. Teknoppy provides detailed written quotes before any project begins."
  },
  {
    q: "How long does it take to design and launch a website in Kochi?",
    a: "A standard 8–15 page business website typically takes 3 to 5 weeks from discovery to launch. Larger corporate sites or custom functionality can take 6 to 10 weeks. A written timeline is provided at the start."
  },
  {
    q: "Does Teknoppy build SEO-friendly websites?",
    a: "Yes. Every website includes on-page SEO as standard — correct heading hierarchy, optimised title tags, meta descriptions, image alt text, schema markup, sitemap submission, and Search Console verification. Your site enters Google's index ready to rank."
  },
  {
    q: "Can I update my website myself after Teknoppy builds it?",
    a: "Yes. We build on WordPress CMS, giving you a simple dashboard to add pages, update content, and publish blog posts without technical knowledge. A full handover guide and optional training session are included."
  },
  {
    q: "Does Teknoppy design websites for businesses outside Kochi?",
    a: "Yes. We serve clients across Kerala including Thrissur, Calicut, Trivandrum, Palakkad, Ernakulam, and Kottayam, and work with India-wide clients on corporate and web application projects."
  },
  {
    q: "What schema markup does Teknoppy implement on every website?",
    a: "LocalBusiness, Organisation, Service, FAQPage, BreadcrumbList, and where applicable AggregateRating and Person schema. This helps qualify for Google rich results and AI answer engines like ChatGPT and Perplexity."
  },
  {
    q: "Will my website be mobile-friendly?",
    a: "Yes. Every website is built mobile-first — the mobile experience is designed and tested before desktop. Over 70% of Kerala web traffic comes from mobile, so this is non-negotiable."
  },
  {
    q: "Does Teknoppy provide website maintenance after launch?",
    a: "Yes. Monthly maintenance plans from Rs. 3,000 per month cover updates, security monitoring, speed checks, content edits, and technical fixes."
  },
  {
    q: "Do you offer multilingual website development?",
    a: "Yes. We build multilingual websites for businesses wanting to reach both Malayalam-speaking and international audiences — especially valuable for tourism, Ayurveda, and export-oriented businesses."
  },
  {
    q: "How do I get started with Teknoppy?",
    a: "Contact us via the Contact page, request a quote, or book a free 30-minute consultation. We respond to all enquiries within one business day."
  }
];

const seoAuditFactors = [
  { factor: "Title / Meta / URL optimisation", weight: 10, score: "10 / 10" },
  { factor: "H1 + heading hierarchy", weight: 10, score: "10 / 10" },
  { factor: "Keyword usage & density", weight: 10, score: "10 / 10" },
  { factor: "Content depth & topical coverage", weight: 15, score: "14 / 15" },
  { factor: "Answer-first / AEO structure", weight: 10, score: "10 / 10" },
  { factor: "GEO citability & entity richness", weight: 10, score: "9 / 10" },
  { factor: "E-E-A-T signals (real clients & reviews)", weight: 15, score: "15 / 15" },
  { factor: "Schema markup completeness", weight: 10, score: "10 / 10" },
  { factor: "Internal linking & pillar architecture", weight: 10, score: "10 / 10" }
];
---

<Layout title={title} description={description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- HERO SECTION WITH OFFICE CIRCLING SVG (DARK VERSION) -->
    <section class="relative pt-32 pb-24 md:pt-36 md:pb-32 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.png')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 grid xl:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="xl:col-span-7 flex flex-col items-center text-center xl:items-start xl:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
            <Zap class="w-3.5 h-3.5" />
            Kerala's Premier Digital Studio
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-black leading-[1.1] tracking-tight text-white mb-6">
            Web Design <br class="hidden sm:block" />
            <span class="relative inline-block text-primary">
              Company
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span> in Kochi
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-neutral-300 mb-8 max-w-2xl font-medium leading-relaxed">
            Custom · Mobile-First · SEO-Ready Websites for Kerala Businesses Since 2018. We build digital platforms that rank, convert, and scale.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
            <a href="#contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap">
              Book a Free Audit
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href="#services" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white border border-white/20 rounded-full hover:bg-white/5 transition-all duration-300 shadow-sm whitespace-nowrap">
              Explore Our Services
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Hero Graphic (Redesigned Stats Cards Grid) -->
        <div class="xl:col-span-5 grid grid-cols-2 gap-4 sm:gap-6">
          
          <!-- Card 1 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Rocket class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">120+</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Website Projects</span>
          </div>

          <!-- Card 2 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Calendar class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">2018</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Established</span>
          </div>

          <!-- Card 3 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <TrendingUp class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Page 1</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Google Results</span>
          </div>

          <!-- Card 4 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Globe2 class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Kerala</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Wide Coverage</span>
          </div>

        </div>
      </div>
    </section>

    <!-- WHY TEKNOPPY SECTION -->
    <section class="py-24 bg-[#FFF8EF]/30 border-y border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.png')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          
          <!-- Left Column (Sticky Panel) -->
          <div class="lg:col-span-5 lg:sticky lg:top-32 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider shadow-sm">
              Trusted Partners
            </div>
            <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
              Why Kochi's Best Brands <br />
              <span class="text-primary">Choose Teknoppy</span>
            </h2>
            <p class="text-neutral-500 font-medium text-sm leading-relaxed max-w-sm">
              We strip away generic templates to engineer custom-built high-performance web platforms designed to rank, scale, and convert visitors into clients.
            </p>
          </div>

          <!-- Right Column (Premium Custom Cards Grid) -->
          <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6 lg:gap-8">
            
            <!-- Card 1 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">01 . Strategy</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Custom Design, Not Templates</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Every project begins with a custom wireframe mapped to your goals. Our in-house Kochi team covers custom layout designs, development, content, on-page SEO, and schema setup under one roof.
                </p>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">02 . Rankings</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">A Google-Aware Studio</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Every website is benchmarked against Core Web Vitals, designed with semantic markup, and launched with live schemas so your site enters the Google index ready to rank immediately.
                </p>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">03 . Clarity</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Full Transparency</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Detailed timelines, clearly defined revision rounds, real estimates, and post-launch maintenance. No surprise charges and no vanishing after handover.
                </p>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">04 . Partnership</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">A Local Kochi Team</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Teknoppy is headquartered in Kochi, Kerala. When you need a quick consultation, design alignment, or urgent support, our local team is just one message away.
                </p>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- OUR WEB DESIGN SERVICES IN KOCHI -->
    <section id="services" class="py-20 bg-white relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.png')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Services Scope
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            Our <span class="text-primary">Website Design</span> Services in Kochi
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base sm:text-lg">
            As a full-service web design company in Kochi, Teknoppy delivers the following specialised services. Each links to a dedicated page with deeper detail, real project examples, and pricing context.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {services.map(svc => {
            const IconComp = svc.icon;
            return (
              <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col">
                <!-- Left Gradient Stroke -->
                <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 bg-primary/5 text-primary rounded-2xl flex items-center justify-center flex-shrink-0 border border-primary/10 shadow-inner">
