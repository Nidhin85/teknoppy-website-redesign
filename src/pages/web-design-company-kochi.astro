---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import Testimonials from '../components/Testimonials.tsx';
import videoTestimonials from '../data/video-testimonials.json';
import { 
  ArrowRight, 
  Play, 
  Mail, 
  Phone, 
  Globe2, 
  Clock, 
  Zap, 
  Rocket, 
  Activity, 
  Home, 
  Utensils, 
  GraduationCap, 
  Compass, 
  Briefcase, 
  Factory, 
  Languages, 
  MonitorSmartphone, 
  Building2, 
  Edit, 
  ShieldCheck, 
  Search, 
  Layers, 
  Network, 
  Code, 
  Gauge, 
  LayoutGrid, 
  Calendar, 
  TrendingUp, 
  ChevronDown, 
  ExternalLink 
} from 'lucide-react';
import page from '../data/pages/web-design.json';
import { getCollection } from 'astro:content';

// Resolve blog posts from the blog collection by slug so titles, dates, covers stay CMS-driven.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const blogPosts = page.blog.items
  .map(item => allPosts.find(post => post.id === item.slug))
  .filter(Boolean)
  .map(post => ({
    title: post!.data.title,
    excerpt: post!.data.excerpt,
    category: post!.data.category,
    readTime: post!.data.readTime,
    image: post!.data.cover,
    date: post!.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }),
    href: `/blog/${post!.id}/`
  }));

// Resolve real client testimonials and photos from src/content/testimonials/
const testimonialsCollection = await getCollection('testimonials');
const testimonials = page.testimonials.items.map(item => {
  const match = testimonialsCollection.find(t => 
    t.data.name.toLowerCase() === item.author.toLowerCase() || 
    item.author.toLowerCase().includes(t.data.name.toLowerCase())
  );
  return {
    name: item.author,
    role: item.role,
    content: item.quote,
    initials: match?.data.initials || item.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase(),
    photo: match?.data.photo
  };
});

// Curated verified client logos for the continuous Trusted Partners marquee
const trustedPartnerLogos = [
  { name: 'Abroad Career', src: '/client logos/Abroad-career-1.jpg' },
  { name: 'Abu Dhabi Business Hub', src: '/client logos/abu-dhabi.jpg' },
  { name: 'Al Coffee', src: '/client logos/al-coffee-1.jpg' },
  { name: 'Amster', src: '/client logos/amster.jpg' },
  { name: 'Laughing Waters', src: '/client logos/laughing-waters.jpg' },
  { name: 'Olive Builders', src: '/client logos/olive.jpg' },
  { name: 'WestN Resorts', src: '/client logos/westn.jpg' },
  { name: 'Abrus Krishna Finance', src: '/client logos/abrus-krishna-finance.jpg' },
  { name: 'Cochin Suraksha', src: '/client logos/cochin-suraksha.webp' },
  { name: 'General Tech Services', src: '/client logos/general-tech-services.jpg' },
  { name: 'Leema Engineering', src: '/client logos/leema-engineering.png' },
  { name: 'Kerala Dayz', src: '/client logos/kerala-dayz.png' },
  { name: 'Varma Ayurveda', src: '/client logos/varma-ayurveda.png' },
  { name: 'Edamanasserry Spine Hospital', src: '/client logos/edamanasserry-spine-hospital.jpg' },
  { name: 'Creative Qatar', src: '/client logos/creative-qatar.png' },
  { name: 'Alankar Avenue', src: '/client logos/alankar-avenue.png' }
];

const title = page.meta.title;
const description = page.meta.description;

// SEO Schemas
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": page.faqs.items.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a.replace(/<[^>]*>/g, '')
    }
  }))
};

const pageUrl = "https://www.teknoppy.com/web-design-company-kochi/";

const kochiLocalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://www.teknoppy.com/web-design-company-kochi/#localbusiness",
  "name": "Teknoppy – Web Design Company in Kochi",
  "url": "https://www.teknoppy.com/web-design-company-kochi/",
  "logo": "https://www.teknoppy.com/logo.svg",
  "image": "https://www.teknoppy.com/og-image.png",
  "telephone": "+91-6282249224",
  "email": "sales@teknoppy.com",
  "priceRange": "₹15,000 - ₹3,00,000",
  "foundingDate": "2018",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam, Vyttila",
    "addressLocality": "Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  },
  "areaServed": [
    { "@type": "City", "name": "Kochi" },
    { "@type": "Place", "name": "Ernakulam" },
    { "@type": "Place", "name": "Vyttila" },
    { "@type": "Place", "name": "Edappally" },
    { "@type": "Place", "name": "Kakkanad" }
  ],
  "hasMap": "https://maps.google.com/maps?q=Teknoppy+Vyttila+Kochi",
  "sameAs": [
    "https://maps.google.com/maps?q=Teknoppy+Vyttila+Kochi",
    "https://www.facebook.com/teknoppy",
    "https://www.linkedin.com/company/teknoppy"
  ],
  "parentOrganization": {
    "@type": "Organization",
    "name": "Teknoppy",
    "url": "https://www.teknoppy.com/"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.teknoppy.com/" },
    { "@type": "ListItem", "position": 2, "name": "Web Design Company in Kochi", "item": pageUrl }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Web Design Company in Kochi",
  "serviceType": "Web Design and Development",
  "url": pageUrl,
  "provider": { "@type": "LocalBusiness", "@id": "https://www.teknoppy.com/web-design-company-kochi/#localbusiness" },
  "areaServed": [
    { "@type": "City", "name": "Kochi" },
    { "@type": "State", "name": "Kerala" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Website Design Services in Kochi",
    "itemListElement": page.services.cards.map(card => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": card.title, "description": card.desc }
    }))
  }
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": page.author.name,
  "jobTitle": page.author.role,
  "email": page.author.email,
  "telephone": page.author.phone,
  "description": page.author.bio,
  "worksFor": { "@type": "Organization", "name": "Teknoppy", "url": "https://www.teknoppy.com/" }
};

// Icons mapped by index with JSON lists
const heroStatIcons = [Rocket, Calendar, TrendingUp, Globe2];
const serviceIcons = [MonitorSmartphone, Briefcase, Building2, Rocket, Edit, ShieldCheck, Search, Layers];
const processIcons = [Search, Network, LayoutGrid, Code, Gauge, Rocket];
const industryIcons = [Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages];

// Case-study accent colour classes
const caseAccents: Record<string, { glow: string; mesh: string; label: string }> = {
  blue: {
    glow: "from-blue-500/20 to-indigo-500/20",
    mesh: "from-blue-500/10 via-transparent to-transparent",
    label: "text-blue-500"
  },
  emerald: {
    glow: "from-emerald-500/20 to-teal-500/20",
    mesh: "from-emerald-500/10 via-transparent to-transparent",
    label: "text-emerald-500"
  }
};
---

<Layout
  title={title}
  description={description}
  canonical="https://www.teknoppy.com/web-design-company-kochi/"
  showBottomBar={true}
  floatingCtaLabel="Let's Build Your Website"
  floatingCtaHref="/request-a-quote/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(kochiLocalBusinessSchema)} />
  </Fragment>
  <Header />

  <main class="overflow-hidden">
    <!-- 1. HERO SECTION (MATCHING HOMEPAGE DESIGN SYSTEM) -->
    <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-cover bg-center bg-no-repeat hero-bg">
      <!-- Decorative Background Layer -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <!-- Fine grid pattern texture -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(240,90,44,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(240,90,44,0.02)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_at_center,white,transparent_85%)]"></div>
        <!-- Glowing Warm Orbs -->
        <div class="absolute -top-48 -right-48 w-[600px] h-[600px] rounded-full bg-secondary/10 blur-[135px] animate-[pulse_8s_infinite_alternate]"></div>
        <div class="absolute top-[30%] -left-48 w-[500px] h-[500px] rounded-full bg-primary/5 blur-[120px]"></div>
        <div class="absolute -bottom-48 right-[10%] w-[500px] h-[500px] rounded-full bg-secondary/8 blur-[100px] animate-[pulse_6s_infinite_alternate_1s]"></div>

        <!-- Office graphic circular outlines -->
        <svg class="absolute right-0 top-12 w-[600px] h-[600px] opacity-15 text-primary pointer-events-none" viewBox="0 0 200 200" fill="none">
          <circle cx="120" cy="80" r="80" stroke="currentColor" stroke-width="0.3" stroke-dasharray="2 2"></circle>
          <circle cx="120" cy="80" r="60" stroke="currentColor" stroke-width="0.3"></circle>
          <circle cx="120" cy="80" r="40" stroke="currentColor" stroke-width="0.6" stroke-dasharray="4 4"></circle>
          <path d="M20,100 C60,40 140,160 180,100" stroke="currentColor" stroke-width="0.3"></path>
        </svg>
      </div>

      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 grid xl:grid-cols-12 gap-12 xl:gap-8 items-center relative z-10">
        <!-- Hero Text (Left Column) -->
        <div class="xl:col-span-7 flex flex-col items-center text-center xl:items-start xl:text-left">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-[11px] sm:text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1 max-w-full">
            <Zap class="w-3.5 sm:w-4 h-3.5 sm:h-4 text-primary shrink-0" />
            <span class="truncate sm:whitespace-normal">{page.hero.badge}</span>
          </div>

          <!-- Headline (H1) -->
          <h1 class="text-3xl sm:text-5xl lg:text-[52px] xl:text-[56px] font-black leading-[1.15] tracking-tight text-neutral-900 mb-6">
            <span class="block">
              {page.hero.headingLead}{" "}
              <span class="inline-block bg-primary text-white px-2.5 sm:px-4 py-0.5 rounded-[1.5rem] transform -rotate-1 shadow-md mx-0.5 sm:mx-1 whitespace-nowrap">
                {page.hero.headingAccent}
              </span>{" "}
              {page.hero.headingRest}
            </span>
          </h1>

          <!-- Body -->
          <p class="text-base sm:text-lg lg:text-xl text-neutral-600 mb-8 max-w-xl font-medium leading-relaxed">
            {page.hero.body}
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-center gap-3.5 w-full sm:w-auto mb-8 max-w-full">
            <a 
              href={page.hero.ctaPrimary.href} 
              class="kochi-cta kochi-cta-primary w-full sm:w-auto inline-flex items-center justify-center text-center gap-2 px-5 sm:px-8 py-3.5 sm:py-4 text-sm sm:text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.25)] hover:bg-primary/95 transition-all duration-300 leading-snug"
            >
              <span>{page.hero.ctaPrimary.label}</span>
              <ArrowRight class="w-4 h-4 kochi-cta-arrow text-white transition-transform duration-300 shrink-0" />
            </a>
            <a 
              href={page.hero.ctaSecondary.href} 
              class="kochi-cta-tertiary w-full sm:w-auto inline-flex items-center justify-center text-center gap-2 px-5 sm:px-8 py-3.5 sm:py-4 text-sm sm:text-base font-bold text-neutral-700 bg-white border border-neutral-200 rounded-full hover:border-primary/50 hover:bg-cream transition-all duration-300 shadow-sm leading-snug"
            >
              <span class="flex items-center justify-center w-6 h-6 rounded-full border border-neutral-300 text-primary shrink-0">
                <Play class="w-2.5 h-2.5 fill-current ml-0.5" />
              </span>
              <span>{page.hero.ctaSecondary.label}</span>
            </a>
          </div>

          <!-- Trust Bar Strip (Shown on mobile & tablet, hidden on desktop xl where cards appear) -->
          <div class="mt-2 pt-6 border-t border-neutral-200/60 w-full grid grid-cols-2 sm:grid-cols-4 gap-y-4 gap-x-4 max-w-xl mx-auto xl:mx-0 xl:hidden">
            {page.hero.stats.map(stat => (
              <div class="flex flex-col items-center sm:items-start">
                <span class="text-xl sm:text-2xl font-black text-neutral-900 leading-none">{stat.value}</span>
                <span class="text-[12px] sm:text-[13px] text-neutral-500 font-semibold mt-1.5 uppercase tracking-wide text-center sm:text-left leading-tight">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Hero Graphic / Stats Showcase Cards (Desktop Right Column) -->
        <div class="xl:col-span-5 hidden xl:grid grid-cols-2 gap-4 sm:gap-6 w-full">
          {page.hero.stats.map((stat, i) => {
            const StatIcon = heroStatIcons[i];
            return (
              <div class="bg-white/95 backdrop-blur-md rounded-3xl p-6 sm:p-7 border border-neutral-100/90 shadow-[0_12px_35px_rgba(240,90,44,0.05)] hover:border-primary/30 hover:shadow-[0_20px_45px_rgba(240,90,44,0.1)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group min-h-[190px] sm:min-h-[210px]">
                <div class="w-12 h-12 rounded-2xl bg-primary/5 border border-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white group-hover:scale-105 group-hover:shadow-[0_6px_15px_rgba(240,90,44,0.25)] transition-all duration-300 mb-5">
                  <StatIcon class="w-5 h-5" />
                </div>
                <div>
                  <span class="text-3xl sm:text-4xl font-black text-neutral-900 block leading-none mb-2">{stat.value}</span>
                  <div class="w-8 h-[2.5px] bg-primary mb-3 rounded-full group-hover:w-12 transition-all duration-300"></div>
                  <span class="text-[11px] sm:text-xs font-bold text-neutral-500 uppercase tracking-wider leading-snug block">{stat.label}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 2. INTRO BAND SECTION (MATCHING ABOUT.ASTRO DESIGN SYSTEM) -->
    <section class="py-20 md:py-24 bg-cream relative overflow-hidden">
      <!-- Subtle decorative background -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.webp')] opacity-30"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl space-y-6">
          <p class="text-xl md:text-2xl font-semibold text-neutral-900 leading-snug pl-0 lg:pl-6 border-l-0 lg:border-l-4 border-secondary">
            {page.introBand[0]}
          </p>
          <p class="text-base md:text-lg text-neutral-600 leading-relaxed font-medium pl-0 lg:pl-6">
            {page.introBand[1]}
          </p>
          <div class="pt-2 pl-0 lg:pl-6">
            <a 
              href="/request-a-quote/" 
              class="kochi-cta kochi-cta-secondary inline-flex items-center gap-2 px-6 py-3 text-sm font-bold text-neutral-900 bg-white border border-neutral-200/90 rounded-full hover:border-primary hover:text-primary transition-all duration-300 shadow-sm"
            >
              Talk About My Website
              <ArrowRight class="w-4 h-4 kochi-cta-arrow text-primary transition-transform duration-300" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. WHY TEKNOPPY SECTION (MATCHING WHYCHOOSEUS.ASTRO DESIGN SYSTEM) -->
    <section class="py-24 md:py-32 bg-cream relative overflow-hidden">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 relative z-10 min-w-0">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-12 xl:gap-20 items-start min-w-0">

          <!-- Left Column (Sticky Panel) -->
          <div class="lg:col-span-5 lg:sticky lg:top-32 space-y-8 min-w-0 w-full overflow-hidden">
            <div>
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
                {page.whyTeknoppy.badge}
              </div>
              <h2 class="text-4xl md:text-5xl font-black tracking-tight text-neutral-900 leading-[1.15] mb-6">
                {page.whyTeknoppy.headingLead} <br class="hidden sm:inline" />
                <span class="text-primary">{page.whyTeknoppy.headingAccent}</span>
              </h2>
              <p class="text-neutral-600 text-base leading-relaxed">
                {page.whyTeknoppy.intro}
              </p>
              <div class="pt-5">
                <a 
                  href="/request-a-quote/" 
                  class="kochi-cta kochi-cta-secondary inline-flex items-center gap-2 px-6 py-3.5 text-sm font-bold text-neutral-900 bg-white border border-neutral-200/90 rounded-full hover:border-primary hover:text-primary transition-all duration-300 shadow-sm"
                >
                  Get My Website Started
                  <ArrowRight class="w-4 h-4 kochi-cta-arrow text-primary transition-transform duration-300" />
                </a>
              </div>
            </div>

            <!-- Trusted Partners Continuous Scrolling Marquee -->
            <div class="pt-8 space-y-4">
              <div>
                <p class="text-[12px] font-bold text-neutral-400 uppercase tracking-wider">Trusted Partners</p>
                <p class="text-sm font-semibold text-neutral-900 leading-tight">Trusted by 100+ Brands in Kochi & Beyond</p>
              </div>

              <!-- Marquee Track flanked by clean divider borders -->
              <div class="border-y border-neutral-200/70 py-4 sm:py-5">
                <div class="marquee-viewport relative w-full overflow-hidden marquee-mask py-1" aria-label="Trusted client brand logos">
                  <div class="flex w-max">
                    <!-- First set of logos -->
                    <div class="marquee-content flex items-center gap-6 sm:gap-8 lg:gap-10 pr-6 sm:pr-8 lg:pr-10 shrink-0">
                      {trustedPartnerLogos.map((logo) => (
                        <div class="logo-plate h-[72px] sm:h-[84px] lg:h-[98px] xl:h-[106px] min-w-[110px] sm:min-w-[130px] px-5 sm:px-7 py-2 rounded-xl border border-neutral-200/80 bg-white/95 shadow-[0_2px_6px_rgba(0,0,0,0.03)] flex items-center justify-center shrink-0 hover:border-primary/40 hover:shadow-md transition-all duration-300">
                          <img 
                            src={logo.src} 
                            alt={`${logo.name} logo`} 
                            loading="lazy" 
                            decoding="async" 
                            class="h-[56px] sm:h-[66px] lg:h-[80px] xl:h-[88px] w-auto max-w-[160px] sm:max-w-[200px] lg:max-w-[240px] xl:max-w-[270px] object-contain transition-all duration-300 mix-blend-multiply" 
                          />
                        </div>
                      ))}
                    </div>
                    <!-- Duplicate set for seamless continuous loop -->
                    <div class="marquee-content flex items-center gap-6 sm:gap-8 lg:gap-10 pr-6 sm:pr-8 lg:pr-10 shrink-0" aria-hidden="true">
                      {trustedPartnerLogos.map((logo) => (
                        <div class="logo-plate h-[72px] sm:h-[84px] lg:h-[98px] xl:h-[106px] min-w-[110px] sm:min-w-[130px] px-5 sm:px-7 py-2 rounded-xl border border-neutral-200/80 bg-white/95 shadow-[0_2px_6px_rgba(0,0,0,0.03)] flex items-center justify-center shrink-0 hover:border-primary/40 hover:shadow-md transition-all duration-300">
                          <img 
                            src={logo.src} 
                            alt={`${logo.name} logo`} 
                            loading="lazy" 
                            decoding="async" 
                            class="h-[56px] sm:h-[66px] lg:h-[80px] xl:h-[88px] w-auto max-w-[160px] sm:max-w-[200px] lg:max-w-[240px] xl:max-w-[270px] object-contain transition-all duration-300 mix-blend-multiply" 
                          />
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Compact conversion CTA connected to trusted partners marquee -->
              <div class="pt-2">
                <a 
                  href="/request-a-quote/" 
                  class="kochi-cta kochi-cta-secondary inline-flex items-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-bold text-neutral-800 bg-white border border-neutral-200/90 rounded-full hover:border-primary hover:text-primary transition-all duration-300 shadow-sm"
                >
                  Build a Website Like These
                  <ArrowRight class="w-3.5 h-3.5 kochi-cta-arrow text-primary transition-transform duration-300" />
                </a>
              </div>
            </div>
          </div>

          <!-- Right Column (Custom Feature Cards Grid) -->
          <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6 min-w-0 w-full">
            {page.whyTeknoppy.cards.map((card, idx) => (
              <div class="relative bg-white border border-neutral-100/80 hover:border-primary/30 rounded-2xl p-7 sm:p-8 transition-all duration-500 group flex flex-col justify-between shadow-sm hover:shadow-[0_20px_50px_rgba(240,90,44,0.06)] hover:-translate-y-1">
                <div>
                  <div class="flex justify-between items-center mb-6">
                    <span class="text-xs font-mono font-bold text-primary bg-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wider">
                      {card.tag}
                    </span>
                    <span class="text-xs font-mono font-bold text-neutral-300 group-hover:text-primary transition-colors">
                      0{idx + 1}
                    </span>
                  </div>
                  <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3 leading-snug">
                    {card.title}
                  </h3>
                  <p class="text-neutral-600 text-sm leading-relaxed font-normal">
                    {card.description}
                  </p>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- 4. OUR WEB DESIGN SERVICES IN KOCHI (MATCHING SERVICES.ASTRO DESIGN SYSTEM) -->
