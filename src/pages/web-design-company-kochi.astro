---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HomepageVideoHero from '../components/HomepageVideoHero.astro';
import FooterCTA from '../components/FooterCTA.astro';
import Testimonials from '../components/Testimonials.tsx';
import videoTestimonials from '../data/video-testimonials.json';
import { 
  ArrowRight, 
  Play, 
  Mail, 
  Phone, 
  Globe2, 
  Clock, 
  Zap, 
  Rocket, 
  Activity, 
  Home, 
  Utensils, 
  GraduationCap, 
  Compass, 
  Briefcase, 
  Factory, 
  Languages, 
  MonitorSmartphone, 
  Building2, 
  Edit, 
  ShieldCheck, 
  Search, 
  Layers, 
  Network, 
  Code, 
  Gauge, 
  LayoutGrid, 
  Calendar, 
  TrendingUp, 
  ChevronDown, 
  ExternalLink,
  MapPin
} from 'lucide-react';
import page from '../data/pages/web-design.json';
import { getCollection } from 'astro:content';

// Resolve blog posts from the blog collection by slug so titles, dates, covers stay CMS-driven.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const blogPosts = page.blog.items
  .map(item => allPosts.find(post => post.id === item.slug))
  .filter(Boolean)
  .map(post => ({
    title: post!.data.title,
    excerpt: post!.data.excerpt,
    category: post!.data.category,
    readTime: post!.data.readTime,
    image: post!.data.cover,
    date: post!.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }),
    href: `/blog/${post!.id}/`
  }));

// Resolve real client testimonials and photos from src/content/testimonials/
const testimonialsCollection = await getCollection('testimonials');
const testimonials = page.testimonials.items.map(item => {
  const match = testimonialsCollection.find(t => 
    t.data.name.toLowerCase() === item.author.toLowerCase() || 
    item.author.toLowerCase().includes(t.data.name.toLowerCase())
  );
  return {
    name: item.author,
    role: item.role,
    content: item.quote,
    initials: match?.data.initials || item.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase(),
    photo: match?.data.photo
  };
});

// Curated verified client logos for the continuous Trusted Partners marquee
const trustedPartnerLogos = [
  { name: 'Abroad Career', src: '/client logos/Abroad-career-1.jpg' },
  { name: 'Abu Dhabi Business Hub', src: '/client logos/abu-dhabi.jpg' },
  { name: 'Al Coffee', src: '/client logos/al-coffee-1.jpg' },
  { name: 'Amster', src: '/client logos/amster.jpg' },
  { name: 'Laughing Waters', src: '/client logos/laughing-waters.jpg' },
  { name: 'Olive Builders', src: '/client logos/olive.jpg' },
  { name: 'WestN Resorts', src: '/client logos/westn.jpg' },
  { name: 'Abrus Krishna Finance', src: '/client logos/abrus-krishna-finance.jpg' },
  { name: 'Cochin Suraksha', src: '/client logos/cochin-suraksha.webp' },
  { name: 'General Tech Services', src: '/client logos/general-tech-services.jpg' },
  { name: 'Leema Engineering', src: '/client logos/leema-engineering.png' },
  { name: 'Kerala Dayz', src: '/client logos/kerala-dayz.png' },
  { name: 'Varma Ayurveda', src: '/client logos/varma-ayurveda.png' },
  { name: 'Edamanasserry Spine Hospital', src: '/client logos/edamanasserry-spine-hospital.jpg' },
  { name: 'Creative Qatar', src: '/client logos/creative-qatar.png' },
  { name: 'Alankar Avenue', src: '/client logos/alankar-avenue.png' }
];

const title = page.meta.title;
const description = page.meta?.description && !page.meta.description.includes('Kerala')
  ? page.meta.description
  : "Teknoppy is a trusted web design company in Kochi building fast, SEO-ready, conversion-focused websites for Kochi businesses. Get a free quote today.";

// SEO Schemas
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": page.faqs.items.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a.replace(/<[^>]*>/g, '')
    }
  }))
};

const pageUrl = "https://www.teknoppy.com/web-design-company-kochi/";

const kochiLocalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://www.teknoppy.com/web-design-company-kochi/#localbusiness",
  "name": "Teknoppy – Web Design Company in Kochi",
  "url": "https://www.teknoppy.com/web-design-company-kochi/",
  "logo": "https://www.teknoppy.com/logo.svg",
  "image": "https://www.teknoppy.com/og-image.png",
  "telephone": "+91-6282249224",
  "email": "sales@teknoppy.com",
  "priceRange": "₹15,000 - ₹3,00,000",
  "foundingDate": "2018",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam, Vyttila",
    "addressLocality": "Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  },
  "areaServed": [
    { "@type": "City", "name": "Kochi" },
    { "@type": "Place", "name": "Ernakulam" },
    { "@type": "Place", "name": "Vyttila" },
    { "@type": "Place", "name": "Edappally" },
    { "@type": "Place", "name": "Kakkanad" }
  ],
  "hasMap": "https://maps.google.com/maps?q=Teknoppy+Vyttila+Kochi",
  "sameAs": [
    "https://maps.google.com/maps?q=Teknoppy+Vyttila+Kochi",
    "https://www.facebook.com/teknoppy",
    "https://www.linkedin.com/company/teknoppy"
  ],
  "parentOrganization": {
    "@type": "Organization",
    "name": "Teknoppy",
    "url": "https://www.teknoppy.com/"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.teknoppy.com/" },
    { "@type": "ListItem", "position": 2, "name": "Web Design Company in Kochi", "item": pageUrl }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Web Design Company in Kochi",
  "serviceType": "Web Design and Development",
  "url": pageUrl,
  "provider": { "@type": "LocalBusiness", "@id": "https://www.teknoppy.com/web-design-company-kochi/#localbusiness" },
  "areaServed": [
    { "@type": "City", "name": "Kochi" },
    { "@type": "State", "name": "Kerala" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Website Design Services in Kochi",
    "itemListElement": page.services.cards.map(card => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": card.title, "description": card.desc }
    }))
  }
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": page.author.name,
  "jobTitle": page.author.role,
  "email": page.author.email,
  "telephone": page.author.phone,
  "description": page.author.bio,
  "worksFor": { "@type": "Organization", "name": "Teknoppy", "url": "https://www.teknoppy.com/" }
};

// Icons mapped by index with JSON lists
const heroStatIcons = [Rocket, Calendar, TrendingUp, MapPin];
const serviceIcons = [MonitorSmartphone, Briefcase, Building2, Rocket, Edit, ShieldCheck, Search, Layers];
const processIcons = [Search, Network, LayoutGrid, Code, Gauge, Rocket];
const industryIcons = [Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages];

// Case-study accent colour classes
const caseAccents: Record<string, { glow: string; mesh: string; label: string }> = {
  blue: {
    glow: "from-blue-500/20 to-indigo-500/20",
    mesh: "from-blue-500/10 via-transparent to-transparent",
    label: "text-blue-500"
  },
  emerald: {
    glow: "from-emerald-500/20 to-teal-500/20",
    mesh: "from-emerald-500/10 via-transparent to-transparent",
    label: "text-emerald-500"
  }
};
---

<Layout
  title={title}
  description={description}
  canonical="https://www.teknoppy.com/web-design-company-kochi/"
  showBottomBar={true}
  floatingCtaLabel="Let's Build Your Website"
  floatingCtaHref="/request-a-quote/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(kochiLocalBusinessSchema)} />
  </Fragment>
  <Header forceSolidBg={true} />

  <main class="wdk-page overflow-hidden">
    <!-- Office video (framed as on the homepage) -->
    <section class="home-video-band" aria-label="Teknoppy studio video">
      <div class="home-video-frame">
        <HomepageVideoHero ariaLabel="Teknoppy — Web Design Company in Kochi Video" />
      </div>
    </section>

    <!-- 1. HERO (reference layout: copy left, 3D browser visual right, stats strip below) -->
    <section id="hero-intro" class="wdk-hero theme-keep-light relative pt-28 sm:pt-32 lg:pt-36 pb-14 sm:pb-16 lg:pb-20 overflow-hidden text-white">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
        <div class="wdk-hero-glow"></div>
        <div class="wdk-hero-arc"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-5 sm:px-6 lg:px-12 relative z-10">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
          <!-- Hero Text (Left Column) -->
          <div class="lg:col-span-6 flex flex-col items-start text-left">
            <nav class="flex flex-wrap items-center gap-2 text-xs font-medium text-white/60 mb-5" aria-label="Breadcrumb">
              <a href="/" class="hover:text-white transition-colors">Home</a>
              <span class="text-white/30">›</span>
              <span class="text-white font-semibold">Web Design Company in Kochi</span>
            </nav>

            <!-- Badge -->
            <div class="wdk-badge mb-5">
              <Zap class="w-3.5 h-3.5 shrink-0" />
              <span>{page.hero.badge}</span>
            </div>

            <!-- Headline (H1) -->
            <h1 class="text-[40px] sm:text-6xl lg:text-[58px] xl:text-[64px] font-black leading-[1.04] tracking-[-0.035em] text-white mb-6">
              <span class="text-[#ff7a3d]">{page.hero.headingLead}</span>{" "}{page.hero.headingAccent}{" "}<span class="text-[#ff7a3d]">{page.hero.headingRest}</span>
            </h1>

            <!-- Body -->
            <p class="text-base sm:text-lg text-white/85 mb-8 max-w-xl font-medium leading-relaxed">
              {page.hero.body}
            </p>

            <!-- CTAs -->
            <div class="flex flex-col min-[420px]:flex-row items-stretch min-[420px]:items-center gap-3 sm:gap-4 w-full sm:w-auto">
              <a
                href={page.hero.ctaPrimary.href}
                class="inline-flex items-center justify-center gap-2.5 px-7 py-4 text-sm sm:text-base font-bold text-white bg-primary rounded-full shadow-[0_10px_30px_-6px_rgba(240,90,44,0.75)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 leading-snug whitespace-nowrap"
              >
                <span>{page.hero.ctaPrimary.label}</span>
                <ArrowRight class="w-4 h-4 text-white shrink-0" />
              </a>
              <a
                href={page.hero.ctaSecondary.href}
                class="inline-flex items-center justify-center gap-3 pl-2.5 pr-7 py-2.5 text-sm sm:text-base font-bold text-neutral-900 bg-white border border-white rounded-full hover:text-primary transition-all duration-300 shadow-sm leading-snug whitespace-nowrap"
              >
                <span class="flex items-center justify-center w-9 h-9 rounded-full bg-primary/10 text-primary shrink-0">
                  <Play class="w-3.5 h-3.5 ml-0.5" fill="currentColor" />
                </span>
                <span>{page.hero.ctaSecondary.label}</span>
              </a>
            </div>
          </div>

          <!-- Hero visual (Right Column): 3D browser window, orange ring and floating labels -->
          <div class="lg:col-span-6">
            <div class="wdk-visual relative mx-auto w-full max-w-[600px] lg:max-w-none xl:w-[110%]">
              <picture>
                <source media="(max-width: 767px)" srcset="/images/home/3d/kochi-hero-3d-dark-900.webp" />
                <img src="/images/home/3d/kochi-hero-3d-dark.webp" alt="3D website design mockup in a browser window with a WordPress panel, a glowing orange ring and labels for modern design, SEO friendly, mobile responsive and custom development" width="1500" height="1001" loading="eager" decoding="async" fetchpriority="high" class="w-full h-auto" />
              </picture>
            </div>
          </div>
        </div>

        <!-- Stats strip -->
        <div class="wdk-stats mt-12 lg:mt-14 grid grid-cols-2 lg:grid-cols-4">
          {page.hero.stats.map((stat, i) => {
            const StatIcon = heroStatIcons[i];
            return (
              <div class="flex items-center gap-3.5 px-4 sm:px-6 py-4 sm:py-5">
                <span class="w-11 h-11 sm:w-12 sm:h-12 shrink-0 rounded-2xl bg-gradient-to-br from-[#fff1e8] to-[#ffe0cc] text-primary flex items-center justify-center">
                  <StatIcon class="w-5 h-5" />
                </span>
                <div class="min-w-0">
                  <span class="block text-xl sm:text-2xl font-black text-neutral-900 leading-none tracking-tight">{stat.value}</span>
                  <span class="block text-xs sm:text-[13px] text-neutral-500 font-medium mt-1.5 leading-snug">{stat.label}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 2. INTRO BAND SECTION (MATCHING ABOUT.ASTRO DESIGN SYSTEM) -->
    <section class="py-12 sm:py-14 md:py-16 bg-cream relative overflow-hidden">
      <!-- Subtle decorative background -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.webp')] opacity-30"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl space-y-4 sm:space-y-6">
          <p class="text-[1.0625rem] sm:text-xl md:text-2xl font-medium sm:font-semibold text-neutral-800 sm:text-neutral-900 leading-[1.6] sm:leading-snug tracking-[-0.01em] pl-4 sm:pl-0 lg:pl-6 border-l-[3px] sm:border-l-0 lg:border-l-4 border-secondary">
            {page.introBand[0]}
          </p>
          <p class="text-[0.9375rem] sm:text-base md:text-lg text-neutral-600 leading-[1.7] sm:leading-relaxed font-normal sm:font-medium pl-0 lg:pl-7">
            {page.introBand[1]}
          </p>
          <div class="pt-2 pl-0 lg:pl-7">
            <a
              href="/request-a-quote/"
              class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 text-sm font-bold text-neutral-900 bg-white border border-neutral-200/90 rounded-full hover:border-primary hover:text-primary hover:shadow hover:-translate-y-0.5 transition-all duration-300 shadow-sm"
            >
              Talk About My Website
              <ArrowRight class="w-4 h-4 text-primary transition-transform duration-300" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. WHY TEKNOPPY SECTION (MATCHING WHYCHOOSEUS.ASTRO DESIGN SYSTEM) -->
    <section class="py-14 sm:py-16 md:py-20 bg-cream relative overflow-hidden">
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.webp')] opacity-75"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 relative z-10 min-w-0">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-12 xl:gap-20 items-start min-w-0">

          <!-- Left Column (Sticky Panel) -->
          <div class="lg:col-span-5 lg:sticky lg:top-32 space-y-8 min-w-0 w-full overflow-hidden">
            <div>
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
                {page.whyTeknoppy.badge}
              </div>
              <h2 class="text-4xl md:text-5xl font-black tracking-tight text-neutral-900 leading-[1.15] mb-6">
                {page.whyTeknoppy.headingLead} <br class="hidden sm:inline" />
                <span class="text-primary">{page.whyTeknoppy.headingAccent}</span>
              </h2>
              <p class="text-neutral-600 text-base leading-relaxed">
                {page.whyTeknoppy.intro}
              </p>
              <div class="pt-5">
                <a 
                  href="/request-a-quote/" 
                  class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 text-sm font-bold text-neutral-900 bg-white border border-neutral-200/90 rounded-full hover:border-primary hover:text-primary hover:shadow hover:-translate-y-0.5 transition-all duration-300 shadow-sm"
                >
                  Get My Website Started
                  <ArrowRight class="w-4 h-4 text-primary transition-transform duration-300" />
                </a>
              </div>
            </div>

            <!-- Trusted Partners Continuous Scrolling Marquee -->
            <div class="pt-8 space-y-4">
              <div>
                <p class="text-[12px] font-bold text-neutral-400 uppercase tracking-wider">Trusted Partners</p>
                <p class="text-sm font-semibold text-neutral-900 leading-tight">Trusted by 100+ Brands in Kochi & Beyond</p>
              </div>

              <!-- Marquee Track flanked by clean divider borders -->
              <div class="border-y border-neutral-200/70 py-4 sm:py-5">
                <div class="marquee-viewport relative w-full overflow-hidden marquee-mask py-1" aria-label="Trusted client brand logos">
                  <div class="flex w-max">
                    <!-- First set of logos -->
                    <div class="marquee-content flex items-center gap-6 sm:gap-8 lg:gap-10 pr-6 sm:pr-8 lg:pr-10 shrink-0">
                      {trustedPartnerLogos.map((logo) => (
                        <div class="logo-plate h-[72px] sm:h-[84px] lg:h-[98px] xl:h-[106px] min-w-[110px] sm:min-w-[130px] px-5 sm:px-7 py-2 rounded-xl border border-neutral-200/80 bg-white/95 shadow-[0_2px_6px_rgba(0,0,0,0.03)] flex items-center justify-center shrink-0 hover:border-primary/40 hover:shadow-md transition-all duration-300">
                          <img 
                            src={logo.src} 
                            alt={`${logo.name} logo`} 
                            loading="lazy" 
                            decoding="async" 
                            class="h-[56px] sm:h-[66px] lg:h-[80px] xl:h-[88px] w-auto max-w-[160px] sm:max-w-[200px] lg:max-w-[240px] xl:max-w-[270px] object-contain transition-all duration-300 mix-blend-multiply" 
                          />
                        </div>
                      ))}
                    </div>
                    <!-- Duplicate set for seamless continuous loop -->
                    <div class="marquee-content flex items-center gap-6 sm:gap-8 lg:gap-10 pr-6 sm:pr-8 lg:pr-10 shrink-0" aria-hidden="true">
                      {trustedPartnerLogos.map((logo) => (
                        <div class="logo-plate h-[72px] sm:h-[84px] lg:h-[98px] xl:h-[106px] min-w-[110px] sm:min-w-[130px] px-5 sm:px-7 py-2 rounded-xl border border-neutral-200/80 bg-white/95 shadow-[0_2px_6px_rgba(0,0,0,0.03)] flex items-center justify-center shrink-0 hover:border-primary/40 hover:shadow-md transition-all duration-300">
                          <img 
                            src={logo.src} 
                            alt={`${logo.name} logo`} 
                            loading="lazy" 
                            decoding="async" 
                            class="h-[56px] sm:h-[66px] lg:h-[80px] xl:h-[88px] w-auto max-w-[160px] sm:max-w-[200px] lg:max-w-[240px] xl:max-w-[270px] object-contain transition-all duration-300 mix-blend-multiply" 
                          />
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Compact conversion CTA connected to trusted partners marquee -->
              <div class="pt-2">
                <a 
                  href="/request-a-quote/" 
                  class="inline-flex items-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-bold text-neutral-900 bg-white border border-neutral-200/90 rounded-full hover:border-primary hover:text-primary hover:shadow hover:-translate-y-0.5 transition-all duration-300 shadow-sm"
                >
                  Build a Website Like These
                  <ArrowRight class="w-3.5 h-3.5 text-primary transition-transform duration-300" />
                </a>
              </div>
            </div>
          </div>

          <!-- Right Column (Custom Feature Cards Grid) -->
          <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6 min-w-0 w-full">
            {page.whyTeknoppy.cards.map((card, idx) => (
              <div class="relative bg-white border border-neutral-100/90 hover:border-primary/30 rounded-2xl p-6 sm:p-7 transition-all duration-500 group flex flex-col justify-between shadow-sm hover:shadow-[0_15px_40px_rgba(240,90,44,0.06)] hover:-translate-y-1">
                <div>
                  <div class="flex justify-between items-center mb-6">
                    <span class="text-xs font-mono font-bold text-primary bg-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wider">
                      {card.tag}
                    </span>
                    <span class="text-xs font-mono font-bold text-neutral-300 group-hover:text-primary transition-colors">
                      0{idx + 1}
                    </span>
                  </div>
                  <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3 leading-snug">
                    {card.title}
                  </h3>
                  <p class="text-neutral-600 text-sm leading-relaxed font-normal">
                    {card.description}
                  </p>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- 4. OUR WEB DESIGN SERVICES IN KOCHI (MATCHING SERVICES.ASTRO DESIGN SYSTEM) -->
    <section id="services" class="py-14 sm:py-16 md:py-20 bg-white relative overflow-hidden">
      <!-- Dynamic background container -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 theme-dim-bg bg-cover bg-center bg-no-repeat lg:bg-[url('/whatwedo.webp')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-8 sm:mb-10 md:mb-12">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
            {page.services.badge}
          </div>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight text-neutral-900 mb-6">
            {page.services.headingLead} <span class="text-primary">{page.services.headingAccent}</span> {page.services.headingRest}
          </h2>
          <p class="text-lg md:text-xl text-neutral-600 leading-relaxed font-medium">
            {page.services.intro}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 relative z-10">
          {page.services.cards.map((svc, i) => {
            const IconComp = serviceIcons[i];
