      ctaClassName="inline-flex items-center justify-center gap-2.5 px-7 sm:px-8 py-3.5 sm:py-4 text-sm sm:text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.25)] hover:bg-primary/95 hover:shadow-[0_8px_25px_rgba(240,90,44,0.35)] hover:-translate-y-0.5 transition-all shrink-0 group whitespace-nowrap"
      client:visible
    />

    <!-- 11. LATEST BLOG POSTS (MATCHING HOMEPAGE BLOG.ASTRO DESIGN SYSTEM) -->
    <section class="py-14 sm:py-16 md:py-20 bg-white relative overflow-hidden">
      <!-- Soft Background Accent Glows -->
      <div class="absolute top-0 left-0 w-80 h-80 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-0 w-80 h-80 bg-secondary/5 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-8 sm:mb-10 md:mb-12">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
              {page.blog.badge}
            </div>
            <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
              {page.blog.headingLead} <span class="text-primary">{page.blog.headingAccent}</span> {page.blog.headingRest}
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {blogPosts.map(post => (
            <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-primary/30 border border-neutral-100/90 transition-all duration-300 flex flex-col h-full">
              {post.image && (
                <div class="overflow-hidden aspect-[16/10] bg-neutral-100 relative">
                  <img 
                    src={post.image} 
                    alt={post.title} 
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              )}
              <div class="p-6 md:p-8 flex flex-col flex-grow justify-between">
                <div class="space-y-4">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-medium text-neutral-400">
                    <span class="text-[11px] font-black text-primary bg-primary/10 border border-primary/20 px-2.5 py-0.5 rounded-full uppercase tracking-wider whitespace-nowrap">
                      {post.category}
                    </span>
                    <span class="flex items-center gap-1 whitespace-nowrap">
                      <Clock class="w-3.5 h-3.5" />
                      {post.readTime}
                    </span>
                    <span class="flex items-center gap-1 whitespace-nowrap">
                      <Calendar class="w-3.5 h-3.5" />
                      {post.date}
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-neutral-900 leading-snug group-hover:text-primary transition-colors duration-300">
                    <a href={post.href}>{post.title}</a>
                  </h3>

                  <p class="text-sm text-neutral-500 leading-relaxed font-medium">
                    {post.excerpt}
                  </p>
                </div>

                <div class="pt-6 mt-6 border-t border-neutral-100/80">
                  <a 
                    href={post.href} 
                    class="inline-flex items-center gap-2 text-sm font-bold text-neutral-850 hover:text-primary transition-colors duration-300"
                  >
                    Read Article
                    <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-10 sm:mt-12 flex justify-center">
          <a href={page.blog.allLink.href} class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 text-sm font-bold text-neutral-900 bg-white border border-neutral-200/90 rounded-full hover:border-primary hover:text-primary hover:shadow hover:-translate-y-0.5 transition-all duration-300 shadow-sm">
            {page.blog.allLink.label}
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- 12. FAQS SECTION (MATCHING HOMEPAGE FAQ.ASTRO DESIGN SYSTEM) -->
    <section id="faq" class="py-14 sm:py-16 md:py-20 bg-cream relative overflow-hidden">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-10 md:mb-12">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
            {page.faqs.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight mb-4">
            {page.faqs.headingLead} <span class="text-primary">{page.faqs.headingAccent}</span>
          </h2>
          <p class="text-neutral-600 font-medium text-base md:text-lg max-w-xl mx-auto">
            {page.faqs.intro}
          </p>
        </div>

        <div class="max-w-3xl mx-auto space-y-3">
          {page.faqs.items.map(faq => (
            <details class="faq-group bg-white rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden border border-neutral-100 shadow-sm transition-all duration-300 hover:border-primary/20" name="faq">
              <summary class="flex items-center justify-between px-5 sm:px-6 py-4 sm:py-5 cursor-pointer list-none font-bold text-sm sm:text-[15px] text-neutral-900 transition-colors faq-summary">
                <h3 class="pr-6 leading-snug">{faq.q}</h3>
                <span class="ml-auto flex-shrink-0 bg-primary/5 rounded-full p-2 transition-all duration-300 faq-icon-container shadow-sm border border-primary/10">
                  <ChevronDown className="w-4 h-4 text-primary transition-transform duration-300 faq-icon" />
                </span>
              </summary>
              <div class="px-5 sm:px-6 pb-5 text-neutral-600 leading-relaxed font-normal text-sm faq-content">
                <div class="h-px w-full bg-neutral-100 mb-5"></div>
                <p set:html={faq.a}></p>
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- FAQ Schema & Page Schemas -->
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    </section>

    <!-- 13. MEET THE TEKNOPPY TEAM (E-E-A-T AUTHOR BLOCK) -->
    <section class="py-14 sm:py-16 md:py-20 bg-white relative overflow-hidden border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-8 sm:mb-10">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
            {page.author.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {page.author.headingLead} <span class="text-primary">{page.author.headingAccent}</span>
          </h2>
        </div>

        <div class="max-w-4xl bg-white rounded-3xl border border-neutral-100/90 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] p-6 sm:p-8 md:p-10">
          <div class="flex flex-col sm:flex-row sm:items-center gap-5 mb-6">
            <img 
              src="/team/sanal-edison.webp" 
              alt={`${page.author.name} — ${page.author.role}`} 
              width="64" 
              height="64" 
              loading="lazy" 
              class="w-16 h-16 rounded-full object-cover shadow-sm ring-2 ring-primary/40 flex-shrink-0"
            />
            <div>
              <h3 class="text-2xl font-black text-neutral-900">{page.author.name}</h3>
              <p class="text-sm font-bold text-primary">{page.author.role}</p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-6">
            <a href={`mailto:${page.author.email}`} class="inline-flex items-center gap-2 text-xs font-bold text-neutral-600 hover:text-primary transition-colors">
              <Mail class="w-4 h-4 text-primary" />
              {page.author.email}
            </a>
            <a href={`tel:${page.author.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-2 text-xs font-bold text-neutral-600 hover:text-primary transition-colors">
              <Phone class="w-4 h-4 text-primary" />
              {page.author.phone}
            </a>
          </div>

          <p class="text-neutral-600 text-sm sm:text-base leading-relaxed font-normal mb-8">{page.author.bio}</p>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-neutral-100">
            <a href={page.author.profileHref} class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:underline">
              More about our team
              <ArrowRight class="w-4 h-4" />
            </a>
            <span class="text-xs text-neutral-400 font-semibold italic">{page.author.reviewed}</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FooterCTA 
    heading="Ready to Start Your Website Project in Kochi?"
    description="Whether you are launching a new business website, rebuilding an outdated one, or scaling your web presence in Kochi — Teknoppy is ready to deliver. Start with a free website audit and see exactly where your current online presence stands, or request a quote and get a clear, no-obligation proposal within 24 hours."
    includeSchema={false}
  >
    <div slot="after-form" class="mt-12 pt-8 border-t border-white/20 space-y-6">
      <h3 class="text-2xl font-bold text-white flex items-center gap-3">
        <span class="w-8 h-1 bg-white rounded-full"></span>
        Visit Our Kochi Office
      </h3>
      <p class="text-sm md:text-base text-white/90 leading-relaxed font-medium">
        Teknoppy, Second Floor, Kaithakal Building, Door No 49,<br />
        Kaithakal Lane, Thykoodam, Vyttila, Ernakulam, Kochi, Kerala 682019<br />
        Phone: <a href="tel:+916282249224" class="underline hover:text-white">+91 6282249224</a> · Email: <a href="mailto:sales@teknoppy.com" class="underline hover:text-white">sales@teknoppy.com</a>
      </p>
      <div class="rounded-2xl overflow-hidden border border-white/20 shadow-lg">
        <iframe
          src="https://maps.google.com/maps?q=Teknoppy+Vyttila+Kochi&output=embed"
          width="100%"
          height="320"
          style="border:0"
          loading="lazy"
          title="Teknoppy office location in Vyttila, Kochi"
          class="w-full block"
        ></iframe>
      </div>
    </div>
  </FooterCTA>
</Layout>

<style>
  /* ---- Web Design in Kochi: reference design layer (page-scoped) ---- */
  .wdk-hero { background: radial-gradient(120% 90% at 76% 34%, #3a1608 0%, #1a0b05 45%, #0b0604 100%); }
  .wdk-hero-glow {
    position: absolute; right: -6%; top: 6%; width: 60%; height: 88%;
    background: radial-gradient(closest-side, rgba(255, 98, 30, 0.42), rgba(255, 98, 30, 0.12) 55%, transparent 100%);
    filter: blur(10px);
  }
  /* soft orange light arc along the bottom corners */
  .wdk-hero-arc {
    position: absolute; left: -40%; right: -40%; bottom: -142%; height: 150%;
    border-radius: 50%; border-top: 2px solid rgba(255, 110, 40, 0.75);
    box-shadow: 0 -12px 60px -6px rgba(255, 90, 20, 0.55), inset 0 30px 80px -30px rgba(255, 90, 20, 0.35);
  }
  .wdk-badge {
    display: inline-flex; align-items: center; gap: 0.5rem; max-width: 100%;
    padding: 0.4rem 0.9rem; border-radius: 999px;
    background: var(--color-primary); color: #fff;
    font-size: 0.8rem; font-weight: 700;
    box-shadow: 0 8px 22px -8px rgba(240, 90, 44, 0.8);
  }
  .wdk-visual img { filter: drop-shadow(0 30px 50px rgba(255, 90, 20, 0.28)); }
  @media (prefers-reduced-motion: no-preference) {
    .wdk-visual picture { display: block; animation: wdkFloat 7s ease-in-out infinite; }
  }
  @keyframes wdkFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  .wdk-stats {
    position: relative; z-index: 2; background: #fff; border: 1px solid rgba(240, 90, 44, 0.1); border-radius: 1.5rem;
    box-shadow: 0 24px 50px -34px rgba(160, 60, 20, 0.45);
  }
  .wdk-stats > div + div { border-left: 1px solid #f3ebe5; }
  @media (max-width: 1023px) {
    .wdk-stats > div:nth-child(3) { border-left: 0; }
    .wdk-stats > div:nth-child(n+3) { border-top: 1px solid #f3ebe5; }
  }
  /* process: dashed connector through the icon centres (single row on desktop) */
  @media (min-width: 1024px) {
    .wdk-process::before {
      content: ""; position: absolute; top: 2rem; left: 8%; right: 8%;
      border-top: 2px dashed rgba(240, 90, 44, 0.28);
    }
  }
  /* section label pills -> "— Label" eyebrows, as in the reference */
  .wdk-page :global(:is(div, span).rounded-full.uppercase.text-primary[class*="tracking-"][class*="mb-"]) {
    background: none; border: 0; box-shadow: none; transform: none; padding: 0;
    gap: 0.75rem; text-transform: none; letter-spacing: -0.005em; font-size: 1.05rem; font-weight: 700;
  }
  .wdk-page :global(:is(div, span).rounded-full.uppercase.text-primary[class*="tracking-"][class*="mb-"]::before) {
    content: ""; flex: none; width: 1.9rem; height: 2.5px; border-radius: 2px; background: currentColor;
  }
  .wdk-page :global(section h2.font-black) { letter-spacing: -0.032em; line-height: 1.06; }
  

  /* FAQ Interactive styling matching homepage */
  .faq-group[open] {
    background-color: var(--color-white);
    box-shadow: 0 16px 32px -8px rgba(240,90,44,0.08);
    border: 1px solid var(--color-primary);
  }
  
  .faq-group[open] .faq-summary {
    color: var(--color-primary);
  }
  
  .faq-group[open] .faq-icon-container {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }
  
  .faq-group[open] .faq-icon {
    color: var(--color-white);
    transform: rotate(-180deg);
  }

  details > .faq-content {
    animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Continuous Horizontal Scrolling Logo Marquee */
  .marquee-viewport {
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }

  .marquee-content {
    animation: marquee-scroll 45s linear infinite;
    will-change: transform;
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-100%, 0, 0);
    }
  }

  /* Pause or slow down on hover for desktop cursor interaction */
  @media (hover: hover) and (pointer: fine) {
    .marquee-viewport:hover .marquee-content {
      animation-play-state: paused;
    }
  }

  /* Respect user accessibility preferences */
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
    .marquee-viewport {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>
