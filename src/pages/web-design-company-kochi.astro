    <!-- 10. CLIENT TESTIMONIALS SECTION (REUSING EXACT HOMEPAGE COMPONENT) -->
    <Testimonials
      testimonials={testimonials}
      videos={videoTestimonials.videos}
      badge={page.testimonials.badge}
      headingLead={page.testimonials.headingLead}
      headingAccent={page.testimonials.headingAccent}
      headingRest={page.testimonials.headingRest}
      intro={page.testimonials.intro}
      ctaText="Let's Build My Website"
      ctaClassName="kochi-cta kochi-cta-primary inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-bold text-white bg-primary rounded-full hover:bg-primary/95 transition-all shadow-md shrink-0 group whitespace-nowrap"
      client:visible
    />

    <!-- 11. LATEST BLOG POSTS (MATCHING HOMEPAGE BLOG.ASTRO DESIGN SYSTEM) -->
    <section class="py-24 md:py-32 bg-white relative overflow-hidden">
      <!-- Soft Background Accent Glows -->
      <div class="absolute top-0 left-0 w-80 h-80 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-0 w-80 h-80 bg-secondary/5 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-16">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
              {page.blog.badge}
            </div>
            <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
              {page.blog.headingLead} <span class="text-primary">{page.blog.headingAccent}</span> {page.blog.headingRest}
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {blogPosts.map(post => (
            <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-primary/30 border border-neutral-100/80 transition-all duration-300 flex flex-col h-full">
              {post.image && (
                <div class="overflow-hidden aspect-[16/10] bg-neutral-100 relative">
                  <img 
                    src={post.image} 
                    alt={post.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              )}
              <div class="p-6 md:p-8 flex flex-col flex-grow justify-between">
                <div class="space-y-4">
                  <div class="flex items-center gap-3 text-xs font-medium text-neutral-400">
                    <span class="text-[11px] font-black text-primary bg-primary/10 border border-primary/20 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                      {post.category}
                    </span>
                    <span class="flex items-center gap-1">
                      <Clock class="w-3.5 h-3.5" />
                      {post.readTime}
                    </span>
                    <span class="flex items-center gap-1">
                      <Calendar class="w-3.5 h-3.5" />
                      {post.date}
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-neutral-900 leading-snug group-hover:text-primary transition-colors duration-300">
                    <a href={post.href}>{post.title}</a>
                  </h3>

                  <p class="text-sm text-neutral-500 leading-relaxed font-medium">
                    {post.excerpt}
                  </p>
                </div>

                <div class="pt-6 mt-6 border-t border-neutral-100/80">
                  <a 
                    href={post.href} 
                    class="inline-flex items-center gap-2 text-sm font-bold text-neutral-850 hover:text-primary transition-colors duration-300"
                  >
                    Read Article
                    <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-14 flex justify-center">
          <a href={page.blog.allLink.href} class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-bold text-neutral-900 bg-white border border-neutral-200 rounded-full hover:border-primary hover:text-primary hover:-translate-y-0.5 transition-all duration-300 shadow-sm">
            {page.blog.allLink.label}
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- 12. FAQS SECTION (MATCHING HOMEPAGE FAQ.ASTRO DESIGN SYSTEM) -->
    <section id="faq" class="py-24 md:py-32 bg-cream relative overflow-hidden">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
            {page.faqs.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight mb-4">
            {page.faqs.headingLead} <span class="text-primary">{page.faqs.headingAccent}</span>
          </h2>
          <p class="text-neutral-600 font-medium text-base md:text-lg max-w-xl mx-auto">
            {page.faqs.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
          {page.faqs.items.map(faq => (
            <details class="faq-group bg-white rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden border border-neutral-100 shadow-sm transition-all duration-300 hover:border-primary/20" name="faq">
              <summary class="flex items-center justify-between p-6 md:p-7 cursor-pointer list-none font-bold text-base sm:text-lg text-neutral-800 transition-colors faq-summary">
                <h3 class="pr-6 leading-snug">{faq.q}</h3>
                <span class="ml-auto flex-shrink-0 bg-primary/5 rounded-full p-2 transition-all duration-300 faq-icon-container shadow-sm border border-primary/10">
                  <ChevronDown className="w-4 h-4 text-primary transition-transform duration-300 faq-icon" />
                </span>
              </summary>
              <div class="px-6 md:px-7 pb-6 md:pb-7 text-neutral-600 leading-relaxed font-normal text-sm sm:text-base faq-content">
                <div class="h-px w-full bg-neutral-100 mb-5"></div>
                <p set:html={faq.a}></p>
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- FAQ Schema & Page Schemas -->
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    </section>

    <!-- 13. MEET THE TEKNOPPY TEAM (E-E-A-T AUTHOR BLOCK) -->
    <section class="py-24 md:py-32 bg-white relative overflow-hidden border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-12">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F9AE42]/10 border border-[#F9AE42]/30 text-primary text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform -rotate-1">
            {page.author.badge}
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            {page.author.headingLead} <span class="text-primary">{page.author.headingAccent}</span>
          </h2>
        </div>

        <div class="max-w-4xl bg-white rounded-3xl border border-neutral-100 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] p-8 sm:p-10">
          <div class="flex flex-col sm:flex-row sm:items-center gap-5 mb-6">
            <img 
              src="/team/sanal-edison.webp" 
              alt={`${page.author.name} — ${page.author.role}`} 
              width="64" 
              height="64" 
              loading="lazy" 
              class="w-16 h-16 rounded-full object-cover shadow-sm ring-2 ring-primary/40 flex-shrink-0"
            />
            <div>
              <h3 class="text-2xl font-black text-neutral-900">{page.author.name}</h3>
              <p class="text-sm font-bold text-primary">{page.author.role}</p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-6">
            <a href={`mailto:${page.author.email}`} class="inline-flex items-center gap-2 text-xs font-bold text-neutral-600 hover:text-primary transition-colors">
              <Mail class="w-4 h-4 text-primary" />
              {page.author.email}
            </a>
            <a href={`tel:${page.author.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-2 text-xs font-bold text-neutral-600 hover:text-primary transition-colors">
              <Phone class="w-4 h-4 text-primary" />
              {page.author.phone}
            </a>
          </div>

          <p class="text-neutral-600 text-sm sm:text-base leading-relaxed font-normal mb-8">{page.author.bio}</p>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-neutral-100">
            <a href={page.author.profileHref} class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:underline">
              More about our team
              <ArrowRight class="w-4 h-4" />
            </a>
            <span class="text-xs text-neutral-400 font-semibold italic">{page.author.reviewed}</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FooterCTA 
    heading="Ready to Work with the Leading Web Design Company in Kochi?"
    description="Whether you are launching a new business website, rebuilding an outdated one, or scaling your web presence in Kochi — Teknoppy is ready to deliver. Start with a free website audit and see exactly where your current online presence stands, or request a quote and get a clear, no-obligation proposal within 24 hours."
    includeSchema={false}
  >
    <div slot="after-form" class="mt-12 pt-8 border-t border-white/20 space-y-6">
      <h3 class="text-2xl font-bold text-white flex items-center gap-3">
        <span class="w-8 h-1 bg-white rounded-full"></span>
        Visit Our Kochi Office
      </h3>
      <p class="text-sm md:text-base text-white/90 leading-relaxed font-medium">
        Teknoppy, Second Floor, Kaithakal Building, Door No 49,<br />
        Kaithakal Lane, Thykoodam, Vyttila, Ernakulam, Kochi, Kerala 682019<br />
        Phone: <a href="tel:+916282249224" class="underline hover:text-white">+91 6282249224</a> · Email: <a href="mailto:sales@teknoppy.com" class="underline hover:text-white">sales@teknoppy.com</a>
      </p>
      <div class="rounded-2xl overflow-hidden border border-white/20 shadow-lg">
        <iframe
          src="https://maps.google.com/maps?q=Teknoppy+Vyttila+Kochi&output=embed"
          width="100%"
          height="320"
          style="border:0"
          loading="lazy"
          title="Teknoppy office location in Vyttila, Kochi"
          class="w-full block"
