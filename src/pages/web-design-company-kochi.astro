  </FooterCTA>
</Layout>

<style>
  /* FAQ Interactive styling matching homepage */
  .faq-group[open] {
    background-color: var(--color-white);
    box-shadow: 0 16px 32px -8px rgba(240,90,44,0.08);
    border: 1px solid var(--color-primary);
  }
  
  .faq-group[open] .faq-summary {
    color: var(--color-primary);
  }
  
  .faq-group[open] .faq-icon-container {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }
  
  .faq-group[open] .faq-icon {
    color: var(--color-white);
    transform: rotate(-180deg);
  }

  details > .faq-content {
    animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Continuous Horizontal Scrolling Logo Marquee */
  .marquee-viewport {
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }

  .marquee-content {
    animation: marquee-scroll 45s linear infinite;
    will-change: transform;
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-100%, 0, 0);
    }
  }

  /* Pause or slow down on hover for desktop cursor interaction */
  @media (hover: hover) and (pointer: fine) {
    .marquee-viewport:hover .marquee-content {
      animation-play-state: paused;
    }
  }

  /* Respect user accessibility preferences */
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
    .marquee-viewport {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>
