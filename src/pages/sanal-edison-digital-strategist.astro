---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import site from '../data/site.json';
import page from '../data/pages/leadership.json';

const PERSON_ID = 'https://teknoppy.com/sanal-edison-digital-strategist/#person';

// The doc requires the placeholder LinkedIn / personal-site links to be replaced
// with verified URLs before publishing. Until they are supplied the words render
// as plain text rather than as dead links, and sameAs is left out of the schema.
const { linkedinUrl, personalWebsiteUrl } = page.connect;
const sameAs = [linkedinUrl, personalWebsiteUrl].filter((u) => u && u !== '#');

const link = (url: string, label: string) =>
  url && url !== '#'
    ? `<a href="${url}" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold hover:underline">${label}</a>`
    : `<strong class="text-neutral-800">${label}</strong>`;

const connectHtml = page.connect.html
  .replace('{{linkedin}}', link(linkedinUrl, 'LinkedIn'))
  .replace('{{website}}', link(personalWebsiteUrl, 'personal website'));

const schemas: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": PERSON_ID,
    "name": page.hero.name,
    "jobTitle": ["Digital Strategist", "Founder"],
    "image": `https://teknoppy.com${page.hero.photo}`,
    "url": "https://teknoppy.com/sanal-edison-digital-strategist/",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://teknoppy.com/#organization",
      "name": site.businessName,
      "url": "https://teknoppy.com/"
    },
    ...(sameAs.length ? { sameAs } : {})
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": page.faq.items.map((f: any) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://teknoppy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Leadership", "item": "https://teknoppy.com/sanal-edison-digital-strategist/" }
    ]
  }
];

// Visual accent only: a heading's last word renders in the brand colour.
const split = (h: string) => {
  const i = h.lastIndexOf(' ');
  return i < 0 ? ['', h] : [h.slice(0, i + 1), h.slice(i + 1)];
};
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-white">
    <!-- HERO — dark band; photo stacks above the name on mobile -->
    <section class="relative bg-[#141414] text-white pt-32 pb-36 md:pt-40 md:pb-44 overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-40 -right-40 w-[560px] h-[560px] rounded-full border border-primary/30"></div>
        <div class="absolute -top-24 -right-24 w-[420px] h-[420px] rounded-full bg-primary/10 blur-3xl"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 grid md:grid-cols-[1fr_auto] gap-10 md:gap-16 items-center">
        <div class="order-2 md:order-1">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-primary/70 text-xs font-bold text-primary uppercase tracking-widest mb-7">
            <span class="w-2 h-2 rounded-full bg-primary ring-4 ring-primary/25"></span>
            {page.hero.badge}
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[64px] font-black leading-[1.05] tracking-tight mb-3">
            {page.hero.name}
          </h1>
          <p class="text-lg sm:text-xl font-bold text-primary mb-6">{page.hero.role}</p>
          <p class="text-sm sm:text-base text-neutral-300 max-w-2xl leading-relaxed">{page.hero.intro}</p>
          <p class="text-xs sm:text-sm text-neutral-500 font-semibold italic mt-6">{page.hero.reviewedLine}</p>
        </div>

        <div class="order-1 md:order-2 relative w-44 h-44 sm:w-56 sm:h-56 lg:w-72 lg:h-72 mx-auto md:mx-0">
          <div class="absolute -inset-4 rounded-full border-[3px] border-transparent border-b-primary border-r-primary rotate-12"></div>
          <div class="absolute inset-0 rounded-full bg-white p-2 shadow-[0_20px_60px_rgba(240,90,44,0.35)]">
            <img src={page.hero.photo} alt={page.hero.photoAlt} width="288" height="288" class="w-full h-full rounded-full object-cover" />
          </div>
        </div>
      </div>

      <svg class="absolute bottom-0 left-0 w-full h-24 md:h-32" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 140 L0 110 C360 140 720 30 1080 60 C1260 75 1380 40 1440 20 L1440 140 Z" fill="#f05a2c" />
        <path d="M0 140 L0 125 C380 150 760 60 1100 85 C1270 97 1390 70 1440 55 L1440 140 Z" fill="#ffffff" />
      </svg>
    </section>

    <!-- BACKGROUND / LEADS / PHILOSOPHY -->
    {page.sections.map((s: any, i: number) => {
      const [lead, last] = split(s.heading);
      return (
        <section class="py-10 sm:py-14">
          <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
            <div class={i === 1 ? 'rounded-[28px] bg-[#fff4ec] border border-primary/10 px-6 py-10 sm:px-12 sm:py-12 shadow-[0_10px_40px_rgba(240,90,44,0.06)]' : ''}>
              <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">
                {lead}<span class={i === 0 ? '' : 'text-primary'}>{last}</span>
              </h2>
              <span class="block w-16 h-1 rounded-full bg-primary mt-4 mb-6"></span>
              <p class="max-w-4xl text-neutral-700 text-sm sm:text-base leading-relaxed">{s.text}</p>
            </div>
          </div>
        </section>
      );
    })}

    <!-- CONNECT WITH SANAL -->
    <section class="py-10 sm:py-14">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="relative overflow-hidden rounded-[28px] bg-[#fff4ec] border border-primary/10 px-6 py-10 sm:px-12 sm:py-12">
          <div class="absolute -bottom-24 -right-16 w-80 h-80 rounded-[45%] bg-primary/10 rotate-12 pointer-events-none" aria-hidden="true"></div>
          <div class="relative">
            <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight mb-6">
              {split(page.connect.heading)[0]}<span class="text-primary">{split(page.connect.heading)[1]}</span>
            </h2>
            <p class="max-w-3xl text-neutral-700 text-sm sm:text-base leading-relaxed" set:html={connectHtml} />

            <div class="flex flex-wrap gap-4 mt-8">
              {page.connect.relatedLinks.map((l: any) => (
                <a
                  href={l.href}
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white border-2 border-primary text-sm font-bold text-neutral-900 hover:bg-primary hover:text-white transition-colors"
                >
                  {l.label}
                  <ArrowUpRight class="w-4 h-4" />
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-10 sm:py-14">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">
          {split(page.faq.heading)[0]}<span class="text-primary">{split(page.faq.heading)[1]}</span>
        </h2>
        <span class="block w-16 h-1 rounded-full bg-primary mt-4 mb-8"></span>

        <div class="space-y-3">
          {page.faq.items.map((faq: any) => (
            <details class="group rounded-2xl border border-neutral-200 bg-white px-6 py-4 transition-colors open:bg-[#fff4ec] open:border-primary/20 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
                <h3 class="text-sm sm:text-base font-bold text-neutral-900 pr-4">{faq.q}</h3>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-neutral-900 group-open:text-primary flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-3 text-xs sm:text-sm text-neutral-700 leading-relaxed max-w-3xl">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="pt-6 pb-16 sm:pb-20">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="rounded-[28px] bg-[#141414] px-6 py-10 sm:px-12 sm:py-12 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <p class="text-white font-medium text-base sm:text-lg leading-relaxed max-w-2xl">{page.cta.text}</p>
          <a
            href={page.cta.href}
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 flex-shrink-0"
          >
            {page.cta.label}
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <FooterCTA />

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</Layout>
