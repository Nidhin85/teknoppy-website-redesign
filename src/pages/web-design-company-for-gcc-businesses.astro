---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/web-design-company-for-gcc-businesses.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="svc-cluster overflow-hidden bg-cream/20">
    <InnerPage page={page} pillar="gcc" />
  </main>

  <FooterCTA />
</Layout>
