---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { Zap, ArrowRight, Star, ShieldCheck, ExternalLink } from 'lucide-react';
import site from '../data/site.json';
import page from '../data/pages/certifications.json';

// The source doc forbids publishing placeholder badges, ratings, or testimonials.
// Each block therefore renders only once real data exists in the JSON.
const certifications = (page.certifications.items ?? []).filter((c: any) => c.name);
const ratings = (page.ratings.items ?? []).filter((r: any) => r.rating);
// Featured testimonials come from src/content/testimonials — the same five real,
// named clients quoted across the rest of the site. The JSON array stays supported
// so an editor can override the selection from the CMS.
const jsonTestimonials = (page.testimonials.items ?? []).filter((t: any) => t.quote);
const testimonials = jsonTestimonials.length
  ? jsonTestimonials
  : (await getCollection('testimonials'))
      .sort((a, b) => a.data.order - b.data.order)
      .map((t) => ({ quote: t.data.quote, name: t.data.name, company: t.data.role }));

const sameAs = [
  ...ratings.map((r: any) => r.url),
  site.social.linkedin,
  site.social.instagram,
  site.social.twitter
].filter((u) => u && u !== '#');

// Review / AggregateRating markup is withheld until a rating is backed by at
// least five genuine reviews, exactly as the doc instructs.
const rated = ratings.filter((r: any) => Number(r.reviewCount) >= 5 && Number(r.rating) > 0);
const totalReviews = rated.reduce((n: number, r: any) => n + Number(r.reviewCount), 0);
const avgRating = totalReviews
  ? (rated.reduce((n: number, r: any) => n + Number(r.rating) * Number(r.reviewCount), 0) / totalReviews).toFixed(1)
  : null;

const schemas: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": site.businessName,
    "url": "https://teknoppy.com/",
    "logo": "https://teknoppy.com/logo.svg",
    "email": site.email,
    "telephone": site.phone,
    "founder": { "@id": "https://teknoppy.com/sanal-edison-digital-strategist/#person" },
    ...(sameAs.length ? { sameAs } : {}),
    ...(avgRating
      ? {
          aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: avgRating,
            reviewCount: String(totalReviews)
          }
        }
      : {})
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": page.faq.items.map((f: any) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://teknoppy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Certifications", "item": "https://teknoppy.com/certifications/" }
    ]
  }
];
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- HERO -->
    <section class="relative pt-32 pb-20 md:pt-36 md:pb-24 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.webp')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
            <Zap class="w-3.5 h-3.5" />
            {page.hero.badge}
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-black leading-[1.1] tracking-tight text-white mb-6">
            {page.hero.h1Lead}{' '}
            <span class="relative inline-block text-primary">
              {page.hero.h1Accent}
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
          </h1>
          <p class="text-base sm:text-lg text-neutral-300 max-w-3xl font-medium leading-relaxed">
            {page.hero.intro}
          </p>
          {page.hero.verifiedLine && (
            <p class="text-xs sm:text-sm text-neutral-400 font-semibold italic mt-8">{page.hero.verifiedLine}</p>
          )}
        </div>
      </div>
    </section>

    <!-- PLATFORM CERTIFICATIONS -->
    <!-- Heading and intro promise verifiable badges, so the whole section is held
         back until at least one real certification exists in the JSON. -->
    {certifications.length > 0 && (
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight mb-6">{page.certifications.heading}</h2>
        <p class="max-w-4xl text-neutral-600 text-sm sm:text-base leading-relaxed font-medium">{page.certifications.intro}</p>

        {(
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
            {certifications.map((cert: any) => (
              <a
                href={cert.verificationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col items-start"
              >
                <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
                {cert.badge
                  ? <img src={cert.badge} alt={`${cert.name} certification badge`} loading="lazy" decoding="async" class="h-16 w-auto object-contain mb-5" />
                  : <span class="w-[52px] h-[52px] bg-primary/5 text-primary rounded-2xl flex items-center justify-center border border-primary/10 mb-5"><ShieldCheck class="w-5 h-5" /></span>}
                <h3 class="text-base font-black text-neutral-900 leading-snug">{cert.name}</h3>
                <span class="inline-flex items-center gap-1.5 text-xs font-black text-primary mt-4 uppercase tracking-wider">
                  Verify
                  <ExternalLink class="w-3.5 h-3.5" />
                </span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
    )}

    <!-- CLIENT REVIEWS AND RATINGS -->
    <!-- Same rule: no live platform rating, no section. Never publish an
         estimated or placeholder score. -->
    {ratings.length > 0 && (
    <section class="py-16 sm:py-20 bg-[#FFF8EF]/30 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight mb-6">{page.ratings.heading}</h2>
        <p class="max-w-4xl text-neutral-600 text-sm sm:text-base leading-relaxed font-medium">{page.ratings.intro}</p>

        {(
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
            {ratings.map((r: any) => (
              <a
                href={r.url}
                target={r.url ? '_blank' : undefined}
                rel={r.url ? 'noopener noreferrer' : undefined}
                class="bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 transition-all duration-300 flex flex-col"
              >
                <span class="text-[10px] font-black text-primary uppercase tracking-widest mb-3">{r.platform}</span>
                <div class="flex items-baseline gap-2">
                  <span class="text-3xl font-black text-neutral-900 leading-none">{r.rating}</span>
                  <div class="flex gap-0.5 text-[#F9AE42]">
                    {[0, 1, 2, 3, 4].map((i) => (
                      <Star class={`w-3.5 h-3.5 ${i < Math.round(Number(r.rating)) ? 'fill-current' : 'opacity-30'}`} />
                    ))}
                  </div>
                </div>
                <span class="text-xs text-neutral-500 font-semibold mt-3">from {r.reviewCount} reviews</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
    )}

    <!-- FEATURED TESTIMONIALS -->
    {testimonials.length > 0 && (
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight mb-6">{page.testimonials.heading}</h2>
        <p class="max-w-4xl text-neutral-600 text-sm sm:text-base leading-relaxed font-medium">{page.testimonials.intro}</p>

        {testimonials.length > 0 && (
          <div class="grid md:grid-cols-3 gap-6 mt-10">
            {testimonials.map((t: any) => (
              <figure class="bg-white rounded-3xl border border-neutral-200/60 p-6 shadow-sm flex flex-col justify-between">
                <blockquote class="border-l-4 border-primary pl-4 py-1.5 bg-[#FFF8EF]/30 rounded-r-2xl">
                  <p class="text-sm text-neutral-600 font-medium italic leading-relaxed">"{t.quote}"</p>
                </blockquote>
                <figcaption class="border-t border-neutral-100 pt-4 mt-5">
                  <span class="block text-sm font-bold text-neutral-800">{t.name}</span>
                  {t.company && <span class="block text-[10px] text-neutral-400 font-bold uppercase tracking-wider mt-0.5">{t.company}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
    )}

    <!-- WHY THIS MATTERS -->
    <section class="py-16 sm:py-20 bg-neutral-50/50 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight mb-6">{page.whyThisMatters.heading}</h2>
        <p class="max-w-4xl text-neutral-600 text-sm sm:text-base leading-relaxed font-medium" set:html={page.whyThisMatters.html} />
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight mb-10 text-center">{page.faq.heading}</h2>

        <div class="max-w-4xl mx-auto space-y-4">
          {page.faq.items.map((faq: any) => (
            <details class="group bg-white rounded-2xl border border-neutral-200/60 p-6 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
                <h3 class="text-sm sm:text-base font-bold text-neutral-850 pr-4">{faq.q}</h3>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-primary flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-neutral-100/60 text-xs sm:text-sm text-neutral-600 leading-relaxed font-semibold">
                {faq.aHtml ? <Fragment set:html={faq.aHtml} /> : faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 sm:py-20 bg-[#FFF8EF]/30 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-4xl mx-auto text-center">
          <p class="text-neutral-700 font-medium text-base sm:text-lg leading-relaxed mb-8">{page.cta.html}</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            {page.cta.buttons.map((btn: any, i: number) => (
              <a
                href={btn.href}
                class={i === 0
                  ? "w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300"
                  : "w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-primary border border-primary/30 bg-white rounded-full hover:bg-primary/5 transition-all duration-300"}
              >
                {btn.label}
                <ArrowRight class="w-4 h-4" />
              </a>
            ))}
          </div>
          <p class="text-sm text-neutral-500 font-medium mt-8" set:html={page.cta.leadershipHtml} />
        </div>
      </div>
    </section>
  </main>

  <FooterCTA />

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</Layout>
