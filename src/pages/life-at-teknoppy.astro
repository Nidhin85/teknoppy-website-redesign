---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StudioGallery from '../components/life/StudioGallery.astro';
import Celebrations from '../components/life/Celebrations.astro';
import LifeLightbox from '../components/life/LifeLightbox.astro';

const title = "Life at Teknoppy | Team, Culture & Our Vyttila Office";
const description = "Life at Teknoppy: meet the 12-person in-house team in Vyttila, Kochi behind 120+ websites since 2018. See how we work, our values and a typical day.";

// Structured data schemas
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.teknoppy.com/#organization",
  "name": "Teknoppy",
  "numberOfEmployees": { "@type": "QuantitativeValue", "value": 12 },
  "url": "https://www.teknoppy.com/",
  "logo": "https://www.teknoppy.com/logo.svg",
  "telephone": "+91 6282249224",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam",
    "addressLocality": "Vyttila, Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  }
};

const localBizSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.teknoppy.com/#localbusiness",
  "name": "Teknoppy",
  "image": "https://www.teknoppy.com/og-image.png",
  "telephone": "+91 6282249224",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam",
    "addressLocality": "Vyttila, Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 9.9678,
    "longitude": 76.3197
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:30",
      "closes": "17:30"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is life at Teknoppy like?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A tight-knit in-house team in Vyttila, Kochi. Designers, developers and SEO specialists work on the same accounts, and juniors get real projects from week one."
      }
    },
    {
      "@type": "Question",
      "name": "Where is the office?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Second Floor, Kaithakal Building, Thykoodam, Vyttila, Kochi 682019. A 3-minute walk from Thykoodam Metro. Open Monday to Saturday, 9:30 am to 5:30 pm."
      }
    },
    {
      "@type": "Question",
      "name": "Can I visit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, clients and candidates are welcome by appointment. Call +91 6282249224."
      }
    }
  ]
};

const team = [
  ["Niya K K", "niya-kk"],
  ["Nandana", "nandana"],
  ["Vijayakala", "vijayakala"],
  ["Adithya K", "adithya-k"],
  ["Neha P", "neha-p"],
  ["Vaisakh", "vaisakh-jayadev"],
  ["Sanal Edison", "sanal-edison"]
];

const allEmployees = [
  { name: "Sanal Edison", role: "Founder & Digital Strategist", slug: "sanal-edison" },
  { name: "Vijayakala", role: "Business Development & Client Relations", slug: "vijayakala" },
  { name: "Niya K K", role: "SEO Lead", slug: "niya-kk" },
  { name: "Neha P", role: "SEO Analyst", slug: "neha-p" },
  { name: "Nandana S Madhu", role: "Web Developer", slug: "nandana" },
  { name: "Adithya K", role: "Social Media Content Strategist", slug: "adithya-k" },
  { name: "Vaisakh Jayadev", role: "Videographer & Video Editor", slug: "vaisakh-jayadev" },
  { name: "Nithya Sibi", role: "Jr. SEO Executive", slug: "nithya-sibi" },
  { name: "Anjali Babu", role: "Jr. SEO Executive", slug: "anjali-babu" },
  { name: "Anjana Babu", role: "Jr. SEO Executive", slug: "anjana-babu" },
  { name: "Farsana A", role: "Jr. SEO Executive", slug: "farsana-a" },
  { name: "Jyothsana P K", role: "Jr. SEO Executive", slug: "jyothsana-pk" }
];

// Decorative role icons (paths only), index-matched with allEmployees.slice(1)
const roleIcons = [
  '<rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  '<path d="M3 3v18h18"/><path d="M8 17v-4M13 17V7M18 17v-7"/>',
  '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
  '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  '<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
  '<path d="m16 13 5.2 3.5a.5.5 0 0 0 .8-.4V7.9a.5.5 0 0 0-.8-.4L16 11"/><rect width="14" height="12" x="2" y="6" rx="2"/>',
  '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  '<path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/>',
  '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>'
];
const [founder, ...crew] = allEmployees;

const stats = [
  ["2018", "Founded in Kochi"],
  ["12", "People, all in-house"],
  ["120+", "Websites delivered"],
  ["3", "Kerala, UAE and Qatar"]
];

const steps = [
  ["Discovery", "We listen to your goals, budget and timeline."],
  ["Strategy", "Every page gets a purpose and a keyword."],
  ["Design", "Wireframes first. You approve before any code."],
  ["Build", "Fast, clean WordPress or custom builds."],
  ["SEO", "Schema, speed and on-page checks before launch."],
  ["Launch", "Live, tracked, with a plain-language monthly report."]
];

const values = [
  [
    "Every page earns its place",
    "A clear goal and a keyword for each one.",
    "/images/life/teknoppy-workstation-laptop-planning.jpg",
    "Architecture and page strategy planning at Teknoppy"
  ],
  [
    "Reviewed before it ships",
    "Senior eyes on every piece of work.",
    "/images/life/teknoppy-side-by-side-review.jpg",
    "Side-by-side QA and design review"
  ],
  [
    "Provable, not claimed",
    "Real data and real rankings, not adjectives.",
    "/images/life/teknoppy-developer-workstation.jpg",
    "Real code and performance analytics"
  ],
  [
    "Learn in the open",
    "Friday knowledge-share and constant certifications.",
    "/images/life/teknoppy-friday-knowledge-share.jpg",
    "Friday team knowledge sharing session"
  ],
  [
    "Clients hear it from us first",
    "One named contact, same-day honesty.",
    "/images/life/teknoppy-client-consultation-lenaa.webp",
    "Direct client consultation at Teknoppy"
  ]
];

const voices = [
  ["Niya K K", "SEO Lead", "niya-kk", "Watching local businesses reach the top three on Google is the best part of my job."],
  ["Nandana S Madhu", "Web Developer", "nandana", "Designers, developers and SEOs sit at one table, so problems are caught before staging."],
  ["Neha P", "SEO Analyst", "neha-p", "Every technical audit and performance report is rooted in verified ranking data, so our clients see exactly how their search visibility grows."],
  ["Vijayakala", "Client Relations", "vijayakala", "We never overpromise. Clients value that honesty more than anything."]
];

const dayItems = [
  ["9:30", "Stand-up", "Ten minutes: what ships, what's blocked.", "teknoppy-individual-workstation-focus.png"],
  ["12:00", "Peer reviews", "Seniors review juniors side by side.", "teknoppy-side-by-side-review.jpg"],
  ["1:00", "Lunch together", "Tea, conversation, a proper break.", "teknoppy-team-lunch-together.jpg"],
  ["2:00", "Client calls", "Kerala, UAE and Qatar, in person or on Gulf time.", "teknoppy-client-consultation-lenaa.webp"],
  ["5:00", "Wrap-up", "Commits merged, tomorrow planned.", "teknoppy-developer-workstation.jpg"]
];

// Decorative icons (paths only), index-matched with dayItems
const dayIcons = [
  '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  '<path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><path d="M6 2v2M10 2v2M14 2v2"/>',
  '<path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/>',
  '<path d="M20 6 9 17l-5-5"/>'
];

const tickItems = [
  "Design",
  "Development",
  "SEO",
  "Social content",
  "Client care",
  "Kochi to the Gulf"
];

// Decorative line icons (paths only), index-matched with `steps` and `growItems`
const stepIcons = [
  '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
  '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>',
  '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>'
];
const growIcons = [
  '<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8M12 17v4"/>',
  '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  '<path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><path d="M6 2v2M10 2v2M14 2v2"/>'
];

const growItems = [
  ["Real projects from week one", "Juniors join live client work straight away, with a senior beside them.", "teknoppy-side-by-side-review.jpg", "Junior developer and senior colleague reviewing live client code at workstation"],
  ["Side-by-side mentorship", "Reviews happen at the desk, not over tickets.", "teknoppy-side-by-side-mentorship.webp", "Side-by-side mentorship and collaborative desk review at Teknoppy"],
  ["Friday knowledge-share", "Tools, technical SEO and development, shared every week.", "teknoppy-friday-knowledge-share.webp", "Friday knowledge-share and technical development session with the Teknoppy team"],
  ["Lunch and tea together", "A proper break, most days, with the whole team.", "teknoppy-team-lunch-together.jpg", "Teknoppy team enjoying lunch and tea together"]
];
---

<Layout
  title={title}
  description={description}
  canonical="https://www.teknoppy.com/life-at-teknoppy/"
  image="/images/life/teknoppy-core-team-portrait.jpg"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Plus+Jakarta+Sans:wght@400;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBizSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header forceSolidBg={true} />

  <div class="life-container">
    <!-- Top Progress Bar -->
    <div class="bar" id="bar"></div>

    <main class="life-main">
      <!-- 1. HERO SECTION -->
      <section class="hero">
        <div class="blob b1"></div>
        <div class="blob b2"></div>

        <div class="hero-copy">
          <span class="pill rv">Vyttila, Kochi · since 2018</span>
          <h1 data-split>Life at Teknoppy</h1>
          <p class="lead rv" style="--d:.5s">Twelve specialists. One room. A team that loves building good websites together.</p>
          <div class="cta rv" style="--d:.7s">
            <a class="btn solid" href="/career/">See open roles</a>
            <a class="btn ghost" href="#team">Meet the team</a>
          </div>
        </div>

        <div class="orbit-wrap rv" style="--d:.3s">
          <div class="ring"></div>
          <div class="orbit" id="orbit">
            {team.map((p, k) => (
              <div class="node" style={`--a:${(360 / team.length) * k}deg`}>
                <span class="av" data-n={p[0]}>
                  <img src={`/team/${p[1]}.webp`} alt={p[0]} width="84" height="84" loading="eager" />
                </span>
              </div>
            ))}
          </div>
          <div class="core">
            <img src="/images/life/teknoppy-core-team-portrait.jpg" alt="The Teknoppy team" width="300" height="300" loading="eager" />
          </div>
        </div>
      </section>

      <!-- 2. STATS SECTION -->
      <section class="stats" id="stats">
        {stats.map((s, k) => (
          <div class="stat rv" style={`--d:${k * 0.1}s`}>
            <b data-c={s[0]}>{s[0]}</b>
            <span>{s[1]}</span>
          </div>
        ))}
      </section>

      <!-- 3. ANIMATED TICKER -->
      <div class="tick">
        <div id="tick">
          {[...tickItems, ...tickItems].map((t) => (
            <span>{t}</span>
          ))}
        </div>
      </div>

      <!-- 4. STUDIO MEDIA GRID -->
      <section class="sec space">
        <h2 class="rv">Where good work <span class="hl">happens</span></h2>
        <p class="sub rv">Real photos from our Vyttila studio.</p>
        <div class="mg">
          <figure class="big rv">
            <img src="/images/life/teknoppy-inhouse-team-full-lineup.jpg" alt="The in-house Teknoppy team" loading="lazy" />
            <figcaption><svg class="fci" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>The in-house team</figcaption>
          </figure>
          <figure class="rv" style="--d:.1s">
            <img src="/images/life/teknoppy-design-sprint-collaboration.jpg" alt="Design and sprint floor collaboration" loading="lazy" />
            <figcaption><svg class="fci" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>Design and sprint floor</figcaption>
          </figure>
          <figure class="rv" style="--d:.2s">
            <img src="/images/life/teknoppy-side-by-side-review.jpg" alt="Side-by-side peer reviews" loading="lazy" />
            <figcaption><svg class="fci" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>Side-by-side reviews</figcaption>
          </figure>
        </div>
      </section>

      <!-- 5. PROCESS STEPS -->
      <section class="sec" id="process">
        <div class="ph">
        <h2 class="rv">How a project <span class="hl">moves</span></h2>
        <p class="sub rv">Six stages. The same people from first call to monthly report.</p>
        </div>
        <ol class="steps" id="steps">
          {steps.map((s, k) => (
            <li class="step rv" style={`--d:${k * 0.08}s`}>
              <span class="sic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={stepIcons[k]} /></span>
              <i>{k + 1}</i>
              <h3>{s[0]}</h3>
              <p>{s[1]}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- 6. HOW WE GROW TOGETHER -->
      <section class="sec" id="grow">
        <h2 class="rv">How we grow <span class="hl">together</span></h2>
        <p class="sub rv">Tap an item to see it in action.</p>
        <div class="grow rv">
          <div class="gimg" id="gimg">
            {growItems.map((g, k) => (
              <img src={`/images/life/${g[2]}`} alt={g[3] || g[0]} class={k === 0 ? "on" : ""} loading="lazy" width="1024" height="682" />
            ))}
          </div>
          <div class="gl" id="gl">
            {growItems.map((g, k) => (
              <div class={`gi ${k === 0 ? "on" : ""}`} data-k={k}>
                <span class="gic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={growIcons[k]} /></span>
                <h3>{g[0]}</h3>
                <p>{g[1]}</p>
                <span class="garr" aria-hidden="true">→</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. VALUES ACCORDION & FOUNDER QUOTE -->
      <section class="sec" id="values">
        <h2 class="rv">What we <span class="hl">value</span></h2>
        <div class="acc" id="acc">
          {values.map((v, k) => (
            <article class="panel rv" tabindex="0" style={`--d:${k * 0.08}s`}>
              <div class="panel-content">
                <h3>{v[0]}</h3>
                <p>{v[1]}</p>
              </div>
              <div class="panel-img">
                <img src={v[2]} alt={v[3]} loading="lazy" />
              </div>
            </article>
          ))}
        </div>
        <blockquote class="founder rv">
          <img src="/team/sanal-edison.webp" alt="Sanal Edison" width="96" height="96" loading="lazy" />
          <p>Clients should talk directly to the specialists building their site.</p>
          <cite>Sanal Edison, Founder</cite>
        </blockquote>
      </section>

      <!-- 8. TEAM FACES -->
      <section class="sec" id="team">
        <div class="th">
          <div class="thl">
            <span class="pill tpill rv">Our Team</span>
            <h2 class="rv">The people behind <span class="hl">the work</span></h2>
          </div>
          <div class="tsub rv">
            <span class="tic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
            <p class="sub">Client relations, SEO, design, development and content, together.</p>
          </div>
        </div>
        <div class="tgrid">
          <figure class="fcard rv">
            <div class="fph"><img src={`/team/${founder.slug}.webp`} alt={founder.name} loading="lazy" /></div>
            <figcaption>
              <span class="face-name">{founder.name}</span>
              <span class="face-role">{founder.role}</span>
              <a class="farr" href="/sanal-edison-digital-strategist/" aria-label={`Read ${founder.name}'s profile`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </figcaption>
          </figure>
          <div class="faces" id="faces">
            {crew.map((p, k) => (
              <figure class="face rv" style={`--d:${(k + 1) * 0.05}s`}>
                <div class="fph"><img src={`/team/${p.slug}.webp`} alt={p.name} loading="lazy" /></div>
                <figcaption>
                  <span class="face-name">{p.name}</span>
                  <span class="face-role" title={p.role}><span class="ric" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={roleIcons[k]} /></span><span class="rl">{p.role}</span></span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- 9. VOICES (TESTIMONIALS) -->
      <section class="sec" id="voices">
