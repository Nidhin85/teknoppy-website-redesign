    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--orange);
    box-shadow: 0 10px 20px -6px rgba(241, 90, 36, 0.7);
    animation: hop 2.2s cubic-bezier(0.3, 1.4, 0.5, 1) infinite;
  }
  .map .pin::after {
    content: "";
    position: absolute;
    inset: 15px;
