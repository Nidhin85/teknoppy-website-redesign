      s.addEventListener('mousemove', function(e) {
        var r = s.getBoundingClientRect();
        s.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        s.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });
  }

  // 11. IN-PLACE VIDEO LOADER (fast performance)
  var videoBtn = document.getElementById('team-video-btn');
  if (videoBtn) {
    videoBtn.addEventListener('click', function() {
      var wrapper = document.createElement('div');
      wrapper.className = 'video-embed-container';
      wrapper.style.cssText = 'position:relative;width:100%;height:100%;min-height:380px;background:#000;border-radius:var(--r);overflow:hidden;';
      wrapper.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?autoplay=1" title="Teknoppy Team Video" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
      videoBtn.parentNode.replaceChild(wrapper, videoBtn);
    });
  }

  // 12. DRAG-SCROLL HELPER FOR FILMSTRIP & CAROUSEL
  function dragger(el) {
    if (!el) return;
    var down = false;
    var sx = 0;
    var sl = 0;
    var moved = false;

    el.addEventListener('mousedown', function(e) {
      down = true;
      moved = false;
      sx = e.pageX;
      sl = el.scrollLeft;
      el.classList.add('drag');
    });

    addEventListener('mouseup', function() {
      if (down) {
        down = false;
        el.classList.remove('drag');
      }
    });

    el.addEventListener('mousemove', function(e) {
      if (down) {
        e.preventDefault();
        if (Math.abs(e.pageX - sx) > 4) moved = true;
        el.scrollLeft = sl - (e.pageX - sx);
      }
    });

    el.addEventListener('click', function(e) {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);
  }

  dragger(document.getElementById('frames'));
  var car = document.getElementById('car');
  dragger(car);

  // 13. CELEBRATIONS CAROUSEL SYNC & CONTROLS
  if (car) {
    var slides = $$('.slide', car);
    var cbar = document.getElementById('cbar');

    function carSync() {
      var c = car.getBoundingClientRect();
      var mid = c.left + c.width / 2;
      var best = 0;
      var bd = 1e9;
      slides.forEach(function(s, i) {
        var r = s.getBoundingClientRect();
        var d = Math.abs(r.left + r.width / 2 - mid);
        if (d < bd) {
          bd = d;
          best = i;
        }
      });
      slides.forEach(function(s, i) {
        s.classList.toggle('on', i === best);
      });
      var max = car.scrollWidth - car.clientWidth;
      if (cbar) {
        cbar.style.width = (max > 0 ? (car.scrollLeft / max * 100) : 100) + '%';
      }
    }

    car.addEventListener('scroll', carSync, { passive: true });
    carSync();

    function stepWidth() {
      return slides.length ? (slides[0].offsetWidth + 20) : 340;
    }

    var cnext = document.getElementById('cnext');
    var cprev = document.getElementById('cprev');
    if (cnext) cnext.onclick = function() { car.scrollBy({ left: stepWidth(), behavior: 'smooth' }); };
    if (cprev) cprev.onclick = function() { car.scrollBy({ left: -stepWidth(), behavior: 'smooth' }); };

    // 14. LIGHTBOX MODAL WITH ACCESSIBLE FOCUS TRAP
    var lb = document.getElementById('lb');
    var lastSlide = null;

    slides.forEach(function(s) {
      s.addEventListener('click', function() {
        lastSlide = s;
        var ph = s.querySelector('.ph');
        var fig = s.querySelector('figcaption');
        if (ph && document.getElementById('lbph')) {
          document.getElementById('lbph').innerHTML = ph.outerHTML;
        }
        if (fig && document.getElementById('lbc')) {
          document.getElementById('lbc').innerHTML = fig.innerHTML.replace(/<b>.*?</b>/, '');
        }
        if (lb) {
          lb.classList.add('open');
          var xBtn = document.getElementById('lbx');
          if (xBtn) xBtn.focus();
        }
      });
      s.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          s.click();
        }
      });
    });

    function closeLb() {
      if (!lb) return;
      lb.classList.remove('open');
      if (lastSlide && lastSlide.focus) {
        lastSlide.focus();
      }
    }

    var lbx = document.getElementById('lbx');
    if (lbx) lbx.onclick = closeLb;
    if (lb) {
      lb.addEventListener('click', function(e) {
        if (e.target === lb) closeLb();
      });
    }
    addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && lb && lb.classList.contains('open')) {
        closeLb();
      }
    });
  }

  // 15. SCROLL PROGRESS BAR, STICKY PROCESS STORY & SIDE DOT NAVIGATION
  var bar = document.getElementById('progress');
  var steps = $$('.step[data-cap]');
  var layers = $$('#sticky .layer');
  var names = ['Discovery', 'Strategy', 'Design', 'Build', 'SEO', 'Launch and report'];
  var curStep = -1;
  var dots = $$('#dots a');
  var dsecs = dots.map(function(a) {
    return document.querySelector(a.getAttribute('href'));
  });

  function onScroll() {
    var H = root.scrollHeight - innerHeight;
    if (bar) {
      bar.style.transform = 'scaleX(' + (H > 0 ? scrollY / H : 0) + ')';
    }

    // Process steps sync
    var mid = innerHeight * 0.5;
    var act = 0;
    steps.forEach(function(s, i) {
      if (s.getBoundingClientRect().top < mid) act = i;
    });

    steps.forEach(function(s, i) {
      s.classList.toggle('on', i === act);
    });

    if (act !== curStep) {
      curStep = act;
      layers.forEach(function(l, i) {
        l.classList.toggle('on', i === act);
      });
      var snum = document.getElementById('snum');
      var sname = document.getElementById('sname');
      var scap = document.getElementById('scap');
      var smeter = document.getElementById('smeter');
      if (snum) snum.textContent = '0' + (act + 1);
      if (sname) sname.textContent = names[act];
      if (scap && steps[act]) scap.innerHTML = steps[act].dataset.cap;
      if (smeter) smeter.style.width = ((act + 1) / 6 * 100) + '%';
    }

    // Side dots sync
    var d = 0;
    dsecs.forEach(function(s, i) {
      if (s && s.getBoundingClientRect().top < innerHeight * 0.45) d = i;
    });
    dots.forEach(function(a, i) {
      a.classList.toggle('on', i === d);
    });
  }

  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll, { passive: true });
  onScroll();

})();
</script>
