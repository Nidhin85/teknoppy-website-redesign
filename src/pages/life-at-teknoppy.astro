  display: flex;
  flex-direction: column;
  gap: 2px;
}
.hcb-addr-title {
  font-size: 11px;
  font-weight: 800;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 5px;
}
.hcb-addr-floor {
  font-size: 9px;
  font-weight: 700;
  color: var(--orange, #f15a24);
  background: rgba(241, 90, 36, 0.15);
  padding: 1px 5px;
  border-radius: 3px;
  margin-left: auto;
}
.hcb-addr-line {
  font-size: 9.5px;
  color: #94a3b8;
  font-weight: 500;
}
.hcb-addr-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 8.5px;
  font-weight: 600;
  color: #64748b;
  margin-top: 3px;
  padding-top: 4px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}
.hcb-addr-metro {
  color: #38bdf8;
  display: inline-flex;
  align-items: center;
  gap: 3px;
}
.facts {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-top: 40px;
  position: relative;
}
.facts div {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 10px 20px;
  display: flex;
  gap: 8px;
  align-items: baseline;
  transition: transform .3s, border-color .3s, background .3s;
}
.facts div:hover {
  transform: translateY(-4px);
  border-color: var(--tint-line);
  background: var(--tint);
}
.facts small {
  color: var(--soft);
  font-size: 12.5px;
  font-weight: 700;
}
.facts b {
  font-family: var(--display);
  font-size: 15px;
}

/* ==========================================================================
   SECTION 2: PROCESS (STICKY SPLIT)
   ========================================================================== */
.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: start;
}
.sticky {
  position: sticky;
  top: 96px;
  height: calc(100vh - 140px);
  max-height: 620px;
  border-radius: 28px;
  overflow: hidden;
  background: var(--tint);
}
.sticky .layer {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: scale(1.06);
  transition: opacity .7s, transform 1.2s cubic-bezier(.2,.8,.2,1);
}
.sticky .layer.on {
  opacity: 1;
  transform: none;
}
.sticky .layer .ph {
  position: absolute;
  inset: 0;
}
.sticky .badge {
  position: absolute;
  left: 20px;
  top: 20px;
  z-index: 3;
  background: var(--surface);
  border-radius: 999px;
  padding: 8px 14px;
  font-family: var(--display);
  font-weight: 800;
  font-size: 14px;
  display: flex;
  gap: 8px;
  align-items: center;
  box-shadow: 0 10px 24px -14px rgba(26, 26, 26, .4);
}
.sticky .badge i {
  font-style: normal;
  color: var(--orange);
}
.sticky .cap {
  position: absolute;
  left: 20px;
  right: 20px;
  bottom: 20px;
  z-index: 3;
  background: rgba(255, 255, 255, .94);
  border-radius: 14px;
  padding: 10px 14px;
  font-size: 14px;
  color: var(--muted);
  transition: opacity .4s;
}
.sticky .meter {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 4px;
  background: var(--orange);
  z-index: 4;
  transition: width .5s cubic-bezier(.2,.8,.2,1);
}
.steps {
  display: grid;
  gap: 0;
}
.step {
  min-height: 62vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12px;
  padding-block: 20px;
  opacity: .28;
  transition: opacity .5s;
}
.step.on {
  opacity: 1;
}
.step .n {
  font-family: var(--display);
  font-weight: 800;
  font-size: 72px;
  line-height: .9;
  color: transparent;
  -webkit-text-stroke: 2px var(--orange);
  transition: color 0.4s cubic-bezier(.2,.8,.2,1), transform 0.4s cubic-bezier(.2,.8,.2,1), text-shadow 0.4s cubic-bezier(.2,.8,.2,1);
}
.step.on .n {
  color: var(--orange);
  -webkit-text-stroke: 0;
  transform: translateX(6px);
  text-shadow: 0 0 24px rgba(241, 90, 36, 0.45);
}
.step small {
  font-weight: 800;
  color: var(--orange);
  letter-spacing: .08em;
  text-transform: uppercase;
  font-size: 13px;
}
.step h3 {
  font-size: clamp(28px, 3.4vw, 42px);
}
.step p {
  color: var(--muted);
  font-size: 18px;
  max-width: 34ch;
}
.step .mobph {
  display: none;
}
.steps > .intro {
  min-height: auto;
  opacity: 1;
  padding-bottom: 20px;
}
.steps > .intro h2 {
  font-size: clamp(30px, 4vw, 48px);
}
.steps > .intro p {
  max-width: 46ch;
}

/* ==========================================================================
   SECTION 3: VALUES (ACCORDION)
   ========================================================================== */
.vacc {
  border-top: 2px solid var(--ink);
}
.vi {
  border-bottom: 1px solid var(--line);
}
.vi button {
  all: unset;
  box-sizing: border-box;
  width: 100%;
  display: grid;
  grid-template-columns: 80px 1fr auto;
  gap: 20px;
  align-items: center;
  padding: 26px 6px;
  cursor: pointer;
}
.vi button:focus-visible {
  outline: 3px solid var(--orange);
}
.vi .num {
  font-family: var(--display);
  font-weight: 800;
  font-size: 15px;
  color: var(--soft);
  transition: color .3s;
}
.vi h3 {
  font-size: clamp(22px, 2.8vw, 34px);
  transition: color .3s, transform .4s cubic-bezier(.2,.8,.2,1);
}
.vi button:hover h3 {
  transform: translateX(10px);
}
.vi .pl {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 1.5px solid var(--line);
  display: grid;
  place-items: center;
  font-size: 22px;
  transition: all .4s;
}
.vi.open .num,
.vi.open h3 {
  color: var(--orange);
}
.vi.open .pl {
  background: var(--orange);
  border-color: var(--orange);
  color: #fff;
  transform: rotate(45deg);
}
.vi .body {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows .5s cubic-bezier(.2,.8,.2,1);
}
.vi.open .body {
  grid-template-rows: 1fr;
}
.vi .body > div {
  overflow: hidden;
}
.vi .inner {
  display: grid;
  grid-template-columns: 80px 1fr 1fr;
  gap: 20px;
  padding: 0 6px 28px;
}
.vi .inner p {
  color: var(--muted);
  font-size: 17px;
  grid-column: 2;
}
.vi .prac {
  grid-column: 3;
  background: var(--tint);
  border: 1px solid var(--tint-line);
  border-radius: 16px;
  padding: 16px 18px;
  font-size: 15px;
}
.vi .prac b {
  display: block;
  color: var(--orange);
  font-family: var(--display);
  margin-bottom: 4px;
}
.vi .prac a {
  color: var(--orange);
  font-weight: 800;
}
.founder {
  margin-top: 56px;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 30px;
  align-items: center;
  padding: 36px;
  border-radius: 28px;
  background: var(--orange);
  color: #fff;
  position: relative;
  overflow: hidden;
  isolation: isolate;
}
.founder::before {
  content: "“";
  position: absolute;
  right: 30px;
  top: -40px;
  font-family: var(--display);
  font-size: 220px;
  line-height: 1;
  color: rgba(255, 255, 255, .14);
  z-index: -1;
  animation: bob 6s ease-in-out infinite;
}
@keyframes bob {
  50% { transform: translateY(-12px); }
}
.founder .av {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  background: var(--g);
  border: 4px solid #fff;
  display: grid;
  place-items: center;
  font-size: 34px;
  animation: bob 5s ease-in-out infinite;
  object-fit: cover;
  object-position: top;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, .25);
}
.founder blockquote {
  margin: 0;
  font-family: var(--display);
  font-weight: 600;
  font-size: clamp(19px, 2.3vw, 26px);
  line-height: 1.4;
}
.founder .fill {
  background: rgba(255, 255, 255, .2);
  color: #fff;
  border-color: rgba(255, 255, 255, .6);
}
.founder cite {
  display: block;
  margin-top: 12px;
  font-style: normal;
  opacity: .9;
}
.founder cite a {
  color: #fff;
  font-weight: 800;
}
.founder > div {
  min-width: 0;
}

/* ==========================================================================
   SECTION 4: TEAM (ORBIT)
   ========================================================================== */
.teamw {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
}
.orbit {
  position: relative;
  aspect-ratio: 1/1;
  max-width: 520px;
  width: 100%;
  margin: 0 auto;
}
.orbit .ring {
  position: absolute;
  inset: 6%;
  border: 2px dashed var(--tint-line);
  border-radius: 50%;
}
.orbit .spin {
  position: absolute;
  inset: 0;
  animation: spin 46s linear infinite;
}
.orbit:hover .spin,
.orbit:hover .od {
  animation-play-state: paused;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.od {
  position: absolute;
  width: 24%;
  aspect-ratio: 1/1;
  border-radius: 50%;
  overflow: hidden;
  border: 4px solid var(--surface);
  box-shadow: 0 14px 30px -14px rgba(26, 26, 26, .45);
  cursor: pointer;
  padding: 0;
  background: none;
  translate: -50% -50%;
  animation: spin 46s linear infinite reverse;
  transition: scale .4s cubic-bezier(.3,1.4,.5,1), box-shadow .3s;
}
.od .ph {
  position: absolute;
  inset: 0;
  padding: 6px;
}
.od .ph .t,
.od .ph .f {
  display: none;
}
.od .ini {
  position: relative;
  font-family: var(--display);
  font-weight: 800;
  font-size: 15px;
  color: var(--ink);
  background: rgba(255, 255, 255, .88);
  border-radius: 999px;
  padding: 2px 8px;
}
.od:hover,
.od.on {
  scale: 1.15;
  box-shadow: 0 0 0 4px var(--orange), 0 20px 40px -16px rgba(241, 90, 36, .6);
}
.ocore {
  position: absolute;
  inset: 32%;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 26px 50px -24px rgba(26, 26, 26, .5);
  border: 6px solid var(--surface);
}
.ocore .ph {
  position: absolute;
  inset: 0;
  transition: opacity .4s;
}
.ocore .ph .t { font-size: 12px; }
.ocore .ph .f { font-size: 9.5px; }
.tinfo {
  display: grid;
  gap: 16px;
}
.tinfo h2 {
  font-size: clamp(30px, 4vw, 48px);
}
.tinfo > p {
  color: var(--muted);
  font-size: 17px;
}
.tcard {
  border-radius: 20px;
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 22px 24px;
  min-height: 150px;
  display: grid;
  gap: 6px;
  align-content: start;
}
.tcard b {
  font-family: var(--display);
  font-size: 22px;
}
.tcard span {
  color: var(--muted);
}
.tcard small {
  color: var(--soft);
  font-size: 12.5px;
  overflow-wrap: anywhere;
}
.tcard.swap {
  animation: swap .5s cubic-bezier(.2,.8,.2,1);
}
@keyframes swap {
  from { opacity: 0; transform: translateY(10px); }
}
.tnav {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.tnav button {
  border: 1.5px solid var(--line);
  background: var(--surface);
  border-radius: 999px;
  padding: 7px 14px;
  font-weight: 700;
  font-size: 13.5px;
  cursor: pointer;
  transition: all .3s;
}
.tnav button:hover,
.tnav button.on {
  background: var(--orange);
  border-color: var(--orange);
  color: #fff;
}
.tinfo .about a {
  color: var(--orange);
  font-weight: 800;
}

/* ==========================================================================
   SECTION 5: IN THEIR WORDS (SPOTLIGHT STORIES & VIDEO)
   ========================================================================== */
.stories {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.story {
  --mx: 50%;
  --my: 50%;
  position: relative;
  border-radius: var(--r);
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 32px;
  display: grid;
  gap: 18px;
  align-content: start;
  overflow: hidden;
  isolation: isolate;
  transition: transform .45s cubic-bezier(.2,.8,.2,1), border-color .3s;
}
.story::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(420px circle at var(--mx) var(--my), rgba(241, 90, 36, .1), transparent 45%);
  opacity: 0;
  transition: opacity .3s;
  z-index: -1;
}
.story:hover {
  transform: translateY(-6px);
  border-color: var(--tint-line);
}
.story:hover::before {
  opacity: 1;
}
.story .top {
  display: flex;
  gap: 14px;
  align-items: center;
}
.story .av {
  flex: none;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: var(--g);
  display: grid;
  place-items: center;
  font-size: 20px;
  object-fit: cover;
  object-position: top;
  border: 2px solid var(--surface);
  box-shadow: 0 4px 12px rgba(0, 0, 0, .08);
}
.od-avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
  display: block;
}
.story .top b {
  display: block;
  font-family: var(--display);
  font-size: 17px;
}
.story .top span {
  color: var(--muted);
  font-size: 14px;
}
.story q {
  font-size: 17px;
  line-height: 1.65;
  quotes: "“" "”";
}
.vrow {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 20px;
  margin-top: 20px;
}
.video {
  position: relative;
  border-radius: var(--r);
  overflow: hidden;
  min-height: 380px;
  cursor: pointer;
  border: 0;
  padding: 0;
  font: inherit;
  color: inherit;
  text-align: center;
  width: 100%;
}
.video .ph {
  position: absolute;
  inset: 0;
}
.video:hover .ph::before {
  transform: scale(1.06);
}
.play {
  width: 76px;
  height: 76px;
  border-radius: 50%;
  background: var(--orange);
  display: grid;
  place-items: center;
  position: relative;
  transition: transform .3s;
}
.play::before,
.play::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid var(--orange);
  animation: ping 2.2s infinite;
}
.play::after {
  animation-delay: 1.1s;
}
@keyframes ping {
  to { transform: scale(1.6); opacity: 0; }
}
.video:hover .play {
  transform: scale(1.1);
}
.tscript {
  border-radius: var(--r);
  background: var(--tint);
  border: 1px solid var(--tint-line);
  padding: 28px;
  display: grid;
  gap: 10px;
  align-content: start;
}
.tscript b {
  font-family: var(--display);
  font-size: 19px;
}
.tscript p {
  color: var(--muted);
}
.tscript a {
  color: var(--orange);
  font-weight: 800;
}

/* ==========================================================================
   SECTION 6: A TYPICAL DAY (FILMSTRIP)
   ========================================================================= */
.film {
  position: relative;
  background: var(--ink);
  border-radius: 28px;
  padding: 30px 0;
  overflow: hidden;
}
.film::before,
.film::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 14px;
  background: repeating-linear-gradient(90deg, transparent 0 18px, rgba(255, 255, 255, .22) 18px 34px);
  background-size: 34px 100%;
  animation: sprock 2s linear infinite;
}
.film::before { top: 8px; }
.film::after { bottom: 8px; }
@keyframes sprock {
  to { background-position: 34px 0; }
}
.frames {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding: 18px 24px;
  scrollbar-width: none;
  cursor: grab;
}
.frames::-webkit-scrollbar {
  display: none;
}
.frames.drag {
  cursor: grabbing;
  scroll-snap-type: none;
}
.frame {
  flex: 0 0 280px;
  scroll-snap-align: start;
  background: var(--surface);
  border-radius: 16px;
  padding: 22px;
  display: grid;
  gap: 8px;
  align-content: start;
  transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .4s;
  min-height: 200px;
}
.frame:hover {
  transform: translateY(-6px) rotate(-1deg);
  box-shadow: 0 0 0 3px var(--orange);
}
.frame time {
  font-family: var(--display);
  font-weight: 800;
  color: var(--orange);
  font-size: 22px;
}
.frame b {
  font-family: var(--display);
  font-size: 19px;
}
.frame span {
  color: var(--muted);
  font-size: 15px;
}
.frame.photo {
  flex-basis: 380px;
  padding: 0;
  overflow: hidden;
  position: relative;
}
.frame.photo .ph {
  position: absolute;
  inset: 0;
}
.filmhint {
  color: rgba(255, 255, 255, .7);
  font-size: 13px;
  text-align: center;
  margin-top: 6px;
}
.place {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 24px;
}
.info {
  border-radius: var(--r);
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 8px 26px;
}
.info div {
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}
.info div:last-child {
  border-bottom: 0;
}
.info small {
  display: block;
  color: var(--soft);
  font-weight: 800;
  font-size: 12.5px;
}
.info a {
  color: var(--orange);
  font-weight: 800;
}
.map {
  position: relative;
  border-radius: var(--r);
  background: var(--surface);
  border: 1px solid var(--line);
  overflow: hidden;
  min-height: 300px;
  display: grid;
  place-items: center;
  text-align: center;
}
.map::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size: 30px 30px;
}
.map svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.map path {
  fill: none;
  stroke: var(--orange);
  stroke-width: 3;
  stroke-dasharray: 8 8;
  animation: dash 1.4s linear infinite;
}
@keyframes dash {
  to { stroke-dashoffset: -32; }
}
.map .pin {
  position: relative;
  width: 46px;
  height: 46px;
  border-radius: 50% 50% 50% 0;
  rotate: -45deg;
  background: var(--orange);
  box-shadow: 0 10px 20px -6px rgba(241, 90, 36, .7);
  animation: hop 2.2s cubic-bezier(.3,1.4,.5,1) infinite;
}
.map .pin::after {
  content: "";
  position: absolute;
  inset: 15px;
  border-radius: 50%;
  background: #fff;
}
@keyframes hop {
  50% { translate: 6px -6px; }
}
.map b {
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 14px;
  font-family: var(--display);
  font-size: 13.5px;
  background: rgba(255, 255, 255, .94);
  border-radius: 12px;
  padding: 8px;
}
.map .mlabel {
  position: absolute;
  left: 16px;
  top: 16px;
  font-size: 12px;
  font-weight: 800;
  color: var(--muted);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 4px 10px;
}

/* ==========================================================================
   SECTION 7: CELEBRATIONS (CAROUSEL & LIGHTBOX)
   ========================================================================== */
.carw {
  position: relative;
}
.car {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding: 10px max(20px, calc((100vw - 1180px) / 2 + 20px)) 30px;
  scrollbar-width: none;
  cursor: grab;
}
.car::-webkit-scrollbar {
  display: none;
}
.car.drag {
  cursor: grabbing;
  scroll-snap-type: none;
}
.slide {
  flex: 0 0 min(420px, 80vw);
  scroll-snap-align: center;
  margin: 0;
  display: grid;
  gap: 12px;
  transition: transform .5s cubic-bezier(.2,.8,.2,1), opacity .5s;
  opacity: .55;
  transform: scale(.92);
  cursor: pointer;
}
.slide.on {
  opacity: 1;
  transform: none;
}
.slide .ph {
  height: 320px;
  border-radius: var(--r);
}
.slide:hover .ph::before {
  transform: scale(1.06);
}
.slide figcaption {
  color: var(--muted);
  font-size: 14.5px;
  padding-inline: 4px;
}
.slide figcaption b {
  display: block;
  color: var(--ink);
  font-family: var(--display);
  font-size: 18px;
}
.carctl {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}
.carbar {
  flex: 1;
  height: 3px;
