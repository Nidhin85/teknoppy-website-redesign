        <p class="text-base sm:text-xl text-neutral-300 font-medium max-w-2xl mx-auto leading-relaxed mb-12">
          Want to collaborate with a team that treats your website like their own product? Let’s start the conversation.
        </p>

        <!-- Subtle Conversion CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
          <a
            href="/request-a-quote/"
            class="cta-pulse-strong w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_25px_rgba(240,90,44,0.4)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all"
          >
            <span>Start a Project</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
          <a
            href="/career/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 text-base font-bold text-white border border-white/20 rounded-full hover:bg-white/10 transition-all"
          >
            <span>Join Teknoppy</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/></svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- =========================================================================
       INTERACTIVE FULLSCREEN MEDIA LIGHTBOX MODAL
       ========================================================================= -->
  <div id="life-lightbox" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-xl hidden flex-col justify-between p-4 sm:p-8" role="dialog" aria-modal="true" aria-label="Media Lightbox">
    <!-- Top bar -->
    <div class="flex items-center justify-between text-white max-w-5xl mx-auto w-full z-10">
      <div class="flex items-center gap-3">
        <span id="lb-category" class="px-3 py-1 rounded-full bg-primary/90 text-white text-[11px] font-black uppercase tracking-wider">
          Category
        </span>
        <span id="lb-date" class="text-xs text-neutral-400 font-mono font-bold">OCT 2026</span>
      </div>
      <button id="lb-close-btn" class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors" aria-label="Close Lightbox">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Center Stage -->
    <div class="relative flex-1 flex items-center justify-center my-4 max-w-5xl mx-auto w-full overflow-hidden">
      <!-- Prev Button -->
      <button id="lb-prev-btn" class="absolute left-2 sm:left-4 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all backdrop-blur-sm" aria-label="Previous Media">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
      </button>

      <!-- Content Container -->
      <div id="lb-media-stage" class="max-h-[65vh] sm:max-h-[72vh] max-w-full flex items-center justify-center">
        <img id="lb-image" src="" alt="" class="max-h-[65vh] sm:max-h-[72vh] max-w-full object-contain rounded-2xl shadow-2xl transition-transform duration-300" />
        <div id="lb-video-wrapper" class="hidden w-[90vw] max-w-4xl aspect-video rounded-2xl overflow-hidden shadow-2xl">
          <iframe id="lb-iframe" class="w-full h-full" src="" title="Video preview" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>

      <!-- Next Button -->
      <button id="lb-next-btn" class="absolute right-2 sm:right-4 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all backdrop-blur-sm" aria-label="Next Media">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </button>
    </div>

    <!-- Bottom Description -->
    <div class="text-white max-w-5xl mx-auto w-full border-t border-white/10 pt-4 z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <h3 id="lb-title" class="text-base sm:text-lg font-black text-white leading-snug">Title</h3>
        <p id="lb-desc" class="text-xs sm:text-sm text-neutral-300 font-medium mt-1 max-w-2xl">Description</p>
      </div>
      <div class="text-[11px] font-mono text-neutral-400">
        Use <kbd class="px-1.5 py-0.5 bg-white/10 rounded">ESC</kbd> to close · <kbd class="px-1.5 py-0.5 bg-white/10 rounded">←</kbd> <kbd class="px-1.5 py-0.5 bg-white/10 rounded">→</kbd> to navigate
      </div>
    </div>
  </div>

  <Footer />

</Layout>

<style>
  /* 3D NEWSPAPER FOLDING ANIMATION */
  .newspaper-fold-wrapper {
    perspective: 1200px;
  }
  .newspaper-card {
    transform-style: preserve-3d;
  }
  .newspaper-leaf {
    transform-origin: left center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
  }
  .newspaper-fold-wrapper:hover .newspaper-leaf,
  .newspaper-fold-wrapper.is-unfolded .newspaper-leaf {
    transform: rotateY(-18deg) scale(1.02);
    box-shadow: -15px 10px 30px rgba(0, 0, 0, 0.15);
  }

  /* TICKER & MARQUEE FLOWS */
  @keyframes tickerFlow {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
  .animate-ticker {
    animation: tickerFlow 25s linear infinite;
  }
  .team-editorial-ticker:hover .animate-ticker {
    animation-play-state: paused;
  }

  @keyframes marqueeLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes marqueeRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }
  .animate-marquee-left {
    animation: marqueeLeft 35s linear infinite;
  }
  .animate-marquee-right {
    animation: marqueeRight 35s linear infinite;
  }
  .infinite-photo-row:hover {
    animation-play-state: paused;
  }

  /* FLOATING ANIMATIONS FOR HERO PILLS */
  @keyframes floatSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes floatDelayed {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }
  .animate-float-slow {
    animation: floatSlow 5s ease-in-out infinite;
  }
  .animate-float-delayed {
    animation: floatDelayed 6s ease-in-out 1s infinite;
  }

  /* REDUCED MOTION SAFEGUARDS */
  @media (prefers-reduced-motion: reduce) {
    .animate-ticker,
    .animate-marquee-left,
    .animate-marquee-right,
    .animate-float-slow,
    .animate-float-delayed {
      animation: none !important;
    }
    .newspaper-leaf {
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. SECTION SPY & SCROLL COUNTER (01 / 08)
    const sections = document.querySelectorAll('.life-section');
    const stepNum = document.getElementById('active-step-num');
    const stepTitle = document.getElementById('active-step-title');

    if (sections.length > 0 && stepNum && stepTitle) {
      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const num = entry.target.getAttribute('data-section-num');
            const name = entry.target.getAttribute('data-section-name');
            if (num) stepNum.textContent = num;
            if (name) stepTitle.textContent = name;
          }
        });
      }, { threshold: 0.3 });

      sections.forEach((sec) => sectionObserver.observe(sec));
    }

    // 2. DAILY CAROUSEL CONTROLS
    const dailyRail = document.getElementById('daily-rail');
    const prevBtn = document.getElementById('daily-prev-btn');
    const nextBtn = document.getElementById('daily-next-btn');

    if (dailyRail && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        dailyRail.scrollBy({ left: -380, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        dailyRail.scrollBy({ left: 380, behavior: 'smooth' });
      });
    }

    // 3. CATEGORY FILTER SYSTEM
    const filterButtons = document.querySelectorAll('.life-filter-btn');
    const wallCards = document.querySelectorAll('.wall-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-neutral-900', 'text-white', 'border-neutral-900', 'shadow-md', 'is-active');
          b.classList.add('bg-white', 'text-neutral-600', 'border-neutral-200');
        });
        btn.classList.add('bg-neutral-900', 'text-white', 'border-neutral-900', 'shadow-md', 'is-active');
        btn.classList.remove('bg-white', 'text-neutral-600', 'border-neutral-200');

        const cat = btn.getAttribute('data-category');
        wallCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            card.style.display = 'flex';
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
          } else {
            card.style.display = 'none';
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
          }
        });
      });
    });

    // 4. INTERACTIVE LIGHTBOX SYSTEM
    const lightbox = document.getElementById('life-lightbox');
    const lbImg = document.getElementById('lb-image');
    const lbVideoWrapper = document.getElementById('lb-video-wrapper');
    const lbIframe = document.getElementById('lb-iframe');
    const lbTitle = document.getElementById('lb-title');
    const lbDesc = document.getElementById('lb-desc');
    const lbCategory = document.getElementById('lb-category');
    const lbDate = document.getElementById('lb-date');
    const lbCloseBtn = document.getElementById('lb-close-btn');
    const lbPrevBtn = document.getElementById('lb-prev-btn');
    const lbNextBtn = document.getElementById('lb-next-btn');

    let currentIndex = 0;
    const cardsArray = Array.from(wallCards);

    function openLightbox(index) {
      if (!lightbox || index < 0 || index >= cardsArray.length) return;
      currentIndex = index;
      const card = cardsArray[currentIndex];

      const type = card.getAttribute('data-type');
      const media = card.getAttribute('data-media');
      const youtube = card.getAttribute('data-youtube');
      const title = card.getAttribute('data-title');
      const desc = card.getAttribute('data-desc');
      const date = card.getAttribute('data-date');
      const category = card.getAttribute('data-category');

      if (lbTitle) lbTitle.textContent = title || '';
      if (lbDesc) lbDesc.textContent = desc || '';
      if (lbDate) lbDate.textContent = date || '';
      if (lbCategory) lbCategory.textContent = '#' + (category || '');

      if (type === 'video' && youtube) {
        if (lbImg) lbImg.classList.add('hidden');
        if (lbVideoWrapper && lbIframe) {
          lbVideoWrapper.classList.remove('hidden');
          lbIframe.src = 'https://www.youtube-nocookie.com/embed/' + youtube + '?autoplay=1';
        }
      } else {
        if (lbVideoWrapper && lbIframe) {
          lbVideoWrapper.classList.add('hidden');
          lbIframe.src = '';
        }
        if (lbImg) {
          lbImg.classList.remove('hidden');
          lbImg.src = media || '';
          lbImg.alt = title || '';
        }
      }

      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      if (lbIframe) lbIframe.src = '';
      document.body.style.overflow = '';
    }

    wallCards.forEach((card, idx) => {
      card.addEventListener('click', () => openLightbox(idx));
    });

    if (lbCloseBtn) lbCloseBtn.addEventListener('click', closeLightbox);
    if (lbPrevBtn) lbPrevBtn.addEventListener('click', () => {
      const newIdx = (currentIndex - 1 + cardsArray.length) % cardsArray.length;
      openLightbox(newIdx);
    });
    if (lbNextBtn) lbNextBtn.addEventListener('click', () => {
      const newIdx = (currentIndex + 1) % cardsArray.length;
      openLightbox(newIdx);
    });

    // Keyboard handlers
    document.addEventListener('keydown', (e) => {
      if (!lightbox || lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft' && lbPrevBtn) lbPrevBtn.click();
      if (e.key === 'ArrowRight' && lbNextBtn) lbNextBtn.click();
    });

    // Touch swipe handling for mobile
    let touchStartX = 0;
    if (lightbox) {
      lightbox.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });
      lightbox.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 50 && lbNextBtn) lbNextBtn.click();
        if (touchEndX - touchStartX > 50 && lbPrevBtn) lbPrevBtn.click();
      }, { passive: true });
    }

    // 5. MOBILE AUTO-UNFOLD OBSERVER FOR TEAM NEWSPAPER CARDS
    const foldCards = document.querySelectorAll('.newspaper-fold-wrapper');
    if (foldCards.length > 0) {
      const foldObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-unfolded');
          } else {
            entry.target.classList.remove('is-unfolded');
          }
        });
      }, { threshold: 0.4 });

      foldCards.forEach((c) => foldObserver.observe(c));
    }
  });
</script>
