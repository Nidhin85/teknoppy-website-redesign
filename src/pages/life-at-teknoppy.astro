---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import lifeData from '../data/lifeAtTeknoppy.json';

// CMS integration helper with reliable fallbacks
const getMemberPhoto = (nameSnippet: string, fallback: string) => {
  const member = lifeData?.teamMembers?.find((m: any) => m.name.toLowerCase().includes(nameSnippet.toLowerCase()));
  return member?.photo || fallback;
};

const orbitMembers = [
  ['g1', 'NK', 'Niya K K and Farsana A', 'Reviewing a client audit, <i class="fill">Sept 2026</i>.', 'SEO team audit review at one screen', 'teknoppy-seo-team-audit-review.webp · Landscape 1200 × 800, WebP, under 150 KB', getMemberPhoto('Niya', '/team/niya-kk.webp')],
  ['g2', 'NS', 'Nandana S Madhu', 'On a WordPress build, <i class="fill">month 2026</i>.', 'Developer at work, code and design side by side', 'teknoppy-developer-wordpress-build.webp', getMemberPhoto('Nandana', '/team/nandana.webp')],
  ['g3', 'VK', 'Vijayakala', 'On a scoping call with a client, <i class="fill">month 2026</i>.', 'Client relations on a call', 'teknoppy-client-relations-call.webp', getMemberPhoto('Vijayakala', '/team/vijayakala.webp')],
  ['g5', 'AK', 'Adithya K', 'Planning a client content calendar, <i class="fill">month 2026</i>.', 'Content and social planning', 'teknoppy-social-content-planning.webp', getMemberPhoto('Adithya', '/team/adithya-k.webp')],
  ['g4', 'SE', 'Sanal Edison', 'Talking through a site plan with the team, <i class="fill">month 2026</i>.', 'Founder with the team', 'teknoppy-founder-team-discussion.webp', getMemberPhoto('Sanal', '/team/sanal-edison.webp')],
  ['g5', 'ALL', 'Morning stand-up', 'The whole team at the Vyttila office, <i class="fill">month 2026</i>.', 'Morning stand-up, whole team', 'teknoppy-morning-standup.webp', '']
];

const title = "Life at Teknoppy — Team Culture, Routines & Behind the Scenes";
const description = "The people, routines and Vyttila office behind 120+ websites since 2018. Explore how we work, who we are, candid team stories and a typical day at Teknoppy.";

// Structured data schemas
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.teknoppy.com/#organization",
  "name": "Teknoppy",
  "url": "https://www.teknoppy.com/",
  "logo": "https://www.teknoppy.com/logo.svg",
  "telephone": "+91 6282249224",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam",
    "addressLocality": "Vyttila, Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  }
};

const localBizSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.teknoppy.com/#localbusiness",
  "name": "Teknoppy",
  "image": "https://www.teknoppy.com/og-image.png",
  "telephone": "+91 6282249224",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam",
    "addressLocality": "Vyttila, Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 9.9678,
    "longitude": 76.3197
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:30",
      "closes": "17:30"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is it like to work at Teknoppy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Teknoppy is a small in-house agency in Vyttila, Kochi. Designers, developers, SEO specialists and marketers sit together and work on the same client accounts. Junior staff work on real projects from the first week, with a senior colleague reviewing their work."
      }
    },
    {
      "@type": "Question",
      "name": "How many people work at Teknoppy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "10 people across client relations, SEO, development and social content, all in-house in one office."
      }
    },
    {
      "@type": "Question",
      "name": "Where is the Teknoppy office?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On the second floor of Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam, Vyttila, Kochi, Kerala 682019. It's a short walk from Thykoodam Metro station."
      }
    },
    {
      "@type": "Question",
      "name": "Does the team work with clients outside Kerala?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Alongside clients in Kerala, the team works with clients in the UAE and Qatar, with calls scheduled on Gulf time for those accounts."
      }
    },
    {
      "@type": "Question",
      "name": "Does Teknoppy train its team?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Junior work is reviewed side by side by a senior colleague, and the team runs a weekly knowledge-share session every Friday."
      }
    },
    {
      "@type": "Question",
      "name": "Can clients meet the Teknoppy team?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Clients and candidates are welcome at the office by appointment. Call +91 6282249224 to arrange a visit."
      }
    }
  ]
};
---

<Layout title={title} description={description} hideBottomBar={true} hideFloatingCta={true}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBizSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Custom orange cursor ring (desktop fine pointer only) -->
  <div id="cursor-ring" class="cursor-ring" aria-hidden="true"></div>

  <!-- Top scroll progress bar in orange -->
  <div id="progress"></div>

  <!-- SECTION 0: GLOBAL STICKY BLURRED NAV -->
  <nav id="life-nav">
    <div class="wrap">
      <a class="logo" href="/" aria-label="Teknoppy Home">Teknop<b>p</b>y</a>
      <a class="btn btn-primary nav-btn" href="/request-a-quote/" data-magnetic style="padding:10px 18px">
        Get free quote <span class="arr">→</span>
      </a>
    </div>
  </nav>

  <!-- Side dot navigation (desktop only) -->
  <div class="dots" id="dots" aria-label="Section navigation">
    <a href="#top" aria-label="Go to Top"><span>Top</span></a>
    <a href="#process" aria-label="Go to How we work"><span>How we work</span></a>
    <a href="#values" aria-label="Go to Values"><span>Values</span></a>
    <a href="#team" aria-label="Go to Team"><span>Team</span></a>
    <a href="#voices" aria-label="Go to Stories"><span>Stories</span></a>
    <a href="#day" aria-label="Go to A day"><span>A day</span></a>
    <a href="#celebrate" aria-label="Go to Celebrations"><span>Celebrations</span></a>
    <a href="#faq" aria-label="Go to FAQ"><span>FAQ</span></a>
  </div>

  <main id="life-page">

    <!-- =========================================================================
         SECTION 1: HERO (CENTRED)
         ========================================================================= -->
    <header class="hero" id="top">
      <!-- Ambient floating glow blobs for depth -->
      <div class="motion-glow-blob" style="width:420px;height:420px;top:40px;left:5%;" aria-hidden="true"></div>
      <div class="motion-glow-blob" style="width:480px;height:480px;top:260px;right:4%;animation-delay:-6s;" aria-hidden="true"></div>

      <div class="wrap">
        <p class="draft" data-reveal="down">Draft for review. Text marked <i class="fill">like this</i> needs a real detail before publishing. Photo and video slots show the file name and size to use.</p>
        <div class="crumb" data-reveal="up" data-delay="0.1s"><a href="/">Home</a><span>/</span><a href="/about-us/">About Us</a><span>/</span><span>Life at Teknoppy</span></div>
        <h1 id="h1" data-chars>Life at <span class="o">Teknoppy</span></h1>
        <p class="lead" data-reveal="up" data-delay="0.15s">The people, routines and Vyttila office behind 120+ websites since 2018.</p>
        <p class="intro" data-reveal="up" data-delay="0.2s">Teknoppy is a web design and digital marketing agency in Vyttila, Kochi, founded in 2018 by Sanal Edison. Our in-house team of designers, developers, SEO specialists and social media strategists works from one office on websites and campaigns for clients in Kerala, the UAE and Qatar.</p>
        <p class="intro" data-reveal="up" data-delay="0.25s">This page shows how we work, who we are and what a normal day looks like. Every photo here was taken at our office, and every story is written by the person named on it.</p>
        <div class="ctas" data-reveal="up" data-delay="0.3s">
          <a class="btn btn-primary" href="/career/" data-magnetic>See open roles <span class="arr">→</span></a>
          <a class="btn btn-ghost" href="#team" data-magnetic>Meet the team</a>
        </div>
        <div class="fan" id="fan-stage" role="region" aria-label="Teknoppy Culture, Team and Studio Showcase">
          <!-- CARD 1: SEO PERFORMANCE DASHBOARD MOCKUP -->
          <div class="card c1" data-tilt="12" data-parallax="0.08">
            <div class="hero-card hero-card-seo" role="img" aria-label="SEO performance dashboard mockup showing 98% audit health score, keyword rankings, and organic growth analytics">
              <div class="hcs-top">
                <div class="hcs-dots" aria-hidden="true"><span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span></div>
                <span class="hcs-pill"><span class="hcs-live-dot" aria-hidden="true"></span>SEO SUITE · AUDIT</span>
              </div>
              <div class="hcs-stats">
                <div class="hcs-stat-box">
                  <span class="hcs-stat-lbl">HEALTH SCORE</span>
                  <div class="hcs-stat-val"><span class="num">98</span><small class="sub">/100</small><span class="badge hcs-badge-green">▲ 4%</span></div>
                </div>
                <div class="hcs-stat-box">
                  <span class="hcs-stat-lbl">TOP 3 RANKS</span>
                  <div class="hcs-stat-val"><span class="num">120+</span><span class="badge hcs-badge-orange">GOOGLE</span></div>
                </div>
              </div>
              <div class="hcs-chart-wrap">
                <div class="hcs-chart-head">
                  <span class="hcs-chart-title">ORGANIC TRAFFIC</span>
                  <span class="hcs-chart-growth">+142% YOY</span>
                </div>
                <svg class="hcs-svg-chart" viewBox="0 0 240 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <defs>
                    <linearGradient id="hcs-grad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#f15a24" stop-opacity="0.38"/>
                      <stop offset="100%" stop-color="#f15a24" stop-opacity="0.0"/>
                    </linearGradient>
                  </defs>
                  <line x1="0" y1="16" x2="240" y2="16" stroke="rgba(255,255,255,0.06)" stroke-dasharray="3 3"/>
                  <line x1="0" y1="36" x2="240" y2="36" stroke="rgba(255,255,255,0.06)" stroke-dasharray="3 3"/>
                  <line x1="0" y1="56" x2="240" y2="56" stroke="rgba(255,255,255,0.06)"/>
                  <path d="M0,52 C35,48 55,42 85,38 C115,34 145,26 175,18 C205,10 220,8 240,4 L240,64 L0,64 Z" fill="url(#hcs-grad)"/>
                  <path d="M0,52 C35,48 55,42 85,38 C115,34 145,26 175,18 C205,10 220,8 240,4" stroke="#f15a24" stroke-width="2.5" stroke-linecap="round"/>
                  <circle cx="85" cy="38" r="3" fill="#f15a24"/>
                  <circle cx="175" cy="18" r="3" fill="#f15a24"/>
                  <circle cx="240" cy="4" r="4" fill="#ffffff" stroke="#f15a24" stroke-width="2"/>
                </svg>
              </div>
              <div class="hcs-keywords">
                <div class="hcs-kw-row">
                  <span class="hcs-kw-name">web design kochi</span>
                  <span class="hcs-kw-rank">#1</span>
                </div>
                <div class="hcs-kw-row">
                  <span class="hcs-kw-name">seo agency kerala</span>
                  <span class="hcs-kw-rank">#1</span>
                </div>
                <div class="hcs-kw-row">
                  <span class="hcs-kw-name">ecommerce web design</span>
                  <span class="hcs-kw-rank">#2</span>
                </div>
              </div>
              <div class="hcs-footer">
                <span>Core Web Vitals: Good</span>
                <span>Vyttila SEO Team</span>
              </div>
            </div>
          </div>

          <!-- CARD 2: FULL TEAM GRID COMPOSITION WITH TEKNOPPY LOGO -->
          <div class="card c2" data-tilt="8" data-parallax="0.03">
            <div class="hero-card hero-card-team" role="img" aria-label="Teknoppy in-house team composition featuring official logo and verified portraits of all 10 specialists in Vyttila, Kochi">
              <div class="hct-top">
                <img src="/logo.svg" alt="Teknoppy" width="112" height="32" class="hct-logo" />
                <span class="hct-pill">In-House Team · 10 Specialists</span>
              </div>
              <div class="hct-grid">
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/sanal-edison.webp" alt="Sanal Edison, Founder" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Sanal</span>
                </div>
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/vijayakala.webp" alt="Vijayakala, Client Relations" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Vijaya</span>
                </div>
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/niya-kk.webp" alt="Niya K K, SEO Lead" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Niya</span>
                </div>
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/nandana.webp" alt="Nandana S Madhu, Web Developer" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Nandana</span>
                </div>
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/adithya-k.webp" alt="Adithya K, Content Strategist" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Adithya</span>
                </div>
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/neha-p.webp" alt="Neha P, SEO Analyst" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Neha</span>
                </div>
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/nithya-sibi.webp" alt="Nithya Sibi, Jr SEO" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Nithya</span>
                </div>
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/anjali-babu.webp" alt="Anjali Babu, Jr SEO" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Anjali</span>
                </div>
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/anjana-babu.webp" alt="Anjana Babu, Jr SEO" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Anjana</span>
                </div>
                <div class="hct-member">
                  <div class="hct-avatar-wrap">
                    <img src="/team/farsana-a.webp" alt="Farsana A, Jr SEO" class="hct-avatar" loading="eager" width="44" height="44" />
                  </div>
                  <span class="hct-name">Farsana</span>
                </div>
              </div>
              <div class="hct-footer">
                <div class="hct-foot-top">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="var(--orange, #f15a24)"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                  <span>100% In-House in Vyttila, Kochi</span>
                </div>
                <span class="hct-foot-sub">Design · Development · SEO · Content</span>
              </div>
            </div>
          </div>

          <!-- CARD 3: OUR KOCHI STUDIO ARCHITECTURAL SHOWCASE -->
          <div class="card c3" data-tilt="12" data-parallax="0.1">
            <div class="hero-card hero-card-studio" role="img" aria-label="Our Kochi Studio architectural showcase of Teknoppy Kaithakal Building, Vyttila, Kochi">
              <div class="hcb-top">
                <span class="hcb-tag">Our Kochi Studio</span>
                <span class="hcb-coord">9.9678° N · 76.3197° E</span>
              </div>
              <div class="hcb-vis">
                <svg class="hcb-svg" viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <!-- Architectural Grid Background -->
                  <defs>
                    <pattern id="archGrid" width="12" height="12" patternUnits="userSpaceOnUse">
                      <path d="M 12 0 L 0 0 0 12" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="0.5"/>
                    </pattern>
                  </defs>
                  <rect width="240" height="120" fill="url(#archGrid)"/>
                  
                  <!-- Ground line -->
                  <line x1="16" y1="108" x2="224" y2="108" stroke="#475569" stroke-width="1.5"/>
                  
                  <!-- Building Outline -->
                  <rect x="36" y="24" width="168" height="84" rx="3" stroke="#64748b" stroke-width="1.5" fill="rgba(15,23,42,0.6)"/>
                  
                  <!-- Rooftop parapet & details -->
                  <line x1="30" y1="24" x2="210" y2="24" stroke="#94a3b8" stroke-width="2"/>
                  <rect x="52" y="16" width="36" height="8" stroke="#475569" stroke-width="1"/>
                  <line x1="180" y1="14" x2="180" y2="24" stroke="#475569" stroke-width="1"/>
                  
                  <!-- Floor 3 / Upper level -->
                  <rect x="46" y="32" width="26" height="16" stroke="rgba(148,163,184,0.4)" stroke-width="1" rx="1"/>
                  <rect x="80" y="32" width="26" height="16" stroke="rgba(148,163,184,0.4)" stroke-width="1" rx="1"/>
                  <rect x="134" y="32" width="26" height="16" stroke="rgba(148,163,184,0.4)" stroke-width="1" rx="1"/>
                  <rect x="168" y="32" width="26" height="16" stroke="rgba(148,163,184,0.4)" stroke-width="1" rx="1"/>
                  
                  <!-- Floor 2: TEKNOPPY STUDIO (HIGHLIGHTED IN ORANGE ACCENT) -->
                  <rect x="38" y="54" width="164" height="26" fill="rgba(241,90,36,0.12)" stroke="#f15a24" stroke-width="1.5"/>
                  <rect x="46" y="58" width="26" height="18" fill="rgba(241,90,36,0.22)" stroke="#f15a24" stroke-width="1" rx="1"/>
                  <rect x="80" y="58" width="26" height="18" fill="rgba(241,90,36,0.22)" stroke="#f15a24" stroke-width="1" rx="1"/>
                  <rect x="134" y="58" width="26" height="18" fill="rgba(241,90,36,0.22)" stroke="#f15a24" stroke-width="1" rx="1"/>
                  <rect x="168" y="58" width="26" height="18" fill="rgba(241,90,36,0.22)" stroke="#f15a24" stroke-width="1" rx="1"/>
                  <!-- Floor 2 Center Badge -->
                  <rect x="110" y="58" width="20" height="18" fill="#f15a24" rx="2"/>
                  <text x="120" y="70" fill="#ffffff" font-size="7.5" font-weight="800" text-anchor="middle" font-family="'Sora', sans-serif">2F</text>
                  
                  <!-- Floor 1 / Ground Floor Entrance -->
                  <rect x="46" y="86" width="26" height="16" stroke="rgba(148,163,184,0.4)" stroke-width="1" rx="1"/>
                  <!-- Main Entrance Door -->
                  <rect x="108" y="84" width="24" height="24" stroke="#94a3b8" stroke-width="1.5" fill="rgba(30,41,59,0.8)"/>
                  <line x1="120" y1="84" x2="120" y2="108" stroke="#64748b" stroke-width="1"/>
                  <rect x="168" y="86" width="26" height="16" stroke="rgba(148,163,184,0.4)" stroke-width="1" rx="1"/>
                  
                  <!-- Studio Zone Indicators -->
                  <text x="120" y="44" fill="#94a3b8" font-size="6" font-weight="700" text-anchor="middle" letter-spacing="1">KAITHAKAL BUILDING</text>
                  <text x="120" y="116" fill="#f15a24" font-size="6.5" font-weight="800" text-anchor="middle" letter-spacing="0.5">TEKNOPPY DIGITAL AGENCY · 2ND FL</text>
                  
                  <!-- North Pointer compass -->
                  <circle cx="218" cy="22" r="10" stroke="#475569" stroke-width="0.8" fill="rgba(15,23,42,0.5)"/>
                  <path d="M218 15 L221 24 L218 22 L215 24 Z" fill="#f15a24"/>
                  <text x="218" y="30" fill="#64748b" font-size="5.5" font-weight="700" text-anchor="middle">N</text>
                </svg>
              </div>
              <div class="hcb-addr-box">
                <div class="hcb-addr-title">
                  <span>Kaithakal Building</span>
                  <span class="hcb-addr-floor">2nd Floor HQ</span>
                </div>
                <div class="hcb-addr-line">Door No 49, Kaithakal Lane, Thykoodam</div>
                <div class="hcb-addr-meta">
                  <span class="hcb-addr-metro">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    Thykoodam Metro · 2 min walk
                  </span>
                  <span>Vyttila, Kochi</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="facts" data-stagger="50">
          <div><small>Founded</small><b><span class="cnt" data-count data-to="2018" data-from="1990">2018</span>, Kochi</b></div>
          <div><small>Team</small><b><i class="fill">10</i> people, all in-house</b></div>
          <div><small>Office</small><b>Thykoodam, Vyttila</b></div>
