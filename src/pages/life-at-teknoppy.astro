---
import Layout from '../layouts/Layout.astro';

const title = "Life at Teknoppy | Team, Culture & Our Vyttila Office";
const description = "Life at Teknoppy: meet the 12-person in-house team in Vyttila, Kochi behind 120+ websites since 2018. See how we work, our values and a typical day.";

// Structured data schemas
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.teknoppy.com/#organization",
  "name": "Teknoppy",
  "numberOfEmployees": { "@type": "QuantitativeValue", "value": 12 },
  "url": "https://www.teknoppy.com/",
  "logo": "https://www.teknoppy.com/logo.svg",
  "telephone": "+91 6282249224",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam",
    "addressLocality": "Vyttila, Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  }
};

const localBizSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.teknoppy.com/#localbusiness",
  "name": "Teknoppy",
  "image": "https://www.teknoppy.com/og-image.png",
  "telephone": "+91 6282249224",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam",
    "addressLocality": "Vyttila, Kochi",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 9.9678,
    "longitude": 76.3197
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:30",
      "closes": "17:30"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is life at Teknoppy like?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A tight-knit in-house team in Vyttila, Kochi. Designers, developers and SEO specialists work on the same accounts, and juniors get real projects from week one."
      }
    },
    {
      "@type": "Question",
      "name": "Where is the office?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Second Floor, Kaithakal Building, Thykoodam, Vyttila, Kochi 682019. A 3-minute walk from Thykoodam Metro. Open Monday to Saturday, 9:30 am to 5:30 pm."
      }
    },
    {
      "@type": "Question",
      "name": "Can I visit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, clients and candidates are welcome by appointment. Call +91 6282249224."
      }
    }
  ]
};

const team = [
  ["Niya K K", "niya-kk"],
  ["Nandana", "nandana"],
  ["Vijayakala", "vijayakala"],
  ["Adithya K", "adithya-k"],
  ["Neha P", "neha-p"],
  ["Vaisakh", "vaisakh-jayadev"],
  ["Sanal Edison", "sanal-edison"]
];

const allEmployees = [
  { name: "Sanal Edison", role: "Founder & Digital Strategist", slug: "sanal-edison" },
  { name: "Vijayakala", role: "Business Development & Client Relations", slug: "vijayakala" },
  { name: "Niya K K", role: "SEO Lead", slug: "niya-kk" },
  { name: "Neha P", role: "SEO Analyst", slug: "neha-p" },
  { name: "Nandana S Madhu", role: "Web Developer", slug: "nandana" },
  { name: "Adithya K", role: "Social Media Content Strategist", slug: "adithya-k" },
  { name: "Vaisakh Jayadev", role: "Videographer & Video Editor", slug: "vaisakh-jayadev" },
  { name: "Nithya Sibi", role: "Jr. SEO Executive", slug: "nithya-sibi" },
  { name: "Anjali Babu", role: "Jr. SEO Executive", slug: "anjali-babu" },
  { name: "Anjana Babu", role: "Jr. SEO Executive", slug: "anjana-babu" },
  { name: "Farsana A", role: "Jr. SEO Executive", slug: "farsana-a" },
  { name: "Jyothsana P K", role: "Jr. SEO Executive", slug: "jyothsana-pk" }
];

const stats = [
  ["2018", "Founded in Kochi"],
  ["12", "People, all in-house"],
  ["120+", "Websites delivered"],
  ["3", "Kerala, UAE and Qatar"]
];

const steps = [
  ["Discovery", "We listen to your goals, budget and timeline."],
  ["Strategy", "Every page gets a purpose and a keyword."],
  ["Design", "Wireframes first. You approve before any code."],
  ["Build", "Fast, clean WordPress or custom builds."],
  ["SEO", "Schema, speed and on-page checks before launch."],
  ["Launch", "Live, tracked, with a plain-language monthly report."]
];

const values = [
  [
    "Every page earns its place",
    "A clear goal and a keyword for each one.",
    "/images/life/teknoppy-workstation-laptop-planning.jpg",
    "Architecture and page strategy planning at Teknoppy"
  ],
  [
    "Reviewed before it ships",
    "Senior eyes on every piece of work.",
    "/images/life/teknoppy-side-by-side-review.jpg",
    "Side-by-side QA and design review"
  ],
  [
    "Provable, not claimed",
    "Real data and real rankings, not adjectives.",
    "/images/life/teknoppy-developer-workstation.jpg",
    "Real code and performance analytics"
  ],
  [
    "Learn in the open",
    "Friday knowledge-share and constant certifications.",
    "/images/life/teknoppy-friday-knowledge-share.jpg",
    "Friday team knowledge sharing session"
  ],
  [
    "Clients hear it from us first",
    "One named contact, same-day honesty.",
    "/images/life/teknoppy-client-consultation-lenaa.webp",
    "Direct client consultation at Teknoppy"
  ]
];

const voices = [
  ["Niya K K", "SEO Lead", "niya-kk", "Watching local businesses reach the top three on Google is the best part of my job."],
  ["Nandana S Madhu", "Web Developer", "nandana", "Designers, developers and SEOs sit at one table, so problems are caught before staging."],
  ["Neha P", "SEO Analyst", "neha-p", "Every technical audit and performance report is rooted in verified ranking data, so our clients see exactly how their search visibility grows."],
  ["Vijayakala", "Client Relations", "vijayakala", "We never overpromise. Clients value that honesty more than anything."]
];

const dayItems = [
  ["9:30", "Stand-up", "Ten minutes: what ships, what's blocked.", "teknoppy-individual-workstation-focus.png"],
  ["12:00", "Peer reviews", "Seniors review juniors side by side.", "teknoppy-side-by-side-review.jpg"],
  ["1:00", "Lunch together", "Tea, conversation, a proper break.", "teknoppy-team-lunch-together.jpg"],
  ["2:00", "Client calls", "Kerala, UAE and Qatar, in person or on Gulf time.", "teknoppy-client-consultation-lenaa.webp"],
  ["5:00", "Wrap-up", "Commits merged, tomorrow planned.", "teknoppy-developer-workstation.jpg"]
];

const celebrateItems = [
  ["Onam Festival", "teknoppy-onam-celebration.webp"],
  ["Pookkalam", "teknoppy-pookkalam-preparation.webp"],
  ["Project go-live", "teknoppy-project-launch-presentation.webp"],
  ["Team milestone", "teknoppy-team-client-milestone.webp"],
  ["Client partnership", "teknoppy-client-partnership-meeting.jpg"],
  ["Behind the scenes", "teknoppy-behind-the-scenes-shoot.webp"],
  ["The whole team", "teknoppy-core-team-portrait.jpg"],
  ["Collaborative reviews", "teknoppy-side-by-side-review.jpg"]
];

const tickItems = [
  "Design",
  "Development",
  "SEO",
  "Social content",
  "Client care",
  "Kochi to the Gulf"
];

const growItems = [
  ["Real projects from week one", "Juniors join live client work straight away, with a senior beside them.", "teknoppy-side-by-side-review.jpg"],
  ["Side-by-side mentorship", "Reviews happen at the desk, not over tickets.", "teknoppy-design-sprint-collaboration.jpg"],
  ["Friday knowledge-share", "Tools, technical SEO and development, shared every week.", "teknoppy-friday-knowledge-share.jpg"],
  ["Lunch and tea together", "A proper break, most days, with the whole team.", "teknoppy-team-lunch-together.jpg"]
];

const bentoItems = [
  ["a", "teknoppy-friday-knowledge-share.jpg", "Sprint board"],
  ["", "teknoppy-onam-celebration.webp", "Onam"],
  ["b", "teknoppy-design-sprint-collaboration.jpg", "Behind the scenes"],
  ["", "teknoppy-pookkalam-preparation.webp", "Pookkalam"],
  ["c", "teknoppy-project-launch-presentation.webp", "Launch day"]
];
---

<Layout
  title={title}
  description={description}
  canonical="https://www.teknoppy.com/life-at-teknoppy/"
  image="/images/life/teknoppy-core-team-portrait.jpg"
  hideBottomBar={true}
  hideFloatingCta={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Plus+Jakarta+Sans:wght@400;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBizSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="life-container">
    <!-- Top Progress Bar -->
    <div class="bar" id="bar"></div>

    <!-- Reference Navigation -->
    <nav class="life-nav">
      <a href="/"><b>Teknoppy</b></a>
      <a class="q" href="/request-a-quote/">Get free quote</a>
    </nav>

    <main class="life-main">
      <!-- 1. HERO SECTION -->
      <section class="hero">
        <div class="blob b1"></div>
        <div class="blob b2"></div>

        <div class="hero-copy">
          <span class="pill rv">Vyttila, Kochi · since 2018</span>
          <h1 data-split>Life at Teknoppy</h1>
          <p class="lead rv" style="--d:.5s">Twelve specialists. One room. A team that loves building good websites together.</p>
          <div class="cta rv" style="--d:.7s">
            <a class="btn solid" href="/career/">See open roles</a>
            <a class="btn ghost" href="#team">Meet the team</a>
          </div>
        </div>

        <div class="orbit-wrap rv" style="--d:.3s">
          <div class="ring"></div>
          <div class="orbit" id="orbit">
            {team.map((p, k) => (
              <div class="node" style={`--a:${(360 / team.length) * k}deg`}>
                <span class="av" data-n={p[0]}>
                  <img src={`/team/${p[1]}.webp`} alt={p[0]} width="84" height="84" loading="eager" />
                </span>
              </div>
            ))}
          </div>
          <div class="core">
            <img src="/images/life/teknoppy-core-team-portrait.jpg" alt="The Teknoppy team" width="300" height="300" loading="eager" />
          </div>
        </div>
      </section>

      <!-- 2. STATS SECTION -->
      <section class="stats" id="stats">
        {stats.map((s, k) => (
          <div class="stat rv" style={`--d:${k * 0.1}s`}>
            <b data-c={s[0]}>{s[0]}</b>
            <span>{s[1]}</span>
          </div>
        ))}
      </section>

      <!-- 3. ANIMATED TICKER -->
      <div class="tick">
        <div id="tick">
          {[...tickItems, ...tickItems].map((t) => (
            <span>{t}</span>
          ))}
        </div>
      </div>

      <!-- 4. STUDIO MEDIA GRID -->
      <section class="sec">
        <h2 class="rv">Where good work happens</h2>
        <p class="sub rv">Real photos from our Vyttila studio.</p>
        <div class="mg">
          <figure class="big rv">
            <img src="/images/life/teknoppy-inhouse-team-full-lineup.jpg" alt="The in-house Teknoppy team" loading="lazy" />
            <figcaption>The in-house team</figcaption>
          </figure>
          <figure class="rv" style="--d:.1s">
            <img src="/images/life/teknoppy-design-sprint-collaboration.jpg" alt="Design and sprint floor collaboration" loading="lazy" />
            <figcaption>Design and sprint floor</figcaption>
          </figure>
          <figure class="rv" style="--d:.2s">
            <img src="/images/life/teknoppy-side-by-side-review.jpg" alt="Side-by-side peer reviews" loading="lazy" />
            <figcaption>Side-by-side reviews</figcaption>
          </figure>
        </div>
      </section>

      <!-- 5. PROCESS STEPS -->
      <section class="sec" id="process">
        <h2 class="rv">How a project moves</h2>
        <p class="sub rv">Six stages. The same people from first call to monthly report.</p>
        <ol class="steps" id="steps">
          {steps.map((s, k) => (
            <li class="step rv" style={`--d:${k * 0.08}s`}>
              <i>{k + 1}</i>
              <h3>{s[0]}</h3>
              <p>{s[1]}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- 6. HOW WE GROW TOGETHER -->
      <section class="sec" id="grow">
        <h2 class="rv">How we grow together</h2>
        <p class="sub rv">Tap an item to see it in action.</p>
        <div class="grow rv">
          <div class="gimg" id="gimg">
            {growItems.map((g, k) => (
              <img src={`/images/life/${g[2]}`} alt={g[0]} class={k === 0 ? "on" : ""} loading="lazy" />
            ))}
          </div>
          <div class="gl" id="gl">
            {growItems.map((g, k) => (
              <div class={`gi ${k === 0 ? "on" : ""}`} data-k={k}>
                <h3>{g[0]}</h3>
                <p>{g[1]}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. VALUES ACCORDION & FOUNDER QUOTE -->
      <section class="sec" id="values">
        <h2 class="rv">What we value</h2>
        <div class="acc" id="acc">
          {values.map((v, k) => (
            <article class="panel rv" tabindex="0" style={`--d:${k * 0.08}s`}>
              <div class="panel-content">
                <h3>{v[0]}</h3>
                <p>{v[1]}</p>
              </div>
              <div class="panel-img">
                <img src={v[2]} alt={v[3]} loading="lazy" />
              </div>
            </article>
          ))}
        </div>
        <blockquote class="founder rv">
          <img src="/team/sanal-edison.webp" alt="Sanal Edison" width="96" height="96" loading="lazy" />
          <p>Clients should talk directly to the specialists building their site.</p>
          <cite>Sanal Edison, Founder</cite>
        </blockquote>
      </section>

      <!-- 8. TEAM FACES -->
      <section class="sec" id="team">
        <h2 class="rv">The people behind the work</h2>
        <p class="sub rv">Client relations, SEO, design, development and content, together.</p>
        <div class="faces" id="faces">
          {allEmployees.map((p, k) => (
            <figure class="face rv" style={`--d:${k * 0.05}s`}>
              <img src={`/team/${p.slug}.webp`} alt={p.name} loading="lazy" />
              <figcaption>
                <span class="face-name">{p.name}</span>
                <span class="face-role">{p.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- 9. VOICES (TESTIMONIALS) -->
      <section class="sec" id="voices">
        <h2 class="rv">In their words</h2>
        <div class="vg" id="vg">
          {voices.map((v, k) => (
            <article class="vc rv" style={`--d:${k * 0.1}s`}>
              <p>“{v[3]}”</p>
              <footer>
                <img src={`/team/${v[2]}.webp`} alt={v[0]} width="52" height="52" loading="lazy" />
                <div>
                  <b>{v[0]}</b>
                  <span>{v[1]}</span>
                </div>
              </footer>
            </article>
          ))}
        </div>
      </section>

      <!-- 10. A DAY AT THE OFFICE -->
      <section class="sec" id="day">
        <h2 class="rv">A day at the office</h2>
        <p class="sub rv">Drag or scroll sideways. Monday to Saturday, 9:30 to 5:30.</p>
        <div class="track" id="track">
          {dayItems.map((d) => (
            <article class="slot">
              <img src={`/images/life/${d[3]}`} alt={d[1]} loading="lazy" />
              <div>
                <time>{d[0]}</time>
                <h3>{d[1]}</h3>
                <p>{d[2]}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- 11. BENTO GRID (STUDIO UP CLOSE) -->
      <section class="sec" id="studio">
        <h2 class="rv">Studio, up close</h2>
        <p class="sub rv">Work, craft and a little fun, all in one place.</p>
        <div class="bento" id="bento">
          {bentoItems.map((b) => (
            b[0] === "c" ? (
              <figure class="c rv bento-video-wrap">
                <video
                  src="/videos/life/teknoppy-launch-day-reel.mp4"
                  poster="/images/life/teknoppy-project-launch-presentation.webp"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="auto"
                  class="bento-video"
                ></video>
                <figcaption>Launch day</figcaption>
              </figure>
            ) : (
              <figure class={`${b[0]} rv`}>
                <img src={`/images/life/${b[1]}`} alt={b[2]} loading="lazy" />
                <figcaption>{b[2]}</figcaption>
              </figure>
            )
          ))}
        </div>
      </section>

      <!-- 12. GULF SECTION -->
      <section class="gulf">
        <h2 class="rv">Working across the Gulf</h2>
        <p class="rv">Alongside Kerala, we run live accounts in the UAE, Qatar and Oman, with calls on Gulf time.</p>
        <div class="chips rv">
          <span class="chip"><i></i>Kochi</span>
          <span class="chip"><i></i>Dubai</span>
          <span class="chip"><i></i>Abu Dhabi</span>
          <span class="chip"><i></i>Doha</span>
          <span class="chip"><i></i>Muscat</span>
        </div>
      </section>

      <!-- 13. CELEBRATIONS MARQUEE -->
      <section class="sec" id="celebrate">
        <h2 class="rv">We celebrate together</h2>
        <p class="sub rv">Festivals, launches and milestones.</p>
        <div class="marquee">
          <div class="belt" id="belt">
            {[...celebrateItems, ...celebrateItems].map((m) => (
              <figure>
                <img src={`/images/life/${m[1]}`} alt={m[0]} loading="lazy" />
                <figcaption>{m[0]}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- 14. VISIT US -->
      <section class="sec" id="visit">
        <h2 class="rv">Come say hello</h2>
        <p class="sub rv">Visitors are welcome by appointment.</p>
        <div class="visit">
          <div class="ph rv">
            <img src="/images/life/teknoppy-client-partnership-handshake.webp" alt="Client partnership at Teknoppy" loading="lazy" />
          </div>
          <div class="vi rv">
            <div>
              <b>Find us</b>
              <span>Second Floor, Kaithakal Building, Thykoodam, Vyttila, Kochi 682019</span>
            </div>
            <div>
              <b>Getting here</b>
              <span>3-minute walk from Thykoodam Metro, Exit A</span>
            </div>
            <div>
              <b>Open</b>
              <span>Monday to Saturday, 9:30 am to 5:30 pm</span>
            </div>
            <a class="btn solid" style="text-align:center" href="https://maps.google.com/?q=Teknoppy%20Web%20Design%20Kochi" target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
          </div>
        </div>
      </section>

      <!-- 15. FAQ SECTION -->
      <section class="sec faq" id="faq">
        <h2 class="rv">Good to know</h2>
        <details class="rv">
          <summary>What is life at Teknoppy like?</summary>
          <p>A tight-knit in-house team in Vyttila, Kochi. Designers, developers and SEO specialists work on the same accounts, and juniors get real projects from week one.</p>
        </details>
        <details class="rv">
          <summary>Where is the office?</summary>
          <p>Second Floor, Kaithakal Building, Thykoodam, Vyttila, Kochi 682019. A 3-minute walk from Thykoodam Metro. Open Monday to Saturday, 9:30 am to 5:30 pm.</p>
        </details>
        <details class="rv">
          <summary>Can I visit?</summary>
          <p>Yes, clients and candidates are welcome by appointment. Call +91 6282249224.</p>
        </details>
      </section>

      <!-- 16. JOIN US CALL TO ACTION -->
      <section class="join">
        <h2 class="rv">Want to be part of it?</h2>
        <p class="rv">Join the team, or bring us your next project.</p>
        <div class="cta c rv">
          <a class="btn solid" href="/career/">Go to careers</a>
          <a class="btn ghost" href="/request-a-quote/">Request a quote</a>
        </div>
      </section>
    </main>

    <!-- Reference Footer -->
    <footer class="f">
      © 2026 Teknoppy · Kaithakal Building, Thykoodam, Vyttila, Kochi 682019 · +91 6282249224
    </footer>
  </div>
</Layout>

<style>
.life-container {
  --brand: #f26a1b;
  --brand2: #ffb27a;
  --ink: #16181d;
  --mute: #5d6370;
  --line: #ecedf0;
  --hd: "Bricolage Grotesque", sans-serif;
  box-sizing: border-box;
  font-family: "Plus Jakarta Sans", sans-serif;
  color: var(--ink);
  background: #fcfcfc;
  line-height: 1.6;
  overflow-x: hidden;
  position: relative;
  width: 100%;
}
.life-container * { box-sizing: border-box; }
.life-container h1, .life-container h2, .life-container h3, .life-container p { margin: 0; }
.life-container h1, .life-container h2, .life-container h3 { font-family: var(--hd); line-height: 1.05; letter-spacing: -0.02em; }
.life-container img { display: block; max-width: 100%; }
.life-container a { color: inherit; text-decoration: none; }
.sec { padding: clamp(60px, 9vw, 110px) clamp(20px, 6vw, 80px); max-width: 1280px; margin: auto; }
.sec h2 { font-size: clamp(32px, 5vw, 58px); font-weight: 800; max-width: 14ch; }
.sub { color: var(--mute); margin-top: 12px; }
.bar { position: fixed; top: 0; left: 0; height: 3px; width: 100%; background: var(--brand); transform-origin: 0; transform: scaleX(var(--p, 0)); z-index: 99; }
.rv { opacity: 0; transform: translateY(34px); filter: blur(6px); transition: all 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s); }
.rv.in { opacity: 1; transform: none; filter: none; }
.life-nav { position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; padding: 20px clamp(20px, 6vw, 80px); z-index: 20; }
.life-nav b { font-family: var(--hd); font-size: 24px; font-weight: 800; }
.life-nav a.q { background: var(--ink); color: #fff; padding: 10px 20px; border-radius: 99px; font-weight: 600; font-size: 14px; }
.hero { position: relative; min-height: 100svh; display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 30px; padding: 110px clamp(20px, 6vw, 80px) 60px; max-width: 1400px; margin: auto; }
