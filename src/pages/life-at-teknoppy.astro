<script is:inline>
(function() {
  const $ = id => document.getElementById(id);

  // Split text for hero headline animation
  document.querySelectorAll("[data-split]").forEach(e => {
    e.innerHTML = e.textContent.trim().split(" ").map((w, i) => `<span class="w"><span style="--i:${i}">${w}</span></span>`).join(" ");
  });

  // Reveal observer for .rv elements
  const io = new IntersectionObserver(es => {
    es.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add("in");
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll(".rv").forEach(e => io.observe(e));

  // Counter observer for stats
  const co = new IntersectionObserver(es => {
    es.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      co.unobserve(el);
      const t = el.dataset.c;
      const n = parseInt(t, 10);
      if (n === 2018) return;
      const s = performance.now();
      const f = x => {
        const p = Math.min((x - s) / 1400, 1);
        el.textContent = Math.round(n * (1 - Math.pow(1 - p, 3))) + (p === 1 && t.includes("+") ? "+" : "");
        if (p < 1) requestAnimationFrame(f);
      };
      requestAnimationFrame(f);
    });
  }, { threshold: 0.6 });

  document.querySelectorAll("[data-c]").forEach(e => co.observe(e));

  // Interactive growth tabs switcher
  let cur = 0;
  const glItems = document.querySelectorAll("#gl .gi");
  const gImages = document.querySelectorAll("#gimg img");

  const gs = () => {
    glItems.forEach(x => x.classList.toggle("on", x.dataset.k == cur));
    gImages.forEach((x, i) => x.classList.toggle("on", i == cur));
  };

  let auto = setInterval(() => {
    cur = (cur + 1) % 4;
    gs();
  }, 4500);

  glItems.forEach(x => {
    x.onclick = () => {
      cur = +x.dataset.k;
      gs();
      clearInterval(auto);
    };
  });

  // 3D Perspective Tilt for .mg figure
  document.querySelectorAll(".mg figure").forEach(el => {
    el.onpointermove = e => {
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      el.style.transform = `perspective(900px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg) scale(1.02)`;
    };
    el.onpointerleave = () => {
      el.style.transform = "";
    };
  });

  // Autoplay video on scroll into view (muted & looping)
  const v = document.querySelector(".bento-video");
  if (v) {
    v.muted = true;
    const vObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    }, { threshold: 0.2 });
    vObserver.observe(v);
  }

  // Scroll listener for top progress bar and blob parallax
  addEventListener("scroll", () => {
    const h = document.documentElement;
    const bar = $("bar");
    if (bar) {
      bar.style.setProperty("--p", h.scrollTop / (h.scrollHeight - h.clientHeight));
    }
    document.querySelectorAll(".blob").forEach((b, i) => {
      b.style.translate = `0 ${scrollY * (i ? -0.12 : 0.18)}px`;
    });
  }, { passive: true });

  // Draggable horizontal timeline track
  const t = $("track");
  if (t) {
    let d = 0, sx = 0, sl = 0;
    t.onpointerdown = e => {
      d = 1;
      sx = e.clientX;
      sl = t.scrollLeft;
    };
    addEventListener("pointerup", () => { d = 0; });
    t.onpointermove = e => {
      if (d) t.scrollLeft = sl - (e.clientX - sx);
    };
  }
})();
</script>
