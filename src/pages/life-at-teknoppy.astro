    border-radius: 12px;
    padding: 8px;
    border: 1px solid var(--line);
    transition: all 0.3s ease;
  }
  .map .mlabel {
    position: absolute;
    left: 16px;
    top: 16px;
    font-size: 12px;
    font-weight: 800;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
  }

  /* Carousel */
  .carw {
    position: relative;
  }
  .car {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 10px max(20px, calc((100vw - 1180px)/2 + 20px)) 30px;
    scrollbar-width: none;
    cursor: grab;
  }
  .car::-webkit-scrollbar {
    display: none;
  }
  .car.drag {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .slide {
    flex: 0 0 min(420px, 80vw);
    scroll-snap-align: center;
    margin: 0;
    display: grid;
    gap: 12px;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s ease;
    opacity: 0.55;
    transform: scale(0.92);
  }
  .slide.on {
    opacity: 1;
    transform: none;
  }
  .slide figcaption {
    color: var(--muted);
    font-size: 14.5px;
    padding-inline: 4px;
    line-height: 1.5;
  }
  .slide figcaption b {
    display: block;
    color: var(--ink);
    font-family: var(--display);
    font-size: 18px;
    margin-bottom: 2px;
  }
  .carctl {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 10px;
  }
  .carbar {
    flex: 1;
    height: 3px;
    background: var(--line);
    border-radius: 3px;
    overflow: hidden;
  }
  .carbar i {
    display: block;
    height: 100%;
    background: var(--orange);
    width: 0;
    transition: width 0.3s ease;
  }
  .carctl button {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: var(--surface);
    font-size: 18px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: grid;
    place-items: center;
  }
  .carctl button:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
  }
  .social {
    margin-top: 22px;
    color: var(--muted);
    text-align: center;
  }

  /* Lightbox */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(20, 18, 17, 0.94);
    display: grid;
    place-items: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
