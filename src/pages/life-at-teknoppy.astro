---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  lifeEntries,
  dailyTimeline,
  teamMembers,
  projectWorkflow,
  activeBuilds,
  clientMoments,
  milestones,
  cultureMoments
} from '../data/lifeAtTeknoppy';

const title = "Life @ Teknoppy — Team Culture, Office Moments & Behind the Scenes";
const description = "Explore Life at Teknoppy — Kerala's premier web design and digital agency. Behind the websites, code, and launches: discover our team culture, daily rhythms, client collaborations, and creative craft.";

// Verified initials helper
const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).map(w => w[0]).join('').slice(0, 2).toUpperCase();

// Structured data for Life @ Teknoppy
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://teknoppy.com/life-at-teknoppy/#webpage",
  "url": "https://teknoppy.com/life-at-teknoppy/",
  "name": "Life @ Teknoppy — Team Culture & Behind the Scenes",
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "Teknoppy",
    "url": "https://teknoppy.com",
    "logo": "https://teknoppy.com/logo.svg"
  }
};

const filterCategories = [
  { id: 'all', label: 'All Moments' },
  { id: 'team', label: 'Team' },
  { id: 'projects', label: 'Projects' },
  { id: 'clients', label: 'Clients' },
  { id: 'behind-the-scenes', label: 'Behind the Scenes' },
  { id: 'achievements', label: 'Achievements' },
  { id: 'culture', label: 'Culture' }
];
---

<Layout title={title} description={description} hideBottomBar={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <Header forceSolidBg={false} />

  <!-- STICKY FLOATING LIFE NAVIGATION BAR & SCROLL COUNTER -->
  <aside id="life-nav-tracker" class="fixed top-20 right-4 sm:right-8 z-40 hidden md:flex items-center gap-3 bg-neutral-900/90 text-white backdrop-blur-md px-4 py-2 rounded-full border border-white/10 shadow-2xl transition-all duration-300">
    <div class="flex items-center gap-1.5 text-xs font-black tracking-widest text-primary uppercase">
      <span id="active-step-num">01</span>
      <span class="text-neutral-500">/</span>
      <span class="text-neutral-400">08</span>
    </div>
    <div class="w-[1px] h-3 bg-white/20"></div>
    <span id="active-step-title" class="text-xs font-bold text-neutral-200 tracking-wide">Hero</span>
    <div class="flex items-center gap-1.5 ml-2">
      <a href="#manifesto" class="w-2 h-2 rounded-full bg-white/30 hover:bg-primary transition-colors" title="Manifesto"></a>
      <a href="#daily" class="w-2 h-2 rounded-full bg-white/30 hover:bg-primary transition-colors" title="A Day at Teknoppy"></a>
      <a href="#wall" class="w-2 h-2 rounded-full bg-white/30 hover:bg-primary transition-colors" title="The Teknoppy Wall"></a>
      <a href="#workflow" class="w-2 h-2 rounded-full bg-white/30 hover:bg-primary transition-colors" title="Workflow"></a>
      <a href="#team" class="w-2 h-2 rounded-full bg-white/30 hover:bg-primary transition-colors" title="People Behind Teknoppy"></a>
    </div>
  </aside>

  <main class="overflow-x-hidden bg-[#FCFCFC] text-neutral-900">

    <!-- =========================================================================
         SECTION 1: CINEMATIC COLLAGE HERO
         ========================================================================= -->
    <section id="hero" class="life-section relative min-h-[92vh] lg:min-h-screen pt-32 pb-24 flex items-center justify-center overflow-hidden bg-neutral-950 text-white" data-section-num="01" data-section-name="Hero">
      <!-- Ambient Grid & Glow -->
      <div class="absolute inset-0 pointer-events-none z-0">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(240,90,44,0.18)_0%,transparent_70%)]"></div>
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
      </div>

      <!-- Floating Pills Foreground Tags -->
      <div class="absolute inset-0 max-w-[1400px] mx-auto pointer-events-none z-20 overflow-hidden">
        <span class="hero-floating-pill absolute top-28 left-6 sm:left-12 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-[11px] sm:text-xs font-black uppercase tracking-widest text-primary shadow-lg animate-float-slow">
          ✦ PEOPLE & CULTURE
        </span>
        <span class="hero-floating-pill absolute top-40 right-6 sm:right-16 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-[11px] sm:text-xs font-black uppercase tracking-widest text-[#F9AE42] shadow-lg animate-float-delayed">
          ✦ DIGITAL ARCHITECTURE
        </span>
        <span class="hero-floating-pill absolute bottom-32 left-10 sm:left-24 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-[11px] sm:text-xs font-black uppercase tracking-widest text-white/90 shadow-lg animate-float-slow">
          ✦ DAILY CRAFT
        </span>
        <span class="hero-floating-pill absolute bottom-28 right-8 sm:right-28 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-[11px] sm:text-xs font-black uppercase tracking-widest text-primary shadow-lg animate-float-delayed">
          ✦ KOCHI & BEYOND
        </span>
      </div>

      <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-12 relative z-10 w-full">
        <!-- Center Cinematic Typography -->
        <div class="text-center max-w-4xl mx-auto mb-12 sm:mb-16">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-black text-primary uppercase tracking-[0.25em] mb-6 shadow-inner">
            <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
            Digital Journal & Culture Wall
          </div>
          
          <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-[88px] font-black tracking-tight leading-[1.02] text-white mb-6 uppercase">
            LIFE <span class="text-primary italic font-serif">@</span> TEKNOPPY
          </h1>

          <p class="text-base sm:text-xl lg:text-2xl text-neutral-300 font-medium leading-relaxed max-w-3xl mx-auto">
            Behind the websites, ideas, launches and results — this is the people, daily work, and moments that make Teknoppy.
          </p>
        </div>

        <!-- Layered Collage Cards (Depth Flow) -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 max-w-5xl mx-auto relative">
          <!-- Card 1: Team & Collaboration -->
          <div class="group relative aspect-[4/5] rounded-3xl overflow-hidden border border-white/10 bg-neutral-900 shadow-2xl hover:scale-[1.03] transition-all duration-500 -rotate-1 hover:rotate-0">
            <img src="/whoweare.webp" alt="Teknoppy Team Collaboration" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-80 group-hover:opacity-100" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-5 flex flex-col justify-end">
              <span class="text-[10px] font-black tracking-widest uppercase text-primary mb-1">TEAM DISCOVERY</span>
              <p class="text-sm font-bold text-white leading-tight">Sprint Planning & Design Ideation</p>
            </div>
          </div>

          <!-- Card 2: Founder / Leadership Craft -->
          <div class="group relative aspect-[4/5] rounded-3xl overflow-hidden border border-white/10 bg-neutral-900 shadow-2xl hover:scale-[1.03] transition-all duration-500 translate-y-4 md:translate-y-8 rotate-2 hover:rotate-0">
            <img src="/team/sanal-edison.webp" alt="Sanal Edison - Lead Designer" class="w-full h-full object-contain p-2 group-hover:scale-105 transition-transform duration-700 opacity-90 group-hover:opacity-100" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent p-5 flex flex-col justify-end">
              <span class="text-[10px] font-black tracking-widest uppercase text-[#F9AE42] mb-1">CREATIVE DIRECTION</span>
              <p class="text-sm font-bold text-white leading-tight">Sanal Edison & UX Architecture</p>
            </div>
          </div>

          <!-- Card 3: Client Moments & Reviews -->
          <div class="group relative aspect-[4/5] rounded-3xl overflow-hidden border border-white/10 bg-neutral-900 shadow-2xl hover:scale-[1.03] transition-all duration-500 -translate-y-2 md:-translate-y-4 -rotate-2 hover:rotate-0">
            <img src="/testimonials/vivek-menon.webp" alt="Vivek Menon - Evosyz Collaboration" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-80 group-hover:opacity-100" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent p-5 flex flex-col justify-end">
              <span class="text-[10px] font-black tracking-widest uppercase text-emerald-400 mb-1">CLIENT MOMENT</span>
              <p class="text-sm font-bold text-white leading-tight">Evosyz FinTech Strategy Session</p>
            </div>
          </div>

          <!-- Card 4: Web Projects Shipped -->
          <div class="group relative aspect-[4/5] rounded-3xl overflow-hidden border border-white/10 bg-neutral-900 shadow-2xl hover:scale-[1.03] transition-all duration-500 translate-y-3 rotate-1 hover:rotate-0">
            <img src="/portfolios/website/direction-north.webp" alt="Direction North Portal" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-80 group-hover:opacity-100" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-5 flex flex-col justify-end">
              <span class="text-[10px] font-black tracking-widest uppercase text-primary mb-1">LIVE LAUNCH</span>
              <p class="text-sm font-bold text-white leading-tight">Direction North Global Freight</p>
            </div>
          </div>
        </div>

        <!-- Scroll down nudge -->
        <div class="text-center mt-14 sm:mt-16">
          <a href="#manifesto" class="inline-flex flex-col items-center gap-2 text-xs font-bold text-neutral-400 hover:text-primary transition-colors group">
            <span class="uppercase tracking-widest">Scroll To Explore</span>
            <svg class="w-5 h-5 text-primary group-hover:translate-y-1 transition-transform animate-bounce" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 2: "THIS IS US" MANIFESTO STREAM
         ========================================================================= -->
    <section id="manifesto" class="life-section py-24 sm:py-32 bg-[#FAF7F2] border-b border-neutral-200/60 relative overflow-hidden" data-section-num="02" data-section-name="Manifesto">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-xs font-bold text-primary uppercase tracking-wider mb-4">
            Our Culture & Ethos
          </div>
          <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-neutral-900 tracking-tight leading-tight">
            More Than Work.
          </h2>
          <p class="text-base sm:text-xl text-neutral-600 font-medium leading-relaxed mt-4 max-w-2xl mx-auto">
            We don’t just build templates. We obsess over the nuance, the performance, the user journey, and the people behind every brand we touch.
          </p>
        </div>

        <!-- Kinetic Typography Stream -->
        <div class="manifesto-stream max-w-5xl mx-auto space-y-4 sm:space-y-6">
          {['DESIGNING', 'BUILDING', 'SOLVING', 'LEARNING', 'CELEBRATING'].map((word, idx) => {
            const subtitles = [
              'Sculpting intuitive interfaces with purpose, clarity, and conversion psychology.',
              'Writing lean, semantic code that loads in milliseconds on any mobile connection.',
              'De-tangling complex business workflows into seamless digital customer funnels.',
              'Staying relentless on Core Web Vitals, new web standards, and search algorithms.',
              'Cheering every client milestone, production release, and team victory together.'
            ];
            return (
              <div class="manifesto-card group bg-white border border-neutral-200/70 rounded-3xl p-6 sm:p-10 shadow-sm hover:shadow-xl hover:border-primary/40 transition-all duration-300 flex flex-col md:flex-row md:items-center justify-between gap-4 cursor-default">
                <div class="flex items-baseline gap-4 sm:gap-6">
                  <span class="text-xs sm:text-sm font-black text-primary font-mono tracking-widest">0{idx + 1}</span>
                  <span class="text-3xl sm:text-5xl lg:text-6xl font-black text-neutral-900 group-hover:text-primary transition-colors tracking-tight uppercase">
                    {word}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-neutral-500 font-semibold max-w-md md:text-right group-hover:text-neutral-700 transition-colors">
                  {subtitles[idx]}
                </p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 3: A DAY AT TEKNOPPY (STICKY HORIZONTAL / CAROUSEL RAIL)
         ========================================================================= -->
    <section id="daily" class="life-section py-24 sm:py-32 bg-white border-b border-neutral-200/60 relative" data-section-num="03" data-section-name="Daily Rhythms">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
          <div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-xs font-bold text-primary uppercase tracking-wider mb-3">
              Daily Rhythms
            </div>
            <h2 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
              A Day At <span class="text-primary">Teknoppy</span>
            </h2>
            <p class="text-sm sm:text-base text-neutral-500 font-semibold mt-2 max-w-xl">
              From morning espresso & stand-up to late-evening Lighthouse benchmarks — here is how our days unfold at the Kochi studio.
            </p>
          </div>

          <!-- Controls for Desktop -->
          <div class="hidden sm:flex items-center gap-3">
            <button id="daily-prev-btn" class="w-12 h-12 rounded-full border border-neutral-200 bg-neutral-50 hover:bg-white hover:border-primary text-neutral-700 hover:text-primary flex items-center justify-center transition-all shadow-sm active:scale-95" aria-label="Previous Day Step">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
            </button>
            <button id="daily-next-btn" class="w-12 h-12 rounded-full border border-neutral-200 bg-neutral-50 hover:bg-white hover:border-primary text-neutral-700 hover:text-primary flex items-center justify-center transition-all shadow-sm active:scale-95" aria-label="Next Day Step">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
            </button>
          </div>
        </div>

        <!-- Scrollable Rail -->
        <div id="daily-rail" class="flex gap-6 overflow-x-auto pb-8 pt-2 scroll-smooth snap-x snap-mandatory scrollbar-none">
          {dailyTimeline.map((item, index) => (
            <div class="snap-start shrink-0 w-[290px] sm:w-[360px] md:w-[400px] bg-white border border-neutral-200/80 rounded-3xl p-6 sm:p-7 shadow-sm hover:shadow-xl hover:border-primary/30 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <!-- Time & Location Header -->
                <div class="flex items-center justify-between mb-5">
                  <div class="flex items-baseline gap-1 font-mono text-primary font-black">
                    <span class="text-3xl sm:text-4xl leading-none">{item.time}</span>
                    <span class="text-xs font-bold uppercase">{item.period}</span>
                  </div>
                  <span class="px-3 py-1 rounded-full bg-neutral-100 text-[11px] font-bold text-neutral-600 uppercase tracking-wider">
                    {item.location}
                  </span>
                </div>

                <!-- Visual Snapshot -->
                <div class="aspect-[16/10] rounded-2xl overflow-hidden bg-neutral-100 border border-neutral-200/60 mb-5 relative">
                  <img src={item.image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  <span class="absolute bottom-2.5 left-2.5 px-2.5 py-1 rounded-md bg-black/75 backdrop-blur-sm text-[10px] font-black uppercase text-white tracking-widest">
                    {item.tag}
                  </span>
                </div>

                <h3 class="text-lg sm:text-xl font-black text-neutral-900 group-hover:text-primary transition-colors mb-2 leading-snug">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-sm font-bold text-neutral-700 mb-3">{item.subtitle}</p>
                <p class="text-xs sm:text-sm text-neutral-500 font-medium leading-relaxed">
                  {item.description}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-between text-xs font-bold text-neutral-400">
                <span>Phase 0{index + 1} of 05</span>
                <span class="text-primary font-black group-hover:translate-x-1 transition-transform">✦ In Progress</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 4: THE TEKNOPPY WALL (EXPANDABLE MASONRY & FILTER)
         ========================================================================= -->
    <section id="wall" class="life-section py-24 sm:py-32 bg-[#F9F7F5] border-b border-neutral-200/60 relative" data-section-num="04" data-section-name="Media Wall">
      <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-12">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-xs font-bold text-primary uppercase tracking-wider mb-4">
            Visual Journal & Wall
          </div>
          <h2 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
            The <span class="text-primary">Teknoppy</span> Wall
          </h2>
          <p class="text-sm sm:text-base text-neutral-600 font-semibold mt-3">
            An expanding collection of project drops, client catchups, team highlights, and candid agency life. Click any card to expand.
          </p>
        </div>

        <!-- Filter Navigation Tabs -->
        <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-4 mb-10 scrollbar-none">
          {filterCategories.map((cat, idx) => (
            <button
              class={`life-filter-btn px-4 sm:px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-wider whitespace-nowrap transition-all duration-200 border ${
                idx === 0
                  ? 'bg-neutral-900 text-white border-neutral-900 shadow-md is-active'
                  : 'bg-white text-neutral-600 border-neutral-200 hover:border-primary hover:text-primary'
              }`}
              data-category={cat.id}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- Masonry Grid Cards -->
        <div id="media-wall-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 sm:gap-6">
          {lifeEntries.map((item, idx) => (
            <div
              class="wall-card group relative bg-white border border-neutral-200/80 rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl hover:border-primary/40 transition-all duration-300 cursor-pointer flex flex-col"
              data-category={item.category}
              data-index={idx}
              data-id={item.id}
              data-title={item.title}
              data-date={item.formattedDate}
              data-type={item.type}
              data-media={item.mediaUrl}
              data-youtube={item.youtubeId || ''}
              data-desc={item.description}
            >
              <!-- Media Frame -->
              <div class="relative w-full aspect-[4/3] bg-neutral-100 overflow-hidden">
                <img
                  src={item.thumbnailUrl || item.mediaUrl}
                  alt={item.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />

                {item.type === 'video' && (
                  <div class="absolute inset-0 bg-black/30 flex items-center justify-center group-hover:bg-black/20 transition-colors">
                    <div class="w-12 h-12 rounded-full bg-primary/95 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                      <svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                  </div>
                )}

                {item.isNew && (
                  <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-primary text-white text-[10px] font-black uppercase tracking-widest shadow-md">
                    ● RECENT
                  </span>
                )}

                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-[10px] font-black uppercase tracking-widest">
                  {item.formattedDate}
                </span>
              </div>

              <!-- Content Body -->
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-[11px] font-black uppercase tracking-wider text-primary">
                      #{item.category}
                    </span>
                    {item.client && (
                      <span class="text-[11px] font-semibold text-neutral-400">· {item.client}</span>
                    )}
                  </div>
                  <h3 class="text-base font-black text-neutral-900 group-hover:text-primary transition-colors leading-snug mb-2">
                    {item.title}
                  </h3>
                  <p class="text-xs text-neutral-500 font-medium leading-relaxed line-clamp-2">
                    {item.description}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-neutral-100 flex items-center justify-between text-xs font-bold text-neutral-400 group-hover:text-neutral-700">
                  <span>View Details</span>
                  <svg class="w-4 h-4 text-primary group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/>
                  </svg>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 5: DATE-BASED TIMELINE ("OUR JOURNEY")
         ========================================================================= -->
    <section id="journey" class="life-section py-24 sm:py-32 bg-white border-b border-neutral-200/60 relative" data-section-num="05" data-section-name="Journey">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-xs font-bold text-primary uppercase tracking-wider mb-4">
            Chronological Flow
          </div>
          <h2 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
            Our <span class="text-primary">Journey</span> & Milestones
          </h2>
          <p class="text-sm sm:text-base text-neutral-600 font-semibold mt-3">
            A real-time progression of recent agency releases, collaborations, and engineering wins.
          </p>
        </div>

        <!-- Vertical Timeline Container -->
        <div class="relative max-w-4xl mx-auto">
          <!-- Center Vertical Track Line -->
          <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-[2px] bg-neutral-200 md:-translate-x-1/2 z-0"></div>

