  }
  .lb.open {
    opacity: 1;
    pointer-events: auto;
  }
  .lb .box {
    width: min(840px, 100%);
    display: grid;
    gap: 16px;
    transform: scale(0.9);
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .lb.open .box {
    transform: none;
  }
  .lb p {
    color: #fff;
    text-align: center;
  }
  .lb .x {
    justify-self: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: none;
    color: #fff;
    font-size: 20px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .lb .x:hover {
    background: var(--orange);
    border-color: var(--orange);
  }

  /* FAQ */
  .faqg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    align-items: start;
  }
  .qa {
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .qa.open {
    border-color: #ffd3c1;
    box-shadow: 0 20px 40px -30px rgba(241, 90, 36, 0.6);
  }
  .qa button {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
    padding: 20px 22px;
    cursor: pointer;
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
  }
  .qa button:focus-visible {
    outline: 3px solid var(--orange);
  }
  .pm {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--tint);
    color: var(--orange);
    display: grid;
    place-items: center;
    position: relative;
    transition: transform 0.4s ease, background 0.3s ease, color 0.3s ease;
  }
  .pm::before, .pm::after {
    content: "";
    position: absolute;
    width: 12px;
    height: 2px;
    background: currentColor;
    transition: transform 0.4s ease;
  }
  .pm::after {
    transform: rotate(90deg);
  }
  .qa.open .pm {
    background: var(--orange);
    color: #fff;
    transform: rotate(180deg);
  }
  .qa.open .pm::after {
    transform: rotate(0);
  }
  .ans {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .qa.open .ans {
    grid-template-rows: 1fr;
  }
  .ans > div {
    overflow: hidden;
  }
  .ans p {
    color: var(--muted);
    padding: 0 22px 20px;
    line-height: 1.6;
  }
  .faqnote {
    text-align: center;
    color: var(--muted);
    margin-top: 26px;
    font-size: 15px;
  }
  .faqnote a {
    color: var(--orange);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Dual CTA End Split */
  .endsplit {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 32px;
    overflow: hidden;
    border: 1px solid var(--tint-line);
    box-shadow: 0 16px 40px -16px rgba(241, 90, 36, 0.15);
  }
  .endsplit > div {
    padding: 56px 44px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-width: 0;
  }
  .endsplit h3 {
    font-size: clamp(28px, 3.4vw, 42px);
    letter-spacing: -0.04em;
  }
  .endsplit p {
    font-size: 17px;
    max-width: 36ch;
    line-height: 1.6;
  }
  .endsplit .l {
    background: var(--tint);
  }
  .endsplit .l p {
    color: var(--muted);
  }
  .endsplit .r {
    background: var(--orange);
    color: #fff;
  }
  .endsplit .r h3 {
    color: #fff;
  }
  .endsplit .r p {
    color: rgba(255, 255, 255, 0.9);
  }
  .endsplit .r .btn {
    background: #fff;
    color: var(--orange) !important;
  }
  .endsplit .r::before {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    border: 40px solid rgba(255, 255, 255, 0.12);
    right: -100px;
    bottom: -120px;
    animation: ctaSpin 26s linear infinite;
    z-index: -1;
  }
  @keyframes ctaSpin {
    to { transform: rotate(360deg); }
  }
  .endsplit .r::after {
    content: "";
    position: absolute;
    top: 0;
    left: -40%;
    width: 30%;
    height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transform: skewX(-20deg);
    animation: ctaShine 5s ease-in-out infinite;
    z-index: -1;
  }
  @keyframes ctaShine {
    0%, 60% { left: -40%; }
    100% { left: 130%; }
  }

  /* Scroll Reveal Transitions */
  .js .rv {
    opacity: 0;
    transform: translateY(36px);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(var(--d, 0) * 90ms);
  }
  .js .rv.in {
    opacity: 1;
    transform: none;
  }

  /* Responsive Media Queries matching reference design */
  @media (max-width: 980px) {
    .dots { display: none; }
    .teamw, .place, .vrow, .faqg { grid-template-columns: 1fr; }
    .vi .inner { grid-template-columns: 1fr; padding-left: 6px; }
    .vi .inner p, .vi .prac { grid-column: auto; }
    .vi button { grid-template-columns: 50px 1fr auto; }
    .stories { grid-template-columns: 1fr; }
    .endsplit { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .life-page section { padding-block: 68px; }
    .vi button { grid-template-columns: 36px 1fr auto; gap: 12px; padding: 20px 2px; }
    .vi .pl { width: 38px; height: 38px; }
    .founder { grid-template-columns: 1fr; padding: 26px; }
    .story { padding: 24px; }
    .video { min-height: 240px; }
    .frame { flex-basis: 230px; }
    .frame.photo { flex-basis: 280px; }
    .orbit { max-width: 340px; }
    .endsplit > div { padding: 36px 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
    .words .wd { opacity: 1; transform: none; }
  }
</style>

<script is:inline>
(function() {
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = matchMedia('(pointer: fine)').matches;
  var root = document.documentElement;

  function $$(selector, context) {
    return [].slice.call((context || document).querySelectorAll(selector));
  }

  /* Heading Word-by-word Reveals */
  $$('.words').forEach(function(h) {
    if (h.dataset.split) return;
    h.dataset.split = 'true';
    var i = 0;
    h.innerHTML = h.textContent.split(' ').map(function(w) {
      return '<span class="wd" style="transition-delay:' + (i++ * 60) + 'ms">' + w + '</span>';
    }).join(' ');
  });

  /* 3. Reveal and Number Counter Observers */
  function show(el) {
    el.classList.add('in');
  }
  
  if (!reduce && 'IntersectionObserver' in window) {
    root.classList.add('js');
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          show(e.target);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.15 });

    $$('.rv, .sec, .step.intro').forEach(function(el) {
      el.getBoundingClientRect().top < innerHeight ? show(el) : io.observe(el);
    });

    // Fallback timer so content is never stuck
    setTimeout(function() {
      $$('.rv:not(.in), .sec:not(.in), .step.intro:not(.in)').forEach(show);
    }, 4000);

    // Number counters
    var co = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (!e.isIntersecting) return;
        var el = e.target;
        var to = +el.dataset.to;
        var from = +(el.dataset.from || 0);
        var t0 = null;
        function stepCount(timestamp) {
          if (!t0) t0 = timestamp;
          var progress = Math.min((timestamp - t0) / 1600, 1);
          el.textContent = Math.round(from + (to - from) * (1 - Math.pow(1 - progress, 3)));
          if (progress < 1) requestAnimationFrame(stepCount);
        }
        requestAnimationFrame(stepCount);
        co.unobserve(el);
      });
    }, { threshold: 0.5 });

    $$('.cnt').forEach(function(c) {
      co.observe(c);
    });
  } else {
    root.classList.add('nojs');
    $$('.sec, .step.intro, .rv').forEach(show);
  }

  /* Hero Fan Pointer Perspective Tilt */
  if (fine && !reduce) {
    var heroFan = document.getElementById('hero-fan');
    if (heroFan) {
      heroFan.addEventListener('mousemove', function(e) {
        var rect = heroFan.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width - 0.5;
        var y = (e.clientY - rect.top) / rect.height - 0.5;
        heroFan.style.transform = 'perspective(1200px) rotateY(' + (x * 8) + 'deg) rotateX(' + (-y * 6) + 'deg)';
      });
      heroFan.addEventListener('mouseleave', function() {
        heroFan.style.transform = 'none';
        heroFan.style.transition = 'transform 0.5s ease';
      });
      heroFan.addEventListener('mouseenter', function() {
        heroFan.style.transition = 'none';
      });
    }
  }

  /* 4. Values Accordion Interaction */
  $$('.vi button').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = btn.parentElement;
      var isOpen = item.classList.contains('open');
      $$('.vi').forEach(function(v) {
        v.classList.remove('open');
        var b = v.querySelector('button');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* 5. Team Orbit Interactive Controls */
  var teamData = window.__TEKNOPPY_TEAM_ORBIT__ || [];
  var ospin = document.getElementById('ospin');
  var ocore = document.getElementById('ocore');
  var ocoreImg = document.getElementById('ocore-img');
  var ocoreTitle = document.getElementById('ocore-title');
  var ocoreSub = document.getElementById('ocore-sub');
  var tcard = document.getElementById('tcard');
  var tcardName = document.getElementById('tcard-name');
  var tcardRole = document.getElementById('tcard-role');
  var tcardDesc = document.getElementById('tcard-desc');
  var tcardPhoto = document.getElementById('tcard-photo');
  var ttimer;
  var currentOrbitIdx = 0;

  function pickOrbit(idx) {
    if (!teamData[idx]) return;
    currentOrbitIdx = idx;
    var t = teamData[idx];

    if (ocoreImg) {
      ocoreImg.style.opacity = '0';
      setTimeout(function() {
        ocoreImg.src = t.photo;
        ocoreImg.alt = t.name;
        ocoreImg.style.opacity = '1';
      }, 150);
    }
    if (ocoreTitle) ocoreTitle.textContent = t.name;
    if (ocoreSub) ocoreSub.textContent = t.caption;

    if (tcard) {
      tcard.className = 'tcard';
      void tcard.offsetWidth; // Trigger reflow for animation restart
      tcard.className = 'tcard swap';
    }
    if (tcardName) tcardName.textContent = t.name;
    if (tcardRole) tcardRole.textContent = t.role;
    if (tcardDesc) tcardDesc.textContent = t.desc;
    if (tcardPhoto) tcardPhoto.textContent = 'Photo: ' + t.caption;

    $$('.od').forEach(function(node) {
      node.classList.toggle('on', +node.dataset.i === idx);
    });
    $$('#tnav button').forEach(function(pill) {
      pill.classList.toggle('on', +pill.dataset.i === idx);
    });

    clearTimeout(ttimer);
    if (!reduce) {
      ttimer = setTimeout(function() {
        pickOrbit((currentOrbitIdx + 1) % teamData.length);
      }, 3800);
    }
  }

  $$('.od').forEach(function(node) {
    node.addEventListener('click', function() {
      pickOrbit(+node.dataset.i);
    });
    node.addEventListener('mouseenter', function() {
      if (fine) pickOrbit(+node.dataset.i);
    });
  });

  $$('#tnav button').forEach(function(pill) {
    pill.addEventListener('click', function() {
      pickOrbit(+pill.dataset.i);
    });
  });

  if (teamData.length > 0) {
    pickOrbit(0);
  }

  /* 6. Story Spotlight Hover Effect */
  if (fine) {
    $$('.story').forEach(function(card) {
      card.addEventListener('mousemove', function(e) {
        var rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - rect.left) + 'px');
        card.style.setProperty('--my', (e.clientY - rect.top) + 'px');
      });
    });
  }

  /* 7. Drag-Scroll Helper for Filmstrip & Carousel */
  function makeDraggable(el) {
    if (!el) return;
    var isDown = false;
    var startX = 0;
    var scrollLeft = 0;
    var moved = false;

    el.addEventListener('mousedown', function(e) {
      isDown = true;
      moved = false;
      startX = e.pageX;
      scrollLeft = el.scrollLeft;
      el.classList.add('drag');
    });

    addEventListener('mouseup', function() {
      if (isDown) {
        isDown = false;
        el.classList.remove('drag');
      }
    });

    el.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      e.preventDefault();
      if (Math.abs(e.pageX - startX) > 4) moved = true;
      el.scrollLeft = scrollLeft - (e.pageX - startX);
    });

    el.addEventListener('click', function(e) {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);
  }

  makeDraggable(document.getElementById('frames'));

  /* 8. Celebrations Carousel and Lightbox */
  var car = document.getElementById('car');
  makeDraggable(car);

  var slides = $$('.slide', car);
  var cbar = document.getElementById('cbar');

  function syncCarousel() {
    if (!car || slides.length === 0) return;
    var cRect = car.getBoundingClientRect();
    var mid = cRect.left + cRect.width / 2;
    var bestIdx = 0;
    var bestDistance = 1e9;

    slides.forEach(function(slide, idx) {
      var r = slide.getBoundingClientRect();
      var dist = Math.abs(r.left + r.width / 2 - mid);
      if (dist < bestDistance) {
        bestDistance = dist;
        bestIdx = idx;
      }
    });

    slides.forEach(function(s, idx) {
      s.classList.toggle('on', idx === bestIdx);
    });

    var maxScroll = car.scrollWidth - car.clientWidth;
    if (cbar) {
      cbar.style.width = (maxScroll > 0 ? (car.scrollLeft / maxScroll * 100) : 100) + '%';
    }
  }

  if (car) {
    car.addEventListener('scroll', syncCarousel, { passive: true });
    syncCarousel();
  }

  var cnext = document.getElementById('cnext');
  var cprev = document.getElementById('cprev');
  function getStepWidth() {
    return (slides[0] ? slides[0].offsetWidth : 380) + 20;
  }
  if (cnext) {
    cnext.addEventListener('click', function() {
      if (car) car.scrollBy({ left: getStepWidth(), behavior: 'smooth' });
    });
  }
  if (cprev) {
    cprev.addEventListener('click', function() {
      if (car) car.scrollBy({ left: -getStepWidth(), behavior: 'smooth' });
    });
  }

  /* Lightbox Modal */
  var lb = document.getElementById('lb');
  var lbph = document.getElementById('lbph');
  var lbc = document.getElementById('lbc');
  var lbx = document.getElementById('lbx');
  var lastFocusedSlide = null;

  slides.forEach(function(slide) {
    slide.addEventListener('click', function() {
      lastFocusedSlide = slide;
      var img = slide.querySelector('img');
      var fig = slide.querySelector('figcaption');
      if (lbph && img) {
        lbph.innerHTML = '<img src="' + img.src + '" alt="' + (img.alt || '') + '" />';
      }
      if (lbc && fig) {
        lbc.innerHTML = fig.innerHTML;
      }
      if (lb) lb.classList.add('open');
      if (lbx) lbx.focus();
    });
    slide.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        slide.click();
      }
    });
  });

  function closeLightbox() {
    if (lb) lb.classList.remove('open');
    if (lastFocusedSlide && lastFocusedSlide.focus) lastFocusedSlide.focus();
  }
  if (lbx) lbx.addEventListener('click', closeLightbox);
  if (lb) {
    lb.addEventListener('click', function(e) {
      if (e.target === lb) closeLightbox();
    });
  }
  addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lb && lb.classList.contains('open')) closeLightbox();
  });

  /* 9. FAQ Accordion Interaction */
  $$('.qa button').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var qaItem = btn.parentElement;
      var isOpen = qaItem.classList.contains('open');
      qaItem.classList.toggle('open', !isOpen);
      btn.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
    });
  });

  /* 10. Scroll Listeners: Top Progress Bar and Side Dots Navigation */
  var progressBar = document.getElementById('progress');
  var dots = $$('#dots a');
  var dotTargets = dots.map(function(a) {
    return document.querySelector(a.getAttribute('href'));
  });

  function onScroll() {
    var maxScroll = root.scrollHeight - innerHeight;
    if (progressBar) {
      progressBar.style.transform = 'scaleX(' + (maxScroll > 0 ? scrollY / maxScroll : 0) + ')';
    }

    var activeDot = 0;
    dotTargets.forEach(function(target, idx) {
      if (target && target.getBoundingClientRect().top < innerHeight * 0.45) activeDot = idx;
    });
    dots.forEach(function(dot, idx) {
      dot.classList.toggle('on', idx === activeDot);
    });
  }

  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  onScroll();
})();
</script>
