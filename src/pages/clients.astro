---
/**
 * /clients/ — the client roster page that exists on the old teknoppy.com and
 * was missing from this build. The logo wall reads from src/data/clients.json,
 * the same file the homepage strip and the testimonial grid use, so a new
 * client is added in one place.
 *
 * Everything else on the page is real: quotes come from the testimonials
 * collection, projects from the portfolio collection. No invented numbers.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Quote } from 'lucide-react';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import clients from '../data/clients.json';
import page from '../data/pages/clients.json';

const logos = clients.logos;

// Targeted enlargement styles for specific clients whose logos have internal padding or need visual prominence
const enlargedLogoConfigs: Record<string, { imgClass: string }> = {
  'Laughing Waters': {
    imgClass: 'max-h-[80px] sm:max-h-[88px] xl:max-h-[92px] scale-[1.35] sm:scale-[1.42] xl:scale-[1.48]'
  },
  'Abrus Krishna Finance': {
    imgClass: 'max-h-[80px] sm:max-h-[88px] xl:max-h-[94px] scale-[1.55] sm:scale-[1.65] xl:scale-[1.75]'
  },
  'Alankar Avenue': {
    imgClass: 'max-h-[80px] sm:max-h-[88px] xl:max-h-[94px] scale-[1.70] sm:scale-[1.80] xl:scale-[1.90]'
  },
  'Kerala Dayz': {
    imgClass: 'max-h-[78px] sm:max-h-[86px] xl:max-h-[90px] scale-[1.45] sm:scale-[1.52] xl:scale-[1.60]'
  }
};

const testimonials = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => t.data);

const projects = (await getCollection('portfolio', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => e.data);

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Teknoppy Clients",
    "description": page.meta.description,
    "url": "https://teknoppy.com/clients/",
    "about": { "@type": "Organization", "name": site.businessName, "url": "https://teknoppy.com/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": page.breadcrumb.map((c, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": c.name,
      "item": `https://teknoppy.com${c.href}`
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": page.faq.items.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">

    <!-- HERO -->
    <section class="ds-hero relative pt-32 pb-20 md:pt-36 md:pb-24 overflow-hidden bg-[#fff8f2] text-neutral-900 border-b border-primary/10">
      <div class="absolute inset-0 opacity-[0.18]">
        <div class="ds-hero-glow absolute inset-0"></div>
        <div class="ds-hero-orbit absolute hidden lg:block"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 flex flex-col items-center text-center">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold text-neutral-500">
            <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-neutral-700" aria-current="page">Clients</li>
          </ol>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/80 border border-neutral-200 text-xs font-bold text-primary uppercase tracking-widest mb-6">
          {page.hero.badge}
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-black leading-[1.1] tracking-tight text-neutral-900 mb-6">
          {page.hero.h1Lead}{' '}
          <span class="relative inline-block text-primary">
            {page.hero.h1Accent}
            <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
          </span>
        </h1>

        {page.hero.body.map((p) => (
          <p class="text-base sm:text-lg text-neutral-600 max-w-3xl font-medium leading-relaxed mt-4">{p}</p>
        ))}
      </div>
    </section>

    <!-- LOGO WALL -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mb-10">
          <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">{page.wall.heading}</h2>
          <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">{page.wall.intro}</p>
        </div>

        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 border-t border-l border-neutral-100 rounded-3xl overflow-hidden bg-white shadow-[0_12px_30px_-18px_rgba(0,0,0,0.08)]">
          {logos.map((logo) => {
            const enlarged = enlargedLogoConfigs[logo.name];
            const imgClass = enlarged
              ? `${enlarged.imgClass} max-w-full object-contain mix-blend-multiply transition-transform duration-300`
              : 'max-h-[52px] max-w-full object-contain mix-blend-multiply transition-transform duration-300';
            return (
              <li class="aspect-[4/3] border-r border-b border-neutral-100 flex flex-col items-center justify-center gap-3 p-5 sm:p-6 hover:bg-neutral-50/60 transition-colors duration-300">
                <span class="logo-plate flex items-center justify-center w-full flex-grow px-3 py-2">
                  <img
                    src={logo.src}
                    alt={`${logo.name} logo`}
                    width="200"
                    height="120"
                    loading="lazy"
                    decoding="async"
                    class={imgClass}
                  />
                </span>
                <span class="text-[11px] font-bold text-neutral-400 uppercase tracking-wider text-center leading-tight">{logo.name}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- SECTORS -->
    <section class="py-16 sm:py-20 bg-cream/30 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mb-10">
          <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">{page.sectors.heading}</h2>
          <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">{page.sectors.intro}</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {page.sectors.items.map((item) => (
            <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col">
              <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
              <h3 class="text-lg font-black text-neutral-900 leading-snug mb-3">{item.title}</h3>
              <p class="text-neutral-600 text-sm leading-relaxed font-medium">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    {testimonials.length > 0 && (
      <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
          <div class="max-w-3xl mb-10">
            <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">{page.testimonials.heading}</h2>
            <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">{page.testimonials.intro}</p>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {testimonials.map((t) => (
              <figure class="bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] flex flex-col">
                <Quote class="w-6 h-6 text-primary/30 mb-4 flex-shrink-0" />
                <blockquote class="text-neutral-700 text-sm leading-relaxed font-medium flex-grow">{t.quote}</blockquote>
                <figcaption class="flex items-center gap-3 mt-6 pt-5 border-t border-neutral-100">
                  {t.photo
                    ? <img src={t.photo} alt={t.name} width="44" height="44" loading="lazy" decoding="async" class="w-11 h-11 rounded-full object-cover border border-neutral-100" />
                    : <span class="w-11 h-11 rounded-full bg-primary text-white text-sm font-black flex items-center justify-center">{t.initials || t.name.charAt(0)}</span>}
                  <span class="min-w-0">
                    <span class="block text-sm font-black text-neutral-900 leading-snug">{t.name}</span>
                    <span class="block text-xs font-semibold text-neutral-500 leading-snug mt-0.5">{t.role}</span>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- PROJECTS -->
    {projects.length > 0 && (
      <section class="py-16 sm:py-20 bg-cream/30 border-t border-neutral-100">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
          <div class="max-w-3xl mb-10">
            <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">{page.projects.heading}</h2>
            <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">{page.projects.intro}</p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {projects.map((proj) => (
              <div class="bg-white rounded-3xl border border-neutral-200/60 p-6 shadow-sm flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-3 mb-4">
                    <h3 class="text-lg font-bold text-neutral-900">{proj.name}</h3>
                    <span class="text-[11px] font-black text-primary bg-primary/5 px-2 py-0.5 rounded-full uppercase tracking-wider whitespace-nowrap">{proj.industry}</span>
                  </div>
                  <p class="text-xs font-bold text-neutral-400 uppercase tracking-wider mb-3">{proj.location}</p>
                  <p class="text-neutral-600 text-xs leading-relaxed font-semibold mb-4">{proj.description}</p>
                  <div class="bg-neutral-50/50 rounded-2xl p-4 border border-neutral-100">
                    <span class="block text-[12px] font-black text-neutral-800 uppercase tracking-wider mb-1">Result</span>
                    <p class="text-neutral-500 text-xs font-semibold leading-relaxed">{proj.result}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- RELATED PAGES -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-2xl sm:text-3xl font-black text-neutral-900 leading-tight mb-8">{page.links.heading}</h2>

        <div class="grid gap-4 sm:grid-cols-2 max-w-5xl">
          {page.links.items.map((item) => (
            <a href={item.href} class="group bg-white rounded-2xl border border-neutral-100 p-5 shadow-[0_10px_24px_-16px_rgba(0,0,0,0.08)] hover:border-primary/30 hover:-translate-y-0.5 transition-all duration-300 flex items-start justify-between gap-4">
              <span>
                <span class="block text-sm font-black text-neutral-900 group-hover:text-primary transition-colors">{item.label}</span>
                <span class="block text-neutral-500 text-xs font-semibold mt-1 leading-relaxed">{item.text}</span>
              </span>
              <ArrowRight class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 sm:py-20 bg-cream/30 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight mb-10 text-center">{page.faq.heading}</h2>

        <div class="max-w-4xl mx-auto space-y-4">
          {page.faq.items.map((faq) => (
            <details class="group bg-white rounded-2xl border border-neutral-200/60 p-6 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
                <h3 class="text-sm sm:text-base font-bold text-neutral-850 pr-4">{faq.q}</h3>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-primary flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-neutral-100/60 text-xs sm:text-sm text-neutral-600 leading-relaxed font-semibold">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl sm:text-4xl font-black text-neutral-900 leading-tight mb-4">{page.cta.heading}</h2>
          <p class="text-neutral-700 font-medium text-base sm:text-lg leading-relaxed mb-8">{page.cta.text}</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href={page.cta.primary.href} class="inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300">
              {page.cta.primary.label}
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href={page.cta.secondary.href} class="inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-bold text-neutral-900 bg-white border border-neutral-200 rounded-full hover:border-primary hover:text-primary transition-all duration-300">
              {page.cta.secondary.label}
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <FooterCTA />

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</Layout>
