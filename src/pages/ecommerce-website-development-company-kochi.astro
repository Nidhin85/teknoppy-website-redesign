---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { ArrowRight, Play, Globe2, Smile, Award, Star, CheckCircle, Clock, Heart, Shield, Check, HelpCircle, User, Zap, Rocket, Activity, Home, Utensils, GraduationCap, Compass, Briefcase, Factory, Languages, MonitorSmartphone, Building2, Edit, ShieldCheck, Search, Layers, Network, Code, Gauge, LayoutGrid, Calendar, TrendingUp } from 'lucide-react';

const title = "Ecommerce Website Development Company in Kochi | Teknoppy";
const description = "Teknoppy is a trusted ecommerce website development company in Kochi building fast, secure, SEO-ready online stores for Kerala businesses. Get a free quote.";

const services = [
  {
    title: "Custom Ecommerce Development",
    desc: "Tailor-made stores with product filtering, subscriptions, bundles, and custom checkout flows built on clean, scalable code.",
    icon: Code
  },
  {
    title: "WooCommerce Development",
    desc: "Flexible, SEO-friendly stores on WordPress and WooCommerce, giving you full ownership and easy day-to-day control.",
    icon: Layers
  },
  {
    title: "Shopify Development",
    desc: "Quick-to-launch, reliable Shopify stores for brands wanting a hosted, low-maintenance platform with predictable costs.",
    icon: Rocket
  },
  {
    title: "Multi-Vendor Marketplace Development",
    desc: "Platforms where many sellers list and sell, with vendor dashboards, commission handling, and automated order routing.",
    icon: Network
  },
  {
    title: "Payment Gateway Integration",
    desc: "Secure setup of Indian and international payment options, with full testing and PCI-aware configuration.",
    icon: Shield
  },
  {
    title: "Ecommerce Redesign & Migration",
    desc: "A complete overhaul or platform move that preserves your existing Google ranking history and SEO equity.",
    icon: Edit
  }
];

const processes = [
  {
    step: "01",
    title: "Discovery & Goal Mapping",
    desc: "A structured brief covering products, target markets, competitors, and technical needs. We map your local SEO area from the start.",
    icon: Search
  },
  {
    step: "02",
    title: "Sitemap & URL Architecture",
    desc: "Category and product URL planning and internal linking, defined before design to prevent cannibalization and ensure crawlability.",
    icon: Network
  },
  {
    step: "03",
    title: "Wireframing & UX Design",
    desc: "Low-fidelity wireframes first, then high-fidelity mockups. You approve the layout before a line of code is written.",
    icon: LayoutGrid
  },
  {
    step: "04",
    title: "Development & Schema",
    desc: "Clean, mobile-first code with Product, Offer, Organisation, BreadcrumbList, and FAQPage schema built in for rich results.",
    icon: Code
  },
  {
    step: "05",
    title: "Payments, SEO & Speed",
    desc: "Secure gateway setup, optimised metadata, image compression, Core Web Vitals tuning, and Search Console verification.",
    icon: Gauge
  },
  {
    step: "06",
    title: "Launch, Testing & Handover",
    desc: "Full cross-device and checkout testing, sitemap submission, and a clear handover document covering store management.",
    icon: Rocket
  }
];

const pricing = [
  { type: "Starter Online Store (up to 50 products)", price: "Rs. 45,000 – 90,000" },
  { type: "Professional Ecommerce Store (WooCommerce / Shopify)", price: "Rs. 90,000 – 2,00,000" },
  { type: "Custom Ecommerce / B2B Portal", price: "Rs. 2,00,000 – 6,00,000" },
  { type: "Multi-Vendor Marketplace", price: "Rs. 3,00,000 – 8,00,000+" },
  { type: "Ecommerce Redesign / Migration", price: "Rs. 50,000 – 2,00,000" },
  { type: "Ongoing Monthly Maintenance", price: "Rs. 5,000 – 15,000 / mo" }
];

const industries = [
  { name: "Fashion & Lifestyle", desc: "Visual product pages, size guides, and fast mobile checkout.", icon: Heart },
  { name: "Ayurveda, Wellness & Export", desc: "Multilingual, multi-currency stores built to convert international buyers.", icon: Activity },
  { name: "Groceries & FMCG", desc: "Bulk ordering, delivery zones, and repeat-purchase flows.", icon: Utensils },
  { name: "Electronics & Gadgets", desc: "Detailed specifications, comparison tools, and secure payments.", icon: MonitorSmartphone },
  { name: "Manufacturing & B2B", desc: "Catalogue stores with enquiry-to-order and custom pricing.", icon: Factory },
  { name: "Handicrafts & Local Brands", desc: "Storytelling pages that sell Kerala products to India and the world.", icon: Award }
];

const projects = [
  {
    name: "Evosyz",
    loc: "KOCHI · FINTECH",
    desc: "On-page SEO and conversion optimisation for a regulated fintech brand with WhatsApp integration.",
    result: "Stronger search visibility for fintech keywords in Kochi and increased franchise and partnership enquiries."
  },
  {
    name: "Greens Ayurveda",
    loc: "AZHIYUR, CALICUT · AYURVEDA",
    desc: "Local and organic SEO with schema and a structured enquiry flow for Ayurvedic-treatment keywords.",
    result: "A significant rise in international enquiries and steady organic growth for wellness keywords."
  },
  {
    name: "Olives Resort",
    loc: "WAYANAD · HOSPITALITY",
    desc: "Conversion-focused website paired with local and organic SEO for resort keywords.",
    result: "Top Google rankings for core resort keywords and a measurable increase in direct booking calls (confirmed by CEO Biju Thomas)."
  }
];

const testimonials = [
  {
    quote: "We now rank at the top of Google for our keywords and get many direct booking calls due to better visibility. Thank you Teknoppy for all the support.",
    author: "Biju Thomas",
    role: "CEO, Olives Resort, Wayanad"
  },
  {
    quote: "Being in the Fintech space, we needed a reliable partner. Teknoppy created an appealing website that represents our brand perfectly.",
    author: "Vivek Menon",
    role: "CTO, Evosyz, Kochi"
  },
  {
    quote: "Teknoppy was very intuitive in understanding our requirements. They made great digital collateral and now we are getting good outreach to the market.",
    author: "Shainesh Prakashan",
    role: "CEO, Exacore IT, Infopark Kochi"
  },
  {
    quote: "I have worked with many IT teams, but I am 100% happy with Teknoppy. No doubt, I recommend them with 100% satisfaction.",
    author: "Dr. Asghar",
    role: "CEO, Greens Ayurveda, Calicut"
  }
];

const faqs = [
  {
    q: "How much does ecommerce website development cost in Kochi?",
    a: "A standard online store typically costs between Rs. 45,000 and Rs. 2,00,000 depending on product count, features, and design. Custom and marketplace platforms cost more. A detailed written quote is provided before any project begins."
  },
  {
    q: "Which is the best platform for an ecommerce website in Kerala?",
    a: "It depends on your goals. WooCommerce is best for control and SEO; Shopify for a hosted, low-maintenance store; custom builds for large or complex businesses. We recommend the right fit after understanding your products and budget."
  },
  {
    q: "How long does it take to build an online store in Kochi?",
    a: "A standard ecommerce website takes 4 to 8 weeks from discovery to launch. Larger custom or multi-vendor platforms take 8 to 14 weeks. A written timeline is shared at the start."
  },
  {
    q: "Can I manage and update my store myself after launch?",
    a: "Yes. We build on user-friendly platforms like WooCommerce and Shopify, giving you a simple dashboard to add products, update prices, and run offers without any coding. A handover guide and optional training are included."
  },
  {
    q: "Do you build ecommerce websites for international customers?",
    a: "Yes. We build multi-currency, multilingual stores with international payment gateways and shipping logic — ideal for Ayurveda, handicraft, and export brands selling beyond India."
  },
  {
    q: "What schema markup do you implement on ecommerce stores?",
    a: "Product, Offer, Organisation, BreadcrumbList, FAQPage, and where applicable AggregateRating and Review schema — helping qualify for Google rich results and AI answer engines like ChatGPT and Perplexity."
  },
  {
    q: "Are your ecommerce websites SEO-friendly and mobile-first?",
    a: "Yes. Every store is built mobile-first with clean code, Product schema, optimised metadata, and Core Web Vitals tuning, so it is ready to rank from launch. Over 70% of Kerala web traffic comes from mobile, so this is standard."
  },
  {
    q: "Do you provide maintenance after the store goes live?",
    a: "Yes. Monthly maintenance plans from Rs. 5,000 per month cover updates, security monitoring, speed checks, product edits, and technical fixes."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={title} description={description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- HERO SECTION WITH OFFICE CIRCLING SVG (DARK VERSION) -->
    <section class="relative pt-32 pb-24 md:pt-36 md:pb-32 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.png')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 grid xl:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="xl:col-span-7 flex flex-col items-center text-center xl:items-start xl:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
            <Zap class="w-3.5 h-3.5" />
            Kerala's Ecommerce Studio
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-black leading-[1.1] tracking-tight text-white mb-6">
            <span class="relative inline-block text-primary">
              Ecommerce
              <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span> Website Development <br class="hidden sm:block" />
            Company in Kochi
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-neutral-300 mb-5 max-w-2xl font-medium leading-relaxed">
            Custom · Secure · SEO-Ready Online Stores for Kerala Businesses Since 2018. We build online stores that rank and sell — at home in India and across the world.
          </p>
          <p class="text-sm sm:text-base text-neutral-400 mb-8 max-w-2xl font-medium leading-relaxed">
            Ecommerce Website Development Company in Kochi — Teknoppy builds custom, mobile-first, conversion-focused online stores that help Kerala businesses sell more, both at home in India and to customers around the world. Since 2018, we have delivered 120+ website and ecommerce projects, from compact single-brand stores to large multi-vendor marketplaces, helping Kerala brands sell online with confidence.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
            <a href="#contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap">
              Get a Free Quote
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href="#services" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white border border-white/20 rounded-full hover:bg-white/5 transition-all duration-300 shadow-sm whitespace-nowrap">
              Explore Our Services
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Hero Graphic (Redesigned Stats Cards Grid) -->
        <div class="xl:col-span-5 grid grid-cols-2 gap-4 sm:gap-6">

          <!-- Card 1 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Rocket class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">120+</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Projects Delivered</span>
          </div>

          <!-- Card 2 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Calendar class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">2018</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Established</span>
          </div>

          <!-- Card 3 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <TrendingUp class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Page 1</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Google Results</span>
          </div>

          <!-- Card 4 -->
          <div class="bg-[#0c0c0e] border border-white/5 rounded-[2rem] p-8 shadow-2xl hover:border-primary/30 hover:shadow-[0_0_30px_rgba(240,90,44,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-start min-h-[220px] group">
            <div class="w-11 h-11 rounded-full border border-primary/30 flex items-center justify-center text-primary bg-primary/5 shadow-[0_0_15px_rgba(240,90,44,0.25)] mb-6 group-hover:scale-105 transition-transform">
              <Globe2 class="w-5 h-5" />
            </div>
            <span class="text-3xl font-black text-white block leading-none mb-2">Kerala + Global</span>
            <div class="w-8 h-[2px] bg-primary mb-4"></div>
            <span class="text-[9px] font-black text-neutral-400 uppercase tracking-widest leading-normal">Wide Coverage</span>
          </div>

        </div>
      </div>
    </section>

    <!-- INTRO BAND -->
    <section class="py-16 bg-white border-b border-neutral-100 relative">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <p class="text-neutral-600 text-base sm:text-lg leading-relaxed font-medium max-w-4xl">
          Every business today needs more than a shopping cart. It needs a fast, secure, search-optimised platform that turns visitors into paying customers and handles payments, stock, and shipping without friction. As a dedicated ecommerce development company in Kochi, Teknoppy combines clean store design with secure payment integration, Product schema markup, and Core Web Vitals optimisation — so your store does not just look great, it ranks and sells. Our clients include startups, retailers, Ayurveda and export brands, manufacturers, and established enterprises across Kochi, Thrissur, Calicut, Trivandrum, and the wider Kerala market.
        </p>
      </div>
    </section>

    <!-- WHY TEKNOPPY SECTION -->
    <section class="py-24 bg-[#FFF8EF]/30 border-y border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/whoweare.png')] opacity-50"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

          <!-- Left Column (Sticky Panel) -->
          <div class="lg:col-span-5 lg:sticky lg:top-32 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider shadow-sm">
              Trusted Partners
            </div>
            <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
              Why Teknoppy Is the Trusted <br />
              <span class="text-primary">Ecommerce Website Development Company in Kochi.</span>
            </h2>
            <p class="text-neutral-500 font-medium text-sm leading-relaxed max-w-sm">
              We strip away generic shopping-cart templates to engineer custom-built, high-performance online stores designed to rank, scale, and convert browsers into buyers.
            </p>
          </div>

          <!-- Right Column (Premium Custom Cards Grid) -->
          <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6 lg:gap-8">

            <!-- Card 1 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">01 . Strategy</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Custom Stores, Not Templates</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Every project begins with a custom wireframe mapped to your products, customers, and sales goals — design, development, payments, on-page SEO, and schema, all under one roof.
                </p>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">02 . Conversion</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Built to Sell, Not Just Display</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  We design for conversions: fast product pages, clear calls to action, simple checkout, and trust signals that reduce abandoned carts and turn browsers into buyers.
                </p>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">03 . Payments</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">Secure Payments, Local & Global</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  UPI, cards, and net banking for India, plus PayPal and Stripe for overseas buyers — so customers in Kerala and abroad pay with confidence on a secure, tested checkout.
                </p>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="bg-white rounded-3xl border border-neutral-100 p-8 shadow-[0_12px_40px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-4">04 . Partnership</span>
                <h3 class="text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors duration-300 mb-3">A Local Kochi Team</h3>
                <p class="text-neutral-500 text-xs leading-relaxed font-semibold">
                  Teknoppy is headquartered in Kochi, Kerala — not a remote offshore agency. When you need a meeting, a quick call, or an urgent update, we are one message away.
                </p>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- OUR ECOMMERCE DEVELOPMENT SERVICES IN KOCHI -->
    <section id="services" class="py-20 bg-white relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/bgourservices.png')]" style="opacity: 0.45;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            Services Scope
          </div>
          <h2 class="text-4xl md:text-5xl font-black text-neutral-900 leading-tight">
            Our <span class="text-primary">Ecommerce Development</span> Services in Kochi
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base sm:text-lg">
            As a full-service ecommerce development company in Kochi, Teknoppy delivers the following specialised services.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {services.map(svc => {
            const IconComp = svc.icon;
            return (
              <div class="relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col">
                <!-- Left Gradient Stroke -->
                <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 bg-primary/5 text-primary rounded-2xl flex items-center justify-center flex-shrink-0 border border-primary/10 shadow-inner">
                    <IconComp class="w-6 h-6" />
                  </div>
                  <h3 class="text-base sm:text-[17px] font-black text-neutral-850 leading-snug">{svc.title}</h3>
                </div>
                <p class="text-neutral-500 text-xs leading-relaxed mt-4 font-semibold">{svc.desc}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ECOMMERCE PROCESS SECTION (LIGHT TIMELINE CARDS) -->
    <section class="py-24 bg-[#FFF9F6]/40 border-t border-neutral-100 relative">
      <!-- Dynamic background container to prevent overflow issues -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/tekenoppyadvantage.png')]" style="opacity: 0.8;"></div>
      </div>
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-wider mb-4 shadow-sm">
            • Our Process •
          </div>
          <h2 class="text-4xl sm:text-5xl font-black text-neutral-900 leading-tight">
            Our <span class="text-primary">Ecommerce Process</span> — How We Work
          </h2>
          <p class="text-neutral-500 font-medium mt-3 text-base">
            Our ecommerce development process follows six clearly defined stages, ensuring every project is delivered on time, within budget, and built precisely to brief.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-y-12 gap-x-6 lg:gap-x-8 relative z-10">
          {processes.map((proc, idx) => {
            const IconComponent = proc.icon;
            return (
