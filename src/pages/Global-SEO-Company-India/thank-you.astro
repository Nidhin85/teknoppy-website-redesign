---
/**
 * Thank-you page after a successful Global SEO Audit form submission.
 * Route: /Global-SEO-Company-India/thank-you/
 * Uses identical branding, fonts, GTM (GTM-NHX2WJ39), and noindex directives.
 */
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Thank You | Global SEO Company in India | Teknoppy</title>
  <meta name="description" content="Thank you for requesting a Global SEO audit. Vijayakala and our team will review your website and get in touch within 24 hours." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href="https://www.teknoppy.com/Global-SEO-Company-India/thank-you/" />

  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NHX2WJ39');</script>
  <!-- End Google Tag Manager -->

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style is:inline>
  :root{
    --orange:#FF6B00;--orange-d:#E85D00;--orange-s:#FFF1E6;
    --yellow:#FFC400;--yellow-s:#FFF7DB;
    --black:#0F0F0F;--ink:#1B1B1B;--muted:#6A6A6A;--line:#ECECEC;--bg:#FCFCFA;
    --wa:#25D366;--green:#16A34A;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{overflow-x:clip}
  body{font-family:"DM Sans",system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column}
  a{color:inherit;text-decoration:none}
  img{display:block;max-width:100%}
  .wrap{width:min(1180px,100% - 32px);margin-inline:auto}
  h1,h2,h3{font-family:"Space Grotesk",sans-serif;letter-spacing:-.035em;line-height:1.05;color:var(--black);font-weight:700}

  /* Nav */
  .navwrap{position:sticky;top:14px;z-index:99;padding:0 16px}
  .nav{max-width:980px;margin:0 auto;background:rgba(255,255,255,.94);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:18px;height:62px;display:flex;align-items:center;justify-content:space-between;padding:0 12px 0 20px;box-shadow:0 14px 40px -24px rgba(0,0,0,.25)}
  .logo img{height:32px;width:auto}
  .nav-actions{display:flex;align-items:center;gap:12px}
  .nav-phone{display:inline-flex;align-items:center;gap:8px;font-size:.9rem;font-weight:700;color:var(--ink);padding:8px 14px;border-radius:12px;background:var(--bg);border:1px solid var(--line);transition:all .2s}
  .nav-phone:hover{border-color:var(--orange);color:var(--orange)}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:12px 22px;border-radius:12px;font-weight:700;font-size:.92rem;border:0;cursor:pointer;font-family:inherit;transition:transform .2s,background .2s}
  .btn-o{background:var(--orange);color:#fff}
  .btn-o:hover{background:var(--orange-d);transform:translateY(-2px)}
  .btn-wa{background:var(--wa);color:#fff}
  .btn-wa:hover{background:#1ebc59;transform:translateY(-2px)}

  /* Main Thank You Container */
  main{flex:1;display:flex;align-items:center;padding:70px 0 90px}
  .ty-card{max-width:840px;margin:0 auto;background:#fff;border:1px solid var(--line);border-radius:28px;padding:50px 44px;box-shadow:0 30px 60px -30px rgba(0,0,0,.15);text-align:center}
  
  .success-badge{width:76px;height:76px;border-radius:50%;background:rgba(37,211,102,.12);border:2px solid var(--wa);display:grid;place-items:center;margin:0 auto 24px;font-size:2.2rem;color:var(--green);animation:popBadge .6s cubic-bezier(.34,1.56,.64,1) forwards}
  @keyframes popBadge{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}

  .ty-tag{display:inline-flex;align-items:center;gap:6px;background:var(--orange-s);color:var(--orange-d);font-size:.82rem;font-weight:700;padding:6px 14px;border-radius:999px;margin-bottom:14px}
  h1{font-size:clamp(2.2rem,4.8vw,3.2rem);margin-bottom:16px}
  .lead{color:var(--muted);font-size:1.15rem;max-width:620px;margin:0 auto 36px;line-height:1.65}
  .lead b{color:var(--ink)}

  /* 2-column info grid */
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;text-align:left;margin-top:28px}
  .col-card{background:var(--bg);border:1px solid var(--line);border-radius:20px;padding:26px;display:flex;flex-direction:column;justify-content:space-between}
  .col-card h3{font-size:1.18rem;margin-bottom:10px}
  .col-card p{color:var(--muted);font-size:.92rem;line-height:1.55;margin-bottom:18px}

  /* Profile chip */
  .vk-chip{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin-bottom:18px}
  .vk-chip img{width:46px;height:46px;border-radius:50%;object-fit:cover;border:1.5px solid var(--orange)}
  .vk-chip-info b{display:block;font-size:.92rem}
  .vk-chip-info small{color:var(--muted);font-size:.78rem}

  /* Links */
  .qlinks{display:flex;flex-direction:column;gap:10px}
  .qlink{display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 16px;font-weight:700;font-size:.9rem;color:var(--ink);transition:all .2s}
  .qlink:hover{border-color:var(--orange);color:var(--orange);transform:translateX(3px)}
  .qlink span{color:var(--orange)}

  /* Footer */
  footer{background:var(--black);color:#7E7E7E;font-size:.85rem;padding:30px 0}
  footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}
  footer b{color:var(--yellow)}

  @media (max-width:768px){
    .ty-card{padding:36px 24px}
    .grid-2{grid-template-columns:1fr}
    .navwrap{top:8px;padding:0 10px}
    .nav{height:56px;padding:0 8px 0 14px}
    .nav .btn{display:none}
  }
  </style>
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NHX2WJ39"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <!-- STICKY HEADER -->
  <div class="navwrap">
    <nav class="nav">
      <a aria-label="Teknoppy" class="logo" href="/">
        <img alt="Teknoppy" src="/logo.svg" onerror="this.onerror=null;this.src='https://www.teknoppy.com/logo.svg';" />
      </a>
      <div class="nav-actions">
        <a class="nav-phone" href="tel:+916282249224">
          <span>📞</span><span>+91 62822 49224</span>
        </a>
        <a class="btn btn-wa" href="https://wa.me/916282249224?text=Hi%20Teknoppy%2C%20I%20submitted%20a%20Global%20SEO%20audit%20request." target="_blank" rel="noopener">
          WhatsApp Us
        </a>
      </div>
    </nav>
  </div>

  <!-- MAIN CONTENT -->
  <main>
    <div class="wrap">
      <div class="ty-card">
        <div class="success-badge">✓</div>
        <span class="ty-tag">AUDIT REQUEST RECEIVED</span>
        <h1>Thank you for reaching out!</h1>
        <p class="lead">We've received your Global SEO audit request. <b>Vijayakala</b> and our international search squad will analyze your website, competitor keyword footprints, and AI citation readiness, and reach out within <b>24 hours</b>.</p>

        <div class="grid-2">
          <!-- Connect Card -->
          <div class="col-card">
            <div>
              <h3>Need faster answers?</h3>
              <p>Chat directly with Vijayakala on WhatsApp to discuss your target countries or immediate SEO goals.</p>
              
              <div class="vk-chip">
                <img src="/team/vijayakala-expert.webp" alt="Vijayakala, Business Development at Teknoppy" onerror="this.onerror=null;this.src='https://www.teknoppy.com/team/vijayakala-expert.webp';" />
                <div class="vk-chip-info">
                  <b>Vijayakala</b>
                  <small>Business Development &amp; Client Relations · Online</small>
                </div>
              </div>
            </div>

            <a class="btn btn-wa" href="https://wa.me/916282249224?text=Hi%20Teknoppy%2C%20I%20submitted%20a%20Global%20SEO%20audit%20request%20and%20would%20like%20to%20connect." target="_blank" rel="noopener">
              Chat on WhatsApp ↗
            </a>
          </div>

          <!-- Explore Card -->
          <div class="col-card">
            <div>
              <h3>Explore while you wait</h3>
              <p>See our proven international client results, recent web designs, and case studies across 10+ countries.</p>

              <div class="qlinks">
                <a class="qlink" href="/portfolios/">
                  Client Case Studies <span>→</span>
                </a>
                <a class="qlink" href="/web-design-company-landingpage/">
                  Web Design Services <span>→</span>
                </a>
                <a class="qlink" href="/services/">
                  All Digital Capabilities <span>→</span>
                </a>
              </div>
            </div>

            <div style="margin-top:16px;font-size:0.82rem;color:var(--muted);text-align:center;">
              Direct Email: <a href="mailto:sales@teknoppy.com" style="color:var(--orange);font-weight:700;">sales@teknoppy.com</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer>
    <div class="wrap">
      <span>© 2026 <b>Teknoppy</b> · Global SEO Company</span>
      <span>Kochi, Kerala · Serving clients worldwide since 2018</span>
    </div>
  </footer>
</body>
</html>
