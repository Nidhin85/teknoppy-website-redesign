  <style is:inline>
  /* ===== TEKNOPPY COLOURS ===== */
  :root{
    --orange:#FF6B00;--orange-d:#E85D00;--orange-s:#FFF1E6;
    --yellow:#FFC400;--yellow-s:#FFF7DB;
    --black:#0F0F0F;--ink:#1B1B1B;--muted:#6A6A6A;--line:#ECECEC;--bg:#FCFCFA;
    --wa:#25D366;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  html,body{overflow-x:clip}
  body{font-family:"DM Sans",system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  img{display:block;max-width:100%}
  .wrap{width:min(1180px,100% - 32px);margin-inline:auto}
  h1,h2,h3{font-family:"Space Grotesk",sans-serif;letter-spacing:-.035em;line-height:1.02;color:var(--black);font-weight:700}
  h2{font-size:clamp(2rem,4.4vw,3.4rem)}
  section{padding:100px 0}
  .tag{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 14px;font-size:.82rem;font-weight:600}
  .tag .dot{width:8px;height:8px;border-radius:50%;background:var(--orange);box-shadow:0 0 0 0 rgba(255,107,0,.6);animation:ping 1.8s infinite}
  @keyframes ping{70%{box-shadow:0 0 0 9px rgba(255,107,0,0)}100%{box-shadow:0 0 0 0 rgba(255,107,0,0)}}
  .kicker{font-family:"Space Grotesk",system-ui,sans-serif;font-weight:600;font-size:.9rem;color:var(--orange);margin-bottom:12px;display:block}
  body.gcc .r-intl,body.intl .r-gcc{display:none!important}

  /* buttons */
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:16px 26px;border-radius:14px;font-weight:700;font-size:1rem;border:0;cursor:pointer;font-family:inherit;transition:transform .2s,background .2s}
  .btn-o{background:var(--orange);color:#fff}
  .btn-o:hover{background:var(--orange-d);transform:translateY(-2px)}
  .btn-k{background:var(--black);color:#fff}
  .btn-k:hover{transform:translateY(-2px)}
  .btn .ar{transition:transform .25s}.btn:hover .ar{transform:translateX(4px)}
  .ic{width:20px;height:20px;fill:currentColor}

  /* floating nav */
  .navwrap{position:sticky;top:14px;z-index:50;padding:0 16px}
  .nav{max-width:980px;margin:14px auto 0;background:rgba(255,255,255,.88);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:18px;height:62px;display:flex;align-items:center;justify-content:space-between;padding:0 10px 0 20px;box-shadow:0 14px 40px -24px rgba(0,0,0,.35)}
  .logo{font-family:"Space Grotesk",system-ui,sans-serif;font-weight:700;font-size:1.2rem;display:flex;align-items:center}
  .logo img{height:32px;width:auto}
  .seg{display:flex;gap:4px;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:4px}
  .seg button{border:0;background:none;font:inherit;font-weight:700;font-size:.82rem;padding:7px 12px;border-radius:9px;cursor:pointer;color:var(--muted);white-space:nowrap}
  .seg button.on{background:var(--black);color:#fff}
  .nav .btn{padding:11px 18px;font-size:.9rem;border-radius:12px}
  .sm{display:none}

  /* hero */
  .hero{padding:70px 0 0;text-align:center;position:relative}
  .hero h1{font-size:clamp(2.6rem,7.4vw,6rem);margin:22px auto 22px;max-width:1000px}
  .hero h1 .o{color:var(--orange)}
  .hero h1 .u{position:relative;white-space:nowrap}
  .hero h1 .u svg{position:absolute;left:0;bottom:-.12em;width:100%;height:.3em;overflow:visible}
  .hero h1 .u path{stroke:var(--yellow);stroke-width:10;fill:none;stroke-linecap:round;stroke-dasharray:420;stroke-dashoffset:420;animation:ul 1.1s .6s ease forwards}
  @keyframes ul{to{stroke-dashoffset:0}}
  .hero p.sub{color:var(--muted);font-size:1.15rem;max-width:640px;margin:0 auto 30px}
  .audit{display:flex;gap:8px;max-width:600px;margin:0 auto;background:#fff;border:1.5px solid var(--line);border-radius:18px;padding:8px;box-shadow:0 24px 50px -30px rgba(0,0,0,.35);transition:border-color .2s}
  .audit:focus-within{border-color:var(--orange)}
  .audit span{display:grid;place-items:center;padding-left:12px;font-size:1.1rem}
  .audit input{flex:1;border:0;outline:0;font:inherit;font-size:1rem;padding:12px 6px;min-width:0;background:none}
  .audit .btn{padding:14px 22px}
  .note{margin-top:14px;font-size:.88rem;color:var(--muted);display:flex;gap:18px;justify-content:center;flex-wrap:wrap}
  .note b{color:var(--ink)}

  /* map */
  .map{position:relative;max-width:1100px;margin:46px auto 0}
  .map svg{width:100%;height:auto;display:block}
  .map .land{stroke:#D9D4CB;stroke-width:4.4;stroke-linecap:round}
  .arc{fill:none;stroke:var(--orange);stroke-width:2;stroke-dasharray:6 7;opacity:.18;transition:opacity .4s}
  body.gcc .a-gcc,body.intl .a-intl{opacity:1;animation:flow 1.2s linear infinite}
  @keyframes flow{to{stroke-dashoffset:-26}}
  .pin{fill:#CFCFCF;transition:fill .4s}
  body.gcc .p-gcc,body.intl .p-intl{fill:var(--orange)}
  .home{fill:var(--black)}
  .home-r{fill:none;stroke:var(--orange);stroke-width:2;transform-origin:716px 226px;animation:rad 2s ease-out infinite}
  @keyframes rad{from{transform:scale(.6);opacity:1}to{transform:scale(3.2);opacity:0}}
  .mlabel{position:absolute;transform:translate(-50%,-150%);background:#fff;border:1px solid var(--line);border-radius:8px;padding:4px 9px;font-size:.74rem;font-weight:700;white-space:nowrap;box-shadow:0 8px 20px -12px rgba(0,0,0,.35);opacity:0;transition:opacity .4s}
  body.gcc .l-gcc,body.intl .l-intl{opacity:1}
  .mhome{position:absolute;left:71.6%;top:51.4%;transform:translate(-50%,40%);background:var(--black);color:#fff;border-radius:10px;padding:6px 11px;font-size:.78rem;font-weight:700;white-space:nowrap}
  .mhome b{color:var(--yellow)}

  /* logos */
  .logos{padding:46px 0 30px;border-bottom:1px solid var(--line)}
  .logos p{text-align:center;font-size:.86rem;color:var(--muted);font-weight:600;margin-bottom:18px}
  .lt{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
  .track{display:flex;gap:50px;width:max-content;animation:sc 34s linear infinite}
  .track img{height:46px;width:auto;border-radius:8px;filter:grayscale(1);opacity:.65}
  @keyframes sc{to{transform:translateX(-50%)}}

  /* bento */
  .bhead{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:40px}
  .bhead p{color:var(--muted);max-width:380px}
  .bento{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:minmax(190px,auto);gap:16px}
  .tile{background:#fff;border:1px solid var(--line);border-radius:24px;padding:28px;position:relative;overflow:hidden;transition:transform .3s,box-shadow .3s}
  .tile:hover{transform:translateY(-4px);box-shadow:0 30px 50px -34px rgba(0,0,0,.35)}
  .tile h3{font-size:1.45rem;margin-bottom:8px}
  .tile p{color:var(--muted);font-size:.96rem}
  .t-big{grid-column:span 3;grid-row:span 2;background:var(--orange);color:#fff;border:0}
  .t-big h3{color:#fff;font-size:clamp(1.8rem,3vw,2.5rem)}
  .t-big p{color:#FFE9D6;font-size:1.05rem;max-width:380px}
  .bars{position:absolute;left:28px;right:28px;bottom:28px;display:grid;gap:12px}
  .bar{font-size:.82rem;font-weight:700}
  .bar i{display:block;height:14px;border-radius:8px;margin-top:6px;background:rgba(255,255,255,.3);position:relative;overflow:hidden}
  .bar i::after{content:"";position:absolute;inset:0;width:var(--w);background:#fff;border-radius:8px;transform-origin:left;transform:scaleX(0);transition:transform 1.2s cubic-bezier(.2,.8,.2,1)}
  .bar.y i::after{background:var(--yellow)}
  .in .bar i::after{transform:scaleX(1)}
  .bars small{font-size:.72rem;opacity:.8}
  .t-3{grid-column:span 3}
  .t-2{grid-column:span 2}
  .t-dark{background:var(--black);border:0}
  .t-dark h3{color:#fff}.t-dark p{color:#A9A9A9}
  .t-yel{background:var(--yellow-s);border-color:#FFE7A0}
  .clocks{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}
  .clk{flex:1;min-width:110px;background:var(--bg);border:1px solid var(--line);border-radius:14px;padding:10px 12px}
  .clk small{display:block;font-size:.72rem;color:var(--muted);font-weight:600}
  .clk b{font-family:"Space Grotesk",system-ui,sans-serif;font-size:1.35rem}
  .clk.me{background:var(--black);color:#fff;border:0}.clk.me small{color:#bbb}
  .rep{margin-top:16px;display:flex;flex-direction:column;gap:8px}
  .rep div{display:flex;justify-content:space-between;align-items:center;font-size:.84rem;font-weight:600;padding:9px 12px;background:var(--bg);border-radius:10px}
  .rep em{font-style:normal;color:#16A34A}
  .big-ic{font-size:2.2rem;margin-bottom:10px}

  /* services list */
  .slist{margin-top:40px;border-top:1px solid var(--black)}
  .srow{display:grid;grid-template-columns:70px 1fr 1.1fr 50px;gap:20px;align-items:center;padding:26px 6px;border-bottom:1px solid var(--line);transition:background .3s,padding .3s;cursor:pointer}
  .srow:hover{background:#fff;padding-left:18px}
  .srow .n{font-family:"Space Grotesk",system-ui,sans-serif;color:var(--muted);font-weight:600}
  .srow h3{font-size:clamp(1.3rem,2.4vw,1.9rem)}
  .srow p{color:var(--muted)}
  .srow .go{width:44px;height:44px;border-radius:50%;border:1.5px solid var(--line);display:grid;place-items:center;transition:.3s}
  .srow:hover .go{background:var(--orange);border-color:var(--orange);color:#fff;transform:rotate(-45deg)}

  /* steps */
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:44px;border:1px solid var(--line);border-radius:24px;background:#fff;overflow:hidden}
  .st{padding:34px 30px;border-right:1px solid var(--line)}
  .st:last-child{border:0}
  .st .num{font-family:"Space Grotesk",system-ui,sans-serif;font-size:4rem;font-weight:700;line-height:1;color:transparent;-webkit-text-stroke:1.5px var(--orange);margin-bottom:16px}
  .st h3{font-size:1.3rem;margin-bottom:6px}
  .st p{color:var(--muted)}

  /* white label */
  .wl{background:var(--yellow);border-radius:28px;padding:50px;display:grid;grid-template-columns:1.3fr auto;gap:30px;align-items:center}
  .wl h2{font-size:clamp(1.8rem,3.6vw,2.8rem)}
  .wl p{color:#3B3B3B;margin-top:10px;max-width:560px;font-weight:500}

  /* quote */
  .quote{display:grid;grid-template-columns:auto 1fr;gap:40px;align-items:center;max-width:960px;margin:0 auto}
  .quote img{width:120px;height:120px;border-radius:24px;object-fit:cover;background:var(--orange-s)}
  .quote blockquote{font-family:"Space Grotesk",system-ui,sans-serif;font-size:clamp(1.4rem,2.8vw,2.1rem);font-weight:600;line-height:1.25;letter-spacing:-.02em;color:var(--black)}
  .quote blockquote::before{content:"\201C";color:var(--orange)}
  .quote blockquote::after{content:"\201D";color:var(--orange)}
  .quote cite{display:block;font-style:normal;margin-top:16px;font-weight:700}
  .quote cite small{color:var(--muted);font-weight:500}

  /* faq */
  .faqg{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px}
  .faq details{border-bottom:1px solid var(--line)}
  .faq summary{list-style:none;cursor:pointer;padding:22px 0;font-family:"Space Grotesk",system-ui,sans-serif;font-weight:600;font-size:1.15rem;display:flex;justify-content:space-between;gap:14px}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"\2193";color:var(--orange);transition:transform .25s}
  .faq details[open] summary::after{transform:rotate(180deg)}
  .faq details p{color:var(--muted);padding-bottom:22px}

  /* final */
  .final{background:var(--black);color:#fff;border-radius:36px 36px 0 0;padding:100px 0}
  .fg{display:grid;grid-template-columns:1fr .9fr;gap:60px;align-items:start}

  /* VIJAYAKALA PROFILE CARD IN AUDIT SECTION */
  .vk-audit-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 22px;
    margin-top: 26px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .vk-audit-top {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }
  .vk-audit-photo-wrap {
    position: relative;
    width: 68px;
    height: 68px;
    flex-shrink: 0;
  }
  .vk-audit-photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--orange);
    display: block;
  }
  .vk-dot-pulse {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 13px;
    height: 13px;
    background: var(--wa);
    border-radius: 50%;
    border: 2px solid var(--black);
  }
  .vk-audit-meta {
    display: flex;
    flex-direction: column;
  }
  .vk-audit-meta .vk-status {
    font-size: 0.76rem;
    font-weight: 700;
    color: #34D399;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 2px;
  }
  .vk-audit-meta .dot-green {
    width: 7px;
    height: 7px;
    background: #34D399;
    border-radius: 50%;
    display: inline-block;
  }
  .vk-audit-meta b {
    font-size: 1.15rem;
    color: #fff;
    font-family: 'Space Grotesk', sans-serif;
  }
  .vk-audit-meta .vk-role {
    font-size: 0.84rem;
    color: var(--yellow);
    font-weight: 600;
  }
  .vk-audit-meta .vk-direct {
    font-size: 0.82rem;
    color: #bbb;
    margin-top: 2px;
  }
  .vk-audit-quote {
    font-size: 0.92rem;
    color: #ddd;
    line-height: 1.5;
    margin-bottom: 14px;
    font-style: italic;
    border-left: 2px solid var(--orange);
    padding-left: 12px;
  }
  .vk-audit-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .vk-audit-badges span {
    font-size: 0.76rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.08);
    color: #eee;
    padding: 5px 10px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .final h2{color:#fff;font-size:clamp(2.4rem,5.4vw,4.4rem)}
  .final h2 span{color:var(--yellow)}
  .final p.t{color:#BDBDBD;font-size:1.1rem;margin:18px 0 28px;max-width:480px}
  .final .links{display:flex;flex-direction:column;gap:12px;font-weight:600}
  .final .links a:hover{color:var(--yellow)}
  .form{background:#fff;color:var(--ink);border-radius:26px;padding:32px;position:relative}
  .form::before{content:"";position:absolute;inset:-2px;border-radius:28px;background:linear-gradient(135deg,var(--orange),var(--yellow));z-index:-1}
  .form h3{font-size:1.5rem}
  .form .s{color:var(--muted);font-size:.92rem;margin:4px 0 18px}
  .f{margin-bottom:12px}
  .f label{display:block;font-size:.8rem;font-weight:700;margin-bottom:5px}
  .f input,.f select{width:100%;padding:13px 14px;border:1.5px solid #E5E5E5;border-radius:12px;font:inherit;background:#fff}
  .f input:focus,.f select:focus{outline:none;border-color:var(--orange)}
  .form .btn{width:100%;margin-top:4px}
  .form .ok{display:none;text-align:center;padding:36px 0}
  .form .ok b{display:grid;place-items:center;width:64px;height:64px;margin:0 auto 12px;border-radius:50%;background:var(--orange-s);color:var(--orange);font-size:1.8rem}
  .secure{text-align:center;font-size:.8rem;color:var(--muted);margin-top:12px}
  footer{background:var(--black);color:#7E7E7E;font-size:.85rem;padding:0 0 30px}
