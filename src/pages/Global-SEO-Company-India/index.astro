    if(RM||matchMedia('(hover:none)').matches)return;
    document.querySelectorAll('.btn-o,.btn-k').forEach(function(b){
      b.addEventListener('mousemove',function(e){var r=b.getBoundingClientRect();b.style.transform='translate('+((e.clientX-r.left-r.width/2)*.18)+'px,'+((e.clientY-r.top-r.height/2)*.3)+'px)'});
      b.addEventListener('mouseleave',function(){b.style.transform=''});
    });
  })();

  (function(){var el=document.getElementById('score');if(!el)return;var io=new IntersectionObserver(function(es){if(!es[0].isIntersecting)return;io.disconnect();var v=0;var iv=setInterval(function(){v+=2;if(v>=62){v=62;clearInterval(iv)}el.textContent=v},28)},{threshold:.4});io.observe(el)})();

  (function(){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;io.unobserve(e.target);
    var el=e.target,t=+el.dataset.count,s=el.querySelector('span').outerHTML,c=0,st=Math.max(1,Math.ceil(t/40));
    var iv=setInterval(function(){c+=st;if(c>=t){c=t;clearInterval(iv)}el.innerHTML=c+s},30)})},{threshold:.6});
    document.querySelectorAll('[data-count]').forEach(function(n){io.observe(n)})})();

  (function(){
    var k=0;
    document.querySelectorAll('[data-split]').forEach(function(el){
      var txt=el.textContent;el.textContent='';
      txt.split(/(\s+)/).forEach(function(word){
        if(!word)return;
        if(/^\s+$/.test(word)){el.appendChild(document.createTextNode(' '));return}
        var g=document.createElement('span');g.className='wg';
        for(var c of word){var sp=document.createElement('span');sp.className='ch';sp.textContent=c;sp.style.animationDelay=(k*0.045)+'s'+(el.classList.contains('ig')?', '+(1.6+k*0.045)+'s':'');g.appendChild(sp);k++}
        el.appendChild(g);
      });
    });
  })();

  (function(){
    var RM2=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
    var sp=document.querySelector('.sprog');
    if(sp&&!RM2){var t=false;function up(){var d=document.documentElement;var m=d.scrollHeight-innerHeight;sp.style.transform='scaleX('+(m>0?scrollY/m:0)+')';t=false}
      addEventListener('scroll',function(){if(!t){requestAnimationFrame(up);t=true}},{passive:true});up();}

    if(!RM2){document.querySelectorAll('section h2').forEach(function(h2){
      var walk=document.createTreeWalker(h2,NodeFilter.SHOW_TEXT,null),nodes=[],n;while(n=walk.nextNode())nodes.push(n);
      var i=0;nodes.forEach(function(tn){var frag=document.createDocumentFragment();
        tn.textContent.split(/(\s+)/).forEach(function(w){if(!w)return;if(/^\s+$/.test(w)){frag.appendChild(document.createTextNode(' '));return}
          var o=document.createElement('span');o.className='hw';var s=document.createElement('span');s.textContent=w;s.style.transitionDelay=(i*0.05)+'s';i++;o.appendChild(s);frag.appendChild(o)});
        tn.parentNode.replaceChild(frag,tn)});
      var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.querySelectorAll('.hw').forEach(function(x){x.classList.add('go')});io.unobserve(e.target)}})},{threshold:.3});
      io.observe(h2);
    });}

    var q=document.getElementById('aiq'),a=document.getElementById('aia');
    if(q&&a){var txt='Which company should I hire for international SEO?';
      if(RM2){q.textContent=txt;a.classList.add('show');return}
      var io2=new IntersectionObserver(function(es){if(!es[0].isIntersecting)return;io2.disconnect();
        (function loop(){var k=0;q.textContent='';a.classList.remove('show');
          var iv=setInterval(function(){q.textContent=txt.slice(0,++k);if(k>=txt.length){clearInterval(iv);setTimeout(function(){a.classList.add('show')},400);setTimeout(loop,7000)}},45)})();
      },{threshold:.4});io2.observe(q);}
  })();

  (function(){var io='IntersectionObserver' in window?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.15}):null;
  document.querySelectorAll('.rv').forEach(function(el){io?io.observe(el):el.classList.add('in')})})();

  (function(){
    var t=document.getElementById('cases');if(!t)return;
    var cards=t.querySelectorAll('.case'),dots=document.querySelectorAll('.cs-dots span'),cur=0,timer;
    cards.forEach(function(c){c.classList.add('in')});
    function go(i){cur=(i+cards.length)%cards.length;t.scrollTo({left:cards[cur].offsetLeft-t.offsetLeft,behavior:'smooth'})}
    var last=-1;
    function mark(){
      var i=Math.round(t.scrollLeft/t.clientWidth);cur=i;
      if(i===last)return;last=i;
      dots.forEach(function(d,j){d.classList.remove('on');void d.offsetWidth;if(j===i)d.classList.add('on')});
      cards.forEach(function(c,j){c.classList.remove('act');if(j===i){void c.offsetWidth;c.classList.add('act')}});
    }
    t.addEventListener('scroll',function(){requestAnimationFrame(mark)},{passive:true});
    var prevBtn = document.querySelector('.cs-prev');
    var nextBtn = document.querySelector('.cs-next');
    if(prevBtn) prevBtn.onclick=function(){go(cur-1);reset()};
    if(nextBtn) nextBtn.onclick=function(){go(cur+1);reset()};
    dots.forEach(function(d,j){d.onclick=function(){go(j);reset()}});
    t.addEventListener('keydown',function(e){if(e.key==='ArrowRight'){go(cur+1);reset()}if(e.key==='ArrowLeft'){go(cur-1);reset()}});
    var RMs=matchMedia('(prefers-reduced-motion: reduce)').matches;
    function reset(){clearInterval(timer);if(!RMs)timer=setInterval(function(){go(cur+1)},6000)}
    var dw=document.querySelector('.cs-dots');
    t.addEventListener('mouseenter',function(){clearInterval(timer);if(dw)dw.classList.add('paused')});
    t.addEventListener('mouseleave',function(){if(dw)dw.classList.remove('paused');reset()});
    var seen=new IntersectionObserver(function(es){if(es[0].isIntersecting){seen.disconnect();last=-1;mark();reset()}},{threshold:.3});seen.observe(t);
  })();
  </script>
</body>
</html>
