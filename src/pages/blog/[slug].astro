---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterCTA from '../../components/FooterCTA.astro';
import { Calendar, Clock, ChevronLeft, ArrowRight, RefreshCw, User } from 'lucide-react';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, excerpt, category, date, updated, author, readTime, cover } = post.data;
const pageTitle = `${title} — Teknoppy`;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const dateStr = fmt(date);
const updatedStr = updated ? fmt(updated) : null;

// GEO rule (site structure doc §10): every post carries a visible author and
// published/updated date, mirrored into Article schema for AI crawlers.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": excerpt,
  "image": new URL(cover, Astro.site ?? 'https://teknoppy.com').href,
  "articleSection": category,
  "datePublished": date.toISOString(),
  "dateModified": (updated ?? date).toISOString(),
  "author": { "@type": "Organization", "name": author },
  "publisher": {
    "@type": "Organization",
    "name": site.businessName,
    "url": "https://teknoppy.com/"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(`/blog/${post.id}/`, Astro.site ?? 'https://teknoppy.com').href
  }
};
---

<Layout title={pageTitle} description={excerpt}>
  <Header />

  <main class="bg-white pt-28 pb-20">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-12 mt-8">
      <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-bold text-neutral-500 hover:text-primary transition-colors mb-10 group">
        <ChevronLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
        Back to Blog list
      </a>

      <div class="max-w-3xl space-y-6">
        <span class="inline-block text-xs font-black uppercase tracking-wider text-primary bg-primary/10 px-3 py-1.5 rounded-full">{category}</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 leading-tight">
          {title}
        </h1>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium text-neutral-500 pt-2 border-b border-neutral-100 pb-6">
          <span class="flex items-center gap-2"><User class="w-4 h-4 text-primary" />By {author}</span>
          <span class="flex items-center gap-2"><Calendar class="w-4 h-4 text-primary" />Published {dateStr}</span>
          {updatedStr && (
            <span class="flex items-center gap-2"><RefreshCw class="w-4 h-4 text-primary" />Updated {updatedStr}</span>
          )}
          <span class="flex items-center gap-2"><Clock class="w-4 h-4 text-primary" />{readTime}</span>
        </div>
      </div>
    </div>

    <div class="max-w-[1280px] mx-auto px-6 lg:px-12 my-12">
      <div class="aspect-[21/9] w-full rounded-xl overflow-hidden bg-neutral-100 shadow-sm">
        <img src={cover} alt={title} class="w-full h-full object-cover" />
      </div>
    </div>

    <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
      <div class="max-w-3xl mx-auto">
        <article class="article-body text-neutral-700 leading-relaxed font-medium">
          <Content />
        </article>

        <div class="mt-16 theme-keep-light bg-[#0A0A0C] text-white p-8 md:p-12 rounded-xl text-center space-y-6 shadow-xl relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-full blur-2xl"></div>
          <h3 class="text-2xl md:text-3xl font-bold">Your 2026-ready website starts with one conversation</h3>
          <p class="text-sm text-neutral-400 max-w-md mx-auto">
            Ready to grow your brand online? Communicate with our experts today.
          </p>
          <a href="/contact-us/" class="inline-flex items-center gap-2 px-8 py-4 text-sm font-bold text-white bg-primary hover:bg-primary/90 rounded-xl shadow-lg transition-transform hover:-translate-y-0.5">
            Book a Free Consultation
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </main>

  <FooterCTA />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</Layout>

<style>
  .article-body :global(p) { margin-bottom: 1.5rem; font-size: 1.125rem; line-height: 1.75; }
  .article-body :global(p:first-of-type) { font-size: 1.3125rem; line-height: 1.6; color: #111; font-weight: 600; }
  .article-body :global(h2) { font-size: 1.6rem; font-weight: 800; color: #111; margin-top: 3rem; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid #f0f0f0; line-height: 1.25; }
  .article-body :global(h3) { font-size: 1.3125rem; font-weight: 700; color: #111; margin-top: 2rem; margin-bottom: 1rem; }
  .article-body :global(ul) { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.5rem; }
  .article-body :global(li) { margin-bottom: 0.5rem; font-size: 1.125rem; line-height: 1.7; }
  .article-body :global(strong) { color: #111; font-weight: 700; }
  .article-body :global(a) { color: var(--color-primary); font-weight: 700; text-decoration: underline; }
</style>
