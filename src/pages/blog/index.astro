---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterCTA from '../../components/FooterCTA.astro';
import { ArrowRight, Calendar, Clock, User } from 'lucide-react';
import { getCollection } from 'astro:content';
import site from '../../data/site.json';
import page from '../../data/pages/blog.json';

// "Latest From The Blog" is auto-pulled, not hardcoded — 6 most recent posts.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6)
  .map((e) => ({
    title: e.data.title,
    excerpt: e.data.excerpt,
    category: e.data.category,
    author: e.data.author,
    date: e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
    readTime: e.data.readTime,
    image: e.data.cover,
    href: `/blog/${e.id}/`
  }));

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": page.faq.items.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://teknoppy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://teknoppy.com/blog/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": site.businessName,
    "url": "https://teknoppy.com/",
    "logo": "https://teknoppy.com/logo.svg",
    "email": site.email,
    "telephone": site.phone
  }
];
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#FFF8EF]/20">
    <!-- DARK HERO SECTION -->
    <section class="relative pt-32 pb-24 md:pt-36 md:pb-28 overflow-hidden bg-neutral-950 text-white border-b border-white/5">
      <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat lg:bg-[url('/herodarkwebdesign.webp')]"></div>
      </div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10 flex flex-col items-center text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-primary uppercase tracking-widest mb-6">
          {page.hero.badge}
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-black leading-[1.1] tracking-tight text-white mb-6">
          {page.hero.h1Lead}{' '}
          <span class="relative inline-block text-primary">
            {page.hero.h1Accent}
            <svg class="absolute -bottom-2 left-0 w-full h-2 text-primary" viewBox="0 0 100 10" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 7C30 3 70 3 97 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
          </span>
        </h1>
        <p class="text-base sm:text-lg text-neutral-300 max-w-3xl font-medium leading-relaxed">
          {page.hero.intro}
        </p>
        <p class="text-xs sm:text-sm text-neutral-400 font-semibold italic mt-8" set:html={page.hero.trustlineHtml} />
      </div>
    </section>

    <!-- BROWSE BY TOPIC — 2 columns on desktop, 1 on mobile -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <p class="max-w-3xl text-neutral-600 font-medium text-base sm:text-lg leading-relaxed mb-10">
          {page.categories.intro}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {page.categories.items.map((cat) => (
            <a
              href={cat.href}
              class="group relative overflow-hidden bg-white rounded-3xl border border-neutral-100 p-6 sm:p-7 shadow-[0_12px_30px_-15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col min-h-[112px]"
            >
              <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-gradient-to-b from-primary via-[#F58439] to-[#FFE2D1]"></div>
              <h2 class="text-lg font-black text-neutral-900 leading-snug mb-3 group-hover:text-primary transition-colors">{cat.title}</h2>
              <p class="text-neutral-600 text-sm leading-relaxed font-medium">{cat.text}</p>
              <span class="inline-flex items-center gap-1.5 text-xs font-black text-primary mt-5 uppercase tracking-wider">
                Browse category
                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- LATEST FROM THE BLOG — auto-pulled -->
    <section class="py-16 sm:py-20 bg-[#FFF8EF]/30 border-t border-neutral-100 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-80 h-80 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-[1280px] mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-3xl mb-12">
          <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight">{page.latest.heading}</h2>
          <p class="text-neutral-600 font-medium mt-4 text-base sm:text-lg leading-relaxed">{page.latest.intro}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-primary/30 border border-neutral-100/80 transition-all duration-300 flex flex-col h-full">
              <div class="overflow-hidden aspect-[16/10] bg-neutral-100 relative">
                <img
                  src={post.image}
                  alt={`${post.category} article thumbnail — ${post.title}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full bg-white/90 backdrop-blur-sm text-[12px] font-black text-primary uppercase tracking-wider shadow-sm">
                  {post.category}
                </span>
              </div>

              <div class="p-6 md:p-8 flex flex-col flex-grow justify-between">
                <div class="space-y-4">
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium text-neutral-400">
                    <span class="flex items-center gap-1.5">
                      <User class="w-3.5 h-3.5" />
                      {post.author}
                    </span>
                    <span class="flex items-center gap-1.5">
                      <Calendar class="w-3.5 h-3.5" />
                      {post.date}
                    </span>
                    <span class="flex items-center gap-1.5">
                      <Clock class="w-3.5 h-3.5" />
                      {post.readTime}
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-neutral-900 leading-snug group-hover:text-primary transition-colors duration-300">
                    <a href={post.href}>{post.title}</a>
                  </h3>

                  <p class="text-sm text-neutral-500 leading-relaxed font-medium">{post.excerpt}</p>
                </div>

                <div class="pt-6 mt-6 border-t border-neutral-50">
                  <a href={post.href} class="inline-flex items-center gap-2 text-sm font-bold text-neutral-850 hover:text-primary transition-colors duration-300">
                    Read Article
                    <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 sm:py-20 bg-white border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <h2 class="text-3xl sm:text-4xl md:text-[42px] font-black text-neutral-900 leading-tight mb-10 text-center">{page.faq.heading}</h2>

        <div class="max-w-4xl mx-auto space-y-4">
          {page.faq.items.map((faq) => (
            <details class="group bg-white rounded-2xl border border-neutral-200/60 p-6 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
                <h3 class="text-sm sm:text-base font-bold text-neutral-850 pr-4">{faq.q}</h3>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-primary flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-neutral-100/60 text-xs sm:text-sm text-neutral-600 leading-relaxed font-semibold">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 sm:py-20 bg-[#FFF8EF]/30 border-t border-neutral-100">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-12">
        <div class="max-w-4xl mx-auto text-center">
          <p class="text-neutral-700 font-medium text-base sm:text-lg leading-relaxed mb-8">{page.cta.text}</p>
          <a
            href={page.cta.href}
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 text-base font-bold text-white bg-primary rounded-full shadow-[0_6px_20px_rgba(240,90,44,0.35)] hover:bg-primary/95 hover:-translate-y-0.5 transition-all duration-300"
          >
            {page.cta.label}
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <FooterCTA />

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</Layout>
