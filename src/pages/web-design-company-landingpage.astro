      "foundingDate": "2018",
      "founder": {
        "@type": "Person",
        "name": "Sanal Edison",
        "jobTitle": "Founder & Lead Strategist"
      },
      "employee": [
        {
          "@type": "Person",
          "name": "Vijayakala",
          "jobTitle": "Business Development & Client Relations"
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Second Floor, Kaithakal Building, Door No 49, Kaithakal Lane, Thykoodam, Vyttila",
        "addressLocality": "Kochi",
        "addressRegion": "Kerala",
        "postalCode": "682019",
        "addressCountry": "IN"
      },
      "areaServed": ["Kochi", "Ernakulam", "Kerala", "UAE", "Qatar"]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does a website cost in Kochi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Business websites start from ₹25,000. You get a fixed written quote before any work begins."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most websites go live in 3–5 weeks. Larger corporate sites take 6–10 weeks."
          }
        },
        {
          "@type": "Question",
          "name": "Will my website rank on Google?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SEO setup is included in every website. For faster growth, we also offer ongoing SEO plans."
          }
        },
        {
          "@type": "Question",
          "name": "Can I update the website myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We build on WordPress and train you to edit text, images and pages without any coding."
          }
        }
      ]
    }
  ]
}
</script>

