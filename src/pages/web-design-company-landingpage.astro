<!-- Structured Data for SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "name": "Teknoppy",
      "description": "Web design company in Kochi building fast, mobile-friendly, SEO-ready websites. Websites from ₹25,000, live in 3–5 weeks.",
