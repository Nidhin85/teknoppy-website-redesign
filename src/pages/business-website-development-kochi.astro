---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/business-website-development-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA
    heading="Ready to Get More Enquiries From Your Website?"
    description="Tell us about your business and how customers find you today. We will reply within one business day with a recommended page plan, timeline and quote."
  />
</Layout>
