---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/wordpress-web-design-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA heading="Ready to Start Your WordPress Web Design Project?" description="Tell us about your brand and the website you need. We reply within one business day with a recommended site plan, timeline and fixed quote." />
</Layout>
