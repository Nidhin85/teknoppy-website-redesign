---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/wordpress-speed-optimization-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA heading="Ready to Fix a Slow WordPress Site?" description="Tell us your website URL and current speed issues. We will run a free audit and send you a before-and-after speed improvement roadmap within 24 hours." />
</Layout>
