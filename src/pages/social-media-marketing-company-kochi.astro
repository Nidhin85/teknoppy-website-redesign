---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import InnerPage from '../components/InnerPage.astro';
import page from '../data/pages/social-media-marketing-company-kochi.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-cream/20">
    <InnerPage page={page} />
  </main>

  <FooterCTA
    heading="Talk to Our Social Media Team in Kochi"
    description="Tell us which platforms you use and what you want from them — enquiries, bookings or sales. We will review your pages for free and send a written content and ads plan within 24 hours."
  />
</Layout>
