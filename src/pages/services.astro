---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterCTA from '../components/FooterCTA.astro';
import ServicesHub from '../components/services/ServicesHub.astro';
import page from '../data/pages/services.json';
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Header forceSolidBg={true} />

  <main class="overflow-hidden bg-[#fffaf6]">
    <ServicesHub page={page} />
  </main>

  <FooterCTA />
</Layout>
