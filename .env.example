# Teknoppy — environment variables (template).
# Copy this file to `.env`, fill in real values, and add the same keys in
# Vercel → Settings → Environment Variables (Production), then redeploy.

# ─────────────────────────────────────────────────────────────────────────────
# CONTACT FORMS  (read by /api/contact and by the build)
# ─────────────────────────────────────────────────────────────────────────────

# Optional. The forms already post to the built-in /api/contact handler; set
# this only to point them somewhere else (another route or an external service).
PUBLIC_CONTACT_ENDPOINT=

# REQUIRED. API key from resend.com — the free tier covers form volume
# comfortably. Without it /api/contact returns 500 and no enquiry is sent, so
# the forms show their "please call or email us" fallback message.
RESEND_API_KEY=

# Primary recipient. Defaults to sales@teknoppy.com if unset.
CONTACT_TO=

# Copied on every enquiry. Defaults to sanal@teknoppy.com if unset.
# Comma-separate for several addresses; set to "none" to send no copy.
CONTACT_CC=

# REQUIRED for production. Defaults to Resend's shared onboarding@resend.dev,
# but an account with no verified domain is in TESTING MODE — it can only email
# your own Resend account address, and enquiries to sales@teknoppy.com are
# rejected with a 403. Verify teknoppy.com at resend.com/domains (add the DKIM,
# SPF and MX records to DNS), then set this to an address on that domain:
#   CONTACT_FROM="Teknoppy Website <website@teknoppy.com>"
CONTACT_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# CMS  (read only by the /api/auth serverless function)
# ─────────────────────────────────────────────────────────────────────────────

# Password editors type at /admin/ to sign in (choose a strong one).
CMS_PASSWORD=

# GitHub fine-grained token — repo "tekenoppy", Contents: Read and write.
# Stored server-side only; editors never see it.
CMS_GITHUB_TOKEN=
