# Teknoppy — environment variables (template).
# Copy this file to `.env`, fill in real values, and add the same keys in
# Vercel → Settings → Environment Variables (Production), then redeploy.

# ─────────────────────────────────────────────────────────────────────────────
# CONTACT FORMS
# ─────────────────────────────────────────────────────────────────────────────

# Optional. The forms post straight to FormSubmit (formsubmit.co), which emails
# sales@teknoppy.com — no server code or API key. Set this only to send them
# somewhere else.
PUBLIC_CONTACT_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# CMS  (read only by scripts/pull-cms.mjs, which runs before every build)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Payload CMS in cms/ (http://localhost:3000 when run locally).
# Leave empty to build from the committed content files without contacting the CMS.
PAYLOAD_URL=

# API key of the CMS "site-build" user (SITE_BUILD_API_KEY in cms/.env).
PAYLOAD_API_KEY=
