# Teknoppy — environment variables (template).
# Copy this file to `.env`, fill in real values, and add the same keys in
# Vercel → Settings → Environment Variables (Production), then redeploy.

# ─────────────────────────────────────────────────────────────────────────────
# CONTACT FORMS  (read by /api/contact and by the build)
# ─────────────────────────────────────────────────────────────────────────────

# Turns the forms on. Until this is set, the footer and contact-page forms tell
# visitors to phone or email instead of accepting an enquiry they can't deliver.
# Set it to the built-in handler:
PUBLIC_CONTACT_ENDPOINT=/api/contact

# API key from resend.com — the free tier covers form volume comfortably.
# Without it /api/contact returns 500 and no enquiry is sent.
RESEND_API_KEY=

# Where enquiries land. Defaults to sanal@teknoppy.com if unset.
CONTACT_TO=

# Sender address. Defaults to onboarding@resend.dev, which works immediately
# with no domain setup. Once teknoppy.com is verified in Resend, switch this to
# something like "Teknoppy Website <website@teknoppy.com>" so mail authenticates
# properly (SPF/DKIM) and is far less likely to land in spam.
CONTACT_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# CMS  (read only by the /api/auth serverless function)
# ─────────────────────────────────────────────────────────────────────────────

# Password editors type at /admin/ to sign in (choose a strong one).
CMS_PASSWORD=

# GitHub fine-grained token — repo "tekenoppy", Contents: Read and write.
# Stored server-side only; editors never see it.
CMS_GITHUB_TOKEN=
