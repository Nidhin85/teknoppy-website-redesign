# Postgres connection string. Local: any Postgres database. Production: the Neon
# pooled connection string (Vercel's Neon integration sets DATABASE_URL for you).
DATABASE_URL=postgres://localhost:5432/teknoppy_cms

# Signs login sessions. Any long random string; keep it stable per environment.
PAYLOAD_SECRET=

# `npm run seed` on an empty database creates this admin login and a "site-build"
# user holding this API key — the same value goes in the site's PAYLOAD_API_KEY.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SITE_BUILD_API_KEY=

# Production only ────────────────────────────────────────────────────────────

# Vercel deploy hook of the Astro site: every save in the CMS rebuilds the site.
SITE_DEPLOY_HOOK_URL=

# Vercel Blob token for media uploads (Vercel has no persistent disk).
BLOB_READ_WRITE_TOKEN=
